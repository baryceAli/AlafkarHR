@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using System.Globalization
@using System.Security.Claims
@using System.Text
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

@if (IsOpen)
{
    <div class="command-palette-backdrop" @onclick="CloseAsync"></div>
    <section class="command-palette" role="dialog" aria-modal="true" aria-label="Command search">
        <div class="command-palette-search">
            <i class="bi @ModeIcon"></i>
            <input class="form-control"
                   autofocus
                   placeholder="@Placeholder"
                   value="@searchText"
                   @oninput="HandleSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
            <button type="button" class="btn erp-icon-btn" @onclick="CloseAsync">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <div class="command-palette-hints">
            <span class="command-hint @(SearchMode == CommandSearchMode.All ? "is-active" : "")">Ctrl+K</span>
            <span class="command-hint @(SearchMode == CommandSearchMode.Page ? "is-active" : "")">/ @SharedDataService.SelectViewLang("Pages", "\u0635\u0641\u062d\u0627\u062a")</span>
            <span class="command-hint @(SearchMode == CommandSearchMode.Action ? "is-active" : "")">&gt; @SharedDataService.SelectViewLang("Actions", "\u0625\u062c\u0631\u0627\u0621\u0627\u062a")</span>
        </div>

        <div class="command-palette-results">
            @if (SearchMode == CommandSearchMode.People)
            {
                <div class="command-empty">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>@SharedDataService.SelectViewLang("People search is reserved for a future safe lookup source.", "\u0628\u062d\u062b \u0627\u0644\u0623\u0634\u062e\u0627\u0635 \u0645\u062e\u0635\u0635 \u0644\u0645\u0635\u062f\u0631 \u0628\u062d\u062b \u0622\u0645\u0646 \u0644\u0627\u062d\u0642\u0627.")</span>
                </div>
            }
            else if (!VisibleResults.Any())
            {
                <div class="command-empty">
                    <i class="bi bi-search"></i>
                    <span>@SharedDataService.SelectViewLang("No authorized command matches your search.", "\u0644\u0627 \u064a\u0648\u062c\u062f \u0623\u0645\u0631 \u0645\u0635\u0631\u062d \u064a\u0637\u0627\u0628\u0642 \u0627\u0644\u0628\u062d\u062b.")</span>
                </div>
            }
            else
            {
                @for (var index = 0; index < VisibleResults.Count; index++)
                {
                    var item = VisibleResults[index];
                    var resultIndex = index;
                    <button type="button"
                            class="command-result @(selectedIndex == resultIndex ? "is-selected" : "")"
                            @onclick="() => NavigateAsync(item, false)">
                        <span class="command-result-icon"><i class="bi @item.Icon"></i></span>
                        <span class="command-result-copy">
                            <strong>@Label(item)</strong>
                            <small>@PathLabel(item)</small>
                        </span>
                        <span class="command-result-mode">@ModeLabel(item)</span>
                        <i class="bi bi-arrow-return-left command-result-enter"></i>
                    </button>
                }
            }
        </div>
    </section>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public string ActiveWorkspace { get; set; } = NavigationMenuResolver.WorkspaceHome;
    [Parameter] public AuthenticationState? AuthState { get; set; }
    [Parameter] public EventCallback<MenuItem> OnNavigate { get; set; }

    private string searchText = "";
    private int selectedIndex;

    private IReadOnlyList<MenuItem> VisibleResults => NavigationMenuResolver.GetAuthorizedNavigableItems(AuthState?.User)
        .Where(MatchesMode)
        .Where(MatchesSearch)
        .Take(ResultLimit)
        .ToList();

    private int ResultLimit => string.IsNullOrWhiteSpace(searchText) ? 12 : 30;
    private CommandSearchMode SearchMode => ResolveSearchMode(searchText);
    private string SearchTerm => StripModePrefix(searchText);
    private string ModeIcon => SearchMode switch
    {
        CommandSearchMode.Action => "bi-lightning-charge",
        CommandSearchMode.People => "bi-person-lines-fill",
        _ => "bi-search"
    };
    private string Placeholder => SharedDataService.SelectViewLang(
        "Search pages. Use / for pages, > for actions, @ for people later.",
        "\u0627\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0635\u0641\u062d\u0627\u062a. \u0627\u0633\u062a\u062e\u062f\u0645 / \u0644\u0644\u0635\u0641\u062d\u0627\u062a \u0648 > \u0644\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0648 @ \u0644\u0644\u0623\u0634\u062e\u0627\u0635 \u0644\u0627\u062d\u0642\u0627.");

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private bool MatchesSearch(MenuItem item)
    {
        var term = Normalize(SearchTerm);
        if (string.IsNullOrWhiteSpace(term))
        {
            return true;
        }

        var path = NavigationMenuResolver.GetMenuPath(item, ActiveWorkspace);
        var haystack = string.Join(" ", item.TextEn, item.TextAr, item.Url, item.KeywordsEn, item.KeywordsAr, string.Join(" ", path.Select(p => $"{p.TextEn} {p.TextAr}")));
        return Normalize(haystack).Contains(term);
    }

    private bool MatchesMode(MenuItem item)
        => SearchMode switch
        {
            CommandSearchMode.Action => IsActionLike(item),
            CommandSearchMode.People => false,
            _ => true
        };

    private async Task NavigateAsync(MenuItem item, bool openInNewTab)
    {
        await SaveRecentAsync(item);
        await OnNavigate.InvokeAsync(item);
        await CloseAsync();

        if (!string.IsNullOrWhiteSpace(item.Url))
        {
            if (openInNewTab)
            {
                await JSRuntime.InvokeVoidAsync("open", NavigationManager.ToAbsoluteUri(item.Url).ToString(), "_blank", "noopener");
                return;
            }

            NavigationManager.NavigateTo(item.Url);
        }
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? "";
        selectedIndex = 0;
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            await CloseAsync();
            return;
        }

        if (!VisibleResults.Any())
        {
            return;
        }

        if (args.Key == "ArrowDown")
        {
            selectedIndex = Math.Min(selectedIndex + 1, VisibleResults.Count - 1);
            return;
        }

        if (args.Key == "ArrowUp")
        {
            selectedIndex = Math.Max(selectedIndex - 1, 0);
            return;
        }

        if (args.Key == "Enter")
        {
            var item = VisibleResults[Math.Clamp(selectedIndex, 0, VisibleResults.Count - 1)];
            await NavigateAsync(item, args.CtrlKey || args.MetaKey);
        }
    }

    private async Task SaveRecentAsync(MenuItem item)
    {
        var key = NavigationMenuResolver.GetStorageKey(item);
        var existing = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", NavigationShellState.RecentStorageKey);
        var next = NavigationShellState.AddRecent(NavigationShellState.ParseKeys(existing), key);
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", NavigationShellState.RecentStorageKey, NavigationShellState.SerializeKeys(next));
    }

    private string Label(MenuItem item) => SharedDataService.SelectViewLang(item.TextEn, item.TextAr);

    private string ModeLabel(MenuItem item)
        => IsActionLike(item)
            ? SharedDataService.SelectViewLang("Action", "\u0625\u062c\u0631\u0627\u0621")
            : SharedDataService.SelectViewLang("Page", "\u0635\u0641\u062d\u0629");

    private string PathLabel(MenuItem item)
    {
        var path = NavigationMenuResolver.GetMenuPath(item, ActiveWorkspace);
        return path.Count > 0
            ? string.Join(" / ", path.Select(Label))
            : item.Url ?? "";
    }

    private async Task CloseAsync()
    {
        searchText = "";
        selectedIndex = 0;
        await IsOpenChanged.InvokeAsync(false);
    }

    private static CommandSearchMode ResolveSearchMode(string value)
    {
        var trimmed = value.TrimStart();
        if (trimmed.StartsWith("/", StringComparison.Ordinal))
        {
            return CommandSearchMode.Page;
        }

        if (trimmed.StartsWith(">", StringComparison.Ordinal))
        {
            return CommandSearchMode.Action;
        }

        if (trimmed.StartsWith("@", StringComparison.Ordinal))
        {
            return CommandSearchMode.People;
        }

        return CommandSearchMode.All;
    }

    private static string StripModePrefix(string value)
    {
        var trimmed = value.TrimStart();
        return trimmed.StartsWith("/", StringComparison.Ordinal)
               || trimmed.StartsWith(">", StringComparison.Ordinal)
               || trimmed.StartsWith("@", StringComparison.Ordinal)
            ? trimmed[1..].TrimStart()
            : value;
    }

    private static bool IsActionLike(MenuItem item)
    {
        var haystack = Normalize(string.Join(" ", item.TextEn, item.TextAr, item.Url, item.KeywordsEn, item.KeywordsAr));
        return haystack.Contains("create")
               || haystack.Contains("new")
               || haystack.Contains("add")
               || haystack.Contains("assign")
               || haystack.Contains("approve")
               || haystack.Contains("generate")
               || haystack.Contains("upload")
               || haystack.Contains("setup")
               || haystack.Contains("configuration")
               || haystack.Contains("\u0625\u0646\u0634\u0627\u0621")
               || haystack.Contains("\u0625\u0636\u0627\u0641\u0629")
               || haystack.Contains("\u062a\u0639\u064a\u064a\u0646")
               || haystack.Contains("\u0627\u0639\u062a\u0645\u0627\u062f");
    }

    private static string Normalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        var normalized = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);
        foreach (var character in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(character);
            if (category is UnicodeCategory.NonSpacingMark or UnicodeCategory.SpacingCombiningMark or UnicodeCategory.EnclosingMark || character == '\u0640')
            {
                continue;
            }

            builder.Append(char.ToLowerInvariant(character));
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

    private enum CommandSearchMode
    {
        All,
        Page,
        Action,
        People
    }
}
