@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@inject SharedDataService SharedDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@implements IDisposable

<nav class="navbar navbar-expand-lg erp-topbar px-3">
    <div class="d-flex align-items-center min-w-0 topbar-context">
        <button class="btn erp-icon-btn me-2 topbar-command-btn d-none d-lg-inline-flex"
                title="@SharedDataService.SelectViewLang("Search", "\u0628\u062d\u062b")"
                aria-label="@SharedDataService.SelectViewLang("Search navigation", "\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u062a\u0646\u0642\u0644")"
                @onclick="() => OnOpenCommand.InvokeAsync()">
            <i class="bi bi-search"></i>
        </button>

        @if (ActiveWorkspaceChanged.HasDelegate && OnOpenMore.HasDelegate)
        {
            <MobileWorkspaceSwitcher ActiveWorkspace="@ActiveWorkspace"
                                     IsMoreOpen="@IsMoreOpen"
                                     AuthState="@(ShellAuthState ?? authState)"
                                     LicensedBusinessLineKeys="@LicensedBusinessLineKeys"
                                     ActiveWorkspaceChanged="ActiveWorkspaceChanged"
                                     OnOpenMore="OnOpenMore" />
        }

        @if (IsEnterpriseNext)
        {
            <div class="enterprise-topbar-context min-w-0">
                <div class="enterprise-context-primary">
                    <span class="enterprise-app-pill">
                        <i class="bi @ActiveWorkspaceIcon"></i>
                        @WorkspaceLabel
                    </span>
                    <button type="button"
                            class="enterprise-command-trigger"
                            @onclick="() => OnOpenCommand.InvokeAsync()">
                        <i class="bi bi-search"></i>
                        <span>@SharedDataService.SelectViewLang("Search or jump to page", "\u0627\u0628\u062d\u062b \u0623\u0648 \u0627\u0646\u062a\u0642\u0644 \u0644\u0635\u0641\u062d\u0629")</span>
                        <kbd>Ctrl K</kbd>
                    </button>
                </div>
                <ol class="enterprise-context-trail" aria-label="Workspace trail">
                    @if (ActivePath.Count == 0)
                    {
                        <li>@CurrentTitle</li>
                    }
                    else
                    {
                        @foreach (var item in ActivePath)
                        {
                            <li class="@(ReferenceEquals(item, ActivePath.LastOrDefault()) ? "is-current" : "")">
                                @SharedDataService.SelectViewLang(item.TextEn, item.TextAr)
                            </li>
                        }
                    }
                </ol>
            </div>
        }
        else
        {
            <div class="topbar-page-context min-w-0">
                <span class="erp-topbar-title">@CurrentTitle</span>
                @if (ActivePath.Count > 1)
                {
                    <ol class="topbar-breadcrumb" aria-label="Breadcrumb">
                        @foreach (var item in ActivePath)
                        {
                            <li>@SharedDataService.SelectViewLang(item.TextEn, item.TextAr)</li>
                        }
                    </ol>
                }
            </div>
        }
    </div>

    <div class="ms-auto d-flex align-items-center topbar-actions">
        <ThemeSelector />

        <button @onclick="async () => { await SharedDataService.UpdateLanguageAsync(); }"
                class="btn erp-icon-btn ms-2"
                aria-label="@SharedDataService.SelectViewLang("Change language", "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0644\u063a\u0629")"
                title="@SharedDataService.SelectViewLang("Change language", "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0644\u063a\u0629")">
            <span>@(SharedDataService.Language == "Ar" ? "Eng" : "\u0639")</span>
            <i class="bi bi-globe"></i>
        </button>

        <div class="dropdown">
            <button class="btn erp-icon-btn dropdown-toggle ms-2 topbar-user-button"
                    data-bs-toggle="dropdown"
                    aria-label="@SharedDataService.SelectViewLang("Open user menu", "\u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645")"
                    aria-expanded="false">
                <span class="topbar-user-avatar">@UserInitials</span>
                <span class="topbar-user-name">@UserDisplayName</span>
            </button>

            <ul class="dropdown-menu dropdown-menu-end">
                <li><span class="dropdown-header">@UserDisplayName</span></li>
                <li>
                    <a @onclick="LogoutAsync" class="dropdown-item">
                        @SharedDataService.SelectViewLang("Logout", "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c")
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleSidebarCollapsed { get; set; }
    [Parameter] public bool IsSidebarCollapsed { get; set; }
    [Parameter] public EventCallback OnOpenCommand { get; set; }
    [Parameter] public EventCallback OnOpenMore { get; set; }
    [Parameter] public EventCallback<string> ActiveWorkspaceChanged { get; set; }
    [Parameter] public string ActiveWorkspace { get; set; } = NavigationMenuResolver.WorkspaceHome;
    [Parameter] public bool IsMoreOpen { get; set; }
    [Parameter] public AuthenticationState? ShellAuthState { get; set; }
    [Parameter] public IReadOnlySet<string>? LicensedBusinessLineKeys { get; set; }
    [Parameter] public bool IsEnterpriseNext { get; set; }

    private AuthenticationState? authState;
    private IReadOnlyList<MenuItem> ActivePath { get; set; } = Array.Empty<MenuItem>();

    private string CurrentTitle
        => ActivePath.LastOrDefault() is { } activeItem
            ? SharedDataService.SelectViewLang(activeItem.TextEn, activeItem.TextAr)
            : SharedDataService.SelectViewLang("Dashboard", "\u0644\u0648\u062d\u0629 \u0627\u0644\u062a\u062d\u0643\u0645");

    private NavigationWorkspace? ActiveWorkspaceModel
        => NavigationMenuResolver.MobileWorkspaces.FirstOrDefault(item => item.Key == ActiveWorkspace);

    private string WorkspaceLabel
        => ActiveWorkspaceModel is { } workspace
            ? SharedDataService.SelectViewLang(workspace.TextEn, workspace.TextAr)
            : SharedDataService.SelectViewLang("Workspace", "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644");

    private string ActiveWorkspaceIcon => ActiveWorkspaceModel?.Icon ?? "bi-grid-3x3-gap";

    private string UserDisplayName
    {
        get
        {
            var user = (ShellAuthState ?? authState)?.User;
            return FirstClaimValue(user, ClaimTypes.Name, "name", "unique_name", "email", "sub")
                   ?? SharedDataService.SelectViewLang("Administrator", "\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645");
        }
    }

    private string UserInitials
    {
        get
        {
            var name = UserDisplayName.Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                return "A";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 1)
            {
                return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
            }

            return name[..Math.Min(2, name.Length)].ToUpperInvariant();
        }
    }

    protected override void OnInitialized()
    {
        UpdateActivePath();
        SharedDataService.OnChange1 += HandleChangeAsync;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    protected override void OnParametersSet()
    {
        UpdateActivePath();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LogoutAsync()
    {
        await ((CustomAuthStateProvider)AuthenticationStateProvider).NotifyUserLogout();
        NavigationManager.NavigateTo("/", true);
    }

    private void UpdateActivePath()
    {
        ActivePath = NavigationMenuResolver.GetActivePath(NavigationManager.Uri, NavigationManager.BaseUri, ActiveWorkspace);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        UpdateActivePath();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private static string? FirstClaimValue(ClaimsPrincipal? user, params string[] claimTypes)
        => claimTypes
            .Select(type => user?.Claims.FirstOrDefault(c => c.Type == type)?.Value)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
