@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@inherits LayoutComponentBase
@implements IDisposable

@inject SharedDataService SharedDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ITaskManagementService TaskManagementService

@* @Body *@
@* <div class="d-flex vh-100"> *@
<div class="erp-shell mobile-first-shell d-flex vh-100 overflow-hidden">
    <DesktopWorkspaceNav ActiveWorkspace="@activeWorkspace"
                         ActiveWorkspaceChanged="SetActiveWorkspaceAsync"
                         AuthState="@AuthState"
                         OnOpenCommand="OpenCommandPalette" />

    <!-- Main Area -->
    @* <div class="flex-grow-1 d-flex flex-column"> *@
    <div class="flex-grow-1 d-flex flex-column min-vw-0">
        <!-- Top Navbar -->
        <TopNavbar OnOpenCommand="OpenCommandPalette"
                   OnOpenMore="OpenMoreHub"
                   ActiveWorkspace="@activeWorkspace"
                   ActiveWorkspaceChanged="SetActiveWorkspaceAsync"
                   IsMoreOpen="@isMoreHubOpen"
                   ShellAuthState="@AuthState" />
        
        <!-- Page Content -->
        @* <main class="flex-grow-1 p-3 overflow-auto bg-light" dir="@SharedDataService.PageDirection"> *@
        <main class="erp-main flex-grow-1 overflow-auto min-w-0"
              dir="@SharedDataService.PageDirection">
            @Body
        </main>


        <AppModal />
        <AppToast />
        <AppLoader />


    </div>

    <MobileActionBar IsMoreOpen="@isMoreHubOpen"
                     OnOpenCommand="OpenCommandPalette"
                     OnOpenWorkspace="OpenWorkspaceHub"
                     OnOpenRecent="OpenRecentHub"
                     OnOpenFavorites="OpenFavoritesHub"
                     OnOpenMore="OpenMoreHub" />

    <MoreHub IsOpen="@isMoreHubOpen"
             IsOpenChanged="SetMoreHubOpen"
             InitialView="@moreHubInitialView"
             ActiveWorkspace="@activeWorkspace"
             AuthState="@AuthState"
             OnNavigate="OnNavigationItemSelectedAsync" />

    <CommandPalette IsOpen="@isCommandPaletteOpen"
                    IsOpenChanged="SetCommandPaletteOpen"
                    ActiveWorkspace="@activeWorkspace"
                    AuthState="@AuthState"
                    OnNavigate="OnNavigationItemSelectedAsync" />

</div>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private AuthenticationState? AuthState;

    private string activeWorkspace = NavigationMenuResolver.WorkspaceHome;
    private string moreHubInitialView = MoreHub.ViewDirectory;
    private bool isMoreHubOpen;
    private bool isCommandPaletteOpen;
    private DotNetObjectReference<AdminLayout>? shortcutReference;

    protected override async Task OnInitializedAsync()
    {

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
            if (AuthState.User.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("login", true);
            }
            else
            {
                await RunTaskDailyCheckSilentlyAsync();
            }
            activeWorkspace = await LoadActiveWorkspaceAsync();
            shortcutReference = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("alafkarNavigation.bindShortcuts", shortcutReference);
            await InvokeAsync(StateHasChanged);
            // NavigationManager.NavigateTo("/login");
        }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task<string> LoadActiveWorkspaceAsync()
    {
        string resolvedWorkspace;
        try
        {
            var stored = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", NavigationShellState.ActiveWorkspaceStorageKey);
            resolvedWorkspace = NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri, stored);
        }
        catch (InvalidOperationException)
        {
            resolvedWorkspace = NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri);
        }
        catch (JSException)
        {
            resolvedWorkspace = NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri);
        }

        return EnsureAuthorizedWorkspace(resolvedWorkspace);
    }

    private async Task SetActiveWorkspaceAsync(string workspaceKey)
    {
        activeWorkspace = EnsureAuthorizedWorkspace(workspaceKey);
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", NavigationShellState.ActiveWorkspaceStorageKey, activeWorkspace);
        }
        catch (JSException)
        {
        }
    }

    private string EnsureAuthorizedWorkspace(string workspaceKey)
    {
        var authorizedWorkspaces = NavigationMenuResolver.GetAuthorizedWorkspaces(AuthState?.User);
        if (authorizedWorkspaces.Any(workspace => workspace.Key == workspaceKey))
        {
            return workspaceKey;
        }

        var routeWorkspace = NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri);
        if (authorizedWorkspaces.Any(workspace => workspace.Key == routeWorkspace))
        {
            return routeWorkspace;
        }

        return authorizedWorkspaces.FirstOrDefault()?.Key ?? NavigationMenuResolver.WorkspaceHome;
    }

    private void OpenMoreHub()
    {
        moreHubInitialView = MoreHub.ViewDirectory;
        isMoreHubOpen = true;
    }

    private void OpenWorkspaceHub()
    {
        moreHubInitialView = MoreHub.ViewWorkspace;
        isMoreHubOpen = true;
    }

    private void OpenRecentHub()
    {
        moreHubInitialView = MoreHub.ViewRecent;
        isMoreHubOpen = true;
    }

    private void OpenFavoritesHub()
    {
        moreHubInitialView = MoreHub.ViewFavorites;
        isMoreHubOpen = true;
    }

    private void OpenCommandPalette()
    {
        isCommandPaletteOpen = true;
    }

    [JSInvokable]
    public async Task OpenCommandPaletteFromShortcut()
    {
        isCommandPaletteOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task SetMoreHubOpen(bool value)
    {
        isMoreHubOpen = value;
        return Task.CompletedTask;
    }

    private Task SetCommandPaletteOpen(bool value)
    {
        isCommandPaletteOpen = value;
        return Task.CompletedTask;
    }

    private async Task OnNavigationItemSelectedAsync(MenuItem item)
    {
        await SetActiveWorkspaceAsync(NavigationMenuResolver.ResolveNavigationWorkspace(item, activeWorkspace));
    }

    private async Task RunTaskDailyCheckSilentlyAsync()
    {
        try
        {
            await TaskManagementService.RunMyDailyCheckAsync();
        }
        catch
        {
        }
    }

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs args)
    {
        activeWorkspace = EnsureAuthorizedWorkspace(NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri, activeWorkspace));
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
        NavigationManager.LocationChanged -= HandleLocationChanged;
        _ = JSRuntime.InvokeVoidAsync("alafkarNavigation.unbindShortcuts");
        shortcutReference?.Dispose();
    }
}
