@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@implements IDisposable

<aside class="enterprise-nav-shell" aria-label="@Text("Enterprise navigation", "\u062a\u0646\u0642\u0644 \u0627\u0644\u0645\u0624\u0633\u0633\u0629")">
    <nav class="enterprise-app-switcher" aria-label="@Text("Applications", "\u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a")">
        <button type="button"
                class="enterprise-app-button enterprise-command-button"
                title="@Text("Command search", "\u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0627\u0645\u0631")"
                aria-label="@Text("Command search", "\u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0627\u0645\u0631")"
                @onclick="() => OnOpenCommand.InvokeAsync()">
            <i class="bi bi-command"></i>
            <span>Ctrl K</span>
        </button>

        <div class="enterprise-app-list">
            @foreach (var workspace in AuthorizedWorkspaces.Where(item => item.Key != NavigationMenuResolver.WorkspaceMore))
            {
                <button type="button"
                        class="enterprise-app-button @(ActiveWorkspace == workspace.Key ? "is-active" : "")"
                        title="@Label(workspace)"
                        aria-label="@Label(workspace)"
                        aria-current="@(ActiveWorkspace == workspace.Key ? "page" : null)"
                        @onclick="() => SelectWorkspaceAsync(workspace)">
                    <i class="bi @workspace.Icon"></i>
                    <span>@Label(workspace)</span>
                </button>
            }
        </div>

        @if (AuthorizedWorkspaces.Any(item => item.Key == NavigationMenuResolver.WorkspaceMore))
        {
            <button type="button"
                    class="enterprise-app-button @(ActiveWorkspace == NavigationMenuResolver.WorkspaceMore ? "is-active" : "")"
                    title="@Text("All apps", "\u0643\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a")"
                    aria-label="@Text("All apps", "\u0643\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a")"
                    @onclick="SelectMoreAsync">
                <i class="bi bi-grid-3x3-gap"></i>
                <span>@Text("All", "\u0627\u0644\u0643\u0644")</span>
            </button>
        }
    </nav>

    <section class="enterprise-nav-panel">
        <CompanySwitcher AuthState="@AuthState" />

        <header class="enterprise-workspace-header">
            <div>
                <span>@Text("Workspace", "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644")</span>
                <strong>@WorkspaceLabel</strong>
            </div>
            <button type="button"
                    class="btn erp-icon-btn"
                    title="@Text("Open command search", "\u0641\u062a\u062d \u0628\u062d\u062b \u0627\u0644\u0623\u0648\u0627\u0645\u0631")"
                    @onclick="() => OnOpenCommand.InvokeAsync()">
                <i class="bi bi-search"></i>
            </button>
        </header>

        <div class="enterprise-nav-search">
            <i class="bi bi-search"></i>
            <input class="form-control"
                   value="@searchText"
                   @oninput="OnSearchInput"
                   placeholder="@Text("Search pages in this workspace", "\u0627\u0628\u062d\u062b \u0641\u064a \u0635\u0641\u062d\u0627\u062a \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u062d\u0629")" />
            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                <button type="button"
                        class="btn erp-icon-btn btn-sm"
                        title="@Text("Clear", "\u0645\u0633\u062d")"
                        @onclick="ClearSearch">
                    <i class="bi bi-x-lg"></i>
                </button>
            }
        </div>

        @if (ShouldUseFunctionalDrilldown)
        {
            <div class="enterprise-functional-list" role="list" aria-label="@Text("Functional areas", "\u0627\u0644\u0645\u062c\u0627\u0644\u0627\u062a \u0627\u0644\u0648\u0638\u064a\u0641\u064a\u0629")">
                @foreach (var group in FunctionalGroups)
                {
                    var journeyGroups = VisibleGroupsForFunctionalGroup(group.Key).ToList();
                    var entryCount = journeyGroups.SelectMany(navigationGroup => FilteredEntries(navigationGroup)).Count();
                    <button type="button"
                            class="enterprise-functional-button @(IsFunctionalGroupExpanded(group.Key) ? "is-active" : "")"
                            aria-current="@(IsFunctionalGroupExpanded(group.Key) ? "page" : null)"
                            @onclick="() => SelectFunctionalGroup(group)">
                        <span class="enterprise-functional-icon"><i class="bi @group.Icon"></i></span>
                        <span>
                            <strong>@Label(group)</strong>
                            <small>@Text($"{entryCount} pages", $"{entryCount} \u0635\u0641\u062d\u0627\u062a")</small>
                        </span>
                    </button>
                }
            </div>

            @if (QuickEntries.Any())
            {
                <section class="enterprise-quick-section" aria-label="@Text("Quick links", "\u0631\u0648\u0627\u0628\u0637 \u0633\u0631\u064a\u0639\u0629")">
                    <div class="enterprise-flat-heading">
                        <span>@Text("Quick links", "\u0631\u0648\u0627\u0628\u0637 \u0633\u0631\u064a\u0639\u0629")</span>
                    </div>
                    <div class="enterprise-quick-list">
                        @foreach (var entry in QuickEntries)
                        {
                            <button type="button"
                                    class="@EnterpriseQuickLinkClass(entry)"
                                    disabled="@(!CanNavigate(entry.Item))"
                                    @onclick="() => NavigateAsync(entry.Item)">
                                <i class="bi @entry.Item.Icon"></i>
                                <span>@Label(entry.Item)</span>
                            </button>
                        }
                    </div>
                </section>
            }

            <div class="enterprise-section-list enterprise-flat-list">
                @if (!VisibleGroups.Any())
                {
                    <div class="enterprise-nav-empty">
                        <i class="bi bi-search"></i>
                        <strong>@Text("No pages found", "\u0644\u0627 \u062a\u0648\u062c\u062f \u0635\u0641\u062d\u0627\u062a")</strong>
                        <span>@Text("Try another area or search term.", "\u062c\u0631\u0628 \u0645\u062c\u0627\u0644\u0627\u064b \u0622\u062e\u0631 \u0623\u0648 \u0643\u0644\u0645\u0629 \u0628\u062d\u062b \u0645\u062e\u062a\u0644\u0641\u0629.")</span>
                    </div>
                }
                else
                {
                    @foreach (var group in VisibleGroups)
                    {
                        var entries = FilteredEntries(group).ToList();
                        <section class="enterprise-flat-section">
                            <header class="enterprise-flat-heading">
                                <span class="enterprise-section-icon"><i class="bi @group.Icon"></i></span>
                                <span>
                                    <strong>@Label(group)</strong>
                                    <small>@Text($"{entries.Count} pages", $"{entries.Count} \u0635\u0641\u062d\u0627\u062a")</small>
                                </span>
                            </header>
                            <div class="enterprise-link-list">
                                @foreach (var entry in entries)
                                {
                                    @LinkRow(entry)
                                }
                            </div>
                        </section>
                    }
                }
            </div>
        }
        else
        {
            <div class="enterprise-section-list enterprise-flat-list">
            @if (!VisibleGroups.Any())
            {
                <div class="enterprise-nav-empty">
                    <i class="bi bi-search"></i>
                    <strong>@Text("No pages found", "\u0644\u0627 \u062a\u0648\u062c\u062f \u0635\u0641\u062d\u0627\u062a")</strong>
                    <span>@Text("Try another workspace or search term.", "\u062c\u0631\u0628 \u0645\u0633\u0627\u062d\u0629 \u0623\u062e\u0631\u0649 \u0623\u0648 \u0643\u0644\u0645\u0629 \u0628\u062d\u062b \u0645\u062e\u062a\u0644\u0641\u0629.")</span>
                </div>
            }
            else
            {
                @foreach (var group in VisibleGroups)
                {
                    var entries = FilteredEntries(group).ToList();
                    <section class="enterprise-flat-section">
                        <header class="enterprise-flat-heading">
                            <span class="enterprise-section-icon"><i class="bi @group.Icon"></i></span>
                            <span>
                                <strong>@Label(group)</strong>
                                <small>@GroupKindLabel(group.Kind) &middot; @Text($"{entries.Count} pages", $"{entries.Count} \u0635\u0641\u062d\u0627\u062a")</small>
                            </span>
                        </header>

                        <div class="enterprise-link-list">
                            @foreach (var entry in entries)
                            {
                                @LinkRow(entry)
                            }
                        </div>
                    </section>
                }
            }
            </div>
        }
    </section>
</aside>

@code {
    [Parameter] public string ActiveWorkspace { get; set; } = NavigationMenuResolver.WorkspaceHome;
    [Parameter] public EventCallback<string> ActiveWorkspaceChanged { get; set; }
    [Parameter] public AuthenticationState? AuthState { get; set; }
    [Parameter] public IReadOnlySet<string>? LicensedBusinessLineKeys { get; set; }
    [Parameter] public EventCallback OnOpenCommand { get; set; }

    private IReadOnlyList<string> favoriteKeys = [];
    private IReadOnlyList<string> recentKeys = [];
    private string searchText = "";
    private string? selectedFunctionalGroupKey;

    private IReadOnlyList<NavigationWorkspace> AuthorizedWorkspaces => NavigationMenuResolver.GetAuthorizedWorkspaces(AuthState?.User, LicensedBusinessLineKeys);
    private IEnumerable<MenuItem> AuthorizedItems => NavigationMenuResolver.GetAuthorizedNavigableItems(AuthState?.User, LicensedBusinessLineKeys);
    private IReadOnlyList<NavigationFunctionalGroup> FunctionalGroups => NavigationMenuResolver.GetAuthorizedWorkspaceFunctionalGroups(AuthState?.User, FunctionalWorkspaceKey, LicensedBusinessLineKeys);
    private IReadOnlyList<EnterpriseNavigationGroup> Groups => NavigationMenuResolver.GetEnterpriseNavigationGroups(AuthState?.User, EnterpriseWorkspaceKey, CurrentPath, LicensedBusinessLineKeys, EffectiveFunctionalGroupKey);
    private IEnumerable<EnterpriseNavigationGroup> VisibleGroups => Groups.Where(group => FilteredEntries(group).Any());
    private IReadOnlyList<EnterpriseNavigationEntry> QuickEntries => VisibleGroups
        .SelectMany(FilteredEntries)
        .GroupBy(entry => NavigationMenuResolver.GetStorageKey(entry.Item), StringComparer.OrdinalIgnoreCase)
        .Select(group => group.OrderBy(GetQuickPriority).ThenBy(entry => entry.Priority).First())
        .OrderBy(GetQuickPriority)
        .ThenBy(entry => entry.Priority)
        .ThenBy(entry => Label(entry.Item))
        .Take(5)
        .ToList();
    private IEnumerable<MenuItem> FavoriteItems => NavigationPanelShared.ResolveKeys(favoriteKeys, AuthorizedItems).Where(MatchesCurrentWorkspace);
    private IEnumerable<MenuItem> RecentItems => NavigationPanelShared.ResolveKeys(recentKeys, AuthorizedItems).Where(MatchesCurrentWorkspace);
    private string CurrentPath => NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
    private string EnterpriseWorkspaceKey => ActiveWorkspace == NavigationMenuResolver.WorkspaceMore
        ? NavigationMenuResolver.WorkspaceMore
        : NavigationMenuResolver.ResolveEnterpriseWorkspaceKey(ActiveWorkspace);
    private string FunctionalWorkspaceKey => ActiveWorkspace == NavigationMenuResolver.WorkspaceMore
        ? NavigationMenuResolver.WorkspaceMore
        : ActiveWorkspace;
    private bool IsFunctionalWorkspace => ActiveWorkspace != NavigationMenuResolver.WorkspaceMore
        && NavigationMenuResolver.HasFunctionalGroups(FunctionalWorkspaceKey);
    private bool ShouldUseFunctionalDrilldown => IsFunctionalWorkspace && string.IsNullOrWhiteSpace(searchText);
    private string? EffectiveFunctionalGroupKey => ShouldUseFunctionalDrilldown ? selectedFunctionalGroupKey : null;

    private string WorkspaceLabel
        => ActiveWorkspace == NavigationMenuResolver.WorkspaceMore
            ? Text("All apps", "\u0643\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a")
            : AuthorizedWorkspaces
                .Where(item => item.Key == ActiveWorkspace)
                .Select(Label)
                .FirstOrDefault() ?? Text("Workspace", "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644");

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        NavigationManager.LocationChanged += HandleLocationChanged;
        await LoadStateAsync();
        SyncSelectedFunctionalGroupWithCurrentPath();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadStateAsync();
        SyncSelectedFunctionalGroupWithCurrentPath();
    }

    private async Task SelectWorkspaceAsync(NavigationWorkspace workspace)
    {
        await ActiveWorkspaceChanged.InvokeAsync(workspace.Key);
        if (NavigationMenuResolver.HasFunctionalGroups(workspace.Key))
        {
            selectedFunctionalGroupKey = ResolveFunctionalGroupForWorkspace(workspace.Key);
            return;
        }

        selectedFunctionalGroupKey = null;
        var url = NavigationMenuResolver.GetWorkspaceDefaultUrl(workspace.Key, AuthState?.User, LicensedBusinessLineKeys);
        if (!string.IsNullOrWhiteSpace(url))
        {
            NavigationManager.NavigateTo(url);
        }
    }

    private async Task SelectMoreAsync()
    {
        selectedFunctionalGroupKey = null;
        await ActiveWorkspaceChanged.InvokeAsync(NavigationMenuResolver.WorkspaceMore);
    }

    private void SelectFunctionalGroup(NavigationFunctionalGroup group)
    {
        selectedFunctionalGroupKey = group.Key;
    }

    private async Task NavigateAsync(MenuItem item)
    {
        if (!CanNavigate(item))
        {
            return;
        }

        await ActiveWorkspaceChanged.InvokeAsync(NavigationMenuResolver.ResolveNavigationWorkspace(item, ActiveWorkspace));
        await SaveRecentAsync(item);
        NavigationManager.NavigateTo(item.Url!);
    }

    private IEnumerable<EnterpriseNavigationEntry> FilteredEntries(EnterpriseNavigationGroup group)
        => NavigationPanelShared.FilterEntries(group, searchText, AuthState?.User, LicensedBusinessLineKeys);

    private IEnumerable<EnterpriseNavigationGroup> VisibleGroupsForFunctionalGroup(string functionalGroupKey)
        => NavigationMenuResolver
            .GetEnterpriseNavigationGroups(AuthState?.User, EnterpriseWorkspaceKey, CurrentPath, LicensedBusinessLineKeys, functionalGroupKey)
            .Where(group => FilteredEntries(group).Any());

    private bool MatchesCurrentWorkspace(MenuItem item)
        => NavigationPanelShared.MatchesCurrentWorkspace(item, ActiveWorkspace, Groups);

    private bool CanNavigate(MenuItem item)
        => NavigationPanelShared.CanNavigate(item, AuthState?.User, LicensedBusinessLineKeys);

    private bool CanFavorite(MenuItem item)
        => item.IsFavoriteCandidate && CanNavigate(item);

    private bool IsFavorite(MenuItem item)
        => favoriteKeys.Contains(NavigationMenuResolver.GetStorageKey(item), StringComparer.OrdinalIgnoreCase);

    private string EnterpriseLinkClass(EnterpriseNavigationEntry entry)
    {
        var classes = new List<string> { "enterprise-nav-link" };
        if (IsActive(entry.Item))
        {
            classes.Add("is-active");
        }

        if (entry.IsRelated)
        {
            classes.Add("is-related");
        }

        return string.Join(" ", classes);
    }

    private string EnterpriseQuickLinkClass(EnterpriseNavigationEntry entry)
    {
        var classes = new List<string> { "enterprise-quick-link" };
        if (IsActive(entry.Item))
        {
            classes.Add("is-active");
        }

        return string.Join(" ", classes);
    }

    private bool IsActive(MenuItem item)
        => NavigationMenuResolver.IsPathWithinItem(CurrentPath, item);

    private int GetQuickPriority(EnterpriseNavigationEntry entry)
    {
        if (IsActive(entry.Item))
        {
            return -100;
        }

        return entry.Kind switch
        {
            EnterpriseNavigationGroupKind.Start => 0,
            EnterpriseNavigationGroupKind.DailyWork => 10,
            EnterpriseNavigationGroupKind.Approvals => 20,
            _ => 100 + entry.Priority
        };
    }

    private bool IsFunctionalGroupExpanded(string functionalGroupKey)
        => string.Equals(selectedFunctionalGroupKey, functionalGroupKey, StringComparison.OrdinalIgnoreCase);

    private async Task OnSearchInput(ChangeEventArgs args)
    {
        searchText = args.Value?.ToString() ?? "";
        await InvokeAsync(StateHasChanged);
    }

    private void ClearSearch()
    {
        searchText = "";
        SyncSelectedFunctionalGroupWithCurrentPath();
    }

    private async Task SaveRecentAsync(MenuItem item)
    {
        recentKeys = NavigationShellState.AddRecent(recentKeys, NavigationMenuResolver.GetStorageKey(item));
        await TrySetLocalStorageItemAsync(NavigationShellState.RecentStorageKey, NavigationShellState.SerializeKeys(recentKeys));
    }

    private async Task ToggleFavoriteAsync(MenuItem item)
    {
        var key = NavigationMenuResolver.GetStorageKey(item);
        favoriteKeys = IsFavorite(item)
            ? favoriteKeys.Where(existingKey => !string.Equals(existingKey, key, StringComparison.OrdinalIgnoreCase)).ToList()
            : favoriteKeys.Concat([key]).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

        await TrySetLocalStorageItemAsync(NavigationShellState.FavoriteStorageKey, NavigationShellState.SerializeKeys(favoriteKeys));
    }

    private async Task LoadStateAsync()
    {
        favoriteKeys = NavigationShellState.ParseKeys(await TryGetLocalStorageItemAsync(NavigationShellState.FavoriteStorageKey));
        recentKeys = NavigationShellState.ParseKeys(await TryGetLocalStorageItemAsync(NavigationShellState.RecentStorageKey));
    }

    private async Task<string?> TryGetLocalStorageItemAsync(string key)
    {
        try
        {
            return await JSRuntime.InvokeAsync<string?>("localStorage.getItem", key);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (OperationCanceledException)
        {
        }

        return null;
    }

    private async Task TrySetLocalStorageItemAsync(string key, string value)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", key, value);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string GroupKindLabel(EnterpriseNavigationGroupKind kind)
        => NavigationPanelShared.GroupKindLabel(kind, Text);

    private string FavoriteTitle(MenuItem item)
        => NavigationPanelShared.FavoriteTitle(item, IsFavorite(item), Text);

    private string Label(NavigationWorkspace workspace) => Text(workspace.TextEn, workspace.TextAr);
    private string Label(NavigationFunctionalGroup group) => Text(group.TextEn, group.TextAr);
    private string Label(EnterpriseNavigationGroup group) => Text(group.TextEn, group.TextAr);
    private string Label(MenuItem item) => Text(item.TextEn, item.TextAr);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private RenderFragment<EnterpriseNavigationEntry> LinkRow => entry => @<div class="enterprise-link-row depth-@Math.Min(entry.Depth, 4) priority-@entry.Priority">
        <button type="button"
                class="@EnterpriseLinkClass(entry)"
                disabled="@(!CanNavigate(entry.Item))"
                @onclick="() => NavigateAsync(entry.Item)">
            <i class="bi @entry.Item.Icon"></i>
            <span>
                <strong>@Label(entry.Item)</strong>
                <small>@PathLabel(entry)</small>
            </span>
        </button>
        @if (CanFavorite(entry.Item))
        {
            <button type="button"
                    class="btn enterprise-favorite-toggle @(IsFavorite(entry.Item) ? "is-active" : "")"
                    title="@FavoriteTitle(entry.Item)"
                    aria-label="@FavoriteTitle(entry.Item)"
                    @onclick="() => ToggleFavoriteAsync(entry.Item)">
                <i class="bi @(IsFavorite(entry.Item) ? "bi-star-fill" : "bi-star")"></i>
            </button>
        }
    </div>;

    private string PathLabel(EnterpriseNavigationEntry entry)
        => entry.Path.Count > 1
            ? string.Join(" / ", entry.Path.Select(Label).Take(Math.Max(1, entry.Path.Count - 1)))
            : entry.Item.Url ?? "";

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        SyncSelectedFunctionalGroupWithCurrentPath();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncSelectedFunctionalGroupWithCurrentPath()
    {
        if (!IsFunctionalWorkspace)
        {
            selectedFunctionalGroupKey = null;
            return;
        }

        selectedFunctionalGroupKey = ResolveFunctionalGroupForWorkspace(FunctionalWorkspaceKey);
    }

    private string? ResolveFunctionalGroupForWorkspace(string workspaceKey)
    {
        var authorizedGroups = NavigationMenuResolver.GetAuthorizedWorkspaceFunctionalGroups(AuthState?.User, workspaceKey, LicensedBusinessLineKeys);
        if (authorizedGroups.Count == 0)
        {
            return null;
        }

        var activeFunctionalGroupKey = NavigationMenuResolver.ResolveActiveFunctionalGroupKey(
            NavigationManager.Uri,
            NavigationManager.BaseUri,
            workspaceKey);

        if (!string.IsNullOrWhiteSpace(activeFunctionalGroupKey)
            && authorizedGroups.Any(group => string.Equals(group.Key, activeFunctionalGroupKey, StringComparison.OrdinalIgnoreCase)))
        {
            return activeFunctionalGroupKey;
        }

        if (!string.IsNullOrWhiteSpace(selectedFunctionalGroupKey)
            && authorizedGroups.Any(group => string.Equals(group.Key, selectedFunctionalGroupKey, StringComparison.OrdinalIgnoreCase)))
        {
            return selectedFunctionalGroupKey;
        }

        return authorizedGroups.First().Key;
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
