@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
<li class="nav-item">

    @if (HasChildren)
    {
        @*     <div class="nav-link text-white
    @(IsActive ? "active bg-primary" : IsParentActive ? "bg-secondary" : "")"> *@

        <!-- Parent (ONLY for items with children) -->
        if (authState != null && !string.IsNullOrEmpty(Item.PermissionPolicy) && authState.User.Claims.Any(c => c.Value == Item.PermissionPolicy))
        {
            
        <div class="nav-link text-white d-flex justify-content-between align-items-center
            class=@(IsActive ? "nav-link text-white active bg-primary" : "nav-link text-white")
            style="cursor:pointer"
             @onclick="Toggle">

            <div>
                <i class="bi @Item.Icon me-2"></i>
                @SharedDataService.SelectViewLang(Item.TextEn, Item.TextAr)
            </div>

            <i class="bi @(Item.IsOpen ? "bi-chevron-down" : "bi-chevron-right")"></i>
        </div>
        }
    }
    else if (!string.IsNullOrEmpty(Item.Url))
    {
        @* class="nav-link text-white @(IsActive ? "active bg-primary" : "")" *@
        <!-- Leaf (ONLY once, no duplication) -->
        @* <AuthorizeView Roles="@Item.PermissionPolicy">
            <Authorized>
                authorized
            </Authorized>
            <NotAuthorized>
                    <a class="nav-link text-white disabled" href="#" tabindex="-1" aria-disabled="true">
                        <i class="bi @Item.Icon me-2"></i>
                        @SharedDataService.SelectViewLang(Item.TextEn,Item.TextAr) not authorized
                </a>
            </NotAuthorized>
        </AuthorizeView> *@
        if (authState != null && !string.IsNullOrEmpty(Item.PermissionPolicy) && authState.User.Claims.Any(c => c.Value == Item.PermissionPolicy))
        {
            
        <NavLink href="@Item.Url"
                 class=@(IsActive ? "nav-link text-white active bg-primary" : "nav-link text-white")
                 Match="NavLinkMatch.All" ActiveClass="">
            <i class="bi @Item.Icon me-2"></i>
            @SharedDataService.SelectViewLang(Item.TextEn, Item.TextAr)
        </NavLink>
        }
    }

    <!-- Children -->
    @if (HasChildren && Item.IsOpen)
    {

        @if (authState != null && !string.IsNullOrEmpty(Item.PermissionPolicy) && authState.User.Claims.Any(c => c.Value == Item.PermissionPolicy))
        {
            <ul class="nav flex-column ms-3">
            
                @foreach (var child in Item.Children)
                {
                    if (authState != null && !string.IsNullOrEmpty(Item.PermissionPolicy) && authState.User.Claims.Any(c => c.Value == child.PermissionPolicy))
                    {
                        
                        <SidebarItem Item="child" Siblings="Item.Children" />
                    }
                }
            </ul>
        }
    }

</li>
@code {
    [Parameter] public MenuItem Item { get; set; } = default!;
    [Parameter] public List<MenuItem>? Siblings { get; set; }

    private bool HasChildren => Item.Children?.Any() == true;

    private string CurrentUrl => NavigationManager.Uri.Replace(NavigationManager.BaseUri, "/");

    // private bool IsActive => IsMatch(Item);
    private bool IsActive
    {
        get
        {
            if (string.IsNullOrEmpty(Item.Url))
                return false;

            var current = Normalize(CurrentUrl);
            var target = Normalize(Item.Url);

            return current == target;
        }
    }

    private string Normalize(string url)
    {
        if (string.IsNullOrEmpty(url)) return "/";

        url = url.ToLower().TrimEnd('/');

        return string.IsNullOrEmpty(url) ? "/" : url;
    }

    // private bool IsParentActive =>
    // HasChildren && Item.Children.Any(IsMatch);
    AuthenticationState? authState;
    protected override async Task OnInitializedAsync()
    {
        authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        
    }
    protected override void OnInitialized()
    {
        AutoExpand(Item);
        SharedDataService.OnChange1 += HandleChangeAsync;
    }
    
    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
    void Toggle()
    {
        if (!HasChildren)
        {
            if (!string.IsNullOrEmpty(Item.Url))
                NavigationManager.NavigateTo(Item.Url);

            return;
        }

        // 🔥 Accordion: close siblings
        if (Siblings != null)
        {
            foreach (var sibling in Siblings)
            {
                if (sibling != Item)
                    sibling.IsOpen = false;
            }
        }

        Item.IsOpen = !Item.IsOpen;
    }

    // 🔥 Auto expand based on route
    void AutoExpand(MenuItem item)
    {
        if (IsMatch(item))
        {
            item.IsOpen = true;
        }

        foreach (var child in item.Children)
        {
            AutoExpand(child);

            if (child.IsOpen)
            {
                item.IsOpen = true;
            }
        }
    }

    // 🔥 Active route detection (recursive)
    bool IsMatch(MenuItem item)
    {
        if (!string.IsNullOrEmpty(item.Url) &&
            CurrentUrl.StartsWith(item.Url, StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        return item.Children.Any(IsMatch);
    }
    
}