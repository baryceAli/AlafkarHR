@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using System.Globalization
@using System.Text
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@implements IDisposable

<li class="nav-item sidebar-node @(HasVisibleChildren ? "has-children" : "") @(IsParentActive ? "parent-active" : "")">
    @if (HasVisibleChildren)
    {
        <button type="button"
                class="sidebar-link sidebar-parent @(IsParentActive ? "is-parent-active" : "") @(Item.IsOpen ? "is-open" : "")"
                title="@FullPathLabel"
                @onclick="ToggleAsync"
                aria-expanded="@ShouldShowChildren">
            <span class="sidebar-link-main">
                <i class="bi @Item.Icon sidebar-link-icon"></i>
                <span class="sidebar-link-copy">
                    <span class="sidebar-link-text">@Label</span>
                    @if (IsFiltering && !IsCollapsed && !string.IsNullOrWhiteSpace(ParentPathLabel))
                    {
                        <span class="sidebar-link-context">@ParentPathLabel</span>
                    }
                </span>
            </span>
            <span class="sidebar-link-trailing">
                @if (!string.IsNullOrWhiteSpace(Item.BadgeText))
                {
                    <span class="badge rounded-pill @(Item.BadgeCssClass ?? "text-bg-primary")"
                          title="@BadgeTitle">@Item.BadgeText</span>
                }
                <i class="bi @(ShouldShowChildren ? "bi-chevron-down" : "bi-chevron-right") sidebar-chevron"></i>
            </span>
        </button>

        @if (ShouldShowChildren)
        {
            <ul class="nav flex-column sidebar-submenu">
                @foreach (var child in VisibleChildren)
                {
                    <SidebarItem Item="child"
                                 Siblings="@VisibleChildren"
                                 RootItems="@RootItems"
                                 AuthState="@AuthState"
                                 SearchText="@SearchText"
                                 IsFiltering="@IsFiltering"
                                 IsCollapsed="@IsCollapsed"
                                 ParentPath="@CurrentPath"
                                 OnLeafSelected="OnLeafSelected"
                                 OnOpenStateChanged="OnOpenStateChanged" />
                }
            </ul>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Item.Url))
    {
        <NavLink href="@Item.Url"
                 class="@LeafClass"
                 Match="NavLinkMatch.All"
                 ActiveClass=""
                 title="@FullPathLabel"
                 @onclick="HandleLeafClickAsync">
            <span class="sidebar-link-main">
                <i class="bi @Item.Icon sidebar-link-icon"></i>
                <span class="sidebar-link-copy">
                    <span class="sidebar-link-text">@Label</span>
                    @if (IsFiltering && !IsCollapsed && !string.IsNullOrWhiteSpace(ParentPathLabel))
                    {
                        <span class="sidebar-link-context">@ParentPathLabel</span>
                    }
                </span>
            </span>
            @if (!string.IsNullOrWhiteSpace(Item.BadgeText))
            {
                <span class="badge rounded-pill @(Item.BadgeCssClass ?? "text-bg-primary")"
                      title="@BadgeTitle">@Item.BadgeText</span>
            }
        </NavLink>
    }
</li>

@code {
    [Parameter] public MenuItem Item { get; set; } = default!;
    [Parameter] public List<MenuItem>? Siblings { get; set; }
    [Parameter] public List<MenuItem>? RootItems { get; set; }
    [Parameter] public AuthenticationState? AuthState { get; set; }
    [Parameter] public string SearchText { get; set; } = "";
    [Parameter] public bool IsFiltering { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public IReadOnlyList<MenuItem> ParentPath { get; set; } = Array.Empty<MenuItem>();
    [Parameter] public EventCallback OnLeafSelected { get; set; }
    [Parameter] public EventCallback OnOpenStateChanged { get; set; }

    private string Label => SharedDataService.SelectViewLang(Item.TextEn, Item.TextAr);
    private IReadOnlyList<MenuItem> CurrentPath => ParentPath.Concat(new[] { Item }).ToList();
    private string ParentPathLabel => FormatPath(ParentPath);
    private string FullPathLabel => FormatPath(CurrentPath);
    private string BadgeTitle => SharedDataService.SelectViewLang(
        Item.BadgeTitleEn ?? Item.BadgeText ?? "",
        Item.BadgeTitleAr ?? Item.BadgeText ?? "");
    private string LeafClass => IsActive ? "sidebar-link sidebar-leaf is-active" : "sidebar-link sidebar-leaf";
    private bool HasVisibleChildren => VisibleChildren.Any();
    private bool ShouldShowChildren => HasVisibleChildren && !IsCollapsed && (Item.IsOpen || IsFiltering);
    private bool IsParentActive => HasVisibleChildren && (IsUrlWithinActivePath(Item.Url) || Item.Children.Any(IsMatch));
    private bool IsActive => IsUrlExactActive(Item.Url);

    private List<MenuItem> VisibleChildren
    {
        get
        {
            var authorizedChildren = Item.Children
                .Where(IsAuthorized)
                .ToList();

            if (!IsFiltering)
            {
                return authorizedChildren;
            }

            if (ItemMatchesSearch(Item))
            {
                return authorizedChildren;
            }

            return authorizedChildren
                .Where(MatchesSearch)
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AutoExpand(Item);
        NavigationManager.LocationChanged += HandleLocationChanged;
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private bool IsAuthorized(MenuItem item)
    {
        if (AuthState is null)
        {
            return false;
        }

        var hasOwnPermission = !string.IsNullOrWhiteSpace(item.PermissionPolicy)
            && AuthState.User.Claims.Any(c => c.Value == item.PermissionPolicy);

        return hasOwnPermission || item.Children.Any(IsAuthorized);
    }

    private bool MatchesSearch(MenuItem item)
    {
        if (!IsFiltering)
        {
            return true;
        }

        return ItemMatchesSearch(item) || item.Children.Where(IsAuthorized).Any(MatchesSearch);
    }

    private bool ItemMatchesSearch(MenuItem item)
    {
        var term = NormalizeSearchText(SearchText);
        if (string.IsNullOrWhiteSpace(term))
        {
            return true;
        }

        return NormalizeSearchText(item.TextEn).Contains(term)
               || NormalizeSearchText(item.TextAr).Contains(term)
               || NormalizeSearchText(item.Url).Contains(term);
    }

    private static string NormalizeSearchText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        var normalized = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var character in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(character);
            if (category is UnicodeCategory.NonSpacingMark
                or UnicodeCategory.SpacingCombiningMark
                or UnicodeCategory.EnclosingMark
                || character == '\u0640')
            {
                continue;
            }

            builder.Append(char.ToLowerInvariant(character));
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private async Task ToggleAsync()
    {
        if (!HasVisibleChildren)
        {
            if (!string.IsNullOrWhiteSpace(Item.Url))
            {
                NavigationManager.NavigateTo(Item.Url);
            }

            return;
        }

        if (Item.IsOpen && IsParentActive)
        {
            return;
        }

        CloseUnrelatedOpenNodes(Item);
        CloseSiblingNodes(Item);

        Item.IsOpen = !Item.IsOpen;
        await OnOpenStateChanged.InvokeAsync();
    }

    private async Task HandleLeafClickAsync()
    {
        CloseUnrelatedOpenNodes(Item);
        CloseSiblingNodes(Item);
        await OnOpenStateChanged.InvokeAsync();
        await OnLeafSelected.InvokeAsync();
    }

    private void CloseUnrelatedOpenNodes(MenuItem clickedItem)
    {
        var roots = RootItems ?? Siblings;
        if (roots is null)
        {
            return;
        }

        foreach (var root in roots)
        {
            CloseUnrelatedOpenNodes(root, clickedItem);
        }
    }

    private static void CloseUnrelatedOpenNodes(MenuItem current, MenuItem clickedItem)
    {
        var isClicked = ReferenceEquals(current, clickedItem);
        var isAncestorOfClicked = ContainsDescendant(current, clickedItem);
        var isDescendantOfClicked = ContainsDescendant(clickedItem, current);

        if (!isClicked && !isAncestorOfClicked && !isDescendantOfClicked)
        {
            CloseNodeAndDescendants(current);
            return;
        }

        foreach (var child in current.Children)
        {
            CloseUnrelatedOpenNodes(child, clickedItem);
        }
    }

    private void CloseSiblingNodes(MenuItem clickedItem)
    {
        if (Siblings is null)
        {
            return;
        }

        foreach (var sibling in Siblings)
        {
            if (!ReferenceEquals(sibling, clickedItem))
            {
                CloseNodeAndDescendants(sibling);
            }
        }
    }

    private static void CloseNodeAndDescendants(MenuItem item)
    {
        item.IsOpen = false;

        foreach (var child in item.Children)
        {
            CloseNodeAndDescendants(child);
        }
    }

    private static bool ContainsDescendant(MenuItem ancestor, MenuItem item)
        => ancestor.Children.Any(child => ReferenceEquals(child, item) || ContainsDescendant(child, item));

    private void AutoExpand(MenuItem item)
    {
        if (IsMatch(item))
        {
            item.IsOpen = true;
        }

        foreach (var child in item.Children)
        {
            AutoExpand(child);

            if (child.IsOpen)
            {
                item.IsOpen = true;
            }
        }
    }

    private bool IsMatch(MenuItem item)
    {
        if (IsUrlWithinActivePath(item.Url))
        {
            return true;
        }

        return item.Children.Any(IsMatch);
    }

    private bool IsUrlExactActive(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        return NavigationMenuResolver.IsExactPathMatch(CurrentPathFromUri(), url);
    }

    private bool IsUrlWithinActivePath(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        return NavigationMenuResolver.IsPathWithinUrl(CurrentPathFromUri(), url);
    }

    private string CurrentPathFromUri()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var pathOnly = relativePath.Split('?', '#')[0];

        return NavigationMenuResolver.NormalizePath($"/{pathOnly}");
    }

    private string FormatPath(IEnumerable<MenuItem> items)
        => string.Join(" / ", items.Select(item => SharedDataService.SelectViewLang(item.TextEn, item.TextAr)));

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        foreach (var item in NavigationMenuResolver.GetActivePath(NavigationManager.Uri, NavigationManager.BaseUri))
        {
            item.IsOpen = true;
        }

        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
