@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@implements IDisposable

<li class="nav-item sidebar-node @(HasVisibleChildren ? "has-children" : "") @(IsParentActive ? "parent-active" : "")">
    @if (HasVisibleChildren)
    {
        <button type="button"
                class="sidebar-link sidebar-parent @(IsParentActive ? "is-parent-active" : "") @(Item.IsOpen ? "is-open" : "")"
                @onclick="Toggle"
                aria-expanded="@ShouldShowChildren">
            <span class="sidebar-link-main">
                <i class="bi @Item.Icon sidebar-link-icon"></i>
                <span class="sidebar-link-text">@Label</span>
            </span>
            <span class="sidebar-link-trailing">
                @if (!string.IsNullOrWhiteSpace(Item.BadgeText))
                {
                    <span class="badge rounded-pill @(Item.BadgeCssClass ?? "text-bg-primary")"
                          title="@BadgeTitle">@Item.BadgeText</span>
                }
                <i class="bi @(ShouldShowChildren ? "bi-chevron-down" : "bi-chevron-right") sidebar-chevron"></i>
            </span>
        </button>

        @if (ShouldShowChildren)
        {
            <ul class="nav flex-column sidebar-submenu">
                @foreach (var child in VisibleChildren)
                {
                    <SidebarItem Item="child"
                                 Siblings="VisibleChildren"
                                 AuthState="AuthState"
                                 SearchText="SearchText"
                                 IsFiltering="@IsFiltering" />
                }
            </ul>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Item.Url))
    {
        <NavLink href="@Item.Url"
                 class="@LeafClass"
                 Match="NavLinkMatch.All"
                 ActiveClass="">
            <span class="sidebar-link-main">
                <i class="bi @Item.Icon sidebar-link-icon"></i>
                <span class="sidebar-link-text">@Label</span>
            </span>
            @if (!string.IsNullOrWhiteSpace(Item.BadgeText))
            {
                <span class="badge rounded-pill @(Item.BadgeCssClass ?? "text-bg-primary")"
                      title="@BadgeTitle">@Item.BadgeText</span>
            }
        </NavLink>
    }
</li>

@code {
    [Parameter] public MenuItem Item { get; set; } = default!;
    [Parameter] public List<MenuItem>? Siblings { get; set; }
    [Parameter] public AuthenticationState? AuthState { get; set; }
    [Parameter] public string SearchText { get; set; } = "";
    [Parameter] public bool IsFiltering { get; set; }

    private string Label => SharedDataService.SelectViewLang(Item.TextEn, Item.TextAr);
    private string BadgeTitle => SharedDataService.SelectViewLang(
        Item.BadgeTitleEn ?? Item.BadgeText ?? "",
        Item.BadgeTitleAr ?? Item.BadgeText ?? "");
    private string LeafClass => IsActive ? "sidebar-link sidebar-leaf is-active" : "sidebar-link sidebar-leaf";
    private bool HasVisibleChildren => VisibleChildren.Any();
    private bool ShouldShowChildren => HasVisibleChildren && (Item.IsOpen || IsFiltering || IsParentActive);
    private bool IsParentActive => HasVisibleChildren && (IsUrlActive(Item.Url) || Item.Children.Any(IsMatch));

    private bool IsActive
    {
        get
        {
            return IsUrlActive(Item.Url);
        }
    }

    private List<MenuItem> VisibleChildren
    {
        get
        {
            var authorizedChildren = Item.Children
                .Where(IsAuthorized)
                .ToList();

            if (!IsFiltering)
            {
                return authorizedChildren;
            }

            if (ItemMatchesSearch(Item))
            {
                return authorizedChildren;
            }

            return authorizedChildren
                .Where(MatchesSearch)
                .ToList();
        }
    }

    protected override void OnInitialized()
    {
        AutoExpand(Item);
        SharedDataService.OnChange1 += HandleChangeAsync;
        NavigationManager.LocationChanged += HandleLocationChanged;
    }

    private bool IsAuthorized(MenuItem item)
    {
        if (AuthState is null)
        {
            return false;
        }

        var hasOwnPermission = !string.IsNullOrWhiteSpace(item.PermissionPolicy)
            && AuthState.User.Claims.Any(c => c.Value == item.PermissionPolicy);

        return hasOwnPermission || item.Children.Any(IsAuthorized);
    }

    private bool MatchesSearch(MenuItem item)
    {
        if (!IsFiltering)
        {
            return true;
        }

        return ItemMatchesSearch(item) || item.Children.Any(MatchesSearch);
    }

    private bool ItemMatchesSearch(MenuItem item)
    {
        var term = SearchText.Trim();
        return item.TextEn.Contains(term, StringComparison.OrdinalIgnoreCase)
               || item.TextAr.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private void Toggle()
    {
        if (!HasVisibleChildren)
        {
            if (!string.IsNullOrWhiteSpace(Item.Url))
            {
                NavigationManager.NavigateTo(Item.Url);
            }

            return;
        }

        if (Siblings is not null)
        {
            foreach (var sibling in Siblings)
            {
                if (sibling != Item)
                {
                    sibling.IsOpen = false;
                }
            }
        }

        Item.IsOpen = !Item.IsOpen;
    }

    private void AutoExpand(MenuItem item)
    {
        if (IsMatch(item))
        {
            item.IsOpen = true;
        }

        foreach (var child in item.Children)
        {
            AutoExpand(child);

            if (child.IsOpen)
            {
                item.IsOpen = true;
            }
        }
    }

    private bool IsMatch(MenuItem item)
    {
        if (IsUrlActive(item.Url))
        {
            return true;
        }

        return item.Children.Any(IsMatch);
    }

    private bool IsUrlActive(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return false;
        }

        var currentPath = CurrentPath();
        var targetPath = NormalizePath(url);

        if (currentPath == targetPath)
        {
            return true;
        }

        return targetPath != "/" &&
               currentPath.StartsWith($"{targetPath}/", StringComparison.OrdinalIgnoreCase);
    }

    private string CurrentPath()
    {
        var relativePath = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var pathOnly = relativePath.Split('?', '#')[0];

        return NormalizePath($"/{pathOnly}");
    }

    private static string NormalizePath(string url)
    {
        if (string.IsNullOrWhiteSpace(url))
        {
            return "/";
        }

        var path = url.Split('?', '#')[0].Trim();

        if (Uri.TryCreate(path, UriKind.Absolute, out var absoluteUri))
        {
            path = absoluteUri.AbsolutePath;
        }

        path = "/" + path.Trim('/').ToLowerInvariant();
        return path == "/" ? "/" : path.TrimEnd('/');
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}

<style>
    .sidebar-node {
        margin: .08rem 0;
    }

    .sidebar-node.parent-active {
        padding-block: .08rem;
    }

    .sidebar-link {
        width: 100%;
        min-height: 40px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .65rem;
        border: 0;
        border-radius: 8px;
        padding: .58rem .65rem;
        color: rgba(255, 255, 255, .76);
        background: transparent;
        text-decoration: none;
        text-align: start;
        transition: background-color .15s ease, color .15s ease;
    }

    .sidebar-link:hover {
        color: #fff;
        background: rgba(255, 255, 255, .08);
    }

    .sidebar-link.is-active {
        color: #fff;
        background: #2563eb;
        box-shadow: inset 3px 0 0 rgba(255, 255, 255, .62);
    }

    [dir="rtl"] .sidebar-link.is-active {
        box-shadow: inset -3px 0 0 rgba(255, 255, 255, .62);
    }

    .sidebar-link.is-parent-active,
    .sidebar-link.is-open {
        color: #fff;
        background: rgba(37, 99, 235, .18);
    }

    .sidebar-link-main {
        display: flex;
        align-items: center;
        gap: .65rem;
        min-width: 0;
    }

    .sidebar-link-icon {
        width: 1.1rem;
        text-align: center;
        color: rgba(255, 255, 255, .7);
        flex: 0 0 auto;
    }

    .sidebar-link.is-active .sidebar-link-icon,
    .sidebar-link.is-parent-active .sidebar-link-icon,
    .sidebar-link:hover .sidebar-link-icon {
        color: #fff;
    }

    .sidebar-link-text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .92rem;
        line-height: 1.2;
    }

    .sidebar-link-trailing {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        flex: 0 0 auto;
    }

    .sidebar-chevron {
        color: rgba(255, 255, 255, .5);
        font-size: .78rem;
    }

    .sidebar-submenu {
        position: relative;
        margin: .16rem 0 .28rem;
        padding-inline-start: .8rem;
        gap: .12rem;
    }

    .sidebar-submenu::before {
        content: "";
        position: absolute;
        inset-block: .25rem;
        inset-inline-start: .2rem;
        width: 1px;
        background: rgba(255, 255, 255, .12);
    }

    .sidebar-submenu .sidebar-link {
        min-height: 36px;
        padding: .5rem .6rem;
        color: rgba(255, 255, 255, .68);
    }

    .sidebar-submenu .sidebar-link-text {
        font-size: .86rem;
    }

    .sidebar-submenu .sidebar-submenu {
        padding-inline-start: .7rem;
        margin-block: .12rem;
    }

    .sidebar-link .badge {
        font-size: .68rem;
        line-height: 1;
    }
</style>
