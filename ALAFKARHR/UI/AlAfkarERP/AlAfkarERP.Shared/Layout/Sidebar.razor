@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Globalization
@using System.Text
@using SharedWithUI.Permissions
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITaskManagementService TaskManagementService
@inject IJSRuntime JSRuntime
@implements IDisposable

<aside class="sidebar app-sidebar text-white d-flex flex-column @(IsOpen ? "open" : "") @(IsCollapsed ? "is-collapsed" : "")" aria-label="Main navigation">
    <div class="sidebar-brand">
        <div class="brand-mark">
            <i class="bi bi-grid-1x2-fill"></i>
        </div>
        <div class="min-w-0 sidebar-brand-copy">
            <div class="brand-title">ALAFKAR ERP</div>
            <div class="brand-subtitle">@SharedDataService.SelectViewLang("ERP Workspace", "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644")</div>
        </div>
        @if (OnToggleCollapsed.HasDelegate)
        {
            <button type="button"
                    class="btn sidebar-collapse-btn d-none d-lg-inline-flex"
                    title="@SharedDataService.SelectViewLang(IsCollapsed ? "Expand sidebar" : "Collapse sidebar", IsCollapsed ? "\u062a\u0648\u0633\u064a\u0639 \u0627\u0644\u0642\u0627\u0626\u0645\u0629" : "\u0637\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629")"
                    @onclick="() => OnToggleCollapsed.InvokeAsync()">
                <i class="bi @(IsCollapsed ? "bi-layout-sidebar-inset" : "bi-layout-sidebar-inset-reverse")"></i>
            </button>
        }
    </div>

    <div class="sidebar-search" title="@SharedDataService.SelectViewLang("Search menu", "\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629")">
        <i class="bi bi-search"></i>
        <input class="form-control"
               placeholder="@SharedDataService.SelectViewLang("Search menu", "\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0642\u0627\u0626\u0645\u0629")"
               @bind="searchText"
               @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(searchText))
        {
            <button type="button"
                    class="btn btn-sm search-clear"
                    title="@SharedDataService.SelectViewLang("Clear", "\u0645\u0633\u062d")"
                    @onclick="ClearSearch">
                <i class="bi bi-x-lg"></i>
            </button>
        }
    </div>

    <nav class="sidebar-nav" aria-label="Application modules">
        @if (authState is null)
        {
            <div class="sidebar-empty">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>@SharedDataService.SelectViewLang("Loading menu...", "\u062c\u0627\u0631\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0642\u0627\u0626\u0645\u0629...")</span>
            </div>
        }
        else if (!VisibleRootItems.Any())
        {
            <div class="sidebar-empty">
                <i class="bi bi-search"></i>
                <span>@SharedDataService.SelectViewLang("No permitted menu item matches your search", "\u0644\u0627 \u064a\u0648\u062c\u062f \u0639\u0646\u0635\u0631 \u0645\u0633\u0645\u0648\u062d \u064a\u0637\u0627\u0628\u0642 \u0627\u0644\u0628\u062d\u062b")</span>
            </div>
        }
        else
        {
            <ul class="nav flex-column sidebar-menu">
                @for (var index = 0; index < VisibleRootItems.Count; index++)
                {
                    var item = VisibleRootItems[index];
                    var sectionLabel = GetSectionLabel(item, index);

                    if (!string.IsNullOrWhiteSpace(sectionLabel))
                    {
                        <li class="sidebar-section-label">@sectionLabel</li>
                    }

                    <SidebarItem Item="item"
                                 Siblings="@VisibleRootItems"
                                 RootItems="@MenuItem.Menu"
                                 AuthState="@authState"
                                 SearchText="@searchText"
                                 IsFiltering="@IsFiltering"
                                 IsCollapsed="@IsCollapsed"
                                 ActiveWorkspace="@activeWorkspace"
                                 ParentPath="@EmptyMenuPath"
                                 OnLeafSelected="HandleLeafSelected"
                                 OnOpenStateChanged="PersistOpenStateAsync" />
                }
            </ul>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="user-chip">
            <div class="user-avatar">@UserInitials</div>
            <div class="min-w-0 sidebar-user-copy">
                <div class="user-name">@UserDisplayName</div>
                <div class="user-meta">@SharedDataService.SelectViewLang("Signed in", "\u0645\u0633\u062c\u0644 \u0627\u0644\u062f\u062e\u0648\u0644")</div>
            </div>
        </div>
        <button type="button"
                class="btn logout-btn"
                title="@SharedDataService.SelectViewLang("Logout", "\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062e\u0631\u0648\u062c")"
                @onclick="LogoutAsync">
            <i class="bi bi-box-arrow-right"></i>
        </button>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsCollapsed { get; set; }
    [Parameter] public EventCallback OnLeafSelected { get; set; }
    [Parameter] public EventCallback OnToggleCollapsed { get; set; }

    private AuthenticationState? authState;
    private string searchText = "";
    private string activeWorkspace = NavigationMenuResolver.WorkspaceHome;
    private const string SidebarOpenStateStorageKey = "alafkar.sidebar.openKeys";

    private bool IsFiltering => !string.IsNullOrWhiteSpace(searchText);
    private static readonly IReadOnlyList<MenuItem> EmptyMenuPath = Array.Empty<MenuItem>();

    private List<MenuItem> VisibleRootItems => MenuItem.Menu
        .Where(item => IsAuthorized(item) && MatchesSearch(item))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        await LoadTaskBadgeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadOpenStateAsync();
        }
    }

    private bool IsAuthorized(MenuItem item)
    {
        if (authState is null)
        {
            return false;
        }

        var hasOwnPermission = NavigationMenuResolver.HasOwnPermission(item, authState.User);

        return hasOwnPermission || item.Children.Any(IsAuthorized);
    }

    private bool MatchesSearch(MenuItem item)
    {
        if (!IsFiltering)
        {
            return true;
        }

        return ItemMatchesSearch(item) || item.Children.Where(IsAuthorized).Any(MatchesSearch);
    }

    private bool ItemMatchesSearch(MenuItem item)
    {
        var term = NormalizeSearchText(searchText);
        if (string.IsNullOrWhiteSpace(term))
        {
            return true;
        }

        return NormalizeSearchText(item.TextEn).Contains(term)
               || NormalizeSearchText(item.TextAr).Contains(term)
               || NormalizeSearchText(item.Url).Contains(term);
    }

    private static string NormalizeSearchText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        var normalized = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var character in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(character);
            if (category is UnicodeCategory.NonSpacingMark
                or UnicodeCategory.SpacingCombiningMark
                or UnicodeCategory.EnclosingMark
                || character == '\u0640')
            {
                continue;
            }

            builder.Append(char.ToLowerInvariant(character));
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private void ClearSearch()
    {
        searchText = "";
    }

    private async Task HandleLeafSelected()
    {
        await OnLeafSelected.InvokeAsync();
    }

    private async Task LoadOpenStateAsync()
    {
        try
        {
            var storedWorkspace = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", NavigationShellState.ActiveWorkspaceStorageKey);
            activeWorkspace = NavigationMenuResolver.ResolveActiveWorkspace(NavigationManager.Uri, NavigationManager.BaseUri, storedWorkspace);
            var value = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", SidebarOpenStateStorageKey);
            if (!string.IsNullOrWhiteSpace(value))
            {
                var keys = value.Split('|', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToHashSet(StringComparer.OrdinalIgnoreCase);
                foreach (var item in NavigationMenuResolver.Flatten(MenuItem.Menu))
                {
                    if (keys.Contains(NavigationMenuResolver.GetStorageKey(item)))
                    {
                        item.IsOpen = true;
                    }
                }
            }

            foreach (var item in NavigationMenuResolver.GetActivePath(NavigationManager.Uri, NavigationManager.BaseUri, activeWorkspace))
            {
                item.IsOpen = true;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task PersistOpenStateAsync()
    {
        try
        {
            var keys = NavigationMenuResolver.Flatten(MenuItem.Menu)
                .Where(item => item.IsOpen)
                .Select(NavigationMenuResolver.GetStorageKey);

            await JSRuntime.InvokeVoidAsync("localStorage.setItem", SidebarOpenStateStorageKey, string.Join("|", keys));
        }
        catch (JSException)
        {
        }
    }

    private async Task LogoutAsync()
    {
        await ((CustomAuthStateProvider)AuthenticationStateProvider).NotifyUserLogout();
        NavigationManager.NavigateTo("/", true);
    }

    private async Task LoadTaskBadgeAsync()
    {
        ResetTaskBadge();

        if (authState?.User.Identity?.IsAuthenticated != true ||
            !authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.View))
        {
            return;
        }

        var response = await TaskManagementService.GetDashboardAsync("mine");
        if (!response.IsSuccess || response.Data is null)
        {
            return;
        }

        var dashboard = response.Data;
        if (dashboard.OverdueTasks > 0)
        {
            SetTaskBadge(
                dashboard.OverdueTasks,
                "text-bg-danger",
                $"{dashboard.OverdueTasks} overdue task(s)",
                $"{dashboard.OverdueTasks} \u0645\u0647\u0645\u0629 \u0645\u062a\u0623\u062e\u0631\u0629");
        }
        else if (dashboard.TasksDueToday > 0)
        {
            SetTaskBadge(
                dashboard.TasksDueToday,
                "text-bg-warning",
                $"{dashboard.TasksDueToday} task(s) due today",
                $"{dashboard.TasksDueToday} \u0645\u0647\u0645\u0629 \u0645\u0633\u062a\u062d\u0642\u0629 \u0627\u0644\u064a\u0648\u0645");
        }
        else if (dashboard.OpenTasks > 0)
        {
            SetTaskBadge(
                dashboard.OpenTasks,
                "text-bg-primary",
                $"{dashboard.OpenTasks} open task(s)",
                $"{dashboard.OpenTasks} \u0645\u0647\u0645\u0629 \u0645\u0641\u062a\u0648\u062d\u0629");
        }
    }

    private static void ResetTaskBadge()
    {
        var myTasksMenu = GetMyTasksMenu();
        if (myTasksMenu is null)
        {
            return;
        }

        myTasksMenu.BadgeText = null;
        myTasksMenu.BadgeCssClass = null;
        myTasksMenu.BadgeTitleEn = null;
        myTasksMenu.BadgeTitleAr = null;
    }

    private static void SetTaskBadge(int count, string cssClass, string titleEn, string titleAr)
    {
        var myTasksMenu = GetMyTasksMenu();
        if (myTasksMenu is null)
        {
            return;
        }

        myTasksMenu.BadgeText = count > 99 ? "99+" : count.ToString();
        myTasksMenu.BadgeCssClass = cssClass;
        myTasksMenu.BadgeTitleEn = titleEn;
        myTasksMenu.BadgeTitleAr = titleAr;
    }

    private static MenuItem? GetMyTasksMenu()
        => MenuItem.Menu
            .FirstOrDefault(item => item.TextEn == "Task Management")
            ?.Children.FirstOrDefault(item => item.TextEn == "My Tasks");

    private string UserDisplayName
    {
        get
        {
            var user = authState?.User;
            return FirstClaimValue(user, ClaimTypes.Name, "name", "unique_name", "email", "sub")
                   ?? SharedDataService.SelectViewLang("Administrator", "\u0645\u062f\u064a\u0631 \u0627\u0644\u0646\u0638\u0627\u0645");
        }
    }

    private string UserInitials
    {
        get
        {
            var name = UserDisplayName.Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                return "A";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 1)
            {
                return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
            }

            return name[..Math.Min(2, name.Length)].ToUpperInvariant();
        }
    }

    private string? GetSectionLabel(MenuItem item, int index)
    {
        if (IsFiltering || IsCollapsed)
        {
            return null;
        }

        return item.TextEn switch
        {
            "Home" when index == 0 => SharedDataService.SelectViewLang("Start", "\u0627\u0644\u0628\u062f\u0627\u064a\u0629"),
            "Organizational Structure" => SharedDataService.SelectViewLang("Company", "\u0627\u0644\u0634\u0631\u0643\u0629"),
            "People" => SharedDataService.SelectViewLang("Workforce", "\u0627\u0644\u0642\u0648\u0649 \u0627\u0644\u0639\u0627\u0645\u0644\u0629"),
            "Operations" => SharedDataService.SelectViewLang("Operations", "\u0627\u0644\u0639\u0645\u0644\u064a\u0627\u062a"),
            "Platform Operations" => SharedDataService.SelectViewLang("Platform Operations", "\u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0645\u0646\u0635\u0629"),
            "Task Management" => SharedDataService.SelectViewLang("Productivity", "\u0627\u0644\u0625\u0646\u062a\u0627\u062c\u064a\u0629"),
            "General Settings" => SharedDataService.SelectViewLang("Administration", "\u0627\u0644\u0625\u062f\u0627\u0631\u0629"),
            _ => null
        };
    }

    private static string? FirstClaimValue(ClaimsPrincipal? user, params string[] claimTypes)
        => claimTypes
            .Select(type => user?.Claims.FirstOrDefault(c => c.Type == type)?.Value)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
