@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using SharedWithUI.Permissions
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITaskManagementService TaskManagementService
@implements IDisposable

<aside class="sidebar app-sidebar text-white d-flex flex-column @(IsOpen ? "open" : "")" aria-label="Main navigation">
    <div class="sidebar-brand">
        <div class="brand-mark">
            <i class="bi bi-grid-1x2-fill"></i>
        </div>
        <div class="min-w-0">
            <div class="brand-title">ALAFKAR HR</div>
            <div class="brand-subtitle">@SharedDataService.SelectViewLang("ERP Workspace", "مساحة العمل")</div>
        </div>
    </div>

    <div class="sidebar-search">
        <i class="bi bi-search"></i>
        <input class="form-control"
               placeholder="@SharedDataService.SelectViewLang("Search menu", "بحث في القائمة")"
               @bind="searchText"
               @bind:event="oninput" />
        @if (!string.IsNullOrWhiteSpace(searchText))
        {
            <button type="button"
                    class="btn btn-sm search-clear"
                    title="@SharedDataService.SelectViewLang("Clear", "مسح")"
                    @onclick="ClearSearch">
                <i class="bi bi-x-lg"></i>
            </button>
        }
    </div>

    <nav class="sidebar-nav" aria-label="Application modules">
        @if (authState is null)
        {
            <div class="sidebar-empty">
                <div class="spinner-border spinner-border-sm" role="status"></div>
                <span>@SharedDataService.SelectViewLang("Loading menu...", "جاري تحميل القائمة...")</span>
            </div>
        }
        else if (!VisibleRootItems.Any())
        {
            <div class="sidebar-empty">
                <i class="bi bi-search"></i>
                <span>@SharedDataService.SelectViewLang("No matching menu items", "لا توجد عناصر مطابقة")</span>
            </div>
        }
        else
        {
            <ul class="nav flex-column sidebar-menu">
                @foreach (var item in VisibleRootItems)
                {
                    <SidebarItem Item="item"
                                 Siblings="VisibleRootItems"
                                 RootItems="VisibleRootItems"
                                 AuthState="authState"
                                 SearchText="searchText"
                                 IsFiltering="@IsFiltering" />
                }
            </ul>
        }
    </nav>

    <div class="sidebar-footer">
        <div class="user-chip">
            <div class="user-avatar">@UserInitials</div>
            <div class="min-w-0">
                <div class="user-name">@UserDisplayName</div>
                <div class="user-meta">@SharedDataService.SelectViewLang("Signed in", "مسجل الدخول")</div>
            </div>
        </div>
        <button type="button"
                class="btn logout-btn"
                title="@SharedDataService.SelectViewLang("Logout", "تسجيل الخروج")"
                @onclick="LogoutAsync">
            <i class="bi bi-box-arrow-right"></i>
        </button>
    </div>
</aside>

@code {
    [Parameter] public bool IsOpen { get; set; }

    private AuthenticationState? authState;
    private string searchText = "";

    private bool IsFiltering => !string.IsNullOrWhiteSpace(searchText);

    private List<MenuItem> VisibleRootItems => MenuItem.Menu
        .Where(item => IsAuthorized(item) && MatchesSearch(item))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        await LoadTaskBadgeAsync();
    }

    private bool IsAuthorized(MenuItem item)
    {
        if (authState is null)
        {
            return false;
        }

        var hasOwnPermission = !string.IsNullOrWhiteSpace(item.PermissionPolicy)
            && authState.User.Claims.Any(c => c.Value == item.PermissionPolicy);

        return hasOwnPermission || item.Children.Any(IsAuthorized);
    }

    private bool MatchesSearch(MenuItem item)
    {
        if (!IsFiltering)
        {
            return true;
        }

        return ItemMatchesSearch(item) || item.Children.Where(IsAuthorized).Any(MatchesSearch);
    }

    private bool ItemMatchesSearch(MenuItem item)
    {
        var term = searchText.Trim();
        return item.TextEn.Contains(term, StringComparison.OrdinalIgnoreCase)
               || item.TextAr.Contains(term, StringComparison.OrdinalIgnoreCase);
    }

    private void ClearSearch()
    {
        searchText = "";
    }

    private async Task LogoutAsync()
    {
        await ((CustomAuthStateProvider)AuthenticationStateProvider).NotifyUserLogout();
        NavigationManager.NavigateTo("/", true);
    }

    private async Task LoadTaskBadgeAsync()
    {
        ResetTaskBadge();

        if (authState?.User.Identity?.IsAuthenticated != true ||
            !authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.View))
        {
            return;
        }

        var response = await TaskManagementService.GetDashboardAsync("mine");
        if (!response.IsSuccess || response.Data is null)
        {
            return;
        }

        var dashboard = response.Data;
        if (dashboard.OverdueTasks > 0)
        {
            SetTaskBadge(
                dashboard.OverdueTasks,
                "text-bg-danger",
                $"{dashboard.OverdueTasks} overdue task(s)",
                $"{dashboard.OverdueTasks} مهمة متأخرة");
        }
        else if (dashboard.TasksDueToday > 0)
        {
            SetTaskBadge(
                dashboard.TasksDueToday,
                "text-bg-warning",
                $"{dashboard.TasksDueToday} task(s) due today",
                $"{dashboard.TasksDueToday} مهمة مستحقة اليوم");
        }
        else if (dashboard.OpenTasks > 0)
        {
            SetTaskBadge(
                dashboard.OpenTasks,
                "text-bg-primary",
                $"{dashboard.OpenTasks} open task(s)",
                $"{dashboard.OpenTasks} مهمة مفتوحة");
        }
    }

    private static void ResetTaskBadge()
    {
        var myTasksMenu = GetMyTasksMenu();
        if (myTasksMenu is null)
        {
            return;
        }

        myTasksMenu.BadgeText = null;
        myTasksMenu.BadgeCssClass = null;
        myTasksMenu.BadgeTitleEn = null;
        myTasksMenu.BadgeTitleAr = null;
    }

    private static void SetTaskBadge(int count, string cssClass, string titleEn, string titleAr)
    {
        var myTasksMenu = GetMyTasksMenu();
        if (myTasksMenu is null)
        {
            return;
        }

        myTasksMenu.BadgeText = count > 99 ? "99+" : count.ToString();
        myTasksMenu.BadgeCssClass = cssClass;
        myTasksMenu.BadgeTitleEn = titleEn;
        myTasksMenu.BadgeTitleAr = titleAr;
    }

    private static MenuItem? GetMyTasksMenu()
        => MenuItem.Menu
            .FirstOrDefault(item => item.TextEn == "Task Management")
            ?.Children.FirstOrDefault(item => item.TextEn == "My Tasks");

    private string UserDisplayName
    {
        get
        {
            var user = authState?.User;
            return FirstClaimValue(user, ClaimTypes.Name, "name", "unique_name", "email", "sub")
                   ?? SharedDataService.SelectViewLang("Administrator", "مدير النظام");
        }
    }

    private string UserInitials
    {
        get
        {
            var name = UserDisplayName.Trim();
            if (string.IsNullOrWhiteSpace(name))
            {
                return "A";
            }

            var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length > 1)
            {
                return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
            }

            return name[..Math.Min(2, name.Length)].ToUpperInvariant();
        }
    }

    private static string? FirstClaimValue(ClaimsPrincipal? user, params string[] claimTypes)
        => claimTypes
            .Select(type => user?.Claims.FirstOrDefault(c => c.Type == type)?.Value)
            .FirstOrDefault(value => !string.IsNullOrWhiteSpace(value));

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .app-sidebar {
        width: 280px;
        min-width: 280px;
        height: 100vh;
        background: #111827;
        border-inline-end: 1px solid rgba(255, 255, 255, .08);
        padding: 1rem .75rem;
        overflow: hidden;
    }

    .sidebar-brand {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .35rem .45rem .9rem;
        border-bottom: 1px solid rgba(255, 255, 255, .1);
        margin-bottom: .75rem;
    }

    .brand-mark {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #2563eb;
        color: #fff;
        flex: 0 0 auto;
    }

    .brand-title {
        font-weight: 700;
        line-height: 1.1;
    }

    .brand-subtitle,
    .user-meta {
        color: rgba(255, 255, 255, .58);
        font-size: .76rem;
        line-height: 1.2;
    }

    .sidebar-search {
        position: relative;
        margin-bottom: .75rem;
    }

    .sidebar-search > .bi {
        position: absolute;
        inset-inline-start: .75rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, .48);
        pointer-events: none;
    }

    .sidebar-search .form-control {
        height: 38px;
        border-radius: 8px;
        border: 1px solid rgba(255, 255, 255, .12);
        background: rgba(255, 255, 255, .08);
        color: #fff;
        padding-inline-start: 2.25rem;
        padding-inline-end: 2rem;
        font-size: .9rem;
    }

    .sidebar-search .form-control::placeholder {
        color: rgba(255, 255, 255, .52);
    }

    .search-clear {
        position: absolute;
        inset-inline-end: .25rem;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(255, 255, 255, .7);
        border: 0;
    }

    .sidebar-nav {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding-inline-end: .2rem;
    }

    .sidebar-nav::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-nav::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, .18);
        border-radius: 999px;
    }

    .sidebar-menu {
        gap: .18rem;
    }

    .sidebar-empty {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: .5rem;
        min-height: 120px;
        color: rgba(255, 255, 255, .62);
        font-size: .9rem;
        text-align: center;
    }

    .sidebar-footer {
        display: flex;
        align-items: center;
        gap: .5rem;
        border-top: 1px solid rgba(255, 255, 255, .1);
        padding-top: .75rem;
        margin-top: .75rem;
    }

    .user-chip {
        display: flex;
        align-items: center;
        gap: .6rem;
        min-width: 0;
        flex: 1 1 auto;
    }

    .user-avatar {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: rgba(255, 255, 255, .12);
        font-weight: 700;
        font-size: .78rem;
        flex: 0 0 auto;
    }

    .user-name {
        font-size: .9rem;
        font-weight: 600;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .logout-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        color: rgba(255, 255, 255, .75);
        background: rgba(255, 255, 255, .08);
        flex: 0 0 auto;
    }

    .logout-btn:hover,
    .search-clear:hover {
        color: #fff;
        background: rgba(255, 255, 255, .14);
    }

    @@media (max-width: 991.98px) {
        .app-sidebar {
            position: fixed;
            z-index: 1040;
            inset-block: 0;
            inset-inline-start: 0;
            transform: translateX(-100%);
            transition: transform .2s ease;
        }

        [dir="rtl"] .app-sidebar {
            transform: translateX(100%);
        }

        .app-sidebar.open {
            transform: translateX(0);
        }
    }
</style>
