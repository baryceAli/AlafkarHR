@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@inherits LayoutComponentBase
@implements IDisposable

@inject SharedDataService SharedDataService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@* @Body *@
@* <div class="d-flex vh-100"> *@
<div class="erp-shell d-flex vh-100 overflow-hidden @(isSidebarCollapsed ? "sidebar-collapsed" : "")">
    
    @if (isSidebarOpen)
    {
        <div class="sidebar-backdrop" @onclick="ToggleSidebar"></div>
    }
    <!-- Sidebar -->
    <Sidebar IsOpen="isSidebarOpen"
             IsCollapsed="isSidebarCollapsed"
             OnLeafSelected="CloseSidebar"
             OnToggleCollapsed="ToggleSidebarCollapsedAsync" />

    <!-- Main Area -->
    <div class="flex-grow-1 d-flex flex-column min-vw-0">

        <!-- Top Navbar -->
        <TopNavbar OnToggleSidebar="ToggleSidebar"
                   OnToggleSidebarCollapsed="ToggleSidebarCollapsedAsync"
                   IsSidebarCollapsed="isSidebarCollapsed" />
        
        <!-- Page Content -->
        <main class="erp-main flex-grow-1 overflow-auto w-100" dir="@SharedDataService.PageDirection">
            @Body
        </main>


        <AppModal />
        <AppToast />
        <AppLoader />


    </div>

</div>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    private AuthenticationState? AuthState;

    private bool isSidebarOpen = false;
    private bool isSidebarCollapsed = false;
    private const string SidebarCollapsedStorageKey = "alafkar.sidebar.collapsed";

    void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }

    private void CloseSidebar()
    {
        isSidebarOpen = false;
    }

    private async Task ToggleSidebarCollapsedAsync()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
        await PersistSidebarCollapsedAsync();
    }

    protected override async Task OnInitializedAsync()
    {

    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadSidebarCollapsedAsync();
            AuthState = await((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
            if (AuthState.User.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("login",true);
            }
            // NavigationManager.NavigateTo("/login");
        }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadSidebarCollapsedAsync()
    {
        try
        {
            var value = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", SidebarCollapsedStorageKey);
            isSidebarCollapsed = string.Equals(value, "true", StringComparison.OrdinalIgnoreCase);
            await InvokeAsync(StateHasChanged);
        }
        catch (InvalidOperationException)
        {
        }
        catch (JSException)
        {
        }
    }

    private async Task PersistSidebarCollapsedAsync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", SidebarCollapsedStorageKey, isSidebarCollapsed ? "true" : "false");
        }
        catch (JSException)
        {
        }
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
