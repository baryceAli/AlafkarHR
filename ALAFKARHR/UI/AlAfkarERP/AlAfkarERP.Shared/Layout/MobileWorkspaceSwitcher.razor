@implements IDisposable
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager

<div class="mobile-workspace-switcher d-lg-none">
    <button type="button"
            class="mobile-workspace-trigger"
            aria-expanded="@isOpen"
            aria-haspopup="menu"
            @onclick="Toggle">
        <span class="mobile-workspace-icon"><i class="bi @ActiveWorkspaceItem.Icon"></i></span>
        <span class="mobile-workspace-copy">
            <small>@SharedDataService.SelectViewLang("Workspace", "\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644")</small>
            <strong>@WorkspaceLabel(ActiveWorkspaceItem)</strong>
        </span>
        <i class="bi bi-chevron-down mobile-workspace-chevron"></i>
    </button>

    @if (isOpen)
    {
        <div class="mobile-workspace-backdrop" @onclick="Close"></div>
        <div class="mobile-workspace-menu" role="menu">
            @foreach (var workspace in WorkspaceItems)
            {
                var isActive = workspace.Key == ActiveWorkspace || workspace.Key == NavigationMenuResolver.WorkspaceMore && IsMoreOpen;
                <button type="button"
                        role="menuitem"
                        class="mobile-workspace-option @(isActive ? "is-active" : "")"
                        @onclick="() => SelectWorkspaceAsync(workspace)">
                    <span class="mobile-workspace-option-icon"><i class="bi @workspace.Icon"></i></span>
                    <span>
                        <strong>@WorkspaceLabel(workspace)</strong>
                        <small>@WorkspaceHint(workspace)</small>
                    </span>
                    @if (isActive)
                    {
                        <i class="bi bi-check2"></i>
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string ActiveWorkspace { get; set; } = NavigationMenuResolver.WorkspaceHome;
    [Parameter] public bool IsMoreOpen { get; set; }
    [Parameter] public AuthenticationState? AuthState { get; set; }
    [Parameter] public IReadOnlySet<string>? LicensedBusinessLineKeys { get; set; }
    [Parameter] public EventCallback<string> ActiveWorkspaceChanged { get; set; }
    [Parameter] public EventCallback OnOpenMore { get; set; }

    private bool isOpen;

    private IReadOnlyList<NavigationWorkspace> WorkspaceItems
        => NavigationMenuResolver.GetAuthorizedWorkspaces(AuthState?.User, LicensedBusinessLineKeys);

    private NavigationWorkspace ActiveWorkspaceItem
        => IsMoreOpen
            ? WorkspaceItems.FirstOrDefault(item => item.Key == NavigationMenuResolver.WorkspaceMore) ?? NavigationMenuResolver.MobileWorkspaces.Last()
            : WorkspaceItems.FirstOrDefault(item => item.Key == ActiveWorkspace)
              ?? NavigationMenuResolver.MobileWorkspaces.First(item => item.Key == NavigationMenuResolver.WorkspaceHome);

    private void Toggle() => isOpen = !isOpen;
    private void Close() => isOpen = false;

    private async Task SelectWorkspaceAsync(NavigationWorkspace workspace)
    {
        isOpen = false;
        if (workspace.Key == NavigationMenuResolver.WorkspaceMore)
        {
            await OnOpenMore.InvokeAsync();
            return;
        }

        await ActiveWorkspaceChanged.InvokeAsync(workspace.Key);
        if (NavigationMenuResolver.HasFunctionalGroups(workspace.Key))
        {
            return;
        }

        var url = NavigationMenuResolver.GetWorkspaceDefaultUrl(workspace.Key, AuthState?.User, LicensedBusinessLineKeys);
        if (!string.IsNullOrWhiteSpace(url))
        {
            NavigationManager.NavigateTo(url);
        }
    }

    private string WorkspaceLabel(NavigationWorkspace workspace)
        => workspace.Key == NavigationMenuResolver.WorkspaceMore
            ? SharedDataService.SelectViewLang("More / All", "\u0627\u0644\u0645\u0632\u064a\u062f / \u0627\u0644\u0643\u0644")
            : SharedDataService.SelectViewLang(workspace.TextEn, workspace.TextAr);

    private string WorkspaceHint(NavigationWorkspace workspace)
        => workspace.Key switch
        {
            NavigationMenuResolver.WorkspaceHome => SharedDataService.SelectViewLang("Start and dashboards", "\u0627\u0644\u0628\u062f\u0621 \u0648\u0644\u0648\u062d\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645"),
            NavigationMenuResolver.WorkspaceStoreFront => SharedDataService.SelectViewLang("Stores, checkout, cashier", "\u0645\u062a\u0627\u062c\u0631 \u0648\u0628\u064a\u0639 \u0648\u0643\u0627\u0634\u064a\u0631"),
            NavigationMenuResolver.WorkspaceHr => SharedDataService.SelectViewLang("Employees, attendance, leave", "\u0627\u0644\u0645\u0648\u0638\u0641\u0648\u0646 \u0648\u0627\u0644\u062d\u0636\u0648\u0631 \u0648\u0627\u0644\u0625\u062c\u0627\u0632\u0627\u062a"),
            NavigationMenuResolver.WorkspaceSales => SharedDataService.SelectViewLang("Customers, orders, reports", "\u0639\u0645\u0644\u0627\u0621 \u0648\u0637\u0644\u0628\u0627\u062a \u0648\u062a\u0642\u0627\u0631\u064a\u0631"),
            NavigationMenuResolver.WorkspacePurchasing => SharedDataService.SelectViewLang("Procurement and suppliers", "\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0648\u0645\u0648\u0631\u062f\u0648\u0646"),
            NavigationMenuResolver.WorkspaceWarehouse => SharedDataService.SelectViewLang("Inventory, stock, products", "\u0645\u062e\u0632\u0648\u0646 \u0648\u0623\u0631\u0635\u062f\u0629 \u0648\u0645\u0646\u062a\u062c\u0627\u062a"),
            NavigationMenuResolver.WorkspaceAccountingFinance => SharedDataService.SelectViewLang("Accounting and finance", "\u0645\u062d\u0627\u0633\u0628\u0629 \u0648\u0645\u0627\u0644\u064a\u0629"),
            NavigationMenuResolver.WorkspaceAdmin => SharedDataService.SelectViewLang("Organization, tasks, settings", "\u0647\u064a\u0643\u0644 \u0648\u0645\u0647\u0627\u0645 \u0648\u0625\u0639\u062f\u0627\u062f\u0627\u062a"),
            NavigationMenuResolver.WorkspaceSecurity => SharedDataService.SelectViewLang("Roles, users, access", "\u0623\u062f\u0648\u0627\u0631 \u0648\u0645\u0633\u062a\u062e\u062f\u0645\u0648\u0646 \u0648\u0635\u0644\u0627\u062d\u064a\u0627\u062a"),
            _ => SharedDataService.SelectViewLang("All modules", "\u0643\u0644 \u0627\u0644\u0648\u062d\u062f\u0627\u062a")
        };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

}
