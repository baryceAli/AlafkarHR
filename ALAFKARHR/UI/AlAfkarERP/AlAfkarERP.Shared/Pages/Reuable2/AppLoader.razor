@inject LoadingService LoadingService


@* 
    How to use it
    1. Add the class: LoadingService
    2. register it in DI: builder.Services.AddScoped<LoadingService>();
    3. Inject in your page: @inject LoadingService LoadingService
    4. Add to your layout page <AppLoader />
    5. Use anywhere
        LoadingService.Show();
        LoadingService.Hide(); // ✅ always hides
         
*@


@if (isVisible)
{
    <div class="erp-loader-overlay">

        <div class="spinner-border erp-loader-spinner">
        </div>

    </div>
}

@code {
    private bool isVisible;

    protected override void OnInitialized()
    {
        LoadingService.OnChange += Toggle;
    }

    private void Toggle(bool show)
    {
        isVisible = show;
        StateHasChanged();
    }
}
