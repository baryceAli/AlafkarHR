@using AlAfkarERP.Shared.Utilities
@implements IDisposable
@inject ModalService ModalService
@inject SharedDataService SharedDataService

@if (isVisible)
{
    <div class="app-modal modal fade show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="@titleId"
         aria-describedby="@messageId"
         dir="@ModalDirection">
        <div class="app-modal__dialog modal-dialog modal-dialog-centered">
            <div class="app-modal__content modal-content @VariantClass">
                <div class="app-modal__header">
                    <span class="app-modal__icon" aria-hidden="true">
                        <i class="@IconClass"></i>
                    </span>

                    <div class="app-modal__heading">
                        <h5 class="app-modal__title modal-title" id="@titleId">@options.Title</h5>
                    </div>

                    <button type="button"
                            class="app-modal__close"
                            aria-label="@CloseLabel"
                            @onclick="HandleDismiss">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="app-modal__body modal-body">
                    <p class="app-modal__message" id="@messageId">@options.Message</p>

                    @if (!string.IsNullOrWhiteSpace(options.Details))
                    {
                        <div class="app-modal__details">@options.Details</div>
                    }
                </div>

                <div class="app-modal__footer modal-footer">
                    @if (options.ShowCancel)
                    {
                        <button type="button" class="app-modal__btn app-modal__btn--secondary" @onclick="HandleCancel">
                            @options.CancelText
                        </button>
                    }

                    <button type="button" class="app-modal__btn app-modal__btn--primary @PrimaryButtonClass" @onclick="HandleOk">
                        @options.OkText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible;
    private ModalOptions options = new();
    private readonly string titleId = $"app-modal-title-{Guid.NewGuid():N}";
    private readonly string messageId = $"app-modal-message-{Guid.NewGuid():N}";

    private ModalVariant EffectiveVariant => options.Variant switch
    {
        ModalVariant.Default when options.IsError => ModalVariant.Danger,
        ModalVariant.Default when options.ShowCancel => ModalVariant.Warning,
        ModalVariant.Default => ModalVariant.Info,
        _ => options.Variant
    };

    private string ModalDirection => SharedDataService.Language == "Ar" ? "rtl" : "ltr";
    private string VariantClass => $"app-modal__content--{EffectiveVariant.ToString().ToLowerInvariant()}";
    private string PrimaryButtonClass => EffectiveVariant == ModalVariant.Danger ? "app-modal__btn--danger" : "";
    private string CloseLabel => SharedDataService.SelectViewLang("Close dialog", "\u0625\u063A\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629");

    private string IconClass => !string.IsNullOrWhiteSpace(options.IconCssClass)
        ? options.IconCssClass
        : EffectiveVariant switch
        {
            ModalVariant.Danger => "bi bi-exclamation-octagon-fill",
            ModalVariant.Warning => "bi bi-exclamation-triangle-fill",
            ModalVariant.Success => "bi bi-check-circle-fill",
            _ => "bi bi-info-circle-fill"
        };

    protected override void OnInitialized()
    {
        ModalService.OnShow += Show;
        ModalService.OnHide += Hide;
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private Task Show(ModalOptions opts)
    {
        options = opts;
        isVisible = true;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task Hide()
    {
        isVisible = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task HandleOk()
    {
        if (options.OnOk != null)
            await options.OnOk();

        await ModalService.HideAsync();
    }

    private async Task HandleCancel()
    {
        if (options.OnCancel != null)
            await options.OnCancel();

        await ModalService.HideAsync();
    }

    private async Task HandleDismiss()
    {
        if (options.ShowCancel)
        {
            await HandleCancel();
            return;
        }

        await ModalService.HideAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ModalService.OnShow -= Show;
        ModalService.OnHide -= Hide;
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
