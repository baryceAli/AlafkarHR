@typeparam TItem

@* Usage samples *@

@* 1. *@
@* Local Image *@
@* new() { Title = IsArabic ? "الصورة" : "Photo", Property = "pictureURL_images_user_profile_50_50", GetValue = u => u.ProfilePictureUrl }, *@

@* 2. *@
@* Remote Image *@
@* new() { Title = SharedDataService.Language=="Ar" ? "الشعار" : "Logo", Property = "imageURL_80_80", GetValue = o => o.Logo } *@

@* 3. *@
@* URL *@
@* new {Id = u.AdministrativeDivisionId,Name = administrativeDivisionList.First(ad => ad.AdministrativeDivisionId == u.AdministrativeDivisionId).Name,URL="AdministrativeDivision/Details"} *@

@using FluentValidation
@using FluentValidation.Results


@inject IJSRuntime JS
<div dir="@Direction">
    <div class="card">
        <div class="mb-2">
            <button class="btn btn-success btn-sm" @onclick="StartCreate">
                @(IsArabic ? "إضافة" : "Add New")
            </button>
        </div>
        <table class="table table-striped">
            <thead>
                <tr>
                    @foreach (var column in Columns.Where(c => !c.isHidden && !c.IsActionColumn))
                    {
                        <th @onclick="() => Sort(column.Property)" style="cursor:pointer">
                            @column.Title
                            @(CurrentSortColumn == column.Property ? (SortAscending ? " ↑" : " ↓") : "")
                        </th>
                    }

                    @if (Columns.Any(c => c.IsActionColumn))
                    {
                        <th>@(IsArabic ? "الإجراءات" : "Actions")</th>
                    }
                </tr>

                <tr>
                    @foreach (var column in Columns.Where(c => !c.isHidden && !c.IsActionColumn))
                    {
                        <th>
                            <input class="form-control"
                                   @bind="column.SearchValue"
                                   @bind:event="oninput" />
                        </th>
                    }

                    @if (Columns.Any(c => c.IsActionColumn))
                    {
                        <th></th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (PagedItems.Any())
                {
                    @if (IsCreating)
                    {
                        <tr class="table-success">
                            @foreach (var column in Columns.Where(c => !c.isHidden && !c.IsActionColumn))
                            {
                                <td>
                                    <input class="form-control"
                                           @onchange="e => SetNewValue(column, e.Value?.ToString())" />
                                </td>
                            }

                            <td>
                                <button class="btn btn-success btn-sm" @onclick="SaveNew">Save</button>
                                <button class="btn btn-secondary btn-sm" @onclick="CancelCreate">Cancel</button>
                            </td>
                        </tr>
                    }
                    @foreach (var item in PagedItems)
                    {
                        <tr>
                            <!-- Normal Columns -->
                            @foreach (var column in Columns.Where(c => !c.isHidden && !c.IsActionColumn))
                            {
                                <td>@column.RenderCell(item, EditingItem, ValidationErrors)</td>
                            }

                            <!-- Actions Column -->
                            @if (Columns.Any(c => c.IsActionColumn))
                            {
                                var actionColumn = Columns.First(c => c.IsActionColumn);
                                var actions = new List<RowAction<TItem>>();

                                actions.Add(new RowAction<TItem>
                                {
                                    Text = IsArabic ? "تعديل" : "Edit",
                                    CssClass = "btn btn-outline-warning btn-sm erp-row-action",
                                    Icon = "bi bi-pencil-square",
                                    Visible = _ => !EqualityComparer<TItem>.Default.Equals(EditingItem, item),
                                    OnClick = EventCallback.Factory.Create<TItem>(this, StartEdit)
                                });

                                actions.Add(new RowAction<TItem>
                                {
                                    Text = IsArabic ? "حفظ" : "Save",
                                    CssClass = "btn btn-outline-success btn-sm erp-row-action",
                                    Icon = "bi bi-check2",
                                    Visible = _ => EqualityComparer<TItem>.Default.Equals(EditingItem, item),
                                    OnClick = EventCallback.Factory.Create<TItem>(this, SaveEdit)
                                });

                                actions.Add(new RowAction<TItem>
                                {
                                    Text = IsArabic ? "حذف" : "Delete",
                                    CssClass = "btn btn-outline-danger btn-sm erp-row-action",
                                    Icon = "bi bi-trash",
                                    ConfirmMessage = _ => IsArabic ? "هل أنت متأكد؟" : "Are you sure?",
                                    OnClick = EventCallback.Factory.Create<TItem>(this, DeleteItem)
                                });

                                // 👉 Merge user actions
                                if (actionColumn.Actions != null)
                                {
                                    actions.AddRange(actionColumn.Actions(item));
                                }
                                <td>
                                    <div class="btn-group">
                                        @foreach (var action in actions)
                                        {
                                            if (action.Visible?.Invoke(item) == false)
                                                continue;

                                            var isDisabled = action.Disabled?.Invoke(item) == true;

                                            var isIconOnlyAction = IsIconOnlyAction(action);

                                            <button class="@action.CssClass"
                                                    title="@action.Text"
                                                    aria-label="@action.Text"
                                                    disabled="@isDisabled"
                                                    @onclick='async () =>
                                                            {
                                                                if (action.ConfirmMessage != null)
                                                                {
                                                                    var confirm = await JS.InvokeAsync<bool>("confirm", action.ConfirmMessage(item));
                                                                        if (!confirm) return;}
                                                                    await action.OnClick.InvokeAsync(item);
                                                                }'>

                                                        @if (!string.IsNullOrEmpty(action.Icon))
                                                        {
                                                            <i class="@action.Icon  mx-1"></i>
                                                        }

                                                        @if (!isIconOnlyAction)
                                                        {
                                                            @action.Text
                                                        }
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        }
    else
                        {
                            <tr>
                                <td class="text-danger text-center" colspan="@(Columns.Count)">
                                    @(IsArabic ? "لا توجد بيانات" : "No data available")
                                </td>
                            </tr>
                        }
                    </tbody>
        </table>

        <div class="row w-100 justify-content-between">
            <div class="col-auto text-start">
                <nav>
                    <ul class="pagination">
                        <li class="page-item @(CurrentPage == 1 ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage - 1)">
                                @(IsArabic ? "السابق" : "Previous")
                            </button>
                        </li>
                        @for (int tablePage = 1; tablePage <= TotalPages; tablePage++)
                        {
                            var indexPage = tablePage;
                            <li class="page-item @(CurrentPage == indexPage ? "active" : "")">
                                <button class="page-link" @onclick="() => GoToPage(indexPage)">
                                    @indexPage
                                </button>
                            </li>
                        }
                        <li class="page-item @(CurrentPage == TotalPages ? "disabled" : "")">
                            <button class="page-link" @onclick="() => GoToPage(CurrentPage + 1)">
                                @(IsArabic ? "التالي" : "Next")
                            </button>
                        </li>
                    </ul>
                </nav>
            </div>
            <div class="col-auto text-end">
                <div class="mb-3 d-flex align-items-center">
                    <label for="pageSizeSelector" class="me-2">@(IsArabic ? "عدد العناصر:" : "Items per page:")</label>
                    <select id="pageSizeSelector" class="form-select w-auto" @onchange="OnPageSizeChanged">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(size == PageSize)">
                                @size
                            </option>
                        }
                    </select>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<TItem> Items { get; set; } = new();
    [Parameter] public List<ColumnDefinition<TItem>> Columns { get; set; } = new();
    
    [Parameter] public string Language { get; set; } = "En";
    bool IsArabic => Language == "Ar";
    string Direction => IsArabic ? "rtl" : "ltr";

    #region Crud

    TItem? EditingItem;
    TItem? NewItem;
    bool IsCreating => NewItem != null;

    [Parameter] public EventCallback<TItem> OnCreate { get; set; }
    [Parameter] public EventCallback<TItem> OnUpdate { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
    [Parameter] public Func<TItem>? CreateNewItem { get; set; }
    [Parameter] public IValidator<TItem>? Validator { get; set; }
    void StartCreate()
    {
        if (CreateNewItem != null)
            NewItem = CreateNewItem();
    }

    async Task SaveNew()
    {
        if (NewItem != null)
        {
            await OnCreate.InvokeAsync(NewItem);
            NewItem = default;
        }
    }

    void CancelCreate() => NewItem = default;

    void StartEdit(TItem item)
    {
        EditingItem = item;
    }

    async Task SaveEdit(TItem item)
    {
        ValidationErrors.Clear(); // 🔥 important

        if (Validator is not null)
        {
            var result = await Validator.ValidateAsync(item);

            if (!result.IsValid)
            {
                ValidationErrors = result.Errors
                    .GroupBy(e => e.PropertyName)
                    .ToDictionary(
                        g => g.Key,
                        g => g.First().ErrorMessage
                    );

                return;
            }
        }

        await OnUpdate.InvokeAsync(item);
        EditingItem = default;
    }

    void CancelEdit() => EditingItem = default;

    async Task DeleteItem(TItem item)
    {
        await OnDelete.InvokeAsync(item);
    }


    void SetNewValue(ColumnDefinition<TItem> column, string? value)
    {
        if (NewItem == null) return;

        var prop = typeof(TItem).GetProperty(column.Property);
        if (prop != null && prop.CanWrite)
        {
            var converted = Convert.ChangeType(value, prop.PropertyType);
            column.SetValue?.Invoke(NewItem, converted);
            // prop.SetValue(NewItem, converted);
        }
    }

    Dictionary<string, string?> ValidationErrors = new();
    #endregion Crud


    int CurrentPage = 1;
    int PageSize = 10;
    int[] PageSizeOptions = new[] { 5, 10, 20, 50 };
    string? CurrentSortColumn;
    bool SortAscending = true;

    IEnumerable<TItem> FilteredItems => Items.Where(item =>
        Columns.All(c =>
            string.IsNullOrEmpty(c.SearchValue) ||
            (c.GetValue(item)?.ToString()?.Contains(c.SearchValue, StringComparison.OrdinalIgnoreCase) ?? false)
        )
    );

    IEnumerable<TItem> SortedItems =>
        string.IsNullOrEmpty(CurrentSortColumn)
            ? FilteredItems
            : (SortAscending
                ? FilteredItems.OrderBy(i => Columns.First(c => c.Property == CurrentSortColumn).GetValue(i))
                : FilteredItems.OrderByDescending(i => Columns.First(c => c.Property == CurrentSortColumn).GetValue(i)));

    IEnumerable<TItem> PagedItems => SortedItems.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    int TotalPages => (int)Math.Ceiling(SortedItems.Count() / (double)PageSize);

    void Sort(string property)
    {
        if (CurrentSortColumn == property)
            SortAscending = !SortAscending;
        else
        {
            CurrentSortColumn = property;
            SortAscending = true;
        }
    }

    void GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        CurrentPage = page;
    }

    void OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int newSize))
        {
            PageSize = newSize;
            CurrentPage = 1;
        }
    }

    private static bool IsIconOnlyAction(RowAction<TItem> action)
        => action.CssClass.Contains("erp-row-action", StringComparison.OrdinalIgnoreCase)
           || action.CssClass.Contains("branch-action", StringComparison.OrdinalIgnoreCase)
           || action.CssClass.Contains("org-action", StringComparison.OrdinalIgnoreCase)
           || action.CssClass.Contains("employee-action", StringComparison.OrdinalIgnoreCase)
           || action.CssClass.Contains("employee-lookup-action", StringComparison.OrdinalIgnoreCase)
           || action.CssClass.Contains("shift-action", StringComparison.OrdinalIgnoreCase);

    public class RowAction<T>
    {
        public string Text { get; set; } = "";
        public string CssClass { get; set; } = "btn btn-primary btn-sm";
        public string? Icon { get; set; }   // e.g. "bi bi-plus"
    
        public Func<T, bool>? Visible { get; set; }     // show/hide
        public Func<T, bool>? Disabled { get; set; }    // enable/disable
        
        public Func<T, string>? ConfirmMessage { get; set; } // ✅ NEW
        public EventCallback<T> OnClick { get; set; }
    }

    public class ColumnDefinition<T>
    {
        public string Title { get; set; } = "";
        public string Property { get; set; } = "";
        public string? SearchValue { get; set; }
        public bool isHidden { get; set; } = false;

        public Func<T, object?> GetValue { get; set; } = _ => null!;
        public Action<T, object?>? SetValue { get; set; }   // ✅ NEW (important)

        public ColumnType Type { get; set; } = ColumnType.Text;

        // Select support
        public List<SelectOption>? Options { get; set; }

        // Validation
        public Func<object?, string?>? Validator { get; set; }


        // public Func<T, object?> GetValue { get; set; } = _ => null!;
        public Func<T, RenderFragment>? CellTemplate { get; set; }
        
        // 🔥 NEW: multiple actions
        public Func<T, List<RowAction<T>>>? Actions { get; set; }
        public bool IsActionColumn => Actions != null; // ✅ NEW

        public RenderFragment RenderCell(
            T item,
            T? editingItem,
            Dictionary<string, string?> validationErrors) => builder =>
        {
            var value = GetValue(item);
            var valueStr = value?.ToString() ?? string.Empty;


            // --------------------------
            // PATTERN 1: Local image (pictureURL_)
            // --------------------------

            // --------------------------
            // PATTERN 2: Remote image (imageURL_)
            // --------------------------

            // --------------------------
            // PATTERN 3: Hyperlink (URL_)
            // New Rule: last part is property name containing ID
            // Example: URL_User_Details_Id => <a href="/user/details/{item.Id}">{value}</a>
            // --------------------------



            // --------------------------
            // PATTERN 1: Local image (pictureURL_)
            // --------------------------

            if (Property.StartsWith("pictureURL_", StringComparison.OrdinalIgnoreCase))
            {
                var parts = Property.Split('_', StringSplitOptions.RemoveEmptyEntries);

                string imagePath = "images";
                string width = "50";
                string height = "50";
                string defaultImage = "default.png";

                if (parts.Length > 3)
                {
                    bool hasCustomDefault = parts.Length >= 5 && parts[^1].Contains('.');
                    if (hasCustomDefault)
                    {
                        defaultImage = parts[^1];
                        height = parts[^2];
                        width = parts[^3];
                        imagePath = string.Join('/', parts.Skip(1).Take(parts.Length - 4));
                    }
                    else
                    {
                        height = parts[^1];
                        width = parts[^2];
                        imagePath = string.Join('/', parts.Skip(1).Take(parts.Length - 3));
                    }
                }

                var src = $"_content/HajjManagement.Shared/{imagePath}/{(string.IsNullOrEmpty(valueStr) ? defaultImage : valueStr)}";

                builder.OpenElement(0, "img");
                builder.AddAttribute(1, "src", src);
                builder.AddAttribute(2, "width", width);
                builder.AddAttribute(3, "height", height);
                builder.AddAttribute(4, "alt", "Image");
                builder.CloseElement();
            }

            // --------------------------
            // PATTERN 2: Remote image (imageURL_)
            // --------------------------

            else if (Property.StartsWith("imageURL_", StringComparison.OrdinalIgnoreCase))
            {
                var parts = Property.Split('_', StringSplitOptions.RemoveEmptyEntries);

                string width = "50";
                string height = "50";

                if (parts.Length >= 3)
                {
                    width = parts[1];
                    height = parts[2];
                }

                var src = string.IsNullOrEmpty(valueStr)
                ? "https://via.placeholder.com/50x50?text=No+Image"
                : valueStr;

                builder.OpenElement(0, "img");
                builder.AddAttribute(1, "src", src);
                builder.AddAttribute(2, "width", width);
                builder.AddAttribute(3, "height", height);
                builder.AddAttribute(4, "alt", "Image");
                builder.CloseElement();
            }

            // --------------------------
            // PATTERN 3: Hyperlink (URL_)
            // New Rule: last part is property name containing ID
            // Example: URL_User_Details_Id => <a href="/user/details/{item.Id}">{value}</a>
            // --------------------------
            else if (Property.StartsWith("URL_", StringComparison.OrdinalIgnoreCase))
            {
                dynamic val = value; // val.Id, val.Name
                var href = $"/{val.URL}/{val.Id}";

                builder.OpenElement(0, "a");
                builder.AddAttribute(1, "href", href);
                builder.AddContent(2, val.Name);
                builder.CloseElement();

            }
            
            // --------------------------
            // DEFAULT: Normal text or custom template
            // --------------------------
            else if (CellTemplate != null)
            {
                builder.AddContent(5, CellTemplate(item));
            }
            else
            {
                if (EqualityComparer<T>.Default.Equals(item, editingItem))
                {
                    switch (Type)
                    {
                        case ColumnType.Text:
                            builder.OpenElement(0, "input");
                            builder.AddAttribute(1, "class", "form-control");
                            builder.AddAttribute(2, "value", valueStr);
                            builder.AddAttribute(3, "onchange",
                                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                                {
                                    var val = e.Value?.ToString();

                                    SetValue?.Invoke(item, val);

                                    validationErrors.Remove(Property);
                                    var error = Validator?.Invoke(val);
                                    validationErrors[Property] = error;
                                }));
                            builder.CloseElement();
                            break;

                        case ColumnType.Number:
                            builder.OpenElement(0, "input");
                            builder.AddAttribute(1, "type", "number");
                            builder.AddAttribute(2, "class", "form-control");
                            builder.AddAttribute(3, "value", valueStr);
                            builder.AddAttribute(4, "onchange",
                                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                                {
                                    if (int.TryParse(e.Value?.ToString(), out var val))
                                    {
                                        SetValue?.Invoke(item, val);

                                        validationErrors.Remove(Property);
                                        var error = Validator?.Invoke(val);
                                        validationErrors[Property] = error;
                                    }
                                }));
                            builder.CloseElement();
                            break;

                        case ColumnType.Date:
                            builder.OpenElement(0, "input");
                            builder.AddAttribute(1, "type", "date");
                            builder.AddAttribute(2, "class", "form-control");
                            builder.AddAttribute(3, "value", value is DateTime dt ? dt.ToString("yyyy-MM-dd") : "");
                            builder.AddAttribute(4, "onchange",
                                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                                {
                                    if (DateTime.TryParse(e.Value?.ToString(), out var val))
                                    {
                                        SetValue?.Invoke(item, val);

                                        validationErrors.Remove(Property);
                                        var error = Validator?.Invoke(val);
                                        validationErrors[Property] = error;
                                    }
                                }));
                            builder.CloseElement();
                            break;

                        case ColumnType.Checkbox:
                            builder.OpenElement(0, "input");
                            builder.AddAttribute(1, "type", "checkbox");
                            builder.AddAttribute(2, "checked", value is bool b && b);
                            builder.AddAttribute(3, "onchange",
                                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                                {
                                    var val = (bool)e.Value!;
                                    SetValue?.Invoke(item, val);

                                    validationErrors.Remove(Property);
                                    var error = Validator?.Invoke(val);
                                    validationErrors[Property] = error;
                                }));
                            builder.CloseElement();
                            break;

                        case ColumnType.Select:
                            builder.OpenElement(0, "select");
                            builder.AddAttribute(1, "class", "form-control");

                            foreach (var opt in Options ?? new())
                            {
                                builder.OpenElement(2, "option");
                                builder.AddAttribute(3, "value", opt.Value);
                                if (opt.Value == valueStr)
                                    builder.AddAttribute(4, "selected", true);

                                builder.AddContent(5, opt.Text);
                                builder.CloseElement();
                            }

                            builder.AddAttribute(6, "onchange",
                                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                                {
                                    var val = e.Value?.ToString();
                                    SetValue?.Invoke(item, val);

                                    validationErrors.Remove(Property);
                                    var error = Validator?.Invoke(val);
                                    validationErrors[Property] = error;
                                }));

                            builder.CloseElement();
                            break;
                    }

                    // 🔥 GLOBAL VALIDATION UI (applies to ALL types)
                    if (validationErrors.ContainsKey(Property) && validationErrors[Property] != null)
                    {
                        builder.OpenElement(100, "div");
                        builder.AddAttribute(101, "class", "text-danger small");
                        builder.AddContent(102, validationErrors[Property]);
                        builder.CloseElement();
                    }
                }
                else
                {
                    builder.AddContent(11, valueStr);
                }
            }
        };



    }


    public enum ColumnType
    {
        Text,
        Number,
        Date,
        Checkbox,
        Select
    }
    public class SelectOption
    {
        public string Value { get; set; } = "";
        public string Text { get; set; } = "";
    }
}


