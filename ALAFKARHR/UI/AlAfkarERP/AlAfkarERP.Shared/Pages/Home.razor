@layout LandingPageLayout
@page "/"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.Catalog.Dtos
@inject IProductService ProductService
@inject ApiConfig ApiConfig
@inject SharedDataService SharedDataService

<PageTitle>ALAFKAR</PageTitle>

<main class="home-page" dir="@SharedDataService.PageDirection">
    <section class="home-hero">
        <div class="container">
            <div class="home-hero-grid">
                <div class="home-hero-content">
                    <span class="home-eyebrow">الأفكار الناجحة</span>
                    <h1>خدمات الإعاشة والسقيا المتكاملة</h1>
                    <p>
                        وجبات ساخنة وجافة للمشاريع الموسمية والخيرية، بتجهيز منظم وجودة واضحة من الطلب إلى التسليم.
                    </p>
                    <div class="home-hero-actions">
                        <a class="btn home-primary-action" href="#products">
                            <i class="bi bi-bag-check"></i>
                            استعرض المنتجات
                        </a>
                        <a class="btn home-secondary-action" href="/login">
                            <i class="bi bi-box-arrow-in-left"></i>
                            دخول النظام
                        </a>
                    </div>
                </div>

                <div class="home-hero-visual" aria-label="وجبة جاهزة من الأفكار">
                    <div class="home-product-tray">
                        <div class="home-product-media">
                            <span class="home-product-badge">
                                <i class="bi bi-check2-circle"></i>
                                جاهزة للطلب
                            </span>
                            <img alt="وجبة الأفكار" src="_content/AlAfkarERP.Shared/images/Meals/alkaramSingleMeal.png" />
                        </div>
                        <div class="home-product-content">
                            <span class="home-product-kicker">
                                <i class="bi bi-cup-hot"></i>
                                وجبات جاهزة
                            </span>
                            <strong>تنظيم سريع للطلبات الموسمية</strong>
                            <p>خيارات ساخنة وجافة، مع تجهيز واضح من الطلب إلى التسليم.</p>
                            <div class="home-product-delivery">
                                <i class="bi bi-truck"></i>
                                <span>الاستلام من المطبخ ويمكن توصيلها مجانا</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-service-strip" aria-label="مزايا الخدمة">
        <div class="container">
            <div class="home-service-grid">
                <div class="home-service-item">
                    <i class="bi bi-calendar2-check"></i>
                    <div>
                        <strong>مناسبة للمواسم</strong>
                        <span>تجهيز منظم للمشاريع الموسمية والخيرية.</span>
                    </div>
                </div>
                <div class="home-service-item">
                    <i class="bi bi-cup-hot"></i>
                    <div>
                        <strong>خيارات ساخنة وجافة</strong>
                        <span>منتجات واضحة من كتالوج المنتجات المخزنية.</span>
                    </div>
                </div>
                <div class="home-service-item">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <strong>جودة من الطلب للتسليم</strong>
                        <span>عرض الاسم والسعر والصورة من بيانات المنتج.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="products" class="store-section">
        <div class="container">
            <div class="store-heading">
                <div>
                    <span class="store-kicker">قائمة المنتجات</span>
                    <h2>اختر الوجبة المناسبة</h2>
                </div>
                <p>منتجات مباشرة من كتالوج المنتجات المخزنية، مع عرض الاسم والسعر والصورة من بيانات المنتج المخزني.</p>
            </div>

            <div class="store-toolbar" aria-label="@SharedDataService.SelectViewLang("Product filters", "تصفية المنتجات")">
                <label class="store-filter-field store-search-field">
                    <span>@SharedDataService.SelectViewLang("Search", "البحث")</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control"
                               value="@searchTerm"
                               @oninput="OnSearchInputChanged"
                               placeholder="@SharedDataService.SelectViewLang("Search products, brands, packages...", "ابحث في المنتجات والعلامات والتغليف...")" />
                    </div>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Category", "الصنف")</span>
                    <select class="form-select" value="@selectedCategoryId" @onchange="OnCategoryChanged">
                        <option value="">@SharedDataService.SelectViewLang("All categories", "كل الأصناف")</option>
                        @foreach (var category in filterMetadata.Categories)
                        {
                            <option value="@category.Id">@GetFilterOptionName(category)</option>
                        }
                    </select>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Brand", "العلامة")</span>
                    <select class="form-select" value="@selectedBrandId" @onchange="OnBrandChanged">
                        <option value="">@SharedDataService.SelectViewLang("All brands", "كل العلامات")</option>
                        @foreach (var brand in filterMetadata.Brands)
                        {
                            <option value="@brand.Id">@GetFilterOptionName(brand)</option>
                        }
                    </select>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Package", "التغليف")</span>
                    <select class="form-select" value="@selectedPackageId" @onchange="OnPackageChanged">
                        <option value="">@SharedDataService.SelectViewLang("All packages", "كل العبوات")</option>
                        @foreach (var package in filterMetadata.Packages)
                        {
                            <option value="@package.Id">@GetFilterOptionName(package)</option>
                        }
                    </select>
                </label>

                <label class="store-filter-field store-price-field">
                    <span>@SharedDataService.SelectViewLang("Min price", "أقل سعر")</span>
                    <input class="form-control"
                           inputmode="decimal"
                           min="0"
                           type="number"
                           value="@minPrice"
                           @onchange="OnMinPriceChanged"
                           placeholder="@GetPricePlaceholder(filterMetadata.MinPrice)" />
                </label>

                <label class="store-filter-field store-price-field">
                    <span>@SharedDataService.SelectViewLang("Max price", "أعلى سعر")</span>
                    <input class="form-control"
                           inputmode="decimal"
                           min="0"
                           type="number"
                           value="@maxPrice"
                           @onchange="OnMaxPriceChanged"
                           placeholder="@GetPricePlaceholder(filterMetadata.MaxPrice)" />
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Sort by", "الترتيب")</span>
                    <select class="form-select" value="@sortOption" @onchange="OnSortChanged">
                        <option value="newest_desc">@SharedDataService.SelectViewLang("Newest first", "الأحدث أولاً")</option>
                        <option value="name_asc">@SharedDataService.SelectViewLang("Name A-Z", "الاسم تصاعدياً")</option>
                        <option value="price_asc">@SharedDataService.SelectViewLang("Price low to high", "السعر من الأقل")</option>
                        <option value="price_desc">@SharedDataService.SelectViewLang("Price high to low", "السعر من الأعلى")</option>
                        <option value="brand_asc">@SharedDataService.SelectViewLang("Brand A-Z", "العلامة تصاعدياً")</option>
                    </select>
                </label>

                <div class="store-filter-actions">
                    <button class="btn home-primary-action store-filter-apply" type="button" @onclick="ApplyFiltersAsync">
                        <i class="bi bi-funnel"></i>
                        @SharedDataService.SelectViewLang("Apply", "تطبيق")
                    </button>
                    @if (HasActiveFilters)
                    {
                        <button class="btn home-secondary-action store-filter-clear" type="button" @onclick="ClearFiltersAsync">
                            <i class="bi bi-x-lg"></i>
                            @SharedDataService.SelectViewLang("Clear", "مسح")
                        </button>
                    }
                </div>
            </div>

            <div class="store-results-summary">
                @if (!isLoadingProducts)
                {
                    <span>
                        @SharedDataService.SelectViewLang("Showing", "عرض")
                        @productSkus.Count
                        @SharedDataService.SelectViewLang("of", "من")
                        @totalProductCount
                        @SharedDataService.SelectViewLang("products", "منتج")
                    </span>
                }
            </div>

            @if (isLoadingProducts)
            {
                <div class="product-state">
                    <div class="spinner-border" role="status" aria-label="جاري تحميل المنتجات"></div>
                    <span>جاري تحميل المنتجات...</span>
                </div>
            }
            else if (!productSkus.Any())
            {
                <div class="product-state">
                    <i class="bi bi-box-seam"></i>
                    <span>لا توجد منتجات متاحة للعرض حاليا.</span>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var sku in productSkus)
                    {
                        <article class="product-card">
                            <div class="product-media">
                                <img alt="@GetSkuName(sku)" src="@GetProductImage(sku)" />
                                @if (sku.ShowOnStore)
                                {
                                    <span class="product-badge">متاح</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(GetCategoryName(sku)))
                                {
                                    <span class="product-category-pill">@GetCategoryName(sku)</span>
                                }
                            </div>
                            <div class="product-body">
                                <div class="product-card-main">
                                    <div class="product-kicker">@GetBrandName(sku)</div>
                                    <h3>@GetSkuName(sku)</h3>
                                    <p>@GetSkuDescription(sku)</p>
                                    <div class="product-chip-row" aria-label="@SharedDataService.SelectViewLang("Product details", "تفاصيل المنتج")">
                                        @if (!string.IsNullOrWhiteSpace(GetPackageName(sku)))
                                        {
                                            <span class="product-chip">
                                                <i class="bi bi-box-seam"></i>
                                                @GetPackageName(sku)
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="product-action">
                                    <div class="product-price">
                                        <small>@SharedDataService.SelectViewLang("Price", "السعر")</small>
                                        <strong>@sku.Price.ToString("0.##") &#xFDFC;</strong>
                                    </div>
                                    <button class="btn home-primary-action product-buy-action" type="button">شراء</button>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <nav class="store-pagination" aria-label="@SharedDataService.SelectViewLang("Product pages", "صفحات المنتجات")">
                        <button class="btn home-secondary-action"
                                type="button"
                                disabled="@(pageIndex == 0 || isLoadingProducts)"
                                @onclick="PreviousPageAsync">
                            <i class="bi bi-chevron-right"></i>
                            @SharedDataService.SelectViewLang("Previous", "السابق")
                        </button>
                        <span>
                            @SharedDataService.SelectViewLang("Page", "صفحة")
                            @(pageIndex + 1)
                            @SharedDataService.SelectViewLang("of", "من")
                            @TotalPages
                        </span>
                        <button class="btn home-secondary-action"
                                type="button"
                                disabled="@(pageIndex >= TotalPages - 1 || isLoadingProducts)"
                                @onclick="NextPageAsync">
                            @SharedDataService.SelectViewLang("Next", "التالي")
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </nav>
                }
            }
        </div>
    </section>
</main>

@code {
    private readonly List<ProductSkuDto> productSkus = [];
    private PublicStoreProductSkuFilterMetadataDto filterMetadata = new();
    private bool isLoadingProducts = true;
    private string searchTerm = "";
    private string selectedCategoryId = "";
    private string selectedBrandId = "";
    private string selectedPackageId = "";
    private string minPrice = "";
    private string maxPrice = "";
    private string sortOption = "newest_desc";
    private int pageIndex;
    private const int PageSize = 6;
    private long totalProductCount;

    private int TotalPages => totalProductCount <= 0
        ? 1
        : (int)Math.Ceiling(totalProductCount / (double)PageSize);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrWhiteSpace(selectedCategoryId) ||
        !string.IsNullOrWhiteSpace(selectedBrandId) ||
        !string.IsNullOrWhiteSpace(selectedPackageId) ||
        !string.IsNullOrWhiteSpace(minPrice) ||
        !string.IsNullOrWhiteSpace(maxPrice) ||
        sortOption != "newest_desc";

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadFilterMetadataAsync();
        await LoadProductSkusAsync();
    }

    private async Task LoadFilterMetadataAsync()
    {
        var response = await ProductService.GetPublicStoreProductSkuFiltersAsync();
        if (response.IsSuccess && response.Data is not null)
        {
            filterMetadata = response.Data;
        }
    }

    private async Task LoadProductSkusAsync()
    {
        isLoadingProducts = true;

        try
        {
            var response = await ProductService.GetPublicStoreProductSkusAsync(BuildProductSkuRequest());
            if (response.IsSuccess && response.Data is not null)
            {
                productSkus.Clear();
                productSkus.AddRange(response.Data.Data);
                totalProductCount = response.Data.Count;
            }
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private PublicStoreProductSkuRequest BuildProductSkuRequest()
    {
        var (sortBy, sortDescending) = GetSortValues();

        return new PublicStoreProductSkuRequest
        {
            PageIndex = pageIndex,
            PageSize = PageSize,
            SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim(),
            CategoryId = TryParseGuid(selectedCategoryId),
            BrandId = TryParseGuid(selectedBrandId),
            PackageId = TryParseGuid(selectedPackageId),
            MinPrice = TryParseDecimal(minPrice),
            MaxPrice = TryParseDecimal(maxPrice),
            SortBy = sortBy,
            SortDescending = sortDescending
        };
    }

    private static Guid? TryParseGuid(string value)
        => Guid.TryParse(value, out var id) ? id : null;

    private static decimal? TryParseDecimal(string value)
        => decimal.TryParse(
            value,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out var price)
            ? price
            : null;

    private (string SortBy, bool SortDescending) GetSortValues()
        => sortOption switch
        {
            "name_asc" => ("name", false),
            "price_asc" => ("price", false),
            "price_desc" => ("price", true),
            "brand_asc" => ("brand", false),
            _ => ("newest", true)
        };

    private async Task ApplyFiltersAsync()
    {
        pageIndex = 0;
        await LoadProductSkusAsync();
    }

    private async Task ClearFiltersAsync()
    {
        searchTerm = "";
        selectedCategoryId = "";
        selectedBrandId = "";
        selectedPackageId = "";
        minPrice = "";
        maxPrice = "";
        sortOption = "newest_desc";
        pageIndex = 0;
        await LoadProductSkusAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs args)
    {
        selectedCategoryId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnBrandChanged(ChangeEventArgs args)
    {
        selectedBrandId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnPackageChanged(ChangeEventArgs args)
    {
        selectedPackageId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnMinPriceChanged(ChangeEventArgs args)
    {
        minPrice = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnMaxPriceChanged(ChangeEventArgs args)
    {
        maxPrice = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs args)
    {
        sortOption = args.Value?.ToString() ?? "newest_desc";
        await ApplyFiltersAsync();
    }

    private void OnSearchInputChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? "";
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex == 0)
        {
            return;
        }

        pageIndex--;
        await LoadProductSkusAsync();
    }

    private async Task NextPageAsync()
    {
        if (pageIndex >= TotalPages - 1)
        {
            return;
        }

        pageIndex++;
        await LoadProductSkusAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string GetSkuName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.NameEng) ? sku.NameEng : sku.Name,
            !string.IsNullOrWhiteSpace(sku.Name) ? sku.Name : sku.NameEng);

    private string GetSkuDescription(ProductSkuDto sku)
    {
        var brand = SharedDataService.SelectViewLang(sku.BrandNameEng ?? "", sku.BrandName ?? "");
        var packageName = SharedDataService.SelectViewLang(sku.PackageNameEng ?? "", sku.PackageName ?? "");

        if (!string.IsNullOrWhiteSpace(brand) && !string.IsNullOrWhiteSpace(packageName))
        {
            return $"{brand} - {packageName}";
        }

        return !string.IsNullOrWhiteSpace(brand)
            ? brand
            : "الاستلام من المطبخ ويمكن توصيلها مجانا";
    }

    private string GetCategoryName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.CategoryNameEng) ? sku.CategoryNameEng : sku.CategoryName ?? "",
            !string.IsNullOrWhiteSpace(sku.CategoryName) ? sku.CategoryName : sku.CategoryNameEng ?? "");

    private string GetBrandName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.BrandNameEng) ? sku.BrandNameEng : sku.BrandName ?? "",
            !string.IsNullOrWhiteSpace(sku.BrandName) ? sku.BrandName : sku.BrandNameEng ?? "");

    private string GetPackageName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.PackageNameEng) ? sku.PackageNameEng : sku.PackageName ?? "",
            !string.IsNullOrWhiteSpace(sku.PackageName) ? sku.PackageName : sku.PackageNameEng ?? "");

    private string GetFilterOptionName(PublicStoreFilterOptionDto option)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(option.NameEng) ? option.NameEng : option.Name ?? "",
            !string.IsNullOrWhiteSpace(option.Name) ? option.Name : option.NameEng ?? "");

    private string GetPricePlaceholder(decimal? price)
        => price.HasValue ? price.Value.ToString("0.##") : "";

    private string GetProductImage(ProductSkuDto sku)
    {
        if (string.IsNullOrWhiteSpace(sku.ImageUrl))
        {
            return "_content/AlAfkarERP.Shared/images/Meals/alkaramSingleMeal.png";
        }

        if (Uri.TryCreate(sku.ImageUrl, UriKind.Absolute, out _))
        {
            return sku.ImageUrl;
        }

        return $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}";
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
