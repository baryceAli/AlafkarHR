@code {
    private readonly List<ProductSkuDto> productSkus = [];
    private bool isLoadingProducts = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadProductSkusAsync();
    }

    private async Task LoadProductSkusAsync()
    {
        try
        {
            var response = await ProductService.GetPublicStoreProductSkusAsync(0, 6);
            if (response.IsSuccess && response.Data is not null)
            {
                productSkus.Clear();
                productSkus.AddRange(response.Data.Data);
            }
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private string GetSkuName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.NameEng) ? sku.NameEng : sku.Name,
            !string.IsNullOrWhiteSpace(sku.Name) ? sku.Name : sku.NameEng);

    private string GetSkuCode(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.SkuCodeEng) ? sku.SkuCodeEng : sku.SkuCode,
            !string.IsNullOrWhiteSpace(sku.SkuCode) ? sku.SkuCode : sku.SkuCodeEng);

    private string GetSkuDescription(ProductSkuDto sku)
    {
        var brand = SharedDataService.SelectViewLang(sku.BrandNameEng ?? "", sku.BrandName ?? "");
        var packageName = sku.PackageName ?? "";

        if (!string.IsNullOrWhiteSpace(brand) && !string.IsNullOrWhiteSpace(packageName))
        {
            return $"{brand} - {packageName}";
        }

        return !string.IsNullOrWhiteSpace(brand)
            ? brand
            : "الاستلام من المطبخ ويمكن توصيلها مجانا";
    }

    private string GetProductImage(ProductSkuDto sku)
    {
        if (string.IsNullOrWhiteSpace(sku.ImageUrl))
        {
            return "_content/AlAfkarERP.Shared/images/Meals/alkaramSingleMeal.png";
        }

        if (Uri.TryCreate(sku.ImageUrl, UriKind.Absolute, out _))
        {
            return sku.ImageUrl;
        }

        return $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}";
    }
}

