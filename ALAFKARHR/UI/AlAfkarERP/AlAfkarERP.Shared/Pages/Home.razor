    private string GetSkuDescription(ProductSkuDto sku)
    {
        var brand = SharedDataService.SelectViewLang(sku.BrandNameEng ?? "", sku.BrandName ?? "");
        var packageName = SharedDataService.SelectViewLang(sku.PackageNameEng ?? "", sku.PackageName ?? "");

        if (!string.IsNullOrWhiteSpace(brand) && !string.IsNullOrWhiteSpace(packageName))
        {
            return $"{brand} - {packageName}";
        }

        return !string.IsNullOrWhiteSpace(brand)
            ? brand
            : "الاستلام من المطبخ ويمكن توصيلها مجانا";
    }

