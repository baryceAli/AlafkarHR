    private string GetPricePlaceholder(decimal? price)
        => price.HasValue ? price.Value.ToString("0.##") : "";

    private decimal ClampPrice(decimal value)
    {
        if (value < PriceFloor)
        {
            return PriceFloor;
        }

        if (value > PriceCeiling)
        {
            return PriceCeiling;
        }

        return value;
    }

    private string FormatPriceValue(decimal value)
        => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string GetSelectedPriceRangeText()
        => $"{FormatPriceValue(SelectedMinPrice)} - {FormatPriceValue(SelectedMaxPrice)} \uFDFC";

    private string GetPriceRangeStyle()
    {
        var range = PriceCeiling - PriceFloor;
        if (range <= 0m)
        {
            return "--range-start: 0%; --range-end: 100%;";
        }

        var start = (SelectedMinPrice - PriceFloor) / range * 100m;
        var end = (SelectedMaxPrice - PriceFloor) / range * 100m;

        return $"--range-start: {FormatPriceValue(start)}%; --range-end: {FormatPriceValue(end)}%;";
    }

    private string GetProductImage(ProductSkuDto sku)
    {
        if (string.IsNullOrWhiteSpace(sku.ImageUrl))
        {
            return "_content/AlAfkarERP.Shared/images/Meals/alkaramSingleMeal.png";
        }

        if (Uri.TryCreate(sku.ImageUrl, UriKind.Absolute, out _))
        {
            return sku.ImageUrl;
        }

        return $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}";
    }

