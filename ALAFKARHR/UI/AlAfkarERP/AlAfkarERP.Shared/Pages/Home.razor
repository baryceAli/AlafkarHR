@layout CorporateLayout
@page "/store"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@inject IProductService ProductService
@inject ApiConfig ApiConfig
@inject SharedDataService SharedDataService
@inject AuthenticationStateProvider AuthenticationStateProvider

@using AlAfkarERP.Shared.Pages.PublicSite
<SiteMetadata Title="@Text("Store & packages", "الباقات والمنتجات")" Description="@Text("Explore our solutions and products and request a tailored quote.", "استعرض حلولنا ومنتجاتنا واطلب عرض سعر مناسبًا لاحتياجك.")" Brand="@Text(SiteContent.Brand.En, SiteContent.Brand.Ar)" />
<div class="home-page home-page-current" dir="@SharedDataService.PageDirection">
    <section class="af-section">
        <SiteHeading Title="@Text("Packages & products", "الباقات والمنتجات")" Description="@Text("Practical solutions shaped around your needs. Tell us what you need for a tailored quote.", "حلول عملية تناسب احتياجك. شاركنا متطلباتك للحصول على عرض سعر مناسب.")" />
        <SitePackages />
    </section>
    <section id="products" class="store-section">
        <div class="container">
            <div class="store-heading">
                <div class="store-heading-copy">
                    <span class="store-kicker">
                        <i class="bi bi-grid-3x3-gap"></i>
                        @Text("Product catalog", "كتالوج المنتجات")
                    </span>
                    <h2>@Text("Explore our products", "استعرض منتجاتنا")</h2>
                    <p>
                        @Text("Browse available products and request a quote tailored to your requirements.", "استعرض المنتجات المتاحة واطلب عرض سعر يناسب متطلباتك.")
                    </p>
                </div>
            </div>

            <div class="store-toolbar" aria-label="@SharedDataService.SelectViewLang("Product filters", "تصفية المنتجات")">
                <label class="store-filter-field store-search-field">
                    <span>@SharedDataService.SelectViewLang("Search", "البحث")</span>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control"
                               value="@searchTerm"
                               @oninput="OnSearchInputChanged"
                               placeholder="@SharedDataService.SelectViewLang("Search products, brands, packages...", "ابحث في المنتجات والعلامات والتغليف...")" />
                    </div>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Category", "الصنف")</span>
                    <select class="form-select" value="@selectedCategoryId" @onchange="OnCategoryChanged">
                        <option value="">@SharedDataService.SelectViewLang("All categories", "كل الأصناف")</option>
                        @foreach (var category in filterMetadata.Categories)
                        {
                            <option value="@category.Id">@GetFilterOptionName(category)</option>
                        }
                    </select>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Brand", "العلامة")</span>
                    <select class="form-select" value="@selectedBrandId" @onchange="OnBrandChanged">
                        <option value="">@SharedDataService.SelectViewLang("All brands", "كل العلامات")</option>
                        @foreach (var brand in filterMetadata.Brands)
                        {
                            <option value="@brand.Id">@GetFilterOptionName(brand)</option>
                        }
                    </select>
                </label>

                <label class="store-filter-field">
                    <span>@SharedDataService.SelectViewLang("Package", "التغليف")</span>
                    <select class="form-select" value="@selectedPackageId" @onchange="OnPackageChanged">
                        <option value="">@SharedDataService.SelectViewLang("All packages", "كل العبوات")</option>
                        @foreach (var package in filterMetadata.Packages)
                        {
                            <option value="@package.Id">@GetFilterOptionName(package)</option>
                        }
                    </select>
                </label>

                <div class="store-filter-field store-price-field store-range-field">
                    <div class="store-range-label">
                        <span>@SharedDataService.SelectViewLang("Price range", "نطاق السعر")</span>
                        <strong>@GetSelectedPriceRangeText()</strong>
                    </div>
                    <div class="store-range-control"
                         style="@GetPriceRangeStyle()"
                         aria-label="@SharedDataService.SelectViewLang("Price range", "نطاق السعر")">
                        <input class="store-range-input store-range-input-min"
                               type="range"
                               min="@FormatPriceValue(PriceFloor)"
                               max="@FormatPriceValue(PriceCeiling)"
                               step="@FormatPriceValue(PriceStep)"
                               value="@FormatPriceValue(SelectedMinPrice)"
                               @oninput="OnMinPriceChanged"
                               aria-label="@SharedDataService.SelectViewLang("Minimum price", "أقل سعر")" />
                        <input class="store-range-input store-range-input-max"
                               type="range"
                               min="@FormatPriceValue(PriceFloor)"
                               max="@FormatPriceValue(PriceCeiling)"
                               step="@FormatPriceValue(PriceStep)"
                               value="@FormatPriceValue(SelectedMaxPrice)"
                               @oninput="OnMaxPriceChanged"
                               aria-label="@SharedDataService.SelectViewLang("Maximum price", "أعلى سعر")" />
                    </div>
                </div>

                <label class="store-filter-field store-sort-field">
                    <span>@SharedDataService.SelectViewLang("Sort by", "الترتيب")</span>
                    <select class="form-select" value="@sortOption" @onchange="OnSortChanged">
                        <option value="newest_desc">@SharedDataService.SelectViewLang("Newest first", "الأحدث أولاً")</option>
                        <option value="name_asc">@SharedDataService.SelectViewLang("Name A-Z", "الاسم تصاعدياً")</option>
                        <option value="price_asc">@SharedDataService.SelectViewLang("Price low to high", "السعر من الأقل")</option>
                        <option value="price_desc">@SharedDataService.SelectViewLang("Price high to low", "السعر من الأعلى")</option>
                        <option value="brand_asc">@SharedDataService.SelectViewLang("Brand A-Z", "العلامة تصاعدياً")</option>
                    </select>
                </label>

                <div class="store-filter-actions">
                    <button class="btn home-primary-action store-filter-apply" type="button" @onclick="ApplyFiltersAsync">
                        <i class="bi bi-funnel"></i>
                        @SharedDataService.SelectViewLang("Apply", "تطبيق")
                    </button>
                    @if (HasActiveFilters)
                    {
                        <button class="btn home-secondary-action store-filter-clear" type="button" @onclick="ClearFiltersAsync">
                            <i class="bi bi-x-lg"></i>
                            @SharedDataService.SelectViewLang("Clear", "مسح")
                        </button>
                    }
                </div>
            </div>

            <div class="store-results-summary">
                @if (!isLoadingProducts)
                {
                    <span>
                        @SharedDataService.SelectViewLang("Showing", "عرض")
                        @productSkus.Count
                        @SharedDataService.SelectViewLang("of", "من")
                        @totalProductCount
                        @SharedDataService.SelectViewLang("products", "منتج")
                    </span>
                }
            </div>

            @if (isLoadingProducts)
            {
                <div class="product-grid product-grid-skeleton" role="status" aria-label="@SharedDataService.SelectViewLang("Loading products", "جاري تحميل المنتجات")">
                    @for (var index = 0; index < 6; index++)
                    {
                        <article class="product-card product-skeleton-card" aria-hidden="true">
                            <div class="product-media product-skeleton-media">
                                <span class="product-skeleton-shimmer product-skeleton-image"></span>
                                <span class="product-skeleton-shimmer product-skeleton-badge"></span>
                                <span class="product-skeleton-shimmer product-skeleton-pill"></span>
                            </div>
                            <div class="product-body">
                                <div class="product-card-main">
                                    <span class="product-skeleton-shimmer product-skeleton-kicker"></span>
                                    <span class="product-skeleton-shimmer product-skeleton-title"></span>
                                    <span class="product-skeleton-shimmer product-skeleton-line"></span>
                                    <span class="product-skeleton-shimmer product-skeleton-line short"></span>
                                    <span class="product-skeleton-shimmer product-skeleton-chip"></span>
                                </div>
                                <div class="product-action product-skeleton-action">
                                    <span class="product-skeleton-shimmer product-skeleton-price"></span>
                                    <span class="product-skeleton-shimmer product-skeleton-button"></span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <div class="product-state">
                    <div class="spinner-border" role="status" aria-label="@Text("Loading products", "جاري تحميل المنتجات")"></div>
                    <span>@Text("Loading products…", "جاري تحميل المنتجات…")</span>
                </div>
            }
            else if (productsError)
            {
                <div class="product-state" role="alert">
                    <span>@Text("Unable to load the catalog. Please try again.", "تعذر تحميل الكتالوج. يرجى المحاولة مرة أخرى.")</span>
                    <button class="btn home-secondary-action" type="button" @onclick="RetryCatalogAsync">@Text("Try again", "إعادة المحاولة")</button>
                </div>
            }
            else if (!productSkus.Any())
            {
                <div class="product-state">
                    <i class="bi bi-box-seam"></i>
                    <span>@Text("No products are currently available.", "لا توجد منتجات متاحة للعرض حاليًا.")</span>
                </div>
            }
            else
            {
                <div class="product-grid">
                    @foreach (var sku in productSkus)
                    {
                        <article class="product-card">
                            <div class="product-media">
                                @if (!string.IsNullOrWhiteSpace(sku.ImageUrl))
                                {
                                    <img alt="@GetSkuName(sku)" src="@GetProductImage(sku)" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <div class="af-product-placeholder" role="img" aria-label="@Text("Product image not available", "صورة المنتج غير متوفرة")"><i class="bi bi-box-seam" aria-hidden="true"></i></div>
                                }
                                @if (sku.ShowOnStore)
                                {
                                    <span class="product-badge">@Text("Available", "متاح")</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(GetCategoryName(sku)))
                                {
                                    <span class="product-category-pill">@GetCategoryName(sku)</span>
                                }
                            </div>
                            <div class="product-body">
                                <div class="product-card-main">
                                    <div class="product-kicker">@GetBrandName(sku)</div>
                                    <h3>@GetSkuName(sku)</h3>
                                    <p>@GetSkuDescription(sku)</p>
                                    <div class="product-chip-row" aria-label="@SharedDataService.SelectViewLang("Product details", "تفاصيل المنتج")">
                                        @if (!string.IsNullOrWhiteSpace(GetPackageName(sku)))
                                        {
                                            <span class="product-chip">
                                                <i class="bi bi-box-seam"></i>
                                                @GetPackageName(sku)
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="product-action">
                                    <div class="product-price">
                                        <small>@SharedDataService.SelectViewLang("Price", "السعر")</small>
                                        <strong>@sku.Price.ToString("0.##") &#xFDFC;</strong>
                                    </div>
                                    <a class="btn home-primary-action product-buy-action" href="@ProductInquiryUrl(sku)">@Text("Request a quote", "طلب عرض سعر")</a>
                                </div>
                            </div>
                        </article>
                    }
                </div>

                @if (TotalPages > 1)
                {
                    <nav class="store-pagination" aria-label="@SharedDataService.SelectViewLang("Product pages", "صفحات المنتجات")">
                        <button class="btn home-secondary-action"
                                type="button"
                                disabled="@(pageIndex == 0 || isLoadingProducts)"
                                @onclick="PreviousPageAsync">
                            <i class="bi bi-chevron-right"></i>
                            @SharedDataService.SelectViewLang("Previous", "السابق")
                        </button>
                        <span>
                            @SharedDataService.SelectViewLang("Page", "صفحة")
                            @(pageIndex + 1)
                            @SharedDataService.SelectViewLang("of", "من")
                            @TotalPages
                        </span>
                        <button class="btn home-secondary-action"
                                type="button"
                                disabled="@(pageIndex >= TotalPages - 1 || isLoadingProducts)"
                                @onclick="NextPageAsync">
                            @SharedDataService.SelectViewLang("Next", "التالي")
                            <i class="bi bi-chevron-left"></i>
                        </button>
                    </nav>
                }
            }
        </div>
    </section>
</div>

@code {
    private readonly List<ProductSkuDto> productSkus = [];
    private PublicStoreProductSkuFilterMetadataDto filterMetadata = new();
    private bool isLoadingProducts = true;
    private bool productsError;
    private string searchTerm = "";
    private string selectedCategoryId = "";
    private string selectedBrandId = "";
    private string selectedPackageId = "";
    private string minPrice = "";
    private string maxPrice = "";
    private string sortOption = "newest_desc";
    private int pageIndex;
    private const int PageSize = 6;
    private long totalProductCount;
    private Guid? authenticatedCustomerId;

    private int TotalPages => totalProductCount <= 0
        ? 1
        : (int)Math.Ceiling(totalProductCount / (double)PageSize);

    private bool HasActiveFilters =>
        !string.IsNullOrWhiteSpace(searchTerm) ||
        !string.IsNullOrWhiteSpace(selectedCategoryId) ||
        !string.IsNullOrWhiteSpace(selectedBrandId) ||
        !string.IsNullOrWhiteSpace(selectedPackageId) ||
        HasActivePriceRange ||
        sortOption != "newest_desc";

    private decimal PriceFloor => filterMetadata.MinPrice.GetValueOrDefault(0m) < 0m
        ? 0m
        : filterMetadata.MinPrice.GetValueOrDefault(0m);

    private decimal PriceCeiling => filterMetadata.MaxPrice.GetValueOrDefault(PriceFloor) < PriceFloor
        ? PriceFloor
        : filterMetadata.MaxPrice.GetValueOrDefault(PriceFloor);

    private decimal PriceStep => PriceCeiling - PriceFloor <= 20m ? 0.5m : 1m;

    private decimal SelectedMinPrice => ClampPrice(TryParseDecimal(minPrice) ?? PriceFloor);

    private decimal SelectedMaxPrice => ClampPrice(TryParseDecimal(maxPrice) ?? PriceCeiling);

    private bool HasActivePriceRange =>
        SelectedMinPrice > PriceFloor ||
        SelectedMaxPrice < PriceCeiling;

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {

        await ResolveAuthenticatedCustomerAsync();
        await LoadFilterMetadataAsync();
        await LoadProductSkusAsync();
    }

    private async Task ResolveAuthenticatedCustomerAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user.Identity?.IsAuthenticated != true)
            return;

        var customerClaim = user.FindFirst("customer_id")
            ?? user.FindFirst("CustomerId")
            ?? user.FindFirst("customerId");

        if (Guid.TryParse(customerClaim?.Value, out var customerId))
        {
            authenticatedCustomerId = customerId;
        }
    }

    private async Task LoadFilterMetadataAsync()
    {
        var response = await ProductService.GetPublicStoreProductSkuFiltersAsync();
        if (response.IsSuccess && response.Data is not null)
        {
            filterMetadata = response.Data;
        }
    }

    private async Task RetryCatalogAsync()
    {
        await LoadFilterMetadataAsync();
        await LoadProductSkusAsync();
    }

    private async Task LoadProductSkusAsync()
    {
        isLoadingProducts = true;
        productsError = false;

        try
        {
            var response = await ProductService.GetPublicStoreProductSkusAsync(BuildProductSkuRequest());
            if (response.IsSuccess && response.Data is not null)
            {
                productSkus.Clear();
                productSkus.AddRange(response.Data.Data);
                totalProductCount = response.Data.Count;
            }
            else { productsError = true; }
        }
        catch
        {
            productsError = true;
        }
        finally
        {
            isLoadingProducts = false;
        }
    }

    private PublicStoreProductSkuRequest BuildProductSkuRequest()
    {
        var (sortBy, sortDescending) = GetSortValues();

        return new PublicStoreProductSkuRequest
        {
            PageIndex = pageIndex,
            PageSize = PageSize,
            CustomerId = authenticatedCustomerId,
            SearchTerm = string.IsNullOrWhiteSpace(searchTerm) ? null : searchTerm.Trim(),
            CategoryId = TryParseGuid(selectedCategoryId),
            BrandId = TryParseGuid(selectedBrandId),
            PackageId = TryParseGuid(selectedPackageId),
            MinPrice = HasActivePriceRange ? SelectedMinPrice : null,
            MaxPrice = HasActivePriceRange ? SelectedMaxPrice : null,
            SortBy = sortBy,
            SortDescending = sortDescending
        };
    }

    private static Guid? TryParseGuid(string value)
        => Guid.TryParse(value, out var id) ? id : null;

    private static decimal? TryParseDecimal(string value)
        => decimal.TryParse(
            value,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out var price)
            ? price
            : null;

    private (string SortBy, bool SortDescending) GetSortValues()
        => sortOption switch
        {
            "name_asc" => ("name", false),
            "price_asc" => ("price", false),
            "price_desc" => ("price", true),
            "brand_asc" => ("brand", false),
            _ => ("newest", true)
        };

    private async Task ApplyFiltersAsync()
    {
        pageIndex = 0;
        await LoadProductSkusAsync();
    }

    private async Task ClearFiltersAsync()
    {
        searchTerm = "";
        selectedCategoryId = "";
        selectedBrandId = "";
        selectedPackageId = "";
        minPrice = "";
        maxPrice = "";
        sortOption = "newest_desc";
        pageIndex = 0;
        await LoadProductSkusAsync();
    }

    private async Task OnCategoryChanged(ChangeEventArgs args)
    {
        selectedCategoryId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnBrandChanged(ChangeEventArgs args)
    {
        selectedBrandId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnPackageChanged(ChangeEventArgs args)
    {
        selectedPackageId = args.Value?.ToString() ?? "";
        await ApplyFiltersAsync();
    }

    private async Task OnMinPriceChanged(ChangeEventArgs args)
    {
        var value = ClampPrice(TryParseDecimal(args.Value?.ToString() ?? "") ?? PriceFloor);
        if (value > SelectedMaxPrice)
        {
            value = SelectedMaxPrice;
        }

        minPrice = FormatPriceValue(value);
        await ApplyFiltersAsync();
    }

    private async Task OnMaxPriceChanged(ChangeEventArgs args)
    {
        var value = ClampPrice(TryParseDecimal(args.Value?.ToString() ?? "") ?? PriceCeiling);
        if (value < SelectedMinPrice)
        {
            value = SelectedMinPrice;
        }

        maxPrice = FormatPriceValue(value);
        await ApplyFiltersAsync();
    }

    private async Task OnSortChanged(ChangeEventArgs args)
    {
        sortOption = args.Value?.ToString() ?? "newest_desc";
        await ApplyFiltersAsync();
    }

    private void OnSearchInputChanged(ChangeEventArgs args)
    {
        searchTerm = args.Value?.ToString() ?? "";
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex == 0)
        {
            return;
        }

        pageIndex--;
        await LoadProductSkusAsync();
    }

    private async Task NextPageAsync()
    {
        if (pageIndex >= TotalPages - 1)
        {
            return;
        }

        pageIndex++;
        await LoadProductSkusAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string GetSkuName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.NameEng) ? sku.NameEng : sku.Name,
            !string.IsNullOrWhiteSpace(sku.Name) ? sku.Name : sku.NameEng);

    private string GetSkuDescription(ProductSkuDto sku)
    {
        var brand = SharedDataService.SelectViewLang(sku.BrandNameEng ?? "", sku.BrandName ?? "");
        var packageName = SharedDataService.SelectViewLang(sku.PackageNameEng ?? "", sku.PackageName ?? "");

        if (!string.IsNullOrWhiteSpace(brand) && !string.IsNullOrWhiteSpace(packageName))
        {
            return $"{brand} - {packageName}";
        }

        return !string.IsNullOrWhiteSpace(brand)
            ? brand
            : Text("Request a quote tailored to your needs.", "اطلب عرض سعر يناسب احتياجك.");
    }

    private string GetCategoryName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.CategoryNameEng) ? sku.CategoryNameEng : sku.CategoryName ?? "",
            !string.IsNullOrWhiteSpace(sku.CategoryName) ? sku.CategoryName : sku.CategoryNameEng ?? "");

    private string GetBrandName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.BrandNameEng) ? sku.BrandNameEng : sku.BrandName ?? "",
            !string.IsNullOrWhiteSpace(sku.BrandName) ? sku.BrandName : sku.BrandNameEng ?? "");

    private string GetPackageName(ProductSkuDto sku)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(sku.PackageNameEng) ? sku.PackageNameEng : sku.PackageName ?? "",
            !string.IsNullOrWhiteSpace(sku.PackageName) ? sku.PackageName : sku.PackageNameEng ?? "");

    private string GetFilterOptionName(PublicStoreFilterOptionDto option)
        => SharedDataService.SelectViewLang(
            !string.IsNullOrWhiteSpace(option.NameEng) ? option.NameEng : option.Name ?? "",
            !string.IsNullOrWhiteSpace(option.Name) ? option.Name : option.NameEng ?? "");

    private string GetPricePlaceholder(decimal? price)
        => price.HasValue ? price.Value.ToString("0.##") : "";

    private decimal ClampPrice(decimal value)
    {
        if (value < PriceFloor)
        {
            return PriceFloor;
        }

        if (value > PriceCeiling)
        {
            return PriceCeiling;
        }

        return value;
    }

    private string FormatPriceValue(decimal value)
        => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private string GetSelectedPriceRangeText()
        => $"{FormatPriceValue(SelectedMinPrice)} - {FormatPriceValue(SelectedMaxPrice)} \uFDFC";

    private string GetPriceRangeStyle()
    {
        var range = PriceCeiling - PriceFloor;
        if (range <= 0m)
        {
            return "--range-start: 0%; --range-end: 100%;";
        }

        var start = (SelectedMinPrice - PriceFloor) / range * 100m;
        var end = (SelectedMaxPrice - PriceFloor) / range * 100m;

        return $"--range-start: {FormatPriceValue(start)}%; --range-end: {FormatPriceValue(end)}%;";
    }

    private string GetProductImage(ProductSkuDto sku)
    {
        if (Uri.TryCreate(sku.ImageUrl, UriKind.Absolute, out _))
        {
            return sku.ImageUrl;
        }

        return $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}";
    }

    private string ProductInquiryUrl(ProductSkuDto sku)
    {
        var ar = !string.IsNullOrWhiteSpace(sku.Name) ? sku.Name : sku.ProductName ?? sku.NameEng ?? "";
        var en = !string.IsNullOrWhiteSpace(sku.NameEng) ? sku.NameEng : sku.ProductNameEng ?? ar;
        return $"/contact?type=Product&product={sku.Id}&source=/store&labelAr={Uri.EscapeDataString(ar)}&labelEn={Uri.EscapeDataString(en)}";
    }

    private string Text(string? en, string? ar)
        => SharedDataService.SelectViewLang(en ?? "", ar ?? "");

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
