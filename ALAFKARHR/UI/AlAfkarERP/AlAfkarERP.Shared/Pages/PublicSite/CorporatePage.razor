@page "/"
@page "/about"
@page "/services"
@page "/projects"
@page "/projects/{Slug}"
@page "/partners"
@page "/media"
@page "/media/{Slug}"
@layout CorporateLayout
@inherits SiteComponentBase
@using Microsoft.AspNetCore.Components.Routing
@inject NavigationManager Nav

<SiteMetadata Title="@Title" Description="@Description" Brand="@T(SiteContent.Brand)" />
@if (Path == "") { <SiteHome /> }
else
{
    <section class="af-section">
        <SiteHeading Title="@Title" Description="@Description" Eyebrow="@T(SiteContent.Brand)" />
        @if (Path == "about")
        {
            <div class="af-split"><div><h2>@T("Our story", "عن الشركة")</h2><p>@T(SiteContent.Intro)</p></div><div class="af-editorial"><span class="af-eyebrow">@T("Innovation with purpose", "ابتكار له غاية")</span><p>@T("We connect ideas with practical delivery, shaping solutions around the needs of institutions and communities.", "نربط الأفكار بالتنفيذ العملي، ونصمم الحلول انطلاقًا من احتياجات المؤسسات والمجتمعات.")</p></div></div>
            <div class="af-draft" role="note"><strong>@T("Editorial draft — pending company approval", "مسودة تحريرية — تحتاج اعتماد الشركة قبل النشر")</strong><p>@T("The vision, mission and management statement below are proposed copy.", "الرؤية والرسالة وكلمة الإدارة التالية صياغات مقترحة وليست تصريحات معتمدة.")</p></div>
            <div class="af-split"><div><h2>@T("Our vision", "رؤيتنا")</h2><p>@T("To turn promising ideas into sustainable institutional impact.", "تحويل الأفكار الواعدة إلى أثر مؤسسي مستدام.")</p></div><div><h2>@T("Our mission", "رسالتنا")</h2><p>@T("To develop practical institutional and digital solutions, manage purposeful initiatives, and strengthen capabilities through innovation and quality.", "تطوير حلول مؤسسية ورقمية عملية، وإدارة مبادرات نوعية، وتعزيز القدرات من خلال الابتكار والجودة.")</p></div></div>
            <h2>@T("Our values", "قيمنا")</h2><div class="af-values">@foreach (var value in SiteContent.Values) { <span>@T(value)</span> }</div>
            <div class="af-editorial"><h2>@T("Management statement · Draft", "كلمة الإدارة · مسودة")</h2><p>@T("Our direction is to connect strategic thinking with practical execution, building partnerships founded on transparency and solutions with lasting value.", "نتطلع إلى ربط التفكير الاستراتيجي بالتنفيذ العملي، وبناء شراكات قائمة على الشفافية وحلول تقدم قيمة مستدامة.")</p></div>
        }
        else if (Path == "services") { <SiteServices ShowOutcomes="true" /> }
        else if (Path == "projects" && currentSlug is null)
        {
            <label class="af-filter">@T("Field of work", "مجال العمل")<select @bind="selectedService"><option value="">@T("All fields", "كل المجالات")</option>@foreach (var service in SiteContent.Services) { <option value="@service.Key">@T(service.Title)</option> }</select></label>
            <div class="af-grid">@foreach (var p in FilteredProjects) { <SiteCard Title="@T(p.Title)" Description="@T(p.Summary)" Image="@p.Media.FirstOrDefault(x => !x.Video)" ImageAlt="@T(p.Media.FirstOrDefault(x => !x.Video)?.Alt ?? p.Title)" Href="@($"/projects/{p.Slug}")" Action="@T("Project details", "تفاصيل المشروع")"><p class="af-outcome">@T(p.Impact)</p></SiteCard> }</div>
            @if (!FilteredProjects.Any()) { @Empty() }
        }
        else if (Path == "projects" && Project is not null)
        {
            <div class="af-split"><div><h2>@T("The challenge", "التحدي")</h2><p>@T(Project.Challenge)</p></div><div><h2>@T("The solution & deliverables", "الحل والمخرجات")</h2><p>@T(Project.Solution)</p></div></div>
            <div class="af-editorial"><span class="af-eyebrow">@T("Impact", "الأثر")</span><p>@T(Project.Impact)</p></div><SiteGallery Items="Project.Media" />
            <a class="af-button" href="/contact?type=Consultation&context=@Project.ServiceKey&source=/projects">@T("Discuss a similar project", "ناقش مشروعًا مشابهًا")</a>
        }
        else if (Path == "partners") { <SitePartners /> @if (!SiteContent.Partners.Any(x => x.Approved)) { @Empty() } }
        else if (Path == "media" && currentSlug is null) { <SiteNewsList /> @if (!SiteContent.News.Any(x => x.Approved)) { @Empty() } }
        else if (Path == "media" && Article is not null)
        {
            <time datetime="@Article.Date.ToString("yyyy-MM-dd")">@Article.Date.ToString("yyyy-MM-dd")</time><p class="af-article">@T(Article.Body)</p><SiteGallery Items="Article.Media" />
            <div class="af-actions">@foreach (var file in Article.Downloads) { <a class="af-button af-button-outline" href="@file.Url" download>@T(file.Label)</a> }</div>
        }
        else { <p>@T("The requested content could not be found.", "تعذر العثور على المحتوى المطلوب.")</p><a class="af-button" href="/">@T("Back to home", "العودة للرئيسية")</a> }
    </section>
}
@code {
    [Parameter] public string? Slug { get; set; }
    private string selectedService = "";
    private string? previousRoute;
    private string Path { get; set; } = "";
    private string? currentSlug;
    private bool disposed;
    private IEnumerable<SiteProject> FilteredProjects => SiteContent.Projects.Where(x => x.Approved && (selectedService == "" || x.ServiceKey == selectedService));
    private SiteProject? Project => Path == "projects" ? SiteContent.Projects.FirstOrDefault(x => x.Approved && x.Slug == currentSlug) : null;
    private SiteNews? Article => Path == "media" ? SiteContent.News.FirstOrDefault(x => x.Approved && x.Slug == currentSlug) : null;
    private string Title => currentSlug is not null ? Project is not null ? T(Project.Title) : Article is not null ? T(Article.Title) : T("Content not found", "المحتوى غير موجود") : Path switch
    {
        "about" => T("About us", "من نحن"), "services" => T("Our services", "خدماتنا ومجالات العمل"), "projects" => T("Projects & innovation", "المشاريع والابتكارات"), "partners" => T("Partners in success", "شركاء النجاح"), "media" => T("Media center", "المركز الإعلامي"), _ => T(SiteContent.Brand)
    };
    private string Description => Project is not null ? T(Project.Summary) : Article is not null ? T(Article.Summary) : T(SiteContent.Intro);
    private RenderFragment Empty() => @<div class="af-empty"><i class="bi bi-folder2-open" aria-hidden="true"></i><p>@T("Approved updates will appear here when available.", "ستظهر المستجدات المعتمدة هنا عند توفرها.")</p></div>;
    protected override void OnInitialized()
    {
        base.OnInitialized();
        RefreshRoute();
        Nav.LocationChanged += LocationChanged;
    }

    protected override void OnParametersSet() => RefreshRoute();

    private void RefreshRoute()
    {
        // Shared routes can reuse this component without changing its parameters.
        // Read both section and slug from the URI to avoid stale detail-page state.
        var relativePath = Nav.ToBaseRelativePath(Nav.Uri).Split(new[] { '?', '#' }, 2)[0];
        var segments = relativePath.Trim('/').Split('/');
        Path = segments[0].ToLowerInvariant();
        currentSlug = (Path is "projects" or "media") && segments.Length > 1
            ? Uri.UnescapeDataString(segments[1])
            : null;
        var route = $"{Path}|{currentSlug}";
        if (previousRoute != route) { selectedService = ""; previousRoute = route; }
    }

    private void LocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (disposed) return;
        _ = InvokeAsync(() =>
        {
            if (disposed) return;
            // Use the latest URI if multiple navigation events have been queued.
            RefreshRoute();
            StateHasChanged();
        });
    }

    public override void Dispose()
    {
        disposed = true;
        Nav.LocationChanged -= LocationChanged;
        base.Dispose();
    }
}
