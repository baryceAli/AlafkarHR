@inherits SiteComponentBase
@using System.Linq.Expressions
@if (Context.GetValidationMessages(field).Any())
{
    <span class="validation-message" role="alert">@T(English, Arabic)</span>
}
@code {
    [CascadingParameter] public EditContext Context { get; set; } = default!;
    [Parameter, EditorRequired] public Expression<Func<string>> For { get; set; } = default!;
    [Parameter, EditorRequired] public string English { get; set; } = "";
    [Parameter, EditorRequired] public string Arabic { get; set; } = "";
    private EditContext? observed;
    private FieldIdentifier field;
    protected override void OnParametersSet()
    {
        field = FieldIdentifier.Create(For);
        if (observed == Context) return;
        if (observed is not null) observed.OnValidationStateChanged -= ValidationChanged;
        observed = Context;
        observed.OnValidationStateChanged += ValidationChanged;
    }
    private void ValidationChanged(object? sender, ValidationStateChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);
    public override void Dispose()
    {
        if (observed is not null) observed.OnValidationStateChanged -= ValidationChanged;
        base.Dispose();
    }
}
