<header class="af-heading">
    @if (!string.IsNullOrWhiteSpace(Eyebrow)) { <span class="af-eyebrow">@Eyebrow</span> }
    <h1>@Title</h1>
    <p>@Description</p>
</header>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? Eyebrow { get; set; }
}
