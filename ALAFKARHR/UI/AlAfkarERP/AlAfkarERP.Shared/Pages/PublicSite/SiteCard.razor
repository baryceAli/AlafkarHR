<article class="af-card">
    @if (Image is not null) { <img class="af-card-image" src="@Image.Url" alt="@ImageAlt" loading="lazy" decoding="async" width="640" height="400" /> }
    @if (Icon is not null) { <span class="af-icon" aria-hidden="true"><i class="bi @Icon"></i></span> }
    <h3>@Title</h3><p>@Description</p>
    @ChildContent
    @if (Href is not null) { <a class="af-text-action" href="@Href">@Action <span aria-hidden="true">↗</span></a> }
</article>
@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string? Icon { get; set; }
    [Parameter] public SiteMedia? Image { get; set; }
    [Parameter] public string? ImageAlt { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Action { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
