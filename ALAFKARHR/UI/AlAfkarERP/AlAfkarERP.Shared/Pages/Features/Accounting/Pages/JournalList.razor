@layout AdminLayout

@using AlAfkarERP.Shared.Pages.Features.Accounting.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Accounting.Dtos
@using SharedWithUI.Permissions

@implements IDisposable
@inject IAccountingService AccountingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Journal Entries", "القيود اليومية")"
                Subtitle="@SharedDataService.SelectViewLang("Balanced double-entry postings generated by accounting documents.", "قيود مزدوجة متوازنة ناتجة من المستندات المحاسبية.")"
                Overline="@SharedDataService.SelectViewLang("Accounting", "المحاسبة")"
                Icon="bi-journal-check" />

    @if (!CanView)
    {
        <div class="alert alert-warning">@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
    }
    else
    {
        <AppCard>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@SharedDataService.SelectViewLang("Number", "الرقم")</th>
                            <th>@SharedDataService.SelectViewLang("Date", "التاريخ")</th>
                            <th>@SharedDataService.SelectViewLang("Source", "المصدر")</th>
                            <th>@SharedDataService.SelectViewLang("Debit", "مدين")</th>
                            <th>@SharedDataService.SelectViewLang("Credit", "دائن")</th>
                            <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td><strong>@entry.Number</strong></td>
                                <td>@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                                <td>@entry.SourceDocumentNumber</td>
                                <td>@entry.TotalDebit.ToString("N2")</td>
                                <td>@entry.TotalCredit.ToString("N2")</td>
                                <td><span class="badge text-bg-secondary">@entry.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </AppCard>
    }
</div>

@code {
    private List<JournalEntryDto> entries = [];
    private AuthenticationState? authState;
    private Guid? companyId;
    private bool CanView => authState?.User.Claims.Any(c => c.Value == PermissionList.JournalEntryPermissions.View) == true;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var claim = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        if (Guid.TryParse(claim, out var parsedCompanyId))
            companyId = parsedCompanyId;

        var result = await AccountingService.GetJournalsAsync(companyId, 1, 50, null);
        if (result.IsSuccess && result.Data is not null)
            entries = result.Data.Data.ToList();
    }

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
