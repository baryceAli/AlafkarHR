@layout AdminLayout
@page "/Accounting/Journals"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Accounting.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Accounting.Dtos
@using SharedWithUI.Accounting.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions

@implements IDisposable
@inject IAccountingService AccountingService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@T("Journal Entries", "القيود اليومية")"
                Subtitle="@T("Balanced double-entry postings generated by accounting documents.", "قيود مزدوجة متوازنة ناتجة من المستندات المحاسبية.")"
                Overline="@T("Accounting", "المحاسبة")"
                Icon="bi-journal-check" />

    @if (!CanView)
    {
        <div class="alert alert-warning">@T("You don't have permissions to view this page", "ليس لديك صلاحية عرض هذه الصفحة")</div>
    }
    else
    {
        <AppCard>
            @if (CanCreate)
            {
                <EditForm Model="@quickEntry" OnValidSubmit="SaveQuickEntryAsync">
                    <DataAnnotationsValidator />
                    <div class="row g-3 align-items-end mb-3">
                        <div class="col-12 col-lg-2">
                            <label class="form-label">@T("Date", "التاريخ")</label>
                            <InputDate class="form-control" @bind-Value="quickEntry.EntryDate" />
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label">@T("Debit Account", "حساب المدين")</label>
                            <InputSelect class="form-select" @bind-Value="quickEntry.DebitAccountId">
                                <option value="@Guid.Empty">@T("Select", "اختر")</option>
                                @foreach (var account in postingAccounts)
                                {
                                    <option value="@account.Id">@AccountLabel(account)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label">@T("Credit Account", "حساب الدائن")</label>
                            <InputSelect class="form-select" @bind-Value="quickEntry.CreditAccountId">
                                <option value="@Guid.Empty">@T("Select", "اختر")</option>
                                @foreach (var account in postingAccounts)
                                {
                                    <option value="@account.Id">@AccountLabel(account)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label">@T("Amount", "المبلغ")</label>
                            <InputNumber class="form-control" @bind-Value="quickEntry.Amount" />
                        </div>
                        <div class="col-12 col-lg-2">
                            <label class="form-label">@T("Memo", "البيان")</label>
                            <InputText class="form-control" @bind-Value="quickEntry.Memo" />
                        </div>
                        <div class="col-12 col-lg-2">
                            <button class="btn btn-primary w-100" type="submit" disabled="@(!CanSaveQuick || savingQuick)">
                                <i class="bi bi-check2-circle"></i>
                                @T("Save and Post", "حفظ وترحيل")
                            </button>
                        </div>
                    </div>
                </EditForm>
            }
            <div class="input-group mb-3">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control" placeholder="@T("Search journals", "بحث في القيود")" @bind="searchText" @bind:event="oninput" />
                <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">@T("Search", "بحث")</button>
            </div>
            <div class="mb-3">
                <InputSelect class="form-select w-auto" @bind-Value="selectedBranchId" @bind-Value:after="OnBranchChangedAsync">
                    <option value="">@T("All allowed branches", "كل الفروع المتاحة")</option>
                    @foreach (var branch in VisibleBranches)
                    {
                        <option value="@branch.Id">@BranchLabel(branch)</option>
                    }
                </InputSelect>
            </div>
            <div class="erp-table-wrap">
                <table class="table align-middle erp-table">
                    <thead>
                        <tr>
                            <th>@T("Number", "الرقم")</th>
                            <th>@T("Date", "التاريخ")</th>
                            <th>@T("Source", "المصدر")</th>
                            <th>@T("Debit", "مدين")</th>
                            <th>@T("Credit", "دائن")</th>
                            <th>@T("Status", "الحالة")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in entries)
                        {
                            <tr>
                                <td><strong>@entry.Number</strong></td>
                                <td>@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                                <td>@entry.SourceModule / @entry.SourceDocumentNumber</td>
                                <td>@entry.TotalDebit.ToString("N2")</td>
                                <td>@entry.TotalCredit.ToString("N2")</td>
                                <td><StatusChip Text="@entry.Status.ToString()" Tone="@JournalTone(entry.Status)" /></td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-secondary" type="button" @onclick="() => selectedEntry = entry"><i class="bi bi-eye"></i></button>
                                        @if (CanReverseJournal(entry))
                                        {
                                            <button class="btn btn-outline-danger" type="button" @onclick="() => ReverseEntryAsync(entry.Id)"><i class="bi bi-arrow-counterclockwise"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!entries.Any())
            {
                <div class="text-muted py-4 text-center">@T("No journal entries found.", "لا توجد قيود يومية.")</div>
            }
        </AppCard>
    }
</div>

@if (selectedEntry is not null)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@selectedEntry.Number</h5>
                    <button class="btn-close" type="button" @onclick="() => selectedEntry = null"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-md-4"><strong>@T("Memo", "البيان"):</strong> @selectedEntry.Memo</div>
                        <div class="col-12 col-md-4"><strong>@T("Source", "المصدر"):</strong> @selectedEntry.SourceModule / @selectedEntry.SourceDocumentNumber</div>
                        <div class="col-12 col-md-4"><strong>@T("Totals", "الإجماليات"):</strong> @selectedEntry.TotalDebit.ToString("N2") / @selectedEntry.TotalCredit.ToString("N2")</div>
                    </div>
                    <div class="erp-table-wrap">
                        <table class="table align-middle erp-table">
                            <thead>
                                <tr>
                                    <th>@T("Account", "الحساب")</th>
                                    <th>@T("Description", "الوصف")</th>
                                    <th>@T("Debit", "مدين")</th>
                                    <th>@T("Credit", "دائن")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in selectedEntry.Lines)
                                {
                                    <tr>
                                        <td>@line.AccountCode - @line.AccountName</td>
                                        <td>@line.Description</td>
                                        <td>@line.Debit.ToString("N2")</td>
                                        <td>@line.Credit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" type="button" @onclick="() => selectedEntry = null">@T("Close", "إغلاق")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<JournalEntryDto> entries = [];
    private List<AccountDto> postingAccounts = [];
    private JournalEntryDto? selectedEntry;
    private AuthenticationState? authState;
    private Guid? companyId;
    private Guid? selectedBranchId;
    private List<BranchDto> branches = [];
    private CurrentUserBranchAccessDto branchAccess = new();
    private string? searchText;
    private bool savingQuick;
    private QuickJournalEntryDto quickEntry = new();
    private bool CanView => HasPermission(PermissionList.JournalEntryPermissions.View);
    private bool CanCreate => HasPermission(PermissionList.JournalEntryPermissions.Create);
    private bool CanReverse => HasPermission(PermissionList.JournalEntryPermissions.Reverse);
    private bool CanSaveQuick => companyId.HasValue
        && companyId.Value != Guid.Empty
        && quickEntry.DebitAccountId != Guid.Empty
        && quickEntry.CreditAccountId != Guid.Empty
        && quickEntry.DebitAccountId != quickEntry.CreditAccountId
        && quickEntry.Amount > 0;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var parsedCompanyId))
            companyId = parsedCompanyId;

        await LoadBranchAccessAsync();
        ResetQuickEntry();
        await LoadAccountsAsync();
        await LoadAsync();
    }

    private IEnumerable<BranchDto> VisibleBranches => branchAccess.CanViewAllBranches
        ? branches
        : branches.Where(x => branchAccess.BranchIds.Contains(x.Id));

    private async Task LoadBranchAccessAsync()
    {
        if (!companyId.HasValue || companyId.Value == Guid.Empty)
            return;

        var accessResult = await BranchService.GetCurrentUserBranchAccessAsync(companyId.Value);
        branchAccess = accessResult.IsSuccess ? accessResult.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();
        var branchesResult = await BranchService.GetByCompanyIdAsync(companyId.Value, 1, 500);
        if (branchesResult.IsSuccess && branchesResult.Data is not null)
            branches = branchesResult.Data.Data.ToList();
    }

    private async Task OnBranchChangedAsync()
    {
        ResetQuickEntry();
        await LoadAccountsAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!CanView)
            return;

        var result = await AccountingService.GetJournalsAsync(companyId, 1, 100, searchText, selectedBranchId);
        if (result.IsSuccess && result.Data is not null)
            entries = result.Data.Data.ToList();
        else
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not load journal entries.", "تعذر تحميل القيود اليومية."));
    }

    private async Task LoadAccountsAsync()
    {
        if (!companyId.HasValue || companyId.Value == Guid.Empty)
            return;

        var result = await AccountingService.GetAccountsAsync(companyId.Value, 1, 500, null, selectedBranchId);
        if (result.IsSuccess && result.Data is not null)
            postingAccounts = result.Data.Data.Where(x => x.IsActive && x.IsPostingAccount).OrderBy(x => x.Code).ToList();
    }

    private async Task SaveQuickEntryAsync()
    {
        if (!CanSaveQuick || !companyId.HasValue)
            return;

        savingQuick = true;
        quickEntry.CompanyId = companyId.Value;
        var result = await AccountingService.CreateQuickJournalEntryAsync(quickEntry);
        savingQuick = false;

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(T("Journal entry posted.", "تم ترحيل القيد."));
            ResetQuickEntry();
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not post journal entry.", "تعذر ترحيل القيد."));
        }
    }

    private void ResetQuickEntry()
    {
        quickEntry = new QuickJournalEntryDto
        {
            CompanyId = companyId ?? Guid.Empty,
            BranchId = selectedBranchId,
            EntryDate = DateTime.UtcNow.Date
        };
    }

    private async Task ReverseEntryAsync(Guid id)
    {
        var result = await AccountingService.ReverseJournalEntryAsync(id);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(T("Journal entry reversed.", "تم عكس القيد."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not reverse journal entry.", "تعذر عكس القيد."));
        }
    }

    private string AccountLabel(AccountDto account) => $"{account.Code} - {T(account.NameEng, account.Name)}";
    private string BranchLabel(BranchDto branch) => SharedDataService.SelectViewLang(branch.NameEng, branch.Name);

    private static string JournalTone(JournalEntryStatus status) => status switch
    {
        JournalEntryStatus.Posted => "success",
        JournalEntryStatus.Draft => "warning",
        JournalEntryStatus.Reversed => "info",
        _ => "muted"
    };

    private bool CanReverseJournal(JournalEntryDto entry) =>
        CanReverse
        && entry.Status == JournalEntryStatus.Posted
        && !string.Equals(entry.SourceModule, "Accounting", StringComparison.OrdinalIgnoreCase);

    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
