@layout AdminLayout
@page "/Accounting/Zatca/Settings"

@using AlAfkarERP.Shared.Pages.Features.Accounting.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Accounting.Dtos
@using SharedWithUI.Accounting.Enums
@using SharedWithUI.Permissions

@implements IDisposable
@inject IAccountingService AccountingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@T("ZATCA Settings", "إعدادات زاتكا")"
                Subtitle="@T("Seller identity, address, device label, and e-invoice environment settings.", "هوية البائع والعنوان واسم الجهاز وبيئة الفوترة الإلكترونية.")"
                Overline="@T("Accounting", "المحاسبة")"
                Icon="bi-shield-check" />

    @if (!CanView)
    {
        <div class="alert alert-warning">@T("You don't have permissions to view this page", "ليس لديك صلاحية عرض هذه الصفحة")</div>
    }
    else
    {
        <div class="row g-3">
            <div class="col-12 col-xl-8">
                <AppCard CssClass="h-100">
                    <EditForm Model="@settings" OnValidSubmit="SaveAsync">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12 col-lg-6">
                                <label class="form-label">@T("Seller Name", "اسم البائع")</label>
                                <InputText class="form-control" @bind-Value="settings.SellerName" />
                            </div>
                            <div class="col-12 col-lg-6">
                                <label class="form-label">@T("Seller Name Arabic", "اسم البائع بالعربية")</label>
                                <InputText class="form-control" @bind-Value="settings.SellerNameAr" />
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">@T("VAT Number", "الرقم الضريبي")</label>
                                <InputText class="form-control" @bind-Value="settings.VatNumber" />
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">@T("Commercial Registration", "السجل التجاري")</label>
                                <InputText class="form-control" @bind-Value="settings.CommercialRegistrationNumber" />
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">@T("Environment", "البيئة")</label>
                                <InputSelect class="form-select" @bind-Value="settings.Environment">
                                    <option value="Sandbox">Sandbox</option>
                                    <option value="Simulation">Simulation</option>
                                    <option value="Production">Production</option>
                                </InputSelect>
                            </div>
                            <div class="col-12 col-lg-4">
                                <label class="form-label">@T("Active Device Name", "اسم الجهاز النشط")</label>
                                <InputText class="form-control" @bind-Value="settings.ActiveDeviceName" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Building No.", "رقم المبنى")</label>
                                <InputText class="form-control" @bind-Value="settings.BuildingNumber" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Street", "الشارع")</label>
                                <InputText class="form-control" @bind-Value="settings.StreetName" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("District", "الحي")</label>
                                <InputText class="form-control" @bind-Value="settings.District" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("City", "المدينة")</label>
                                <InputText class="form-control" @bind-Value="settings.City" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Postal Code", "الرمز البريدي")</label>
                                <InputText class="form-control" @bind-Value="settings.PostalCode" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Country", "الدولة")</label>
                                <InputText class="form-control" @bind-Value="settings.CountryCode" />
                            </div>
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button class="btn btn-primary" type="submit" disabled="@(!CanEdit || saving)">
                                <i class="bi bi-save"></i>
                                @T("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>
            <div class="col-12 col-xl-4">
                <AppCard CssClass="h-100">
                    <h2 class="h5 mb-3">@T("Readiness Checklist", "قائمة الجاهزية")</h2>
                    @ChecklistItem(T("Seller name", "اسم البائع"), !string.IsNullOrWhiteSpace(settings.SellerName) && !string.IsNullOrWhiteSpace(settings.SellerNameAr))
                    @ChecklistItem(T("VAT number", "الرقم الضريبي"), !string.IsNullOrWhiteSpace(settings.VatNumber))
                    @ChecklistItem(T("Address", "العنوان"), HasAddress)
                    @ChecklistItem(T("Environment", "البيئة"), !string.IsNullOrWhiteSpace(settings.Environment))
                    @ChecklistItem(T("Saudi/SAR accounting template", "قالب السعودية/الريال"), setupStatus?.MinimumAccountsMissing == 0)
                    @ChecklistItem(T("Sales posting profile", "توجيه مبيعات"), HasProfile(PostingProfileType.Sales))
                    @ChecklistItem(T("Purchases posting profile", "توجيه مشتريات"), HasProfile(PostingProfileType.Purchases))
                    @ChecklistItem(T("Receipt/payment posting", "توجيه المقبوضات والمدفوعات"), HasProfile(PostingProfileType.CustomerReceipt) && HasProfile(PostingProfileType.SupplierPayment))
                    @ChecklistItem(T("Sales journal", "يومية المبيعات"), setupStatus?.JournalsExist == true)
                    @ChecklistItem(T("Device serial/name", "اسم أو رقم الجهاز"), !string.IsNullOrWhiteSpace(settings.ActiveDeviceName))
                </AppCard>
            </div>
        </div>
    }
</div>

@code {
    private ZatcaSettingsDto settings = new();
    private List<PostingProfileDto> profiles = [];
    private AccountingSetupStatusDto? setupStatus;
    private AuthenticationState? authState;
    private Guid companyId;
    private bool saving;
    private bool CanView => HasPermission(PermissionList.ZatcaSettingsPermissions.View);
    private bool CanEdit => HasPermission(PermissionList.ZatcaSettingsPermissions.Edit);
    private bool HasAddress => !string.IsNullOrWhiteSpace(settings.BuildingNumber)
        && !string.IsNullOrWhiteSpace(settings.StreetName)
        && !string.IsNullOrWhiteSpace(settings.City)
        && !string.IsNullOrWhiteSpace(settings.PostalCode);

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out companyId);
        settings.CompanyId = companyId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (companyId == Guid.Empty || !CanView)
            return;

        var result = await AccountingService.GetZatcaSettingsAsync(companyId);
        if (result.IsSuccess && result.Data is not null)
            settings = result.Data;

        var profilesResult = await AccountingService.GetPostingProfilesAsync(companyId);
        if (profilesResult.IsSuccess && profilesResult.Data is not null)
            profiles = profilesResult.Data;

        var setupResult = await AccountingService.GetSetupStatusAsync(companyId);
        if (setupResult.IsSuccess)
            setupStatus = setupResult.Data;
    }

    private async Task SaveAsync()
    {
        saving = true;
        settings.CompanyId = companyId;
        var result = await AccountingService.SaveZatcaSettingsAsync(settings);
        saving = false;

        if (result.IsSuccess)
            ToastService.ShowSuccess(T("ZATCA settings saved.", "تم حفظ إعدادات زاتكا."));
        else
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save settings.", "تعذر حفظ الإعدادات."));
    }

    private RenderFragment ChecklistItem(string label, bool ok) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "d-flex align-items-center justify-content-between border-bottom py-2");
        builder.AddContent(sequence++, label);
        builder.OpenComponent<StatusChip>(sequence++);
        builder.AddAttribute(sequence++, "Text", ok ? T("Ready", "جاهز") : T("Missing", "ناقص"));
        builder.AddAttribute(sequence++, "Tone", ok ? "success" : "warning");
        builder.CloseComponent();
        builder.CloseElement();
    };

    private bool HasProfile(PostingProfileType type) => profiles.Any(x => x.Type == type && x.IsDefault);
    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
