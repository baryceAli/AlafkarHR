@code {
    private List<BankAccountDto> bankAccounts = [];
    private List<CashAccountDto> cashAccounts = [];
    private List<AccountDto> accounts = [];
    private AuthenticationState? authState;
    private Guid companyId;
    private bool saving;
    private BankAccountDto? editingBank;
    private CashAccountDto? editingCash;
    private bool CanViewBank => HasPermission(PermissionList.BankAccountPermissions.View);
    private bool CanCreateBank => HasPermission(PermissionList.BankAccountPermissions.Create);
    private bool CanEditBank => HasPermission(PermissionList.BankAccountPermissions.Edit);
    private bool CanViewCash => HasPermission(PermissionList.CashAccountPermissions.View);
    private bool CanCreateCash => HasPermission(PermissionList.CashAccountPermissions.Create);
    private bool CanEditCash => HasPermission(PermissionList.CashAccountPermissions.Edit);

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out companyId);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (companyId == Guid.Empty)
            return;
        var accountResult = await AccountingService.GetAccountsAsync(companyId, 1, 500, null);
        if (accountResult.IsSuccess && accountResult.Data is not null)
            accounts = accountResult.Data.Data.Where(x => x.IsActive && x.IsPostingAccount).ToList();
        if (CanViewBank)
        {
            var bankResult = await AccountingService.GetBankAccountsAsync(companyId);
            if (bankResult.IsSuccess && bankResult.Data is not null)
                bankAccounts = bankResult.Data;
        }
        if (CanViewCash)
        {
            var cashResult = await AccountingService.GetCashAccountsAsync(companyId);
            if (cashResult.IsSuccess && cashResult.Data is not null)
                cashAccounts = cashResult.Data;
        }
    }

    private void OpenBank() => editingBank = new BankAccountDto { CompanyId = companyId, DisplayName = T("Main Bank", "البنك الرئيسي"), BankName = string.Empty, CurrencyCode = "SAR", CreateLinkedLedger = true, IsDefault = !bankAccounts.Any(), IsActive = true };
    private void EditBank(BankAccountDto bank) => editingBank = new BankAccountDto { Id = bank.Id, CompanyId = bank.CompanyId, DisplayName = bank.DisplayName, BankName = bank.BankName, AccountNumber = bank.AccountNumber, Iban = bank.Iban, BranchCode = bank.BranchCode, Swift = bank.Swift, CurrencyCode = bank.CurrencyCode, LedgerAccountId = bank.LedgerAccountId, JournalId = bank.JournalId, CreateLinkedLedger = false, IsDefault = bank.IsDefault, IsActive = bank.IsActive };
    private void CloseBank() => editingBank = null;
    private void OpenCash() => editingCash = new CashAccountDto { CompanyId = companyId, DisplayName = T("Main Cash", "الصندوق الرئيسي"), CurrencyCode = "SAR", CreateLinkedLedger = true, IsDefault = !cashAccounts.Any(), IsActive = true };
    private void EditCash(CashAccountDto cash) => editingCash = new CashAccountDto { Id = cash.Id, CompanyId = cash.CompanyId, DisplayName = cash.DisplayName, CurrencyCode = cash.CurrencyCode, LedgerAccountId = cash.LedgerAccountId, JournalId = cash.JournalId, CreateLinkedLedger = false, IsDefault = cash.IsDefault, IsActive = cash.IsActive };
    private void CloseCash() => editingCash = null;

    private async Task SaveBankAsync()
    {
        if (editingBank is null)
            return;
        saving = true;
        editingBank.CompanyId = companyId;
        if (editingBank.CreateLinkedLedger)
            editingBank.LedgerAccountId = null;
        var result = await AccountingService.SaveBankAccountAsync(editingBank);
        saving = false;
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(T("Bank account saved.", "تم حفظ الحساب البنكي."));
            editingBank = null;
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save bank account.", "تعذر حفظ الحساب البنكي."));
        }
    }

    private async Task SaveCashAsync()
    {
        if (editingCash is null)
            return;
        saving = true;
        editingCash.CompanyId = companyId;
        if (editingCash.CreateLinkedLedger)
            editingCash.LedgerAccountId = null;
        var result = await AccountingService.SaveCashAccountAsync(editingCash);
        saving = false;
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(T("Cash account saved.", "تم حفظ الحساب النقدي."));
            editingCash = null;
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save cash account.", "تعذر حفظ الحساب النقدي."));
        }
    }

    private string AccountLabel(Guid? id)
    {
        var account = accounts.FirstOrDefault(x => x.Id == id);
        return account is null ? "-" : $"{account.Code} - {T(account.NameEng, account.Name)}";
    }

    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
