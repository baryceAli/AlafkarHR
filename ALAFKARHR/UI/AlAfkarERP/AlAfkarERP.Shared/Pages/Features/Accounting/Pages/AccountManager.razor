@layout AdminLayout
@page "/Accounting/Accounts"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Accounting.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.Accounting.Dtos
@using SharedWithUI.Accounting.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions

@implements IDisposable
@inject IAccountingService AccountingService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@T("Chart of Accounts", "دليل الحسابات")"
                Subtitle="@T("Company-scoped ledger accounts used by posting profiles and journals.", "حسابات دفتر الأستاذ المستخدمة في التوجيهات والقيود.")"
                Overline="@T("Accounting", "المحاسبة")"
                Icon="bi-diagram-3" />

    @if (!CanView)
    {
        <div class="alert alert-warning">@T("You don't have permissions to view this page", "ليس لديك صلاحية عرض هذه الصفحة")</div>
    }
    else
    {
        <AppCard>
            <div class="d-flex flex-column flex-lg-row gap-2 justify-content-between mb-3">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" placeholder="@T("Search accounts", "بحث في الحسابات")" @bind="searchText" @bind:event="oninput" />
                    <button class="btn btn-outline-secondary" type="button" @onclick="LoadAsync">@T("Search", "بحث")</button>
                </div>
                <InputSelect class="form-select w-auto" @bind-Value="selectedBranchId" @bind-Value:after="LoadAsync">
                    <option value="">@T("All allowed branches", "كل الفروع المتاحة")</option>
                    @foreach (var branch in VisibleBranches)
                    {
                        <option value="@branch.Id">@BranchLabel(branch)</option>
                    }
                </InputSelect>
            </div>
            <div class="account-view-actions mb-3">
                <div class="erp-segmented-control" role="group" aria-label="@T("Account view", "عرض الحسابات")">
                    <button class="erp-segmented-button @(currentView == AccountViewMode.Table ? "active" : string.Empty)" type="button" @onclick="() => SetViewAsync(AccountViewMode.Table)">
                        <i class="bi bi-table"></i>
                        <span>@T("Table", "جدول")</span>
                    </button>
                    <button class="erp-segmented-button @(currentView == AccountViewMode.Tree ? "active" : string.Empty)" type="button" @onclick="() => SetViewAsync(AccountViewMode.Tree)">
                        <i class="bi bi-diagram-3"></i>
                        <span>@T("Tree", "شجرة")</span>
                    </button>
                </div>
            </div>

            @if (loading)
            {
                <div class="text-muted py-4 text-center">@T("Loading accounts...", "جاري تحميل الحسابات...")</div>
            }
            else
            {
                @if (currentView == AccountViewMode.Tree)
                {
                    <div class="account-tree-toolbar">
                        <div class="text-muted small">@T("Hierarchy view", "عرض شجري")</div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-secondary" type="button" @onclick="ExpandAll">
                                <i class="bi bi-arrows-expand"></i>
                                @T("Expand all", "توسيع الكل")
                            </button>
                            <button class="btn btn-outline-secondary" type="button" @onclick="CollapseAll">
                                <i class="bi bi-arrows-collapse"></i>
                                @T("Collapse all", "طي الكل")
                            </button>
                        </div>
                    </div>
                    <div class="account-tree-wrap" role="tree" aria-label="@T("Chart of accounts hierarchy", "التسلسل الشجري للحسابات")">
                                @foreach (var row in VisibleTreeRows)
                                {
                                    var account = row.Account;
                                    var hasChildren = HasVisibleChildren(account.Id);
                                    var isExpanded = expandedAccountIds.Contains(account.Id);
                                    var groupCheckboxId = GroupCheckboxId(account.Id);
                                    <div class="account-tree-item" style="--account-tree-depth:@row.Depth" role="treeitem" aria-expanded="@(hasChildren ? isExpanded : null)" aria-level="@(row.Depth + 1)">
                                        <div class="account-tree-row">
                                            <div class="account-tree-node">
                                                @if (hasChildren)
                                                {
                                                    <button class="account-tree-toggle" type="button" title="@ExpandToggleTitle(isExpanded)" aria-label="@ExpandToggleTitle(isExpanded)" @onclick="() => ToggleExpanded(account.Id)">
                                                        <i class="@ChevronClass(isExpanded)"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="account-tree-toggle account-tree-toggle-placeholder"></span>
                                                }
                                                <i class="@PostingIconClass(account)" role="img" title="@PostingTitle(account)" aria-label="@PostingTitle(account)"></i>
                                                <div class="account-tree-label @(account.IsActive ? null : "account-tree-label-muted")">
                                                    <div class="account-tree-name-line">
                                                        <strong>@T(account.NameEng, account.Name)</strong>
                                                        <i class="@NormalBalanceIconClass(account)" role="img" title="@NormalBalanceTitle(account)" aria-label="@NormalBalanceTitle(account)"></i>
                                                    </div>
                                                    <span>@account.Code</span>
                                                </div>
                                            </div>
                                            <div class="account-row-actions account-tree-controls">
                                                @if (CanCreate)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary" type="button" title="@AddChildTitle(account)" disabled="@account.IsPostingAccount" @onclick="() => StartCreateChild(account)">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                }
                                                @if (CanEdit)
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary" type="button" title="@T("Edit", "تعديل")" @onclick="() => StartEdit(account)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    @if (IsInlineEditorFor(account.Id))
                                    {
                                        <div class="account-inline-row">
                                            <EditForm Model="@editingAccount" OnValidSubmit="SaveInlineAsync">
                                                <DataAnnotationsValidator />
                                                <div class="erp-inline-editor account-tree-inline-editor" style="--account-tree-depth:@row.Depth">
                                                    <div class="account-inline-heading">
                                                        <strong>@InlineEditorTitle</strong>
                                                        <span class="text-muted small">@ParentInlineLabel</span>
                                                    </div>
                                                    <div class="account-tree-inline-grid">
                                                        <div>
                                                            <label class="form-label">@T("Code", "الكود")</label>
                                                            <div class="form-control form-control-sm account-code-input bg-light">@GeneratedCodeLabel(editingAccount)</div>
                                                        </div>
                                                        <div>
                                                            <label class="form-label">@T("Arabic Name", "الاسم العربي")</label>
                                                            <InputText class="form-control form-control-sm account-name-input" @bind-Value="editingAccount!.Name" />
                                                        </div>
                                                        <div>
                                                            <label class="form-label">@T("English Name", "الاسم الإنجليزي")</label>
                                                            <InputText class="form-control form-control-sm account-name-input" @bind-Value="editingAccount!.NameEng" />
                                                        </div>
                                                        <div class="account-tree-inline-option">
                                                            <div class="form-check account-inline-check">
                                                                <input id="@groupCheckboxId" class="form-check-input" type="checkbox" checked="@editingIsGroup" @onchange="OnInlineGroupChanged" />
                                                                <label class="form-check-label" for="@groupCheckboxId">@T("Group", "مجموعة")</label>
                                                            </div>
                                                        </div>
                                                        <div class="account-row-actions">
                                                            <button class="btn btn-sm btn-primary" type="submit" disabled="@savingInline">
                                                                <i class="bi bi-check-lg"></i>
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@savingInline" @onclick="CancelInline">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </EditForm>
                                        </div>
                                    }
                                </div>
                                }
                    </div>
                    @if (!VisibleTreeRows.Any())
                    {
                        <div class="text-muted py-4 text-center">@T("No accounts found.", "لا توجد حسابات.")</div>
                    }
                }
                else
                {
                <div class="erp-table-wrap">
                    <table class="table align-middle erp-table">
                        <thead>
                            <tr>
                                <th>@T("Code", "الكود")</th>
                                <th>@T("Name", "الاسم")</th>
                                <th>@T("Type", "النوع")</th>
                                <th>@T("Role", "الدور")</th>
                                <th>@T("Balance", "الطبيعة")</th>
                                <th>@T("Posting", "ترحيل")</th>
                                <th>@T("Template", "القالب")</th>
                                <th>@T("Status", "الحالة")</th>
                                <th class="account-actions-col">@T("Actions", "الإجراءات")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var account in VisibleAccounts)
                            {
                                <tr>
                                    <td><strong>@account.Code</strong></td>
                                    <td>
                                        <span class="@IndentClass(account)">@T(account.NameEng, account.Name)</span>
                                        @if (account.ParentAccountId.HasValue)
                                        {
                                            <div class="text-muted small">@ParentLabel(account.ParentAccountId.Value)</div>
                                        }
                                    </td>
                                    <td>@account.Type</td>
                                    <td>@(account.Role == AccountRole.None ? "-" : account.Role)</td>
                                    <td>@account.NormalBalance</td>
                                    <td><StatusChip Text="@T(account.IsPostingAccount ? "Ledger" : "Group", account.IsPostingAccount ? "دفتر" : "مجموعة")" Tone="@(account.IsPostingAccount ? "info" : "muted")" /></td>
                                    <td><StatusChip Text="@T(account.IsSystemAccount ? "System" : "User", account.IsSystemAccount ? "نظام" : "مستخدم")" Tone="@(account.IsSystemAccount ? "primary" : "muted")" /></td>
                                    <td><StatusChip Text="@T(account.IsActive ? "Active" : "Inactive", account.IsActive ? "نشط" : "غير نشط")" Tone="@(account.IsActive ? "success" : "muted")" /></td>
                                    <td>
                                        <div class="account-row-actions">
                                            @if (CanCreate)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" type="button" title="@AddChildTitle(account)" disabled="@account.IsPostingAccount" @onclick="() => StartCreateChild(account)">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                            }
                                            @if (CanEdit)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" type="button" title="@T("Edit", "تعديل")" @onclick="() => StartEdit(account)">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                                @if (IsInlineEditorFor(account.Id))
                                {
                                    <tr class="account-inline-row">
                                        <td colspan="9">
                                            <EditForm Model="@editingAccount" OnValidSubmit="SaveInlineAsync">
                                                <DataAnnotationsValidator />
                                                <div class="erp-inline-editor account-table-inline-editor">
                                                    <div class="account-inline-heading">
                                                        <strong>@InlineEditorTitle</strong>
                                                        <span class="text-muted small">@ParentInlineLabel</span>
                                                    </div>
                                                    <div class="row g-2">
                                                        <div class="col-12 col-md-2">
                                                            <label class="form-label">@T("Code", "الكود")</label>
                                                            <div class="form-control form-control-sm bg-light">@GeneratedCodeLabel(editingAccount)</div>
                                                        </div>
                                                        <div class="col-12 col-md-3">
                                                            <label class="form-label">@T("Arabic Name", "الاسم العربي")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="editingAccount!.Name" />
                                                        </div>
                                                        <div class="col-12 col-md-3">
                                                            <label class="form-label">@T("English Name", "الاسم الإنجليزي")</label>
                                                            <InputText class="form-control form-control-sm" @bind-Value="editingAccount!.NameEng" />
                                                        </div>
                                                        <div class="col-12 col-md-2">
                                                            <label class="form-label">@T("Type", "النوع")</label>
                                                            <InputSelect class="form-select form-select-sm" @bind-Value="editingAccount!.Type">
                                                                @foreach (var type in Enum.GetValues<AccountType>())
                                                                {
                                                                    <option value="@type">@type</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-12 col-md-2">
                                                            <label class="form-label">@T("Balance", "الطبيعة")</label>
                                                            <InputSelect class="form-select form-select-sm" @bind-Value="editingAccount!.NormalBalance">
                                                                @foreach (var balance in Enum.GetValues<NormalBalance>())
                                                                {
                                                                    <option value="@balance">@balance</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-12 col-md-2">
                                                            <label class="form-label">@T("Role", "الدور")</label>
                                                            <InputSelect class="form-select form-select-sm" @bind-Value="editingAccount!.Role">
                                                                @foreach (var role in Enum.GetValues<AccountRole>())
                                                                {
                                                                    <option value="@role">@role</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-12 col-md-4">
                                                            <label class="form-label">@T("Parent Account", "الحساب الأب")</label>
                                                            <InputSelect class="form-select form-select-sm" @bind-Value="editingAccount!.ParentAccountId">
                                                                <option value="">@T("None", "بدون")</option>
                                                                @foreach (var parent in AvailableParentAccounts)
                                                                {
                                                                    <option value="@parent.Id">@parent.Code - @T(parent.NameEng, parent.Name)</option>
                                                                }
                                                            </InputSelect>
                                                        </div>
                                                        <div class="col-12 col-md-2 d-flex align-items-end">
                                                            <div class="form-check">
                                                                <input class="form-check-input" type="checkbox" checked="@editingIsGroup" @onchange="OnInlineGroupChanged" />
                                                                <label class="form-check-label">@T("Group", "مجموعة")</label>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 col-md-2 d-flex align-items-end">
                                                            <div class="form-check">
                                                                <InputCheckbox class="form-check-input" @bind-Value="editingAccount!.IsActive" />
                                                                <label class="form-check-label">@T("Active", "نشط")</label>
                                                            </div>
                                                        </div>
                                                        <div class="col-12 col-md-2 d-flex align-items-end justify-content-md-end">
                                                            <div class="account-row-actions">
                                                                <button class="btn btn-sm btn-primary" type="submit" disabled="@savingInline">
                                                                    <i class="bi bi-check-lg"></i>
                                                                    @T("Save", "حفظ")
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-secondary" type="button" disabled="@savingInline" @onclick="CancelInline">
                                                                    <i class="bi bi-x-lg"></i>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </EditForm>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                @if (!VisibleAccounts.Any())
                {
                    <div class="text-muted py-4 text-center">@T("No accounts found.", "لا توجد حسابات.")</div>
                }
                }
            }
        </AppCard>
    }
</div>

@if (showCreate)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="@newAccount" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@T("Create Account", "إضافة حساب")</h5>
                        <button class="btn-close" type="button" @onclick="CloseCreate"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Code", "الكود")</label>
                                <div class="form-control bg-light">@GeneratedCodeLabel(newAccount)</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Arabic Name", "الاسم العربي")</label>
                                <InputText class="form-control" @bind-Value="newAccount.Name" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("English Name", "الاسم الإنجليزي")</label>
                                <InputText class="form-control" @bind-Value="newAccount.NameEng" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Type", "النوع")</label>
                                <InputSelect class="form-select" @bind-Value="newAccount.Type">
                                    @foreach (var type in Enum.GetValues<AccountType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Normal Balance", "الطبيعة")</label>
                                <InputSelect class="form-select" @bind-Value="newAccount.NormalBalance">
                                    @foreach (var balance in Enum.GetValues<NormalBalance>())
                                    {
                                        <option value="@balance">@balance</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Role", "الدور")</label>
                                <InputSelect class="form-select" @bind-Value="newAccount.Role">
                                    @foreach (var role in Enum.GetValues<AccountRole>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@T("Parent Account", "الحساب الأب")</label>
                                <InputSelect class="form-select" @bind-Value="newAccount.ParentAccountId">
                                    <option value="">@T("None", "بدون")</option>
                                    @foreach (var account in accounts)
                                    {
                                        <option value="@account.Id">@account.Code - @T(account.NameEng, account.Name)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="newAccount.IsPostingAccount" />
                                    <label class="form-check-label">@T("Posting account", "حساب ترحيلي")</label>
                                </div>
                            </div>
                            <div class="col-12 col-md-6">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="newAccount.IsActive" />
                                    <label class="form-check-label">@T("Active", "نشط")</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button class="btn btn-outline-secondary" type="button" @onclick="CloseCreate">@T("Cancel", "إلغاء")</button>
                        <button class="btn btn-primary" type="submit" disabled="@saving"><i class="bi bi-save"></i> @T("Save", "حفظ")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private const int AccountsPageSize = 200;
    private const string AccountViewStorageKey = "accounting.accounts.view";

    private readonly HashSet<Guid> expandedAccountIds = [];
    private List<AccountDto> accounts = [];
    private AuthenticationState? authState;
    private Guid companyId;
    private Guid? selectedBranchId;
    private List<BranchDto> branches = [];
    private CurrentUserBranchAccessDto branchAccess = new();
    private string? searchText;
    private AccountViewMode currentView = AccountViewMode.Tree;
    private bool loading;
    private bool saving;
    private bool savingInline;
    private bool showCreate;
    private bool initializedExpansion;
    private AccountDto newAccount = new();
    private AccountDto? editingAccount;
    private Guid? inlineAnchorAccountId;
    private InlineAccountMode inlineMode;
    private bool editingIsGroup;
    private bool CanView => HasPermission(PermissionList.AccountPermissions.View);
    private bool CanCreate => HasPermission(PermissionList.AccountPermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.AccountPermissions.Edit);
    private IEnumerable<AccountDto> VisibleAccounts => accounts
        .Where(AccountMatchesFilters)
        .OrderBy(x => x.Code);
    private List<AccountTreeRow> VisibleTreeRows => BuildVisibleTreeRows();
    private Dictionary<Guid, List<AccountDto>> VisibleTreeChildren => BuildVisibleTreeChildren();
    private IEnumerable<AccountDto> AvailableParentAccounts => accounts
        .Where(x => editingAccount is null || x.Id != editingAccount.Id)
        .Where(x => editingAccount is null || editingAccount.Id == Guid.Empty || !IsDescendantOf(x.Id, editingAccount.Id))
        .OrderBy(x => x.Code);
    private string InlineEditorTitle => inlineMode == InlineAccountMode.CreateChild
        ? T("Add child account", "إضافة حساب فرعي")
        : T("Edit account", "تعديل الحساب");
    private string ParentInlineLabel => editingAccount?.ParentAccountId is Guid parentId && parentId != Guid.Empty
        ? ParentLabel(parentId)
        : T("Root account", "حساب رئيسي");

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out companyId);
        await LoadBranchAccessAsync();
        await LoadAsync();
    }

    private IEnumerable<BranchDto> VisibleBranches => branchAccess.CanViewAllBranches
        ? branches
        : branches.Where(x => branchAccess.BranchIds.Contains(x.Id));

    private async Task LoadBranchAccessAsync()
    {
        if (companyId == Guid.Empty)
            return;

        var accessResult = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        branchAccess = accessResult.IsSuccess ? accessResult.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();
        var branchesResult = await BranchService.GetByCompanyIdAsync(companyId, 1, 500);
        if (branchesResult.IsSuccess && branchesResult.Data is not null)
            branches = branchesResult.Data.Data.ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var storedView = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", AccountViewStorageKey);
        if (Enum.TryParse<AccountViewMode>(storedView, out var view))
        {
            currentView = view;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadAsync()
    {
        if (companyId == Guid.Empty || !CanView)
            return;

        loading = true;
        var allAccounts = new List<AccountDto>();
        var pageIndex = 1;
        long totalCount = 0;
        AlAfkarERP.Shared.Dtos.ApiResult<AlAfkarERP.Shared.Dtos.PaginatedResult<AccountDto>>? result = null;

        while (pageIndex == 1 || allAccounts.Count < totalCount)
        {
            result = await AccountingService.GetAccountsAsync(companyId, pageIndex, AccountsPageSize, null, selectedBranchId);
            if (!result.IsSuccess || result.Data is null)
            {
                loading = false;
                ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not load accounts.", "تعذر تحميل الحسابات."));
                return;
            }

            totalCount = result.Data.Count;
            var page = result.Data.Data.ToList();
            allAccounts.AddRange(page);

            if (!page.Any())
                break;

            pageIndex++;
        }
        loading = false;
        if (result is not null)
        {
            accounts = allAccounts
                .GroupBy(x => x.Id)
                .Select(x => x.First())
                .OrderBy(x => x.Code)
                .ToList();
            if (!initializedExpansion)
            {
                ExpandAll();
                initializedExpansion = true;
            }
        }
        else
            ToastService.ShowError(result?.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not load accounts.", "تعذر تحميل الحسابات."));
    }

    private void OpenCreate()
    {
        newAccount = new AccountDto
        {
            CompanyId = companyId,
            BranchId = selectedBranchId,
            Type = AccountType.Asset,
            NormalBalance = NormalBalance.Debit,
            Role = AccountRole.None,
            IsPostingAccount = false,
            IsActive = true
        };
        showCreate = true;
    }

    private void CloseCreate() => showCreate = false;

    private async Task SaveAsync()
    {
        saving = true;
        newAccount.CompanyId = companyId;
        newAccount.BranchId = selectedBranchId;
        var result = await AccountingService.CreateAccountAsync(newAccount);
        saving = false;

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(T("Account created.", "تم إنشاء الحساب."));
            showCreate = false;
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not create account.", "تعذر إنشاء الحساب."));
        }
    }

    private void StartCreateChild(AccountDto parent)
    {
        if (parent.IsPostingAccount)
        {
            return;
        }

        editingAccount = new AccountDto
        {
            CompanyId = companyId,
            Code = string.Empty,
            Name = string.Empty,
            NameEng = string.Empty,
            Type = parent.Type,
            NormalBalance = parent.NormalBalance,
            Role = AccountRole.None,
            ParentAccountId = parent.Id,
            IsPostingAccount = true,
            IsActive = true
        };
        inlineAnchorAccountId = parent.Id;
        inlineMode = InlineAccountMode.CreateChild;
        editingIsGroup = !editingAccount.IsPostingAccount;
        expandedAccountIds.Add(parent.Id);
    }

    private void StartEdit(AccountDto account)
    {
        editingAccount = CloneAccount(account);
        inlineAnchorAccountId = account.Id;
        inlineMode = InlineAccountMode.Edit;
        editingIsGroup = !account.IsPostingAccount;
    }

    private void CancelInline()
    {
        editingAccount = null;
        inlineAnchorAccountId = null;
        editingIsGroup = false;
        savingInline = false;
    }

    private async Task SaveInlineAsync()
    {
        if (editingAccount is null)
            return;

        editingAccount.CompanyId = companyId;
        editingAccount.IsPostingAccount = !editingIsGroup;

        savingInline = true;
        var result = await AccountingService.SaveAccountAsync(editingAccount);
        savingInline = false;

        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(inlineMode == InlineAccountMode.CreateChild
                ? T("Account created.", "تم إنشاء الحساب.")
                : T("Account updated.", "تم تعديل الحساب."));
            CancelInline();
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save account.", "تعذر حفظ الحساب."));
        }
    }

    private bool IsInlineEditorFor(Guid accountId) => inlineAnchorAccountId == accountId && editingAccount is not null;

    private static AccountDto CloneAccount(AccountDto account) => new()
    {
        Id = account.Id,
        CompanyId = account.CompanyId,
        Code = account.Code,
        Name = account.Name,
        NameEng = account.NameEng,
        Type = account.Type,
        NormalBalance = account.NormalBalance,
        Role = account.Role,
        TemplateKey = account.TemplateKey,
        ParentAccountId = account.ParentAccountId,
        IsPostingAccount = account.IsPostingAccount,
        IsSystemAccount = account.IsSystemAccount,
        IsActive = account.IsActive
    };

    private void OnInlineGroupChanged(ChangeEventArgs args)
    {
        var nextIsGroup = args.Value is bool value && value;
        if (editingAccount is null)
        {
            editingIsGroup = nextIsGroup;
            return;
        }

        editingIsGroup = nextIsGroup;
    }

    private string GeneratedCodeLabel(AccountDto? account) =>
        account is null || account.Id == Guid.Empty
            ? T("Generated on save", "يتم توليده عند الحفظ")
            : account.Code;

    private bool IsDescendantOf(Guid possibleDescendantId, Guid ancestorId)
    {
        var parentByAccountId = accounts.ToDictionary(x => x.Id, x => x.ParentAccountId);
        var currentId = possibleDescendantId;
        var visited = new HashSet<Guid>();

        while (visited.Add(currentId) && parentByAccountId.TryGetValue(currentId, out var parentId))
        {
            if (!parentId.HasValue || parentId.Value == Guid.Empty)
                return false;

            if (parentId.Value == ancestorId)
                return true;

            currentId = parentId.Value;
        }

        return false;
    }

    private async Task SetViewAsync(AccountViewMode view)
    {
        currentView = view;
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", AccountViewStorageKey, view.ToString());
    }

    private bool AccountMatchesFilters(AccountDto account) => AccountMatchesSearch(account);

    private bool AccountMatchesSearch(AccountDto account)
    {
        if (string.IsNullOrWhiteSpace(searchText))
            return true;

        var text = searchText.Trim();
        return Contains(account.Code, text)
            || Contains(account.Name, text)
            || Contains(account.NameEng, text)
            || Contains(account.Role.ToString(), text)
            || Contains(account.Type.ToString(), text);
    }

    private static bool Contains(string? value, string search) =>
        !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);

    private HashSet<Guid> GetVisibleTreeAccountIds()
    {
        var ids = new HashSet<Guid>(accounts.Where(AccountMatchesFilters).Select(x => x.Id));
        var accountById = accounts.ToDictionary(x => x.Id);

        foreach (var id in ids.ToList())
        {
            var current = accountById.GetValueOrDefault(id);
            while (current?.ParentAccountId is Guid parentId && accountById.TryGetValue(parentId, out var parent))
            {
                ids.Add(parent.Id);
                current = parent;
            }
        }

        return ids;
    }

    private Dictionary<Guid, List<AccountDto>> BuildVisibleTreeChildren()
    {
        var visibleIds = GetVisibleTreeAccountIds();
        var visibleAccounts = accounts.Where(x => visibleIds.Contains(x.Id)).ToList();
        var visibleIdLookup = visibleAccounts.Select(x => x.Id).ToHashSet();

        return visibleAccounts
            .GroupBy(x => x.ParentAccountId.HasValue && visibleIdLookup.Contains(x.ParentAccountId.Value) ? x.ParentAccountId.Value : Guid.Empty)
            .ToDictionary(x => x.Key, x => x.OrderBy(account => account.Code).ToList());
    }

    private List<AccountTreeRow> BuildVisibleTreeRows()
    {
        var children = VisibleTreeChildren;
        var rows = new List<AccountTreeRow>();

        AppendTreeRows(Guid.Empty, 0);
        return rows;

        void AppendTreeRows(Guid parentId, int depth)
        {
            if (!children.TryGetValue(parentId, out var childAccounts))
                return;

            foreach (var account in childAccounts)
            {
                rows.Add(new AccountTreeRow(account, depth));

                if (expandedAccountIds.Contains(account.Id) || HasActiveFilters())
                    AppendTreeRows(account.Id, depth + 1);
            }
        }
    }

    private bool HasActiveFilters() => !string.IsNullOrWhiteSpace(searchText);
    private string BranchLabel(BranchDto branch) => SharedDataService.SelectViewLang(branch.NameEng, branch.Name);

    private bool HasVisibleChildren(Guid accountId) =>
        VisibleTreeChildren.TryGetValue(accountId, out var children) && children.Any();

    private void ToggleExpanded(Guid accountId)
    {
        if (!expandedAccountIds.Add(accountId))
            expandedAccountIds.Remove(accountId);
    }

    private void ExpandAll()
    {
        expandedAccountIds.Clear();
        var parentIds = accounts.Where(x => x.ParentAccountId.HasValue).Select(x => x.ParentAccountId!.Value).ToHashSet();
        foreach (var accountId in parentIds)
            expandedAccountIds.Add(accountId);
    }

    private void CollapseAll() => expandedAccountIds.Clear();

    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private string ParentLabel(Guid parentId)
    {
        var parent = accounts.FirstOrDefault(x => x.Id == parentId);
        return parent is null ? string.Empty : $"{parent.Code} - {T(parent.NameEng, parent.Name)}";
    }

