        : T("Add child", "إضافة فرعي");
    private string PostingIconClass(AccountDto account) => $"account-tree-icon account-tree-posting-icon {PostingStateClass(account)} bi {(account.IsPostingAccount ? "bi-file-earmark-text" : "bi-folder2")}";
    private string NormalBalanceIconClass(AccountDto account) => $"account-tree-balance-icon bi {(account.NormalBalance == NormalBalance.Debit ? "bi-arrow-down-left" : "bi-arrow-up-right")}";
    private string NormalBalanceTitle(AccountDto account) => account.NormalBalance == NormalBalance.Debit
        ? T("Debit", "مدين")
        : T("Credit", "دائن");
    private string PostingTitle(AccountDto account)
    {
        var ownerEn = account.IsSystemAccount ? "System" : "User";
        var ownerAr = account.IsSystemAccount ? "نظام" : "مستخدم";
        var statusEn = account.IsActive ? "active" : "inactive";
        var statusAr = account.IsActive ? "نشط" : "غير نشط";
        var kindEn = account.IsPostingAccount ? "ledger account" : "group account";
        var kindAr = account.IsPostingAccount ? "حساب ترحيلي" : "حساب مجموعة";
        return T($"{ownerEn} {statusEn} {kindEn}", $"{ownerAr} {statusAr} {kindAr}");
    }
    private static string PostingStateClass(AccountDto account) => account switch
    {
        { IsSystemAccount: true, IsActive: true } => "account-posting-system-active",
        { IsSystemAccount: true, IsActive: false } => "account-posting-system-inactive",
        { IsSystemAccount: false, IsActive: true } => "account-posting-user-active",
        _ => "account-posting-user-inactive"
    };
    private string ExpandToggleTitle(bool isExpanded) => T(isExpanded ? "Collapse" : "Expand", isExpanded ? "طي" : "توسيع");
    private string GroupCheckboxId(Guid accountId) => $"account-inline-group-{accountId:N}";
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;

