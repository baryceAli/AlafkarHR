@layout AdminLayout
@page "/Auth/User/List"
@implements IDisposable
@inject SharedDataService SharedDataService

@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Utilities

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title='@SharedDataService.SelectViewLang("User Management", "إدارة المستخدمين")'
                Overline='@SharedDataService.SelectViewLang("Auth", "الصلاحيات")'
                Icon="bi-people" />

    <AppCard>
        <EmptyState Title='@SharedDataService.SelectViewLang("User list is not configured yet.", "قائمة المستخدمين غير مهيأة بعد.")'
                    Message='@SharedDataService.SelectViewLang("Use the existing user assignment pages for role and branch access management.", "استخدم صفحات تعيين المستخدمين الحالية لإدارة الأدوار والوصول حسب الفروع.")'
                    Icon="bi-person-gear" />
    </AppCard>
</div>

@code {
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
