@layout AdminLayout
@page "/Auth/Role/Form"
@page "/Auth/Role/Form/{RoleName}"
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Pages.Features.Auth.Services

@inject IAuthService AuthService

@* @using AlAfkarERP.Shared.Pages.Features.Auth.Layout *@
@* @using AlAfkarERP.Shared.Pages.Features.Auth.Services *@
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Permissions
@inject SharedDataService SharedDataService;
@inject IRoleService RoleService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ModalService ModalService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

@if (AuthState != null && !AuthState.User.Claims.Any(c => c.Value == PermissionList.RolesPermissions.Create))
{
    <div class="alert alert-warning" dir="@SharedDataService.PageDirection">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page.", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>
    return;

}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title='@SharedDataService.SelectViewLang("Roles Management", "إدارة الصلاحيات")'
                Subtitle='@SharedDataService.SelectViewLang("Configure the role display name and permission matrix.", "تكوين اسم الدور ومصفوفة الصلاحيات.")'
                Overline='@SharedDataService.SelectViewLang("Auth", "الصلاحيات")'
                Icon="bi-shield-check" />

    <EditForm Model="roleDto" OnValidSubmit="ApplyChanges">
        <DataAnnotationsValidator />
        @* <ValidationSummary/> *@
        <AppCard Title='@SharedDataService.SelectViewLang("Role details", "بيانات الدور")' CssClass="mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-8">
                    <label for="inputFirstName" class="form-label">@SharedDataService.SelectViewLang("Role Name", "اسم الصلاحية")</label>
                    <InputText id="inputFirstName" class="form-control" @bind-Value="roleDto.DisplayName" />
                    <ValidationMessage For="() => roleDto.DisplayName" />
                </div>
                <div class="col-12 col-lg-4 d-flex justify-content-lg-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check2-circle"></i>
                        @SharedDataService.SelectViewLang("Apply Change", "حفظ التعديلات")
                    </button>
                </div>
            </div>
        </AppCard>

        @foreach (var group in PermissionList.GetGroupedPermissions(PermissionList.GetAll()))
        @* @foreach (var group in PermissionList.GetGroupedPermissions(roleDto.Permissions)) *@
        {
            <AppCard Title='@($"{SharedDataService.SelectViewLang("Group", "المجموعة")}: {group.Group}")' CssClass="mb-3" BodyClass="p-0">
                <div class="erp-table-wrap" dir="ltr">
                    <table class="table erp-table align-middle mb-0">
                        <tbody>
                            @{
                                bool index = true;
                            }
                            @foreach (var entity in group.Entities)
                            {
                                index = !index;
                                @* ENTITY AND POLICIES  *@
                                <tr>
                                    <td class="fw-semibold">@entity.Entity</td>
                                    @if (SelectedPermissions.Any())
                                    {
                                        @* <div class=@( index==true ? "col-7 bg-dark-subtle" : "col-7")> *@
                                        <td>
                                            <div class="d-flex flex-wrap gap-3">
                                                @foreach (var action in entity.Actions)
                                                {
                                                    var permission = $"{group.Group}.{entity.Entity}.{action}";

                                                    <label class="form-check-label d-inline-flex align-items-center gap-2">
                                                        <InputCheckbox class="form-check-input m-0"
                                                                       @bind-Value="SelectedPermissions[permission]"
                                                                       @onclick="() => OnCheckBoxClicked(permission)" />
                                                        @action
                                                    </label>
                                                    @* @onclick="() => { SelectedPermissions[permission] = !SelectedPermissions[permission]; }" /> *@
                                                }
                                            </div>
                                        </td>
                                        @* index = index + 1; *@
                                    }
                                    else
                                    {
                                        <td></td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </AppCard>
        }


    </EditForm>
</div>

@code {

    [Parameter]
    public string? RoleName { get; set; }
    private bool isEdit = false;
    // [CascadingParameter]
    // private Task<AuthenticationState> AuthStateTask { get; set; }
    private AuthenticationState AuthState;
    // private bool isChecked = false;
    private List<string> Roles = [];
    private Dictionary<string, bool> SelectedPermissions = new();
    // private List<string> CurrentRolePermissions = [];
    private Guid companyId;
    RoleDto roleDto = new RoleDto();
    protected override async Task OnInitializedAsync()
    {
        // if (!authState.User.Identity.IsAuthenticated)
        // {
        //     NavigationManager.NavigateTo("/");
        // }
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        // var authState = await AuthStateTask;
        Guid.TryParse(AuthState.User?.Claims?.FirstOrDefault(c => c.Type == "company_id")?.Value ?? "", out companyId);
        if (!string.IsNullOrWhiteSpace(RoleName))
        {
            RoleName = Uri.UnescapeDataString(RoleName);
            var roleRes = await RoleService.GetByName(RoleName);
            if (roleRes.IsSuccess)
            {
                isEdit = true;
                var role = roleRes.Data;
                foreach (var p in PermissionList.GetAll())
                {
                    SelectedPermissions[p] = role.Permissions.Any(r => r == p);
                }

                roleDto = new RoleDto
                {
                    RoleName = role.RoleName,
                    DisplayName = role.DisplayName,
                    CompanyId = companyId,
                    Permissions = role.Permissions ?? []
                };
                return;
            }
        }

        isEdit = false;
        foreach (var p in PermissionList.GetAll())
        {
            SelectedPermissions[p] = false;
        }

        roleDto = new RoleDto
        {
            RoleName = string.Empty,
            DisplayName = string.Empty,
            CompanyId = companyId,
            Permissions = []
        };
        // var cl = PermissionList.GetAll();
        // var res = AuthState.User.Claims.Any(c => c.Value == PermissionList.RolesPermissions.View);

    }
    private async Task ApplyChanges()
    {
        if (string.IsNullOrWhiteSpace(roleDto.DisplayName))
        {
            await ModalService.ShowAsync(
                new ModalOptions
                {
                    Title = SharedDataService.SelectViewLang("Roles Management", "إدارة الصلاحيات"),
                    IsError = true,
                    Message = SharedDataService.SelectViewLang("Role name is required.", "اسم الصلاحية مطلوب."),
                    OnOk = async () =>
                    {

                    }

            });
            return;
        }

        List<string> rolePermissions = new List<string>();
        foreach (var permission in PermissionList.GetAll())
        {
            // var val = SelectedPermissions[permission];
            if (SelectedPermissions[permission])
            {
                rolePermissions.Add(permission);
            }

        }
        roleDto.Permissions = new List<string>(rolePermissions);

        var res = await RoleService.CreateAsync(roleDto);
        if (res.IsSuccess)
        {
            await ModalService.ShowAsync(
                new ModalOptions
                {
                    Title = SharedDataService.SelectViewLang("Roles Management", "إدارة الصلاحيات"),
                    Message = SharedDataService
                                .SelectViewLang("Changed has been applied successfully",
                                "تم تطبيق التعديلات بنجاح"),
                    IsError = false,
                    OnOk = async () =>
                    {

                    }
                });
            NavigationManager.NavigateTo("/Auth/Role/List");
            return;
        }
        else
        {
            await ModalService.ShowAsync(
                new ModalOptions
                {
                    Title = SharedDataService.SelectViewLang("Roles Management", "إدارة الصلاحيات"),
                    Message = SharedDataService
                                .SelectViewLang("An error has occured, please try again later.",
                                "حدثت مشكلة أثناء محاولة تطبيق التعديلات، الرجاء المحاولة مرة أخرى"),
                    IsError = true,
                    OnOk = async () =>
                    {
                    
                    }
                });
        }

    }
    private void OnCheckBoxClicked(string policy)
    {
        SelectedPermissions[policy] = !SelectedPermissions[policy];

        // saveIt to db


        // if ()
        // {
            
        // }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
