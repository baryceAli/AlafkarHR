@layout AdminLayout
@page "/Auth/Role/List"
@implements IDisposable
@* @using AlAfkarERP.Shared.Pages.Features.Auth.Layout *@
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Permissions
@inject SharedDataService SharedDataService;
@inject IRoleService RoleService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager


@if (AuthState != null && !AuthState.User.Claims.Any(c => c.Value == PermissionList.RolesPermissions.View))
{
    <div class="alert alert-warning" dir="@SharedDataService.PageDirection">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page.", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>
    return;

}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title='@SharedDataService.SelectViewLang("Roles Management", "إدارة الصلاحيات")'
                Subtitle='@SharedDataService.SelectViewLang("Manage company roles and permission sets.", "إدارة أدوار الشركة ومجموعات الصلاحيات.")'
                Overline='@SharedDataService.SelectViewLang("Auth", "الصلاحيات")'
                Icon="bi-shield-lock">
        <Actions>
            <a class="btn btn-primary" href="/Auth/Role/Form">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create new", "إنشاء جديد")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title='@SharedDataService.SelectViewLang("Roles", "الأدوار")'>
        <div class="erp-table-toolbar">
            <div></div>
            <TableExportActions />
        </div>

        <div class="erp-table-wrap">
            <table class="table erp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@SharedDataService.SelectViewLang("Role", "الصلاحية")</th>
                        <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var role in roles)
                    {
                        <tr>
                            <td class="fw-semibold">@RoleDisplayName(role)</td>
                            <td class="text-end">
                                <button @onclick='() => { NavigationManager.NavigateTo($"/Auth/Role/Form/{Uri.EscapeDataString(role.RoleName)}"); }'
                                        class="btn btn-outline-warning btn-sm erp-row-action"
                                        title='@SharedDataService.SelectViewLang("Edit", "تعديل")'>
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                @* <button @onclick='() => { NavigationManager.NavigateTo($"/Auth/Role/AddUser/{role.RoleName}"); }' class="btn btn-warning">Add User</button> *@
                                <button class="btn btn-outline-danger btn-sm erp-row-action"
                                        title='@SharedDataService.SelectViewLang("Delete", "حذف")'>
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AppCard>
</div>



@foreach (var group in PermissionList.GetGroupedPermissions(PermissionList.GetAll()))
{
    
}


@code {
    private AuthenticationState AuthState;
    private List<RoleDto> roles = [];
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        // Guid companyId =
        Guid.TryParse(AuthState.User?.Claims?.FirstOrDefault(c => c.Type == "company_id")?.Value, out Guid companyId);
        var roleRes = await RoleService.GetRoles(companyId, 0, 1000);
        if (roleRes.IsSuccess)
        {
            roles = roleRes.Data?.ToList() ?? [];
        }
    }
    public void CheckedBoxChanged(ChangeEventArgs e)
    {
        var eee = e.Value;
        // if ()
        // {
            
        // }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

    private static string RoleDisplayName(RoleDto role)
        => string.IsNullOrWhiteSpace(role.DisplayName) ? role.RoleName : role.DisplayName;
}
