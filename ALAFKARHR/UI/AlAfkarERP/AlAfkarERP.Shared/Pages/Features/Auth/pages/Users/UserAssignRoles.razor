@layout AdminLayout
@page "/Auth/User/AssignRole"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions
@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using System.Security.Claims
@using System.Text

@inject IAuthService AuthService
@inject IRoleService RoleService
@inject IUserService UserService
@inject IBranchService BranchService
@inject ToastService ToastService
@inject ModalService ModalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (AuthState is not null && !CanAccessPage)
{
    <div class="alert alert-warning">
        @Text("You don't have permissions to view this page", "ليس لديك صلاحية لعرض هذه الصفحة")
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Manage user roles", "إدارة صلاحيات المستخدمين")"
                Subtitle="@Text("Assign or revoke company roles and reset user passwords.", "تعيين أو إلغاء صلاحيات الشركة وإعادة تعيين كلمات مرور المستخدمين.")"
                Icon="bi-person-check">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="OpenCreateUserModal"
                    disabled="@(!CanAssign || isBusy)">
                <i class="bi bi-person-plus"></i> @Text("Create User", "إنشاء مستخدم")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanAssign || isBusy)">
                <i class="bi bi-plus-lg"></i> @Text("Assign Role", "تعيين صلاحية")
            </button>
        </Actions>
    </PageHeader>

    @if (editingRow is not null)
    {
        <AppCard CssClass="mb-3 allow-overflow">
            <EditForm Model="assignRolesForm" OnValidSubmit="SaveRoles">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3 align-items-end">
                    @if (isCreateMode)
                    {
                        <div class="col-lg-5">
                            <label class="form-label">@Text("User", "المستخدم")</label>
                            <AutoCompleteComponent TItem="UserRolesRow"
                                                   Items="AvailableUsersForCreate"
                                                   ItemText="(row => row.DisplayName)"
                                                   Value="selectedCreateRow"
                                                   PlaceHolder="@Text("Search users ...", "ابحث عن المستخدمين ...")"
                                                   ValueChanged="OnCreateUserChanged" />
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-5">
                            <label class="form-label">@Text("User", "المستخدم")</label>
                            <div class="form-control">@editingRow.DisplayName</div>
                        </div>
                    }

                    <div class="col-lg-5">
                        <label class="form-label">@Text("Role", "الصلاحية")</label>
                        <AutoCompleteComponent TItem="RoleDto"
                                               @key="rolePickerKey"
                                               Items="AvailableRolesForEdit"
                                               ItemText="(role => RoleDisplayName(role))"
                                               Value="rolePickerValue"
                                               PlaceHolder="@Text("Search roles ...", "ابحث عن الصلاحيات ...")"
                                               ValueChanged="OnRoleValueChanged" />
                        @if (selectedRoles.Any())
                        {
                            <div class="d-flex flex-wrap gap-2 mt-2">
                                @foreach (var role in selectedRoles)
                                {
                                    <span class="erp-status-chip erp-status-chip-primary d-inline-flex align-items-center gap-2">
                                        @RoleDisplayName(role)
                                        <button type="button"
                                                class="btn-close"
                                                aria-label="@Text("Remove role", "إزالة الصلاحية")"
                                                @onclick="() => RemoveSelectedRole(role)"></button>
                                    </span>
                                }
                            </div>
                        }
                    </div>

                    <div class="col-lg-2 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-success btn-sm"
                                disabled="@(!CanAssign || isBusy)">
                            <i class="bi bi-check-lg"></i> @Text("Save", "حفظ")
                        </button>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                @onclick="CancelEdit"
                                disabled="@isBusy">
                            @Text("Cancel", "إلغاء")
                        </button>
                    </div>
                </div>

                @if (isCreateMode && AvailableUsersForCreate.Count == 0)
                {
                    <div class="text-muted small mt-3">
                        @Text("All editable users already have every assignable role.", "كل المستخدمين القابلين للتعديل لديهم جميع الصلاحيات المتاحة.")
                    </div>
                }
                else if (editingRow is not null && !AvailableRolesForEdit.Any() && !selectedRoles.Any())
                {
                    <div class="text-muted small mt-3">
                        @Text("All available roles are already assigned to this user.", "كل الصلاحيات المتاحة معينة لهذا المستخدم.")
                    </div>
                }
            </EditForm>
        </AppCard>
    }

    <AppCard>
        <FilterBar CssClass="mb-3">
            <ChildContent>
                <input class="form-control"
                       placeholder="@Text("Search", "بحث")"
                       @bind="SearchText"
                       @bind:event="oninput" />

                <select class="form-select erp-page-size-select" @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </ChildContent>

            <Actions>
                <TableExportActions />
            </Actions>
        </FilterBar>

        <div class="erp-table-wrap">
            <table class="table erp-table align-middle">
                <thead>
                    <tr>
                        <th @onclick="ToggleSort" class="sortable">
                            <i class="@SortIcon"></i>
                            @Text("User", "المستخدم")
                        </th>
                        <th>@Text("Roles", "الصلاحيات")</th>
                        <th class="text-end">@Text("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isBusy && userRoleRows.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                @Text("Loading role assignments ...", "جاري تحميل الصلاحيات ...")
                            </td>
                        </tr>
                    }
                    else if (!ProcessedRows.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                @Text("No user role assignments found.", "لا توجد صلاحيات مستخدمين.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in ProcessedRows)
                        {
                            <tr @key="row.User.Id">
                                <td>
                                    <div class="fw-semibold">@row.DisplayName</div>
                                    @if (row.IsProtectedAdmin)
                                    {
                                        <span class="erp-status-chip erp-status-chip-muted mt-1">
                                            <i class="bi bi-lock"></i> @Text("Protected admin", "مدير محمي")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var visibleRoles = DisplayRoles(row).ToList();
                                    }
                                    @if (visibleRoles.Count == 0)
                                    {
                                        <span class="text-muted small">
                                            @(row.IsProtectedAdmin ? Text("Protected admin", "مدير محمي") : Text("No roles assigned", "لا توجد صلاحيات"))
                                        </span>
                                    }
                                    else
                                    {
                                        @foreach (var role in visibleRoles)
                                        {
                                            <span class="erp-status-chip erp-status-chip-muted me-1">@RoleDisplayName(role)</span>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!row.IsProtectedAdmin)
                                    {
                                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                                @onclick="() => EditRow(row)"
                                                disabled="@(!CanAssign || isBusy || !GetUnassignedRoles(row).Any())"
                                                title="@Text("Assign role", "تعيين صلاحية")">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        <button class="btn btn-outline-primary btn-sm erp-row-action"
                                                @onclick="() => OpenResetPassword(row)"
                                                disabled="@(!CanResetPassword || isBusy)"
                                                title="@Text("Reset password", "إعادة تعيين كلمة المرور")">
                                            <i class="bi bi-key"></i>
                                        </button>

                                        <button class="btn btn-outline-secondary btn-sm erp-row-action"
                                                @onclick="() => OpenBranchAssignments(row)"
                                                disabled="@(!CanAssignBranches || isBusy)"
                                                title="@Text("Assign branches", "تعيين الفروع")">
                                            <i class="bi bi-diagram-3"></i>
                                        </button>

                                        <button class="btn btn-outline-info btn-sm erp-row-action"
                                                @onclick="() => OpenStoreBranchRoles(row)"
                                                disabled="@(!CanAssignBranches || isBusy)"
                                                title="@Text("Store branch roles", "صلاحيات فروع المتجر")">
                                            <i class="bi bi-shop-window"></i>
                                        </button>

                                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                                @onclick="() => OpenUnassignRoles(row)"
                                                disabled="@(!CanUnassign || isBusy || !DisplayRoles(row).Any())"
                                                title="@UnassignRoleTitle(row)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Text("Locked", "مغلق")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
            <button class="btn btn-sm btn-secondary"
                    @onclick="PrevPage"
                    disabled="@(pageIndex == 0 || isBusy)">
                @Text("Previous", "السابق")
            </button>

            <span class="text-muted small">
                @Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages
            </span>

            <button class="btn btn-sm btn-secondary"
                    @onclick="NextPage"
                    disabled="@(pageIndex >= TotalPages - 1 || isBusy)">
                @Text("Next", "التالي")
            </button>
        </div>
    </AppCard>
</div>

@if (showCreateUserModal)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <EditForm Model="createUserForm" OnValidSubmit="CreateCompanyUserAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@Text("Create user", "إنشاء مستخدم")</h5>
                        <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseCreateUserModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(createUserError))
                        {
                            <div class="alert alert-danger">
                                @createUserError
                            </div>
                        }

                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">@Text("User name", "اسم المستخدم")</label>
                                <InputText class="form-control" @bind-Value="createUserForm.UserName" />
                                <ValidationMessage For="@(() => createUserForm.UserName)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Email", "البريد الإلكتروني")</label>
                                <InputText type="email" class="form-control" @bind-Value="createUserForm.Email" />
                                <ValidationMessage For="@(() => createUserForm.Email)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Phone", "رقم الجوال")</label>
                                <InputText class="form-control" @bind-Value="createUserForm.PhoneNumber" />
                                <ValidationMessage For="@(() => createUserForm.PhoneNumber)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Temporary password", "كلمة المرور المؤقتة")</label>
                                <InputText type="password" class="form-control" @bind-Value="createUserForm.TemporaryPassword" />
                                <ValidationMessage For="@(() => createUserForm.TemporaryPassword)" />
                            </div>
                            <div class="col-12">
                                <label class="form-label">@Text("Initial roles", "الصلاحيات الأولية")</label>
                                @if (!AssignableRoles.Any())
                                {
                                    <div class="alert alert-light border mb-0">
                                        @Text("No assignable company roles are available.", "لا توجد صلاحيات شركة متاحة للتعيين.")
                                    </div>
                                }
                                else
                                {
                                    <div class="erp-role-check-grid">
                                        @foreach (var role in AssignableRoles)
                                        {
                                            <label class="erp-role-check-tile">
                                                <input class="form-check-input"
                                                       type="checkbox"
                                                       checked="@selectedCreateUserRoleNames.Contains(role.RoleName)"
                                                       @onchange="args => ToggleCreateUserRole(role.RoleName, args)" />
                                                <span class="erp-role-check-icon" aria-hidden="true">
                                                    <i class="bi bi-shield-check"></i>
                                                </span>
                                                <span class="form-check-label erp-role-check-label">@RoleDisplayName(role)</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>

                            @if (CanAssignBranches)
                            {
                                <div class="col-12">
                                    <label class="form-label">@Text("Branch access", "صلاحية الفروع")</label>
                                    @if (isLoadingCreateUserBranches)
                                    {
                                        <div class="alert alert-light border mb-0">
                                            @Text("Loading branches ...", "جاري تحميل الفروع ...")
                                        </div>
                                    }
                                    else if (branches.Count == 0)
                                    {
                                        <div class="alert alert-light border mb-0">
                                            @Text("No branches are available for this company.", "لا توجد فروع متاحة لهذه الشركة.")
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var branch in branches)
                                            {
                                                <label class="form-check d-flex align-items-center gap-2">
                                                    <input class="form-check-input"
                                                           type="checkbox"
                                                           checked="@selectedCreateUserBranchIds.Contains(branch.Id)"
                                                           @onchange="args => ToggleCreateUserBranch(branch.Id, args)" />
                                                    <span class="form-check-label">@LocalizedBranchName(branch)</span>
                                                </label>
                                            }
                                        </div>
                                    }
                                </div>

                                @if (selectedCreateUserBranchIds.Count > 0)
                                {
                                    <div class="col-md-6">
                                        <label class="form-label">@Text("Default branch", "الفرع الافتراضي")</label>
                                        <select class="form-select" @bind="createUserDefaultBranchIdText">
                                            <option value="">@Text("No default branch", "بدون فرع افتراضي")</option>
                                            @foreach (var branch in branches.Where(x => selectedCreateUserBranchIds.Contains(x.Id)))
                                            {
                                                <option value="@branch.Id">@LocalizedBranchName(branch)</option>
                                            }
                                        </select>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseCreateUserModal" disabled="@isBusy">
                            @Text("Cancel", "إلغاء")
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@(!CanAssign || isBusy)">
                            <i class="bi bi-person-plus"></i> @Text("Create", "إنشاء")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (resetPasswordRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="passwordReset" OnValidSubmit="ResetPasswordAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@Text("Reset password", "إعادة تعيين كلمة المرور")</h5>
                        <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseResetPassword"></button>
                    </div>
                    <div class="modal-body">
                        <p class="text-muted">
                            @Text($"Set a temporary password for {resetPasswordRow.DisplayName}.", $"تعيين كلمة مرور مؤقتة للمستخدم {resetPasswordRow.DisplayName}.")
                        </p>
                        <label class="form-label">@Text("Temporary password", "كلمة المرور المؤقتة")</label>
                        <InputText type="password" class="form-control" @bind-Value="passwordReset.TemporaryPassword" />
                        <ValidationMessage For="@(() => passwordReset.TemporaryPassword)" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="CloseResetPassword" disabled="@isBusy">
                            @Text("Cancel", "إلغاء")
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isBusy">
                            <i class="bi bi-key"></i> @Text("Reset", "إعادة تعيين")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (unassignRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Text("Unassign roles", "إلغاء تعيين الصلاحيات")</h5>
                    <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseUnassignRoles"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        @Text($"Choose roles to unassign from {unassignRow.DisplayName}.", $"اختر الصلاحيات المراد إلغاء تعيينها من المستخدم {unassignRow.DisplayName}.")
                    </p>

                    <div class="d-flex flex-column gap-2">
                        @foreach (var role in DisplayRoles(unassignRow))
                        {
                            var roleName = role.RoleName;
                            <label class="form-check d-flex align-items-center gap-2">
                                <input class="form-check-input"
                                       type="checkbox"
                                       checked="@selectedUnassignRoleNames.Contains(roleName)"
                                       @onchange="args => ToggleUnassignRole(roleName, args)" />
                                <span class="form-check-label">@RoleDisplayName(role)</span>
                            </label>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseUnassignRoles" disabled="@isBusy">
                        @Text("Cancel", "إلغاء")
                    </button>
                    <button type="button"
                            class="btn btn-danger"
                            @onclick="UnassignSelectedRolesAsync"
                            disabled="@(isBusy || selectedUnassignRoleNames.Count == 0)">
                        <i class="bi bi-trash"></i> @Text("Unassign", "إلغاء التعيين")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (branchAssignmentRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Text("Assign branches", "تعيين الفروع")</h5>
                    <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseBranchAssignments"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">
                        @Text($"Choose branch access for {branchAssignmentRow.DisplayName}.", $"اختر صلاحية الفروع للمستخدم {branchAssignmentRow.DisplayName}.")
                    </p>

                    @if (branches.Count == 0)
                    {
                        <div class="alert alert-warning mb-0">
                            @Text("No branches are available for this company.", "لا توجد فروع متاحة لهذه الشركة.")
                        </div>
                    }
                    else
                    {
                        <div class="row g-2">
                            @foreach (var branch in branches)
                            {
                                var branchId = branch.Id;
                                <div class="col-md-6">
                                    <label class="form-check border rounded p-2 d-flex align-items-start gap-2">
                                        <input class="form-check-input mt-1"
                                               type="checkbox"
                                               checked="@selectedBranchIds.Contains(branchId)"
                                               @onchange="args => ToggleBranchAssignment(branchId, args)" />
                                        <span class="form-check-label">
                                            <span class="fw-semibold">@LocalizedBranchName(branch)</span>
                                            @if (branch.IsMainBranch)
                                            {
                                                <span class="erp-status-chip erp-status-chip-muted ms-1">@Text("Main", "رئيسي")</span>
                                            }
                                            <span class="d-block text-muted small">@branch.Code</span>
                                        </span>
                                    </label>
                                </div>
                            }
                        </div>

                        <label class="form-label mt-3">@Text("Default branch", "الفرع الافتراضي")</label>
                        <select class="form-select" @bind="defaultBranchIdText" disabled="@(selectedBranchIds.Count == 0)">
                            <option value="">@Text("No default branch", "بدون فرع افتراضي")</option>
                            @foreach (var branch in branches.Where(x => selectedBranchIds.Contains(x.Id)))
                            {
                                <option value="@branch.Id">@LocalizedBranchName(branch)</option>
                            }
                        </select>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseBranchAssignments" disabled="@isBusy">
                        @Text("Cancel", "إلغاء")
                    </button>
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveBranchAssignments"
                            disabled="@(!CanAssignBranches || isBusy || branches.Count == 0)">
                        <i class="bi bi-check-lg"></i> @Text("Save", "حفظ")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (storeBranchRoleRow is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Text("Store branch roles", "صلاحيات فروع المتجر")</h5>
                    <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseStoreBranchRoles"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted">@Text($"Assign StoreFront operational roles for {storeBranchRoleRow.DisplayName}.", $"تعيين صلاحيات تشغيل واجهة المتجر للمستخدم {storeBranchRoleRow.DisplayName}.")</p>

                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-5">
                            <label class="form-label">@Text("Store branch", "فرع المتجر")</label>
                            <select class="form-select" @bind="selectedStoreRoleBranchIdText">
                                <option value="">@Text("Select StoreFront branch", "اختر فرع واجهة المتجر")</option>
                                @foreach (var branch in StoreFrontBranches)
                                {
                                    <option value="@branch.Id">@LocalizedBranchName(branch)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label">@Text("Role profile", "ملف الصلاحيات")</label>
                            <select class="form-select" @bind="selectedStoreRoleTemplateKey">
                                <option value="">@Text("Select role", "اختر صلاحية")</option>
                                @foreach (var profile in storeBranchRoleProfiles)
                                {
                                    <option value="@profile.TemplateKey">@Text(profile.Name, profile.NameAr)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary w-100"
                                    @onclick="AssignStoreBranchRoleAsync"
                                    disabled="@(isBusy || string.IsNullOrWhiteSpace(selectedStoreRoleBranchIdText) || string.IsNullOrWhiteSpace(selectedStoreRoleTemplateKey))">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    @if (!storeBranchRoleAssignments.Any())
                    {
                        <EmptyState Title="@Text("No StoreFront roles", "لا توجد صلاحيات لواجهة المتجر")"
                                    Message="@Text("Assign this user to a store branch role.", "عيّن هذا المستخدم إلى صلاحية فرع متجر.")"
                                    Icon="bi-shop-window" />
                    }
                    else
                    {
                        <div class="erp-table-wrap">
                            <table class="table erp-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@Text("Store branch", "فرع المتجر")</th>
                                        <th>@Text("Role", "الصلاحية")</th>
                                        <th class="text-end">@Text("Actions", "الإجراءات")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var assignment in storeBranchRoleAssignments)
                                    {
                                        <tr>
                                            <td>@LocalizedBranchNameById(assignment.BranchId)</td>
                                            <td>@Text(assignment.RoleName, assignment.RoleNameAr)</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveStoreBranchRoleAsync(assignment.Id)" disabled="@isBusy">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseStoreBranchRoles" disabled="@isBusy">@Text("Close", "إغلاق")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private AuthenticationState? AuthState;
    private Guid companyId;
    private bool isBusy;
    private bool isCreateMode;
    private bool sortAscending = true;
    private int pageSize = 5;
    private int pageIndex;
    private string searchText = string.Empty;

    private string SearchText
    {
        get => searchText;
        set
        {
            if (searchText == value)
            {
                return;
            }

            searchText = value;
            pageIndex = 0;
        }
    }

    private List<UserDto> authUsers = [];
    private List<RoleDto> allRoles = [];
    private List<UserRolesRow> userRoleRows = [];

    private UserRolesRow? editingRow;
    private UserRolesRow? selectedCreateRow;
    private UserRolesRow? resetPasswordRow;
    private UserRolesRow? unassignRow;
    private UserRolesRow? branchAssignmentRow;
    private UserRolesRow? storeBranchRoleRow;
    private RoleDto? rolePickerValue;
    private AssignRolesFormModel assignRolesForm = new();
    private PasswordResetModel passwordReset = new();
    private CreateUserFormModel createUserForm = new();
    private bool showCreateUserModal;
    private bool isLoadingCreateUserBranches;
    private List<RoleDto> selectedRoles = [];
    private List<BranchDto> branches = [];
    private List<BranchRoleProfileDto> storeBranchRoleProfiles = [];
    private List<BranchRoleAssignmentDto> storeBranchRoleAssignments = [];
    private HashSet<Guid> selectedBranchIds = [];
    private string defaultBranchIdText = string.Empty;
    private HashSet<string> selectedCreateUserRoleNames = new(StringComparer.OrdinalIgnoreCase);
    private string createUserDefaultBranchIdText = string.Empty;
    private string createUserError = string.Empty;
    private string selectedStoreRoleBranchIdText = string.Empty;
    private string selectedStoreRoleTemplateKey = string.Empty;
    private HashSet<Guid> selectedCreateUserBranchIds = [];
    private HashSet<string> selectedUnassignRoleNames = new(StringComparer.OrdinalIgnoreCase);
    private int rolePickerKey;

    private bool CanAccessPage => HasPermission(PermissionList.UsersPermissions.View) && HasPermission(PermissionList.RolesPermissions.View);
    private bool CanAssign => HasPermission(PermissionList.UsersPermissions.Create);
    private bool CanUnassign => HasPermission(PermissionList.UsersPermissions.Delete);
    private bool CanResetPassword => HasPermission(PermissionList.UsersPermissions.Edit);
    private bool CanAssignBranches => HasPermission(PermissionList.BranchPermissions.AssignUsers);
    private IEnumerable<BranchDto> StoreFrontBranches => branches
        .Where(branch => branch.Specialization == BranchSpecialization.StoreFront)
        .OrderBy(LocalizedBranchName);

    private IEnumerable<RoleDto> AssignableRoles =>
        allRoles
            .Where(role => !IsCompanyAdminRole(role.RoleName))
            .OrderBy(RoleDisplayName);

    private List<UserRolesRow> AvailableUsersForCreate =>
        userRoleRows
            .Where(row => !row.IsProtectedAdmin && GetUnassignedRoles(row).Any())
            .OrderBy(row => row.DisplayName)
            .ToList();

    private List<RoleDto> AvailableRolesForEdit =>
        editingRow is null
            ? []
            : GetUnassignedRoles(editingRow)
                .Where(role => !selectedRoles.Any(selected => string.Equals(selected.RoleName, role.RoleName, StringComparison.OrdinalIgnoreCase)))
                .ToList();

    private IEnumerable<UserRolesRow> FilteredRows =>
        userRoleRows
            .Where(row =>
                string.IsNullOrWhiteSpace(searchText) ||
                row.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                row.AssignedRoles.Any(role => RoleDisplayName(role).Contains(searchText, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(row => sortAscending ? row.DisplayName : string.Empty)
            .ThenByDescending(row => sortAscending ? string.Empty : row.DisplayName);

    private IEnumerable<UserRolesRow> ProcessedRows =>
        FilteredRows
            .Skip(pageIndex * pageSize)
            .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)pageSize));
    private string SortIcon => sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }

        if (!CanAccessPage)
        {
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isBusy = true;
        try
        {
            var userRes = await UserService.GetUsersByCompany(companyId, 0, 10000);
            if (userRes.IsSuccess)
            {
                authUsers = userRes.Data?.Data?.ToList() ?? [];
            }
            else
            {
                ShowToast(userRes.Error?.Detail ?? Text("Unable to load users", "تعذر تحميل المستخدمين"), "error");
            }

            var roleRes = await RoleService.GetRoles(companyId, 0, 10000);
            if (roleRes.IsSuccess)
            {
                allRoles = roleRes.Data?.ToList() ?? [];
            }
            else
            {
                ShowToast(roleRes.Error?.Detail ?? Text("Unable to load roles", "تعذر تحميل الصلاحيات"), "error");
            }

            await BuildUserRoleRows();
            ClampPageIndex();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task BuildUserRoleRows()
    {
        var rows = new List<UserRolesRow>();

        foreach (var user in authUsers)
        {
            var assignedRoles = new List<RoleDto>();
            var roleRes = await RoleService.GetRolesByUserName(user.UserName);
            if (roleRes.IsSuccess)
            {
                assignedRoles = roleRes.Data?.ToList() ?? [];
            }

            rows.Add(new UserRolesRow
            {
                User = user,
                AssignedRoles = assignedRoles,
                DisplayName = UserDisplayName(user),
                IsProtectedAdmin = IsProtectedAdmin(user, assignedRoles)
            });
        }

        userRoleRows = rows
            .OrderBy(row => row.DisplayName)
            .ToList();
    }

    private async Task OpenCreateUserModal()
    {
        createUserForm = new CreateUserFormModel();
        selectedCreateUserRoleNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        selectedCreateUserBranchIds = [];
        createUserDefaultBranchIdText = string.Empty;
        createUserError = string.Empty;
        isLoadingCreateUserBranches = false;
        showCreateUserModal = true;
        await InvokeAsync(StateHasChanged);

        if (CanAssignBranches)
        {
            isLoadingCreateUserBranches = branches.Count == 0;
            await InvokeAsync(StateHasChanged);

            try
            {
                await EnsureBranchesLoadedAsync();
            }
            catch
            {
                createUserError = Text("Unable to load branches. You can still create the user without branch access.", "تعذر تحميل الفروع. يمكنك إنشاء المستخدم بدون صلاحية فروع.");
                ShowToast(createUserError, "error");
            }
            finally
            {
                isLoadingCreateUserBranches = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void CloseCreateUserModal()
    {
        showCreateUserModal = false;
        createUserForm = new CreateUserFormModel();
        selectedCreateUserRoleNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        selectedCreateUserBranchIds = [];
        createUserDefaultBranchIdText = string.Empty;
        createUserError = string.Empty;
        isLoadingCreateUserBranches = false;
    }

    private async Task CreateCompanyUserAsync()
    {
        createUserError = string.Empty;
        Guid? defaultBranchId = Guid.TryParse(createUserDefaultBranchIdText, out var parsedDefaultBranchId)
            ? parsedDefaultBranchId
            : null;

        if (defaultBranchId.HasValue && !selectedCreateUserBranchIds.Contains(defaultBranchId.Value))
        {
            createUserError = Text("Default branch must be selected in branch access.", "يجب أن يكون الفرع الافتراضي ضمن الفروع المحددة.");
            return;
        }

        isBusy = true;
        try
        {
            var request = new CreateCompanyUserDto
            {
                UserName = createUserForm.UserName.Trim(),
                Email = createUserForm.Email.Trim(),
                PhoneNumber = createUserForm.PhoneNumber.Trim(),
                Password = createUserForm.TemporaryPassword,
                RoleNames = selectedCreateUserRoleNames.ToList(),
                BranchIds = CanAssignBranches ? selectedCreateUserBranchIds.ToList() : [],
                DefaultBranchId = CanAssignBranches ? defaultBranchId : null
            };

            var createResult = await UserService.CreateCompanyUserAsync(companyId, request);
            if (!createResult.IsSuccess)
            {
                createUserError = createResult.Error?.Detail ?? Text("Unable to create user.", "تعذر إنشاء المستخدم.");
                ShowToast(createUserError, "error");
                return;
            }

            var created = createResult.Data;
            ShowToast(
                Text(
                    $"User created successfully. Assigned roles: {created?.AssignedRolesCount ?? 0}, branch assignments: {created?.BranchAssignmentsCount ?? 0}.",
                    $"تم إنشاء المستخدم بنجاح. الصلاحيات المعينة: {created?.AssignedRolesCount ?? 0}، تعيينات الفروع: {created?.BranchAssignmentsCount ?? 0}."),
                "success");
            CloseCreateUserModal();
            await LoadData();
        }
        finally
        {
            isBusy = false;
        }
    }

    private void ToggleCreateUserRole(string roleName, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            selectedCreateUserRoleNames.Add(roleName);
        }
        else
        {
            selectedCreateUserRoleNames.Remove(roleName);
        }
    }

    private void ToggleCreateUserBranch(Guid branchId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            selectedCreateUserBranchIds.Add(branchId);
            if (string.IsNullOrWhiteSpace(createUserDefaultBranchIdText))
            {
                createUserDefaultBranchIdText = branchId.ToString();
            }
        }
        else
        {
            selectedCreateUserBranchIds.Remove(branchId);
            if (string.Equals(createUserDefaultBranchIdText, branchId.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                createUserDefaultBranchIdText = selectedCreateUserBranchIds.FirstOrDefault() == Guid.Empty
                    ? string.Empty
                    : selectedCreateUserBranchIds.First().ToString();
            }
        }
    }

    private void CreateNew()
    {
        isCreateMode = true;
        selectedCreateRow = null;
        rolePickerValue = null;
        selectedRoles = [];
        rolePickerKey++;
        editingRow = new UserRolesRow();
    }

    private void EditRow(UserRolesRow row)
    {
        isCreateMode = false;
        selectedCreateRow = null;
        rolePickerValue = null;
        selectedRoles = [];
        rolePickerKey++;
        editingRow = row;
    }

    private void OnCreateUserChanged(UserRolesRow row)
    {
        selectedCreateRow = row;
        editingRow = row;
        rolePickerValue = null;
        selectedRoles = [];
        rolePickerKey++;
    }

    private void OnRoleValueChanged(RoleDto? role)
    {
        if (role is null || string.IsNullOrWhiteSpace(role.RoleName))
        {
            return;
        }

        if (!selectedRoles.Any(selected => string.Equals(selected.RoleName, role.RoleName, StringComparison.OrdinalIgnoreCase)))
        {
            selectedRoles.Add(role);
        }

        rolePickerValue = null;
        rolePickerKey++;
    }

    private void RemoveSelectedRole(RoleDto role)
    {
        selectedRoles.RemoveAll(selected => string.Equals(selected.RoleName, role.RoleName, StringComparison.OrdinalIgnoreCase));
        rolePickerValue = null;
        rolePickerKey++;
    }

    private async Task SaveRoles()
    {
        var targetRow = isCreateMode ? selectedCreateRow : editingRow;
        if (targetRow is null || targetRow.User is null)
        {
            await ShowValidationModal(Text("Please select a user to continue", "يرجى اختيار مستخدم للمتابعة"));
            return;
        }

        if (!selectedRoles.Any())
        {
            await ShowValidationModal(Text("Please select at least one role to continue", "يرجى اختيار صلاحية واحدة على الأقل للمتابعة"));
            return;
        }

        isBusy = true;
        var failedCount = 0;
        try
        {
            foreach (var role in selectedRoles)
            {
                var result = await RoleService.AssignRole(new UserRoleDto
                {
                    UserName = targetRow.User.UserName,
                    RoleName = role.RoleName
                });

                if (!result.IsSuccess)
                {
                    failedCount++;
                }
            }

            if (failedCount == 0)
            {
                await RefreshCurrentSessionIfNeeded(targetRow.User);
                await LoadData();
                CancelEdit();
            }
            else
            {
                ShowToast(Text("Some roles could not be assigned. The page was refreshed with the latest assignments.", "تعذر تعيين بعض الصلاحيات. تم تحديث الصفحة بآخر التعيينات."), "error");
                await LoadData();
                CancelEdit();
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RefreshCurrentSessionIfNeeded(UserDto assignedUser)
    {
        if (IsCurrentSignedInUser(assignedUser))
        {
            var refreshed = await AuthService.RefreshTokenAsync();
            if (refreshed)
            {
                AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
                ShowToast(Text(
                    "Roles have been assigned successfully. Your current session was refreshed with the new permissions.",
                    "تم تعيين الصلاحيات بنجاح. تم تحديث جلستك الحالية بالصلاحيات الجديدة."),
                    "success");
                return;
            }
        }

        ShowToast(Text(
            "Roles have been assigned successfully. The user must sign out and sign in again to receive the new permissions.",
            "تم تعيين الصلاحيات بنجاح. يجب على المستخدم تسجيل الخروج ثم تسجيل الدخول مرة أخرى لاستلام الصلاحيات الجديدة."),
            "success");
    }

    private bool IsCurrentSignedInUser(UserDto user)
    {
        var currentUserName = AuthState?.User.FindFirst(ClaimTypes.Name)?.Value;
        return !string.IsNullOrWhiteSpace(currentUserName)
            && string.Equals(NormalizeUserNameKey(currentUserName), NormalizeUserNameKey(user.UserName), StringComparison.OrdinalIgnoreCase);
    }

    private void OpenUnassignRoles(UserRolesRow row)
    {
        unassignRow = row;
        selectedUnassignRoleNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private void CloseUnassignRoles()
    {
        unassignRow = null;
        selectedUnassignRoleNames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    }

    private void ToggleUnassignRole(string roleName, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            selectedUnassignRoleNames.Add(roleName);
        }
        else
        {
            selectedUnassignRoleNames.Remove(roleName);
        }
    }

    private async Task UnassignSelectedRolesAsync()
    {
        if (unassignRow is null || selectedUnassignRoleNames.Count == 0)
        {
            return;
        }

        isBusy = true;
        var failedCount = 0;
        try
        {
            foreach (var roleName in selectedUnassignRoleNames.ToList())
            {
                var result = await RoleService.UnassignRole(new UserRoleDto
                {
                    UserName = unassignRow.User.UserName,
                    RoleName = roleName
                });

                if (!result.IsSuccess)
                {
                    failedCount++;
                }
            }

            if (failedCount == 0)
            {
                ShowToast(Text("Roles unassigned successfully", "تم إلغاء تعيين الصلاحيات بنجاح"), "success");
            }
            else
            {
                ShowToast(Text("Some roles could not be unassigned. The page was refreshed with the latest assignments.", "تعذر إلغاء تعيين بعض الصلاحيات. تم تحديث الصفحة بآخر التعيينات."), "error");
            }

            CloseUnassignRoles();
            await LoadData();
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void OpenResetPassword(UserRolesRow row)
    {
        resetPasswordRow = row;
        passwordReset = new PasswordResetModel();
    }

    private void CloseResetPassword()
    {
        resetPasswordRow = null;
        passwordReset = new PasswordResetModel();
    }

    private async Task OpenBranchAssignments(UserRolesRow row)
    {
        branchAssignmentRow = row;
        selectedBranchIds = [];
        defaultBranchIdText = string.Empty;
        isBusy = true;

        try
        {
            if (branches.Count == 0)
            {
                var branchResult = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
                if (branchResult.IsSuccess)
                {
                    branches = branchResult.Data?.Data?.ToList() ?? [];
                }
                else
                {
                    ShowToast(branchResult.Error?.Detail ?? Text("Unable to load branches.", "تعذر تحميل الفروع."), "error");
                }
            }

            var assignmentResult = await BranchService.GetUserBranchAssignmentsAsync(row.User.Id, companyId);
            if (assignmentResult.IsSuccess)
            {
                selectedBranchIds = assignmentResult.Data?.BranchIds?.ToHashSet() ?? [];
                defaultBranchIdText = assignmentResult.Data?.DefaultBranchId?.ToString() ?? string.Empty;
            }
            else
            {
                ShowToast(assignmentResult.Error?.Detail ?? Text("Unable to load branch assignments.", "تعذر تحميل تعيينات الفروع."), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task OpenStoreBranchRoles(UserRolesRow row)
    {
        storeBranchRoleRow = row;
        selectedStoreRoleBranchIdText = string.Empty;
        selectedStoreRoleTemplateKey = string.Empty;
        isBusy = true;

        try
        {
            await EnsureBranchesLoadedAsync();
            if (storeBranchRoleProfiles.Count == 0)
            {
                var profilesResult = await BranchService.GetBranchRoleProfilesAsync();
                if (profilesResult.IsSuccess)
                    storeBranchRoleProfiles = profilesResult.Data ?? [];
                else
                    ShowToast(profilesResult.Error?.Detail ?? Text("Unable to load StoreFront role profiles.", "تعذر تحميل ملفات صلاحيات واجهة المتجر."), "error");
            }

            await LoadStoreBranchRolesForUserAsync(row.User.Id);
        }
        finally
        {
            isBusy = false;
        }
    }

    private void CloseStoreBranchRoles()
    {
        storeBranchRoleRow = null;
        selectedStoreRoleBranchIdText = string.Empty;
        selectedStoreRoleTemplateKey = string.Empty;
        storeBranchRoleAssignments = [];
    }

    private async Task AssignStoreBranchRoleAsync()
    {
        if (storeBranchRoleRow is null
            || !Guid.TryParse(selectedStoreRoleBranchIdText, out var branchId)
            || string.IsNullOrWhiteSpace(selectedStoreRoleTemplateKey))
        {
            return;
        }

        isBusy = true;
        try
        {
            var result = await BranchService.AssignUserBranchRoleAsync(new AssignBranchRoleDto
            {
                UserId = storeBranchRoleRow.User.Id,
                CompanyId = companyId,
                BranchId = branchId,
                TemplateKey = selectedStoreRoleTemplateKey
            });

            if (result.IsSuccess)
            {
                ShowToast(Text("Store branch role assigned.", "تم تعيين صلاحية فرع المتجر."), "success");
                selectedStoreRoleTemplateKey = string.Empty;
                await LoadStoreBranchRolesForUserAsync(storeBranchRoleRow.User.Id);
            }
            else
            {
                ShowToast(result.Error?.Detail ?? Text("Unable to assign StoreFront role.", "تعذر تعيين صلاحية واجهة المتجر."), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RemoveStoreBranchRoleAsync(Guid assignmentId)
    {
        if (storeBranchRoleRow is null)
            return;

        isBusy = true;
        try
        {
            var result = await BranchService.RemoveUserBranchRoleAsync(assignmentId);
            if (result.IsSuccess)
            {
                ShowToast(Text("Store branch role removed.", "تمت إزالة صلاحية فرع المتجر."), "success");
                await LoadStoreBranchRolesForUserAsync(storeBranchRoleRow.User.Id);
            }
            else
            {
                ShowToast(result.Error?.Detail ?? Text("Unable to remove StoreFront role.", "تعذر إزالة صلاحية واجهة المتجر."), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadStoreBranchRolesForUserAsync(Guid userId)
    {
        var result = await BranchService.GetUserBranchRoleAssignmentsAsync(userId, companyId);
        if (result.IsSuccess)
        {
            var storeBranchIds = StoreFrontBranches.Select(branch => branch.Id).ToHashSet();
            storeBranchRoleAssignments = (result.Data ?? [])
                .Where(assignment => storeBranchIds.Contains(assignment.BranchId))
                .OrderBy(assignment => LocalizedBranchNameById(assignment.BranchId))
                .ThenBy(assignment => assignment.RoleName)
                .ToList();
        }
        else
        {
            ShowToast(result.Error?.Detail ?? Text("Unable to load StoreFront role assignments.", "تعذر تحميل تعيينات صلاحيات واجهة المتجر."), "error");
            storeBranchRoleAssignments = [];
        }
    }

    private async Task EnsureBranchesLoadedAsync()
    {
        if (branches.Count > 0)
            return;

        var branchResult = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (branchResult.IsSuccess)
            branches = branchResult.Data?.Data?.ToList() ?? [];
        else
            ShowToast(branchResult.Error?.Detail ?? Text("Unable to load branches.", "تعذر تحميل الفروع."), "error");
    }

    private void CloseBranchAssignments()
    {
        branchAssignmentRow = null;
        selectedBranchIds = [];
        defaultBranchIdText = string.Empty;
    }

    private void ToggleBranchAssignment(Guid branchId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            selectedBranchIds.Add(branchId);
            if (string.IsNullOrWhiteSpace(defaultBranchIdText))
            {
                defaultBranchIdText = branchId.ToString();
            }
        }
        else
        {
            selectedBranchIds.Remove(branchId);
            if (string.Equals(defaultBranchIdText, branchId.ToString(), StringComparison.OrdinalIgnoreCase))
            {
                defaultBranchIdText = selectedBranchIds.FirstOrDefault() == Guid.Empty
                    ? string.Empty
                    : selectedBranchIds.First().ToString();
            }
        }
    }

    private async Task SaveBranchAssignments()
    {
        if (branchAssignmentRow is null)
        {
            return;
        }

        Guid? defaultBranchId = Guid.TryParse(defaultBranchIdText, out var parsedDefaultBranchId)
            ? parsedDefaultBranchId
            : null;

        if (defaultBranchId.HasValue && !selectedBranchIds.Contains(defaultBranchId.Value))
        {
            await ShowValidationModal(Text("Default branch must be selected in branch access.", "يجب أن يكون الفرع الافتراضي ضمن الفروع المحددة."));
            return;
        }

        isBusy = true;
        try
        {
            var result = await BranchService.AssignUserBranchesAsync(new AssignUserBranchesDto
            {
                UserId = branchAssignmentRow.User.Id,
                CompanyId = companyId,
                BranchIds = selectedBranchIds.ToList(),
                DefaultBranchId = defaultBranchId
            });

            if (result.IsSuccess)
            {
                ShowToast(Text("Branch access saved successfully.", "تم حفظ صلاحية الفروع بنجاح."), "success");
                CloseBranchAssignments();
            }
            else
            {
                ShowToast(result.Error?.Detail ?? Text("Unable to save branch access.", "تعذر حفظ صلاحية الفروع."), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task ResetPasswordAsync()
    {
        if (resetPasswordRow is null)
        {
            return;
        }

        isBusy = true;
        try
        {
            var result = await UserService.ResetPasswordAsync(resetPasswordRow.User.UserName, passwordReset.TemporaryPassword);
            if (result.IsSuccess)
            {
                ShowToast(Text("Password reset successfully.", "تمت إعادة تعيين كلمة المرور بنجاح."), "success");
                CloseResetPassword();
            }
            else
            {
                ShowToast(result.Error?.Detail ?? Text("Unable to reset password.", "تعذر إعادة تعيين كلمة المرور."), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

