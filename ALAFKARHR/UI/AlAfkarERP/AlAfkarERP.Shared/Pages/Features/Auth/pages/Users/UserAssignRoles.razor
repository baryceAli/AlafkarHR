@layout AdminLayout
@page "/Auth/User/AssignRole"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions
@using System.Globalization
@using System.Text

@inject IRoleService RoleService
@inject IUserService UserService
@inject IEmployeeService EmployeeService
@inject ToastService ToastService
@inject ModalService ModalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (AuthState is not null && !CanAccessPage)
{
    <div class="alert alert-warning">
        @Text("You don't have permissions to view this page", "You don't have permissions to view this page")
    </div>
    return;
}

<div class="erp-page">
    <PageHeader Title="@Text("Assign role to employees", "Assign role to employees")"
                Subtitle="@Text("Manage employee role assignments without exposing user codes.", "Manage employee role assignments without exposing user codes.")"
                Icon="bi-person-check">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanCreate || isBusy)">
                <i class="bi bi-plus-lg"></i> @Text("Create New", "Create New")
            </button>
        </Actions>
    </PageHeader>

    @if (editingRow is not null)
    {
        <AppCard CssClass="mb-3">
            <EditForm Model="formRole" OnValidSubmit="SaveRole">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row g-3 align-items-end">
                    @if (isCreateMode)
                    {
                        <div class="col-lg-5">
                            <label class="form-label">@Text("Employee", "Employee")</label>
                            <AutoCompleteComponent TItem="EmployeeUserRolesRow"
                                                   Items="AvailableEmployeesForCreate"
                                                   ItemText="(row => row.DisplayName)"
                                                   Value="selectedCreateRow"
                                                   PlaceHolder="@Text("Search employees ...", "Search employees ...")"
                                                   ValueChanged="OnCreateEmployeeChanged" />
                        </div>
                    }
                    else
                    {
                        <div class="col-lg-5">
                            <label class="form-label">@Text("Employee", "Employee")</label>
                            <div class="form-control">@editingRow.DisplayName</div>
                        </div>
                    }

                    <div class="col-lg-5">
                        <label class="form-label">@Text("Role", "Role")</label>
                        <AutoCompleteComponent TItem="RoleDto"
                                               Items="AvailableRolesForEdit"
                                               ItemText="(role => RoleDisplayName(role))"
                                               Value="selectedRole"
                                               PlaceHolder="@Text("Search roles ...", "Search roles ...")"
                                               ValueChanged="OnRoleValueChanged" />
                        <ValidationMessage For="@(() => formRole.RoleName)" />
                    </div>

                    <div class="col-lg-2 d-flex gap-2">
                        <button type="submit"
                                class="btn btn-success btn-sm"
                                disabled="@(!CanCreate || isBusy)">
                            <i class="bi bi-check-lg"></i> @Text("Save", "Save")
                        </button>
                        <button type="button"
                                class="btn btn-secondary btn-sm"
                                @onclick="CancelEdit"
                                disabled="@isBusy">
                            @Text("Cancel", "Cancel")
                        </button>
                    </div>
                </div>

                @if (isCreateMode && AvailableEmployeesForCreate.Count == 0)
                {
                    <div class="text-muted small mt-3">
                        @Text("All identifiable employees already have roles assigned.", "All identifiable employees already have roles assigned.")
                    </div>
                }
                else if (!AvailableRolesForEdit.Any())
                {
                    <div class="text-muted small mt-3">
                        @Text("All available roles are already assigned to this employee.", "All available roles are already assigned to this employee.")
                    </div>
                }
            </EditForm>
        </AppCard>
    }

    <AppCard>
        <FilterBar CssClass="mb-3">
            <ChildContent>
                <input class="form-control"
                       placeholder="@Text("Search", "Search")"
                       @bind="SearchText"
                       @bind:event="oninput" />

                <select class="form-select erp-page-size-select" @onchange="OnPageSizeChanged">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                </select>
            </ChildContent>

            <Actions>
                <TableExportActions />
            </Actions>
        </FilterBar>

        <div class="erp-table-wrap">
            <table class="table erp-table align-middle">
                <thead>
                    <tr>
                        <th @onclick="ToggleSort" class="sortable">
                            <i class="@SortIcon"></i>
                            @Text("Employee", "Employee")
                        </th>
                        <th>@Text("Roles", "Roles")</th>
                        <th class="text-end">@Text("Actions", "Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isBusy && userRoleRows.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                @Text("Loading role assignments ...", "Loading role assignments ...")
                            </td>
                        </tr>
                    }
                    else if (!ProcessedRows.Any())
                    {
                        <tr>
                            <td colspan="3" class="text-center text-muted py-4">
                                @Text("No employee role assignments found.", "No employee role assignments found.")
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var row in ProcessedRows)
                        {
                            <tr @key="row.User.Id">
                                <td>
                                    <div class="fw-semibold">@row.DisplayName</div>
                                    @if (row.IsProtectedAdmin)
                                    {
                                        <span class="badge text-bg-secondary mt-1">
                                            <i class="bi bi-lock"></i> @Text("Protected admin", "Protected admin")
                                        </span>
                                    }
                                </td>
                                <td>
                                    @{
                                        var visibleRoles = DisplayRoles(row).ToList();
                                    }
                                    @if (visibleRoles.Count == 0)
                                    {
                                        <span class="text-muted small">
                                            @(row.IsProtectedAdmin ? Text("Protected admin", "Protected admin") : Text("No roles assigned", "No roles assigned"))
                                        </span>
                                    }
                                    else
                                    {
                                        @foreach (var role in visibleRoles)
                                        {
                                            <span class="badge text-bg-light me-1">@RoleDisplayName(role)</span>
                                        }
                                    }
                                </td>
                                <td class="text-end">
                                    @if (!row.IsProtectedAdmin)
                                    {
                                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                                @onclick="() => EditRow(row)"
                                                disabled="@(!CanCreate || isBusy || !GetUnassignedRoles(row).Any())"
                                                title="@Text("Edit", "Edit")">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        @foreach (var role in row.AssignedRoles)
                                        {
                                            <button class="btn btn-outline-danger btn-sm erp-row-action"
                                                    @onclick="() => RemoveRole(row, role)"
                                                    disabled="@(!CanDelete || isBusy)"
                                                    title="@Text("Unassign", "Unassign")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted small">@Text("Locked", "Locked")</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
            <button class="btn btn-sm btn-secondary"
                    @onclick="PrevPage"
                    disabled="@(pageIndex == 0 || isBusy)">
                @Text("Previous", "Previous")
            </button>

            <span class="text-muted small">
                @Text("Page", "Page") @(pageIndex + 1) @Text("of", "of") @TotalPages
            </span>

            <button class="btn btn-sm btn-secondary"
                    @onclick="NextPage"
                    disabled="@(pageIndex >= TotalPages - 1 || isBusy)">
                @Text("Next", "Next")
            </button>
        </div>
    </AppCard>
</div>

@code {
    private AuthenticationState? AuthState;
    private Guid companyId;
    private bool isBusy;
    private bool isCreateMode;
    private bool sortAscending = true;
    private int pageSize = 5;
    private int pageIndex;
    private string searchText = string.Empty;

    private string SearchText
    {
        get => searchText;
        set
        {
            if (searchText == value)
            {
                return;
            }

            searchText = value;
            pageIndex = 0;
        }
    }

    private List<UserDto> authUsers = [];
    private List<EmployeeDto> employees = [];
    private List<RoleDto> allRoles = [];
    private List<EmployeeUserRolesRow> userRoleRows = [];

    private EmployeeUserRolesRow? editingRow;
    private EmployeeUserRolesRow? selectedCreateRow;
    private RoleDto? selectedRole;
    private RoleDto formRole = new();

    private bool CanAccessPage => CanCreate;
    private bool CanCreate => HasPermission(PermissionList.RolesPermissions.Create);
    private bool CanDelete => HasPermission(PermissionList.RolesPermissions.Delete);

    private List<EmployeeUserRolesRow> AvailableEmployeesForCreate =>
        userRoleRows
            .Where(row => !row.IsProtectedAdmin && row.AssignedRoles.Count == 0)
            .OrderBy(row => row.DisplayName)
            .ToList();

    private List<RoleDto> AvailableRolesForEdit =>
        editingRow is null ? [] : GetUnassignedRoles(editingRow).ToList();

    private IEnumerable<EmployeeUserRolesRow> FilteredRows =>
        userRoleRows
            .Where(row =>
                string.IsNullOrWhiteSpace(searchText) ||
                row.DisplayName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
                row.AssignedRoles.Any(role => RoleDisplayName(role).Contains(searchText, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(row => sortAscending ? row.DisplayName : string.Empty)
            .ThenByDescending(row => sortAscending ? string.Empty : row.DisplayName);

    private IEnumerable<EmployeeUserRolesRow> ProcessedRows =>
        FilteredRows
            .Skip(pageIndex * pageSize)
            .Take(pageSize);

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredRows.Count() / (double)pageSize));
    private string SortIcon => sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        if (!CanAccessPage)
        {
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        isBusy = true;
        try
        {
            var userRes = await UserService.GetUsersByCompany(companyId, 0, 10000);
            if (userRes.IsSuccess)
            {
                authUsers = userRes.Data?.Data?.ToList() ?? [];
            }
            else
            {
                ShowToast(userRes.Error?.Detail ?? Text("Unable to load users", "Unable to load users"), "error");
            }

            var employeeRes = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 10000);
            if (employeeRes.IsSuccess)
            {
                employees = employeeRes.Data?.Data?.ToList() ?? [];
            }
            else
            {
                ShowToast(employeeRes.Error?.Detail ?? Text("Unable to load employees", "Unable to load employees"), "error");
            }

            var roleRes = await RoleService.GetRoles(companyId, 0, 10000);
            if (roleRes.IsSuccess)
            {
                allRoles = roleRes.Data?.ToList() ?? [];
            }
            else
            {
                ShowToast(roleRes.Error?.Detail ?? Text("Unable to load roles", "Unable to load roles"), "error");
            }

            await BuildUserRoleRows();
            ClampPageIndex();
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task BuildUserRoleRows()
    {
        var employeeByUserName = employees
            .Select(employee => new
            {
                Key = NormalizeUserNameKey(employee.Code),
                Employee = employee
            })
            .Where(item => !string.IsNullOrWhiteSpace(item.Key))
            .GroupBy(item => item.Key, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First().Employee, StringComparer.OrdinalIgnoreCase);

        var rows = new List<EmployeeUserRolesRow>();

        foreach (var user in authUsers)
        {
            var userKey = NormalizeUserNameKey(user.UserName);
            if (string.IsNullOrWhiteSpace(userKey) || !employeeByUserName.TryGetValue(userKey, out var employee))
            {
                continue;
            }

            var assignedRoles = new List<RoleDto>();
            var roleRes = await RoleService.GetRolesByUserName(user.UserName);
            if (roleRes.IsSuccess)
            {
                assignedRoles = roleRes.Data?.ToList() ?? [];
            }

            rows.Add(new EmployeeUserRolesRow
            {
                User = user,
                Employee = employee,
                AssignedRoles = assignedRoles,
                DisplayName = EmployeeName(employee),
                IsProtectedAdmin = IsProtectedAdmin(user, assignedRoles)
            });
        }

        userRoleRows = rows
            .OrderBy(row => row.DisplayName)
            .ToList();
    }

    private void CreateNew()
    {
        isCreateMode = true;
        selectedCreateRow = null;
        selectedRole = null;
        formRole = NewFormRole();
        editingRow = new EmployeeUserRolesRow();
    }

    private void EditRow(EmployeeUserRolesRow row)
    {
        isCreateMode = false;
        selectedCreateRow = null;
        selectedRole = null;
        formRole = NewFormRole();
        editingRow = row;
    }

    private void OnCreateEmployeeChanged(EmployeeUserRolesRow row)
    {
        selectedCreateRow = row;
        editingRow = row;
        selectedRole = null;
        formRole = NewFormRole();
    }

    private void OnRoleValueChanged(RoleDto role)
    {
        selectedRole = role;
        formRole.RoleName = role?.RoleName ?? string.Empty;
        formRole.DisplayName = role?.DisplayName ?? string.Empty;
        formRole.CompanyId = companyId;
        formRole.Permissions = role?.Permissions ?? [];
    }

    private async Task SaveRole()
    {
        var targetRow = isCreateMode ? selectedCreateRow : editingRow;
        if (targetRow is null || targetRow.User is null)
        {
            await ShowValidationModal(Text("Please select an employee to continue", "Please select an employee to continue"));
            return;
        }

        if (selectedRole is null || string.IsNullOrWhiteSpace(selectedRole.RoleName))
        {
            await ShowValidationModal(Text("Please select role to continue", "Please select role to continue"));
            return;
        }

        isBusy = true;
        try
        {
            var result = await RoleService.AssignRole(new UserRoleDto
            {
                UserName = targetRow.User.UserName,
                RoleName = selectedRole.RoleName
            });

            if (result.IsSuccess)
            {
                ShowToast(Text("Role has been assigned successfully", "Role has been assigned successfully"), "success");
                await LoadData();
                CancelEdit();
            }
            else
            {
                ShowToast(result.Error?.Detail ?? Text("Error has occured, please try again later", "Error has occured, please try again later"), "error");
            }
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task RemoveRole(EmployeeUserRolesRow row, RoleDto role)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Confirm unassign role", "Confirm unassign role"),
            Message = Text($"Are you sure you want to unassign this role: {RoleDisplayName(role)}?", $"Are you sure you want to unassign this role: {RoleDisplayName(role)}?"),
            ShowCancel = true,
            OkText = Text("Yes", "Yes"),
            CancelText = Text("No", "No"),
            OnOk = async () =>
            {
                isBusy = true;
                try
                {
                    var result = await RoleService.UnassignRole(new UserRoleDto
                    {
                        UserName = row.User.UserName,
                        RoleName = role.RoleName
                    });

                    if (result.IsSuccess)
                    {
                        ShowToast(Text("Role unassigned successfully", "Role unassigned successfully"), "success");
                        await LoadData();
                        await InvokeAsync(StateHasChanged);
                    }
                    else
                    {
                        ShowToast(result.Error?.Detail ?? Text("Fail to unassign the role", "Fail to unassign the role"), "error");
                    }
                }
                finally
                {
                    isBusy = false;
                }
            }
        });
    }

    private void CancelEdit()
    {
        isCreateMode = false;
        editingRow = null;
        selectedCreateRow = null;
        selectedRole = null;
        formRole = NewFormRole();
    }

    private void ToggleSort()
    {
        sortAscending = !sortAscending;
    }

    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "5");
        pageIndex = 0;
        ClampPageIndex();
    }

    private void NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
        }
    }

    private void PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
        }
    }

    private void ClampPageIndex()
    {
        if (pageIndex >= TotalPages)
        {
            pageIndex = TotalPages - 1;
        }

        if (pageIndex < 0)
        {
            pageIndex = 0;
        }
    }

    private IEnumerable<RoleDto> GetUnassignedRoles(EmployeeUserRolesRow row)
    {
        if (row.IsProtectedAdmin)
        {
            return [];
        }

        var assigned = row.AssignedRoles
            .Select(role => role.RoleName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return allRoles
            .Where(role => !IsCompanyAdminRole(role.RoleName))
            .Where(role => !assigned.Contains(role.RoleName))
            .OrderBy(RoleDisplayName);
    }

    private IEnumerable<RoleDto> DisplayRoles(EmployeeUserRolesRow row)
        => row.AssignedRoles
            .Where(role => !IsCompanyAdminRole(role.RoleName));

    private RoleDto NewFormRole()
        => new()
        {
            RoleName = string.Empty,
            DisplayName = string.Empty,
            CompanyId = companyId,
            Permissions = []
        };

    private async Task ShowValidationModal(string message)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Assign Role", "Assign Role"),
            IsError = true,
            Message = message,
            OnOk = async () => { await Task.CompletedTask; }
        });
    }

    private string EmployeeName(EmployeeDto employee)
    {
        var localizedName = Text(employee.FullNameEng, employee.FullName).Trim();
        return string.IsNullOrWhiteSpace(localizedName) ? Text("Employee", "Employee") : localizedName;
    }

    private string NormalizeUserNameKey(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Trim().Normalize(NormalizationForm.FormD);
        var builder = new StringBuilder(normalized.Length);

        foreach (var character in normalized)
        {
            var category = CharUnicodeInfo.GetUnicodeCategory(character);
            if (category is UnicodeCategory.Control
                or UnicodeCategory.Format
                or UnicodeCategory.NonSpacingMark
                or UnicodeCategory.SpacingCombiningMark
                or UnicodeCategory.EnclosingMark)
            {
                continue;
            }

            builder.Append(character);
        }

        return builder.ToString().Normalize(NormalizationForm.FormC);
    }

    private bool IsProtectedAdmin(UserDto user, List<RoleDto> assignedRoles)
    {
        var normalizedUserName = NormalizeUserNameKey(user.UserName);
        if (string.Equals(normalizedUserName, "admin", StringComparison.OrdinalIgnoreCase))
        {
            return true;
        }

        var companyAdminRoleName = $"SystemAdmin-{companyId:N}";
        return assignedRoles.Any(role => string.Equals(role.RoleName, companyAdminRoleName, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsCompanyAdminRole(string? roleName)
    {
        var companyAdminRoleName = $"SystemAdmin-{companyId:N}";
        return string.Equals(roleName, companyAdminRoleName, StringComparison.OrdinalIgnoreCase);
    }

    private static string RoleDisplayName(RoleDto role)
        => string.IsNullOrWhiteSpace(role.DisplayName) ? role.RoleName : role.DisplayName;

    private bool HasPermission(string permission)
        => AuthState?.User.Claims.Any(c => c.Value == permission) == true;

    private string Text(string en, string ar)
        => SharedDataService.SelectViewLang(en, ar);

    private void ShowToast(string message, string type)
        => ToastService.Show(new ToastMessage { Message = message, Type = type });

    private async Task HandleChangeAsync()
    {
        foreach (var row in userRoleRows)
        {
            row.DisplayName = EmployeeName(row.Employee);
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

    private class EmployeeUserRolesRow
    {
        public UserDto User { get; set; } = new();
        public EmployeeDto Employee { get; set; } = new();
        public List<RoleDto> AssignedRoles { get; set; } = [];
        public string DisplayName { get; set; } = string.Empty;
        public bool IsProtectedAdmin { get; set; }
    }
}
