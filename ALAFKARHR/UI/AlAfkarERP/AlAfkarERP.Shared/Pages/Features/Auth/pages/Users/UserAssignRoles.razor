    private void OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "5");
        pageIndex = 0;
        ClampPageIndex();
    }

    private void NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
        }
    }

    private void PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
        }
    }

    private void ClampPageIndex()
    {
        if (pageIndex >= TotalPages)
        {
            pageIndex = TotalPages - 1;
        }

        if (pageIndex < 0)
        {
            pageIndex = 0;
        }
    }

    private IEnumerable<RoleDto> GetUnassignedRoles(UserRolesRow row)
    {
        if (row.IsProtectedAdmin)
        {
            return [];
        }

        var assigned = row.AssignedRoles
            .Select(role => role.RoleName)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return allRoles
            .Where(role => !IsCompanyAdminRole(role.RoleName))
            .Where(role => !assigned.Contains(role.RoleName))
            .OrderBy(RoleDisplayName);
    }

    private IEnumerable<RoleDto> DisplayRoles(UserRolesRow row)
        => row.AssignedRoles
            .Where(role => !IsCompanyAdminRole(role.RoleName));

    private string UnassignRoleTitle(UserRolesRow row)
    {
        if (!CanUnassign)
        {
            return Text("Requires Authentication.Users.Delete permission", "يتطلب صلاحية Authentication.Users.Delete");
        }

        if (!DisplayRoles(row).Any())
        {
            return Text("No assigned roles to revoke", "لا توجد صلاحيات معينة لإلغائها");
        }

        return Text("Unassign roles", "إلغاء تعيين الصلاحيات");
    }

