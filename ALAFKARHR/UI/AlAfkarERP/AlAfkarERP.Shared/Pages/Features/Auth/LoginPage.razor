@* @layout NewLayout *@

@layout AuthNewLayout
@page "/login"

@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Dtos.Auth
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.IdentityModel.JsonWebTokens
@using SharedWithUI.Auth.Dtos
@using System.Security.Claims
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthService AuthService

@inject ModalService ModalService
@inject LoadingService LoadingService

@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="login-page" dir="@SharedDataService.PageDirection" lang="@CurrentLangCode">
    <header class="login-topbar">
        <div class="login-logo" aria-label="ALAFKARERP">ALAFKARERP</div>

        <button type="button" class="language-switch" @onclick="ChangeLanguage" aria-label="@Text("Change language", "تغيير اللغة")">
            <i class="bi bi-globe2" aria-hidden="true"></i>
            <span>Language</span>
        </button>
    </header>

    <main class="login-main">
        <div class="login-bg-orb login-bg-orb-primary" aria-hidden="true"></div>
        <div class="login-bg-orb login-bg-orb-secondary" aria-hidden="true"></div>

        <div class="login-shell">
            <div class="login-panel">
                <div class="login-panel-inner">
                    <div class="login-panel-header">
                        <h1>@Text("Welcome back", "مرحباً بك مجدداً")</h1>
                        <p>@Text("Sign in to continue to your human resources workspace and manage your team efficiently.", "سجل الدخول للمتابعة إلى مساحة الموارد البشرية لإدارة فريقك بكفاءة.")</p>
                    </div>

                    <EditForm Model="@login" OnValidSubmit="HandleLogin" class="login-form">
                        <DataAnnotationsValidator />

                        <div class="form-field">
                            <label for="userName">@Text("Username or email", "اسم المستخدم أو البريد الإلكتروني")</label>
                            <div class="input-shell">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <InputText id="userName" class="login-input" @bind-Value="login.Email" placeholder="john.doe@example.com" autocomplete="username" />
                            </div>
                            <ValidationMessage For="@(() => login.Email)" />
                        </div>

                        <div class="form-field">
                            <div class="label-row">
                                <label for="password">@Text("Password", "كلمة المرور")</label>
                                <a href="/User/ForgetPassword">@Text("Forgot password?", "نسيت كلمة المرور؟")</a>
                            </div>
                            <div class="input-shell password-shell">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <InputText id="password" type="@(showPassword ? "text" : "password")" class="login-input" @bind-Value="login.Password" placeholder="••••••••" autocomplete="current-password" />
                                <button type="button" class="password-toggle" @onclick="TogglePassword" aria-label="@Text("Toggle password visibility", "إظهار أو إخفاء كلمة المرور")">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => login.Password)" />
                        </div>

                        <label class="remember-row">
                            <InputCheckbox @bind-Value="rememberDevice" />
                            <span>@Text("Remember me on this device", "تذكرني على هذا الجهاز")</span>
                        </label>

                        <button type="submit" class="login-button" disabled="@isSubmitting" aria-busy="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>@Text("Signing in...", "جاري تسجيل الدخول...")</span>
                            }
                            else
                            {
                                <span>@Text("Login", "تسجيل الدخول")</span>
                                <i class="bi bi-arrow-left-short" aria-hidden="true"></i>
                            }
                        </button>

                        <p class="register-link">
                            <span>@Text("Don’t have an account?", "ليس لديك حساب؟")</span>
                            <a href="/Register">@Text("Create a new account", "إنشاء حساب جديد")</a>
                        </p>
                    </EditForm>
                </div>
            </div>

            <aside class="login-hero" aria-label="@Text("Human resources overview", "نبذة عن نظام إدارة الموارد البشرية")">
                <div class="hero-accent-circle" aria-hidden="true"></div>
                <div class="hero-accent-band" aria-hidden="true"></div>

                <div class="hero-content">
                    <h2>@Text("Human Resources Management", "إدارة الموارد البشرية")</h2>
                    <p>
                        @Text(
                            "A complete system for workforce management, payroll, analytical reports, and high-precision professional procedures.",
                            "نظام متكامل لإدارة القوى العاملة، كشوف المرتبات، والتقارير التحليلية بدقة واحترافية عالية.")
                    </p>
                </div>

                <div class="hero-features">
                    <div class="hero-feature">
                        <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                        <span>@Text("Enterprise-grade data security", "أمان عالي المستوى للبيانات")</span>
                    </div>
                    <div class="hero-feature">
                        <i class="bi bi-speedometer2" aria-hidden="true"></i>
                        <span>@Text("Fast performance and instant analytics", "أداء سريع وتحليلات فورية")</span>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <footer class="login-footer">
        <p>© 2024 ALAFKARERP. All rights reserved.</p>
        <nav aria-label="@Text("Footer links", "روابط التذييل")">
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Support</a>
        </nav>
    </footer>
</section>



@* <button class="btn btn-primary" @onclick="Login">Login</button> *@
@code {

    private LoginDto login = new LoginDto();
    private bool isSubmitting;
    private bool rememberDevice;
    private bool showPassword;
    private string CurrentLangCode => SharedDataService.Language == "Ar" ? "ar" : "en";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        // login.Email = "baryce@gmail.com";
        // login.Password = "Admin@123";
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task ChangeLanguage()
    {
        await SharedDataService.UpdateLanguageAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
    private async Task HandleLogin()
    {
        try
        {
            isSubmitting = true;
            LoadingService.Show();

            Console.WriteLine("Submit clicked");
            Console.WriteLine($"Email/UserName: {login.Email}");
            Console.WriteLine($"Password: {login.Password}");

            var result = await AuthService.LoginAsync(login.Email, login.Password);

            if (result.IsSuccess)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    if (authState.User.Claims.Any(c =>
                        c.Type == JwtRegisteredClaimNames.Typ &&
                        c.Value == UserType.SystemUser.ToString()))
                    {
                        NavigationManager.NavigateTo("/Dashboard", true);
                        return;
                    }

                    NavigationManager.NavigateTo("/", true);
                    return;
                }
            }

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login", "تسجيل دخول"),
                Message = Text("Credentials are incorrect.", "بيانات الدخول غير صحيحة."),
                Details = $"{result.Error?.ToString()}, {result.Error?.Detail}",
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("LOGIN ERROR:");
            Console.WriteLine(ex.ToString());

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login error", "خطأ تسجيل الدخول"),
                Message = ex.Message,
                Details = ex.ToString(),
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        finally
        {
            isSubmitting = false;
            LoadingService.Hide();
        }
    }

}
