@* @layout NewLayout *@

@layout AuthNewLayout
@page "/login"

@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Dtos.Auth
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.IdentityModel.JsonWebTokens
@using SharedWithUI.Auth.Dtos
@using System.Security.Claims
@implements IDisposable

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthService AuthService
@inject ITaskManagementService TaskManagementService

@inject ModalService ModalService
@inject LoadingService LoadingService

@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="login-page" dir="@SharedDataService.PageDirection" lang="@CurrentLangCode">
    <header class="login-topbar">
        <div class="login-brand" aria-label="ALAFKARERP">
            <span class="login-brand-mark" aria-hidden="true">A</span>
            <span>ALAFKARERP</span>
        </div>

        <button type="button" class="language-switch" @onclick="ChangeLanguage" aria-label="@Text("Change language", "تغيير اللغة")">
            <i class="bi bi-globe2" aria-hidden="true"></i>
            <span>@Text("العربية", "English")</span>
        </button>
    </header>

    <main class="login-main">
        <div class="login-shell">
            <div class="login-panel">
                <div class="login-panel-inner">
                    <div class="login-kicker">@Text("Secure ERP access", "دخول آمن للنظام")</div>

                    <div class="login-panel-header">
                        <h1>@Text("Welcome back", "مرحباً بك مجدداً")</h1>
                        <p>@Text("Sign in to manage business operations, people, inventory, customers, sales, tasks, and reporting from one workspace.", "سجل الدخول لإدارة عمليات الأعمال والأفراد والمخزون والعملاء والمبيعات والمهام والتقارير من مساحة عمل واحدة.")</p>
                    </div>

                    <EditForm Model="@login" OnValidSubmit="HandleLogin" class="login-form">
                        <DataAnnotationsValidator />

                        <div class="form-field">
                            <label for="userName">@Text("Username or email", "اسم المستخدم أو البريد الإلكتروني")</label>
                            <div class="input-shell">
                                <i class="bi bi-person" aria-hidden="true"></i>
                                <InputText id="userName" class="form-control login-input" @bind-Value="login.Email" placeholder="john.doe@example.com" autocomplete="username" />
                            </div>
                            <ValidationMessage For="@(() => login.Email)" />
                        </div>

                        <div class="form-field">
                            <div class="label-row">
                                <label for="password">@Text("Password", "كلمة المرور")</label>
                                <a href="/User/ForgetPassword">@Text("Forgot password?", "نسيت كلمة المرور؟")</a>
                            </div>
                            <div class="input-shell password-shell">
                                <i class="bi bi-lock" aria-hidden="true"></i>
                                <InputText id="password" type="@(showPassword ? "text" : "password")" class="form-control login-input" @bind-Value="login.Password" placeholder="••••••••" autocomplete="current-password" />
                                <button type="button" class="password-toggle" @onclick="TogglePassword" aria-label="@Text("Toggle password visibility", "إظهار أو إخفاء كلمة المرور")">
                                    <i class="bi @(showPassword ? "bi-eye-slash" : "bi-eye")" aria-hidden="true"></i>
                                </button>
                            </div>
                            <ValidationMessage For="@(() => login.Password)" />
                        </div>

                        <label class="remember-row">
                            <InputCheckbox @bind-Value="rememberDevice" />
                            <span>@Text("Remember me on this device", "تذكرني على هذا الجهاز")</span>
                        </label>

                        <button type="submit" class="login-button" disabled="@isSubmitting" aria-busy="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                <span>@Text("Signing in...", "جاري تسجيل الدخول...")</span>
                            }
                            else
                            {
                                <span>@Text("Login", "تسجيل الدخول")</span>
                                <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                            }
                        </button>

                        <p class="register-link">
                            <span>@Text("Don’t have an account?", "ليس لديك حساب؟")</span>
                            <a href="/register">@Text("Create a new account", "إنشاء حساب جديد")</a>
                        </p>
                    </EditForm>
                </div>
            </div>

            <aside class="login-hero" aria-label="@Text("ERP workspace overview", "نبذة عن مساحة عمل ERP")">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="bi bi-shield-check" aria-hidden="true"></i>
                        <span>@Text("Trusted business workspace", "مساحة عمل موثوقة")</span>
                    </div>

                    <h2>@Text("Enterprise Resource Planning", "تخطيط موارد المؤسسة")</h2>
                    <p>
                        @Text(
                            "A connected workspace for operations, people, inventory, customers, sales, tasks, and reporting.",
                            "مساحة عمل مترابطة للعمليات والأفراد والمخزون والعملاء والمبيعات والمهام والتقارير.")
                    </p>
                </div>

                <div class="hero-features">
                    <div class="hero-feature">
                        <i class="bi bi-lock" aria-hidden="true"></i>
                        <span>@Text("Protected company and operational data", "حماية بيانات الشركة والعمليات")</span>
                    </div>
                    <div class="hero-feature">
                        <i class="bi bi-diagram-3" aria-hidden="true"></i>
                        <span>@Text("Connected business workflows", "سير عمل مترابط للأعمال")</span>
                    </div>
                    <div class="hero-feature">
                        <i class="bi bi-bar-chart-line" aria-hidden="true"></i>
                        <span>@Text("Clear reporting for better decisions", "تقارير واضحة لقرارات أفضل")</span>
                    </div>
                </div>
            </aside>
        </div>
    </main>

    <footer class="login-footer">
        <p>@Text($"© {DateTime.Now.Year} ALAFKARERP. All rights reserved.", $"© {DateTime.Now.Year} ألفكار ERP. جميع الحقوق محفوظة.")</p>
        <nav aria-label="@Text("Footer links", "روابط التذييل")">
            <a href="#">@Text("Privacy", "الخصوصية")</a>
            <a href="#">@Text("Terms", "الشروط")</a>
            <a href="#">@Text("Support", "الدعم")</a>
        </nav>
    </footer>
</section>



@* <button class="btn btn-primary" @onclick="Login">Login</button> *@
@code {

    private LoginDto login = new LoginDto();
    private bool isSubmitting;
    private bool rememberDevice;
    private bool showPassword;
    private string CurrentLangCode => SharedDataService.Language == "Ar" ? "ar" : "en";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        // login.Email = "baryce@gmail.com";
        // login.Password = "Admin@123";
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task ChangeLanguage()
    {
        await SharedDataService.UpdateLanguageAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void TogglePassword()
    {
        showPassword = !showPassword;
    }

    private async Task RunTaskDailyCheckSilentlyAsync()
    {
        try
        {
            await TaskManagementService.RunMyDailyCheckAsync();
        }
        catch
        {
        }
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
    private async Task HandleLogin()
    {
        try
        {
            isSubmitting = true;
            LoadingService.Show();

            Console.WriteLine("Submit clicked");
            Console.WriteLine($"Email/UserName: {login.Email}");

            var result = await AuthService.LoginAsync(login.Email, login.Password, rememberDevice);

            if (result.IsSuccess)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    await RunTaskDailyCheckSilentlyAsync();

                    if (authState.User.Claims.Any(c =>
                        c.Type == JwtRegisteredClaimNames.Typ &&
                        c.Value == UserType.SystemUser.ToString()))
                    {
                        NavigationManager.NavigateTo("/Dashboard");
                        return;
                    }

                    NavigationManager.NavigateTo("/");
                    return;
                }
            }

            var fallbackMessage = Text("Credentials are incorrect.", "بيانات الدخول غير صحيحة.");
            var displayMessage = ApiErrorFormatter.GetDisplayMessage(result.Error, SharedDataService.Language, fallbackMessage);

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login", "تسجيل دخول"),
                Message = displayMessage,
                Details = result.Error?.Detail ?? string.Empty,
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("LOGIN ERROR:");
            Console.WriteLine(ex.ToString());

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login error", "خطأ تسجيل الدخول"),
                Message = Text("Unable to complete login. Please try again.", "تعذر إكمال تسجيل الدخول. يرجى المحاولة مرة أخرى."),
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        finally
        {
            isSubmitting = false;
            LoadingService.Hide();
        }
    }

}
