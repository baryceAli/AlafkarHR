@* @layout NewLayout *@

@layout AuthNewLayout
@page "/login"

@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Dtos.Auth
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.IdentityModel.JsonWebTokens
@using SharedWithUI.Auth.Dtos
@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthService AuthService

@inject ModalService ModalService
@inject LoadingService LoadingService

@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="login-page" dir="@SharedDataService.PageDirection" lang="@CurrentLangCode">
    <button type="button" class="language-switch" @onclick="ChangeLanguage" aria-label="@Text("Change language", "تغيير اللغة")">
        <span aria-hidden="true">◎</span>
        <span>@(SharedDataService.Language == "Ar" ? "Eng" : "عربي")</span>
    </button>

    <div class="login-shell">
        <aside class="login-hero" aria-label="@Text("ALAFKARHR overview", "نبذة عن نظام الأفكار للموارد البشرية")">
            <div class="brand-mark">AF</div>
            <div>
                <p class="eyebrow">ALAFKARHR</p>
                <h1>@Text("Welcome back to your HR workspace", "مرحباً بعودتك إلى مساحة الموارد البشرية")</h1>
                <p class="hero-copy">
                    @Text(
                        "Manage employees, attendance, payroll, inventory, and sales operations from one secure ERP portal.",
                        "أدر الموظفين والحضور والرواتب والمخزون وعمليات المبيعات من بوابة ERP آمنة واحدة.")
                </p>
            </div>

            <div class="hero-metrics" aria-label="@Text("Platform highlights", "مميزات المنصة")">
                <div>
                    <strong>360</strong>
                    <span>@Text("employee profile", "ملف الموظف")</span>
                </div>
                <div>
                    <strong>24/7</strong>
                    <span>@Text("secure access", "وصول آمن")</span>
                </div>
                <div>
                    <strong>ERP</strong>
                    <span>@Text("operations hub", "مركز العمليات")</span>
                </div>
            </div>
        </aside>

        <div class="login-panel">
            <div class="login-panel-header">
                <p class="eyebrow">@Text("Secure sign in", "دخول آمن")</p>
                <h2>@Text("Login to your account", "تسجيل الدخول إلى حسابك")</h2>
                <p>@Text("Use your workspace credentials to continue.", "استخدم بيانات حسابك للمتابعة.")</p>
            </div>

            <EditForm Model="@login" OnValidSubmit="HandleLogin" class="login-form">
                <DataAnnotationsValidator />

                <div class="form-field">
                    <label for="userName">@Text("User name", "اسم المستخدم")</label>
                    <InputText id="userName" class="login-input" @bind-Value="login.Email" placeholder="@Text("Enter email or user name", "أدخل البريد الإلكتروني أو اسم المستخدم")" autocomplete="username" />
                    <ValidationMessage For="@(() => login.Email)" />
                </div>

                <div class="form-field">
                    <div class="label-row">
                        <label for="password">@Text("Password", "كلمة المرور")</label>
                        <a href="/User/ForgetPassword">@Text("Forgot password?", "نسيت كلمة المرور؟")</a>
                    </div>
                    <InputText id="password" type="password" class="login-input" @bind-Value="login.Password" placeholder="@Text("Enter password", "أدخل كلمة المرور")" autocomplete="current-password" />
                    <ValidationMessage For="@(() => login.Password)" />
                </div>

                <button type="submit" class="login-button">
                    <span>@Text("Login", "تسجيل الدخول")</span>
                    <span aria-hidden="true">@Text("->", "<-")</span>
                </button>

                <p class="register-link">
                    <span>@Text("Don’t have an account?", "ليس لديك حساب؟")</span>
                    <a href="/Register">@Text("Create one", "إنشاء حساب")</a>
                </p>
            </EditForm>
        </div>
    </div>
</section>



@* <button class="btn btn-primary" @onclick="Login">Login</button> *@
@code {

    private LoginDto login = new LoginDto();
    private string CurrentLangCode => SharedDataService.Language == "Ar" ? "ar" : "en";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        // login.Email = "baryce@gmail.com";
        // login.Password = "Admin@123";
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task ChangeLanguage()
    {
        await SharedDataService.UpdateLanguageAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
    private async Task HandleLogin()
    {
        try
        {
            LoadingService.Show();

            Console.WriteLine("Submit clicked");
            Console.WriteLine($"Email/UserName: {login.Email}");
            Console.WriteLine($"Password: {login.Password}");

            var result = await AuthService.LoginAsync(login.Email, login.Password);

            if (result.IsSuccess)
            {
                var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

                if (authState.User.Identity?.IsAuthenticated == true)
                {
                    if (authState.User.Claims.Any(c =>
                        c.Type == JwtRegisteredClaimNames.Typ &&
                        c.Value == UserType.SystemUser.ToString()))
                    {
                        NavigationManager.NavigateTo("/Dashboard", true);
                        return;
                    }

                    NavigationManager.NavigateTo("/", true);
                    return;
                }
            }

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login", "تسجيل دخول"),
                Message = Text("Credentials are incorrect.", "بيانات الدخول غير صحيحة."),
                Details = $"{result.Error?.ToString()}, {result.Error?.Detail}",
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine("LOGIN ERROR:");
            Console.WriteLine(ex.ToString());

            await ModalService.ShowAsync(new ModalOptions
            {
                IsError = true,
                Title = Text("Login error", "خطأ تسجيل الدخول"),
                Message = ex.Message,
                Details = ex.ToString(),
                OkText = Text("OK", "موافق"),
                OnOk = async () => { }
            });
        }
        finally
        {
            LoadingService.Hide();
        }
    }

}
