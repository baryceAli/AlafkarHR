@layout AuthNewLayout
@page "/User/ForgetPassword"
@page "/forgot-password"

@using AlAfkarERP.Shared.Pages.Features.Auth.Layout
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using System.ComponentModel.DataAnnotations
@implements IDisposable

@inject IAuthService AuthService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="forgot-page" dir="@SharedDataService.PageDirection" lang="@CurrentLangCode">
    <header class="forgot-topbar">
        <a class="forgot-brand" href="/login" aria-label="ALAFKARERP">
            <span class="forgot-brand-mark" aria-hidden="true">A</span>
            <span>ALAFKARERP</span>
        </a>

        <button type="button" class="language-switch" @onclick="ChangeLanguage" aria-label="@Text("Change language", "تغيير اللغة")">
            <i class="bi bi-globe2" aria-hidden="true"></i>
            <span>@Text("العربية", "English")</span>
        </button>
    </header>

    <main class="forgot-main">
        <div class="forgot-shell">
            <section class="forgot-panel">
                <div class="forgot-panel-inner">
                    <div class="forgot-kicker">@Text("Account recovery", "استعادة الحساب")</div>

                    <div class="forgot-panel-header">
                        <h1>@(otpRequested ? Text("Confirm your OTP", "تأكيد رمز التحقق") : Text("Forgot password?", "نسيت كلمة المرور؟"))</h1>
                        <p>
                            @(otpRequested
                                ? Text("Enter the OTP sent to your email or phone. Once confirmed, a temporary password will be sent to you.", "أدخل رمز التحقق المرسل إلى بريدك أو جوالك. بعد التأكيد سيتم إرسال كلمة مرور مؤقتة إليك.")
                                : Text("Enter your email or phone number and we will send an OTP to start password recovery.", "أدخل بريدك الإلكتروني أو رقم الجوال وسنرسل رمز تحقق لبدء استعادة كلمة المرور."))
                        </p>
                    </div>

                    @if (!otpRequested)
                    {
                        <EditForm Model="@requestModel" OnValidSubmit="RequestOtp" class="forgot-form">
                            <DataAnnotationsValidator />

                            <div class="form-field">
                                <label for="identifier">@Text("Email or phone number", "البريد الإلكتروني أو رقم الجوال")</label>
                                <div class="input-shell">
                                    <i class="bi bi-person-vcard" aria-hidden="true"></i>
                                    <InputText id="identifier" class="form-control forgot-input" @bind-Value="requestModel.UserIdentifier" autocomplete="username" />
                                </div>
                                <ValidationMessage For="@(() => requestModel.UserIdentifier)" />
                            </div>

                            <button type="submit" class="forgot-button" disabled="@isSubmitting" aria-busy="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span>@Text("Sending OTP...", "جاري إرسال الرمز...")</span>
                                }
                                else
                                {
                                    <span>@Text("Send OTP", "إرسال رمز التحقق")</span>
                                    <i class="bi bi-arrow-right-short" aria-hidden="true"></i>
                                }
                            </button>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="@confirmModel" OnValidSubmit="ConfirmOtp" class="forgot-form">
                            <DataAnnotationsValidator />

                            <div class="sent-box">
                                <i class="bi bi-send-check" aria-hidden="true"></i>
                                <div>
                                    <strong>@Text("OTP sent", "تم إرسال الرمز")</strong>
                                    <span>@requestModel.UserIdentifier</span>
                                </div>
                            </div>

                            <div class="form-field">
                                <label for="otp">@Text("OTP code", "رمز التحقق")</label>
                                <div class="input-shell">
                                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                                    <InputText id="otp" class="form-control forgot-input otp-input" @bind-Value="confirmModel.Otp" autocomplete="one-time-code" />
                                </div>
                                <ValidationMessage For="@(() => confirmModel.Otp)" />
                            </div>

                            <button type="submit" class="forgot-button" disabled="@isSubmitting" aria-busy="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                                    <span>@Text("Confirming...", "جاري التأكيد...")</span>
                                }
                                else
                                {
                                    <span>@Text("Confirm OTP", "تأكيد الرمز")</span>
                                    <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                }
                            </button>

                            <button type="button" class="ghost-button" @onclick="BackToRequest" disabled="@isSubmitting">
                                <i class="bi bi-arrow-left-short" aria-hidden="true"></i>
                                <span>@Text("Use a different email or phone", "استخدام بريد أو جوال آخر")</span>
                            </button>
                        </EditForm>
                    }

                    <p class="forgot-link-row">
                        <a href="/login">@Text("Back to login", "العودة لتسجيل الدخول")</a>
                    </p>
                </div>
            </section>

            <aside class="forgot-hero" aria-label="@Text("Password recovery overview", "نبذة عن استعادة كلمة المرور")">
                <div class="hero-content">
                    <div class="hero-badge">
                        <i class="bi bi-key" aria-hidden="true"></i>
                        <span>@Text("Secure recovery", "استعادة آمنة")</span>
                    </div>

                    <h2>@Text("Recover access without leaving your workspace", "استعد الوصول دون مغادرة مساحة عملك")</h2>
                    <p>@Text("The current recovery flow verifies your OTP and sends a temporary password through the registered contact channel.", "يتحقق مسار الاستعادة الحالي من رمز التحقق ثم يرسل كلمة مرور مؤقتة عبر وسيلة التواصل المسجلة.")</p>
                </div>

                <div class="hero-features">
                    <div class="hero-feature">
                        <i class="bi bi-person-vcard" aria-hidden="true"></i>
                        <span>@Text("Email or phone recovery", "استعادة بالبريد أو الجوال")</span>
                    </div>
                    <div class="hero-feature">
                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                        <span>@Text("OTP verification", "تحقق برمز مؤقت")</span>
                    </div>
                    <div class="hero-feature">
                        <i class="bi bi-envelope-check" aria-hidden="true"></i>
                        <span>@Text("Temporary password delivery", "إرسال كلمة مرور مؤقتة")</span>
                    </div>
                </div>
            </aside>
        </div>
    </main>
</section>

@code {
    private readonly ForgotPasswordRequestModel requestModel = new();
    private readonly ConfirmOtpModel confirmModel = new();
    private bool otpRequested;
    private bool isSubmitting;
    private string CurrentLangCode => SharedDataService.Language == "Ar" ? "ar" : "en";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task ChangeLanguage()
    {
        await SharedDataService.UpdateLanguageAsync();
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private async Task RequestOtp()
    {
        try
        {
            isSubmitting = true;
            LoadingService.Show();
            requestModel.UserIdentifier = requestModel.UserIdentifier.Trim();

            var result = await AuthService.GenerateResetPasswordOtpAsync(requestModel.UserIdentifier);

            if (result.IsSuccess && result.Data)
            {
                otpRequested = true;
                confirmModel.Otp = string.Empty;
                return;
            }

            await ShowErrorAsync(Text("OTP was not sent", "لم يتم إرسال الرمز"), result.Error?.Detail ?? result.Error?.Title);
        }
        catch (Exception ex)
        {
            await ShowErrorAsync(Text("Password recovery error", "خطأ في استعادة كلمة المرور"), ex.Message, ex.ToString());
        }
        finally
        {
            isSubmitting = false;
            LoadingService.Hide();
        }
    }

    private async Task ConfirmOtp()
    {
        try
        {
            isSubmitting = true;
            LoadingService.Show();

            var result = await AuthService.ConfirmOtpAsync(requestModel.UserIdentifier, confirmModel.Otp.Trim());

            if (result.IsSuccess && result.Data)
            {
                await ModalService.ShowAsync(new ModalOptions
                {
                    Title = Text("OTP confirmed", "تم تأكيد الرمز"),
                    Message = Text("Your password was reset. A temporary password has been sent to your registered contact channel.", "تمت إعادة تعيين كلمة المرور. تم إرسال كلمة مرور مؤقتة إلى وسيلة التواصل المسجلة."),
                    OkText = Text("Go to login", "الذهاب لتسجيل الدخول"),
                    OnOk = async () => NavigationManager.NavigateTo("/login")
                });

                return;
            }

            await ShowErrorAsync(Text("OTP confirmation failed", "تعذر تأكيد الرمز"), result.Error?.Detail ?? result.Error?.Title);
        }
        catch (Exception ex)
        {
            await ShowErrorAsync(Text("OTP confirmation error", "خطأ في تأكيد الرمز"), ex.Message, ex.ToString());
        }
        finally
        {
            isSubmitting = false;
            LoadingService.Hide();
        }
    }

    private void BackToRequest()
    {
        otpRequested = false;
        confirmModel.Otp = string.Empty;
    }

    private async Task ShowErrorAsync(string title, string? message, string? details = null)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            IsError = true,
            Title = title,
            Message = string.IsNullOrWhiteSpace(message) ? Text("Please try again.", "يرجى المحاولة مرة أخرى.") : message,
            Details = details ?? string.Empty,
            OkText = Text("OK", "موافق"),
            OnOk = async () => { }
        });
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

    private sealed class ForgotPasswordRequestModel
    {
        [Required(ErrorMessage = "Email or phone number is required")]
        public string UserIdentifier { get; set; } = string.Empty;
    }

    private sealed class ConfirmOtpModel
    {
        [Required(ErrorMessage = "OTP is required")]
        public string Otp { get; set; } = string.Empty;
    }
}
