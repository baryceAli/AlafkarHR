@layout AdminLayout
@page "/Inventory/Dashboard"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Inventory.Dtos

@inject SharedDataService SharedDataService
@inject IInventoryService InventoryService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Inventory Dashboard", "لوحة المخزون")"
                Subtitle="@SharedDataService.SelectViewLang("Monitor stock balances and move into warehouse, batch, and operation workflows.", "متابعة أرصدة المخزون والانتقال إلى المستودعات والدفعات وعمليات المخزون.")"
                Overline="@SharedDataService.SelectViewLang("Inventory Management", "إدارة المخزون")"
                Icon="bi-box-seam">
        <Actions>
            <a class="btn btn-primary" href="/Inventories/List">
                <i class="bi bi-boxes"></i>
                @SharedDataService.SelectViewLang("Current Stock", "المخزون الحالي")
            </a>
            <a class="btn btn-outline-secondary" href="/Inventory/Warehouse/List">
                <i class="bi bi-building"></i>
                @SharedDataService.SelectViewLang("Warehouses", "المستودعات")
            </a>
            <a class="btn btn-outline-secondary" href="/Inventory/Transfers">
                <i class="bi bi-truck"></i>
                @SharedDataService.SelectViewLang("Transfers", "التحويلات")
            </a>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <AppCard CssClass="mb-3">
            <div class="erp-loading">@T("Loading execution dashboard...", "جاري تحميل لوحة التنفيذ...")</div>
        </AppCard>
    }
    else if (dashboard is not null)
    {
        <div class="row g-3 mb-3">
            @foreach (var metric in dashboard.Metrics.Take(6))
            {
                <div class="col-xl-2 col-md-4 col-sm-6">
                    <StatsCard Title="@T(metric.LabelEng, metric.Label)"
                               Value="@metric.Value.ToString("0.##")"
                               Icon="@metric.Icon"
                               Tone="@metric.Tone"
                               OnClick="@(() => NavigateMetric(metric))" />
                </div>
            }
        </div>

        <div class="row g-3 mb-3">
            <div class="col-xl-7">
                <AppCard Title="@T("Operations To Process", "عمليات قيد التنفيذ")">
                    @if (dashboard.OperationsToProcess.Count == 0)
                    {
                        <EmptyState Title="@T("No open operations", "لا توجد عمليات مفتوحة")"
                                    Message="@T("Warehouse execution is currently clear.", "تنفيذ المستودعات واضح حالياً.")"
                                    Icon="bi-list-check" />
                    }
                    else
                    {
                        <div class="erp-table-wrap">
                            <table class="erp-table table">
                                <thead>
                                    <tr>
                                        <th>@T("Source", "المصدر")</th>
                                        <th>@T("Step", "المرحلة")</th>
                                        <th>@T("Status", "الحالة")</th>
                                        <th>@T("Qty", "الكمية")</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var operation in dashboard.OperationsToProcess)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@OperationUrl(operation)" class="fw-semibold">@operation.SourceDocumentNumber</a>
                                                <div class="text-muted small">@operation.SourceDocumentType</div>
                                            </td>
                                            <td>@operation.OperationKind</td>
                                            <td><StatusChip Text="@operation.Status.ToString()" Tone="muted" /></td>
                                            <td>@operation.DoneQuantity / @operation.PlannedQuantity</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </AppCard>
            </div>
            <div class="col-xl-5">
                <AppCard Title="@T("Open Picking Groups", "مجموعات الالتقاط المفتوحة")">
                    @if (dashboard.OpenPickingGroups.Count == 0)
                    {
                        <EmptyState Title="@T("No open picking groups", "لا توجد مجموعات مفتوحة")"
                                    Message="@T("Create a batch or wave from the picking groups page.", "أنشئ دفعة أو موجة من صفحة مجموعات الالتقاط.")"
                                    Icon="bi-collection" />
                    }
                    else
                    {
                        <div class="vstack gap-2">
                            @foreach (var group in dashboard.OpenPickingGroups)
                            {
                                <a class="d-flex justify-content-between gap-2 border rounded p-2 text-decoration-none" href="/Inventory/Operations/PickingGroups">
                                    <span>
                                        <span class="fw-semibold">@group.GroupNumber</span>
                                        <span class="text-muted small d-block">@group.GroupType - @group.Lines.Count @T("operations", "عمليات")</span>
                                    </span>
                                    <StatusChip Text="@group.Status.ToString()" Tone="primary" CssClass="align-self-center" />
                                </a>
                            }
                        </div>
                    }
                </AppCard>
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Stock Balances", "أرصدة المخزون")"
                     Subtitle="@SharedDataService.SelectViewLang("Review quantities by warehouse, product, and SKU.", "مراجعة الكميات حسب المستودع والمنتج والمنتج المخزني.")">
                <a class="btn btn-outline-primary" href="/Inventories/List">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Open", "فتح")
                </a>
            </AppCard>
        </div>
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Batches", "الدفعات")"
                     Subtitle="@SharedDataService.SelectViewLang("Manage batch numbers and production/expiry dates.", "إدارة أرقام الدفعات وتواريخ الإنتاج والانتهاء.")">
                <a class="btn btn-outline-primary" href="/Inventory/Batch/List">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Open", "فتح")
                </a>
            </AppCard>
        </div>
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Operations", "العمليات")"
                     Subtitle="@SharedDataService.SelectViewLang("Receive, issue, adjust, reserve, or release stock.", "استلام أو صرف أو تسوية أو حجز أو إطلاق المخزون.")">
                <a class="btn btn-outline-primary" href="/Inventory/Operations/StockIn">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Start", "بدء")
                </a>
            </AppCard>
        </div>
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Transfers", "التحويلات")"
                     Subtitle="@SharedDataService.SelectViewLang("Move stock between warehouses and receive shipped items.", "نقل المخزون بين المستودعات واستلام البنود المشحونة.")">
                <a class="btn btn-outline-primary" href="/Inventory/Transfers">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Open", "فتح")
                </a>
            </AppCard>
        </div>
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Movements", "حركات المخزون")"
                     Subtitle="@SharedDataService.SelectViewLang("Review movement history by document, warehouse, SKU, and batch.", "مراجعة سجل الحركات حسب المستند والمستودع والمنتج والدفعة.")">
                <a class="btn btn-outline-primary" href="/Inventory/Movements">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Open", "فتح")
                </a>
            </AppCard>
        </div>
        <div class="col-md-4">
            <AppCard Title="@SharedDataService.SelectViewLang("Asset Instances", "الأصول المخزنية")"
                     Subtitle="@SharedDataService.SelectViewLang("Track serialized and asset-managed inventory items.", "تتبع عناصر المخزون المسلسلة والمدارة كأصول.")">
                <a class="btn btn-outline-primary" href="/Inventory/AssetInstances">
                    <i class="bi bi-arrow-up-right"></i>
                    @SharedDataService.SelectViewLang("Open", "فتح")
                </a>
            </AppCard>
        </div>
    </div>
</div>

@code {
    private InventoryExecutionDashboardDto? dashboard;
    private bool isLoading = true;
    private Guid companyId;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var auth = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (CompanyContext.TryGetCompanyId(auth.User, out companyId))
            await LoadDashboardAsync();
        isLoading = false;
    }

    private async Task LoadDashboardAsync()
    {
        var result = await InventoryService.GetExecutionDashboardAsync(companyId);
        if (result.IsSuccess)
            dashboard = result.Data;
    }

    private void NavigateMetric(InventoryExecutionMetricDto metric)
    {
        if (!string.IsNullOrWhiteSpace(metric.Url))
            NavigationManager.NavigateTo(metric.Url);
    }

    private string OperationUrl(InventoryOperationDto operation) =>
        $"/Inventory/Operations/Execution?sourceDocumentType={Uri.EscapeDataString(operation.SourceDocumentType)}&sourceDocumentId={operation.SourceDocumentId}";

    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
