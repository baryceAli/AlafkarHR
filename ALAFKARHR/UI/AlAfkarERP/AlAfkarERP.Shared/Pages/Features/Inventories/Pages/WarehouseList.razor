@layout AdminLayout
@page "/Inventory/Warehouse/List"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Inventory.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions


@inject IWarehouseService WarehouseService
@inject IInventoryService InventoryService
@inject IBranchService BranchService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.WarehousePermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Warehouse Management", "إدارة المستودعات")"
                Subtitle="@SharedDataService.SelectViewLang("Create, edit, and maintain company warehouse locations.", "إنشاء وتعديل ومتابعة مواقع مستودعات الشركة.")"
                Overline="@SharedDataService.SelectViewLang("Inventory", "المخزون")"
                Icon="bi-building">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.WarehousePermissions.Create}"))">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Warehouses", "المستودعات")"
             Subtitle="@SharedDataService.SelectViewLang("Search warehouse records and manage their address and coordinates.", "البحث في سجلات المستودعات وإدارة العنوان والإحداثيات.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
                <div class="input-group erp-filter-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search warehouses...", "ابحث في المستودعات...")"
                           @bind="searchText" />
                </div>
            </ChildContent>
            <Actions>
                <select class="form-select erp-page-size-select" @bind="branchFilterText" @bind:after="ApplyBranchFilterAsync" aria-label="@SharedDataService.SelectViewLang("Branch scope", "نطاق الفرع")">
                    <option value="">@SharedDataService.SelectViewLang("All scopes", "كل النطاقات")</option>
                    <option value="__shared">@SharedDataService.SelectViewLang("Company-level/shared", "على مستوى الشركة / مشترك")</option>
                    @foreach (var branch in branches)
                    {
                        <option value="@branch.Id">@BranchName(branch.Id)</option>
                    }
                </select>
                <select class="form-select erp-page-size-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

        <div class="erp-table-wrap">
                    <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

            <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th>@SharedDataService.SelectViewLang("Code", "الرمز")</th>
                <th>@SharedDataService.SelectViewLang("Flows", "المسارات")</th>
                <th @onclick="() => Sort(nameof(WarehouseDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(WarehouseDto.Location))">@SharedDataService.SelectViewLang("Location", "الموقع")</th>
                <th>@SharedDataService.SelectViewLang("Branch scope", "نطاق الفرع")</th>
                <th @onclick="() => Sort(nameof(WarehouseDto.Address))">@SharedDataService.SelectViewLang("Address", "العنوان")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingWarehouseId != null)
            {
                var editingItem = warehouses.FirstOrDefault(x => x.Id == editingWarehouseId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveWarehouse(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <div class="p-3">
                                    <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                        <div>
                                            <div class="fw-semibold">@SharedDataService.SelectViewLang("Warehouse Details", "تفاصيل المستودع")</div>
                                            <div class="text-muted small">@SharedDataService.SelectViewLang("Update the warehouse name, location, and address.", "تحديث اسم المستودع والموقع والعنوان.")</div>
                                        </div>
                                    </div>

                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Location", "الموقع")</label>
                                            <InputText class="form-control" @bind-Value="editingItem.Location" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Short code", "الرمز المختصر")</label>
                                            <InputText class="form-control" @bind-Value="editingItem.ShortCode" maxlength="20" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Inbound flow", "مسار الاستلام")</label>
                                            <InputSelect class="form-select" @bind-Value="editingItem.InboundFlow">
                                                @foreach (var flow in Enum.GetValues<WarehouseOperationFlow>())
                                                {
                                                    <option value="@flow">@FlowLabel(flow)</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Outbound flow", "مسار التسليم")</label>
                                            <InputSelect class="form-select" @bind-Value="editingItem.OutboundFlow">
                                                @foreach (var flow in Enum.GetValues<WarehouseOperationFlow>())
                                                {
                                                    <option value="@flow">@FlowLabel(flow)</option>
                                                }
                                            </InputSelect>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Longitude", "خط الطول")</label>
                                            <InputNumber class="form-control" @bind-Value="editingItem.Longitude" />
                                            <ValidationMessage For="()=> editingItem.Longitude"/>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Latitude", "خط العرض")</label>
                                            <InputNumber class="form-control" @bind-Value="editingItem.Latitude" />
                                            <ValidationMessage For="() => editingItem.Latitude" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Branch scope", "نطاق الفرع")</label>
                                            <select class="form-select" value="@BranchEditValue(editingItem.BranchId)" @onchange="args => SetWarehouseBranch(editingItem, args.Value?.ToString())">
                                                @if (canViewAllBranches)
                                                {
                                                    <option value="">@SharedDataService.SelectViewLang("Company-level/shared", "على مستوى الشركة / مشترك")</option>
                                                }
                                                @foreach (var branch in branches)
                                                {
                                                    <option value="@branch.Id">@BranchName(branch.Id)</option>
                                                }
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Address", "العنوان")</label>
                                            <div class="fw-semibold mb-2">@SharedDataService.SelectViewLang("Resupply from", "إعادة الإمداد من")</div>
                                            <div class="row g-2 mb-3">
                                                @foreach (var sourceWarehouse in ResupplyCandidates(editingItem.Id))
                                                {
                                                    <div class="col-md-4 col-lg-3">
                                                        <label class="form-check border rounded p-2 h-100">
                                                            <input class="form-check-input"
                                                                   type="checkbox"
                                                                   checked="@IsResupplySelected(editingItem, sourceWarehouse.Id)"
                                                                   @onchange="args => ToggleResupplyWarehouse(editingItem, sourceWarehouse.Id, args)" />
                                                            <span class="form-check-label ms-1">@WarehouseName(sourceWarehouse)</span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>

                                            <div class="fw-semibold mb-2">@SharedDataService.SelectViewLang("Default operation locations", "مواقع العمليات الافتراضية")</div>
                                            <div class="row g-3 mb-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Source / Stock", "المصدر / المخزون")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultSourceLocationId)" @onchange="args => editingItem.DefaultSourceLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Destination / Input", "الوجهة / الاستلام")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultDestinationLocationId)" @onchange="args => editingItem.DefaultDestinationLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Quality", "الجودة")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultQualityLocationId)" @onchange="args => editingItem.DefaultQualityLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Packing", "التعبئة")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultPackingLocationId)" @onchange="args => editingItem.DefaultPackingLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Output", "الإخراج")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultOutputLocationId)" @onchange="args => editingItem.DefaultOutputLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Transit", "النقل")</label>
                                                    <select class="form-select" value="@LocationEditValue(editingItem.DefaultTransitLocationId)" @onchange="args => editingItem.DefaultTransitLocationId = ParseLocationValue(args.Value?.ToString())">
                                                        @LocationOptions(editingItem.Id)
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-text mb-3">@SharedDataService.SelectViewLang("Required missing locations are created automatically from the short code when saving.", "يتم إنشاء المواقع المطلوبة الناقصة تلقائيا من الرمز المختصر عند الحفظ.")</div>

                                            <InputTextArea class="form-control" @bind-Value="editingItem.Address" />
                                        </div>

                                        <div class="col-12 d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">@SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                            <button type="submit" class="btn btn-success btn-sm">@SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            
            @foreach (var warehouse in ProcessedWarehouse.Where(x => x.Id != editingWarehouseId))
            {
                
                <tr>
                    <td><StatusChip Text="@(!string.IsNullOrWhiteSpace(warehouse.ShortCode) ? warehouse.ShortCode : "-")" Tone="muted" /></td>
                    <td>
                        <div class="small">@SharedDataService.SelectViewLang("In", "وارد"): @FlowLabel(warehouse.InboundFlow)</div>
                        <div class="small text-muted">@SharedDataService.SelectViewLang("Out", "صادر"): @FlowLabel(warehouse.OutboundFlow)</div>
                    </td>
                    <td>@SharedDataService.SelectViewLang(warehouse.NameEng,warehouse.Name)</td>
                    <td>@warehouse.Location</td>
                    <td><StatusChip Text="@BranchScopeLabel(warehouse.BranchId)" Tone="muted" /></td>
                    <td>@warehouse.Address</td>
                    <td>
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditWarehouse(warehouse.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.WarehousePermissions.Edit}"))
                                title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteWarehouse(warehouse)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.WarehousePermissions.Delete}"))
                                title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
                
            }
            </tbody>
        </table>
        </div>

        @if (!ProcessedWarehouse.Any() && editingWarehouseId == null)
        {
            <EmptyState Icon="bi-building"
                        Title="@SharedDataService.SelectViewLang("No warehouses found", "لا توجد مستودعات")"
                        Message="@SharedDataService.SelectViewLang("Create a warehouse or adjust your search.", "أنشئ مستودعا أو عدل عبارة البحث.")" />
        }

    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted small">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<WarehouseDto> warehouses = new();
    private List<WarehouseDto> resupplyWarehouses = new();
    private Guid? editingWarehouseId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    private List<BranchDto> branches = [];
    private List<WarehouseLocationDto> warehouseLocations = [];
    private bool canViewAllBranches;
    private string branchFilterText = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadBranchAccessAsync();
        await LoadWarehouse();
        await LoadWarehouseLocations();
    }
    // Branch
    void CreateNew()
    {
        var newItem = new WarehouseDto()
        {
            Id = Guid.NewGuid()
        };
        newItem.CompanyId = companyId;
        newItem.BranchId = canViewAllBranches ? null : branches.FirstOrDefault()?.Id;
        warehouses.Insert(0, newItem);
        editingWarehouseId = newItem.Id;
        isEdit = false;
    }

    void EditWarehouse(Guid id)
    {
        editingWarehouseId = id;
        isEdit = true;
        StateHasChanged();
    }
    async Task SaveWarehouse(WarehouseDto warehouse)
    {
        if (warehouse.Id == editingWarehouseId && !isEdit)
        {
            //Create new

            // Random rnd = new Random();

            warehouse.CompanyId = companyId;

            var bResponse = await WarehouseService.CreateAsync(warehouse);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Warehouse has been created successfully", "تم إضافة المستودع بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = bResponse.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await WarehouseService.UpdateAsync(warehouse);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Warehouse has been Edited successfully", "تم تعديل المستودع بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = bresponse.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadWarehouse();
        await LoadWarehouseLocations();
        editingWarehouseId = null;
    }

    async Task DeleteWarehouse(WarehouseDto warehouse)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Warehouse: {warehouse.NameEng}?", $"هل ترغب فعلا في حذف المستودع: {warehouse.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await WarehouseService.DeleteAsync(warehouse.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadWarehouse();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Warehouse", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = warehouses.FirstOrDefault(x => x.Id == editingWarehouseId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            await LoadWarehouse();
        }
        else
        {
            // new record → remove it
            warehouses.Remove(item);
        }
        isEdit = false;
        editingWarehouseId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(WarehouseDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadBranchAccessAsync()
    {
        var accessResponse = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        canViewAllBranches = accessResponse.IsSuccess && accessResponse.Data?.CanViewAllBranches == true;

        var branchResponse = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (branchResponse.IsSuccess)
        {
            branches = branchResponse.Data?.Data.ToList() ?? [];
        }
    }

    private async Task LoadWarehouse()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await WarehouseService.GetAsync(companyId, pageIndex, pageSize,searchText, ParseBranchFilter());//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            warehouses = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }

        var resupplyResponse = await WarehouseService.GetAsync(companyId, 0, 1000, string.Empty, ParseBranchFilter());
        if (resupplyResponse.IsSuccess)
        {
            resupplyWarehouses = resupplyResponse.Data?.Data.ToList() ?? [];
        }
    }

    private async Task LoadWarehouseLocations()
    {
        var response = await InventoryService.GetWarehouseLocationsAsync(companyId);
        if (response.IsSuccess)
        {
            warehouseLocations = response.Data ?? [];
        }
    }

    private IEnumerable<WarehouseLocationDto> ActiveLocationsFor(Guid warehouseId) =>
        warehouseLocations
            .Where(x => x.WarehouseId == warehouseId && x.IsActive)
            .OrderBy(x => x.Code);

    private RenderFragment LocationOptions(Guid warehouseId) => builder =>
    {
        var sequence = 0;
        builder.OpenElement(sequence++, "option");
        builder.AddAttribute(sequence++, "value", string.Empty);
        builder.AddContent(sequence++, SharedDataService.SelectViewLang("Auto / none", "تلقائي / لا يوجد"));
        builder.CloseElement();

        foreach (var location in ActiveLocationsFor(warehouseId))
        {
            builder.OpenElement(sequence++, "option");
            builder.AddAttribute(sequence++, "value", location.Id.ToString());
            builder.AddContent(sequence++, LocationName(location));
            builder.CloseElement();
        }
    };

    private string LocationEditValue(Guid? locationId) => locationId?.ToString() ?? string.Empty;

    private Guid? ParseLocationValue(string? value) =>
        Guid.TryParse(value, out var locationId) ? locationId : null;

    private string LocationName(WarehouseLocationDto location)
    {
        var name = SharedDataService.SelectViewLang(location.NameEng, location.Name);
        return string.IsNullOrWhiteSpace(location.Code) ? name : $"{location.Code} - {name}";
    }

    private IEnumerable<WarehouseDto> ResupplyCandidates(Guid currentWarehouseId) =>
        resupplyWarehouses.Where(x => x.Id != currentWarehouseId);

    private bool IsResupplySelected(WarehouseDto warehouse, Guid sourceWarehouseId) =>
        warehouse.ResupplyFromWarehouseIds?.Contains(sourceWarehouseId) == true;

    private void ToggleResupplyWarehouse(WarehouseDto warehouse, Guid sourceWarehouseId, ChangeEventArgs args)
    {
        warehouse.ResupplyFromWarehouseIds ??= [];
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            if (!warehouse.ResupplyFromWarehouseIds.Contains(sourceWarehouseId))
                warehouse.ResupplyFromWarehouseIds.Add(sourceWarehouseId);
        }
        else
        {
            warehouse.ResupplyFromWarehouseIds.Remove(sourceWarehouseId);
        }
    }

    private string WarehouseName(WarehouseDto warehouse) =>
        SharedDataService.SelectViewLang(warehouse.NameEng, warehouse.Name);

    private string FlowLabel(WarehouseOperationFlow flow) =>
        flow switch
        {
            WarehouseOperationFlow.TwoStep => SharedDataService.SelectViewLang("Two-step", "خطوتان"),
            WarehouseOperationFlow.ThreeStep => SharedDataService.SelectViewLang("Three-step", "ثلاث خطوات"),
            _ => SharedDataService.SelectViewLang("One-step", "خطوة واحدة")
        };

    private Guid? ParseBranchFilter() =>
        Guid.TryParse(branchFilterText, out var branchId) ? branchId : null;

    private async Task ApplyBranchFilterAsync()
    {
        pageIndex = 0;
        await LoadWarehouse();
    }

    private string BranchEditValue(Guid? branchId) => branchId?.ToString() ?? string.Empty;

    private void SetWarehouseBranch(WarehouseDto warehouse, string? value)
    {
        warehouse.BranchId = Guid.TryParse(value, out var branchId) ? branchId : null;
    }

    private string BranchScopeLabel(Guid? branchId) =>
        branchId.HasValue
            ? BranchName(branchId.Value)
            : SharedDataService.SelectViewLang("Company-level/shared", "على مستوى الشركة / مشترك");

    private string BranchName(Guid branchId)
    {
        var branch = branches.FirstOrDefault(x => x.Id == branchId);
        return branch is null
            ? SharedDataService.SelectViewLang("Unknown branch", "فرع غير معروف")
            : SharedDataService.SelectViewLang(branch.NameEng, branch.Name);
    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadWarehouse();
    }
    private IEnumerable<WarehouseDto> ProcessedWarehouse =>
    warehouses
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        .Where(b => branchFilterText != "__shared" || b.BranchId == null)

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

