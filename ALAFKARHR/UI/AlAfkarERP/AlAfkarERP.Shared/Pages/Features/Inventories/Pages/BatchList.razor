@layout AdminLayout
@page "/Inventory/Batch/List"

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Permissions


@inject IBatchService BatchService
@inject IProductService ProductService

@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BatchPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Batch Management", "إدارة الدفعات")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain batch identities, SKU links, and manufacturing and expiry dates.", "إدارة بيانات الدفعات وربطها بالمنتجات المخزنية وتواريخ الإنتاج والانتهاء.")"
                Overline="@SharedDataService.SelectViewLang("Inventory", "المخزون")"
                Icon="bi-upc-scan">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BatchPermissions.Create}"))">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Batches", "الدفعات")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, and update batch records for inventory movement.", "البحث والفرز وتحديث سجلات الدفعات لحركات المخزون.")"
             CssClass="allow-overflow">
        <FilterBar CssClass="mb-3">
            <ChildContent>
                <div class="input-group erp-filter-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search batches...", "ابحث في الدفعات...")"
                           @bind="searchText" />
                </div>
            </ChildContent>
            <Actions>
                <select class="form-select erp-page-size-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

        <div class="erp-table-wrap">
                    <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

            <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick='() => Sort(SharedDataService.Language=="Ar"? nameof(BatchDto.ProductName):nameof(BatchDto.ProductNameEng))'>
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Product", "المنتج")
                </th>
                @* <th>@SharedDataService.SelectViewLang("Product", "المنتج")</th> *@
                <th @onclick='() => Sort(SharedDataService.Language=="Ar"? nameof(BatchDto.SkuName):nameof(BatchDto.SkuNameEng))'>
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Product Sku", "المنتج المخزني")
                </th>
                @* <th>@SharedDataService.SelectViewLang("Product Sku", "المنتج المخزني")</th> *@
                <th @onclick="() => Sort(nameof(BatchDto.BatchNumber))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Batch Number", "رقم الدفعة")
                </th>
                <th @onclick="() => Sort(nameof(BatchDto.ManufacturingDate))">@SharedDataService.SelectViewLang("Manufacturing Date", "تاريخ الانتاج")</th>
                <th @onclick="() => Sort(nameof(BatchDto.ExpiryDate))">@SharedDataService.SelectViewLang("Expiry Date", "تاريخ الانتهاء")</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingBatchId != null)
            {
                var editingItem = batchs.FirstOrDefault(x => x.Id == editingBatchId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveBatch(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <div class="p-3">
                                    <div class="mb-3">
                                        <div class="fw-semibold">@SharedDataService.SelectViewLang("Batch Details", "تفاصيل الدفعة")</div>
                                        <div class="text-muted small">@SharedDataService.SelectViewLang("Choose the product and SKU, then set batch dates.", "اختر المنتج والمنتج المخزني ثم حدد تواريخ الدفعة.")</div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                                            <AutoCompleteComponent TItem="ProductDto"
                                                                   Items="products"
                                                                   Value="selectedProduct"
                                                                   ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product","اختر منتج")"
                                                                   ValueChanged="onProductChanged" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Product Sku", "المنتج المخزني")</label>
                                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                                   Items="productSkus"
                                                                   Value="selectedProductSku"
                                                                   ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product sku","اختر منتج مخزني")"
                                                                   ValueChanged="onProductSkuChanged" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Batch Number", "رقم الدفعة")</label>
                                            <InputText class="form-control" @bind-Value="editingItem.BatchNumber" />
                                            <ValidationMessage For="() => editingItem.BatchNumber" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Manufacturing Date", "تاريخ الانتاج")</label>
                                            <InputDate class="form-control" @bind-Value="editingItem.ManufacturingDate" />
                                            <ValidationMessage For="() => editingItem.ManufacturingDate" />
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Expire Date", "تاريخ الانتهاء")</label>
                                            <InputDate class="form-control" @bind-Value="editingItem.ExpiryDate" />
                                            <ValidationMessage For="() => editingItem.ExpiryDate" />
                                        </div>

                                        <div class="col-12 d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">@SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                            <button type="submit" class="btn btn-success btn-sm">@SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            
            @foreach (var batch in ProcessedBatch.Where(x => x.Id != editingBatchId))
            {
                
                <tr>
                    <td>
                        @SharedDataService.SelectViewLang(batch.ProductNameEng,batch.ProductName)
                    </td>
                    <td>
                        @SharedDataService.SelectViewLang(batch.SkuNameEng,batch.SkuName)
                    </td>
                    <td>@batch.BatchNumber</td>
                    <td>@batch.ManufacturingDate.ToString("yyyy/MM/dd")</td>
                    <td>@batch.ExpiryDate.ToString("yyyy/MM/dd")</td>
                    <td>
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditBatch(batch.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BatchPermissions.Edit}"))
                                title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteWarehouse(batch)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BatchPermissions.Delete}"))
                                title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
                
            }
            </tbody>
        </table>
        </div>

        @if (!ProcessedBatch.Any() && editingBatchId == null)
        {
            <EmptyState Icon="bi-upc-scan"
                        Title="@SharedDataService.SelectViewLang("No batches found", "لا توجد دفعات")"
                        Message="@SharedDataService.SelectViewLang("Create a batch or adjust your search.", "أنشئ دفعة أو عدل عبارة البحث.")" />
        }

    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted small">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<BatchDto> batchs = new();
    private List<ProductDto> products = [];
    // private List<InventoryAggregateDto> inventories = [];
    private ProductDto? selectedProduct;
    private List<ProductSkuDto> productSkus = [];
    private ProductSkuDto? selectedProductSku;
    private Guid? editingBatchId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (prodRes.IsSuccess)
        {
            products = prodRes.Data?.Data?.ToList() ?? [];
        }
        // var invRes = await InventoryService.GetByBatchAsync(Guid.Empty, 0, 10000, null);
        // if (invRes.IsSuccess)
        // {
        //     inventories = invRes.Data?.Data?.ToList() ?? [];
        // }
        await LoadBatch();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }
    // Branch
    void CreateNew()
    {
        selectedProduct = null;
        onProductChanged(selectedProduct);
        selectedProductSku = null;
        var newItem = new BatchDto()
        {
            Id = Guid.NewGuid(),
            ManufacturingDate=DateTime.Now,
            ExpiryDate=DateTime.Now.AddDays(1)
        };
        newItem.CompanyId = companyId;
        batchs.Insert(0, newItem);
        editingBatchId = newItem.Id;
        isEdit = false;
    }

    void EditBatch(Guid id)
    {
        editingBatchId = id;
        var batch = batchs.FirstOrDefault(b => b.Id == id);
        selectedProduct = products.FirstOrDefault(p => p.Id == batch.ProductId);
        onProductChanged(selectedProduct);
        selectedProductSku = selectedProduct.Skus.FirstOrDefault(sku => sku.Id == batch.ProductSkuId);
        isEdit = true;
        StateHasChanged();
    }
    async Task SaveBatch(BatchDto batch)
    {
        if (selectedProduct == null || selectedProductSku == null)
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Batch Management", "إدارة الدفعات"),
                IsError = true,
                Message = SharedDataService.SelectViewLang("You should select product and productSku", "يجب اختيار المنتج والمنتج المخزني"),
                OnOk = async () =>
                {

                }
            });
            return;
        }
        batch.ProductId = selectedProduct.Id;
        batch.ProductSkuId = selectedProductSku.Id;
        batch.CompanyId = companyId;
            
        if (batch.Id == editingBatchId && !isEdit)
        {
            //Create new

            // Random rnd = new Random();
            CreateBatchDto cb = new CreateBatchDto
            {
                BatchNumber = batch.BatchNumber,
                ExpiryDate = batch.ExpiryDate,
                ManufacturingDate = batch.ManufacturingDate,
                CompanyId = companyId,
                ProductId = batch.ProductId.Value,
                ProductSkuId = batch.ProductSkuId.Value
            };
            var bResponse = await BatchService.CreateAsync(cb);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Batch has been created successfully", "تم إضافة الدفعة بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            batch.CompanyId = companyId;
            //Edit
            UpdateBatchDto ub = new UpdateBatchDto
            {

                BatchNumber = batch.BatchNumber,
                ExpiryDate = batch.ExpiryDate,
                Id = batch.Id,
                ManufacturingDate = batch.ManufacturingDate,
               

            };
            var bresponse = await BatchService.UpdateAsync(ub);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Batch has been Edited successfully", "تم تعديل الدفعة بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadBatch();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingBatchId = null;
    }

    async Task DeleteWarehouse(BatchDto batch)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Batch: {batch.BatchNumber}?", $"هل ترغب فعلا في حذف الدفعة: {batch.BatchNumber}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await BatchService.DeleteAsync(batch.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadBatch();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Batch", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = batchs.FirstOrDefault(x => x.Id == editingBatchId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            await LoadBatch();
        }
        else
        {
            // new record → remove it
            batchs.Remove(item);
        }
        isEdit = false;
        editingBatchId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(BatchDto.BatchNumber);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadBatch()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await BatchService.GetAsync(companyId, pageIndex, pageSize, searchText);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            batchs = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadBatch();
    }
    private IEnumerable<BatchDto> ProcessedBatch =>
    batchs
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.BatchNumber?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.BatchNumber?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

    // 📄 Pagination
    // .Skip((pageIndex) * pageSize)
    // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadBatch();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;

        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadBatch();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    private void onProductChanged(ProductDto product)
    {
        selectedProduct = null;
        productSkus = [];
        if (product != null && product.Id != Guid.Empty)
        {
            
            selectedProduct = product;
            productSkus = product.Skus;
        }
        
    }
    private void onProductSkuChanged(ProductSkuDto productSku)
    {
        selectedProductSku = null;
        if (productSku != null && productSku.Id != Guid.Empty)
        {
            // selectedProduct = productSku;
            selectedProductSku = productSku;
        }
        
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
