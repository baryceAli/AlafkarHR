@layout AdminLayout
@page "/Inventory/Operations/StockRelease"


@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Inventory.Enums
@using SharedWithUI.Permissions


@inject IInventoryService InventoryService
@inject IWarehouseService WarehouseService
@inject IBatchService BatchService
@inject IProductService ProductService
@inject ICurrencyService CurrencyService

@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.InventoryPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="operation-page" dir="@SharedDataService.PageDirection">
    <div class="operation-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@SharedDataService.SelectViewLang("Inventory Operations", "عمليات المخزون")</div>
            <h3 class="mb-1">@SharedDataService.SelectViewLang("Stock Release", "إطلاق مخزون")</h3>
            <div class="text-muted">@SharedDataService.SelectViewLang("Release reserved stock back into available inventory.", "إطلاق المخزون المحجوز وإعادته إلى الكمية المتاحة.")</div>
        </div>

        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
            <i class="bi bi-arrow-counterclockwise"></i>
            @SharedDataService.SelectViewLang("Reset", "إعادة تعيين")
        </button>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="operation-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">@SharedDataService.SelectViewLang("Stock Selection", "اختيار المخزون")</h5>
                        <div class="text-muted small">@SharedDataService.SelectViewLang("Choose the warehouse, product, SKU, and batch before loading reserved stock.", "اختر المستودع والمنتج والمنتج المخزني والدفعة قبل عرض المخزون المحجوز.")</div>
                    </div>
                    <button class="btn btn-primary" @onclick="onShow">
                        <i class="bi bi-search"></i>
                        @SharedDataService.SelectViewLang("Show", "عرض")
                    </button>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("Warehouse", "المستودع")</label>
                        <AutoCompleteComponent TItem="WarehouseDto"
                                               Items="warehouses"
                                               Value="selectedWarehouse"
                                               ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                               PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse","اختر مستودع")"
                                               ValueChanged="onWarehouseChanged" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                        <AutoCompleteComponent TItem="ProductDto"
                                               Items="products"
                                               Value="selectedProduct"
                                               ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                               PlaceHolder="@SharedDataService.SelectViewLang("Select product","اختر منتج")"
                                               ValueChanged="onProductChanged" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("SKU", "المنتج المخزني")</label>
                        <AutoCompleteComponent TItem="ProductSkuDto"
                                               Items="productSkus"
                                               Value="selectedProductSku"
                                               ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                               PlaceHolder="@SharedDataService.SelectViewLang("Select product sku","اختر منتج مخزني")"
                                               ValueChanged="onProductSkuChanged" />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("Batch", "الدفعة")</label>
                        <AutoCompleteComponent TItem="BatchDto"
                                               Items="batches"
                                               Value="selectedBatch"
                                               ItemText='(p=> p.BatchNumber)'
                                               PlaceHolder="@SharedDataService.SelectViewLang("Select batch","اختر دفعة")"
                                               ValueChanged="onBatchChanged" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (inventory != null && inventory.Id != Guid.Empty)
    {
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <div class="operation-stat border-primary">
                    <div class="operation-stat-icon text-primary"><i class="bi bi-box-seam"></i></div>
                    <div>
                        <div class="text-muted small">@SharedDataService.SelectViewLang("Total Quantity", "إجمالي الكمية")</div>
                        <div class="operation-stat-value">@inventory.TotalQuantity</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="operation-stat border-warning">
                    <div class="operation-stat-icon text-warning"><i class="bi bi-lock"></i></div>
                    <div>
                        <div class="text-muted small">@SharedDataService.SelectViewLang("Reserved Quantity", "الكمية المحجوزة")</div>
                        <div class="operation-stat-value">@inventory.TotalReserved</div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="operation-stat border-success">
                    <div class="operation-stat-icon text-success"><i class="bi bi-check2-circle"></i></div>
                    <div>
                        <div class="text-muted small">@SharedDataService.SelectViewLang("Available Quantity", "الكمية المتاحة")</div>
                        <div class="operation-stat-value">@inventory.TotalAvailable</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <EditForm Model="createInventoryAggregateDto" OnValidSubmit="() => SaveInventory(createInventoryAggregateDto)">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="operation-panel">
                        <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                            <div>
                                <h5 class="mb-1">@SharedDataService.SelectViewLang("Release Details", "تفاصيل الإطلاق")</h5>
                                <div class="text-muted small">@SharedDataService.SelectViewLang("Enter the quantity to release and its valuation.", "أدخل الكمية المراد إطلاقها وتقييمها.")</div>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                    @SharedDataService.SelectViewLang("Cancel", "إلغاء")
                                </button>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-check2"></i>
                                    @SharedDataService.SelectViewLang("Save", "حفظ")
                                </button>
                            </div>
                        </div>

                        <div class="row g-3">
                            @if (selectedProductSku?.Packages.Any() == true)
                            {
                                <div class="col-md-4">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Package", "العبوة")</label>
                                    <select class="form-select" value="@createInventoryAggregateDto.ProductPackageId" @onchange="OnPackageChanged">
                                        <option value="">@SharedDataService.SelectViewLang("Base quantity", "كمية أساسية")</option>
                                        @foreach (var package in selectedProductSku.Packages)
                                        {
                                            <option value="@package.Id">
                                                @SharedDataService.SelectViewLang(package.NameEng, package.Name) (@package.Quantity)
                                            </option>
                                        }
                                    </select>
                                </div>
                            }

                            <div class="col-md-4">
                                <label class="form-label">
                                    @(createInventoryAggregateDto.ProductPackageId.HasValue
                                        ? SharedDataService.SelectViewLang("Package Quantity", "كمية العبوة")
                                        : SharedDataService.SelectViewLang("SKU Quantity", "كمية المنتج المخزني"))
                                </label>
                                <InputNumber class="form-control"
                                             Value="createInventoryAggregateDto.InitialQuantity"
                                             TValue="decimal"
                                             ValueChanged="OnQuantityChanged"
                                             ValueExpression="() => createInventoryAggregateDto.InitialQuantity" />
                            </div>

                            @if (createInventoryAggregateDto.ProductPackageId.HasValue)
                            {
                                <div class="col-md-4">
                                    <label class="form-label">@SharedDataService.SelectViewLang("SKU Quantity", "كمية المنتج المخزني")</label>
                                    <input class="form-control" value="@GetNormalizedQuantity(createInventoryAggregateDto.InitialQuantity)" disabled />
                                </div>
                            }

                            <div class="col-md-4">
                                <label class="form-label">@SharedDataService.SelectViewLang("Unit Cost", "سعر الوحدة")</label>
                                <InputNumber class="form-control"
                                             Value="createInventoryAggregateDto.UnitCost"
                                             TValue="decimal"
                                             ValueChanged="OnUnitCostChanged"
                                             ValueExpression="() => createInventoryAggregateDto.UnitCost" />
                                <ValidationMessage For="() => createInventoryAggregateDto.UnitCost" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">@SharedDataService.SelectViewLang("Total Cost", "السعر الاجمالي")</label>
                                <InputNumber class="form-control" disabled="true" @bind-Value="createInventoryAggregateDto.TotalCost" />
                                <ValidationMessage For="() => createInventoryAggregateDto.TotalCost" />
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">@SharedDataService.SelectViewLang("Currency", "العملة")</label>
                                <AutoCompleteComponent TItem="CurrencyDto"
                                                       Items="currencies"
                                                       Value="selectedCurrency"
                                                       ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select Currency","اختر العملة")"
                                                       ValueChanged="onCurrencyChanged" />
                            </div>

                            <div class="col-md-12">
                                <label class="form-label">@SharedDataService.SelectViewLang("Notes", "ملاحظات")</label>
                                <InputTextArea class="form-control" rows="3" @bind-Value="createInventoryAggregateDto.Notes" />
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>
    }
</div>

<style>
    .operation-page { max-width: 1400px; }
    .operation-header { align-items: flex-start; display: flex; gap: 1rem; justify-content: space-between; }
    .operation-panel { background: var(--erp-surface); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); padding: 1rem; }
    .operation-stat { align-items: center; background: var(--erp-surface); border-inline-start: 4px solid; border-radius: var(--erp-radius-lg); box-shadow: var(--erp-shadow-sm); display: flex; gap: 0.875rem; min-height: 88px; padding: 1rem; }
    .operation-stat-icon { align-items: center; background: var(--erp-surface-muted); border-radius: var(--erp-radius-lg); display: inline-flex; font-size: 1.35rem; height: 44px; justify-content: center; width: 44px; }
    .operation-stat-value { color: var(--erp-text); font-size: 1.35rem; font-weight: 700; line-height: 1.15; }
    [dir="rtl"] .operation-stat { border-inline-start: 0; border-inline-end: 4px solid; }
    @@media (max-width: 767.98px) {
        .operation-header { flex-direction: column; }
    }
</style>

@code {

    private CreateInventoryAggregateDto createInventoryAggregateDto = new CreateInventoryAggregateDto();
    private InventoryAggregateDto inventory = new InventoryAggregateDto();
    private List<BatchDto> allBatches = new();
    private List<BatchDto> batches = new();
    private BatchDto? selectedBatch;

    private List<ProductDto> products = [];
    private ProductDto? selectedProduct;

    private List<WarehouseDto> warehouses = [];
    private WarehouseDto? selectedWarehouse;

    private List<ProductSkuDto> productSkus = [];
    private ProductSkuDto? selectedProductSku;

    private List<CurrencyDto> currencies = [];
    private CurrencyDto? selectedCurrency;

    private Guid companyId;

    private AuthenticationState AuthState;

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (prodRes.IsSuccess)
        {
            products = prodRes.Data?.Data?.ToList() ?? [];
        }
        var wareRes = await WarehouseService.GetAsync(companyId, 0, 10000);
        if (wareRes.IsSuccess)
        {
            warehouses = wareRes.Data?.Data?.ToList() ?? [];
        }

        var batchRes = await BatchService.GetAsync(companyId, 0, 10000);
        if (batchRes.IsSuccess)
        {
            allBatches = batchRes.Data?.Data?.ToList() ?? [];
        }


        var curRes = await CurrencyService.GetAsync(companyId, 0, 10000);
        if (curRes.IsSuccess)
        {
            currencies = curRes.Data?.Data?.ToList() ?? [];
            selectedCurrency = currencies.FirstOrDefault(c => c.IsDefault);

        }

        // createInventoryAggregateDto = new CreateInventoryAggregateDto()
        // {
        //     // Id = Guid.NewGuid(),
        //     CompanyId = companyId,
        //     InitialQuantity = 0,
        //     Currency = selectedCurrency?.Id ?? null
        // };


    }
    async Task onShow()
    {
        inventory = new InventoryAggregateDto();
        if (selectedWarehouse == null || selectedWarehouse.Id == Guid.Empty)
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Stock Release", "إطلاق مخزون"),
                Message = SharedDataService.SelectViewLang("You should select a warehouse", "يرجى اختيار مستودع"),
                IsError = true,
                OnOk = async () => { }
            });
            return;
        }

        if (selectedProductSku == null || selectedProductSku.Id == Guid.Empty)
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Stock Release", "إطلاق مخزون"),
                Message = SharedDataService.SelectViewLang("You should select a sku", "يرجى اختيار منتج مخزني"),
                IsError = true,
                OnOk = async () => { }
            });
            return;
        }


        if (selectedBatch == null || selectedBatch.Id == Guid.Empty)
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Stock Release", "إطلاق مخزون"),
                Message = SharedDataService.SelectViewLang("You should select a batch", "يرجى اختيار دفعة"),
                IsError = true,
                OnOk = async () => { }
            });
            return;
        }
        var invRes = await InventoryService.GetByWarehouseAndSkuAsync(selectedWarehouse.Id, selectedProductSku.Id);
        if (invRes.IsSuccess)
        {
            inventory = invRes.Data;
            createInventoryAggregateDto = new CreateInventoryAggregateDto
            {

                WarehouseId = inventory.WarehouseId,
                ProductId = inventory.ProductId,
                ProductSkuId = inventory.ProductSkuId,
                InitialBatchId = selectedBatch.Id,
                  CurrencyId = selectedCurrency.Id,
                InitialQuantity = 0,
                MovementType = MovementType.ReleaseAmount,
                TotalCost = 0,
                UnitCost = selectedProductSku.Price,
                CompanyId = inventory.CompanyId,
            };
        }
    }
    async Task SaveInventory(CreateInventoryAggregateDto createInventory)
    {
        if (GetNormalizedQuantity(createInventory.InitialQuantity)>inventory.TotalReserved)
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Stock Release", "إطلاق مخزون"),
                Message = SharedDataService.SelectViewLang("Quantity to release is greator than reserved amount", "الكمية المراد اطلاقها اكثر من الكمية المحجوزة"),
                IsError = true,
                OnOk = async () => { }
            });
            return;
        }
        
        LoadingService.Show();
        var bResponse = await InventoryService.ReleaseAsync(createInventory);
        if (bResponse.IsSuccess)
        {
            //show success
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Operation has been done successfully", "تمت العملية بنجاح"),
                Type = "success"
            });
            Reset();
        }
        else
        {
            LoadingService.Hide();
            // how fail
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                Type = "error"
            });
        }

        LoadingService.Hide();


    }

    private void onProductChanged(ProductDto product)
    {
        selectedProduct = null;
        productSkus = [];
        batches = [];
        inventory = new InventoryAggregateDto();
        if (product != null && product.Id != Guid.Empty)
        {

            selectedProduct = product;
            createInventoryAggregateDto.ProductId = product.Id;
            productSkus = product.Skus;
        }
    }
    private void onProductSkuChanged(ProductSkuDto productSku)
    {
        selectedProductSku = null;
        batches = [];
        inventory = new InventoryAggregateDto();
        createInventoryAggregateDto.ProductPackageId = null;
        if (productSku != null && productSku.Id != Guid.Empty)
        {
            // selectedProduct = productSku;
            selectedProductSku = productSku;
            createInventoryAggregateDto.ProductSkuId = productSku.Id;
            batches = new List<BatchDto>
            (allBatches.Where(b => b.ProductSkuId == productSku.Id));
        }

    }
    private void onWarehouseChanged(WarehouseDto warehouse)
    {
        selectedWarehouse = null;
        inventory = new InventoryAggregateDto();
        if (warehouse != null && warehouse.Id != Guid.Empty)
        {
            selectedWarehouse = warehouse;
            createInventoryAggregateDto.WarehouseId = warehouse.Id;
        }
    }
    private void onBatchChanged(BatchDto batch)
    {
        selectedBatch = null;
        inventory = new InventoryAggregateDto();
        if (batch != null && batch.Id != Guid.Empty)
        {
            selectedBatch = batch;
            createInventoryAggregateDto.InitialBatchId = batch.Id;
        }
    }

    private void onCurrencyChanged(CurrencyDto currency)
    {
        selectedCurrency = null;
        if (currency != null && currency.Id != Guid.Empty)
        {
            selectedCurrency = currency;
            createInventoryAggregateDto.CurrencyId = currency.Id;
        }
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
    private void CancelEdit()
    {
        Reset();
    }
    private void Reset()
    {
        onWarehouseChanged(null);
        onProductChanged(null);
        onProductSkuChanged(null);
        onBatchChanged(null);
        createInventoryAggregateDto = new CreateInventoryAggregateDto()
        {
            // Id = Guid.NewGuid(),
            CompanyId = companyId,
            InitialQuantity = 0,

        };
        createInventoryAggregateDto.CompanyId = companyId;

    }
    private void OnQuantityChanged(decimal value)
    {
        createInventoryAggregateDto.InitialQuantity = value;
        RecalculateTotalCost();
    }

    private void OnUnitCostChanged(decimal value)
    {
        createInventoryAggregateDto.UnitCost = value;
        RecalculateTotalCost();
    }

    private void RecalculateTotalCost()
    {
        createInventoryAggregateDto.TotalCost =
            GetNormalizedQuantity(createInventoryAggregateDto.InitialQuantity) * createInventoryAggregateDto.UnitCost;
        StateHasChanged();
    }

    private void OnPackageChanged(ChangeEventArgs args)
    {
        createInventoryAggregateDto.ProductPackageId = Guid.TryParse(args.Value?.ToString(), out var packageId)
            ? packageId
            : null;

        RecalculateTotalCost();
    }

    private decimal GetNormalizedQuantity(decimal quantity)
    {
        if (!createInventoryAggregateDto.ProductPackageId.HasValue || selectedProductSku is null)
        {
            return quantity;
        }

        var selectedPackage = selectedProductSku.Packages.FirstOrDefault(p => p.Id == createInventoryAggregateDto.ProductPackageId.Value);
        return selectedPackage is null ? quantity : quantity * selectedPackage.Quantity;
    }
    private static readonly List<MovementType> StockInMovementTypes =
    [
        MovementType.ReserveAmount,
        MovementType.AdjustmentIncrease,
    ];
    private string GetMovementTypeDisplay(MovementType movementType)
    {
        return movementType switch
        {
            MovementType.OpeningBalance => SharedDataService.SelectViewLang("Opening Balance", "الرصيد الافتتاحي"),
            MovementType.AdjustmentDecrease => SharedDataService.SelectViewLang("Adjustment Decrease", "تسوية بالخفض"),
            MovementType.AdjustmentIncrease => SharedDataService.SelectViewLang("Adjustment Increase", "تسوية بالزيادة"),
            MovementType.ProductionIn => SharedDataService.SelectViewLang("Production In", "إنتاج وارد"),
            MovementType.ProductionOut => SharedDataService.SelectViewLang("Production Out", "إنتاج صادر"),
            MovementType.ReleaseAmount => SharedDataService.SelectViewLang("Release Amount", "إلغاء حجز كمية"),
            MovementType.ReserveAmount => SharedDataService.SelectViewLang("Reserve Amount", "حجز كمية"),
            MovementType.SalesShipment => SharedDataService.SelectViewLang("Sales Shipment", "شحنة مبيعات"),
            MovementType.CustomerReturn => SharedDataService.SelectViewLang("Customer Return", "إرجاع من العميل"),
            MovementType.SupplierReturn => SharedDataService.SelectViewLang("Supplier Return", "إرجاع إلى المورد"),
            MovementType.PurchaseReceipt => SharedDataService.SelectViewLang("Purchase Receipt", "شراء بضاعة"),
            MovementType.TransferIn => SharedDataService.SelectViewLang("Transfer In", "تحويل وارد"),
            MovementType.TransferOut => SharedDataService.SelectViewLang("Transfer Out", "تحويل صادر"),
            _ => movementType.ToString()
        };
    }

}
