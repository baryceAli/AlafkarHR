@layout AdminLayout
@page "/Inventory/WarehouseTransfer/Form"
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions

@inject IWarehouseService WarehouseService
@inject IProductService ProductService
@inject IBranchService BranchService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BatchPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Warehouse Transfer", "تحويل مخزون")"
                Subtitle="@SharedDataService.SelectViewLang("Select source and destination warehouses, then choose the product and SKU to transfer.", "اختر المستودع المصدر والمستودع الوجهة ثم المنتج والمنتج المخزني المراد تحويله.")"
                Overline="@SharedDataService.SelectViewLang("Inventory Operations", "عمليات المخزون")"
                Icon="bi-arrow-left-right">
        <Actions>
            <a class="btn btn-outline-secondary" href="/Inventories/List">
                <i class="bi bi-boxes"></i>
                @SharedDataService.SelectViewLang("Current Stock", "المخزون الحالي")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Transfer Details", "تفاصيل التحويل")"
             Subtitle="@SharedDataService.SelectViewLang("This form keeps the current selection workflow while using the new ERP layout.", "يحافظ هذا النموذج على سير الاختيار الحالي ضمن تصميم ERP الجديد.")"
             CssClass="allow-overflow">
        <EditForm Model="warehouseTransfer">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">@SharedDataService.SelectViewLang("Source warehouse", "المستودع المحول منه")</label>
                    <AutoCompleteComponent TItem="WarehouseDto"
                                           Items="warehouses"
                                           Value="selectedSourceWarehouse"
                                           ItemText="WarehouseText"
                                           PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse","اختر مستودع")"
                                           ValueChanged="onSourceWarehouseSelected" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">@SharedDataService.SelectViewLang("Destination warehouse", "المستودع المحول إليه")</label>
                    <AutoCompleteComponent TItem="WarehouseDto"
                                           Items="warehouses"
                                           Value="selectedDestinationWarehouse"
                                           ItemText="WarehouseText"
                                           PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse","اختر مستودع")"
                                           ValueChanged="onDestinationWarehouseSelected" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                    <AutoCompleteComponent TItem="ProductDto"
                                           Items="products"
                                           Value="selectedProduct"
                                           ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                           PlaceHolder="@SharedDataService.SelectViewLang("Select product","اختر منتج")"
                                           ValueChanged="onProductSelected" />
                </div>

                <div class="col-md-6">
                    <label class="form-label">@SharedDataService.SelectViewLang("Product Sku", "المنتج المخزني")</label>
                    <AutoCompleteComponent TItem="ProductSkuDto"
                                           Items="productSkus"
                                           Value="selectedProductSku"
                                           ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                           PlaceHolder="@SharedDataService.SelectViewLang("Select product sku","اختر منتج مخزني")"
                                           ValueChanged="onProductSkuSelected" />
                </div>

                <div class="col-12 d-flex justify-content-end gap-2">
                    <button type="button" class="btn btn-outline-secondary" @onclick="ResetSelection">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        @SharedDataService.SelectViewLang("Reset", "إعادة تعيين")
                    </button>
                </div>
            </div>
        </EditForm>
    </AppCard>
</div>
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@code {
    private WarehouseTransferDto warehouseTransfer = new();
    private List<WarehouseDto> warehouses = [];
    private WarehouseDto? selectedSourceWarehouse;
    private WarehouseDto? selectedDestinationWarehouse;
    private List<ProductDto> products = [];
    private ProductDto? selectedProduct;
    private List<ProductSkuDto> productSkus = [];
    private ProductSkuDto? selectedProductSku;
    private List<BranchDto> branches = [];
    private CurrentUserBranchAccessDto branchAccess = new();
    private Guid companyId;
    private AuthenticationState AuthState;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadBranchAccessAsync();
        var wareRes = await WarehouseService.GetAsync(companyId, 0, 10000);
        if (wareRes.IsSuccess)
        {
            var loadedWarehouses = wareRes.Data?.Data?.ToList() ?? [];
            warehouses = branchAccess.CanViewAllBranches
                ? loadedWarehouses
                : loadedWarehouses
                    .Where(warehouse => warehouse.BranchId == null || (warehouse.BranchId.HasValue && branchAccess.BranchIds.Contains(warehouse.BranchId.Value)))
                    .ToList();
            ClearInaccessibleWarehouseSelections();
        }

        var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (prodRes.IsSuccess)
        {
            products = prodRes.Data?.Data?.ToList() ?? [];
        }


    }
    private void onSourceWarehouseSelected(WarehouseDto source)
    {
        selectedSourceWarehouse = null;
        if (source != null)
        {
            selectedSourceWarehouse = source;
        }
    }
    private void onDestinationWarehouseSelected(WarehouseDto destination)
    {
        selectedDestinationWarehouse = null;
        if (destination != null)
        {
            selectedDestinationWarehouse = destination;
        }
    }
    private void onProductSelected(ProductDto product)
    {
        selectedProduct = null;
        productSkus = [];
        if (product != null)
        {
            selectedProduct = product;
            productSkus = product.Skus;
        }
    }

    private void onProductSkuSelected(ProductSkuDto sku)
    {
        selectedProductSku = null;
        if (sku != null)
        {
            selectedProductSku = sku;
        }
    }

    private void ResetSelection()
    {
        selectedSourceWarehouse = null;
        selectedDestinationWarehouse = null;
        selectedProduct = null;
        selectedProductSku = null;
        productSkus = [];
    }

    private async Task LoadBranchAccessAsync()
    {
        var accessResponse = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        branchAccess = accessResponse.IsSuccess ? accessResponse.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();

        var branchResponse = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = branchResponse.IsSuccess ? branchResponse.Data?.Data?.ToList() ?? [] : [];
    }

    private void ClearInaccessibleWarehouseSelections()
    {
        if (selectedSourceWarehouse is not null && warehouses.All(x => x.Id != selectedSourceWarehouse.Id))
        {
            selectedSourceWarehouse = null;
            ToastService.ShowWarning(SharedDataService.SelectViewLang(
                "The selected source warehouse is no longer accessible.",
                "المستودع المصدر المحدد لم يعد متاحاً."));
        }

        if (selectedDestinationWarehouse is not null && warehouses.All(x => x.Id != selectedDestinationWarehouse.Id))
        {
            selectedDestinationWarehouse = null;
            ToastService.ShowWarning(SharedDataService.SelectViewLang(
                "The selected destination warehouse is no longer accessible.",
                "المستودع الوجهة المحدد لم يعد متاحاً."));
        }
    }

    private string WarehouseText(WarehouseDto warehouse)
    {
        var name = SharedDataService.SelectViewLang(warehouse.NameEng, warehouse.Name);
        var scope = warehouse.BranchId.HasValue
            ? BranchName(warehouse.BranchId.Value)
            : SharedDataService.SelectViewLang("Company", "الشركة");
        return $"{name} - {scope}";
    }

    private string BranchName(Guid branchId)
    {
        var branch = branches.FirstOrDefault(x => x.Id == branchId);
        return branch is null
            ? branchId.ToString("N")
            : SharedDataService.SelectViewLang(branch.NameEng, branch.Name);
    }

    protected override void OnInitialized()
    {
        NavigationManager.NavigateTo("/Inventory/Transfers", replace: true);
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
