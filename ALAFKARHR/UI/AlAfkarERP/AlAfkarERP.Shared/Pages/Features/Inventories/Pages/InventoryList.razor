@layout AdminLayout
@page "/Inventories/List"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions


@inject IInventoryService InventoryService
@inject IWarehouseService WarehouseService
@inject IBatchService BatchService
@inject IProductService ProductService
@inject IBranchService BranchService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.InventoryPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Current Stock", "المخزون الحالي")"
                Subtitle="@SharedDataService.SelectViewLang("Review warehouse balances by product, SKU, reserved quantity, and available quantity.", "مراجعة أرصدة المستودعات حسب المنتج والمنتج المخزني والكمية المحجوزة والمتاحة.")"
                Overline="@SharedDataService.SelectViewLang("Inventory", "المخزون")"
                Icon="bi-boxes">
        <Actions>
            <a class="btn btn-outline-secondary" href="/Inventory/Operations/StockIn">
                <i class="bi bi-plus-circle"></i>
                @SharedDataService.SelectViewLang("Stock In", "مخزون وارد")
            </a>
            <a class="btn btn-outline-secondary" href="/Inventory/Operations/StockOut">
                <i class="bi bi-dash-circle"></i>
                @SharedDataService.SelectViewLang("Stock Out", "مخزون صادر")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Stock Balances", "أرصدة المخزون")"
             Subtitle="@SharedDataService.SelectViewLang("Press Enter in search to reload matching stock records.", "اضغط Enter في البحث لإعادة تحميل سجلات المخزون المطابقة.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
                <div class="input-group erp-filter-search">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search stock...", "ابحث في المخزون...")"
                           @bind="searchText"
                           @onkeyup="HandleSearch" />
                </div>
            </ChildContent>
            <Actions>
                <TableExportActions Title="@SharedDataService.SelectViewLang("Stock Balances", "أرصدة المخزون")"
                                    FileName="inventory-stock-balances.xls" />
                <select class="form-select erp-page-size-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

        <div class="erp-table-wrap has-mobile-cards">
            <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick='() => Sort(SharedDataService.Language == "Ar" ? nameof(InventoryAggregateDto.WarehouseName) : nameof(InventoryAggregateDto.WarehouseNameEng))'>
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Warehouse", "المستودع")
                </th>

                <th @onclick='() => Sort(SharedDataService.Language == "Ar" ? nameof(InventoryAggregateDto.ProductName) : nameof(InventoryAggregateDto.ProductNameEng))'>
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Product", "المنتج")
                </th>
                <th @onclick='() => Sort(SharedDataService.Language == "Ar" ? nameof(InventoryAggregateDto.ProductSkuName) : nameof(InventoryAggregateDto.ProductSkuNameEng))'>
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Product Sku", "المنتج المخزني")
                </th>
                
                <th @onclick="() => Sort(nameof(InventoryAggregateDto.TotalQuantity))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Total Quantity", "إجمالي الكمية")
                </th>
                <th @onclick="() => Sort(nameof(InventoryAggregateDto.TotalReserved))">@SharedDataService.SelectViewLang("Total Reserved", "إجمالي المحجوز")</th>
                <th @onclick="() => Sort(nameof(InventoryAggregateDto.TotalAvailable))">@SharedDataService.SelectViewLang("Total Available", "إجمالي المتاح")</th>
                @* <th></th> *@
            </tr>
        </thead>
        <tbody>
            
            @if (editingInventoryId != null)
            {
                var editingItem = inventories.FirstOrDefault(x => x.Id == editingInventoryId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveInventory(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                <div class="p-3">
                                    <div class="mb-3">
                                        <div class="fw-semibold">@SharedDataService.SelectViewLang("Opening Balance", "رصيد افتتاحي")</div>
                                        <div class="text-muted small">@SharedDataService.SelectViewLang("Select stock identity and quantity before saving.", "حدد بيانات المخزون والكمية قبل الحفظ.")</div>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Warehouse", "المستودع")</label>
                                            <AutoCompleteComponent TItem="WarehouseDto"
                                                                   Items="warehouses"
                                                                   Value="selectedWarehouse"
                                               ItemText="WarehouseText"
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse","اختر مستودع")"
                                                                   ValueChanged="onWarehouseChanged" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                                            <AutoCompleteComponent TItem="ProductDto"
                                                                   Items="products"
                                                                   Value="selectedProduct"
                                                                   ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product","اختر منتج")"
                                                                   ValueChanged="onProductChanged" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("SKU", "المنتج المخزني")</label>
                                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                                   Items="productSkus"
                                                                   Value="selectedProductSku"
                                                                   ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product sku","اختر منتج مخزني")"
                                                                   ValueChanged="onProductSkuChanged" />
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">@SharedDataService.SelectViewLang("Batch", "الدفعة")</label>
                                            <AutoCompleteComponent TItem="BatchDto"
                                                                   Items="batches"
                                                                   Value="selectedBatch"
                                                                   ItemText='(p=> p.BatchNumber)'
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select batch","اختر دفعة")"
                                                                   ValueChanged="onBatchChanged" />
                                        </div>

                                        @if (selectedProductSku?.Packages.Any() == true)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">@SharedDataService.SelectViewLang("Package", "العبوة")</label>
                                                <select class="form-select" value="@selectedProductPackageId" @onchange="OnPackageChanged">
                                                    <option value="">@SharedDataService.SelectViewLang("Base quantity", "كمية أساسية")</option>
                                                    @foreach (var package in selectedProductSku.Packages)
                                                    {
                                                        <option value="@package.Id">
                                                            @SharedDataService.SelectViewLang(package.NameEng, package.Name) (@package.Quantity)
                                                        </option>
                                                    }
                                                </select>
                                            </div>
                                        }

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                @(selectedProductPackageId.HasValue
                                                    ? SharedDataService.SelectViewLang("Package Quantity", "كمية العبوة")
                                                    : SharedDataService.SelectViewLang("SKU Quantity", "كمية المنتج المخزني"))
                                            </label>
                                            <InputNumber class="form-control" @bind-Value="editingItem.TotalQuantity" />
                                            <ValidationMessage For="() => editingItem.TotalQuantity" />
                                        </div>

                                        @if (selectedProductPackageId.HasValue)
                                        {
                                            <div class="col-md-4">
                                                <label class="form-label">@SharedDataService.SelectViewLang("SKU Quantity", "كمية المنتج المخزني")</label>
                                                <input class="form-control" value="@GetNormalizedQuantity(editingItem.TotalQuantity)" disabled />
                                            </div>
                                        }

                                        <div class="col-12 d-flex justify-content-end gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit">@SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                            <button type="submit" class="btn btn-success btn-sm">@SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        </div>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            
            @foreach (var inventory in ProcessedInventory.Where(x => x.Id != editingInventoryId))
            {
                
                <tr>
                    <td>
                        @WarehouseName(inventory)
                    </td>
                    <td>
                        @SharedDataService.SelectViewLang(inventory.ProductNameEng, inventory.ProductName)
                    </td>
                    <td>
                        @SharedDataService.SelectViewLang(inventory.ProductSkuNameEng, inventory.ProductSkuName)
                    </td>
                    <td>@inventory.TotalQuantity</td>
                    <td>@inventory.TotalReserved</td>
                    <td>@inventory.TotalAvailable</td>
                    @*
                    <td>
                            <button class="btn btn-warning btn-sm"
                                @onclick="() => EditInventory(inventory.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.InventoryPermissions.Edit}"))>
                            @SharedDataService.SelectViewLang("Edit", "تعديل")
                        </button>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeleteInventory(inventory)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.InventoryPermissions.Delete}"))>
                            @SharedDataService.SelectViewLang("Delete", "حذف")
                        </button> 
                    </td>
                        *@
                </tr>
                
            }
            </tbody>
        </table>
        </div>

        <div class="erp-list-card-grid">
            @foreach (var inventory in ProcessedInventory.Where(x => x.Id != editingInventoryId))
            {
                <article class="erp-mobile-list-card">
                    <div>
                        <div class="erp-mobile-list-card-meta">
                            <StatusChip Text="@WarehouseName(inventory)" Tone="primary" />
                        </div>
                        <h2 class="erp-mobile-list-card-title">
                            @SharedDataService.SelectViewLang(inventory.ProductNameEng, inventory.ProductName)
                        </h2>
                        <div class="text-muted small">
                            @SharedDataService.SelectViewLang(inventory.ProductSkuNameEng, inventory.ProductSkuName)
                        </div>
                    </div>
                    <div class="erp-mobile-list-card-metrics">
                        <div class="erp-mobile-list-card-metric">
                            <small>@SharedDataService.SelectViewLang("Total", "الإجمالي")</small>
                            <strong>@inventory.TotalQuantity</strong>
                        </div>
                        <div class="erp-mobile-list-card-metric">
                            <small>@SharedDataService.SelectViewLang("Reserved", "المحجوز")</small>
                            <strong>@inventory.TotalReserved</strong>
                        </div>
                        <div class="erp-mobile-list-card-metric">
                            <small>@SharedDataService.SelectViewLang("Available", "المتاح")</small>
                            <strong>@inventory.TotalAvailable</strong>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (!ProcessedInventory.Any() && editingInventoryId == null)
        {
            <EmptyState Icon="bi-boxes"
                        Title="@SharedDataService.SelectViewLang("No stock records found", "لا توجد سجلات مخزون")"
                        Message="@SharedDataService.SelectViewLang("Adjust search or receive stock to create inventory balances.", "عدل البحث أو استلم مخزونا لإنشاء أرصدة.")" />
        }

    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        @* <span class="mx-3">Page @(pageIndex + 1) of @TotalPages @(TotalPages == 1 ? "" : "Pages")</span> *@
        <span class="mx-3">
            @SharedDataService.SelectViewLang("Page", "صفحة") @(TotalPages == 0 ? 0 : pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages
        </span>
        @* <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            Next
        </button> *@
        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>
    </div>
    </AppCard>
</div>

