        {
            Id = Guid.NewGuid(),
            TotalQuantity = 0,

        };
        newItem.CompanyId = companyId;
        inventories.Insert(0, newItem);
        editingInventoryId = newItem.Id;
        isEdit = false;
    }

    void EditInventory(Guid id)
    {
        editingInventoryId = id;
        var inventory = inventories.FirstOrDefault(b => b.Id == id);
        selectedProduct = products.FirstOrDefault(p => p.Id == inventory.ProductId);
        // onProductChanged(selectedProduct);
        selectedProductSku = selectedProduct.Skus.FirstOrDefault(sku => sku.Id == inventory.ProductSkuId);
        batches = new List<BatchDto>(allBatches.Where(b => b.ProductSkuId == inventory.ProductSkuId));
        selectedBatch = batches.FirstOrDefault(b => inventory.Batches.Any(ib => ib.BatchId == b.Id));
        isEdit = true;
        StateHasChanged();
    }
