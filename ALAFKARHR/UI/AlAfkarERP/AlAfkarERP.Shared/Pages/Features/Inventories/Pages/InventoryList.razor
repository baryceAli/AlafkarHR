    private void onProductChanged(ProductDto product)
    {
        selectedProduct = null;
        productSkus = [];
        batches = [];
        if (product != null && product.Id != Guid.Empty)
        {

            selectedProduct = product;
            productSkus = product.Skus;
        }
    }
    private void onProductSkuChanged(ProductSkuDto productSku)
    {
        selectedProductSku = null;
        selectedProductPackageId = null;
        batches = [];
        if (productSku != null && productSku.Id != Guid.Empty)
        {
            // selectedProduct = productSku;
            selectedProductSku = productSku;
            batches = new List<BatchDto>(allBatches.Where(b => b.ProductSkuId == productSku.Id));
        }

    }

    private void OnPackageChanged(ChangeEventArgs args)
    {
        selectedProductPackageId = Guid.TryParse(args.Value?.ToString(), out var packageId)
            ? packageId
            : null;
    }

    private decimal GetNormalizedQuantity(decimal quantity)
    {
        if (!selectedProductPackageId.HasValue || selectedProductSku is null)
        {
            return quantity;
        }

        var selectedPackage = selectedProductSku.Packages.FirstOrDefault(p => p.Id == selectedProductPackageId.Value);
        return selectedPackage is null ? quantity : quantity * selectedPackage.Quantity;
    }
    private void onWarehouseChanged(WarehouseDto warehouse)
    {
        selectedWarehouse = null;
        if (warehouse != null && warehouse.Id != Guid.Empty)
        {
            selectedWarehouse = warehouse;
        }
    }

    private async Task LoadBranchAccessAsync()
    {
        var accessResult = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        if (accessResult.IsSuccess && accessResult.Data is not null)
        {
            branchAccess = accessResult.Data;
        }

        var branchesResult = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (branchesResult.IsSuccess)
        {
            branches = branchesResult.Data?.Data?.ToList() ?? [];
        }
    }

    private string WarehouseText(WarehouseDto warehouse)
    {
        var name = SharedDataService.SelectViewLang(warehouse.NameEng, warehouse.Name);
        return warehouse.BranchId.HasValue ? $"{name} - {BranchName(warehouse.BranchId.Value)}" : $"{name} - {SharedDataService.SelectViewLang("Company", "الشركة")}";
    }

    private string WarehouseName(InventoryAggregateDto inventory)
    {
        var warehouse = warehouses.FirstOrDefault(x => x.Id == inventory.WarehouseId);
        return warehouse is null
            ? SharedDataService.SelectViewLang(inventory.WarehouseNameEng, inventory.WarehouseName)
            : WarehouseText(warehouse);
    }

    private string BranchName(Guid branchId)
    {
        var branch = branches.FirstOrDefault(x => x.Id == branchId);
        return branch is null ? branchId.ToString("N")[..8] : SharedDataService.SelectViewLang(branch.NameEng, branch.Name);
    }
    private void onBatchChanged(BatchDto batch)
    {
        selectedBatch = null;
        if (batch != null && batch.Id != Guid.Empty)
        {
            selectedBatch = batch;
        }
    }

