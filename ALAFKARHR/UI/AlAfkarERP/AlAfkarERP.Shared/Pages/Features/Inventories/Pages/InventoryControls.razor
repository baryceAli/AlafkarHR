                    </div>
                </AppCard>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Projected Stock", "المخزون المتوقع")">
                    <div class="erp-table-wrap">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>@SharedDataService.SelectViewLang("On hand", "المتوفر")</th>
                                    <th>@SharedDataService.SelectViewLang("Reserved", "محجوز")</th>
                                    <th>@SharedDataService.SelectViewLang("Incoming", "وارد")</th>
                                    <th>@SharedDataService.SelectViewLang("Forecast", "التوقع")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in projectedStock.Take(50))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@SkuName(row.ProductSkuId)</div>
                                            <div class="text-muted small">@WarehouseName(row.WarehouseId)</div>
                                        </td>
                                        <td>@row.OnHandQuantity</td>
                                        <td>@row.ReservedQuantity</td>
                                        <td>@row.IncomingQuantity</td>
                                        <td>@row.ForecastedQuantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
            <div class="col-xl-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Valuation Layers", "طبقات التقييم")">
                    <div class="erp-table-wrap">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>@SharedDataService.SelectViewLang("Reference", "المرجع")</th>
                                    <th>SKU</th>
                                    <th>@SharedDataService.SelectViewLang("Warehouse", "المستودع")</th>
                                    <th>@SharedDataService.SelectViewLang("Qty", "الكمية")</th>
                                    <th>@SharedDataService.SelectViewLang("Cost", "التكلفة")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in valuationLayers.Take(50))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@row.ReferenceNumber</div>
                                            <div class="text-muted small">@row.SourceDocumentType</div>
