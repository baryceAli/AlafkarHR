@layout AdminLayout
@page "/Inventory/Controls"

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Features.Procurement.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Procurement.Dtos
@using SharedWithUI.Procurement.Enums

@implements IDisposable
@inject IInventoryService InventoryService
@inject IWarehouseService WarehouseService
@inject IBatchService BatchService
@inject IProductService ProductService
@inject IProcurementService ProcurementService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Inventory Controls", "ضوابط المخزون")"
                Subtitle="@SharedDataService.SelectViewLang("Locations, putaway rules, quality inspections, landed costs, valuation, and projected stock.", "المواقع وقواعد التخزين وفحص الجودة والتكاليف المحملة والتقييم والمخزون المتوقع.")"
                Overline="@SharedDataService.SelectViewLang("Inventory", "المخزون")"
                Icon="bi bi-boxes" />

    @if (isLoading)
    {
        <AppCard>
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading inventory controls...", "جاري تحميل ضوابط المخزون...")</div>
            </div>
        </AppCard>
    }
    else
    {
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Location", "الموقع")" CssClass="h-100 allow-overflow">
                    <EditForm Model="location" OnValidSubmit="SaveLocationAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedLocationWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnLocationWarehouseChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Code", "الرمز")" @bind-Value="location.Code" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Arabic name", "الاسم العربي")" @bind-Value="location.Name" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("English name", "الاسم الإنجليزي")" @bind-Value="location.NameEng" />
                            <InputSelect class="form-select" @bind-Value="location.LocationType">
                                @foreach (var value in Enum.GetValues<WarehouseLocationType>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <InputSelect class="form-select" @bind-Value="location.LocationUsage">
                                @foreach (var value in Enum.GetValues<WarehouseLocationUsage>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="location.IsVirtual" />
                                <label class="form-check-label">@SharedDataService.SelectViewLang("Virtual location", "موقع افتراضي")</label>
                            </div>
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="location.ExcludeFromPhysicalStock" />
                                <label class="form-check-label">@SharedDataService.SelectViewLang("Exclude from physical stock", "استبعاد من المخزون الفعلي")</label>
                            </div>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Putaway Rule", "قاعدة التخزين")" CssClass="h-100 allow-overflow">
                    <EditForm Model="putawayRule" OnValidSubmit="SavePutawayRuleAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedPutawayWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnPutawayWarehouseChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedPutawayProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product", "اختر المنتج")"
                                                   ValueChanged="OnPutawayProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="putawaySkus"
                                                   Value="selectedPutawaySku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU", "اختر المنتج المخزني")"
                                                   ValueChanged="OnPutawaySkuChanged" />
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="putawayLocations"
                                                   Value="selectedPutawayDestinationLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select destination location", "اختر موقع التخزين")"
                                                   ValueChanged="OnPutawayDestinationLocationChanged" />
                            <InputSelect class="form-select" @bind-Value="putawayRule.RemovalStrategy">
                                @foreach (var value in Enum.GetValues<RemovalStrategy>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <InputNumber class="form-control" @bind-Value="putawayRule.Priority" placeholder="Priority" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Quality Inspection", "فحص الجودة")" CssClass="h-100 allow-overflow">
                    <EditForm Model="inspection" OnValidSubmit="SaveInspectionAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedInspectionWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnInspectionWarehouseChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedInspectionProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product", "اختر المنتج")"
                                                   ValueChanged="OnInspectionProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="inspectionSkus"
                                                   Value="selectedInspectionSku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU", "اختر المنتج المخزني")"
                                                   ValueChanged="OnInspectionSkuChanged" />
                            <AutoCompleteComponent TItem="BatchDto"
                                                   Items="inspectionBatches"
                                                   Value="selectedInspectionBatch"
                                                   ItemText="BatchText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select batch", "اختر الدفعة")"
                                                   ValueChanged="OnInspectionBatchChanged" />
                            <InputNumber class="form-control" @bind-Value="inspection.Quantity" placeholder="Quantity" />
                            <InputSelect class="form-select" @bind-Value="inspection.Status">
                                @foreach (var value in Enum.GetValues<QualityInspectionStatus>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Result notes", "ملاحظات النتيجة")" @bind-Value="inspection.ResultNotes" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Landed Cost", "التكلفة المحملة")" CssClass="h-100 allow-overflow">
                    <EditForm Model="landedCost" OnValidSubmit="SaveLandedCostAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                   Items="postedGoodsReceipts"
                                                   Value="selectedLandedCostReceipt"
                                                   ItemText="ReceiptText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select goods receipt", "اختر مستند الاستلام")"
                                                   ValueChanged="OnLandedCostReceiptChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Receipt Number", "رقم الاستلام")" @bind-Value="landedCost.SourceDocumentNumber" disabled />
                            <InputSelect class="form-select" @bind-Value="landedCost.AllocationMethod">
                                @foreach (var value in Enum.GetValues<LandedCostAllocationMethod>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <div class="row g-2">
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.FreightAmount" placeholder="Freight" /></div>
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.CustomsAmount" placeholder="Customs" /></div>
                            </div>
                            <div class="row g-2">
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.HandlingAmount" placeholder="Handling" /></div>
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.OtherAmount" placeholder="Other" /></div>
                            </div>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>
            <div class="col-12">
                <AppCard Title="@SharedDataService.SelectViewLang("Recent Cycle Counts", "عمليات الجرد الأخيرة")">
                    <div class="erp-table-wrap">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>@SharedDataService.SelectViewLang("Number", "الرقم")</th>
                                    <th>@SharedDataService.SelectViewLang("Warehouse", "المستودع")</th>
                                    <th>@SharedDataService.SelectViewLang("Location", "الموقع")</th>
                                    <th>@SharedDataService.SelectViewLang("Lines", "البنود")</th>
                                    <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var count in cycleCounts.Take(25))
                                {
                                    <tr>
                                        <td>@count.CountNumber</td>
                                        <td>@WarehouseName(count.WarehouseId)</td>
                                        <td>@LocationName(count.WarehouseLocationId)</td>
                                        <td>@count.Lines.Count</td>
                                        <td>
                                            <StatusChip Text="@(count.IsPosted ? SharedDataService.SelectViewLang("Posted", "Posted") : SharedDataService.SelectViewLang("Draft", "Draft"))"
                                                        Tone="@(count.IsPosted ? "success" : "warning")" />
                                            @*
                                                @(count.IsPosted ? SharedDataService.SelectViewLang("Posted", "مرحل") : SharedDataService.SelectViewLang("Draft", "مسودة"))
                                            *@
                                        </td>
                                        <td class="text-end">
                                            @if (!count.IsPosted)
                                            {
                                                <button class="btn btn-sm btn-primary" type="button" @onclick="() => PostCycleCountAsync(count.Id)">
                                                    <i class="bi bi-check2-circle"></i>
                                                @SharedDataService.SelectViewLang("Post", "ترحيل")
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-4">
                <AppCard Title="@SharedDataService.SelectViewLang("Operation Type", "نوع العملية")" CssClass="h-100 allow-overflow">
                    <EditForm Model="operationType" OnValidSubmit="SaveOperationTypeAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedOperationWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnOperationWarehouseChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Code", "الرمز")" @bind-Value="operationType.Code" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Arabic name", "الاسم العربي")" @bind-Value="operationType.Name" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("English name", "الاسم الإنجليزي")" @bind-Value="operationType.NameEng" />
                            <InputSelect class="form-select" @bind-Value="operationType.OperationKind">
                                @foreach (var value in Enum.GetValues<InventoryOperationKind>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="operationLocations"
                                                   Value="selectedOperationSourceLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Default source", "المصدر الافتراضي")"
                                                   ValueChanged="OnOperationSourceLocationChanged" />
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="operationLocations"
                                                   Value="selectedOperationDestinationLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Default destination", "الوجهة الافتراضية")"
                                                   ValueChanged="OnOperationDestinationLocationChanged" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-4">
                <AppCard Title="@SharedDataService.SelectViewLang("Route", "المسار")" CssClass="h-100 allow-overflow">
                    <EditForm Model="inventoryRoute" OnValidSubmit="SaveRouteAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedRouteWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Optional warehouse", "مستودع اختياري")"
                                                   ValueChanged="OnRouteWarehouseChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedRouteProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Optional product", "منتج اختياري")"
                                                   ValueChanged="OnRouteProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="routeSkus"
                                                   Value="selectedRouteSku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Optional SKU", "وحدة منتج اختيارية")"
                                                   ValueChanged="OnRouteSkuChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Code", "الرمز")" @bind-Value="inventoryRoute.Code" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Arabic name", "الاسم العربي")" @bind-Value="inventoryRoute.Name" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("English name", "الاسم الإنجليزي")" @bind-Value="inventoryRoute.NameEng" />
                            <InputSelect class="form-select" @bind-Value="inventoryRoute.ApplicationScope">
                                @foreach (var value in Enum.GetValues<InventoryRouteApplicationScope>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-4">
                <AppCard Title="@SharedDataService.SelectViewLang("Route Rule", "قاعدة المسار")" CssClass="h-100 allow-overflow">
                    <EditForm Model="routeRule" OnValidSubmit="SaveRouteRuleAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="InventoryRouteDto"
                                                   Items="inventoryRoutes"
                                                   Value="selectedRouteRuleRoute"
                                                   ItemText="RouteText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select route", "اختر المسار")"
                                                   ValueChanged="OnRouteRuleRouteChanged" />
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedRouteRuleWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnRouteRuleWarehouseChanged" />
                            <AutoCompleteComponent TItem="InventoryOperationTypeDto"
                                                   Items="routeRuleOperationTypes"
                                                   Value="selectedRouteRuleOperationType"
                                                   ItemText="OperationTypeText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select operation type", "اختر نوع العملية")"
                                                   ValueChanged="OnRouteRuleOperationTypeChanged" />
                            <InputSelect class="form-select" @bind-Value="routeRule.Action">
                                @foreach (var value in Enum.GetValues<InventoryRouteRuleAction>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="routeRuleLocations"
                                                   Value="selectedRouteRuleSourceLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Source location", "موقع المصدر")"
                                                   ValueChanged="OnRouteRuleSourceLocationChanged" />
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="routeRuleLocations"
                                                   Value="selectedRouteRuleDestinationLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Destination location", "موقع الوجهة")"
                                                   ValueChanged="OnRouteRuleDestinationLocationChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedRouteRuleProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Optional product", "منتج اختياري")"
                                                   ValueChanged="OnRouteRuleProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="routeRuleSkus"
                                                   Value="selectedRouteRuleSku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Optional SKU", "وحدة منتج اختيارية")"
                                                   ValueChanged="OnRouteRuleSkuChanged" />
                            <InputNumber class="form-control" @bind-Value="routeRule.Priority" placeholder="Priority" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-12">
                <AppCard Title="@SharedDataService.SelectViewLang("Route Proposals", "اقتراحات المسارات")" CssClass="allow-overflow">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedProposalWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Warehouse", "المستودع")"
                                                   ValueChanged="OnProposalWarehouseChanged" />
                        </div>
                        <div class="col-md-3">
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="proposalLocations"
                                                   Value="selectedProposalLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Location", "الموقع")"
                                                   ValueChanged="OnProposalLocationChanged" />
                        </div>
                        <div class="col-md-3">
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedProposalProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Product", "المنتج")"
                                                   ValueChanged="OnProposalProductChanged" />
                        </div>
                        <div class="col-md-2">
                            <InputSelect class="form-select" @bind-Value="proposalAction">
                                @foreach (var value in Enum.GetValues<InventoryRouteRuleAction>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-1 d-grid">
                            <button class="btn btn-outline-primary" type="button" @onclick="LoadRouteProposalsAsync">
                                <i class="bi bi-arrow-repeat"></i>
                            </button>
                        </div>
                    </div>
                    <div class="erp-table-wrap mt-3">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>@SharedDataService.SelectViewLang("Route", "المسار")</th>
                                    <th>@SharedDataService.SelectViewLang("Operation", "العملية")</th>
                                    <th>@SharedDataService.SelectViewLang("From", "من")</th>
                                    <th>@SharedDataService.SelectViewLang("To", "إلى")</th>
                                    <th>@SharedDataService.SelectViewLang("Priority", "الأولوية")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var proposal in routeProposals.Take(25))
                                {
                                    <tr>
                                        <td>@SharedDataService.SelectViewLang(proposal.RouteNameEng ?? string.Empty, proposal.RouteName ?? string.Empty)</td>
                                        <td>@OperationTypeText(proposal)</td>
                                        <td>@($"{proposal.SourceLocationCode} - {SharedDataService.SelectViewLang(proposal.SourceLocationNameEng ?? string.Empty, proposal.SourceLocationName ?? string.Empty)}")</td>
                                        <td>@($"{proposal.DestinationLocationCode} - {SharedDataService.SelectViewLang(proposal.DestinationLocationNameEng ?? string.Empty, proposal.DestinationLocationName ?? string.Empty)}")</td>
                                        <td>@proposal.Priority</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-4">
                <AppCard Title="@SharedDataService.SelectViewLang("Cycle Count", "الجرد الدوري")" CssClass="h-100 allow-overflow">
                    <EditForm Model="cycleCount" OnValidSubmit="SaveCycleCountAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedCycleWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnCycleWarehouseChanged" />
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="cycleLocations"
                                                   Value="selectedCycleLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select location", "اختر الموقع")"
                                                   ValueChanged="OnCycleLocationChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedCycleProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product", "اختر المنتج")"
                                                   ValueChanged="OnCycleProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="cycleSkus"
                                                   Value="selectedCycleSku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU", "اختر وحدة المنتج")"
                                                   ValueChanged="OnCycleSkuChanged" />
                            <AutoCompleteComponent TItem="BatchDto"
                                                   Items="cycleBatches"
                                                   Value="selectedCycleBatch"
                                                   ItemText="BatchText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select batch", "اختر الدفعة")"
                                                   ValueChanged="OnCycleBatchChanged" />
