        SharedDataService.SelectViewLang(product.NameEng, product.Name);

    private string SkuText(ProductSkuDto sku) =>
        SharedDataService.SelectViewLang(sku.NameEng, sku.Name);

    private string BatchText(BatchDto batch)
    {
        var skuName = SharedDataService.SelectViewLang(batch.SkuNameEng ?? string.Empty, batch.SkuName ?? string.Empty);
        return string.IsNullOrWhiteSpace(skuName) ? batch.BatchNumber : $"{batch.BatchNumber} - {skuName}";
    }

    private string LocationText(WarehouseLocationDto warehouseLocation) =>
        $"{warehouseLocation.Code} - {SharedDataService.SelectViewLang(warehouseLocation.NameEng, warehouseLocation.Name)}";

    private string OperationTypeText(InventoryOperationTypeDto item) =>
        $"{item.Code} - {SharedDataService.SelectViewLang(item.NameEng, item.Name)}";

    private string OperationTypeText(InventoryRouteProposalDto item) =>
        $"{item.OperationTypeCode} - {SharedDataService.SelectViewLang(item.OperationTypeNameEng ?? string.Empty, item.OperationTypeName ?? string.Empty)}";

    private string RouteText(InventoryRouteDto item) =>
        $"{item.Code} - {SharedDataService.SelectViewLang(item.NameEng, item.Name)}";

    private string ReceiptText(ProcurementDocumentDto receipt) =>
        $"{receipt.Number} - {receipt.SupplierName ?? SharedDataService.SelectViewLang("No supplier", "لا يوجد مورد")} - {receipt.DocumentDate:yyyy-MM-dd}";

    private string WarehouseName(Guid warehouseId) =>
        warehouses.FirstOrDefault(x => x.Id == warehouseId) is { } warehouse
            ? WarehouseText(warehouse)
            : ShortId(warehouseId);

    private string LocationName(Guid locationId) =>
        warehouseLocations.FirstOrDefault(x => x.Id == locationId) is { } warehouseLocation
            ? LocationText(warehouseLocation)
            : ShortId(locationId);

    private string SkuName(Guid skuId)
    {
        foreach (var product in products)
        {
            var sku = product.Skus.FirstOrDefault(x => x.Id == skuId);
            if (sku is not null)
                return SkuText(sku);
        }

        return ShortId(skuId);
    }

    private static string ShortId(Guid id) => id == Guid.Empty ? string.Empty : id.ToString("N")[..8];

    private static bool IsPostedGoodsReceipt(ProcurementDocumentDto receipt) =>
        string.Equals(receipt.Status, PostedDocumentStatus.Posted.ToString(), StringComparison.OrdinalIgnoreCase);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
