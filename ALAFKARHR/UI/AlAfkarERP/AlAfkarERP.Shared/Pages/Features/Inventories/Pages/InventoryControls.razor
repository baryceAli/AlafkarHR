    private void AddCycleCountLine()
    {
        if (selectedCycleProduct is null || selectedCycleSku is null || selectedCycleBatch is null || cycleCountQuantity < 0)
        {
            ToastService.Show(new ToastMessage
            {
                Type = "error",
                Message = SharedDataService.SelectViewLang("Select product, SKU, batch, and counted quantity.", "اختر المنتج ووحدة المنتج والدفعة والكمية المعدودة.")
            });
            return;
        }

        cycleCount.Lines.Add(new CycleCountLineDto
        {
            ProductId = selectedCycleProduct.Id,
            ProductSkuId = selectedCycleSku.Id,
            BatchId = selectedCycleBatch.Id,
            ProductName = selectedCycleProduct.Name,
            ProductNameEng = selectedCycleProduct.NameEng,
            ProductSkuName = selectedCycleSku.Name,
            ProductSkuNameEng = selectedCycleSku.NameEng,
            BatchNumber = selectedCycleBatch.BatchNumber,
            CountedQuantity = cycleCountQuantity
        });
    }

    private async Task PostCycleCountAsync(Guid id)
    {
        var result = await InventoryService.PostCycleCountAsync(id);
        ToastService.Show(new ToastMessage
        {
            Type = result.IsSuccess ? "success" : "error",
            Message = result.IsSuccess
                ? SharedDataService.SelectViewLang("Cycle count posted.", "تم ترحيل الجرد الدوري.")
                : result.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Posting failed.", "فشل الترحيل.")
        });

        if (result.IsSuccess)
            await LoadReportsAsync();
    }

    private async Task LoadRouteProposalsAsync()
    {
        if (selectedProposalWarehouse is null || selectedProposalLocation is null)
        {
            ToastService.Show(new ToastMessage
            {
                Type = "error",
                Message = SharedDataService.SelectViewLang("Select warehouse and location.", "اختر المستودع والموقع.")
            });
            return;
        }

        var result = await InventoryService.GetRouteProposalsAsync(
            companyId,
            selectedProposalWarehouse.Id,
            selectedProposalLocation.Id,
            proposalAction,
            selectedProposalProduct?.Id,
            null,
            selectedProposalProduct?.CategoryId);

        if (result.IsSuccess)
        {
            routeProposals = result.Data ?? [];
            return;
        }

        ToastService.Show(new ToastMessage
        {
            Type = "error",
            Message = result.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Proposal lookup failed.", "فشل البحث عن الاقتراحات.")
        });
    }

    private string WarehouseText(WarehouseDto warehouse) =>
        SharedDataService.SelectViewLang(warehouse.NameEng, warehouse.Name);

