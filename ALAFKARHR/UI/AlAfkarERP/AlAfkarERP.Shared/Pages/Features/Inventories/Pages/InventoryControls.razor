@layout AdminLayout
@page "/Inventory/Controls"

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Features.Procurement.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Procurement.Dtos
@using SharedWithUI.Procurement.Enums

@implements IDisposable
@inject IInventoryService InventoryService
@inject IWarehouseService WarehouseService
@inject IBatchService BatchService
@inject IProductService ProductService
@inject IProcurementService ProcurementService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Inventory Controls", "ضوابط المخزون")"
                Subtitle="@SharedDataService.SelectViewLang("Locations, putaway rules, quality inspections, landed costs, valuation, and projected stock.", "المواقع وقواعد التخزين وفحص الجودة والتكاليف المحملة والتقييم والمخزون المتوقع.")"
                Overline="@SharedDataService.SelectViewLang("Inventory", "المخزون")"
                Icon="bi bi-boxes" />

    @if (isLoading)
    {
        <AppCard>
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading inventory controls...", "جاري تحميل ضوابط المخزون...")</div>
            </div>
        </AppCard>
    }
    else
    {
        <div class="row g-3">
            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Location", "الموقع")" CssClass="h-100 allow-overflow">
                    <EditForm Model="location" OnValidSubmit="SaveLocationAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedLocationWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnLocationWarehouseChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Code", "الرمز")" @bind-Value="location.Code" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Arabic name", "الاسم العربي")" @bind-Value="location.Name" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("English name", "الاسم الإنجليزي")" @bind-Value="location.NameEng" />
                            <InputSelect class="form-select" @bind-Value="location.LocationType">
                                @foreach (var value in Enum.GetValues<WarehouseLocationType>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Putaway Rule", "قاعدة التخزين")" CssClass="h-100 allow-overflow">
                    <EditForm Model="putawayRule" OnValidSubmit="SavePutawayRuleAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedPutawayWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnPutawayWarehouseChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedPutawayProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product", "اختر المنتج")"
                                                   ValueChanged="OnPutawayProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="putawaySkus"
                                                   Value="selectedPutawaySku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU", "اختر المنتج المخزني")"
                                                   ValueChanged="OnPutawaySkuChanged" />
                            <AutoCompleteComponent TItem="WarehouseLocationDto"
                                                   Items="putawayLocations"
                                                   Value="selectedPutawayDestinationLocation"
                                                   ItemText="LocationText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select destination location", "اختر موقع التخزين")"
                                                   ValueChanged="OnPutawayDestinationLocationChanged" />
                            <InputSelect class="form-select" @bind-Value="putawayRule.RemovalStrategy">
                                @foreach (var value in Enum.GetValues<RemovalStrategy>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <InputNumber class="form-control" @bind-Value="putawayRule.Priority" placeholder="Priority" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Quality Inspection", "فحص الجودة")" CssClass="h-100 allow-overflow">
                    <EditForm Model="inspection" OnValidSubmit="SaveInspectionAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="warehouses"
                                                   Value="selectedInspectionWarehouse"
                                                   ItemText="WarehouseText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse", "اختر المستودع")"
                                                   ValueChanged="OnInspectionWarehouseChanged" />
                            <AutoCompleteComponent TItem="ProductDto"
                                                   Items="products"
                                                   Value="selectedInspectionProduct"
                                                   ItemText="ProductText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product", "اختر المنتج")"
                                                   ValueChanged="OnInspectionProductChanged" />
                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                   Items="inspectionSkus"
                                                   Value="selectedInspectionSku"
                                                   ItemText="SkuText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU", "اختر المنتج المخزني")"
                                                   ValueChanged="OnInspectionSkuChanged" />
                            <AutoCompleteComponent TItem="BatchDto"
                                                   Items="inspectionBatches"
                                                   Value="selectedInspectionBatch"
                                                   ItemText="BatchText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select batch", "اختر الدفعة")"
                                                   ValueChanged="OnInspectionBatchChanged" />
                            <InputNumber class="form-control" @bind-Value="inspection.Quantity" placeholder="Quantity" />
                            <InputSelect class="form-select" @bind-Value="inspection.Status">
                                @foreach (var value in Enum.GetValues<QualityInspectionStatus>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Result notes", "ملاحظات النتيجة")" @bind-Value="inspection.ResultNotes" />
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>

            <div class="col-xl-3 col-md-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Landed Cost", "التكلفة المحملة")" CssClass="h-100 allow-overflow">
                    <EditForm Model="landedCost" OnValidSubmit="SaveLandedCostAsync">
                        <DataAnnotationsValidator />
                        <div class="vstack gap-2">
                            <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                   Items="postedGoodsReceipts"
                                                   Value="selectedLandedCostReceipt"
                                                   ItemText="ReceiptText"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select goods receipt", "اختر مستند الاستلام")"
                                                   ValueChanged="OnLandedCostReceiptChanged" />
                            <InputText class="form-control" placeholder="@SharedDataService.SelectViewLang("Receipt Number", "رقم الاستلام")" @bind-Value="landedCost.SourceDocumentNumber" disabled />
                            <InputSelect class="form-select" @bind-Value="landedCost.AllocationMethod">
                                @foreach (var value in Enum.GetValues<LandedCostAllocationMethod>())
                                {
                                    <option value="@value">@value</option>
                                }
                            </InputSelect>
                            <div class="row g-2">
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.FreightAmount" placeholder="Freight" /></div>
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.CustomsAmount" placeholder="Customs" /></div>
                            </div>
                            <div class="row g-2">
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.HandlingAmount" placeholder="Handling" /></div>
                                <div class="col"><InputNumber class="form-control" @bind-Value="landedCost.OtherAmount" placeholder="Other" /></div>
                            </div>
                            <button class="btn btn-primary" type="submit">
                                <i class="bi bi-save"></i>
                                @SharedDataService.SelectViewLang("Save", "حفظ")
                            </button>
                        </div>
                    </EditForm>
                </AppCard>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-xl-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Projected Stock", "المخزون المتوقع")">
                    <div class="erp-table-wrap">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th>@SharedDataService.SelectViewLang("On hand", "المتوفر")</th>
                                    <th>@SharedDataService.SelectViewLang("Reserved", "محجوز")</th>
                                    <th>@SharedDataService.SelectViewLang("Incoming", "وارد")</th>
                                    <th>@SharedDataService.SelectViewLang("Forecast", "التوقع")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in projectedStock.Take(50))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@SkuName(row.ProductSkuId)</div>
                                            <div class="text-muted small">@WarehouseName(row.WarehouseId)</div>
                                        </td>
                                        <td>@row.OnHandQuantity</td>
                                        <td>@row.ReservedQuantity</td>
                                        <td>@row.IncomingQuantity</td>
                                        <td>@row.ForecastedQuantity</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
            <div class="col-xl-6">
                <AppCard Title="@SharedDataService.SelectViewLang("Valuation Layers", "طبقات التقييم")">
                    <div class="erp-table-wrap">
                        <table class="erp-table table">
                            <thead>
                                <tr>
                                    <th>@SharedDataService.SelectViewLang("Reference", "المرجع")</th>
                                    <th>SKU</th>
                                    <th>@SharedDataService.SelectViewLang("Warehouse", "المستودع")</th>
                                    <th>@SharedDataService.SelectViewLang("Qty", "الكمية")</th>
                                    <th>@SharedDataService.SelectViewLang("Cost", "التكلفة")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in valuationLayers.Take(50))
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold">@row.ReferenceNumber</div>
                                            <div class="text-muted small">@row.SourceDocumentType</div>
                                        </td>
                                        <td>@SkuName(row.ProductSkuId)</td>
                                        <td>@WarehouseName(row.WarehouseId)</td>
                                        <td>@row.Quantity</td>
                                        <td>@row.TotalCost</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
        </div>
    }
</div>

@code {
    private Guid companyId;
    private bool isLoading = true;
    private WarehouseLocationDto location = new();
    private PutawayRuleDto putawayRule = new();
    private QualityInspectionDto inspection = new();
    private LandedCostVoucherDto landedCost = new();
    private List<WarehouseDto> warehouses = [];
    private List<ProductDto> products = [];
    private List<ProductSkuDto> putawaySkus = [];
    private List<ProductSkuDto> inspectionSkus = [];
    private List<BatchDto> batches = [];
    private List<BatchDto> inspectionBatches = [];
    private List<WarehouseLocationDto> warehouseLocations = [];
    private List<WarehouseLocationDto> putawayLocations = [];
    private List<ProcurementDocumentDto> postedGoodsReceipts = [];
    private List<ProjectedStockRowDto> projectedStock = [];
    private List<InventoryValuationLayerDto> valuationLayers = [];
    private WarehouseDto? selectedLocationWarehouse;
    private WarehouseDto? selectedPutawayWarehouse;
    private ProductDto? selectedPutawayProduct;
    private ProductSkuDto? selectedPutawaySku;
    private WarehouseLocationDto? selectedPutawayDestinationLocation;
    private WarehouseDto? selectedInspectionWarehouse;
    private ProductDto? selectedInspectionProduct;
    private ProductSkuDto? selectedInspectionSku;
    private BatchDto? selectedInspectionBatch;
    private ProcurementDocumentDto? selectedLandedCostReceipt;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var auth = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(auth.User, out companyId))
        {
            isLoading = false;
            return;
        }

        ResetForms();
        await LoadLookupsAsync();
        await LoadReportsAsync();
        isLoading = false;
    }

    private void ResetForms()
    {
        selectedLocationWarehouse = null;
        selectedPutawayWarehouse = null;
        selectedPutawayProduct = null;
        selectedPutawaySku = null;
        selectedPutawayDestinationLocation = null;
        selectedInspectionWarehouse = null;
        selectedInspectionProduct = null;
        selectedInspectionSku = null;
        selectedInspectionBatch = null;
        selectedLandedCostReceipt = null;
        putawaySkus = [];
        inspectionSkus = [];
        inspectionBatches = [];
        putawayLocations = [];
        location = new WarehouseLocationDto { CompanyId = companyId, IsActive = true };
        putawayRule = new PutawayRuleDto { CompanyId = companyId, IsActive = true };
        inspection = new QualityInspectionDto { CompanyId = companyId, InspectionDate = DateTime.UtcNow, Quantity = 1 };
        landedCost = new LandedCostVoucherDto { CompanyId = companyId, VoucherDate = DateTime.UtcNow };
    }

    private async Task LoadLookupsAsync()
    {
        var warehouseResponse = await WarehouseService.GetAsync(companyId, 0, 10000);
        if (warehouseResponse.IsSuccess)
            warehouses = warehouseResponse.Data?.Data?.ToList() ?? [];

        var productResponse = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (productResponse.IsSuccess)
            products = productResponse.Data?.Data?.ToList() ?? [];

        var batchResponse = await BatchService.GetAsync(companyId, 0, 10000);
        if (batchResponse.IsSuccess)
            batches = batchResponse.Data?.Data?.ToList() ?? [];

        var locationResponse = await InventoryService.GetWarehouseLocationsAsync(companyId);
        if (locationResponse.IsSuccess)
            warehouseLocations = locationResponse.Data ?? [];

        var receiptResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.GoodsReceipt, companyId, 1, 200, null);
        if (receiptResponse.IsSuccess)
        {
            postedGoodsReceipts = (receiptResponse.Data?.Data ?? [])
                .Where(IsPostedGoodsReceipt)
                .ToList();
        }
    }

    private async Task LoadReportsAsync()
    {
        var projected = await InventoryService.GetProjectedStockAsync(companyId);
        if (projected.IsSuccess)
            projectedStock = projected.Data ?? [];

        var valuation = await InventoryService.GetValuationLayersAsync(companyId);
        if (valuation.IsSuccess)
            valuationLayers = valuation.Data ?? [];
    }

    private async Task SaveLocationAsync() => await SaveAsync(() => InventoryService.SaveWarehouseLocationAsync(location));
    private async Task SavePutawayRuleAsync() => await SaveAsync(() => InventoryService.SavePutawayRuleAsync(putawayRule));
    private async Task SaveInspectionAsync() => await SaveAsync(() => InventoryService.SaveQualityInspectionAsync(inspection));
    private async Task SaveLandedCostAsync() => await SaveAsync(() => InventoryService.SaveLandedCostVoucherAsync(landedCost));

    private async Task SaveAsync(Func<Task<ApiResult<CreateResponseDto>>> action)
    {
        var result = await action();
        ToastService.Show(new ToastMessage
        {
            Type = result.IsSuccess ? "success" : "error",
            Message = result.IsSuccess
                ? SharedDataService.SelectViewLang("Saved.", "تم الحفظ.")
                : result.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Save failed.", "فشل الحفظ.")
        });

        if (result.IsSuccess)
        {
            ResetForms();
            await LoadLookupsAsync();
            await LoadReportsAsync();
        }
    }

    private void OnLocationWarehouseChanged(WarehouseDto? warehouse)
    {
        selectedLocationWarehouse = warehouse;
        location.WarehouseId = warehouse?.Id ?? Guid.Empty;
    }

    private void OnPutawayWarehouseChanged(WarehouseDto? warehouse)
    {
        selectedPutawayWarehouse = warehouse;
        putawayRule.WarehouseId = warehouse?.Id ?? Guid.Empty;
        putawayLocations = warehouse is null
            ? []
            : warehouseLocations.Where(x => x.WarehouseId == warehouse.Id).ToList();

        if (selectedPutawayDestinationLocation is not null
            && selectedPutawayDestinationLocation.WarehouseId != putawayRule.WarehouseId)
        {
            OnPutawayDestinationLocationChanged(null);
        }
    }

    private void OnPutawayProductChanged(ProductDto? product)
    {
        selectedPutawayProduct = product;
        putawayRule.ProductId = product?.Id;
        putawaySkus = product?.Skus ?? [];
        OnPutawaySkuChanged(null);
    }

    private void OnPutawaySkuChanged(ProductSkuDto? sku)
    {
        selectedPutawaySku = sku;
        putawayRule.ProductSkuId = sku?.Id;
    }

    private void OnPutawayDestinationLocationChanged(WarehouseLocationDto? warehouseLocation)
    {
        selectedPutawayDestinationLocation = warehouseLocation;
        putawayRule.DestinationLocationId = warehouseLocation?.Id;
    }

    private void OnInspectionWarehouseChanged(WarehouseDto? warehouse)
    {
        selectedInspectionWarehouse = warehouse;
        inspection.WarehouseId = warehouse?.Id;
    }

    private void OnInspectionProductChanged(ProductDto? product)
    {
        selectedInspectionProduct = product;
        inspection.ProductId = product?.Id ?? Guid.Empty;
        inspectionSkus = product?.Skus ?? [];
        OnInspectionSkuChanged(null);
    }

    private void OnInspectionSkuChanged(ProductSkuDto? sku)
    {
        selectedInspectionSku = sku;
        inspection.ProductSkuId = sku?.Id ?? Guid.Empty;
        inspectionBatches = sku is null
            ? []
            : batches.Where(x => x.ProductSkuId == sku.Id).ToList();
        OnInspectionBatchChanged(null);
    }

    private void OnInspectionBatchChanged(BatchDto? batch)
    {
        selectedInspectionBatch = batch;
        inspection.BatchId = batch?.Id;
    }

    private void OnLandedCostReceiptChanged(ProcurementDocumentDto? receipt)
    {
        selectedLandedCostReceipt = receipt;
        landedCost.SourceDocumentId = receipt?.Id ?? Guid.Empty;
        landedCost.SourceDocumentNumber = receipt?.Number ?? string.Empty;
    }

    private string WarehouseText(WarehouseDto warehouse) =>
        SharedDataService.SelectViewLang(warehouse.NameEng, warehouse.Name);

    private string ProductText(ProductDto product) =>
        SharedDataService.SelectViewLang(product.NameEng, product.Name);

    private string SkuText(ProductSkuDto sku) =>
        SharedDataService.SelectViewLang(sku.NameEng, sku.Name);

    private string BatchText(BatchDto batch)
    {
        var skuName = SharedDataService.SelectViewLang(batch.SkuNameEng ?? string.Empty, batch.SkuName ?? string.Empty);
        return string.IsNullOrWhiteSpace(skuName) ? batch.BatchNumber : $"{batch.BatchNumber} - {skuName}";
    }

    private string LocationText(WarehouseLocationDto warehouseLocation) =>
        $"{warehouseLocation.Code} - {SharedDataService.SelectViewLang(warehouseLocation.NameEng, warehouseLocation.Name)}";

    private string ReceiptText(ProcurementDocumentDto receipt) =>
        $"{receipt.Number} - {receipt.SupplierName ?? SharedDataService.SelectViewLang("No supplier", "لا يوجد مورد")} - {receipt.DocumentDate:yyyy-MM-dd}";

    private string WarehouseName(Guid warehouseId) =>
        warehouses.FirstOrDefault(x => x.Id == warehouseId) is { } warehouse
            ? WarehouseText(warehouse)
            : ShortId(warehouseId);

    private string SkuName(Guid skuId)
    {
        foreach (var product in products)
        {
            var sku = product.Skus.FirstOrDefault(x => x.Id == skuId);
            if (sku is not null)
                return SkuText(sku);
        }

        return ShortId(skuId);
    }

    private static string ShortId(Guid id) => id == Guid.Empty ? string.Empty : id.ToString("N")[..8];

    private static bool IsPostedGoodsReceipt(ProcurementDocumentDto receipt) =>
        string.Equals(receipt.Status, PostedDocumentStatus.Posted.ToString(), StringComparison.OrdinalIgnoreCase);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
