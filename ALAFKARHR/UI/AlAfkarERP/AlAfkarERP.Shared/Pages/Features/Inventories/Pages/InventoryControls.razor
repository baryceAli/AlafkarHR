    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var auth = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(auth.User, out companyId))
        {
            isLoading = false;
            return;
        }

        ResetForms();
        await LoadLookupsAsync();
        await LoadReportsAsync();
        isLoading = false;
    }

    private void ResetForms()
    {
        selectedLocationWarehouse = null;
        selectedPutawayWarehouse = null;
        selectedPutawayProduct = null;
        selectedPutawaySku = null;
        selectedPutawayDestinationLocation = null;
        selectedInspectionWarehouse = null;
        selectedInspectionProduct = null;
        selectedInspectionSku = null;
        selectedInspectionBatch = null;
        selectedLandedCostReceipt = null;
        selectedCycleWarehouse = null;
        selectedCycleLocation = null;
        selectedCycleProduct = null;
        selectedCycleSku = null;
        selectedCycleBatch = null;
        selectedOperationWarehouse = null;
        selectedOperationSourceLocation = null;
        selectedOperationDestinationLocation = null;
        selectedRouteWarehouse = null;
        selectedRouteProduct = null;
        selectedRouteSku = null;
        selectedRouteRuleRoute = null;
        selectedRouteRuleWarehouse = null;
        selectedRouteRuleOperationType = null;
        selectedRouteRuleSourceLocation = null;
        selectedRouteRuleDestinationLocation = null;
        selectedRouteRuleProduct = null;
        selectedRouteRuleSku = null;
        selectedProposalWarehouse = null;
        selectedProposalLocation = null;
        selectedProposalProduct = null;
        putawaySkus = [];
        inspectionSkus = [];
        inspectionBatches = [];
        putawayLocations = [];
        cycleLocations = [];
        operationLocations = [];
        routeRuleLocations = [];
        routeRuleOperationTypes = [];
        proposalLocations = [];
        routeSkus = [];
        routeRuleSkus = [];
        routeProposals = [];
        cycleSkus = [];
        cycleBatches = [];
        location = new WarehouseLocationDto { CompanyId = companyId, IsActive = true, LocationUsage = WarehouseLocationUsage.Internal };
        putawayRule = new PutawayRuleDto { CompanyId = companyId, IsActive = true };
        inspection = new QualityInspectionDto { CompanyId = companyId, InspectionDate = DateTime.UtcNow, Quantity = 1 };
        landedCost = new LandedCostVoucherDto { CompanyId = companyId, VoucherDate = DateTime.UtcNow };
        cycleCount = new CycleCountDto { CompanyId = companyId, CountDate = DateTime.UtcNow };
        operationType = new InventoryOperationTypeDto { CompanyId = companyId, IsActive = true };
        inventoryRoute = new InventoryRouteDto { CompanyId = companyId, IsActive = true };
        routeRule = new InventoryRouteRuleDto { CompanyId = companyId, IsActive = true };
        proposalAction = InventoryRouteRuleAction.Push;
        cycleCountQuantity = 1;
    }

    private async Task LoadLookupsAsync()
    {
        var warehouseResponse = await WarehouseService.GetAsync(companyId, 0, 10000);
        if (warehouseResponse.IsSuccess)
            warehouses = warehouseResponse.Data?.Data?.ToList() ?? [];

        var productResponse = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (productResponse.IsSuccess)
            products = productResponse.Data?.Data?.ToList() ?? [];

        var batchResponse = await BatchService.GetAsync(companyId, 0, 10000);
        if (batchResponse.IsSuccess)
            batches = batchResponse.Data?.Data?.ToList() ?? [];

        var locationResponse = await InventoryService.GetWarehouseLocationsAsync(companyId);
        if (locationResponse.IsSuccess)
            warehouseLocations = locationResponse.Data ?? [];

        var operationTypeResponse = await InventoryService.GetOperationTypesAsync(companyId);
        if (operationTypeResponse.IsSuccess)
            operationTypes = operationTypeResponse.Data ?? [];

        var routeResponse = await InventoryService.GetRoutesAsync(companyId);
        if (routeResponse.IsSuccess)
            inventoryRoutes = routeResponse.Data ?? [];

        var routeRuleResponse = await InventoryService.GetRouteRulesAsync(companyId);
        if (routeRuleResponse.IsSuccess)
            routeRules = routeRuleResponse.Data ?? [];

        var receiptResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.GoodsReceipt, companyId, 1, 200, null);
        if (receiptResponse.IsSuccess)
        {
            postedGoodsReceipts = (receiptResponse.Data?.Data ?? [])
                .Where(IsPostedGoodsReceipt)
                .ToList();
        }
    }

    private async Task LoadReportsAsync()
    {
        var projected = await InventoryService.GetProjectedStockAsync(companyId);
        if (projected.IsSuccess)
            projectedStock = projected.Data ?? [];

        var valuation = await InventoryService.GetValuationLayersAsync(companyId);
        if (valuation.IsSuccess)
            valuationLayers = valuation.Data ?? [];

        var locations = await InventoryService.GetLocationBalancesAsync(companyId);
        if (locations.IsSuccess)
            locationBalances = locations.Data ?? [];

        var counts = await InventoryService.GetCycleCountsAsync(companyId);
        if (counts.IsSuccess)
            cycleCounts = counts.Data ?? [];
    }

    private async Task SaveLocationAsync() => await SaveAsync(() => InventoryService.SaveWarehouseLocationAsync(location));
    private async Task SavePutawayRuleAsync() => await SaveAsync(() => InventoryService.SavePutawayRuleAsync(putawayRule));
    private async Task SaveInspectionAsync() => await SaveAsync(() => InventoryService.SaveQualityInspectionAsync(inspection));
    private async Task SaveLandedCostAsync() => await SaveAsync(() => InventoryService.SaveLandedCostVoucherAsync(landedCost));
    private async Task SaveCycleCountAsync() => await SaveAsync(() => InventoryService.SaveCycleCountAsync(cycleCount));
    private async Task SaveOperationTypeAsync() => await SaveAsync(() => InventoryService.SaveOperationTypeAsync(operationType));
    private async Task SaveRouteAsync() => await SaveAsync(() => InventoryService.SaveRouteAsync(inventoryRoute));
    private async Task SaveRouteRuleAsync() => await SaveAsync(() => InventoryService.SaveRouteRuleAsync(routeRule));

    private async Task SaveAsync(Func<Task<ApiResult<CreateResponseDto>>> action)
    {
        var result = await action();
        ToastService.Show(new ToastMessage
        {
            Type = result.IsSuccess ? "success" : "error",
            Message = result.IsSuccess
                ? SharedDataService.SelectViewLang("Saved.", "تم الحفظ.")
                : result.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Save failed.", "فشل الحفظ.")
        });

        if (result.IsSuccess)
        {
            ResetForms();
            await LoadLookupsAsync();
            await LoadReportsAsync();
        }
    }

    private void OnLocationWarehouseChanged(WarehouseDto? warehouse)
    {
        selectedLocationWarehouse = warehouse;
        location.WarehouseId = warehouse?.Id ?? Guid.Empty;
    }

    private void OnOperationWarehouseChanged(WarehouseDto? warehouse)
    {
        selectedOperationWarehouse = warehouse;
        operationType.WarehouseId = warehouse?.Id ?? Guid.Empty;
        operationLocations = warehouse is null
            ? []
            : warehouseLocations.Where(x => x.WarehouseId == warehouse.Id && x.IsActive).ToList();
        OnOperationSourceLocationChanged(null);
        OnOperationDestinationLocationChanged(null);
    }

