                                        <td>@SkuName(row.ProductSkuId)</td>
                                        <td>@WarehouseName(row.WarehouseId)</td>
                                        <td>@row.Quantity</td>
                                        <td>@row.TotalCost</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
        </div>
    }
</div>

