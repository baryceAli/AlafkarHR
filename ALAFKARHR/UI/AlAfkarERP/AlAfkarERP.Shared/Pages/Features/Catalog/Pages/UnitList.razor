@layout AdminLayout
@page "/Warehouse/Product/Unit/List"
@implements IDisposable


@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions


@inject IUnitService UnitService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.UnitPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Unit Management", "ادارة الوحدات")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain product units used across catalog items.", "إدارة وحدات المنتجات المستخدمة في عناصر الكتالوج.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-rulers">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.UnitPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Units", "الوحدات")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove unit records.", "ابحث ورتب وعدل واحذف سجلات الوحدات.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search units...", "ابحث في الوحدات...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                    <input type="checkbox" class="form-check-input" checked="@includeInactive" @onchange="OnIncludeInactiveChanged" />
                    <span class="form-check-label">@SharedDataService.SelectViewLang("Include inactive", "تضمين غير النشط")</span>
                </label>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    @if (!units.Any() && editingUnitId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No units yet", "لا توجد وحدات بعد")"
                    Message="@SharedDataService.SelectViewLang("Create the first unit used by catalog products.", "أنشئ أول وحدة مستخدمة في منتجات الكتالوج.")"
                    Icon="bi-rulers">
            <Actions>
                @if (CanCreateUnit)
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                    </button>
                }
            </Actions>
        </EmptyState>
    }
    else if (!ProcessedUnits.Any() && editingUnitId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No matching units", "لا توجد وحدات مطابقة")"
                    Message="@SharedDataService.SelectViewLang("Try a different unit name.", "جرب اسم وحدة مختلفا.")"
                    Icon="bi-search" />
    }
    else
    {
    <div class="erp-table-wrap">
    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(UnitDto.UnitName))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(UnitDto.UnitNameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                <th>@SharedDataService.SelectViewLang("Category", "الفئة")</th>
                <th>@SharedDataService.SelectViewLang("Factor", "معامل التحويل")</th>
                <th>@SharedDataService.SelectViewLang("Reference", "مرجعية")</th>
                <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @* @foreach (var b in branches) *@
            @if (editingUnitId != null)
            {
                var editingItem = units.FirstOrDefault(x => x.Id == editingUnitId);
                if (editingItem != null)
                {
                    <tr>
                        
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveUnit(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.UnitName" />
                                            <ValidationMessage For="() => editingItem.UnitName" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.UnitNameEng" />
                                            <ValidationMessage For="() => editingItem.UnitNameEng" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Category", "الفئة")</label>
                                        <InputText class="form-control" @bind-Value="editingItem.UnitCategory" />
                                        <div class="form-text">@SharedDataService.SelectViewLang("Only units in the same category can convert between each other.", "Only units in the same category can convert between each other.")</div>
                                        <ValidationMessage For="() => editingItem.UnitCategory" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Conversion Factor", "معامل التحويل")</label>
                                        <InputNumber class="form-control" @bind-Value="editingItem.ConversionFactor" />
                                        <div class="form-text">@SharedDataService.SelectViewLang("Use 1 for the reference unit in each category.", "Use 1 for the reference unit in each category.")</div>
                                        <ValidationMessage For="() => editingItem.ConversionFactor" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Reference Unit", "وحدة مرجعية")</label>
                                        <div>
                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsReferenceUnit" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-check d-flex align-items-center gap-2">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsActive" />
                                            <span class="form-check-label">@SharedDataService.SelectViewLang("Active", "نشط")</span>
                                        </label>
                                    </div>

                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>
                }
                <tr>
                </tr>
            }
            @foreach (var unit in ProcessedUnits.Where(x => x.Id != editingUnitId))
            {
                @* @if(0==2){}
                else
                }
                { *@
                <tr>
                    <td>@unit.UnitName</td>
                    <td>@unit.UnitNameEng</td>
                    <td>@unit.UnitCategory</td>
                    <td>@unit.ConversionFactor</td>
                    <td>@(unit.IsReferenceUnit ? SharedDataService.SelectViewLang("Yes", "نعم") : SharedDataService.SelectViewLang("No", "لا"))</td>
                    <td><StatusChip Tone="@GetActiveTone(unit.IsActive)" Text="@GetActiveLabel(unit.IsActive)" /></td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditUnit(unit.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.UnitPermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteUnit(unit)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.UnitPermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<UnitDto> units = new();
    private Guid? editingUnitId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    private bool CanCreateUnit => HasPermission(PermissionList.UnitPermissions.Create);
    private bool HasPermission(string permission) => AuthState?.User?.Claims.Any(c => c.Value == permission) == true;
    protected override async Task OnInitializedAsync()
    {
        LoadingService.Show();

        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadCategory();
        LoadingService.Hide();
    }
    // Branch
    void CreateNew()
    {
        var newItem = new UnitDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId,
            UnitCategory = "General",
            ConversionFactor = 1,
            IsActive = true
        };
        units.Insert(0, newItem);
        editingUnitId = newItem.Id;
        isEdit = false;
    }

    void EditUnit(Guid id)
    {
        editingUnitId = id;
        isEdit = true;
        StateHasChanged();
    }
    async Task SaveUnit(UnitDto unit)
    {
        LoadingService.Show();
        if (unit.Id == editingUnitId && !isEdit)
        {
            //Create new

            unit.CompanyId = companyId;

            var bResponse = await UnitService.CreateAsync(unit);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Unit has been created successfully", "تم إنشاء الوحدة بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await UnitService.UpdateAsync(unit);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Unit has been Edited successfully", "تم تعديل الوحدة بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadCategory();

        editingUnitId = null;
        await InvokeAsync(StateHasChanged);
        LoadingService.Hide();

    }

    async Task DeleteUnit(UnitDto unit)
    {
        LoadingService.Show();
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Unit: {unit.UnitNameEng}?",
            $"هل ترغب فعلا في حذف الوحدة: {unit.UnitName}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await UnitService.DeleteAsync(unit.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadCategory();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Unit", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });

        LoadingService.Hide();
    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = units.FirstOrDefault(x => x.Id == editingUnitId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var brRes = await UnitService.GetByCompanyAsync(companyId, 0, 1000, includeInactive: includeInactive);
            if (brRes.IsSuccess)
            {
                units = brRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            units.Remove(item);
        }
        isEdit = false;
        editingUnitId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";
    private bool includeInactive;

    // Sorting
    private string sortColumn = nameof(UnitDto.UnitName);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadCategory()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await UnitService.GetByCompanyAsync(companyId, pageIndex, pageSize, includeInactive: includeInactive);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            units = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadCategory();
    }
    private async Task OnIncludeInactiveChanged(ChangeEventArgs args)
    {
        includeInactive = args.Value is bool value && value;
        pageIndex = 0;
        await LoadCategory();
    }
    private string GetActiveTone(bool isActive) => isActive ? "success" : "muted";
    private string GetActiveLabel(bool isActive) => isActive
        ? SharedDataService.SelectViewLang("Active", "نشط")
        : SharedDataService.SelectViewLang("Inactive", "غير نشط");
    private IEnumerable<UnitDto> ProcessedUnits =>
    units
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.UnitName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.UnitNameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadCategory();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadCategory();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
