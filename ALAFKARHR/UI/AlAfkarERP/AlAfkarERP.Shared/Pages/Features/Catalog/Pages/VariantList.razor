@layout AdminLayout
@page "/Catalog/Variant/List"
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Catalog.Enums
@using SharedWithUI.Permissions
@using AlAfkarERP.Shared.Pages.Reuable2


@inject IVariantService VariantService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Product Variants", "خيارات المنتج")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain variant options and their selectable values.", "إدارة خيارات المنتج والقيم المتاحة لها.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-ui-checks-grid">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Variants", "خيارات المنتج")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove variant records.", "ابحث ورتب وعدل واحذف سجلات الخيارات.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search variants...", "ابحث في الخيارات...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    @if (!variants.Any() && editingVariantId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No variants yet", "لا توجد خيارات بعد")"
                    Message="@SharedDataService.SelectViewLang("Create the first variant option and its selectable values.", "أنشئ أول خيار منتج وقيمه المتاحة.")"
                    Icon="bi-ui-checks-grid">
            <Actions>
                @if (CanCreateVariant)
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                    </button>
                }
            </Actions>
        </EmptyState>
    }
    else if (!ProcessedVariants.Any() && editingVariantId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No matching variants", "لا توجد خيارات مطابقة")"
                    Message="@SharedDataService.SelectViewLang("Try a different variant name.", "جرب اسم خيار مختلفا.")"
                    Icon="bi-search" />
    }
    else
    {
    <div class="erp-table-wrap">
    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(VariantDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(VariantDto.NameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                <th>@SharedDataService.SelectViewLang("Display", "العرض")</th>
                <th>@SharedDataService.SelectViewLang("Creation", "الإنشاء")</th>
                <th>@SharedDataService.SelectViewLang("Values", "القيم")</th>
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingVariantId != null)
            {
                var editingItem = variants.FirstOrDefault(x => x.Id == editingVariantId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="6">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveVariant(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Display Type", "نوع العرض")</label>
                                        <div class="col-sm-10">
                                            <InputSelect class="form-select" @bind-Value="editingItem.DisplayType">
                                                @foreach (var displayType in Enum.GetValues<VariantDisplayType>())
                                                {
                                                    <option value="@displayType">@GetDisplayTypeLabel(displayType)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Creation Mode", "نمط الإنشاء")</label>
                                        <div class="col-sm-10">
                                            <InputSelect class="form-select" @bind-Value="editingItem.CreationMode">
                                                @foreach (var creationMode in Enum.GetValues<VariantCreationMode>())
                                                {
                                                    <option value="@creationMode">@GetCreationModeLabel(creationMode)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Variant Values", "القيم")</label>
                                        <div class="col-sm-10">
                                            <div class="erp-subpanel">
                                                            @foreach (var value in editingItem.Values)
                                                            {
                                                                <div class="erp-repeater-row" @key="value">

                                                                    <div>
                                                                        <InputText class="form-control"
                                                                                   placeholder="Value"
                                                                                   @bind-Value="value.Value" />
                                                                    </div>

                                                                    <div>
                                                                        <InputText class="form-control"
                                                                                   placeholder="Value (En)"
                                                                                   @bind-Value="value.ValueEng" />
                                                                    </div>

                                                                    <div class="erp-form-actions">
                                                                        <button type="button"
                                            class="btn btn-outline-danger btn-sm erp-row-action"
                                                                                @onclick="() => RemoveVariantValue(editingItem, value)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </div>

                                                                </div>
                                                            }

                                                            <button type="button"
                                                                    class="btn btn-outline-primary btn-sm mt-2"
                                                                    @onclick="() => AddVariantValue(editingItem)">
                                                                <i class="bi bi-plus"></i> Add Value
                                                            </button>

                                                        
                                                    

                                            </div>

                                        </div>
                                    </div>



                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            @foreach (var variant in ProcessedVariants.Where(x => x.Id != editingVariantId))
            {
                
                <tr>
                    <td>@variant.Name</td>
                    <td>@variant.NameEng</td>
                    <td>@GetDisplayTypeLabel(variant.DisplayType)</td>
                    <td>@GetCreationModeLabel(variant.CreationMode)</td>
                    <td>
                        <div class="erp-chip-row">
                            @foreach(var value in variant.Values)
                            {
                                <StatusChip Tone="primary" Text="@SharedDataService.SelectViewLang(value.ValueEng,value.Value)" />
                            }
                        </div>
                    </td>
                    <td>
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditVariant(variant.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteVariant(variant)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                            </div>
                    </td>
                </tr>
                
            }
        </tbody>
    </table>
    </div>
    }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<VariantDto> variants = new();
    private Guid? editingVariantId;
    // private Guid? editingVariantValueId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    private bool CanCreateVariant => HasPermission(PermissionList.VariantPermissions.Create);
    private bool HasPermission(string permission) => AuthState?.User?.Claims.Any(c => c.Value == permission) == true;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadVariants();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }

    void CreateNew()
    {
        var newItem = new VariantDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId,
            DisplayType = VariantDisplayType.Pills,
            CreationMode = VariantCreationMode.Instant,
            Values = new List<VariantValueDto>()
        };

        // Start with one empty row
        newItem.Values.Add(new VariantValueDto
        {
            Id = Guid.Empty,
            VariantId = newItem.Id
        });

        variants.Insert(0, newItem);
        editingVariantId = newItem.Id;
        isEdit = false;
    }

    void EditVariant(Guid id)
    {
        editingVariantId = id;
        isEdit = true;
        // editingVariantValueId = variants.FirstOrDefault(v => v.Id == id)?.Values.FirstOrDefault()?.Id ?? null;
        StateHasChanged();
    }
    async Task SaveVariant(VariantDto variant)
    {
        NormalizeVariantSettings(variant);
        LoadingService.Show();
        if (variant.Id == editingVariantId && !isEdit)
        {
            //Create new

            Random rnd = new Random();

            variant.CompanyId = companyId;
            var bResponse = await VariantService.CreateAsync(variant);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Variant has been created successfully", "تم إنشاء خيارات المنتج بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await VariantService.UpdateAsync(variant);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Variant has been Edited successfully", "تم تعديل خيارات المنتج بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        LoadingService.Hide();
        await LoadVariants();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingVariantId = null;
    }

    async Task DeleteVariant(VariantDto variant)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this variant: {variant.NameEng}?", $"هل ترغب فعلا في حذف خيارات المنتج: {variant.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                LoadingService.Show();
                var brResponse = await VariantService.DeleteAsync(variant.Id);
                LoadingService.Hide();
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadVariants();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the variant", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = variants.FirstOrDefault(x => x.Id == editingVariantId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var varRes = await VariantService.GetByCompanyAsync(companyId, 0, 1000);
            if (varRes.IsSuccess)
            {
                variants = varRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            variants.Remove(item);
        }
        isEdit = false;
        editingVariantId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(VariantDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadVariants()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);
        LoadingService.Show();
        var response = await VariantService.GetByCompanyAsync(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            variants = response.Data?.Data?.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
        LoadingService.Hide();
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadVariants();
    }
    private IEnumerable<VariantDto> ProcessedVariants =>
    variants
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

    // 📄 Pagination
    // .Skip((pageIndex) * pageSize)
    // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadVariants();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadVariants();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    private void AddVariantValue(VariantDto variant)
    {
        variant.Values.Add(new VariantValueDto
        {
            Id = Guid.Empty, // VERY IMPORTANT
            VariantId = variant.Id,
            Value = "",
            ValueEng = ""
        });
    }

    private void RemoveVariantValue(VariantDto variant, VariantValueDto value)
    {
        variant.Values.Remove(value);
    }

    private void NormalizeVariantSettings(VariantDto variant)
    {
        if (variant.DisplayType == VariantDisplayType.MultiCheckbox)
        {
            variant.CreationMode = VariantCreationMode.Never;
        }
    }

    private string GetDisplayTypeLabel(VariantDisplayType displayType) => displayType switch
    {
        VariantDisplayType.Pills => SharedDataService.SelectViewLang("Pills", "أزرار"),
        VariantDisplayType.Color => SharedDataService.SelectViewLang("Color", "لون"),
        VariantDisplayType.Radio => SharedDataService.SelectViewLang("Radio", "اختيار"),
        VariantDisplayType.Select => SharedDataService.SelectViewLang("Select", "قائمة"),
        VariantDisplayType.Image => SharedDataService.SelectViewLang("Image", "صورة"),
        VariantDisplayType.MultiCheckbox => SharedDataService.SelectViewLang("Multi checkbox", "اختيار متعدد"),
        _ => displayType.ToString()
    };

    private string GetCreationModeLabel(VariantCreationMode creationMode) => creationMode switch
    {
        VariantCreationMode.Instant => SharedDataService.SelectViewLang("Instant", "فوري"),
        VariantCreationMode.Dynamic => SharedDataService.SelectViewLang("Dynamic", "ديناميكي"),
        VariantCreationMode.Never => SharedDataService.SelectViewLang("Never", "أبدا"),
        _ => creationMode.ToString()
    };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
