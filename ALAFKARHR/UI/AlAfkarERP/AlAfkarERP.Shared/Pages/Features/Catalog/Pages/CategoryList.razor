@layout AdminLayout
@page "/Warehouse/Product/Category/List"

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions


@inject ICategoryService CategoryService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.CategoryPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page">
    <PageHeader Title="@SharedDataService.SelectViewLang("Category Management", "ادارة الأصناف")"
                Subtitle="@SharedDataService.SelectViewLang("Organize products into searchable catalog categories.", "تنظيم المنتجات ضمن أصناف كتالوج قابلة للبحث.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-diagram-3">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.CategoryPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Categories", "الأصناف")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove category records.", "ابحث ورتب وعدل واحذف سجلات الأصناف.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search categories...", "ابحث في الأصناف...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    <div class="erp-table-wrap">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(CategoryDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(CategoryDto.NameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                <th>@SharedDataService.SelectViewLang("Description", "الوصف")</th>
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @if (editingCategoryId != null && editingCategoryId!=Guid.Empty)
            {
                var category = categories.FirstOrDefault(b => b.Id == editingCategoryId);
                <tr>
                    <td colspan="9">
                        <EditForm Model="category" OnValidSubmit="() => SaveCategory(category)">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            @* <InputHidden @bind-Value="branch.Id"/> *@
                            <div class="row g-3 bg-info-subtle p-3">

                                <div class="col-md-6">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                    <div>
                                        <InputText class="form-control" @bind-Value="category.Name" />
                                        <ValidationMessage For="() => category.Name" />
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                    <div>
                                        <InputText class="form-control" @bind-Value="category.NameEng" />
                                        <ValidationMessage For="() => category.NameEng" />
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Description", "الوصف")</label>
                                    <div>
                                        <InputTextArea class="form-control" @bind-Value="category.Description" />
                                            
                                    </div>
                                </div>



                                <div class="col-12 d-flex justify-content-end gap-2">
                                    <button type="submit" class="btn btn-success btn-sm">@SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                    <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelEdit">@SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                </div>
                            </div>
                        </EditForm>
                    </td>
                </tr>
            }
            @foreach (var category in ProcessedCategories)
            {
                
                
                    <tr>
                        <td>@category.Name</td>
                        <td>@category.NameEng</td>
                        <td>@category.Description</td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-primary btn-sm"
                                    @onclick="() => EditCategory(category.Id)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.Edit}"))>
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => DeleteCategory(category)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.Delete}"))>
                                <i class="bi bi-trash"></i>
                            </button>
                            </div>
                        </td>
                    </tr>
                
            }
        </tbody>
    </table>
    </div>
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<CategoryDto> categories = new();
    private Guid? editingCategoryId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    protected override async Task OnInitializedAsync()
    {
        LoadingService.Show();

        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        await LoadCategory();
        LoadingService.Hide();
    }
    // Branch
    void CreateNew()
    {
        var newItem = new CategoryDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId
        };
        categories.Insert(0, newItem);
        editingCategoryId = newItem.Id;
        isEdit = false;
    }

    void EditCategory(Guid id)
    {
        editingCategoryId = id;
        isEdit = true;
    }
    async Task SaveCategory(CategoryDto category)
    {
        LoadingService.Show();
        if (category.Id == editingCategoryId && !isEdit)
        {
            //Create new

            category.CompanyId = companyId;

            var bResponse = await CategoryService.CreateAsync(category);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Category has been created successfully", "تم إنشاء الصنف بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await CategoryService.UpdateAsync(category);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Category has been Edited successfully", "تم تعديل الصنف بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadCategory();

        editingCategoryId = null;
        await InvokeAsync(StateHasChanged);
        LoadingService.Hide();

    }

    async Task DeleteCategory(CategoryDto category)
    {
        LoadingService.Show();
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this category: {category.NameEng}?",
            $"هل ترغب فعلا في حذف الصنف: {category.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await CategoryService.DeleteAsync(category.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadCategory();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Category", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });

        LoadingService.Hide();
    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = categories.FirstOrDefault(x => x.Id == editingCategoryId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var brRes = await CategoryService.GetByCompanyIdAsync(companyId, 0, 1000);
            if (brRes.IsSuccess)
            {
                categories = brRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            categories.Remove(item);
        }
        isEdit = false;
        editingCategoryId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(BranchDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadCategory()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await CategoryService.GetByCompanyIdAsync(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            categories = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadCategory();
    }
    private IEnumerable<CategoryDto> ProcessedCategories =>
    categories
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadCategory();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadCategory();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
