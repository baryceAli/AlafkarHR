@layout AdminLayout
@page "/Warehouse/Product/Brand/List"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions


@inject IBrandService BrandService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Brand Management", "ادارة العلامة التجارية")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain product brand names and descriptions.", "إدارة أسماء العلامات التجارية وأوصافها.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-tags">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Brands", "العلامات التجارية")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove brand records.", "ابحث ورتب وعدل واحذف سجلات العلامات التجارية.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search brands...", "ابحث في العلامات...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                    <input type="checkbox" class="form-check-input" checked="@includeInactive" @onchange="OnIncludeInactiveChanged" />
                    <span class="form-check-label">@SharedDataService.SelectViewLang("Include inactive", "تضمين غير النشط")</span>
                </label>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

        @if (!brands.Any() && editingBrandId is null)
        {
            <EmptyState Title="@SharedDataService.SelectViewLang("No brands yet", "لا توجد علامات تجارية بعد")"
                        Message="@SharedDataService.SelectViewLang("Create the first brand to classify catalog products.", "أنشئ أول علامة تجارية لتصنيف منتجات الكتالوج.")"
                        Icon="bi-tags">
                <Actions>
                    @if (CanCreateBrand)
                    {
                        <button class="btn btn-primary" @onclick="CreateNew">
                            <i class="bi bi-plus-lg"></i>
                            @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                        </button>
                    }
                </Actions>
            </EmptyState>
        }
        else if (!ProcessedBrands.Any() && editingBrandId is null)
        {
            <EmptyState Title="@SharedDataService.SelectViewLang("No matching brands", "لا توجد علامات تجارية مطابقة")"
                        Message="@SharedDataService.SelectViewLang("Try a different brand name or description.", "جرب اسم علامة تجارية أو وصفا مختلفا.")"
                        Icon="bi-search" />
        }
        else
        {
        <div class="erp-table-wrap">
            <table class="table erp-table mb-0">
                <thead>
                    <tr>
                        <th @onclick="() => Sort(nameof(BrandDto.Name))">
                            <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                            @SharedDataService.SelectViewLang("Name", "الاسم")
                        </th>
                        <th @onclick="() => Sort(nameof(BrandDto.NameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                        <th>@SharedDataService.SelectViewLang("Description", "الوصف")</th>
                        <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                        <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
            
            @if (editingBrandId != null)
            {
                var editingItem = brands.FirstOrDefault(x => x.Id == editingBrandId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveBrand(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Description", "الوصف")</label>
                                        <div>
                                            <InputTextArea class="form-control" @bind-Value="editingItem.Description" />
                                            
                                        </div>
                                    </div>


                                    <div class="col-12">
                                        <label class="form-check d-flex align-items-center gap-2">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsActive" />
                                            <span class="form-check-label">@SharedDataService.SelectViewLang("Active", "نشط")</span>
                                        </label>
                                    </div>

                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }
                

            }
            @foreach (var brand in ProcessedBrands.Where(x => x.Id != editingBrandId))
            {
                
                    <tr>
                        <td>@brand.Name</td>
                        <td>@brand.NameEng</td>
                        <td>@brand.Description</td>
                        <td><StatusChip Tone="@GetActiveTone(brand.IsActive)" Text="@GetActiveLabel(brand.IsActive)" /></td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm erp-row-action"
                                    @onclick="() => EditBrand(brand.Id)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.Edit}"))>
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm erp-row-action"
                                    @onclick="() => DeleteBrand(brand)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.BrandPermissions.Delete}"))>
                                <i class="bi bi-trash"></i>
                            </button>
                            </div>
                        </td>
                    </tr>
                
            }
                </tbody>
            </table>
        </div>
        }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<BrandDto> brands = new();
    private Guid? editingBrandId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    private bool CanCreateBrand => HasPermission(PermissionList.BrandPermissions.Create);
    private bool HasPermission(string permission) => AuthState?.User?.Claims.Any(c => c.Value == permission) == true;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadBrands();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }
    // Branch
    void CreateNew()
    {
        var newItem = new BrandDto()
        {
            Id = Guid.NewGuid(),
            IsActive = true
        };
        newItem.CompanyId = companyId;
        brands.Insert(0, newItem);
        editingBrandId = newItem.Id;
        isEdit = false;
    }

    void EditBrand(Guid id)
    {
        editingBrandId = id;
        isEdit = true;
        StateHasChanged();
    }
    async Task SaveBrand(BrandDto brand)
    {
        if (brand.Id == editingBrandId && !isEdit)
        {
            //Create new

            Random rnd = new Random();

            brand.CompanyId = companyId;

            var bResponse = await BrandService.CreateAsync(brand);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Brand has been created successfully", "تم العلامة التجارية بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await BrandService.UpdateAsync(brand);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Brand has been Edited successfully", "تم تعديل العلامة التجارية بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                // 
                // 
                // 
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadBrands();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingBrandId = null;
    }

    async Task DeleteBrand(BrandDto brand)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this brand: {brand.NameEng}?", $"هل ترغب فعلا في حذف العلامة التجارية: {brand.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await BrandService.DeleteAsync(brand.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadBrands();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the brand", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = brands.FirstOrDefault(x => x.Id == editingBrandId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var brRes = await BrandService.GetByCompanyIdAsync(companyId, 0, 1000, includeInactive);
            if (brRes.IsSuccess)
            {
                brands = brRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            brands.Remove(item);
        }
        isEdit = false;
        editingBrandId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";
    private bool includeInactive;

    // Sorting
    private string sortColumn = nameof(BranchDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadBrands()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await BrandService.GetByCompanyIdAsync(companyId, pageIndex, pageSize, includeInactive);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            brands = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadBrands();
    }
    private async Task OnIncludeInactiveChanged(ChangeEventArgs args)
    {
        includeInactive = args.Value is bool value && value;
        pageIndex = 0;
        await LoadBrands();
    }
    private string GetActiveTone(bool isActive) => isActive ? "success" : "muted";
    private string GetActiveLabel(bool isActive) => isActive
        ? SharedDataService.SelectViewLang("Active", "نشط")
        : SharedDataService.SelectViewLang("Inactive", "غير نشط");
    private IEnumerable<BrandDto> ProcessedBrands =>
    brands
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadBrands();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadBrands();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
