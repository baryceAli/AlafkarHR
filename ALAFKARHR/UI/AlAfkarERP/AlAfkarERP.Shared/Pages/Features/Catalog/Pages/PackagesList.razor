@layout AdminLayout
@page "/Warehouse/Product/Packages/List"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions


@inject IPackageService PackageService
@inject IUnitService UnitService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPackagePermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Package Management", "العبوات")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain package names and quantities for catalog products.", "إدارة أسماء العبوات وكمياتها لمنتجات الكتالوج.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-box-seam">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPackagePermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Packages", "العبوات")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove package records.", "ابحث ورتب وعدل واحذف سجلات العبوات.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search packages...", "ابحث في العبوات...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                    <input type="checkbox" class="form-check-input" checked="@includeInactive" @onchange="OnIncludeInactiveChanged" />
                    <span class="form-check-label">@SharedDataService.SelectViewLang("Include inactive", "تضمين غير النشط")</span>
                </label>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    @if (!packages.Any() && editingPackageId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No packages yet", "لا توجد عبوات بعد")"
                    Message="@SharedDataService.SelectViewLang("Create the first package option for catalog products.", "أنشئ أول خيار عبوة لمنتجات الكتالوج.")"
                    Icon="bi-box-seam">
            <Actions>
                @if (CanCreatePackage)
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                    </button>
                }
            </Actions>
        </EmptyState>
    }
    else if (!ProcessedPackages.Any() && editingPackageId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No matching packages", "لا توجد عبوات مطابقة")"
                    Message="@SharedDataService.SelectViewLang("Try a different package name or quantity.", "جرب اسم عبوة أو كمية مختلفة.")"
                    Icon="bi-search" />
    }
    else
    {
    <div class="erp-table-wrap">
    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(ProductPackageDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(ProductPackageDto.NameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                <th>@SharedDataService.SelectViewLang("Quantity", "الكمية")</th>
                <th>@SharedDataService.SelectViewLang("Unit","الوحدة")</th>
                <th>@SharedDataService.SelectViewLang("Barcode","باركود")</th>
                <th>@SharedDataService.SelectViewLang("Dimensions", "الأبعاد")</th>
                <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingPackageId != null)
            {
                var editingItem = packages.FirstOrDefault(x => x.Id == editingPackageId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="9">
                            <EditForm Model="editingItem" OnValidSubmit="() => SavePackage(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <div class="col-md-4">
                                        <label for="inputPackageName" class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label for="inputPackageNameEng" class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <div>
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label for="inputQuantity" class="form-label">@SharedDataService.SelectViewLang("Quantity", "الكمية")</label>
                                        <div>
                                            <InputNumber class="form-control" @bind-Value="editingItem.Quantity" />
                                            
                                        </div>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Reference Unit", "الوحدة المرجعية")</label>
                                        <InputSelect TValue="Guid?" class="form-select" @bind-Value="editingItem.UnitId">
                                            <option value="">@SharedDataService.SelectViewLang("No unit", "بدون وحدة")</option>
                                            @foreach (var unit in units)
                                            {
                                                <option value="@unit.Id">@SharedDataService.SelectViewLang(unit.UnitNameEng, unit.UnitName)</option>
                                            }
                                        </InputSelect>
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Barcode", "باركود")</label>
                                        <InputText class="form-control" @bind-Value="editingItem.Barcode" />
                                        <ValidationMessage For="() => editingItem.Barcode" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Weight", "الوزن")</label>
                                        <InputNumber class="form-control" @bind-Value="editingItem.Weight" />
                                        <ValidationMessage For="() => editingItem.Weight" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Length", "الطول")</label>
                                        <InputNumber class="form-control" @bind-Value="editingItem.Length" />
                                        <ValidationMessage For="() => editingItem.Length" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Width", "العرض")</label>
                                        <InputNumber class="form-control" @bind-Value="editingItem.Width" />
                                        <ValidationMessage For="() => editingItem.Width" />
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Height", "الارتفاع")</label>
                                        <InputNumber class="form-control" @bind-Value="editingItem.Height" />
                                        <ValidationMessage For="() => editingItem.Height" />
                                    </div>

                                    <div class="col-md-8">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Notes", "ملاحظات")</label>
                                        <InputTextArea class="form-control" @bind-Value="editingItem.Notes" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-check d-flex align-items-center gap-2">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsActive" />
                                            <span class="form-check-label">@SharedDataService.SelectViewLang("Active", "نشط")</span>
                                        </label>
                                    </div>


                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            @foreach (var brand in ProcessedPackages.Where(x => x.Id != editingPackageId))
            {
                
                <tr>
                    <td>@brand.Name</td>
                    <td>@brand.NameEng</td>
                    <td>@brand.Quantity</td>
                    <td>@GetUnitLabel(brand.UnitId)</td>
                    <td>@(string.IsNullOrWhiteSpace(brand.Barcode) ? "-" : brand.Barcode)</td>
                    <td>@GetPackageDimensions(brand)</td>
                    <td><StatusChip Tone="@GetActiveTone(brand.IsActive)" Text="@GetActiveLabel(brand.IsActive)" /></td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditPackage(brand.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPackagePermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeletePackage(brand)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPackagePermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
                
            }
        </tbody>
    </table>
    </div>
    }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<ProductPackageDto> packages = new();
    private List<UnitDto> units = [];
    private UnitDto? selectedUnit;
    private Guid? editingPackageId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    private bool CanCreatePackage => HasPermission(PermissionList.ProductPackagePermissions.Create);
    private bool HasPermission(string permission) => AuthState?.User?.Claims.Any(c => c.Value == permission) == true;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadPackages();
        await LoadUnits();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }
    // Branch
    void CreateNew()
    {
        var newItem = new ProductPackageDto()
        {
            Id = Guid.NewGuid(),
            IsActive = true
        };
        newItem.CompanyId = companyId;
        packages.Insert(0, newItem);
        editingPackageId = newItem.Id;
        isEdit = false;
    }

    void EditPackage(Guid id)
    {
        editingPackageId = id;
        isEdit = true;
        StateHasChanged();
    }
    async Task SavePackage(ProductPackageDto package)
    {
        if (package.Id == editingPackageId && !isEdit)
        {
            //Create new

            Random rnd = new Random();

            package.CompanyId = companyId;

            var bResponse = await PackageService.CreateAsync(package);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Package has been created successfully", "تم العبوة بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await PackageService.UpdateAsync(package);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Package has been Edited successfully", "تم تعديل العبوة بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadPackages();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingPackageId = null;
    }

    async Task DeletePackage(ProductPackageDto package)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService
                    .SelectViewLang($"Are you sure you want to delete this Package: {package.NameEng}?", 
                    $"هل ترغب فعلا في حذف العبوة: {package.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await PackageService.DeleteAsync(package.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadPackages();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the package", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = packages.FirstOrDefault(x => x.Id == editingPackageId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
           await LoadPackages();
            // var brRes = await PackageService.GetByCompanyAsync(companyId, 0, 1000);
            // if (brRes.IsSuccess)
            // {
            //     packages = brRes.Data?.Data?.ToList() ?? [];
            // }
        }
        else
        {
            // new record → remove it
            packages.Remove(item);
        }
        isEdit = false;
        editingPackageId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";
    private bool includeInactive;

    // Sorting
    private string sortColumn = nameof(BranchDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadPackages()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await PackageService.GetByCompanyAsync(companyId, pageIndex, pageSize, searchText, includeInactive);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            packages = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    private async Task LoadUnits()
    {
        var response = await UnitService.GetByCompanyAsync(companyId, 0, 1000);
        if (response.IsSuccess)
        {
            units = response.Data?.Data?.ToList() ?? [];
        }
    }

    private string GetUnitLabel(Guid? unitId)
    {
        if (!unitId.HasValue || unitId.Value == Guid.Empty)
        {
            return "-";
        }

        var unit = units.FirstOrDefault(x => x.Id == unitId.Value);
        return unit is null
            ? "-"
            : SharedDataService.SelectViewLang(unit.UnitNameEng, unit.UnitName);
    }
    private string GetPackageDimensions(ProductPackageDto package)
    {
        var parts = new List<string>();
        if (package.Weight.HasValue) parts.Add($"{package.Weight:g}w");
        if (package.Length.HasValue) parts.Add($"{package.Length:g}l");
        if (package.Width.HasValue) parts.Add($"{package.Width:g}w");
        if (package.Height.HasValue) parts.Add($"{package.Height:g}h");
        return parts.Count == 0 ? "-" : string.Join(" x ", parts);
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadPackages();
    }
    private async Task OnIncludeInactiveChanged(ChangeEventArgs args)
    {
        includeInactive = args.Value is bool value && value;
        pageIndex = 0;
        await LoadPackages();
    }
    private string GetActiveTone(bool isActive) => isActive ? "success" : "muted";
    private string GetActiveLabel(bool isActive) => isActive
        ? SharedDataService.SelectViewLang("Active", "نشط")
        : SharedDataService.SelectViewLang("Inactive", "غير نشط");
    private IEnumerable<ProductPackageDto> ProcessedPackages =>
    packages
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.Barcode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

    // 📄 Pagination
    // .Skip((pageIndex) * pageSize)
    // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadPackages();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadPackages();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
