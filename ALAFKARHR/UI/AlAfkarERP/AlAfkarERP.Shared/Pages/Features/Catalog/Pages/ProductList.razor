    private string GetProductImageSource(ProductDto product)
    {
        if (string.IsNullOrWhiteSpace(product.ImageUrl))
            return "_content/AlAfkarERP.Shared/images/productPlaceHolder.jpg";

        if (product.ImageUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || product.ImageUrl.StartsWith("http://", StringComparison.OrdinalIgnoreCase)
            || product.ImageUrl.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return product.ImageUrl;
        }

        return $"{ApiConfig.BaseURL}/Images/Products/{product.ImageUrl}";
    }

