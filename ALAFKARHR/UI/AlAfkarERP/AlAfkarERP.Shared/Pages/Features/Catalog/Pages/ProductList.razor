    private async Task LoadProductSmartLinksAsync()
    {
        productSmartLinks.Clear();

        foreach (var product in products)
        {
            var links = new ProductSmartLinkSummaryDto
            {
                Skus = product.Skus?.Count ?? 0
            };

            if (HasPermission(PermissionList.ProductPermissions.View))
            {
                var catalogLinks = await ProductService.GetSmartLinksAsync(product.Id);
                if (catalogLinks.IsSuccess && catalogLinks.Data is not null)
                    links.Skus = catalogLinks.Data.Skus;
            }

            if (HasPermission(PermissionList.SalesOrderPermissions.View))
            {
                var salesLinks = await SalesService.GetOrderSmartLinksAsync(companyId, productId: product.Id);
                if (salesLinks.IsSuccess && salesLinks.Data is not null)
                    links.SalesLines = salesLinks.Data.ProductLinks.SalesLines;
            }

            if (HasPermission(PermissionList.PurchaseOrderPermissions.View))
            {
                var procurementLinks = await ProcurementService.GetSmartLinksAsync(companyId, productId: product.Id);
                if (procurementLinks.IsSuccess && procurementLinks.Data is not null)
                    links.PurchaseLines = procurementLinks.Data.ProductLinks.PurchaseLines;

                var vendorPricelists = await ProcurementService.GetVendorPricelistsAsync(companyId, productId: product.Id);
                if (vendorPricelists.IsSuccess)
                    links.VendorPricelists = vendorPricelists.Data?.Count ?? 0;
            }

            if (HasPermission(PermissionList.PurchaseRequestPermissions.View))
            {
                var reorderingRules = await ProcurementService.GetReorderingRulesAsync(companyId, productId: product.Id);
                if (reorderingRules.IsSuccess)
                    links.ReorderingRules = reorderingRules.Data?.Count ?? 0;
            }

            productSmartLinks[product.Id] = links;
        }
    }

    private ProductSmartLinkSummaryDto GetProductLinks(Guid productId)
        => productSmartLinks.TryGetValue(productId, out var links) ? links : new ProductSmartLinkSummaryDto();

