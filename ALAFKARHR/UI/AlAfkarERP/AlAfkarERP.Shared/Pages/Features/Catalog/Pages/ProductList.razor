@layout AdminLayout
@page "/Catalog/Product/List"
@implements IDisposable



@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Catalog.Enums
@using SharedWithUI.Permissions


@inject IProductService ProductService
@inject IUnitService UnitService
@inject ICategoryService CategoryService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Products Management", "ادارة المنتجات")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain catalog products and open their SKU setup.", "إدارة منتجات الكتالوج وفتح إعدادات المنتجات المخزنية.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-box">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Products", "المنتجات")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and manage product SKUs.", "ابحث ورتب وعدل وأدر المنتجات المخزنية.")"
             CssClass="allow-overflow">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search products...", "ابحث في المنتجات...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <label class="form-check d-flex align-items-center gap-2 mb-0">
                    <input type="checkbox" class="form-check-input" checked="@includeInactive" @onchange="OnIncludeInactiveChanged" />
                    <span class="form-check-label">@SharedDataService.SelectViewLang("Include inactive", "تضمين غير النشط")</span>
                </label>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    @if (!products.Any() && editingProductId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No products yet", "لا توجد منتجات بعد")"
                    Message="@SharedDataService.SelectViewLang("Create the first product to start building the catalog.", "أنشئ أول منتج لبدء بناء الكتالوج.")"
                    Icon="bi-box">
            <Actions>
                @if (CanCreateProduct)
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                    </button>
                }
            </Actions>
        </EmptyState>
    }
    else if (!ProcessedProducts.Any() && editingProductId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No matching products", "لا توجد منتجات مطابقة")"
                    Message="@SharedDataService.SelectViewLang("Try a different product, unit, or category search.", "جرب البحث عن منتج أو وحدة أو صنف مختلف.")"
                    Icon="bi-search" />
    }
    else
    {
    <div class="erp-table-wrap">
    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(ProductDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(ProductDto.NameEng))">@SharedDataService.SelectViewLang("NameEng", "الاسم بالانجليزية")</th>
                <th @onclick="() => Sort(nameof(ProductDto.CategoryName))">@SharedDataService.SelectViewLang("category", "الصنف")</th>
                <th>@SharedDataService.SelectViewLang("Type", "النوع")</th>
                <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                @* <th @onclick="() => Sort(nameof(ProductDto.UnitName))">@SharedDataService.SelectViewLang("Unit", "الوحدة")</th> *@
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @* @foreach (var b in branches) *@
            @if (editingProductId != null)
            {
                var editingItem = products.FirstOrDefault(x => x.Id == editingProductId);
                if (editingItem != null)
                {
                    <tr>
                        
                        <td colspan="6">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveProduct(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>
                                    </div>

                                    <!--Category-->
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Category", "الصنف")
                                        </label>
                                        <div class="col-sm-10">
                                            <AutoCompleteComponent TItem="CategoryDto"
                                                                   Items="categories"
                                                                   ItemText="(p=> SharedDataService.SelectViewLang(p.NameEng,p.Name))"
                                                                   PlaceHolder="@(SharedDataService.SelectViewLang("search a category","ابحث عن صنف"))"
                                                                   Value="selectedCategory"
                                                                   ValueChanged="onCategorySelected" />
                                        </div>
                                    </div>
                                    
                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Product Type", "نوع المنتج")
                                        </label>
                                        <div class="col-sm-10">
                                            <InputSelect TValue="CatalogProductType" class="form-select" @bind-Value="editingItem.ProductType">
                                                @foreach (var productType in Enum.GetValues<CatalogProductType>())
                                                {
                                                    <option value="@productType">@GetProductTypeLabel(productType)</option>
                                                }
                                            </InputSelect>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Status", "الحالة")</label>
                                        <div class="col-sm-10">
                                            <label class="form-check d-flex align-items-center gap-2">
                                                <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsActive" />
                                                <span class="form-check-label">@SharedDataService.SelectViewLang("Active", "نشط")</span>
                                            </label>
                                        </div>
                                    </div>

                                    <!--SKU-->
                                    @* <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("SKU", "المنتج المخزني")
                                        </label>
                                        <div class="col-sm-10">

                                            <div class="card">
                                                <div class="card-body">
                                            
                                                    <!--Unit-->
                                                    <div class="mb-3 row">
                                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                                            @SharedDataService.SelectViewLang("Unit", "الوحدة")
                                                        </label>
                                                        <div class="col-sm-10">
                                                            <AutoCompleteComponent TItem="UnitDto"
                                                                                   Items="units"
                                                                                   ItemText="(u=> SharedDataService.SelectViewLang(u.UnitNameEng,u.UnitName))"
                                                                                   PlaceHolder="@(SharedDataService.SelectViewLang("search a unit","ابحث عن وحدة"))"
                                                                                   Value="selectedUnit"
                                                                                   ValueChanged="onUnitSelected" />
                                                        </div>
                                                    </div>

                                                </div>
                                            </div>
                                        </div>
                                        
                                    </div> *@

                                    
                                            
                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>
                }
                <tr>
                </tr>
            }
            @foreach (var product in ProcessedProducts.Where(x => x.Id != editingProductId))
            {
                @* @if(0==2){}
                else
                }
                { *@
                <tr>
                    <td>@product.Name</td>
                    <td>@product.NameEng</td>
                    <td>@product.CategoryName</td>
                    <td>@GetProductTypeLabel(product.ProductType)</td>
                    <td><StatusChip Tone="@GetActiveTone(product.IsActive)" Text="@GetActiveLabel(product.IsActive)" /></td>
                    @* <td>@product.UnitName</td> *@
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditProduct(product.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-primary btn-sm erp-row-action"
                                @onclick='() => NavigationManager.NavigateTo($"/Catalog/Product/{product.Id}/ProductSku")'
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Edit}"))>
                            <i class="bi bi-upc-scan"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteProduct(product)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
    }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<ProductDto> products = new();
    private Guid? editingProductId;
    private Guid companyId;
    private bool isEdit = false;
    private List<UnitDto> units = [];
    // private UnitDto? selectedUnit;
    private List<CategoryDto> categories = [];
    private CategoryDto? selectedCategory;
    private AuthenticationState AuthState;
    private bool CanCreateProduct => HasPermission(PermissionList.ProductPermissions.Create);
    private bool HasPermission(string permission) => AuthState?.User?.Claims.Any(c => c.Value == permission) == true;
    protected override async Task OnInitializedAsync()
    {
        LoadingService.Show();

        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        var catRes = await CategoryService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (catRes.IsSuccess)
        {
            categories = catRes.Data?.Data?.ToList() ?? [];
        }

        var unitRes = await UnitService.GetByCompanyAsync(companyId, 0, 1000);
        if (unitRes.IsSuccess)
        {
            units = unitRes.Data?.Data?.ToList() ?? [];
        }

        await LoadProduct();
        LoadingService.Hide();
    }
    // Branch
    void CreateNew()
    {
        var newItem = new ProductDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId,
            IsActive = true,
            //CategoryId=Guid.NewGuid(),//categories.Any()?categories[0].Id:Guid.NewGuid(),
            //UnitId=Guid.NewGuid()//units.Any()? units[0].Id:Guid.NewGuid()
        };
        products.Insert(0, newItem);
        editingProductId = newItem.Id;
        isEdit = false;
    }

    void EditProduct(Guid id)
    {
        editingProductId = id;
        var editingItem = products.FirstOrDefault(p => p.Id == id);
        if (editingItem != null)
        {
            selectedCategory = categories.FirstOrDefault(x => x.Id == editingItem.CategoryId) ?? new();
            // selectedUnit = units.FirstOrDefault(u => u.Id == editingItem.UnitId) ?? new();
        }

        isEdit = true;
        StateHasChanged();
    }
    async Task SaveProduct(ProductDto prod)
    {
        LoadingService.Show();

        if (selectedCategory == null || selectedCategory.Id == Guid.Empty )
        {
            await ModalService.ShowAsync(new ModalOptions
            {
                Title = SharedDataService.SelectViewLang("Create Product", "إنشاء منتج"),
                IsError = true,
                Message = SharedDataService.SelectViewLang("Please select product's category and unit", "يرجى اختيار الصنف والوحدة"),
                OnOk = async () => { }
            });
            LoadingService.Hide();
            return;
        }
        prod.CategoryId = selectedCategory.Id;
        // prod.UnitId = selectedUnit.Id;

        if (prod.Id == editingProductId && !isEdit)
        {
            //Create new

            prod.CompanyId = companyId;

            var bResponse = await ProductService.CreateAsync(prod);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Product has been created successfully", "تم إنشاء المنتج بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await ProductService.UpdateAsync(prod);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Product has been Edited successfully", "تم تعديل المنتج بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadProduct();

        editingProductId = null;
        await InvokeAsync(StateHasChanged);
        LoadingService.Hide();

    }

    async Task DeleteProduct(ProductDto product)
    {
        LoadingService.Show();
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Product: {product.NameEng}?",
            $"هل ترغب فعلا في حذف المنتج: {product.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await ProductService.DeleteAsync(product.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadProduct();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Product", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });

        LoadingService.Hide();
    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = products.FirstOrDefault(x => x.Id == editingProductId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            await LoadProduct();
            // var brRes = await ProductService.GetByCompanyAsync(companyId, 0, 1000);
            // if (brRes.IsSuccess)
            // {
            //     products = brRes.Data?.Data?.ToList() ?? [];
            // }
        }
        else
        {
            // new record → remove it
            products.Remove(item);
        }
        isEdit = false;
        editingProductId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";
    private bool includeInactive;

    // Sorting
    private string sortColumn = nameof(ProductDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadProduct()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await ProductService.GetByCompanyAsync(companyId, pageIndex, pageSize, includeInactive);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            products = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadProduct();
    }
    private async Task OnIncludeInactiveChanged(ChangeEventArgs args)
    {
        includeInactive = args.Value is bool value && value;
        pageIndex = 0;
        await LoadProduct();
    }
    private string GetActiveTone(bool isActive) => isActive ? "success" : "muted";
    private string GetActiveLabel(bool isActive) => isActive
        ? SharedDataService.SelectViewLang("Active", "نشط")
        : SharedDataService.SelectViewLang("Inactive", "غير نشط");
    private IEnumerable<ProductDto> ProcessedProducts =>
    products
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.CategoryName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.UnitName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.UnitNameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

    // 📄 Pagination
    // .Skip((pageIndex) * pageSize)
    // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadProduct();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;

        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadProduct();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers


    private void onCategorySelected(CategoryDto category)
    {

        selectedCategory = category != null ? category : new();
    }
    private string GetProductTypeLabel(CatalogProductType productType)
    {
        return productType switch
        {
            CatalogProductType.Service => SharedDataService.SelectViewLang("Service", "خدمة"),
            CatalogProductType.Combo => SharedDataService.SelectViewLang("Combo", "مركب"),
            _ => SharedDataService.SelectViewLang("Goods", "بضائع")
        };
    }
    // private void onUnitSelected(UnitDto unit)
    // {
    //     selectedUnit = unit != null ? unit : new();
    //     StateHasChanged();
    // }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
