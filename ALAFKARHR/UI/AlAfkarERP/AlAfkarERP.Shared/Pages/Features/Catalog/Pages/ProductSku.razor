    private void OnBundleComponentSelected(ProductSkuComponentDto component, ProductSkuDto? sku)
    {
        component.ComponentProductSkuId = sku?.Id ?? Guid.Empty;
        component.ComponentSkuName = sku?.Name;
        component.ComponentSkuNameEng = sku?.NameEng;
        component.ComponentSkuCode = sku?.SkuCode;
        component.ComponentSkuCodeEng = sku?.SkuCodeEng;
    }

    private async Task<bool> ValidateBundleComponentsAsync(ProductSkuDto sku)
    {
        if (sku.ProductionType != SkuProductionType.CompositeBundle)
        {
            sku.Components.Clear();
            return true;
        }

        if (!sku.Components.Any())
        {
            await ShowBundleValidationMessageAsync(
                SharedDataService.SelectViewLang("Please add at least one bundle component", "الرجاء إضافة مكون واحد على الأقل للحزمة"));
            return false;
        }

        if (sku.Components.Any(component => component.ComponentProductSkuId == Guid.Empty))
        {
            await ShowBundleValidationMessageAsync(
                SharedDataService.SelectViewLang("Please select a SKU for each bundle component", "الرجاء اختيار منتج مخزني لكل مكون"));
            return false;
        }

        if (sku.Components.Any(component => component.Quantity <= 0))
        {
            await ShowBundleValidationMessageAsync(
                SharedDataService.SelectViewLang("Bundle component quantity must be greater than zero", "يجب أن تكون كمية مكون الحزمة أكبر من صفر"));
            return false;
        }

        if (isEdit && sku.Components.Any(component => component.ComponentProductSkuId == sku.Id))
        {
            await ShowBundleValidationMessageAsync(
                SharedDataService.SelectViewLang("A bundle SKU cannot contain itself", "لا يمكن أن تحتوي الحزمة على نفسها"));
            return false;
        }

        var hasDuplicates = sku.Components
            .GroupBy(component => component.ComponentProductSkuId)
            .Any(group => group.Count() > 1);

        if (hasDuplicates)
        {
            await ShowBundleValidationMessageAsync(
                SharedDataService.SelectViewLang("Each component SKU can be added only once", "يمكن إضافة كل منتج مخزني كمكون مرة واحدة فقط"));
            return false;
        }

        return true;
    }

    private async Task ShowBundleValidationMessageAsync(string message)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Bundle Components", "مكونات الحزمة"),
            Message = message,
            IsError = true,
            OnOk = async () => { }
        });
    }

    private void onVariantSelected(VariantDto variant)
