            SkuProductionType.ManufacturedItem => SharedDataService.SelectViewLang("Manufactured Item", "صنف مصنع"),
            SkuProductionType.CompositeBundle => SharedDataService.SelectViewLang("Composite Bundle", "حزمة مركبة"),
