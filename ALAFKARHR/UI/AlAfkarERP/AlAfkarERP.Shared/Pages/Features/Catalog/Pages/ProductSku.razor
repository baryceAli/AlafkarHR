    private void ToggleSkuPackage(ProductSkuDto sku, ProductPackageDto package, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        var existingPackage = sku.Packages.FirstOrDefault(p => p.Id == package.Id);

        if (isChecked && existingPackage is null)
        {
            sku.Packages.Add(package);
            return;
        }

        if (!isChecked && existingPackage is not null)
        {
            sku.Packages.Remove(existingPackage);
        }
    }

    private async Task LoadCompanyProductsAsync()
    {
        var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (prodRes.IsSuccess)
        {
            products = prodRes.Data?.Data?.ToList() ?? [];
            allProductSkus = products
                .SelectMany(product => product.Skus)
                .ToList();
        }
    }

    private void MergeProductSkusIntoCache(IEnumerable<ProductSkuDto> skus)
    {
        foreach (var sku in skus)
        {
            var index = allProductSkus.FindIndex(existingSku => existingSku.Id == sku.Id);
            if (index >= 0)
            {
                allProductSkus[index] = sku;
                continue;
            }

            allProductSkus.Add(sku);
        }
    }

    private List<ProductSkuDto> GetAvailableComponentSkus(ProductSkuDto bundleSku, ProductSkuComponentDto component)
    {
        var selectedComponentIds = bundleSku.Components
            .Where(c => c != component)
            .Select(c => c.ComponentProductSkuId)
            .ToHashSet();

        return allProductSkus
            .Where(sku => sku.Id != bundleSku.Id)
            .Where(sku => !selectedComponentIds.Contains(sku.Id))
            .ToList();
    }

    private ProductSkuDto? GetComponentSku(ProductSkuComponentDto component)
    {
        if (component.ComponentProductSkuId == Guid.Empty)
        {
            return null;
        }

        return allProductSkus.FirstOrDefault(sku => sku.Id == component.ComponentProductSkuId);
    }

