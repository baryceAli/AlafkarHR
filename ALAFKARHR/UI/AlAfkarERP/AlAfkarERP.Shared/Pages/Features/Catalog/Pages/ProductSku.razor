@layout AdminLayout
@page "/Catalog/Product/{ProductId:guid?}/ProductSku"
@page "/Catalog/Product/ProductSku/List"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Catalog.Enums
@using SharedWithUI.Permissions


@inject IProductService ProductService
@inject IBrandService BrandService
@inject IUnitService UnitService
@inject IPackageService PackageService
@inject IVariantService VariantService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ApiConfig ApiConfig


    @if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang("Product SKU", "منتج مخزني")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain SKU details, images, variants, package, unit, and brand assignments.", "إدارة تفاصيل المنتج المخزني والصور والخيارات والعبوة والوحدة والعلامة التجارية.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-upc-scan">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Product Context", "سياق المنتج")"
             Subtitle="@SharedDataService.SelectViewLang("Choose the product before managing its stock keeping units.", "اختر المنتج قبل إدارة منتجاته المخزنية.")"
             CssClass="mb-3 allow-overflow">
    <div class="erp-subpanel">
    
        @if (ProductId.HasValue && selectedProduct != null && selectedProduct.Id != Guid.Empty)
        {
            <div class="mb-3 row">
                <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                <div class="col-sm-10">
                    <p>@SharedDataService.SelectViewLang(selectedProduct.NameEng, selectedProduct.Name)</p>
                </div>
            </div>
        }
        else
        {
            <AutoCompleteComponent TItem="ProductDto"
                                   Items="products"
                                   Value="selectedProduct"
                                   PlaceHolder="@SharedDataService.SelectViewLang("Search a product","ابحث عن منتج")"
                                   ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                   ValueChanged="onProductSelected">
            </AutoCompleteComponent>
        }
        
    </div>
    </AppCard>

    <AppCard Title="@SharedDataService.SelectViewLang("SKUs", "المنتجات المخزنية")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove SKU records.", "ابحث ورتب وعدل واحذف سجلات المنتجات المخزنية.")"
             CssClass="allow-overflow">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group erp-search-control">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search SKUs...", "ابحث في المنتجات المخزنية...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <TableExportActions />
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    @if (!HasSelectedProduct && editingProductSkuId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("Select a product", "اختر منتجا")"
                    Message="@SharedDataService.SelectViewLang("Choose a product before managing its SKUs.", "اختر منتجا قبل إدارة منتجاته المخزنية.")"
                    Icon="bi-box" />
    }
    else if (!productskuList.Any() && editingProductSkuId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No SKUs yet", "لا توجد منتجات مخزنية بعد")"
                    Message="@SharedDataService.SelectViewLang("Create the first SKU for the selected product.", "أنشئ أول منتج مخزني للمنتج المحدد.")"
                    Icon="bi-upc-scan">
            <Actions>
                @if (CanCreateProduct)
                {
                    <button class="btn btn-primary" @onclick="CreateNew">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
                    </button>
                }
            </Actions>
        </EmptyState>
    }
    else if (!ProcessedVariants.Any() && editingProductSkuId is null)
    {
        <EmptyState Title="@SharedDataService.SelectViewLang("No matching SKUs", "لا توجد منتجات مخزنية مطابقة")"
                    Message="@SharedDataService.SelectViewLang("Try a different SKU name or code.", "جرب اسم منتج مخزني أو رمزا مختلفا.")"
                    Icon="bi-search" />
    }
    else
    {
    <div class="erp-table-wrap">
    <table class="table erp-table mb-0">
        <thead>
            
            <tr>
                <th>@SharedDataService.SelectViewLang("Image", "الصورة")</th>
                <th @onclick="() => Sort(nameof(ProductSkuDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(ProductSkuDto.SkuCode))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("SKUCode", "الرمز المخزني")
                </th>
                <th>@SharedDataService.SelectViewLang("Production Type", "نوع الإنتاج")</th>
                <th @onclick="() => Sort(nameof(ProductSkuDto.Price))">@SharedDataService.SelectViewLang("Price", "السعر")</th>
                <th @onclick="() => Sort(nameof(ProductSkuDto.BrandName))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Brand", "العلامة التجارية")
                </th>
                <th>@SharedDataService.SelectViewLang("Packages", "العبوات")</th>
                <th>@SharedDataService.SelectViewLang("Unit", "الوحدة")</th>
                <th>@SharedDataService.SelectViewLang("Calories", "السعرات")</th>
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            
            @if (selectedProduct != null)
            {
                var editingItem = productskuList.FirstOrDefault(x => x.Id == editingProductSkuId);
                @* var editingItem = selectedProduct.Skus.FirstOrDefault(x => x.Id == editingProductSkuId); *@
                if (editingItem != null)
                {
                    if (isEdit)
                    {
                        selectedBrand = brands.First(b => b.Id == editingItem.BrandId);
                        selectedUnit = units.First(u => u.Id == editingItem.UnitId);
                        if (!editingItem.Packages.Any() && editingItem.PackageId.HasValue)
                        {
                            var legacyPackage = packages.FirstOrDefault(p => p.Id == editingItem.PackageId.Value);
                            if (legacyPackage is not null)
                            {
                                editingItem.Packages.Add(legacyPackage);
                            }
                        }
                    }
                    <tr>
                        <td colspan="10">
                            <EditForm Model="editingItem" OnValidSubmit="() => SaveProductSKU(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="erp-inline-editor">

                                    <!--Brand-->
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Brand", "العلامة التجارية")
                                        </label>
                                        <div class="col-sm-10">
                                            <AutoCompleteComponent TItem="BrandDto"
                                                                   Items="brands"
                                                                   ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                                                   PlaceHolder="@(SharedDataService.SelectViewLang("search a brand","ابحث عن العلامة التجارية"))"
                                                                   Value="selectedBrand"
                                                                   ValueChanged="onBrandSelected" />
                                        </div>
                                    </div>

                                    <!--Packages-->
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Packages", "العبوات")
                                        </label>
                                        <div class="col-sm-10">
                                            <div class="erp-check-tile-group">
                                                @foreach (var package in packages)
                                                {
                                                    <label class="erp-check-tile">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               checked="@editingItem.Packages.Any(p => p.Id == package.Id)"
                                                               @onchange="args => ToggleSkuPackage(editingItem, package, args)" />
                                                        <span class="form-check-label">
                                                            @SharedDataService.SelectViewLang(package.NameEng, package.Name)
                                                            <span class="text-muted">(@package.Quantity)</span>
                                                        </span>
                                                    </label>
                                                }
                                            </div>
                                        </div>
                                    </div>

                                    <!--Unit-->
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Unit", "الوحدة")
                                        </label>
                                        <div class="col-sm-10">
                                            <AutoCompleteComponent TItem="UnitDto"
                                                                   Items="units"
                                                                   ItemText="(u=> SharedDataService.SelectViewLang(u.UnitNameEng,u.UnitName))"
                                                                   PlaceHolder="@(SharedDataService.SelectViewLang("search a unit","ابحث عن وحدة"))"
                                                                   Value="selectedUnit"
                                                                   ValueChanged="onUnitSelected" />
                                        </div>
                                    </div>

                                    
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("Name", "الاسم")
                                        </label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">
                                            @SharedDataService.SelectViewLang("NameEng", "الاسم (En)")
                                        </label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.NameEng" />
                                            <ValidationMessage For="() => editingItem.NameEng" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Barcode", "باركود")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.Barcode" />
                                            <ValidationMessage For="() => editingItem.Barcode" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Price", "السعر")</label>
                                        <div class="col-sm-10">
                                            <InputNumber class="form-control" @bind-Value="editingItem.Price" />
                                            <ValidationMessage For="() => editingItem.Price" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="skuProductionType" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Production Type", "نوع الإنتاج")</label>
                                        <div class="col-sm-10">
                                            <InputSelect id="skuProductionType" TValue="SkuProductionType" class="form-select" @bind-Value="editingItem.ProductionType">
                                                @foreach (var productionType in Enum.GetValues<SkuProductionType>())
                                                {
                                                    <option value="@productionType">@GetSkuProductionTypeLabel(productionType)</option>
                                                }
                                            </InputSelect>
                                            <div class="form-text">
                                                @SharedDataService.SelectViewLang("Product type", "نوع المنتج"):
                                                @GetProductTypeLabel(selectedProduct?.ProductType ?? CatalogProductType.Goods)
                                            </div>
                                        </div>
                                    </div>

                                    @if (editingItem.ProductionType == SkuProductionType.CompositeBundle)
                                    {
                                        <div class="mb-3 row">
                                            <label class="col-sm-2 col-form-label">
                                                @SharedDataService.SelectViewLang("Bundle Components", "مكونات الحزمة")
                                            </label>
                                            <div class="col-sm-10">
                                                <div class="erp-subpanel sku-bundle-editor">
                                                        @if (editingItem.Components.Any())
                                                        {
                                                            <div class="d-flex flex-column gap-3 mb-3">
                                                                @foreach (var component in editingItem.Components)
                                                                {
                                                                    <div class="sku-bundle-component-row">
                                                                        <div class="sku-bundle-component-picker">
                                                                            <label class="form-label small text-muted mb-1">
                                                                                @SharedDataService.SelectViewLang("Component SKU", "المنتج المخزني المكون")
                                                                            </label>
                                                                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                                                                   Items="GetAvailableComponentSkus(editingItem, component)"
                                                                                                   Value="GetComponentSku(component)"
                                                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Search a component SKU", "ابحث عن مكون")"
                                                                                                   ItemText="(sku => GetSkuDisplayName(sku))"
                                                                                                   ValueChanged="sku => OnBundleComponentSelected(component, sku)" />
                                                                        </div>

                                                                        <div class="sku-bundle-component-quantity">
                                                                            <label class="form-label small text-muted mb-1">
                                                                                @SharedDataService.SelectViewLang("Quantity", "الكمية")
                                                                            </label>
                                                                            <InputNumber class="form-control"
                                                                                         min="0.0001"
                                                                                         @bind-Value="component.Quantity" />
                                                                            <ValidationMessage For="() => component.Quantity" />
                                                                        </div>

                                                                        <div class="sku-bundle-component-action">
                                                                            <button type="button"
                                                                                    class="btn btn-outline-danger btn-sm erp-row-action"
                                                                                    @onclick="() => RemoveBundleComponent(editingItem, component)"
                                                                                    title="@SharedDataService.SelectViewLang("Remove component", "حذف المكون")">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="text-muted mb-3">
                                                                @SharedDataService.SelectViewLang("No bundle components have been added yet.", "لم تتم إضافة مكونات للحزمة بعد.")
                                                            </div>
                                                        }

                                                        <button type="button"
                                                                class="btn btn-outline-primary btn-sm"
                                                                @onclick="() => AddBundleComponent(editingItem)">
                                                            <i class="bi bi-plus"></i>
                                                            @SharedDataService.SelectViewLang("Add Component", "إضافة مكون")
                                                        </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    
                                    <div class="mb-3 row">
                                        <label for="DateOfBirth" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Photo", "الصورة")</label>
                                        <div class="col-sm-10">
                                            <label for="profileUpload" class="erp-pointer">
                                                <img src="@(string.IsNullOrEmpty(editingItem?.ImageUrl)
                                                                                                                                                         ? "_content/AlAfkarERP.Shared/images/productPlaceHolder.jpg"
                                                                                                                                                         : (editingItem.ImageUrl.Contains("data:")
                                                                                                                                                             ? editingItem.ImageUrl
                                                                                                                                                             : $"{ApiConfig.BaseURL}/Images/Products/{editingItem.ImageUrl}"))"
                                                     alt="Add product image"
                                                     height="50"
                                                     width="50"
                                                     class="erp-sku-image-upload" />

                                            </label>

                                            <InputFile id="profileUpload"
                                                       class="erp-hidden-input"
                                                       OnChange="OnProductImageSelected"
                                                       accept="image/*" />
                                            <ValidationMessage For="@(() => editingItem.ImageUrl)" class="text-danger" />
                                        </div>
                                    </div>


                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Show in store", "العرض في المتجر")</label>
                                        <div class="col-sm-10">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.ShowOnStore" />
                                            @* <ValidationMessage For="() => editingItem.ImageUrl" /> *@
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("SKU Capabilities", "إعدادات المنتج المخزني")</label>
                                        <div class="col-sm-10">
                                            <div class="erp-check-tile-group">
                                                <label class="erp-check-tile">
                                                    <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsSellable" />
                                                    <span>@SharedDataService.SelectViewLang("Sellable", "قابل للبيع")</span>
                                                </label>
                                                <label class="erp-check-tile">
                                                    <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsPurchasable" />
                                                    <span>@SharedDataService.SelectViewLang("Purchasable", "قابل للشراء")</span>
                                                </label>
                                                <label class="erp-check-tile">
                                                    <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsInventoryTracked" />
                                                    <span>@SharedDataService.SelectViewLang("Inventory tracked", "متابعة مخزونيا")</span>
                                                </label>
                                                <label class="erp-check-tile">
                                                    <InputCheckbox class="form-check-input" @bind-Value="editingItem.IsAssetTrackable" />
                                                    <span>@SharedDataService.SelectViewLang("Asset trackable", "متابعة كأصل")</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Calories", "السعرات")</label>
                                        <div class="col-sm-10">
                                            <InputNumber class="form-control" @bind-Value="editingItem.Calories" />
                                            <ValidationMessage For="() => editingItem.Calories" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Options", "الخيارات")</label>
                                        <div class="col-sm-10">
                                            <div class="erp-subpanel">
                                                    @if (editingItem.Variants.Any())
                                                    {
                                                        
                                                                <div class="erp-table-toolbar">
            <TableExportActions />
        </div>

                                                        
                                                        <table class="table erp-table mb-0">
                                                            <thead class="fw-bold">
                                                                <tr>
                                                                    @* <td class="hiding">Id</td> *@
                                                                    <td>@SharedDataService.SelectViewLang("Option", "الخيار")</td>
                                                                    <td>@SharedDataService.SelectViewLang("Value", "القيمة")</td>
                                                                    <td></td>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var value in editingItem.Variants)
                                                                {
                                                                    <tr>
                                                                        @* <td>@value.Id</td> *@
                                                                        <td>
                                                                            @SharedDataService.SelectViewLang(variants.First(v => v.Id == value.VariantId).NameEng,
                                                                                                        variants.First(v => v.Id == value.VariantId).Name)
                                                                        </td>
                                                                        <td>
                                                                            @SharedDataService.SelectViewLang(variants.First(v => v.Id == value.VariantId).Values.First(vv => vv.Id == value.VariantValueId).ValueEng,
                                                                                                        variants.First(v => v.Id == value.VariantId).Values.First(vv => vv.Id == value.VariantValueId).Value)
                                                                        </td>
                                                                        <td>
                                                                            <button type="button"
                                                            class="btn btn-outline-danger btn-sm erp-row-action"
                                                                                    @onclick="() => RemoveVariantValue(editingItem, value)">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    }

                                                        
                                                    <div class="row">
                                                        <!--المتغير-->
                                                        <div class="col-md-6 mb-3">
                                                            <label for="inputFirstName" class="col-sm-2 col-form-label">
                                                                @SharedDataService.SelectViewLang("Options", "الخيارات")
                                                            </label>
                                                            <div class="col-sm-10">
                                                                <AutoCompleteComponent TItem="VariantDto"
                                                                                       Items="variants"
                                                                                       ItemText="(v=> SharedDataService.SelectViewLang(v.NameEng,v.Name))"
                                                                                       PlaceHolder="@(SharedDataService.SelectViewLang("search an option","ابحث عن خيار"))"
                                                                                       Value="selectedVariant"
                                                                                       ValueChanged="onVariantSelected" />
                                                            </div>
                                                        </div>
                                                        <!--قيمة المتغير-->
                                                        <div class="col-md-6 mb-3">
                                                            <label for="inputFirstName" class="col-sm-2 col-form-label">
                                                                @SharedDataService.SelectViewLang("Value", "القيمة")
                                                            </label>
                                                            <div class="col-sm-10">
                                                                <AutoCompleteComponent TItem="VariantValueDto"
                                                                                       Items="variantValues"
                                                                                       ItemText="(vv=> SharedDataService.SelectViewLang(vv.ValueEng,vv.Value))"
                                                                                       PlaceHolder="@(SharedDataService.SelectViewLang("search a value","ابحث عن قيمة الخيار"))"
                                                                                       Value="selectedVariantValue"
                                                                                       ValueChanged="onVariantValueSelected" />
                                                            </div>
                                                        </div>
                                                        @* <div class="col-md-2">
                                                        </div> *@
                                                    </div>
                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm mt-2"
                                                            @onclick="() => AddVariantValue(editingItem)">
                                                        <i class="bi bi-plus"></i> Add Value
                                                    </button>

                                                        
                                                    

                                            </div>

                                        </div>
                                    </div>


                                    <div class="erp-form-actions">
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            
            @foreach (var sku in ProcessedVariants.Where(x => x.Id != editingProductSkuId))
            {
                
                <tr>
                    <td>
                        <img src="@(string.IsNullOrEmpty(sku?.ImageUrl)
                            ? "_content/AlAfkarERP.Shared/images/productPlaceHolder.jpg"
                            : (sku.ImageUrl.Contains("data:")
                                ? sku.ImageUrl
                                : $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}"))"
                             alt="Add product image"
                             class="erp-sku-image" />
                    </td>
                    <td>@SharedDataService.SelectViewLang(sku.NameEng, sku.Name)</td>
                    <td>@SharedDataService.SelectViewLang(sku.SkuCodeEng, sku.SkuCode)</td>
                    <td>@GetSkuProductionTypeLabel(sku.ProductionType)</td>
                    <td>@sku.Price</td>
                    <td>@SharedDataService.SelectViewLang(brands.FirstOrDefault(b => b.Id == sku.BrandId)?.NameEng ?? "", brands.FirstOrDefault(b => b.Id == sku.BrandId)?.Name ?? "")</td>
                    <td>
                        @if (sku.Packages.Any())
                        {
                            <div class="erp-chip-row">
                                @foreach (var package in sku.Packages)
                                {
                                    <StatusChip Tone="muted"
                                                Text="@($"{SharedDataService.SelectViewLang(package.NameEng, package.Name)} x{package.Quantity}")" />
                                }
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>@SharedDataService.SelectViewLang(units.FirstOrDefault(b => b.Id == sku.UnitId)?.UnitNameEng ?? "", units.FirstOrDefault(b => b.Id == sku.UnitId)?.UnitName ?? "")</td>
                    <td>@(sku.Calories?.ToString("N2") ?? "-")</td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm erp-row-action"
                                @onclick="() => EditProductSku(sku.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm erp-row-action"
                                @onclick="() => DeleteVariant(sku)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.ProductPermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
                
            }
        </tbody>
    </table>
    </div>
    }
    <div class="erp-pagination-bar">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

