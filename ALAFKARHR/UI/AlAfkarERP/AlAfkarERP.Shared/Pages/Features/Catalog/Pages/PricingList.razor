@layout AdminLayout
@page "/Catalog/Pricing/List"

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions
@using AlAfkarERP.Shared.Pages.Reuable2
@using SharedWithUI.Pricing.Dtos


@inject IPriceListService PriceListService
@inject IProductService ProductService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.PricingPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="erp-page">
    <PageHeader Title="@SharedDataService.SelectViewLang("Products Pricing", "تسعير المنتجات")"
                Subtitle="@SharedDataService.SelectViewLang("Maintain product price lists, effective dates, and SKU prices.", "إدارة قوائم أسعار المنتجات وتواريخ السريان وأسعار المنتجات المخزنية.")"
                Overline="@SharedDataService.SelectViewLang("Catalog", "الكتالوج")"
                Icon="bi-cash-coin">
        <Actions>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.PricingPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
            </button>
        </Actions>
    </PageHeader>

    <AppCard Title="@SharedDataService.SelectViewLang("Price Lists", "قوائم الأسعار")"
             Subtitle="@SharedDataService.SelectViewLang("Search, sort, edit, and remove price lists.", "ابحث ورتب وعدل واحذف قوائم الأسعار.")">
        <FilterBar CssClass="mb-3">
            <ChildContent>
            <div class="input-group" style="max-width: 320px;">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search prices...", "ابحث في الأسعار...")"
                       @bind="searchText" />
            </div>
            </ChildContent>
            <Actions>
                <select class="form-select" @onchange="OnPageSizeChanged" aria-label="@SharedDataService.SelectViewLang("Page size", "حجم الصفحة")">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </Actions>
        </FilterBar>

    <div class="erp-table-wrap">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table erp-table mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(PriceListDto.Name))">
                    <span class="@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")"></span>
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                </th>
                <th @onclick="() => Sort(nameof(PriceListDto.EffectiveFrom))">@SharedDataService.SelectViewLang("Effective from", "يسري من")</th>
                <th @onclick="() => Sort(nameof(PriceListDto.EffectiveTo))">@SharedDataService.SelectViewLang("Effective to", "يسري حتى")</th>
                <th @onclick="() => Sort(nameof(PriceListDto.IsDefault))">@SharedDataService.SelectViewLang("Default?", "الافتراضي؟")</th>
                @* <th>@SharedDataService.SelectViewLang("Values", "القيم")</th> *@
                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingPriceListId != null)
            {
                var editingItem = priceLists.FirstOrDefault(x => x.Id == editingPriceListId);
                if (editingItem != null)
                {
                    <tr>
                        <td colspan="4">
                            <EditForm Model="editingItem" OnValidSubmit="() => SavePriceList(editingItem)">
                                <DataAnnotationsValidator />
                                <ValidationSummary />
                                @* <InputHidden @bind-Value="branch.Id"/> *@
                                <div class="row g-3 bg-info-subtle p-3">

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="editingItem.Name" />
                                            <ValidationMessage For="() => editingItem.Name" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Effective from", "يسري من")</label>
                                        <div class="col-sm-10">
                                            <InputDate class="form-control" @bind-Value="editingItem.EffectiveFrom" />
                                            <ValidationMessage For="() => editingItem.EffectiveFrom" />
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Effective to", "يسري حتى")</label>
                                        <div class="col-sm-10">
                                            <InputDate class="form-control" @bind-Value="editingItem.EffectiveTo" />
                                            <ValidationMessage For="() => editingItem.EffectiveTo" />
                                        </div>
                                    </div>
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Products", "المنتجات")</label>
                                        <div class="col-sm-10">
                                            <div class="card bg-transparent">
                                                <div class="card-body">
                                                    
                                                    @* <div class="card bg-transparent">
                                                        <div class="card-body">
                                                        </div>
                                                    </div> *@
                                                
                                                    @foreach (var pl in editingItem.Items)
                                                    {
                                                        <div class="card mb-3" @key="pl">
                                                            <div class="card-body">
                                                                <div class="row mb-2 align-items-center">
                                                                    <div class="col-11">

                                                                        <div class="mb-3 row">
                                                                            <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Product", "المنتج")</label>
                                                                            <div class="col-sm-10">
                                                                                @if(isEdit){
                                                                                    <input type="text"
                                                                                           class="form-control"
                                                                                           value="@allProducts.FirstOrDefault(p => p.Skus.Any(s => s.Id == pl.ProductSkuId))?.Name" disabled />
                                                                                }
                                                                                else
                                                                                {
                                                                                    
                                                                                <AutoCompleteComponent TItem="ProductDto"
                                                                                                       Items="products"
                                                                                                       ItemText="p=>SharedDataService.SelectViewLang(p.NameEng,p.Name)"
                                                                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select a product","اختر المنتج")"
                                                                                                       Value="selectedProduct"
                                                                                                       ValueChanged="OnProductSelected" />
                                                                                }
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-3 row">
                                                                            <label class="col-sm-2 col-form-label">
                                                                                @SharedDataService.SelectViewLang("SKU", "المنتج المخزني")
                                                                            </label>

                                                                            <div class="col-sm-10">
                                                                                @if (isEdit)
                                                                                {
                                                                                    <input type="text"
                                                                                           class="form-control"
                                                                                           value="@allProducts.SelectMany(p => p.Skus).FirstOrDefault(s => s.Id == pl.ProductSkuId)?.Name" disabled />
                                                                                }
                                                                                else
                                                                                {
                                                                            
                                                                                <AutoCompleteComponent TItem="ProductSkuDto"
                                                                                                       Items="productSkus"
                                                                                                       ItemText="p => SharedDataService.SelectViewLang(p.NameEng, p.Name)"
                                                                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select a SKU", "اختر المنتج المخزني")"
                                                                                                       Value="productSkus.FirstOrDefault(x => x.Id == pl.ProductSkuId)"
                                                                                                       ValueChanged="sku => OnProductSkuSelected(pl, sku)" />
                                                                                }
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-3 row">
                                                                            <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Unit price", "سعر الوحدة")</label>
                                                                            <div class="col-sm-10">
                                                                                <InputNumber class="form-control"
                                                                                             @bind-Value="pl.UnitPrice" />
                                                                            </div>
                                                                        </div>

                                                                        <div class="mb-3 row">
                                                                            <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Minimum quantity", "أقل كمية")</label>
                                                                            <div class="col-sm-10">
                                                                                <InputNumber class="form-control"
                                                                                             @bind-Value="pl.MinQuantity" />
                                                                            </div>
                                                                
                                                                        </div>
                                                            
                                                                    </div>
                                                                    <div class="col-1 text-end">
                                                                        <button type="button"
                                                                                class="btn btn-danger btn-sm"
                                                                                @onclick="() => RemovePriceList(editingItem, pl)">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </div>


                                                            
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }

                                                    <button type="button"
                                                            class="btn btn-outline-primary btn-sm mt-2"
                                                            @onclick="() => AddPriceListItem(editingItem)">
                                                        <i class="bi bi-plus"></i> Add Value
                                                    </button>

                                                        
                                                    

                                                </div>
                                            </div>

                                        </div>
                                    </div>



                                    <div class="col">
                                        <button type="submit" class="btn btn-success btn-sm">Save</button>
                                        <button type="button" class="btn btn-secondary btn-sm" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>

                }

                
            }
            @foreach (var pL in ProcessedVariants.Where(x => x.Id != editingPriceListId))
            {
                
                <tr>
                    <td>@pL.Name</td>
                    <td>@pL.EffectiveFrom</td>
                    <td>@pL.EffectiveTo</td>
                    <td>@pL.IsDefault</td>
                    @* <td>
                        <div class="flex-row">
                            @foreach (var value in pL.Items)
                            {
                                <span class="badge bg-primary me-1">@SharedDataService.SelectViewLang(value.ProductSkuId, value.ProductSkuId)</span>
                            }
                        </div>
                    </td> *@
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-primary btn-sm"
                                @onclick="() => EditPriceList(pL.Id)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.PricingPermissions.Edit}"))>
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-danger btn-sm"
                                @onclick="() => DeletePriceList(pL)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.PricingPermissions.Delete}"))>
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
                
            }
        </tbody>
    </table>
    </div>
    <div class="d-flex flex-wrap justify-content-end align-items-center gap-2 mt-3">

        <button class="btn btn-sm btn-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            @SharedDataService.SelectViewLang("Previous", "السابق")
        </button>

        <span class="text-muted">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages)">
            @SharedDataService.SelectViewLang("Next", "التالي")
        </button>

    </div>
    </AppCard>
</div>

@code {
    private List<PriceListDto> priceLists = new();
    private PriceListDto priceListDto = new();
    private Guid? editingPriceListId;
    // private Guid? editingVariantValueId;
    private Guid companyId;
    private List<ProductDto> allProducts = [];
    private List<ProductDto> products = [];
    private ProductDto? selectedProduct;
    private List<ProductSkuDto> productSkus = [];
    private ProductSkuDto? selectedProductSku;
    private bool isEdit = false;
    private AuthenticationState AuthState;
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        if (prodRes.IsSuccess)
        {
            allProducts = prodRes.Data?.Data?.ToList() ?? [];
            products = prodRes.Data?.Data?.ToList() ?? [];
        }
        await LoadPriceLists();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }

    void CreateNew()
    {
        var newItem = new PriceListDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId,
            EffectiveFrom = DateTime.UtcNow,
            EffectiveTo = DateTime.UtcNow,
            Items = []
        };

        // Start with one empty row
        newItem.Items.Add(new PriceListItemDto
        {
            Id = Guid.Empty,
            PriceListId = newItem.Id
        });

        priceLists.Insert(0, newItem);
        editingPriceListId = newItem.Id;
        isEdit = false;
    }

    void EditPriceList(Guid id)
    {
        editingPriceListId = id;
        isEdit = true;
        // editingVariantValueId = variants.FirstOrDefault(v => v.Id == id)?.Values.FirstOrDefault()?.Id ?? null;
        StateHasChanged();
    }
    async Task SavePriceList(PriceListDto priceList)
    {

        if (priceList.Id == editingPriceListId && !isEdit)
        {
            //Create new

            Random rnd = new Random();

            priceList.CompanyId = companyId;

            var bResponse = await PriceListService.CreateAsync(priceList);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("PriceList has been created successfully", "تم إنشاء قائمة الأسعار بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await PriceListService.UpdateAsync(priceList);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("PriceList has been Edited successfully", "تم تعديل قائمة الاسعار بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadPriceLists();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingPriceListId = null;
    }

    async Task DeletePriceList(PriceListDto priceList)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this PriceList: {priceList.Name}?", $"هل ترغب فعلا في حذف قائمة الأسعار: {priceList.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await PriceListService.DeleteAsync(priceList.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadPriceLists();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the PriceList", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = priceLists.FirstOrDefault(x => x.Id == editingPriceListId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var varRes = await PriceListService.GetByCompanyId(companyId, 0, 1000);
            if (varRes.IsSuccess)
            {
                priceLists = varRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            priceLists.Remove(item);
        }
        isEdit = false;
        editingPriceListId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(PriceListDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadPriceLists()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await PriceListService.GetByCompanyId(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            priceLists = response.Data?.Data?.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadPriceLists();
    }
    private IEnumerable<PriceListDto> ProcessedVariants =>
    priceLists
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        // ||
        // (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)

        )

        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

    // 📄 Pagination
    // .Skip((pageIndex) * pageSize)
    // .Take(pageSize);



    // Filtering example
    // private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadPriceLists();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;

        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadPriceLists();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    private void AddPriceListItem(PriceListDto priceList)
    {
        
        selectedProduct = null;
        selectedProductSku = null;
        productSkus = [];
        priceList.Items.Add(new PriceListItemDto
        {
            Id = Guid.Empty, // VERY IMPORTANT
            UnitPrice = 0,
            MinQuantity = 0,
            PriceListId = priceList.Id
        });
    }

    private void RemovePriceList(PriceListDto pl, PriceListItemDto priceLIstItem)
    {
        pl.Items.Remove(priceLIstItem);
    }

    private void OnProductSelected(ProductDto product)
    {
        productSkus = [];
        selectedProduct = null;
        if (product != null)
        {
            selectedProduct = product;
            productSkus = selectedProduct.Skus;
        }


    }
    // private void onProductSkuSelected(ProductSkuDto sku)
    // {
    //     selectedProductSku = null;
    //     if (sku != null)
    //     {
    //         selectedProductSku = sku;
    //     }
    // }
    private void OnProductSkuSelected(PriceListItemDto item, ProductSkuDto sku)
    {
        item.ProductSkuId = Guid.NewGuid();
        item.UnitPrice = 0;
        if (sku != null)
        {
            item.ProductSkuId = sku.Id;
            item.UnitPrice = sku.Price;
            // optional if you have UnitId
            item.UnitId = sku.UnitId;
        }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
