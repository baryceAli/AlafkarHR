@layout AdminLayout
@page "/LeavesManagement/Balances"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Leave.Dtos

@inject ILeaveService LeaveService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
            <p class="text-muted mb-1">@Text("Leave Management", "إدارة الإجازات")</p>
            <h3 class="mb-1">@Text("Employee Leave Balances", "أرصدة إجازات الموظفين")</h3>
            <p class="text-muted mb-0">@Text("Configure annual leave days, carry-forward policy, and track available, taken, and remaining days.", "تكوين أيام الإجازة السنوية وسياسة الترحيل وتتبع الأيام المتاحة والمستخدمة والمتبقية.")</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@isBusy">@Text("Refresh", "تحديث")</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">@Text("Year", "السنة")</label>
                    <input class="form-control" type="number" min="2000" max="2100" @bind="year" @bind:after="LoadBalancesAsync" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@Text("Employee", "الموظف")</label>
                    <select class="form-select" @bind="model.EmployeeId">
                        <option value="@Guid.Empty">@Text("Select employee", "اختر الموظف")</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@EmployeeName(employee)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Annual days", "الأيام السنوية")</label>
                    <input class="form-control" type="number" step="0.5" min="0" @bind="model.AnnualLeaveDays" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Max carry", "حد الترحيل")</label>
                    <input class="form-control" type="number" step="0.5" min="0" @bind="model.MaxCarryForwardDays" disabled="@(!model.AllowCarryForward)" />
                </div>
                <div class="col-md-3">
                    <div class="form-check">
                        <input id="allowCarryForward" class="form-check-input" type="checkbox" @bind="model.AllowCarryForward" />
                        <label class="form-check-label" for="allowCarryForward">@Text("Carry unused days to next year", "ترحيل الأيام غير المستخدمة للسنة التالية")</label>
                    </div>
                </div>
                <div class="col-md-9 text-md-end">
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isBusy">@Text("Save configuration", "حفظ الإعداد")</button>
                    <button class="btn btn-outline-secondary" @onclick="ResetModel" disabled="@isBusy">@Text("New", "جديد")</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>@Text("Employee", "الموظف")</th>
                        <th>@Text("Year", "السنة")</th>
                        <th>@Text("Annual", "سنوي")</th>
                        <th>@Text("Carry forward", "مرحّل")</th>
                        <th>@Text("Available", "متاح")</th>
                        <th>@Text("Taken", "مستخدم")</th>
                        <th>@Text("Remaining", "متبقي")</th>
                        <th class="text-end">@Text("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (balances.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-4">@Text("No leave balances configured for this year.", "لا توجد أرصدة إجازات مكونة لهذه السنة.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var balance in balances)
                        {
                            <tr>
                                <td>@EmployeeName(balance.EmployeeId)</td>
                                <td>@balance.Year</td>
                                <td>@FormatDays(balance.AnnualLeaveDays)</td>
                                <td>@FormatDays(balance.CarriedForwardDays)</td>
                                <td>@FormatDays(balance.AvailableDays)</td>
                                <td>@FormatDays(balance.TakenDays)</td>
                                <td><span class="badge text-bg-@(balance.RemainingDays <= 0 ? "danger" : "success")">@FormatDays(balance.RemainingDays)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm" @onclick="() => Edit(balance)">@Text("Edit", "تعديل")</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private int year = DateTime.Today.Year;
    private Guid companyId;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";
    private List<EmployeeDto> employees = [];
    private List<EmployeeLeaveBalanceDto> balances = [];
    private UpsertEmployeeLeaveBalanceDto model = NewModel();

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        model.CompanyId = companyId;
        model.Year = year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        await LoadEmployeesAsync();
        await LoadBalancesAsync();
        isBusy = false;
    }

    private async Task LoadEmployeesAsync()
    {
        var result = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000);
        employees = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadBalancesAsync()
    {
        model.Year = year;
        var result = await LeaveService.GetLeaveBalancesAsync(companyId, year);
        balances = result.IsSuccess ? result.Data ?? [] : [];
        if (!result.IsSuccess)
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to load leave balances.", "تعذر تحميل أرصدة الإجازات."), "alert-danger");
        }
    }

    private async Task SaveAsync()
    {
        if (model.EmployeeId == Guid.Empty)
        {
            SetMessage(Text("Please select an employee.", "يرجى اختيار موظف."), "alert-warning");
            return;
        }

        model.CompanyId = companyId;
        model.Year = year;
        var result = await LeaveService.UpsertLeaveBalanceAsync(model);
        SetMessage(result.IsSuccess
            ? Text("Leave balance saved.", "تم حفظ رصيد الإجازة.")
            : result.Error?.Detail ?? Text("Unable to save leave balance.", "تعذر حفظ رصيد الإجازة."),
            result.IsSuccess ? "alert-success" : "alert-danger");

        if (result.IsSuccess)
        {
            ResetModel();
            await LoadBalancesAsync();
        }
    }

    private void Edit(EmployeeLeaveBalanceDto balance)
    {
        model = new UpsertEmployeeLeaveBalanceDto
        {
            Id = balance.Id,
            EmployeeId = balance.EmployeeId,
            CompanyId = balance.CompanyId,
            Year = balance.Year,
            AnnualLeaveDays = balance.AnnualLeaveDays,
            AllowCarryForward = balance.AllowCarryForward,
            MaxCarryForwardDays = balance.MaxCarryForwardDays
        };
        year = balance.Year;
    }

    private void ResetModel()
    {
        model = NewModel(companyId, year);
    }

    private static UpsertEmployeeLeaveBalanceDto NewModel(Guid companyId = default, int? year = null)
        => new()
        {
            CompanyId = companyId,
            Year = year ?? DateTime.Today.Year,
            AnnualLeaveDays = 30,
            AllowCarryForward = true,
            MaxCarryForwardDays = 5
        };

    private string EmployeeName(Guid employeeId)
        => employees.FirstOrDefault(x => x.Id == employeeId) is { } employee ? EmployeeName(employee) : employeeId.ToString();

    private string EmployeeName(EmployeeDto employee)
        => SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);

    private static string FormatDays(decimal days) => days.ToString("0.##");

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        return Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
