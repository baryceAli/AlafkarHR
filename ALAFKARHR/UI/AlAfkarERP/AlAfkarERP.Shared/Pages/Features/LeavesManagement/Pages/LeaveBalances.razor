@layout AdminLayout
@page "/LeavesManagement/Balances"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Leave.Dtos
@using SharedWithUI.Permissions

@inject ILeaveService LeaveService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Employee Leave Balances", "أرصدة إجازات الموظفين")"
                Subtitle="@Text("View annual leave balances and manage entitlement configuration when permitted.", "عرض أرصدة الإجازات السنوية وإدارة إعدادات الاستحقاق عند توفر الصلاحية.")"
                Overline="@Text("Leave Management", "إدارة الإجازات")"
                Icon="bi-calendar2-check">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard Title="@Text("Balance Filters", "عوامل تصفية الأرصدة")"
             Subtitle="@Text("Narrow the balance table by year and employee.", "تصفية جدول الأرصدة حسب السنة والموظف.")"
             CssClass="mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">@Text("Year", "السنة")</label>
                    <input class="form-control" type="number" min="2000" max="2100" @bind="year" @bind:after="LoadBalancesAsync" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@Text("Filter employee", "تصفية حسب الموظف")</label>
                    <select class="form-select" @bind="selectedEmployeeId" @bind:after="LoadBalancesAsync">
                        <option value="@Guid.Empty">@Text("All employees", "كل الموظفين")</option>
                        @foreach (var employee in employees)
                        {
                            <option value="@employee.Id">@EmployeeName(employee)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 text-md-end">
                    @if (!CanManageBalances)
                    {
                        <StatusChip Text="@Text("Read only", "للقراءة فقط")" Tone="muted" />
                    }
                </div>
            </div>
    </AppCard>

    @if (CanManageBalances)
    {
        <AppCard Title="@Text("Entitlement Configuration", "إعدادات الاستحقاق")"
                 Subtitle="@Text("Set annual days and carry-forward rules for a selected employee.", "تحديد أيام الإجازة السنوية وقواعد الترحيل للموظف المحدد.")"
                 CssClass="mb-3">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">@Text("Employee", "الموظف")</label>
                        <select class="form-select" @bind="model.EmployeeId">
                            <option value="@Guid.Empty">@Text("Select employee", "اختر الموظف")</option>
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">@EmployeeName(employee)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Text("Annual days", "الأيام السنوية")</label>
                        <input class="form-control" type="number" step="0.5" min="0" @bind="model.AnnualLeaveDays" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">@Text("Max carry", "الحد الأقصى للترحيل")</label>
                        <input class="form-control" type="number" step="0.5" min="0" @bind="model.MaxCarryForwardDays" disabled="@(!model.AllowCarryForward)" />
                    </div>
                    <div class="col-md-4">
                        <div class="form-check">
                            <input id="allowCarryForward" class="form-check-input" type="checkbox" @bind="model.AllowCarryForward" />
                            <label class="form-check-label" for="allowCarryForward">@Text("Carry unused days to next year", "ترحيل الأيام غير المستخدمة إلى السنة التالية")</label>
                        </div>
                    </div>
                    <div class="col-12 text-md-end">
                        <button class="btn btn-primary" @onclick="SaveAsync" disabled="@isBusy">
                            <i class="bi bi-save me-1"></i>@Text("Save configuration", "حفظ الإعدادات")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ResetModel" disabled="@isBusy">@Text("New", "جديد")</button>
                    </div>
                </div>
        </AppCard>
    }

    <AppCard Title="@Text("Leave Balances", "أرصدة الإجازات")"
             Subtitle="@Text("Review available, taken, and remaining leave by employee.", "مراجعة الإجازات المتاحة والمستخدمة والمتبقية حسب الموظف.")">
        <div class="erp-table-wrap">
            <table class="table erp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Text("Employee", "الموظف")</th>
                        <th>@Text("Year", "السنة")</th>
                        <th>@Text("Annual", "سنوي")</th>
                        <th>@Text("Carry forward", "مرحل")</th>
                        <th>@Text("Available", "متاح")</th>
                        <th>@Text("Taken", "مستخدم")</th>
                        <th>@Text("Remaining", "متبقي")</th>
                        @if (CanManageBalances)
                        {
                            <th class="text-end">@Text("Actions", "الإجراءات")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (balances.Count == 0)
                    {
                        <tr>
                            <td colspan="@(CanManageBalances ? 8 : 7)">
                                <EmptyState Title="@Text("No leave balances", "لا توجد أرصدة إجازات")"
                                            Message="@Text("No leave balances are configured for this filter.", "لا توجد أرصدة إجازات معدة لعوامل التصفية الحالية.")"
                                            Icon="bi-calendar-x" />
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var balance in balances)
                        {
                            <tr>
                                <td>@EmployeeName(balance.EmployeeId)</td>
                                <td>@balance.Year</td>
                                <td>@FormatDays(balance.AnnualLeaveDays)</td>
                                <td>@FormatDays(balance.CarriedForwardDays)</td>
                                <td>@FormatDays(balance.AvailableDays)</td>
                                <td>@FormatDays(balance.TakenDays)</td>
                                <td><StatusChip Text="@FormatDays(balance.RemainingDays)" Tone="@(balance.RemainingDays <= 0 ? "danger" : "success")" /></td>
                                @if (CanManageBalances)
                                {
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm" @onclick="() => Edit(balance)">
                                            <i class="bi bi-pencil"></i>
                                            @Text("Edit", "تعديل")
                                        </button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </AppCard>
</section>

@code {
    private int year = DateTime.Today.Year;
    private Guid companyId;
    private Guid selectedEmployeeId;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";
    private AuthenticationState? authState;
    private List<EmployeeDto> employees = [];
    private List<EmployeeLeaveBalanceDto> balances = [];
    private UpsertEmployeeLeaveBalanceDto model = NewModel();
    private bool CanManageBalances => authState?.User.Claims.Any(c => c.Value == PermissionList.LeavePermissions.ManageLeaveBalances) == true;

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        companyId = await ResolveCompanyIdAsync();
        model.CompanyId = companyId;
        model.Year = year;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        await LoadEmployeesAsync();
        await LoadBalancesAsync();
        isBusy = false;
    }

    private async Task LoadEmployeesAsync()
    {
        var result = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000);
        employees = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadBalancesAsync()
    {
        model.Year = year;
        Guid? employeeId = selectedEmployeeId == Guid.Empty ? null : selectedEmployeeId;
        var result = await LeaveService.GetLeaveBalancesAsync(companyId, year, employeeId);
        balances = result.IsSuccess ? result.Data ?? [] : [];
        if (!result.IsSuccess)
        {
            SetMessage(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load leave balances.", "تعذر تحميل أرصدة الإجازات."), "alert-danger");
        }
    }

    private async Task SaveAsync()
    {
        if (!CanManageBalances)
        {
            SetMessage(Text("You do not have permission to manage leave balances.", "ليست لديك صلاحية إدارة أرصدة الإجازات."), "alert-warning");
            return;
        }

        if (model.EmployeeId == Guid.Empty)
        {
            SetMessage(Text("Please select an employee.", "يرجى اختيار موظف."), "alert-warning");
            return;
        }

        model.CompanyId = companyId;
        model.Year = year;
        var result = await LeaveService.UpsertLeaveBalanceAsync(model);
        SetMessage(result.IsSuccess
            ? Text("Leave balance saved.", "تم حفظ رصيد الإجازة.")
            : result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to save leave balance.", "تعذر حفظ رصيد الإجازة."),
            result.IsSuccess ? "alert-success" : "alert-danger");

        if (result.IsSuccess)
        {
            ResetModel();
            await LoadBalancesAsync();
        }
    }

    private void Edit(EmployeeLeaveBalanceDto balance)
    {
        if (!CanManageBalances)
        {
            return;
        }

        model = new UpsertEmployeeLeaveBalanceDto
        {
            Id = balance.Id,
            EmployeeId = balance.EmployeeId,
            CompanyId = balance.CompanyId,
            Year = balance.Year,
            AnnualLeaveDays = balance.AnnualLeaveDays,
            AllowCarryForward = balance.AllowCarryForward,
            MaxCarryForwardDays = balance.MaxCarryForwardDays
        };
        year = balance.Year;
    }

    private void ResetModel()
    {
        model = NewModel(companyId, year);
    }

    private static UpsertEmployeeLeaveBalanceDto NewModel(Guid companyId = default, int? year = null)
        => new()
        {
            CompanyId = companyId,
            Year = year ?? DateTime.Today.Year,
            AnnualLeaveDays = 30,
            AllowCarryForward = true,
            MaxCarryForwardDays = 5
        };

    private string EmployeeName(Guid employeeId)
        => employees.FirstOrDefault(x => x.Id == employeeId) is { } employee ? EmployeeName(employee) : employeeId.ToString();

    private string EmployeeName(EmployeeDto employee)
        => SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);

    private static string FormatDays(decimal days) => days.ToString("0.##");

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        return Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
