@layout AdminLayout
@page "/LeavesManagement/EmergencyLeaves"
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Leave.Dtos

@inject ILeaveService LeaveService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("My Emergency Leaves", "My Emergency Leaves")"
                Subtitle="@Text("Submit emergency leave requests and follow their approval status.", "Submit emergency leave requests and follow their approval status.")"
                Overline="@Text("Leave Management", "Leave Management")"
                Icon="bi-calendar-heart">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "Refresh")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard Title="@Text("Submit Emergency Leave", "Submit Emergency Leave")"
             Subtitle="@Text("Capture the dates, reason, and optional supporting attachment.", "Capture the dates, reason, and optional supporting attachment.")"
             CssClass="mb-3">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Text("Start", "Start")</label>
                    <input class="form-control" type="date" @bind="createModel.StartDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Text("End", "End")</label>
                    <input class="form-control" type="date" @bind="createModel.EndDate" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Text("Attachment", "Attachment")</label>
                    <InputFile @key="attachmentInputKey"
                               class="form-control"
                               OnChange="OnAttachmentSelected"
                               accept="application/pdf,image/*" />
                    @if (!string.IsNullOrWhiteSpace(selectedAttachmentName))
                    {
                        <div class="form-text">@selectedAttachmentName</div>
                    }
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="CreateAsync" disabled="@isBusy">
                        <i class="bi bi-send me-1"></i>@Text("Submit", "Submit")
                    </button>
                </div>
                <div class="col-12">
                    <label class="form-label">@Text("Reason", "Reason")</label>
                    <textarea class="form-control" rows="2" @bind="createModel.Reason"></textarea>
                </div>
            </div>
    </AppCard>

    <AppCard Title="@Text("Requests", "Requests")"
             Subtitle="@Text("Filter and review your submitted emergency leave requests.", "Filter and review your submitted emergency leave requests.")">
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">@Text("Status", "Status")</label>
                    <select class="form-select" @bind="selectedStatus" @bind:after="ResetAndLoadAsync">
                        <option value="">@Text("All statuses", "All statuses")</option>
                        <option value="@AttendanceExceptionStatus.Pending">@Text("Pending", "Pending")</option>
                        <option value="@AttendanceExceptionStatus.Approved">@Text("Approved", "Approved")</option>
                        <option value="@AttendanceExceptionStatus.Rejected">@Text("Rejected", "Rejected")</option>
                    </select>
                </div>
                <div class="col-md-8 text-md-end">
                    <span class="text-muted small">@Text("Total", "Total"): @totalCount</span>
                </div>
            </div>

            @if (isBusy)
            {
                <div class="erp-loading py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="mt-2">@Text("Loading emergency leave requests...", "Loading emergency leave requests...")</div>
                </div>
            }
            else if (requests.Count == 0)
            {
                <EmptyState Title="@Text("No emergency leave requests", "No emergency leave requests")"
                            Message="@Text("Submitted emergency leave requests will appear here.", "Submitted emergency leave requests will appear here.")"
                            Icon="bi-calendar-heart" />
            }
            else
            {
                <div class="erp-table-wrap">
                    <table class="table erp-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Dates", "Dates")</th>
                                <th>@Text("Reason", "Reason")</th>
                                <th>@Text("Status", "Status")</th>
                                <th>@Text("Attachment", "Attachment")</th>
                                <th>@Text("Approver comment", "Approver comment")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in requests)
                            {
                                <tr>
                                    <td>@FormatDate(request.StartDate) - @FormatDate(request.EndDate)</td>
                                    <td>@request.Reason</td>
                                    <td><StatusChip Text="@Text(request.Status.ToString(), request.Status.ToString())" Tone="@StatusTone(request.Status)" /></td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(request.AttachmentPath))
                                        {
                                            <a href="@request.AttachmentPath" target="_blank" rel="noopener">@Text("Open", "Open")</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>@EmptyValue(request.ApproverComment)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="text-muted small">@Text("Page", "Page") @(pageIndex + 1) @Text("of", "of") @TotalPages</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || pageIndex == 0)">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || pageIndex + 1 >= TotalPages)">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
            }
    </AppCard>
</section>

@code {
    private CreateEmergencyLeaveRequestDto createModel = new() { StartDate = DateTime.Today, EndDate = DateTime.Today };
    private List<EmergencyLeaveRequestDto> requests = [];
    private const long MaxAttachmentSize = 10 * 1024 * 1024;
    private const int PageSize = 10;
    private Guid companyId;
    private IBrowserFile? selectedAttachmentFile;
    private string? selectedAttachmentName;
    private string? selectedStatus;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";
    private int attachmentInputKey;
    private int pageIndex;
    private long totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        createModel.CompanyId = companyId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        var result = await LeaveService.GetMyEmergencyLeavesAsync(companyId, pageIndex, PageSize, SelectedStatus());
        requests = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        totalCount = result.IsSuccess ? result.Data?.Count ?? 0 : 0;
        if (!result.IsSuccess)
        {
            SetMessage(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load emergency leave requests.", "Unable to load emergency leave requests."), "alert-danger");
        }

        isBusy = false;
    }

    private async Task ResetAndLoadAsync()
    {
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task CreateAsync()
    {
        if (createModel.EndDate.Date < createModel.StartDate.Date)
        {
            SetMessage(Text("End date must be on or after start date.", "End date must be on or after start date."), "alert-warning");
            return;
        }

        createModel.CompanyId = companyId;
        if (selectedAttachmentFile is not null)
        {
            if (selectedAttachmentFile.Size > MaxAttachmentSize)
            {
                SetMessage(Text("Attachment size must be 10 MB or less.", "Attachment size must be 10 MB or less."), "alert-warning");
                return;
            }

            var uploadResult = await LeaveService.UploadEmergencyLeaveAttachmentAsync(selectedAttachmentFile);
            if (!uploadResult.IsSuccess || string.IsNullOrWhiteSpace(uploadResult.Data))
            {
                SetMessage(uploadResult.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to upload attachment.", "Unable to upload attachment."), "alert-danger");
                return;
            }

            createModel.AttachmentPath = uploadResult.Data;
        }

        var result = await LeaveService.CreateEmergencyLeaveAsync(createModel);
        if (result.IsSuccess)
        {
            SetMessage(Text("Emergency leave submitted.", "Emergency leave submitted."), "alert-success");
            createModel = new() { CompanyId = companyId, StartDate = DateTime.Today, EndDate = DateTime.Today };
            selectedAttachmentFile = null;
            selectedAttachmentName = null;
            attachmentInputKey++;
            pageIndex = 0;
            await LoadAsync();
        }
        else
        {
            SetMessage(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to submit request.", "Unable to submit request."), "alert-danger");
        }
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex == 0)
        {
            return;
        }

        pageIndex--;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (pageIndex + 1 >= TotalPages)
        {
            return;
        }

        pageIndex++;
        await LoadAsync();
    }

    private void OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        selectedAttachmentFile = e.File;
        selectedAttachmentName = $"{e.File.Name} ({e.File.Size / 1024:N0} KB)";
        createModel.AttachmentPath = null;
    }

    private AttendanceExceptionStatus? SelectedStatus()
        => Enum.TryParse<AttendanceExceptionStatus>(selectedStatus, out var status) ? status : null;

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        return Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    }

    private static string StatusTone(AttendanceExceptionStatus status) => status switch
    {
        AttendanceExceptionStatus.Approved => "success",
        AttendanceExceptionStatus.Rejected => "danger",
        _ => "warning"
    };

    private static string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime date) => date.ToString("yyyy/MM/dd");

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
