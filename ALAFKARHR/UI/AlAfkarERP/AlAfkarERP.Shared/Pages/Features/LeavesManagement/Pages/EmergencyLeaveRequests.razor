@layout AdminLayout
@page "/LeavesManagement/EmergencyLeaves"
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Leave.Dtos

@inject ILeaveService LeaveService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("My Emergency Leaves", "إجازاتي الطارئة")"
                Subtitle="@Text("Submit emergency leave requests and follow their approval status.", "إرسال طلبات الإجازة الطارئة ومتابعة حالة اعتمادها.")"
                Overline="@Text("Leave Management", "إدارة الإجازات")"
                Icon="bi-calendar-heart">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard Title="@Text("Submit Emergency Leave", "إرسال إجازة طارئة")"
             Subtitle="@Text("Capture the dates, reason, and optional supporting attachment.", "تسجيل التواريخ والسبب والمرفق الداعم الاختياري.")"
             CssClass="mb-3">
        <div class="row g-3">
            <div class="col-md-3"><label class="form-label">@Text("Start", "البداية")</label><input class="form-control" type="date" @bind="createModel.StartDate" /></div>
            <div class="col-md-3"><label class="form-label">@Text("End", "النهاية")</label><input class="form-control" type="date" @bind="createModel.EndDate" /></div>
            <div class="col-md-4">
                <label class="form-label">@Text("Attachment", "المرفق")</label>
                <InputFile @key="attachmentInputKey" class="form-control" OnChange="OnAttachmentSelected" accept="application/pdf,image/*" />
                @if (!string.IsNullOrWhiteSpace(selectedAttachmentName))
                {
                    <div class="form-text">@selectedAttachmentName</div>
                }
            </div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary w-100" @onclick="CreateAsync" disabled="@isBusy"><i class="bi bi-send me-1"></i>@Text("Submit", "إرسال")</button></div>
            <div class="col-12"><label class="form-label">@Text("Reason", "السبب")</label><textarea class="form-control" rows="2" @bind="createModel.Reason"></textarea></div>
        </div>
    </AppCard>

    <AppCard Title="@Text("Requests", "الطلبات")"
             Subtitle="@Text("Filter and review your submitted emergency leave requests.", "تصفية ومراجعة طلبات الإجازة الطارئة المرسلة.")">
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-4">
                <label class="form-label">@Text("Status", "الحالة")</label>
                <select class="form-select" @bind="selectedStatus" @bind:after="ResetAndLoadAsync">
                    <option value="">@Text("All statuses", "كل الحالات")</option>
                    <option value="@AttendanceExceptionStatus.Pending">@Text("Pending", "معلق")</option>
                    <option value="@AttendanceExceptionStatus.Approved">@Text("Approved", "معتمد")</option>
                    <option value="@AttendanceExceptionStatus.Rejected">@Text("Rejected", "مرفوض")</option>
                </select>
            </div>
            <div class="col-md-8 text-md-end"><span class="text-muted small">@Text("Total", "الإجمالي"): @totalCount</span></div>
        </div>

        @if (isBusy)
        {
            <div class="erp-loading py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"></div><div class="mt-2">@Text("Loading emergency leave requests...", "جاري تحميل طلبات الإجازة الطارئة...")</div></div>
        }
        else if (requests.Count == 0)
        {
            <EmptyState Title="@Text("No emergency leave requests", "لا توجد طلبات إجازة طارئة")" Message="@Text("Submitted emergency leave requests will appear here.", "ستظهر طلبات الإجازة الطارئة المرسلة هنا.")" Icon="bi-calendar-heart" />
        }
        else
        {
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead><tr><th>@Text("Dates", "التواريخ")</th><th>@Text("Reason", "السبب")</th><th>@Text("Status", "الحالة")</th><th>@Text("Attachment", "المرفق")</th><th>@Text("Approver comment", "تعليق المعتمد")</th></tr></thead>
                    <tbody>
                        @foreach (var request in requests)
                        {
                            <tr>
                                <td>@FormatDate(request.StartDate) - @FormatDate(request.EndDate)</td>
                                <td>@request.Reason</td>
                                <td><StatusChip Text="@StatusText(request.Status)" Tone="@StatusTone(request.Status)" /></td>
                                <td>@if (!string.IsNullOrWhiteSpace(request.AttachmentPath)){<a href="@request.AttachmentPath" target="_blank" rel="noopener">@Text("Open", "فتح")</a>}else{<span class="text-muted">-</span>}</td>
                                <td>@EmptyValue(request.ApproverComment)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="text-muted small">@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>
                <div class="btn-group btn-group-sm"><button class="btn btn-outline-secondary" @onclick="PreviousPageAsync" disabled="@(isBusy || pageIndex == 0)"><i class="bi bi-chevron-left"></i></button><button class="btn btn-outline-secondary" @onclick="NextPageAsync" disabled="@(isBusy || pageIndex + 1 >= TotalPages)"><i class="bi bi-chevron-right"></i></button></div>
            </div>
        }
    </AppCard>
</section>

@code {
    private CreateEmergencyLeaveRequestDto createModel = new() { StartDate = DateTime.Today, EndDate = DateTime.Today };
    private List<EmergencyLeaveRequestDto> requests = [];
    private const long MaxAttachmentSize = 10 * 1024 * 1024;
    private const int PageSize = 10;
    private Guid companyId;
    private IBrowserFile? selectedAttachmentFile;
    private string? selectedAttachmentName;
    private string? selectedStatus;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";
    private int attachmentInputKey;
    private int pageIndex;
    private long totalCount;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));

    protected override void OnInitialized() => SharedDataService.OnChange1 += HandleChangeAsync;

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        createModel.CompanyId = companyId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        var result = await LeaveService.GetMyEmergencyLeavesAsync(companyId, pageIndex, PageSize, SelectedStatus());
        requests = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        totalCount = result.IsSuccess ? result.Data?.Count ?? 0 : 0;
        if (!result.IsSuccess) SetMessage(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load emergency leave requests.", "تعذر تحميل طلبات الإجازة الطارئة."), "alert-danger");
        isBusy = false;
    }

    private async Task ResetAndLoadAsync() { pageIndex = 0; await LoadAsync(); }

    private async Task CreateAsync()
    {
        if (createModel.EndDate.Date < createModel.StartDate.Date)
        {
            SetMessage(Text("End date must be on or after start date.", "يجب أن يكون تاريخ النهاية بعد تاريخ البداية أو مساويا له."), "alert-warning");
            return;
        }

        createModel.CompanyId = companyId;
        if (selectedAttachmentFile is not null)
        {
            if (selectedAttachmentFile.Size > MaxAttachmentSize)
            {
                SetMessage(Text("Attachment size must be 10 MB or less.", "يجب ألا يتجاوز حجم المرفق 10 ميجابايت."), "alert-warning");
                return;
            }

            var uploadResult = await LeaveService.UploadEmergencyLeaveAttachmentAsync(selectedAttachmentFile);
            if (!uploadResult.IsSuccess || string.IsNullOrWhiteSpace(uploadResult.Data))
            {
                SetMessage(uploadResult.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to upload attachment.", "تعذر رفع المرفق."), "alert-danger");
                return;
            }

            createModel.AttachmentPath = uploadResult.Data;
        }

        var result = await LeaveService.CreateEmergencyLeaveAsync(createModel);
        if (result.IsSuccess)
        {
            SetMessage(Text("Emergency leave submitted.", "تم إرسال الإجازة الطارئة."), "alert-success");
            createModel = new() { CompanyId = companyId, StartDate = DateTime.Today, EndDate = DateTime.Today };
            selectedAttachmentFile = null;
            selectedAttachmentName = null;
            attachmentInputKey++;
            pageIndex = 0;
            await LoadAsync();
        }
        else
        {
            SetMessage(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to submit request.", "تعذر إرسال الطلب."), "alert-danger");
        }
    }

    private async Task PreviousPageAsync() { if (pageIndex == 0) return; pageIndex--; await LoadAsync(); }
    private async Task NextPageAsync() { if (pageIndex + 1 >= TotalPages) return; pageIndex++; await LoadAsync(); }
    private void OnAttachmentSelected(InputFileChangeEventArgs e) { selectedAttachmentFile = e.File; selectedAttachmentName = $"{e.File.Name} ({e.File.Size / 1024:N0} KB)"; createModel.AttachmentPath = null; }
    private AttendanceExceptionStatus? SelectedStatus() => Enum.TryParse<AttendanceExceptionStatus>(selectedStatus, out var status) ? status : null;
    private async Task<Guid> ResolveCompanyIdAsync() { var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync(); return Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty; }
    private string StatusText(AttendanceExceptionStatus status) => status switch { AttendanceExceptionStatus.Pending => Text("Pending", "معلق"), AttendanceExceptionStatus.Approved => Text("Approved", "معتمد"), AttendanceExceptionStatus.Rejected => Text("Rejected", "مرفوض"), _ => status.ToString() };
    private static string StatusTone(AttendanceExceptionStatus status) => status switch { AttendanceExceptionStatus.Approved => "success", AttendanceExceptionStatus.Rejected => "danger", _ => "warning" };
    private static string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime date) => date.ToString("yyyy/MM/dd");
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
