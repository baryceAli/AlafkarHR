@layout AdminLayout
@page "/Employee/AcademicInistitution/List";

@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions


@inject IAcademicInistitutionService AcademicInistitutionService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == PermissionList.AcademicInistitutionPermissions.View) )
{
    <div class="alert alert-warning">
        <span>
            @SharedDataService.SelectViewLang("You don't have permissions to view this page",
            "ليس لديك الصلاحية لعرض هذه الصفحة")
        </span>
    </div>
    return;
}
<div class="employee-lookup-page" dir="@SharedDataService.PageDirection">
    <div class="employee-lookup-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Employee Setup", "اعدادات الموظفين")</div>
            <h3 class="mb-1">@Text("Academic Institution Management", "ادارة المؤسسات التعليمية")</h3>
            <div class="text-muted">@Text("Maintain the education institutions used in employee qualification records.", "ادارة المؤسسات التعليمية المستخدمة في مؤهلات الموظفين.")</div>
        </div>
        <button class="btn btn-primary"
                @onclick="CreateNew"
                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.AcademicInistitutionPermissions.Create))">
            <i class="bi bi-plus-lg"></i>
            @Text("Create New", "اضافة جديد")
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="employee-lookup-stat border-primary">
                <div class="employee-lookup-stat-icon text-primary"><i class="bi bi-bank"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Institutions", "المؤسسات المعروضة")</div>
                    <div class="employee-lookup-stat-value">@academicInstitutions.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-success">
                <div class="employee-lookup-stat-icon text-success"><i class="bi bi-type"></i></div>
                <div>
                    <div class="text-muted small">@Text("Arabic Names", "اسماء عربية")</div>
                    <div class="employee-lookup-stat-value">@academicInstitutions.Count(a => !string.IsNullOrWhiteSpace(a.Name))</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-info">
                <div class="employee-lookup-stat-icon text-info"><i class="bi bi-translate"></i></div>
                <div>
                    <div class="text-muted small">@Text("English Names", "اسماء انجليزية")</div>
                    <div class="employee-lookup-stat-value">@academicInstitutions.Count(a => !string.IsNullOrWhiteSpace(a.NameEng))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="employee-lookup-toolbar mb-3">
                <div class="employee-lookup-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search academic institutions...", "بحث في المؤسسات التعليمية...")"
                           @bind="searchText" />
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select employee-lookup-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

    <div class="table-responsive">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table employee-lookup-table align-middle mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(AcademicInstitutionDto.Name))" class="sortable">
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                    <i class="@SortIcon(nameof(AcademicInstitutionDto.Name))"></i>
                </th>
                <th @onclick="() => Sort(nameof(AcademicInstitutionDto.NameEng))" class="sortable">
                    @SharedDataService.SelectViewLang("Name (Eng.)", "الاسم بالانجليزية")
                    <i class="@SortIcon(nameof(AcademicInstitutionDto.NameEng))"></i>
                </th>
                <th class="text-center">@Text("Actions", "الاجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @if (editingAcademicInstitutionId != null)
            {
                var academic = academicInstitutions.First(b => b.Id == editingAcademicInstitutionId);
                <tr>
                    <td colspan="3">
                        <EditForm Model="academic" OnValidSubmit="() => SaveAcademicInstitution(academic)">
                            <DataAnnotationsValidator />
                            @* <ValidationSummary /> *@

                            <div class="employee-lookup-edit-panel">

                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label">
                                        @SharedDataService.SelectViewLang("Name (Ar)", "الاسم (ع)")
                                    </label>
                                    <div class="col-sm-10">
                                        <InputText class="form-control" @bind-Value="academic.Name" />
                                        <ValidationMessage For="() => academic.Name" />
                                            
                                    </div>
                                </div>

                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label">
                                        @SharedDataService.SelectViewLang("Name (eng)", "الاسم (e)")
                                    </label>
                                    <div class="col-sm-10">
                                        <InputText class="form-control" @bind-Value="academic.NameEng" />
                                        <ValidationMessage For="() => academic.NameEng" />
                                    </div>
                                </div>
                                    
                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-10">
                                        <button type="submit" class="btn btn-success btn-sm">
                                            <i class="bi bi-check-lg"></i>
                                            @SharedDataService.SelectViewLang("Save", "حفظ")
                                        </button>

                                        <button type="button"
                                                class="btn btn-outline-secondary btn-sm"
                                                @onclick="CancelEdit">
                                            <i class="bi bi-x-lg"></i>
                                            @SharedDataService.SelectViewLang("Cancel", "إلغاء")
                                        </button>
                                    </div>
                                </div>

                                    
                            </div>
                        </EditForm>
                    </td>
                </tr>
            }
                
            @foreach (var academic in ProcessedAcademicInistitutions.Where(a=> a.Id!= editingAcademicInstitutionId))
            {
                
                <tr>
                    <td class="fw-semibold">@EmptyValue(academic.Name)</td>
                    <td>@EmptyValue(academic.NameEng)</td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm employee-lookup-action"
                                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.AcademicInistitutionPermissions.Edit))"
                                @onclick="() => EditAcademicInstitution(academic.Id)"
                                title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm employee-lookup-action"
                                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.AcademicInistitutionPermissions.Delete))"
                                @onclick="() => DeleteAcademicInstitution(academic)"
                                title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
                
            }

        </tbody>
    </table>
    </div>
    <div class="employee-lookup-pagination">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            <i class="bi bi-chevron-left"></i> @Text("Previous", "السابق")
        </button>

        <span class="mx-3">@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @Text("Next", "التالي") <i class="bi bi-chevron-right"></i>
        </button>

    </div>
        </div>
    </div>
</div>

<style>
    .employee-lookup-page { max-width: 1320px; }
    .employee-lookup-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .employee-lookup-stat { align-items: center; background: var(--erp-surface); border-inline-start: 4px solid; border-radius: var(--erp-radius-lg); box-shadow: var(--erp-shadow-sm); display: flex; gap: 0.875rem; min-height: 86px; padding: 1rem; }
    .employee-lookup-stat-icon { align-items: center; background: var(--erp-surface-muted); border-radius: var(--erp-radius-lg); display: inline-flex; font-size: 1.4rem; height: 44px; justify-content: center; width: 44px; }
    .employee-lookup-stat-value { color: var(--erp-text); font-size: 1.55rem; font-weight: 700; line-height: 1.1; }
    .employee-lookup-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; }
    .employee-lookup-search { flex: 1 1 320px; position: relative; }
    .employee-lookup-search i { color: var(--erp-text-muted); inset-inline-start: 0.85rem; position: absolute; top: 50%; transform: translateY(-50%); }
    .employee-lookup-search .form-control { padding-inline-start: 2.5rem; }
    .employee-lookup-page-size { min-width: 86px; }
    .employee-lookup-table thead th { background: var(--erp-surface-muted); color: var(--erp-text-muted); font-size: 0.82rem; font-weight: 700; letter-spacing: 0; text-transform: uppercase; white-space: nowrap; }
    .employee-lookup-table .sortable { cursor: pointer; user-select: none; }
    .employee-lookup-table tbody tr:hover { background: var(--erp-surface-muted); }
    .employee-lookup-edit-panel { background: var(--erp-surface-muted); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); padding: 1rem; }
    .employee-lookup-action { align-items: center; display: inline-flex; height: 32px; justify-content: center; padding: 0; width: 36px; }
    .employee-lookup-pagination { align-items: center; border-top: 1px solid var(--erp-border); display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; margin-top: 1rem; padding-top: 1rem; }
    [dir="rtl"] .employee-lookup-stat { border-inline-start: 0; border-inline-end: 4px solid; }
    [dir="rtl"] .employee-lookup-search i { inset-inline-start: auto; inset-inline-end: 0.85rem; }
    [dir="rtl"] .employee-lookup-search .form-control { padding-inline-start: 0.75rem; padding-inline-end: 2.5rem; }
</style>

@code {
    private List<AcademicInstitutionDto> academicInstitutions = new();
    private Guid? editingAcademicInstitutionId;
    private Guid companyId;
    private AuthenticationState AuthState;

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadAcademicInstitutions();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }
    // Branch
    void CreateNew()
    {
        var newItem = new AcademicInstitutionDto
        {
            Id = Guid.Empty // IMPORTANT FIX
        };

        academicInstitutions.Insert(0, newItem);
        editingAcademicInstitutionId = newItem.Id;
    }
    void EditAcademicInstitution(Guid id) => editingAcademicInstitutionId = id;

    async Task SaveAcademicInstitution(AcademicInstitutionDto academic)
    {
        if (academic.Id == Guid.Empty)
        {
            Random rnd = new Random();
            // academic.Code = academic.Title.Substring(0, 1) + rnd.Next(100, 999);
            academic.CompanyId = companyId;

            var bResponse = await AcademicInistitutionService.CreateAsync(academic);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Academic Institution has been created successfully", "تم انشاء المؤسسة التعليمية بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {

            var bresponse = await AcademicInistitutionService.UpdateAsync(academic);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Academic Institution has been Edited successfully", "تم تعديل المؤسسة التعليمية بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadAcademicInstitutions();

        editingAcademicInstitutionId = null;
    }

    async Task DeleteAcademicInstitution(AcademicInstitutionDto academic)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Academic Institution: {academic.NameEng}?",
                                                        $"هل ترغب فعلا في حذف المؤسسة التعليمية: {academic.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await AcademicInistitutionService.DeleteAsync(academic.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadAcademicInstitutions();
                    await InvokeAsync(StateHasChanged);
                    // var response = await BranchService.GetByCompanyIdAsync(companyId);
                    // if (response.IsSuccess)
                    // {
                    //     branches = response.Data?.ToList() ?? [];
                    //     await InvokeAsync(StateHasChanged);
                    // }
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the position", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }

    async Task CancelEdit()
    {
        var item = academicInstitutions.FirstOrDefault(x => x.Id == editingAcademicInstitutionId);

        if (item != null && item.Id != Guid.Empty)
        {
            // optional: reload from DB if needed

        }

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var acaRes = await AcademicInistitutionService.GetByCompanyAsync(companyId, 0, 1000);
            if (acaRes.IsSuccess)
            {
                academicInstitutions = acaRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            academicInstitutions.Remove(item);
        }

        editingAcademicInstitutionId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(AcademicInstitutionDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadAcademicInstitutions()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await AcademicInistitutionService.GetByCompanyAsync(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            academicInstitutions = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadAcademicInstitutions();
    }
    private IEnumerable<AcademicInstitutionDto> ProcessedAcademicInistitutions =>
    academicInstitutions
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        )


        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadAcademicInstitutions();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadAcademicInstitutions();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
