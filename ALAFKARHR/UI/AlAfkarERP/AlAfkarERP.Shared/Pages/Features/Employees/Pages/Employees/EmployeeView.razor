@layout ViewEmpLayout
@page "/Employee/Employee/view/{Id:guid}"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.Employees.Dtos

@inject IEmployeeService EmployeeService
@inject SharedDataService SharedDataService

@inject ApiConfig ApiConfig

<main class="employee-public-page d-flex justify-content-center align-items-center mx-3" dir="rtl">
   
    @* Public employee card content *@
    @if (employee != null)
    {
        <div class="card shadow employee-public-card">
            @* <img src="@(string.IsNullOrEmpty(employee?.PhotoUrl)
                                                                 ? "_content/AlAfkarERP.Shared/images/empPlaceholder.png"
                                                                 : (employee.PhotoUrl.Contains("data:")
                                                                     ? employee.PhotoUrl
                                                                     : $"{ApiConfig.BaseURL}/Images/Employees/{employee.PhotoUrl}"))"
                class="card-img-top" alt="..."> *@
            <div class="card-header" dir="ltr">
                <div class="row">
                    <div class="col-4 text-start">
                        <img src="_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" alt="Alternate Text" width="56" height="56" />
                    </div>
                    <div class="col-8 text-end">
                        <h3><strong>شركة الافكار الناجحة</strong></h3>
                        @* <p><strong>Successfull Ideas Trading Co.</strong></p> *@
                    </div>
                    
                </div>

                
            </div>
            <div class="card-body">
                        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

                <table class="table table-striped">
                    <tbody>
                        <tr>
                            <td>
                                <strong>اسم الموظف</strong>
                            </td>
                            <td>@employee.FullName</td>
                        </tr>
                        <tr>
                            <td><strong>رقم الهوية</strong></td>
                            <td>@employee.NationalId</td>
                        </tr>
                        <tr>
                            <td><strong>الجنسية</strong></td>
                            <td>@employee.Nationality</td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(employee.PositionName) || !string.IsNullOrWhiteSpace(employee.PositionNameEng))
                        {
                            <tr>
                                <td><strong>المسمى الوظيفي</strong></td>
                                <td>@SharedDataService.SelectViewLang(employee.PositionNameEng ?? "", employee.PositionName ?? "")</td>
                            </tr>
                            
                        }
                        @if (!string.IsNullOrWhiteSpace(employee.BranchName) || !string.IsNullOrWhiteSpace(employee.BranchLocation))
                        {
                            <tr>
                                <td class="employee-label-cell"><strong>الموقع الوظيفي</strong></td>
                                <td>@employee.BranchName@if (!string.IsNullOrWhiteSpace(employee.BranchLocation)) { <span> - @employee.BranchLocation</span> }</td>
                            </tr>
                        }
                    </tbody>
                </table>

               
            </div>
            <div class="card-footer" dir="ltr">
                <div class="row">
                    <div class="col-6 text-start">
                        <p>info@al-afkar.sa</p>
                    </div>
                    <div class="col-6 text-end">
                        <p>تـ 0580007040</p>
                    </div>
                </div>
            </div>
        
        </div>
    }
    else if (isLoading)
    {
        <div class="card employee-public-card-sm">
            @* <img src="_content/AlAfkarERP.Shared/images/empPlaceholder.png" class="card-img-top" alt="..."> *@
            <div class="card-body">
                <h5 class="card-title text-center">جاري تحميل البيانات .. الرجاء الانتظار</h5>
                <p class="card-text"></p>
                @* <a href="#" class="btn btn-primary">Go somewhere</a> *@
            </div>
        </div>
    }
    else
    {
        <div class="card employee-public-card-sm">
            @* <img src="_content/AlAfkarERP.Shared/images/empPlaceholder.png" class="card-img-top" alt="..."> *@
            <div class="card-body">
                <h5 class="card-title text-center">غير معروف</h5>
                <p class="card-text"></p>
                @* <a href="#" class="btn btn-primary">Go somewhere</a> *@
            </div>
        </div>
    }
</main>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PublicEmployeeViewDto? employee;
    private bool isLoading = false;
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        var empRes = await EmployeeService.GetPublicViewAsync(Id);
        if (empRes.IsSuccess)
        {
            employee = empRes.Data ?? null;
        }
        isLoading = false;
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
