@layout AdminLayout
@page "/Employee/Employee/List"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions

@inject IEmployeeService EmployeeService
@inject IPositionService PositionService
@inject ToastService ToastService
@inject ModalService ModalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService



@if (!CanViewEmployees)
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>
    return;
}

<h5>@SharedDataService.SelectViewLang("Employees Management", "ادارة الموظفين")</h5>

<button class="btn btn-primary mb-3"
        @onclick="CreateNew"
        disabled="@(!CanCreateEmployee)">
    <i class="bi bi-file-earmark-plus-fill"></i> @(SharedDataService.Language == "Ar" ? "إضافة جديد" : "Create New")
</button>

<div class="card p-3 mb-3">
    <div class="d-flex justify-content-between align-items-center mb-3 gap-2">
        <input class="form-control"
               placeholder="Search..."
               @bind="searchText" />

        <select class="form-select" style="max-width: 100px;" @onchange="OnPageSizeChanged">
            <option value="5" selected="@(pageSize==5)">5</option>
            <option value="10" selected="@(pageSize==10)">10</option>
            <option value="20" selected="@(pageSize==20)">20</option>
            <option value="50" selected="@(pageSize==50)">50</option>
            <option value="100" selected="@(pageSize==100)">100</option>
        </select>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!employees.Any())
    {
        <div class="alert alert-info">
            @SharedDataService.SelectViewLang("No employees found", "لم يتم العثور على موظفين")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>@SharedDataService.SelectViewLang("EmployeeNo", "الرقم الوظيفي")</th>
                        <th @onclick="() => Sort(nameof(EmployeeDto.FullName))" class="cursor-pointer">
                            <span class=@(sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down")></span>
                            @SharedDataService.SelectViewLang("Name", "الاسم")
                        </th>
                        <th>@SharedDataService.SelectViewLang("DOB", "الميلاد")</th>
                        @* <th>@SharedDataService.SelectViewLang("Email", "الايميل")</th> *@
                        <th>@SharedDataService.SelectViewLang("Phone", "الهاتف")</th>
                        <th>@SharedDataService.SelectViewLang("Hire Date", "تاريخ التعيين")</th>
                        <th @onclick="() => Sort(nameof(EmployeeDto.PositionName))" class="cursor-pointer">
                            @SharedDataService.SelectViewLang("Position", "المسمى الوظيفي")
                        </th>
                        <th class="text-center">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in ProcessedEmployees)
                    {
                        <tr>
                            <td>@emp.EmployeeNo</td>
                            <td>@emp.FullName</td>
                            <td>@FormatDate(emp.DateOfBirth)</td>
                            @* <td>@emp.Email</td> *@
                            <td>@emp.Phone</td>
                            <td>@FormatDate(emp.HireDate)</td>
                            <td>@GetPositionName(emp.PositionId)</td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-info" href="Employee/Employee/view/@emp.Id" title="@SharedDataService.SelectViewLang("View", "عرض")">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button class="btn btn-warning"
                                            @onclick="() => EditEmployee(emp.Id)"
                                            disabled="@(!CanEditEmployee)"
                                            title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-danger"
                                            @onclick="() => DeleteEmployee(emp)"
                                            disabled="@(!CanDeleteEmployee)"
                                            title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <a class="btn btn-secondary" href="Employee/Employee/QR/@emp.Id" title="@SharedDataService.SelectViewLang("QR Code", "QR")">
                                        <i class="bi bi-qr-code"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-3">
        <div>
            <span class="text-muted">
                @SharedDataService.SelectViewLang(
                    $"Showing {(pageIndex * pageSize) + 1} to {Math.Min((pageIndex + 1) * pageSize, (int)totalCount)} of {totalCount}",
                    $"عرض {(pageIndex * pageSize) + 1} إلى {Math.Min((pageIndex + 1) * pageSize, (int)totalCount)} من {totalCount}")
            </span>
        </div>
        <div>
            <button class="btn btn-sm btn-secondary"
                    @onclick="PrevPage"
                    disabled="@(pageIndex == 0)">
                <i class="bi bi-chevron-left"></i> @SharedDataService.SelectViewLang("Previous", "السابق")
            </button>

            <span class="mx-3">@SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @TotalPages</span>

            <button class="btn btn-sm btn-secondary"
                    @onclick="NextPage"
                    disabled="@(pageIndex >= TotalPages - 1)">
                @SharedDataService.SelectViewLang("Next", "التالي") <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

@code {
    private List<PositionDto> positions = [];
    private List<EmployeeDto> employees = [];
    private Dictionary<Guid, string> positionCache = new();

    private Guid companyId;
    private AuthenticationState AuthState;
    private bool isLoading = false;
    private long totalCount = 0;

    // Search, Sort, Pagination
    private string searchText = "";
    private string sortColumn = nameof(EmployeeDto.FullName);
    private bool sortAscending = true;
    private int pageSize = 10;
    private int pageIndex = 0;
    private int TotalPages => (int)Math.Ceiling(totalCount / (double)pageSize);

    // Permission Helpers
    private bool CanViewEmployees => HasPermission(PermissionList.EmployeePermissions.View);
    private bool CanCreateEmployee => HasPermission(PermissionList.EmployeePermissions.Create);
    private bool CanEditEmployee => HasPermission(PermissionList.EmployeePermissions.Edit);
    private bool CanDeleteEmployee => HasPermission(PermissionList.EmployeePermissions.Delete);

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        await LoadPositions();
        await LoadEmployees();
    }

    private async Task LoadPositions()
    {
        var posRes = await PositionService.GetAsync(companyId, 0, 1000);
        if (posRes.IsSuccess)
        {
            positions = posRes.Data?.Data?.ToList() ?? [];
            BuildPositionCache();
        }
    }

    private void BuildPositionCache()
    {
        positionCache.Clear();
        foreach (var position in positions)
        {
            positionCache[position.Id] = SharedDataService.Language == "Ar" ? position.Title : position.TitleEng;
        }
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        var response = await EmployeeService.GetByCompanyIdAsync(companyId, pageIndex, pageSize);

        if (response.IsSuccess)
        {
            employees = response.Data?.Data.ToList() ?? [];
            totalCount = response.Data?.Count ?? 0;
        }
        else
        {
            employees = [];
            totalCount = 0;
        }

        isLoading = false;
    }

    private IEnumerable<EmployeeDto> ProcessedEmployees =>
        employees
            .Where(emp =>
                string.IsNullOrWhiteSpace(searchText) ||
                (emp.FullName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.EmployeeNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.Email?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.PositionName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            )
            .OrderByDynamic(sortColumn, sortAscending);

    private bool HasPermission(string permission) =>
        AuthState?.User.Claims.Any(c => c.Value == permission) ?? false;

    private string GetPositionName(Guid? positionId) =>
        positionId.HasValue && positionCache.TryGetValue(positionId.Value, out var name) ? name : "";

    private string FormatDate(DateTime date) => date.ToString("yyyy/MM/dd");

    void CreateNew() => NavigationManager.NavigateTo("/Employee/Employee/Form");

    void EditEmployee(Guid id) => NavigationManager.NavigateTo($"/Employee/Employee/Form/{id}");

    async Task DeleteEmployee(EmployeeDto employee)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang(
                $"Are you sure you want to delete this employee: {employee.FullName}?",
                $"هل ترغب فعلا في حذف الموظف: {employee.FullName}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),
            OnOk = async () => await ConfirmDelete(employee)
        });
    }

    private async Task ConfirmDelete(EmployeeDto employee)
    {
        var response = await EmployeeService.DeleteAsync(employee.Id);
        if (response.IsSuccess)
        {
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                Type = "success"
            });
            await LoadEmployees();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Fail to delete the employee", "فشلت عملية الحذف"),
                Type = "error"
            });
        }
    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "10");
        pageIndex = 0;
        await LoadEmployees();
    }

    async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadEmployees();
        }
    }

    async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadEmployees();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
