@layout AdminLayout
@implements IDisposable
@page "/Employee/Employee/List"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions

@inject IEmployeeService EmployeeService
@inject IPositionService PositionService
@inject IBranchService BranchService
@inject ToastService ToastService
@inject ModalService ModalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (AuthState is null)
{
    <div class="erp-loading">
        <div class="spinner-border text-primary" role="status"></div>
        <div class="mt-2">@Text("Loading employees...", "جاري تحميل الموظفين...")</div>
    </div>
}
else if (!CanViewEmployees)
{
    <div class="alert alert-warning">
        <span>@Text("You don't have permissions to view this page", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <AppPageMessage Message="@errorMessage"
                    Type="error"
                    Direction="@SharedDataService.PageDirection"
                    Dismissible="false" />
}
else
{
    <div class="erp-page employee-list-page" dir="@SharedDataService.PageDirection">
        <PageHeader Title="@Text("Employees Management", "إدارة الموظفين")"
                    Subtitle="@Text("Manage employee profiles, positions, hire dates, and quick actions.", "إدارة ملفات الموظفين والمسميات وتواريخ التعيين والإجراءات السريعة.")"
                    Overline="@Text("People", "الأفراد")"
                    Icon="bi-person-badge">
            <Actions>
                <button class="btn btn-outline-secondary" @onclick="LoadEmployees" disabled="@isLoading">
                    <i class="bi bi-arrow-clockwise"></i>
                    @Text("Refresh", "تحديث")
                </button>
                <button class="btn btn-primary"
                        @onclick="CreateNew"
                        disabled="@(!CanCreateEmployee)">
                    <i class="bi bi-plus-lg"></i>
                    @Text("Create New", "إضافة جديد")
                </button>
            </Actions>
        </PageHeader>

        <div class="employee-list-stats">
            <StatsCard Title="@Text("Total Employees", "إجمالي الموظفين")"
                       Value="@FormatCount(totalCount)"
                       Subtitle="@Text("Records in this company", "السجلات في هذه الشركة")"
                       Icon="bi-people"
                       Tone="primary" />
            <StatsCard Title="@Text("With Position", "لديهم مسمى")"
                       Value="@FormatCount(employees.Count(e => e.PositionId.HasValue))"
                       Subtitle="@Text("Visible page records", "سجلات الصفحة الحالية")"
                       Icon="bi-briefcase"
                       Tone="success" />
            <StatsCard Title="@Text("With Phone", "لديهم هاتف")"
                       Value="@FormatCount(employees.Count(e => !string.IsNullOrWhiteSpace(e.Phone)))"
                       Subtitle="@Text("Visible page records", "سجلات الصفحة الحالية")"
                       Icon="bi-telephone"
                       Tone="info" />
        </div>

        <AppCard Title="@Text("Employees", "الموظفون")"
                 Subtitle="@Text("Search, review, and open employee actions without leaving the workflow.", "ابحث وراجع وافتح إجراءات الموظفين دون مغادرة مسار العمل.")">
            <FilterBar CssClass="mb-3 employee-filter-bar">
                <ChildContent>
                    <div class="employee-search">
                        <i class="bi bi-search"></i>
                        <input class="form-control"
                               placeholder="@Text("Search by employee name, number, email, or position...", "بحث باسم الموظف أو رقمه أو البريد أو المسمى...")"
                               @bind="searchText"
                               @bind:event="oninput" />
                    </div>
                </ChildContent>
                <Actions>
                    <div class="employee-page-size-control">
                        <label class="text-muted small mb-0" for="employee-branch-filter">@Text("Branch", "الفرع")</label>
                        <select id="employee-branch-filter" class="form-select erp-page-size-select" @onchange="OnBranchFilterChanged" value="@branchFilterText">
                            @if (canViewAllBranches)
                            {
                                <option value="">@Text("All", "الكل")</option>
                            }
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.Id">@Text(branch.NameEng, branch.Name)</option>
                            }
                        </select>
                    </div>
                    <TableExportActions />
                    <div class="employee-page-size-control">
                        <label class="text-muted small mb-0" for="employee-page-size">@Text("Rows", "الصفوف")</label>
                        <select id="employee-page-size" class="form-select erp-page-size-select" @onchange="OnPageSizeChanged" value="@pageSize">
                            <option value="5">5</option>
                            <option value="10">10</option>
                            <option value="20">20</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                </Actions>
            </FilterBar>

            @if (isLoading)
            {
                <div class="erp-loading py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <div class="mt-2">@Text("Loading employees...", "جاري تحميل الموظفين...")</div>
                </div>
            }
            else if (!employees.Any())
            {
                <EmptyState Title="@Text("No employees found", "لم يتم العثور على موظفين")"
                            Message="@Text("Create the first employee record when you are ready.", "يمكنك إنشاء أول سجل موظف عندما تكون جاهزا.")"
                            Icon="bi-person-plus">
                    <Actions>
                        @if (CanCreateEmployee)
                        {
                            <button class="btn btn-primary" @onclick="CreateNew">
                                <i class="bi bi-plus-lg"></i>
                                @Text("Create New", "إضافة جديد")
                            </button>
                        }
                    </Actions>
                </EmptyState>
            }
            else if (!ProcessedEmployees.Any())
            {
                <EmptyState Title="@Text("No matching employees", "لا توجد نتائج مطابقة")"
                            Message="@Text("Try a different name, employee number, email, or position.", "جرب اسما أو رقما وظيفيا أو بريدا أو مسمى مختلفا.")"
                            Icon="bi-search" />
            }
            else
            {
                <div class="erp-table-wrap">
                    <table class="table erp-table employee-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Employee No", "الرقم الوظيفي")</th>
                                <th @onclick="() => Sort(nameof(EmployeeDto.FullName))" class="sortable">
                                    @Text("Name", "الاسم")
                                    <i class="@SortIcon(nameof(EmployeeDto.FullName))"></i>
                                </th>
                                <th>@Text("DOB", "الميلاد")</th>
                                <th>@Text("Phone", "الهاتف")</th>
                                <th>@Text("Hire Date", "تاريخ التعيين")</th>
                                <th>@Text("Branch", "الفرع")</th>
                                <th @onclick="() => Sort(nameof(EmployeeDto.PositionName))" class="sortable">
                                    @Text("Position", "المسمى الوظيفي")
                                    <i class="@SortIcon(nameof(EmployeeDto.PositionName))"></i>
                                </th>
                                <th class="text-end">@Text("Actions", "الإجراءات")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in ProcessedEmployees)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@EmptyValue(emp.EmployeeNo)</div>
                                        <div class="text-muted small">@EmptyValue(emp.Code)</div>
                                    </td>
                                    <td>
                                        <div class="fw-semibold">@EmptyValue(emp.FullName)</div>
                                        <div class="text-muted small">@EmptyValue(emp.Email)</div>
                                    </td>
                                    <td class="text-nowrap">@FormatDate(emp.DateOfBirth)</td>
                                    <td class="text-nowrap">@EmptyValue(emp.Phone)</td>
                                    <td class="text-nowrap">@FormatDate(emp.HireDate)</td>
                                    <td>@BranchText(emp.BranchId)</td>
                                    <td><span class="badge rounded-pill text-bg-light">@EmptyValue(GetPositionName(emp.PositionId))</span></td>
                                    <td class="text-end">
                                        <div class="employee-row-actions">
                                            <a class="btn btn-outline-info btn-sm employee-action" href="/Employee/Employee/view/@emp.Id" title="@Text("View", "عرض")" aria-label="@Text("View employee", "عرض الموظف")">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a class="btn btn-outline-primary btn-sm employee-action" href="/Employee/Employee/360/@emp.Id" title="@Text("360 View", "عرض 360")" aria-label="@Text("Open employee 360 view", "فتح عرض الموظف 360")">
                                                <i class="bi bi-person-vcard"></i>
                                            </a>
                                            <button class="btn btn-outline-warning btn-sm employee-action"
                                                    @onclick="() => EditEmployee(emp.Id)"
                                                    disabled="@(!CanEditEmployee)"
                                                    title="@Text("Edit", "تعديل")"
                                                    aria-label="@Text("Edit employee", "تعديل الموظف")">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>
                                            <button class="btn btn-outline-danger btn-sm employee-action"
                                                    @onclick="() => DeleteEmployee(emp)"
                                                    disabled="@(!CanDeleteEmployee)"
                                                    title="@Text("Delete", "حذف")"
                                                    aria-label="@Text("Delete employee", "حذف الموظف")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                            <a class="btn btn-outline-secondary btn-sm employee-action" href="/Employee/Employee/QR/@emp.Id" title="@Text("QR Code", "QR")" aria-label="@Text("Open employee QR code", "فتح رمز الموظف")">
                                                <i class="bi bi-qr-code"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="erp-pagination employee-pagination">
                <span class="text-muted">
                    @Text(
                        $"Showing {ShowingStart} to {ShowingEnd} of {totalCount}",
                        $"عرض {ShowingStart} إلى {ShowingEnd} من {totalCount}")
                </span>
                <div class="employee-pagination-actions">
                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="PrevPage"
                            disabled="@(pageIndex == 0 || isLoading)">
                        <i class="bi bi-chevron-left"></i>
                        @Text("Previous", "السابق")
                    </button>

                    <span>@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>

                    <button class="btn btn-sm btn-outline-secondary"
                            @onclick="NextPage"
                            disabled="@(pageIndex >= TotalPages - 1 || isLoading)">
                        @Text("Next", "التالي")
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </AppCard>
    </div>
}

@code {
    private List<PositionDto> positions = [];
    private List<EmployeeDto> employees = [];
    private List<BranchDto> branches = [];
    private Dictionary<Guid, string> positionCache = new();
    private CurrentUserBranchAccessDto branchAccess = new();
    private bool canViewAllBranches;

    private Guid companyId;
    private AuthenticationState? AuthState;
    private bool isLoading = false;
    private long totalCount = 0;
    private string errorMessage = "";

    // Search, Sort, Pagination
    private string searchText = "";
    private string branchFilterText = string.Empty;
    private string sortColumn = nameof(EmployeeDto.FullName);
    private bool sortAscending = true;
    private int pageSize = 10;
    private int pageIndex = 0;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private long ShowingStart => totalCount == 0 ? 0 : (pageIndex * pageSize) + 1;
    private long ShowingEnd => Math.Min((pageIndex + 1) * pageSize, totalCount);

    // Permission Helpers
    private bool CanViewEmployees => HasPermission(PermissionList.EmployeePermissions.View);
    private bool CanCreateEmployee => HasPermission(PermissionList.EmployeePermissions.Create);
    private bool CanEditEmployee => HasPermission(PermissionList.EmployeePermissions.Edit);
    private bool CanDeleteEmployee => HasPermission(PermissionList.EmployeePermissions.Delete);

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();

        if (!CanViewEmployees)
        {
            return;
        }

        if (!TryReadCompanyId())
        {
            errorMessage = Text("Company context was not found for the current user.", "لم يتم العثور على سياق الشركة للمستخدم الحالي.");
            return;
        }

        await LoadBranchAccessAsync();
        await LoadPositions();
        await LoadEmployees();
    }

    private bool TryReadCompanyId()
    {
        var value = AuthState?.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        return Guid.TryParse(value, out companyId);
    }

    private async Task LoadPositions()
    {
        var posRes = await PositionService.GetAsync(companyId, 0, 1000);
        if (posRes.IsSuccess)
        {
            positions = posRes.Data?.Data?.ToList() ?? [];
            BuildPositionCache();
        }
    }

    private async Task LoadBranchAccessAsync()
    {
        var accessResponse = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        branchAccess = accessResponse.IsSuccess ? accessResponse.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();
        canViewAllBranches = branchAccess.CanViewAllBranches;

        var branchResponse = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = branchResponse.IsSuccess ? branchResponse.Data?.Data.ToList() ?? [] : [];
        if (!canViewAllBranches)
        {
            branches = branches.Where(branch => branchAccess.BranchIds.Contains(branch.Id)).ToList();
            if (branches.Count == 1)
                branchFilterText = branches[0].Id.ToString();
        }
    }

    private void BuildPositionCache()
    {
        positionCache.Clear();
        foreach (var position in positions)
        {
            positionCache[position.Id] = SharedDataService.Language == "Ar" ? position.Title : position.TitleEng;
        }
    }

    private async Task LoadEmployees()
    {
        isLoading = true;
        var branchId = ParseBranchFilter();
        var response = branchId.HasValue
            ? await EmployeeService.GetByBranchAsync(branchId.Value, pageIndex, pageSize)
            : await EmployeeService.GetByCompanyIdAsync(companyId, pageIndex, pageSize);

        if (response.IsSuccess)
        {
            employees = response.Data?.Data.ToList() ?? [];
            totalCount = response.Data?.Count ?? 0;
        }
        else
        {
            employees = [];
            totalCount = 0;
        }

        isLoading = false;
    }

    private IEnumerable<EmployeeDto> ProcessedEmployees =>
        employees
            .Where(emp =>
                string.IsNullOrWhiteSpace(searchText) ||
                (emp.FullName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.EmployeeNo?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.Email?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (emp.PositionName?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
            )
            .OrderByDynamic(sortColumn, sortAscending);

    private bool HasPermission(string permission) =>
        AuthState?.User.Claims.Any(c => c.Value == permission) ?? false;

    private Guid? ParseBranchFilter() =>
        Guid.TryParse(branchFilterText, out var branchId) ? branchId : null;

    private async Task OnBranchFilterChanged(ChangeEventArgs e)
    {
        branchFilterText = e.Value?.ToString() ?? string.Empty;
        pageIndex = 0;
        await LoadEmployees();
    }

    private string GetPositionName(Guid? positionId) =>
        positionId.HasValue && positionCache.TryGetValue(positionId.Value, out var name) ? name : "";

    private string BranchText(Guid? branchId)
    {
        if (!branchId.HasValue)
            return Text("Company", "الشركة");

        var branch = branches.FirstOrDefault(x => x.Id == branchId.Value);
        return branch is null ? branchId.Value.ToString("N")[..8] : Text(branch.NameEng, branch.Name);
    }

    private string FormatDate(DateTime date) => date.ToString("yyyy/MM/dd");
    private static string FormatCount(long value) => value.ToString("N0");

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    void CreateNew() => NavigationManager.NavigateTo("/Employee/Employee/Form");

    void EditEmployee(Guid id) => NavigationManager.NavigateTo($"/Employee/Employee/Form/{id}");

    async Task DeleteEmployee(EmployeeDto employee)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Confirm Delete", "تأكيد عملية الحذف"),
            Message = Text(
                $"Are you sure you want to delete this employee: {employee.FullName}?",
                $"هل ترغب فعلا في حذف الموظف: {employee.FullName}؟"),
            ShowCancel = true,
            OkText = Text("Yes", "نعم"),
            CancelText = Text("No", "لا"),
            OnOk = async () => await ConfirmDelete(employee)
        });
    }

    private async Task ConfirmDelete(EmployeeDto employee)
    {
        var response = await EmployeeService.DeleteAsync(employee.Id);
        if (response.IsSuccess)
        {
            ToastService.Show(new ToastMessage
            {
                Message = Text("Deleted successfully", "تم الحذف بنجاح"),
                Type = "success"
            });
            await LoadEmployees();
            await InvokeAsync(StateHasChanged);
        }
        else
        {
            ToastService.Show(new ToastMessage
            {
                Message = Text("Fail to delete the employee", "فشلت عملية الحذف"),
                Type = "error"
            });
        }
    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "10");
        pageIndex = 0;
        await LoadEmployees();
    }

    async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadEmployees();
        }
    }

    async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadEmployees();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        BuildPositionCache();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
