@layout AdminLayout
@page "/HR/LeaveApplications"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Leave.Dtos
@using SharedWithUI.Permissions
@inject ILeaveService LeaveService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Leave Applications", "طلبات الإجازات")"
                Subtitle="@Text("Review submitted leave applications. Approved, rejected, and cancelled requests move to reports.", "مراجعة طلبات الإجازة المرسلة. تنتقل الطلبات المعتمدة والمرفوضة والملغاة إلى التقارير.")"
                Overline="@Text("Leave Management", "إدارة الإجازات")"
                Icon="bi-calendar-plus" />

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard CssClass="mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-6"><label class="form-label">@Text("Employee", "الموظف")</label><select class="form-select" @bind="filterEmployeeId"><option value="">@Text("All employees", "كل الموظفين")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
            <div class="col-md-3"><button class="btn btn-outline-primary w-100" type="button" @onclick="LoadApplicationsAsync" disabled="@isBusy"><i class="bi bi-arrow-repeat"></i> @Text("Load submitted", "تحميل المرسلة")</button></div>
            <div class="col-md-3 text-md-end"><a class="btn btn-outline-secondary" href="/LeavesManagement/EmergencyLeaves"><i class="bi bi-life-preserver"></i> @Text("Emergency Leaves", "الإجازات الطارئة")</a></div>
        </div>
    </AppCard>

    <AppCard Title="@Text("Submitted Applications", "الطلبات المرسلة")">
        <div class="erp-table-wrap">
            <table class="table erp-table align-middle mb-0">
                <thead><tr><th>@Text("Employee", "الموظف")</th><th>@Text("Type", "النوع")</th><th>@Text("Dates", "التواريخ")</th><th>@Text("Days", "الأيام")</th><th>@Text("Status", "الحالة")</th><th>@Text("Attachment", "المرفق")</th><th>@Text("Comment", "التعليق")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                <tbody>
                    @if (applications.Count == 0)
                    {
                        <tr><td colspan="8"><EmptyState Title="@Text("No submitted leave applications", "لا توجد طلبات إجازة مرسلة")" Message="@Text("Submitted leave applications that need review will appear here.", "ستظهر هنا طلبات الإجازة المرسلة التي تحتاج إلى مراجعة.")" Icon="bi-calendar-check" /></td></tr>
                    }
                    else
                    {
                        @foreach (var application in applications)
                        {
                            <tr>
                                <td>@EmployeeName(application.EmployeeId)</td>
                                <td>@LeaveTypeName(application)</td>
                                <td>@application.StartDate.ToString("yyyy-MM-dd") - @application.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>@application.TotalDays.ToString("0.##")</td>
                                <td><StatusChip Text="@StatusText(application.Status)" Tone="@StatusTone(application.Status)" /></td>
                                <td>@if (!string.IsNullOrWhiteSpace(application.AttachmentPath)){<a href="@application.AttachmentPath" target="_blank" rel="noopener">@Text("Open", "فتح")</a>}else{<span class="text-muted">-</span>}</td>
                                <td>@EmptyValue(application.ApproverComment)</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group" aria-label="@Text("Leave application actions", "إجراءات طلب الإجازة")">
                                        <button class="btn btn-outline-success" type="button" @onclick="() => BeginReview(application, true)" disabled="@(application.Status != LeaveApplicationStatus.Submitted || !Can(PermissionList.LeaveApplicationPermissions.Approve) || isBusy)">@Text("Approve", "اعتماد")</button>
                                        <button class="btn btn-outline-danger" type="button" @onclick="() => BeginReview(application, false)" disabled="@(application.Status != LeaveApplicationStatus.Submitted || !Can(PermissionList.LeaveApplicationPermissions.Approve) || isBusy)">@Text("Reject", "رفض")</button>
                                        <button class="btn btn-outline-warning" type="button" @onclick="() => CancelAsync(application.Id)" disabled="@(application.Status == LeaveApplicationStatus.Approved || application.Status == LeaveApplicationStatus.Cancelled || !Can(PermissionList.LeaveApplicationPermissions.Cancel) || isBusy)">@Text("Cancel", "إلغاء")</button>
                                    </div>
                                </td>
                            </tr>

                            @if (pendingReview?.ApplicationId == application.Id)
                            {
                                <tr>
                                    <td colspan="8">
                                        <EditForm Model="pendingReview" OnValidSubmit="SubmitReviewAsync">
                                            <div class="border rounded-3 p-3 bg-body-tertiary">
                                                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                                                    <div>
                                                        <div class="fw-semibold">
                                                            @(pendingReview.IsApproved ? Text("Approve leave application", "اعتماد طلب الإجازة") : Text("Reject leave application", "رفض طلب الإجازة"))
                                                        </div>
                                                        <div class="text-muted small">
                                                            @EmployeeName(application.EmployeeId) - @LeaveTypeName(application)
                                                        </div>
                                                    </div>
                                                    <StatusChip Text="@(pendingReview.IsApproved ? Text("Approval comment", "تعليق الاعتماد") : Text("Rejection reason", "سبب الرفض"))" Tone="@(pendingReview.IsApproved ? "success" : "danger")" />
                                                </div>
                                                <label class="form-label" for="@($"review-comment-{application.Id}")">
                                                    @(pendingReview.IsApproved ? Text("Approval reason / comment", "سبب أو تعليق الاعتماد") : Text("Rejection reason / comment", "سبب أو تعليق الرفض"))
                                                </label>
                                                <InputTextArea id="@($"review-comment-{application.Id}")" class="form-control" rows="3" maxlength="1000" @bind-Value="pendingReview.Comment" />
                                                <div class="form-text">@Text("This comment will be saved with the application review.", "سيتم حفظ هذا التعليق مع مراجعة الطلب.")</div>
                                                <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                                                    <button class="btn btn-outline-secondary" type="button" @onclick="CancelReview" disabled="@isBusy">@Text("Cancel", "إلغاء")</button>
                                                    <button class="btn @(pendingReview.IsApproved ? "btn-success" : "btn-danger")" type="submit" disabled="@isBusy">
                                                        <i class="bi @(pendingReview.IsApproved ? "bi-check2-circle" : "bi-x-circle")"></i>
                                                        @(pendingReview.IsApproved ? Text("Confirm approval", "تأكيد الاعتماد") : Text("Confirm rejection", "تأكيد الرفض"))
                                                    </button>
                                                </div>
                                            </div>
                                        </EditForm>
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </AppCard>
</main>

@code {
    private Guid companyId;
    private AuthenticationState? authState;
    private string? message;
    private string messageClass = "alert-info";
    private bool isBusy;
    private List<EmployeeDto> employees = [];
    private List<LeaveApplicationDto> applications = [];
    private string? filterEmployeeId;
    private PendingLeaveReview? pendingReview;

    protected override void OnInitialized() => SharedDataService.OnChange1 += HandleChangeAsync;

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        companyId = await ResolveCompanyIdAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        var employeeResult = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000);
        employees = employeeResult.IsSuccess ? employeeResult.Data?.Data.ToList() ?? [] : [];
        await LoadApplicationsAsync();
        isBusy = false;
    }

    private async Task LoadApplicationsAsync()
    {
        pendingReview = null;
        var result = await LeaveService.GetLeaveApplicationsAsync(companyId, ParseNullable(filterEmployeeId), LeaveApplicationStatus.Submitted);
        applications = result.IsSuccess ? result.Data ?? [] : [];
        if (!result.IsSuccess) SetMessage(Error(result), "alert-danger");
    }

    private void BeginReview(LeaveApplicationDto application, bool approve)
    {
        pendingReview = new PendingLeaveReview
        {
            ApplicationId = application.Id,
            IsApproved = approve,
            Comment = application.ApproverComment
        };
        message = null;
    }

    private async Task SubmitReviewAsync()
    {
        if (pendingReview is null)
            return;

        if (string.IsNullOrWhiteSpace(pendingReview.Comment))
        {
            SetMessage(
                pendingReview.IsApproved
                    ? Text("Enter an approval reason or comment before confirming.", "أدخل سبب أو تعليق الاعتماد قبل التأكيد.")
                    : Text("Enter a rejection reason or comment before confirming.", "أدخل سبب أو تعليق الرفض قبل التأكيد."),
                "alert-warning");
            return;
        }

        var review = pendingReview;
        await ApplyActionAsync(
            () => LeaveService.ReviewLeaveApplicationAsync(new ReviewLeaveApplicationDto
            {
                ApplicationId = review.ApplicationId,
                IsApproved = review.IsApproved,
                ApproverComment = review.Comment
            }),
            review.IsApproved ? Text("Application approved.", "تم اعتماد الطلب.") : Text("Application rejected.", "تم رفض الطلب."),
            clearPendingReview: true);
    }

    private void CancelReview() => pendingReview = null;
    private async Task CancelAsync(Guid id) => await ApplyActionAsync(() => LeaveService.CancelLeaveApplicationAsync(id), Text("Application cancelled.", "تم إلغاء الطلب."));

    private async Task ApplyActionAsync(Func<Task<ApiResult<LeaveApplicationDto>>> action, string success, bool clearPendingReview = false)
    {
        isBusy = true;
        var result = await action();
        SetMessage(result.IsSuccess ? success : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess)
        {
            if (clearPendingReview) pendingReview = null;
            await LoadApplicationsAsync();
        }
        isBusy = false;
    }

    private string EmployeeName(Guid id) => employees.FirstOrDefault(x => x.Id == id) is { } employee ? EmployeeName(employee) : id.ToString();
    private string EmployeeName(EmployeeDto employee) => SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);
    private string LeaveTypeName(LeaveApplicationDto application) => SharedDataService.SelectViewLang(application.LeaveTypeNameEng ?? application.LeaveTypeId.ToString(), application.LeaveTypeName ?? application.LeaveTypeId.ToString());
    private string StatusText(LeaveApplicationStatus status) => status switch { LeaveApplicationStatus.Draft => Text("Draft", "مسودة"), LeaveApplicationStatus.Submitted => Text("Submitted", "مرسل"), LeaveApplicationStatus.Approved => Text("Approved", "معتمد"), LeaveApplicationStatus.Rejected => Text("Rejected", "مرفوض"), LeaveApplicationStatus.Cancelled => Text("Cancelled", "ملغى"), _ => status.ToString() };
    private static string StatusTone(LeaveApplicationStatus status) => status switch { LeaveApplicationStatus.Approved => "success", LeaveApplicationStatus.Rejected => "danger", LeaveApplicationStatus.Submitted => "info", LeaveApplicationStatus.Cancelled => "muted", _ => "warning" };
    private bool Can(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private static Guid? ParseNullable(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private static string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string Error<T>(ApiResult<T> result) => result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Operation failed.", "تعذر تنفيذ العملية.");
    private void SetMessage(string text, string css) { message = text; messageClass = css; }
    private async Task<Guid> ResolveCompanyIdAsync() => Guid.TryParse((await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync()).User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;

    private sealed class PendingLeaveReview
    {
        public Guid ApplicationId { get; set; }
        public bool IsApproved { get; set; }
        public string? Comment { get; set; }
    }
}
