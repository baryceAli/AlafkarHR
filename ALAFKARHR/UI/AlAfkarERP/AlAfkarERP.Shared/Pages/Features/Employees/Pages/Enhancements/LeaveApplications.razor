@layout AdminLayout
@page "/HR/LeaveApplications"
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Features.LeavesManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Leave.Dtos
@using SharedWithUI.Permissions
@inject ILeaveService LeaveService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Leave Applications", "طلبات الإجازات")" Subtitle="@Text("Create, submit, approve, reject, and cancel general leave applications.", "إنشاء وإرسال واعتماد ورفض وإلغاء طلبات الإجازات العامة.")" Overline="@Text("Leave Management", "إدارة الإجازات")" Icon="bi-calendar-plus" />

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard CssClass="mb-3">
        <div class="row g-3 align-items-end">
            <div class="col-md-4"><label class="form-label">@Text("Employee", "الموظف")</label><select class="form-select" @bind="filterEmployeeId"><option value="">@Text("All employees", "كل الموظفين")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
            <div class="col-md-3"><label class="form-label">@Text("Status", "الحالة")</label><select class="form-select" @bind="filterStatus"><option value="">@Text("All statuses", "كل الحالات")</option>@foreach (var status in Enum.GetValues<LeaveApplicationStatus>()){<option value="@status">@StatusText(status)</option>}</select></div>
            <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="button" @onclick="LoadApplicationsAsync"><i class="bi bi-arrow-repeat"></i> @Text("Load", "تحميل")</button></div>
            <div class="col-md-3 text-md-end"><a class="btn btn-outline-secondary" href="/LeavesManagement/EmergencyLeaves"><i class="bi bi-life-preserver"></i> @Text("Emergency Leaves", "الإجازات الطارئة")</a></div>
        </div>
    </AppCard>

    <AppCard Title="@Text("Application", "الطلب")" CssClass="mb-3">
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <div class="row g-3">
                <div class="col-md-4"><label class="form-label">@Text("Employee", "الموظف")</label><select class="form-select" @bind="modelEmployeeId"><option value="">@Text("Select employee", "اختر الموظف")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
                <div class="col-md-3"><label class="form-label">@Text("Leave Type", "نوع الإجازة")</label><select class="form-select" @bind="modelLeaveTypeId"><option value="">@Text("Select type", "اختر النوع")</option>@foreach (var type in leaveTypes){<option value="@type.Id">@LeaveTypeName(type)</option>}</select></div>
                <div class="col-md-2"><label class="form-label">@Text("Start", "البداية")</label><InputDate class="form-control" @bind-Value="model.StartDate" /></div>
                <div class="col-md-2"><label class="form-label">@Text("End", "النهاية")</label><InputDate class="form-control" @bind-Value="model.EndDate" /></div>
                <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit" disabled="@(!Can(PermissionList.LeaveApplicationPermissions.Create) && !Can(PermissionList.LeaveApplicationPermissions.Edit))"><i class="bi bi-save"></i></button></div>
                <div class="col-12"><label class="form-label">@Text("Reason", "السبب")</label><InputText class="form-control" @bind-Value="model.Reason" /></div>
            </div>
        </EditForm>
    </AppCard>

    <AppCard Title="@Text("Applications", "الطلبات")">
        <div class="table-responsive">
            <table class="table align-middle">
                <thead><tr><th>@Text("Employee", "الموظف")</th><th>@Text("Type", "النوع")</th><th>@Text("Dates", "التواريخ")</th><th>@Text("Days", "الأيام")</th><th>@Text("Status", "الحالة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                <tbody>
                    @if (applications.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">@Text("No leave applications found.", "لا توجد طلبات إجازة.")</td></tr>
                    }
                    else
                    {
                        @foreach (var application in applications)
                        {
                            <tr>
                                <td>@EmployeeName(application.EmployeeId)</td>
                                <td>@LeaveTypeName(application)</td>
                                <td>@application.StartDate.ToString("yyyy-MM-dd") - @application.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>@application.TotalDays.ToString("0.##")</td>
                                <td><span class="badge text-bg-@StatusCss(application.Status)">@StatusText(application.Status)</span></td>
                                <td class="text-end">
                                    <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => Edit(application)" disabled="@(application.Status != LeaveApplicationStatus.Draft)">@Text("Edit", "تعديل")</button>
                                    <button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => SubmitAsync(application.Id)" disabled="@(application.Status != LeaveApplicationStatus.Draft || !Can(PermissionList.LeaveApplicationPermissions.Edit))">@Text("Submit", "إرسال")</button>
                                    <button class="btn btn-outline-success btn-sm" type="button" @onclick="() => ReviewAsync(application.Id, true)" disabled="@(application.Status != LeaveApplicationStatus.Submitted || !Can(PermissionList.LeaveApplicationPermissions.Approve))">@Text("Approve", "اعتماد")</button>
                                    <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => ReviewAsync(application.Id, false)" disabled="@(application.Status != LeaveApplicationStatus.Submitted || !Can(PermissionList.LeaveApplicationPermissions.Approve))">@Text("Reject", "رفض")</button>
                                    <button class="btn btn-outline-warning btn-sm" type="button" @onclick="() => CancelAsync(application.Id)" disabled="@(application.Status == LeaveApplicationStatus.Approved || application.Status == LeaveApplicationStatus.Cancelled || !Can(PermissionList.LeaveApplicationPermissions.Cancel))">@Text("Cancel", "إلغاء")</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </AppCard>
</main>

@code {
    private Guid companyId;
    private AuthenticationState? authState;
    private string? message;
    private string messageClass = "alert-info";
    private List<EmployeeDto> employees = [];
    private List<LeaveTypeDto> leaveTypes = [];
    private List<LeaveApplicationDto> applications = [];
    private UpsertLeaveApplicationDto model = NewModel();
    private string? modelEmployeeId;
    private string? modelLeaveTypeId;
    private string? filterEmployeeId;
    private string? filterStatus;

    protected override void OnInitialized() => SharedDataService.OnChange1 += HandleChangeAsync;

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        companyId = await ResolveCompanyIdAsync();
        model.CompanyId = companyId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var employeeResult = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000);
        employees = employeeResult.IsSuccess ? employeeResult.Data?.Data.ToList() ?? [] : [];
        leaveTypes = (await LeaveService.GetLeaveTypesAsync(companyId)).Data ?? [];
        await LoadApplicationsAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        var result = await LeaveService.GetLeaveApplicationsAsync(companyId, ParseNullable(filterEmployeeId), Enum.TryParse<LeaveApplicationStatus>(filterStatus, out var status) ? status : null);
        applications = result.IsSuccess ? result.Data ?? [] : [];
        if (!result.IsSuccess) SetMessage(Error(result), "alert-danger");
    }

    private async Task SaveAsync()
    {
        model.CompanyId = companyId;
        model.EmployeeId = Parse(modelEmployeeId);
        model.LeaveTypeId = Parse(modelLeaveTypeId);
        var result = await LeaveService.UpsertLeaveApplicationAsync(model);
        SetMessage(result.IsSuccess ? Text("Leave application saved.", "تم حفظ طلب الإجازة.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess)
        {
            ResetModel();
            await LoadApplicationsAsync();
        }
    }

    private async Task SubmitAsync(Guid id) => await ApplyActionAsync(() => LeaveService.SubmitLeaveApplicationAsync(id), Text("Application submitted.", "تم إرسال الطلب."));
    private async Task ReviewAsync(Guid id, bool approve) => await ApplyActionAsync(() => LeaveService.ReviewLeaveApplicationAsync(new ReviewLeaveApplicationDto { ApplicationId = id, IsApproved = approve }), approve ? Text("Application approved.", "تم اعتماد الطلب.") : Text("Application rejected.", "تم رفض الطلب."));
    private async Task CancelAsync(Guid id) => await ApplyActionAsync(() => LeaveService.CancelLeaveApplicationAsync(id), Text("Application cancelled.", "تم إلغاء الطلب."));

    private async Task ApplyActionAsync(Func<Task<ApiResult<LeaveApplicationDto>>> action, string success)
    {
        var result = await action();
        SetMessage(result.IsSuccess ? success : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess) await LoadApplicationsAsync();
    }

    private void Edit(LeaveApplicationDto application)
    {
        model = new UpsertLeaveApplicationDto { Id = application.Id, CompanyId = application.CompanyId, EmployeeId = application.EmployeeId, LeaveTypeId = application.LeaveTypeId, StartDate = application.StartDate, EndDate = application.EndDate, Reason = application.Reason, AttachmentPath = application.AttachmentPath };
        modelEmployeeId = application.EmployeeId.ToString();
        modelLeaveTypeId = application.LeaveTypeId.ToString();
    }

    private void ResetModel() { model = NewModel(companyId); modelEmployeeId = null; modelLeaveTypeId = null; }
    private static UpsertLeaveApplicationDto NewModel(Guid companyId = default) => new() { CompanyId = companyId, StartDate = DateTime.Today, EndDate = DateTime.Today };
    private string EmployeeName(Guid id) => employees.FirstOrDefault(x => x.Id == id) is { } employee ? EmployeeName(employee) : id.ToString();
    private string EmployeeName(EmployeeDto employee) => SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);
    private string LeaveTypeName(LeaveTypeDto type) => SharedDataService.SelectViewLang(type.NameEng, type.Name);
    private string LeaveTypeName(LeaveApplicationDto application) => SharedDataService.SelectViewLang(application.LeaveTypeNameEng ?? application.LeaveTypeId.ToString(), application.LeaveTypeName ?? application.LeaveTypeId.ToString());
    private string StatusText(LeaveApplicationStatus status) => status.ToString();
    private static string StatusCss(LeaveApplicationStatus status) => status switch { LeaveApplicationStatus.Approved => "success", LeaveApplicationStatus.Rejected => "danger", LeaveApplicationStatus.Submitted => "primary", LeaveApplicationStatus.Cancelled => "secondary", _ => "light" };
    private bool Can(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private static Guid Parse(string? value) => Guid.TryParse(value, out var id) ? id : Guid.Empty;
    private static Guid? ParseNullable(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private string Error<T>(ApiResult<T> result) => result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Operation failed.", "تعذر تنفيذ العملية.");
    private void SetMessage(string text, string css) { message = text; messageClass = css; }
    private async Task<Guid> ResolveCompanyIdAsync() => Guid.TryParse((await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync()).User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}