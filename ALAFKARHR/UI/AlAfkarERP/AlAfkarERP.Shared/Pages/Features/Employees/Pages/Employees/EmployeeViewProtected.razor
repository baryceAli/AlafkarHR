@layout AdminLayout
@page "/Employee/Employee/view"

<div class="card border-0 shadow-sm mx-auto mt-4 employee-public-card-sm">
    <div class="card-body text-center">
        <div class="mb-3">
            <i class="bi bi-person-vcard fs-1 text-primary"></i>
        </div>
        <h5 class="card-title">Employee public view</h5>
        <p class="card-text text-muted">
            Select an employee from the employee list to open a public employee card.
        </p>
        <a class="btn btn-primary" href="/Employee/Employee/List">
            <i class="bi bi-arrow-left"></i>
            Back to employees
        </a>
    </div>
</div>
