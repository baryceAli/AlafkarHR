@layout AdminLayout
@page "/HR/AttendanceRoster"
@implements IDisposable
@using SharedWithUI.Permissions
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Employees.Dtos
@using AlAfkarERP.Shared.Pages.Reuable2
@inject IAttendanceService AttendanceService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject ModalService ModalService

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Attendance Roster", "جداول الحضور")" Subtitle="@Text("Manage schedules, assignments, swaps, corrections, and device import batches.", "إدارة الجداول والتعيينات والتبديل والتصحيحات ودفعات استيراد الأجهزة.")" Overline="@Text("HR Attendance", "حضور الموارد البشرية")" Icon="bi-calendar3" />

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <AppCard Title="@Text("Control board", "لوحة التحكم")" CssClass="mb-3">
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-2">
                <label class="form-label">@Text("From", "من")</label>
                <InputDate class="form-control" @bind-Value="rosterFromDate" />
            </div>
            <div class="col-md-2">
                <label class="form-label">@Text("To", "إلى")</label>
                <InputDate class="form-control" @bind-Value="rosterToDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("Department", "القسم")</label>
                <select class="form-select" @bind="rosterDepartmentId">
                    <option value="">@Text("All departments", "كل الأقسام")</option>
                    @foreach (var department in DepartmentOptions)
                    {
                        <option value="@department.Id">@department.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@Text("Shift", "الوردية")</label>
                <select class="form-select" @bind="rosterShiftId">
                    <option value="">@Text("All shifts", "كل الورديات")</option>
                    @foreach (var shift in shifts)
                    {
                        <option value="@shift.Id">@shift.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">@Text("Status", "الحالة")</label>
                <select class="form-select" @bind="rosterStatus">
                    <option value="">@Text("All statuses", "كل الحالات")</option>
                    @foreach (var status in Enum.GetValues<AttendanceRosterControlStatus>())
                    {
                        <option value="@status">@RosterStatusText(status)</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100" type="button" @onclick="LoadRosterControlAsync" disabled="@isLoadingRoster">
                    <i class="bi bi-funnel"></i>
                </button>
            </div>
        </div>

        <div class="roster-kpis mb-3">
            @RosterKpi(Text("Planned", "المخطط"), rosterControl.Summary.Planned, "bi-calendar-check")
            @RosterKpi(Text("Present", "الحاضرون"), rosterControl.Summary.Present, "bi-person-check")
            @RosterKpi(Text("Absent", "الغياب"), rosterControl.Summary.Absent, "bi-person-x")
            @RosterKpi(Text("On leave", "في إجازة"), rosterControl.Summary.OnApprovedLeave, "bi-calendar-heart")
            @RosterKpi(Text("Uncovered", "أقسام بلا تغطية"), rosterControl.Summary.UncoveredDepartments, "bi-exclamation-triangle")
        </div>

        @if (isLoadingRoster)
        {
            <div class="erp-loading">@Text("Loading roster control board...", "جاري تحميل لوحة التحكم...")</div>
        }
        else if (rosterControl.Rows.Count == 0)
        {
            <EmptyState Icon="bi-calendar2-week" Title="@Text("No planned staff", "لا يوجد موظفون مخططون")" Message="@Text("No roster rows match the selected date, shift, department, and status.", "لا توجد صفوف مطابقة للتاريخ والوردية والقسم والحالة المحددة.")" />
        }
        else
        {
            @foreach (var group in rosterControl.Rows.GroupBy(x => new { x.WorkDate, x.DepartmentId, x.DepartmentName }).OrderBy(x => x.Key.WorkDate).ThenBy(x => x.Key.DepartmentName))
            {
                <div class="roster-group-title">
                    <div>
                        <strong>@Date(group.Key.WorkDate)</strong>
                        <span>@(string.IsNullOrWhiteSpace(group.Key.DepartmentName) ? Text("Unassigned department", "قسم غير محدد") : group.Key.DepartmentName)</span>
                    </div>
                    <span class="text-muted small">@Text("Planned", "المخطط"): @group.Count() · @Text("Present", "الحاضرون"): @group.Count(x => IsPresent(x.Status))</span>
                </div>
                <div class="erp-table-wrap mb-3">
                    <table class="table erp-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Employee", "الموظف")</th>
                                <th>@Text("Position", "المسمى")</th>
                                <th>@Text("Shift", "الوردية")</th>
                                <th>@Text("Attendance", "الحضور")</th>
                                <th>@Text("Reason", "السبب")</th>
                                <th>@Text("Substitute candidates", "مرشحو البديل")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in group)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@RosterEmployeeName(row)</div>
                                        <div class="text-muted small">@((row.EmployeeNo ?? row.EmployeeCode) ?? row.EmployeeId.ToString()[..8])</div>
                                    </td>
                                    <td>@(TextValue(row.PositionNameEng, row.PositionName) ?? "-")</td>
                                    <td>
                                        <div>@(row.ShiftName ?? row.ShiftId.ToString()[..8])</div>
                                        <div class="text-muted small">@row.PlannedShiftStartUtc.ToLocalTime().ToString("HH:mm") - @row.PlannedShiftEndUtc.ToLocalTime().ToString("HH:mm")</div>
                                    </td>
                                    <td><StatusChip Text="@RosterStatusText(row.Status)" Tone="@RosterStatusTone(row.Status)" /></td>
                                    <td>
                                        @if (row.Status == AttendanceRosterControlStatus.OnApprovedLeave)
                                        {
                                            <div class="fw-semibold">@TextValue(row.LeaveTypeNameEng, row.LeaveTypeName)</div>
                                        }
                                        <div class="text-muted small">@(row.AbsenceReason ?? "-")</div>
                                    </td>
                                    <td>
                                        @if (row.SubstituteCandidates.Count == 0)
                                        {
                                            <span class="text-muted small">@Text("No available candidates", "لا يوجد مرشحون متاحون")</span>
                                        }
                                        else
                                        {
                                            <div class="candidate-list">
                                                @foreach (var candidate in row.SubstituteCandidates)
                                                {
                                                    <span class="candidate-chip">
                                                        @RosterCandidateName(candidate)
                                                        <small>@CandidateSourceText(candidate.Source)</small>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </AppCard>

    <AppCard Title="@Text("Substitute configuration", "إعداد البدلاء")" CssClass="mb-3">
        <div class="row g-3 align-items-end mb-3">
            <div class="col-md-5">
                <label class="form-label">@Text("Search employees", "بحث الموظفين")</label>
                <input class="form-control" placeholder="@Text("Name, employee number, department, or administration", "الاسم أو الرقم أو القسم أو الإدارة")" @bind="substituteSearch" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-outline-secondary w-100" type="button" @onclick="LoadRosterSubstituteConfigurationsAsync" disabled="@isLoadingSubstituteConfigurations">
                    <i class="bi bi-arrow-repeat"></i> @Text("Refresh", "تحديث")
                </button>
            </div>
        </div>

        @if (isLoadingSubstituteConfigurations)
        {
            <div class="erp-loading">@Text("Loading substitute configuration...", "جاري تحميل إعداد البدلاء...")</div>
        }
        else if (FilteredSubstituteConfigurations.Count == 0)
        {
            <EmptyState Icon="bi-person-gear" Title="@Text("No configurable employees", "لا يوجد موظفون قابلون للإعداد")" Message="@Text("Only active employees assigned to an administration are available here.", "يظهر هنا فقط الموظفون النشطون المرتبطون بإدارة.")" />
        }
        else
        {
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Employee", "الموظف")</th>
                            <th>@Text("Administration", "الإدارة")</th>
                            <th>@Text("Department", "القسم")</th>
                            <th>@Text("Roster visible", "ظاهر في الجدول")</th>
                            <th>@Text("Substitute eligible", "مؤهل كبديل")</th>
                            <th>@Text("Notes", "ملاحظات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var config in FilteredSubstituteConfigurations)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@ConfigurationEmployeeName(config)</div>
                                    <div class="text-muted small">@((config.EmployeeNo ?? config.EmployeeCode) ?? config.EmployeeId.ToString()[..8])</div>
                                </td>
                                <td>@ConfigurationAdministrationName(config)</td>
                                <td>@ConfigurationDepartmentName(config)</td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" checked="@config.IsRosterVisible" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Edit))" @onchange="args => ToggleRosterVisibleAsync(config, IsChecked(args))" />
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" checked="@config.IsSubstituteEligible" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Edit))" @onchange="args => ToggleSubstituteEligibleAsync(config, IsChecked(args))" />
                                    </div>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm" value="@config.Notes" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Edit))" @onchange="args => UpdateSubstituteNotesAsync(config, args.Value?.ToString())" />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </AppCard>

    <AppCard Title="@Text("Schedule setup", "إعداد الجدول")" CssClass="mb-3">
        <EditForm Model="scheduleModel" OnValidSubmit="SaveScheduleAsync">
            <div class="row g-3 align-items-end">
                <div class="col-md-3"><label class="form-label">@Text("Name", "الاسم")</label><InputText class="form-control" @bind-Value="scheduleModel.Name" /></div>
                <div class="col-md-2"><label class="form-label">@Text("Start", "البداية")</label><InputDate class="form-control" @bind-Value="scheduleModel.StartDate" /></div>
                <div class="col-md-2"><label class="form-label">@Text("End", "النهاية")</label><InputDate class="form-control" @bind-Value="scheduleModel.EndDate" /></div>
                <div class="col-md-3"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="scheduleModel.Notes" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Create) && !Can(PermissionList.AttendanceRosterPermissions.Edit))"><i class="bi bi-save"></i> @Text("Save", "حفظ")</button></div>
            </div>
        </EditForm>
        <div class="table-responsive mt-3">
            <table class="table align-middle">
                <thead><tr><th>@Text("Schedule", "الجدول")</th><th>@Text("Dates", "التواريخ")</th><th>@Text("Status", "الحالة")</th><th>@Text("Assignments", "التعيينات")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                <tbody>
                    @if (ActiveSchedules.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">@Text("No schedules found.", "لا توجد جداول.")</td></tr>
                    }
                    @foreach (var schedule in ActiveSchedules)
                    {
                        <tr>
                            <td>@schedule.Name</td>
                            <td>@Date(schedule.StartDate) - @Date(schedule.EndDate)</td>
                            <td><span class="badge text-bg-@RosterCss(schedule.Status)">@schedule.Status</span></td>
                            <td>@schedule.AssignmentCount</td>
                            <td class="text-end">
                                <button class="btn btn-outline-secondary btn-sm" type="button" @onclick="() => EditSchedule(schedule)">@Text("Edit", "تعديل")</button>
                                <button class="btn btn-outline-primary btn-sm" type="button" disabled="@(schedule.Status != AttendanceRosterStatus.Draft || !Can(PermissionList.AttendanceRosterPermissions.Publish))" @onclick="() => PublishScheduleAsync(schedule.Id)">@Text("Publish", "نشر")</button>
                                <button class="btn btn-outline-dark btn-sm" type="button" disabled="@(schedule.Status != AttendanceRosterStatus.Published || !Can(PermissionList.AttendanceRosterPermissions.Publish))" @onclick="() => LockScheduleAsync(schedule.Id)">@Text("Lock", "إقفال")</button>
                                <button class="btn btn-outline-danger btn-sm" type="button" disabled="@(schedule.Status == AttendanceRosterStatus.Locked || schedule.Status == AttendanceRosterStatus.Cancelled || !Can(PermissionList.AttendanceRosterPermissions.Edit))" @onclick="() => CancelScheduleAsync(schedule.Id)">@Text("Cancel", "إلغاء")</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </AppCard>

    <AppCard Title="@Text("Roster assignments", "تعيينات الورديات")" CssClass="mb-3 allow-overflow">
        <div class="row g-3 align-items-end">
            <div class="col-md-3"><label class="form-label">@Text("Schedule", "الجدول")</label><select class="form-select" @bind="assignmentModel.ScheduleId"><option value="@Guid.Empty">@Text("Select schedule", "اختر الجدول")</option>@foreach (var s in ActiveSchedules){<option value="@s.Id">@s.Name</option>}</select></div>
            <div class="col-md-3">
                <label class="form-label">@Text("Employees", "الموظفون")</label>
                <MultiSelectAutoCompleteComponent TItem="EmployeeDto"
                                                  Items="employees"
                                                  SelectedIds="assignmentEmployeeIds"
                                                  SelectedIdsChanged="OnAssignmentEmployeesChanged"
                                                  ItemId="@(employee => employee.Id)"
                                                  ItemText="@(employee => EmployeeName(employee))"
                                                  Placeholder="@Text("Search and select employees...", "ابحث واختر الموظفين...")"
                                                  NoResultsText="@Text("No employees found", "لا يوجد موظفون")"
                                                  ClearTitle="@Text("Clear employees", "مسح الموظفين")"
                                                  RemoveTitle="@Text("Remove employee", "إزالة الموظف")"
                                                  SelectedLabel="@Text("Selected employees", "الموظفون المحددون")"
                                                  ResultsLabel="@Text("Employee search results", "نتائج بحث الموظفين")" />
            </div>
            <div class="col-md-2"><label class="form-label">@Text("Shift", "الوردية")</label><select class="form-select" @bind="assignmentModel.ShiftId"><option value="@Guid.Empty">@Text("Select shift", "اختر الوردية")</option>@foreach (var shift in shifts){<option value="@shift.Id">@shift.Name</option>}</select></div>
            <div class="col-md-2"><label class="form-label">@Text("Work Date", "تاريخ العمل")</label><InputDate class="form-control" @bind-Value="assignmentModel.WorkDate" /></div>
            <div class="col-md-2"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="assignmentModel.Notes" /></div>
        </div>
        <div class="row g-3 align-items-end mt-1">
            <div class="col-md-2"><label class="form-label">@Text("From", "من")</label><InputDate class="form-control" @bind-Value="bulkStartDate" /></div>
            <div class="col-md-2"><label class="form-label">@Text("To", "إلى")</label><InputDate class="form-control" @bind-Value="bulkEndDate" /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" type="button" @onclick="SaveAssignmentAsync" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Create) && !Can(PermissionList.AttendanceRosterPermissions.Edit))"><i class="bi bi-save"></i> @Text("Save selected date", "حفظ التاريخ المحدد")</button></div>
            <div class="col-md-2"><button class="btn btn-outline-primary w-100" type="button" @onclick="AssignRosterAsync" disabled="@(!Can(PermissionList.AttendanceRosterPermissions.Create))"><i class="bi bi-calendar-range"></i> @Text("Assign date range", "تعيين نطاق التواريخ")</button></div>
            <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="button" @onclick="ResetAssignment">@Text("Reset", "إعادة ضبط")</button></div>
            <div class="col-md-2"><button class="btn btn-outline-secondary w-100" type="button" @onclick="LoadAssignmentsAsync"><i class="bi bi-arrow-repeat"></i> @Text("Load", "تحميل")</button></div>
        </div>
        <div class="table-responsive mt-3">
            <table class="table align-middle"><thead><tr><th>@Text("Date", "التاريخ")</th><th>@Text("Employee", "الموظف")</th><th>@Text("Shift", "الوردية")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead><tbody>
                @foreach (var item in assignments)
                {
                    <tr><td>@Date(item.WorkDate)</td><td>@EmployeeName(item.EmployeeId)</td><td>@ShiftName(item.ShiftId)</td><td class="text-end"><button class="btn btn-outline-primary btn-sm" type="button" @onclick="() => EditAssignment(item)">@Text("Edit", "تعديل")</button> <button class="btn btn-outline-danger btn-sm" type="button" @onclick="() => DeleteAssignmentAsync(item.Id)">@Text("Delete", "حذف")</button></td></tr>
                }
            </tbody></table>
        </div>
    </AppCard>

    <div class="row g-3">
        <div class="col-xl-4">
            <AppCard Title="@Text("Swap requests", "طلبات التبديل")">
                <div class="row g-2">
                    <div class="col-6"><select class="form-select" @bind="swapRequestingEmployeeId"><option value="">@Text("Requester", "الطالب")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
                    <div class="col-6"><select class="form-select" @bind="swapTargetEmployeeId"><option value="">@Text("Target", "البديل")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
                    <div class="col-7"><InputDate class="form-control" @bind-Value="swapModel.WorkDate" /></div>
                    <div class="col-5"><button class="btn btn-primary w-100" type="button" @onclick="CreateSwapAsync">@Text("Create", "إنشاء")</button></div>
                </div>
                <div class="table-responsive mt-3"><table class="table align-middle"><tbody>
                    @foreach (var item in swapRequests)
                    {
                        <tr><td>@Date(item.WorkDate)<br />@EmployeeName(item.RequestingEmployeeId) -> @EmployeeName(item.TargetEmployeeId)</td><td><span class="badge text-bg-@ExceptionCss(item.Status)">@item.Status</span></td><td class="text-end"><button class="btn btn-outline-success btn-sm" disabled="@(item.Status != AttendanceExceptionStatus.Pending)" @onclick="() => ReviewSwapAsync(item.Id, true)">@Text("Approve", "اعتماد")</button> <button class="btn btn-outline-danger btn-sm" disabled="@(item.Status != AttendanceExceptionStatus.Pending)" @onclick="() => ReviewSwapAsync(item.Id, false)">@Text("Reject", "رفض")</button> <button class="btn btn-outline-warning btn-sm" disabled="@(item.Status != AttendanceExceptionStatus.Pending)" @onclick="() => CancelSwapAsync(item.Id)">@Text("Cancel", "إلغاء")</button></td></tr>
                    }
                </tbody></table></div>
            </AppCard>
        </div>
        <div class="col-xl-4">
            <AppCard Title="@Text("Corrections", "التصحيحات")">
                <div class="row g-2">
                    <div class="col-7"><select class="form-select" @bind="correctionEmployeeId"><option value="">@Text("Employee", "الموظف")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
                    <div class="col-5"><InputDate class="form-control" @bind-Value="correctionModel.WorkDate" /></div>
                    <div class="col-6"><input type="datetime-local" class="form-control" value="@FormatDateTimeLocal(correctionModel.CorrectedCheckInUtc)" @onchange="args => correctionModel.CorrectedCheckInUtc = ParseDateTimeLocal(args.Value?.ToString())" /></div>
                    <div class="col-6"><input type="datetime-local" class="form-control" value="@FormatDateTimeLocal(correctionModel.CorrectedCheckOutUtc)" @onchange="args => correctionModel.CorrectedCheckOutUtc = ParseDateTimeLocal(args.Value?.ToString())" /></div>
                    <div class="col-12"><input class="form-control" placeholder="@Text("Reason", "السبب")" @bind="correctionModel.Reason" /></div>
                    <div class="col-12"><button class="btn btn-primary w-100" type="button" @onclick="CreateCorrectionAsync">@Text("Create correction", "إنشاء تصحيح")</button></div>
                </div>
                <div class="table-responsive mt-3"><table class="table align-middle"><thead><tr><th>@Text("Employee", "الموظف")</th><th>@Text("Current", "الحالي")</th><th>@Text("Correction", "التصحيح")</th><th>@Text("Status", "الحالة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead><tbody>
                    @foreach (var item in corrections)
                    {
                        <tr>
                            <td>@Date(item.WorkDate)<br />@EmployeeName(item.EmployeeId)</td>
                            <td>@CorrectionSituation(item.CurrentCheckInUtc, item.CurrentCheckOutUtc)<br /><span class="text-muted small">@(item.CurrentSessionStatus?.ToString() ?? Text("No session", "لا توجد جلسة"))</span></td>
                            <td>@CorrectionSituation(item.CorrectedCheckInUtc, item.CorrectedCheckOutUtc)</td>
                            <td><span class="badge text-bg-@ExceptionCss(item.Status)">@item.Status</span>@if (item.AppliedAtUtc.HasValue) { <div class="text-muted small">@Text("Applied", "مطبق")</div> }</td>
                            <td class="text-end"><button class="btn btn-outline-success btn-sm" disabled="@(item.Status != AttendanceExceptionStatus.Pending)" @onclick="() => ReviewCorrectionAsync(item.Id, true)">@Text("Approve & apply", "اعتماد وتطبيق")</button> <button class="btn btn-outline-danger btn-sm" disabled="@(item.Status != AttendanceExceptionStatus.Pending)" @onclick="() => ReviewCorrectionAsync(item.Id, false)">@Text("Reject", "رفض")</button></td>
                        </tr>
                    }
                </tbody></table></div>
            </AppCard>
        </div>
        <div class="col-xl-4">
            <AppCard Title="@Text("Biometric device punch staging", "تجهيز بصمات أجهزة الحضور")">
                <div class="row g-2">
                    <div class="col-12"><div class="text-muted small">@Text("Stage punch rows from biometric or time-clock devices before posting them. Posting marks accepted rows as posted; it does not create attendance sessions.", "جهز صفوف البصمة من أجهزة الحضور قبل ترحيلها. الترحيل يعلّم الصفوف المقبولة كمرحلة ولا ينشئ جلسات حضور.")</div></div>
                    <div class="col-12"><input class="form-control" placeholder="@Text("Device or file source", "مصدر الجهاز أو الملف")" @bind="batchModel.SourceName" /></div>
                    <div class="col-12"><input class="form-control" placeholder="@Text("Notes", "ملاحظات")" @bind="batchModel.Notes" /></div>
                    <div class="col-12"><button class="btn btn-primary w-100" type="button" @onclick="CreateBatchAsync">@Text("Create import batch", "إنشاء دفعة استيراد")</button></div>
                </div>
                <div class="table-responsive mt-3"><table class="table align-middle"><tbody>
                    @foreach (var batch in batches)
                    {
                        <tr class="@(selectedBatchId == batch.Id ? "table-primary" : string.Empty)"><td>@batch.SourceName<br />@batch.Status</td><td>@batch.AcceptedRows / @batch.TotalRows</td><td class="text-end"><button class="btn btn-outline-primary btn-sm" @onclick="() => SelectBatch(batch)">@Text("Rows", "الصفوف")</button> <button class="btn btn-outline-dark btn-sm" disabled="@(batch.Status == AttendanceImportBatchStatus.Posted)" @onclick="() => PostBatchAsync(batch.Id)">@Text("Post", "ترحيل")</button></td></tr>
                    }
                </tbody></table></div>
                @if (selectedBatch is not null)
                {
                    <div class="border-top pt-3 mt-3">
                        <h6 class="mb-2">@Text("Staged punch rows", "صفوف البصمة المرحلية")</h6>
                        <div class="row g-2">
                            <div class="col-6"><select class="form-select" @bind="importRowEmployeeId"><option value="">@Text("Employee", "الموظف")</option>@foreach (var employee in employees){<option value="@employee.Id">@EmployeeName(employee)</option>}</select></div>
                            <div class="col-6"><InputText class="form-control" placeholder="@Text("Device code", "رمز الجهاز")" @bind-Value="importRowModel.DeviceEmployeeCode" /></div>
                            <div class="col-6"><InputDate class="form-control" @bind-Value="importRowPunchDate" /></div>
                            <div class="col-6"><InputText class="form-control" placeholder="HH:mm" @bind-Value="importRowPunchTime" /></div>
                            <div class="col-12"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="importRowModel.IsCheckOut" /> <span class="form-check-label">@Text("Checkout punch", "بصمة خروج")</span></label></div>
                            <div class="col-12 d-flex gap-2"><button class="btn btn-primary btn-sm" type="button" @onclick="SaveImportRowAsync" disabled="@(selectedBatch.Status == AttendanceImportBatchStatus.Posted)"><i class="bi bi-save"></i> @Text("Save Row", "حفظ الصف")</button><button class="btn btn-outline-secondary btn-sm" type="button" @onclick="ResetImportRow">@Text("Reset", "إعادة ضبط")</button></div>
                        </div>
                        <div class="table-responsive mt-2"><table class="table table-sm align-middle"><tbody>
                            @foreach (var row in selectedBatch.Rows)
                            {
                                <tr><td>@(row.EmployeeName ?? row.DeviceEmployeeCode ?? "-")<br /><span class="text-muted small">@row.PunchTimeUtc.ToString("yyyy-MM-dd HH:mm")</span></td><td><span class="badge text-bg-@ImportRowCss(row.Status)">@row.Status</span></td><td class="text-end"><button class="btn btn-outline-primary btn-sm" @onclick="() => EditImportRow(row)"><i class="bi bi-pencil"></i></button> <button class="btn btn-outline-success btn-sm" disabled="@(row.Status == AttendanceImportRowStatus.Posted)" @onclick="() => ReviewImportRowAsync(row.Id, true)">@Text("Accept", "قبول")</button> <button class="btn btn-outline-danger btn-sm" disabled="@(row.Status == AttendanceImportRowStatus.Posted)" @onclick="() => ReviewImportRowAsync(row.Id, false)">@Text("Reject", "رفض")</button></td></tr>
                            }
                        </tbody></table></div>
                    </div>
                }
            </AppCard>
        </div>
    </div>
</main>

@code {
    private Guid companyId;
    private AuthenticationState? authState;
    private string? message;
    private string messageClass = "alert-info";
    private List<EmployeeDto> employees = [];
    private List<ShiftDto> shifts = [];
    private List<ShiftScheduleDto> schedules = [];
    private List<ShiftScheduleAssignmentDto> assignments = [];
    private List<ShiftSwapRequestDto> swapRequests = [];
    private List<AttendanceCorrectionDto> corrections = [];
    private List<BiometricImportBatchDto> batches = [];
    private AttendanceRosterControlDto rosterControl = new();
    private List<AttendanceRosterSubstituteConfigurationDto> substituteConfigurations = [];
    private string? substituteSearch;
    private DateTime rosterFromDate = DateTime.Today;
    private DateTime rosterToDate = DateTime.Today.AddDays(6);
    private string? rosterDepartmentId;
    private string? rosterShiftId;
    private string? rosterStatus;
    private bool isLoadingRoster;
    private bool isLoadingSubstituteConfigurations;
    private Guid selectedBatchId;
    private UpsertShiftScheduleDto scheduleModel = NewSchedule();
    private UpsertShiftScheduleAssignmentDto assignmentModel = new() { WorkDate = DateTime.Today };
    private DateTime bulkStartDate = DateTime.Today;
    private DateTime bulkEndDate = DateTime.Today;
    private HashSet<Guid> assignmentEmployeeIds = [];
    private CreateShiftSwapRequestDto swapModel = new() { WorkDate = DateTime.Today };
    private string? swapRequestingEmployeeId;
    private string? swapTargetEmployeeId;
    private CreateAttendanceCorrectionDto correctionModel = new() { WorkDate = DateTime.Today };
    private string? correctionEmployeeId;
    private CreateBiometricImportBatchDto batchModel = new();
    private UpsertBiometricImportRowDto importRowModel = new();
    private string? importRowEmployeeId;
    private DateTime importRowPunchDate = DateTime.Today;
    private string importRowPunchTime = DateTime.Now.ToString("HH:mm");
    private BiometricImportBatchDto? selectedBatch => batches.FirstOrDefault(x => x.Id == selectedBatchId);

    protected override void OnInitialized() => SharedDataService.OnChange1 += HandleChangeAsync;
    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        companyId = await ResolveCompanyIdAsync();
        scheduleModel.CompanyId = companyId;
        ResetAssignment();
        swapModel.CompanyId = companyId;
        correctionModel.CompanyId = companyId;
        batchModel.CompanyId = companyId;
        ResetImportRow();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        employees = (await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000)).Data?.Data.ToList() ?? [];
        shifts = (await AttendanceService.GetShiftsAsync(companyId)).Data ?? [];
        await LoadRosterSubstituteConfigurationsAsync();
        await LoadRosterControlAsync();
        await LoadSchedulesAsync();
        await LoadAssignmentsAsync();
        swapRequests = (await AttendanceService.GetShiftSwapRequestsAsync(companyId)).Data ?? [];
        corrections = (await AttendanceService.GetAttendanceCorrectionsAsync(companyId)).Data ?? [];
        batches = (await AttendanceService.GetBiometricImportBatchesAsync(companyId)).Data ?? [];
    }

    private async Task LoadRosterControlAsync()
    {
        if (companyId == Guid.Empty)
        {
            return;
        }

        isLoadingRoster = true;
        var result = await AttendanceService.GetRosterControlAsync(new AttendanceRosterControlFilterDto
        {
            CompanyId = companyId,
            FromDate = rosterFromDate,
            ToDate = rosterToDate,
            DepartmentId = ParseNullable(rosterDepartmentId),
            ShiftId = ParseNullable(rosterShiftId),
            Status = Enum.TryParse<AttendanceRosterControlStatus>(rosterStatus, out var status) ? status : null
        });

        if (result.IsSuccess)
        {
            rosterControl = result.Data ?? new();
            EnrichRosterRows();
        }
        else
        {
            rosterControl = new();
            SetMessage(Error(result), "alert-danger");
        }

        isLoadingRoster = false;
    }

    private async Task LoadSchedulesAsync()
    {
        schedules = (await AttendanceService.GetShiftSchedulesAsync(companyId)).Data ?? [];
        if (assignmentModel.ScheduleId != Guid.Empty && ActiveSchedules.All(x => x.Id != assignmentModel.ScheduleId))
        {
            assignmentModel.ScheduleId = Guid.Empty;
        }
    }
    private async Task LoadRosterSubstituteConfigurationsAsync()
    {
        if (companyId == Guid.Empty)
        {
            return;
        }

        isLoadingSubstituteConfigurations = true;
        var result = await AttendanceService.GetRosterSubstituteConfigurationsAsync(companyId);
        if (result.IsSuccess)
        {
            substituteConfigurations = result.Data ?? [];
        }
        else
        {
            substituteConfigurations = [];
            SetMessage(Error(result), "alert-danger");
        }

        isLoadingSubstituteConfigurations = false;
    }

    private async Task SaveSubstituteConfigurationAsync(AttendanceRosterSubstituteConfigurationDto config)
    {
        var result = await AttendanceService.UpsertRosterSubstituteConfigurationAsync(new UpsertAttendanceRosterSubstituteConfigurationDto
        {
            Id = config.Id,
            CompanyId = config.CompanyId,
            EmployeeId = config.EmployeeId,
            IsRosterVisible = config.IsRosterVisible,
            IsSubstituteEligible = config.IsSubstituteEligible,
            Notes = config.Notes
        });

        if (result.IsSuccess && result.Data is { } saved)
        {
            var index = substituteConfigurations.FindIndex(x => x.EmployeeId == saved.EmployeeId);
            if (index >= 0)
            {
                substituteConfigurations[index] = saved;
            }

            SetMessage(Text("Substitute configuration saved.", "تم حفظ إعداد البديل."), "alert-success");
            await LoadRosterControlAsync();
        }
        else
        {
            SetMessage(Error(result), "alert-danger");
        }
    }

    private async Task ToggleRosterVisibleAsync(AttendanceRosterSubstituteConfigurationDto config, bool value)
    {
        config.IsRosterVisible = value;
        await SaveSubstituteConfigurationAsync(config);
    }

    private async Task ToggleSubstituteEligibleAsync(AttendanceRosterSubstituteConfigurationDto config, bool value)
    {
        config.IsSubstituteEligible = value;
        await SaveSubstituteConfigurationAsync(config);
    }

    private async Task UpdateSubstituteNotesAsync(AttendanceRosterSubstituteConfigurationDto config, string? notes)
    {
        config.Notes = notes;
        await SaveSubstituteConfigurationAsync(config);
    }

    private void EnrichRosterRows()
    {
        var employeeLookup = employees.ToDictionary(x => x.Id);
        foreach (var row in rosterControl.Rows)
        {
            if (employeeLookup.TryGetValue(row.EmployeeId, out var employee))
            {
                row.DepartmentName ??= employee.DepartmentName;
                row.BranchName ??= employee.BranchName;
                row.AdministrationName ??= employee.AdministrationName;
                row.PositionName ??= employee.PositionName;
            }
        }
    }
    private async Task LoadAssignmentsAsync()
    {
        var activeScheduleIds = ActiveSchedules.Select(x => x.Id).ToHashSet();
        assignments = ((await AttendanceService.GetShiftScheduleAssignmentsAsync(0, 200, null, null, DateTime.Today.AddDays(-30), DateTime.Today.AddDays(30))).Data?.Data.ToList() ?? [])
            .Where(x => activeScheduleIds.Contains(x.ScheduleId))
            .ToList();
    }
    private async Task SaveScheduleAsync()
    {
        scheduleModel.CompanyId = companyId;
        var result = await AttendanceService.UpsertShiftScheduleAsync(scheduleModel);
        SetMessage(result.IsSuccess ? Text("Schedule saved.", "تم حفظ الجدول.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess) { scheduleModel = NewSchedule(companyId); await LoadSchedulesAsync(); }
    }

    private async Task SaveAssignmentAsync()
    {
        assignmentModel.CompanyId = companyId;
        ApiResult<object> result;
        if (assignmentModel.Id.HasValue && assignmentModel.Id.Value != Guid.Empty)
        {
            assignmentModel.EmployeeId = assignmentEmployeeIds.FirstOrDefault();
            var singleResult = await AttendanceService.UpsertShiftScheduleAssignmentAsync(assignmentModel);
            result = ToObjectResult(singleResult);
        }
        else
        {
            var bulkResult = await AttendanceService.BulkShiftScheduleAssignmentAsync(new BulkShiftScheduleAssignmentDto
            {
                ScheduleId = assignmentModel.ScheduleId,
                CompanyId = companyId,
                ShiftId = assignmentModel.ShiftId,
                EmployeeIds = assignmentEmployeeIds.ToList(),
                StartDate = assignmentModel.WorkDate,
                EndDate = assignmentModel.WorkDate,
                Notes = assignmentModel.Notes
            });
            result = ToObjectResult(bulkResult);
        }

        SetMessage(result.IsSuccess ? Text("Roster assignment saved.", "تم حفظ تعيين الوردية.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess) { ResetAssignment(); await LoadAssignmentsAsync(); await LoadRosterControlAsync(); }
    }

    private async Task AssignRosterAsync()
    {
        var result = await AttendanceService.BulkShiftScheduleAssignmentAsync(new BulkShiftScheduleAssignmentDto { ScheduleId = assignmentModel.ScheduleId, CompanyId = companyId, ShiftId = assignmentModel.ShiftId, EmployeeIds = assignmentEmployeeIds.ToList(), StartDate = bulkStartDate, EndDate = bulkEndDate, Notes = assignmentModel.Notes });
        SetMessage(result.IsSuccess ? Text("Roster assignment saved.", "تم حفظ تعيين الوردية.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess) { await LoadAssignmentsAsync(); await LoadRosterControlAsync(); }
    }

    private async Task CreateSwapAsync() { swapModel.CompanyId = companyId; swapModel.RequestingEmployeeId = Parse(swapRequestingEmployeeId); swapModel.TargetEmployeeId = Parse(swapTargetEmployeeId); var result = await AttendanceService.CreateShiftSwapRequestAsync(swapModel); SetMessage(result.IsSuccess ? Text("Swap request created.", "تم إنشاء طلب التبديل.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) { swapModel = new() { CompanyId = companyId, WorkDate = DateTime.Today }; swapRequestingEmployeeId = null; swapTargetEmployeeId = null; swapRequests = (await AttendanceService.GetShiftSwapRequestsAsync(companyId)).Data ?? []; } }
    private async Task CreateCorrectionAsync() { correctionModel.CompanyId = companyId; correctionModel.EmployeeId = Parse(correctionEmployeeId); var result = await AttendanceService.CreateAttendanceCorrectionAsync(correctionModel); SetMessage(result.IsSuccess ? Text("Correction created.", "تم إنشاء التصحيح.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) { correctionModel = new() { CompanyId = companyId, WorkDate = DateTime.Today }; correctionEmployeeId = null; corrections = (await AttendanceService.GetAttendanceCorrectionsAsync(companyId)).Data ?? []; } }
    private async Task CreateBatchAsync() { batchModel.CompanyId = companyId; var result = await AttendanceService.CreateBiometricImportBatchAsync(batchModel); SetMessage(result.IsSuccess ? Text("Import batch created.", "تم إنشاء دفعة الاستيراد.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) { batchModel = new() { CompanyId = companyId }; batches = (await AttendanceService.GetBiometricImportBatchesAsync(companyId)).Data ?? []; } }
    private async Task ScheduleActionAsync(Func<Task<ApiResult<ShiftScheduleDto>>> action, string success) { var result = await action(); SetMessage(result.IsSuccess ? success : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) { await LoadSchedulesAsync(); await LoadAssignmentsAsync(); await LoadRosterControlAsync(); } }
    private async Task PublishScheduleAsync(Guid id) => await ScheduleActionAsync(() => AttendanceService.PublishShiftScheduleAsync(id), Text("Schedule published.", "تم نشر الجدول."));
    private async Task LockScheduleAsync(Guid id) => await ScheduleActionAsync(() => AttendanceService.LockShiftScheduleAsync(id), Text("Schedule locked.", "تم إقفال الجدول."));
    private async Task CancelScheduleAsync(Guid id)
    {
        var schedule = schedules.FirstOrDefault(x => x.Id == id);
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Confirm cancellation", "تأكيد الإلغاء"),
            Message = Text($"Cancel schedule: {schedule?.Name ?? id.ToString()}?", $"إلغاء الجدول: {schedule?.Name ?? id.ToString()}؟"),
            ShowCancel = true,
            Variant = ModalVariant.Warning,
            OkText = Text("Yes, cancel", "نعم، إلغاء"),
            CancelText = Text("Keep schedule", "إبقاء الجدول"),
            OnOk = async () => await ScheduleActionAsync(() => AttendanceService.CancelShiftScheduleAsync(id), Text("Schedule cancelled.", "تم إلغاء الجدول."))
        });
    }
    private async Task ReviewSwapAsync(Guid id, bool approve) => await ApplyRosterActionAsync(() => AttendanceService.ReviewShiftSwapRequestAsync(new ReviewShiftSwapRequestDto { RequestId = id, IsApproved = approve }), async () => swapRequests = (await AttendanceService.GetShiftSwapRequestsAsync(companyId)).Data ?? []);
    private async Task CancelSwapAsync(Guid id) => await ApplyRosterActionAsync(() => AttendanceService.CancelShiftSwapRequestAsync(id), async () => swapRequests = (await AttendanceService.GetShiftSwapRequestsAsync(companyId)).Data ?? []);
    private async Task ReviewCorrectionAsync(Guid id, bool approve) => await ApplyRosterActionAsync(() => AttendanceService.ReviewAttendanceCorrectionAsync(new ReviewAttendanceCorrectionDto { CorrectionId = id, IsApproved = approve }), async () => { corrections = (await AttendanceService.GetAttendanceCorrectionsAsync(companyId)).Data ?? []; await LoadRosterControlAsync(); });
    private async Task PostBatchAsync(Guid id) => await ApplyRosterActionAsync(() => AttendanceService.PostBiometricImportBatchAsync(id), async () => batches = (await AttendanceService.GetBiometricImportBatchesAsync(companyId)).Data ?? []);
    private async Task ApplyRosterActionAsync<T>(Func<Task<ApiResult<T>>> action, Func<Task> reload) { var result = await action(); SetMessage(result.IsSuccess ? Text("Action completed.", "تم تنفيذ الإجراء.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) await reload(); }
    private async Task DeleteAssignmentAsync(Guid id) { var result = await AttendanceService.DeleteShiftScheduleAssignmentAsync(id); SetMessage(result.IsSuccess ? Text("Assignment deleted.", "تم حذف التعيين.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger"); if (result.IsSuccess) await LoadAssignmentsAsync(); }
    private void EditSchedule(ShiftScheduleDto schedule) => scheduleModel = new() { Id = schedule.Id, CompanyId = schedule.CompanyId, Name = schedule.Name, StartDate = schedule.StartDate, EndDate = schedule.EndDate, Notes = schedule.Notes };
    private void EditAssignment(ShiftScheduleAssignmentDto item) { assignmentModel = new() { Id = item.Id, CompanyId = item.CompanyId, ScheduleId = item.ScheduleId, EmployeeId = item.EmployeeId, ShiftId = item.ShiftId, WorkDate = item.WorkDate, Notes = item.Notes }; assignmentEmployeeIds = new HashSet<Guid> { item.EmployeeId }; }
    private void ResetAssignment() { assignmentModel = new() { CompanyId = companyId, WorkDate = DateTime.Today }; assignmentEmployeeIds.Clear(); bulkStartDate = DateTime.Today; bulkEndDate = DateTime.Today; }
    private void SelectBatch(BiometricImportBatchDto batch) { selectedBatchId = batch.Id; ResetImportRow(); }
    private async Task SaveImportRowAsync()
    {
        if (selectedBatchId == Guid.Empty) return;
        importRowModel.BatchId = selectedBatchId;
        importRowModel.CompanyId = companyId;
        importRowModel.EmployeeId = ParseNullable(importRowEmployeeId);
        importRowModel.PunchTimeUtc = importRowPunchDate.Date + (TimeSpan.TryParse(importRowPunchTime, out var time) ? time : TimeSpan.Zero);
        var result = await AttendanceService.UpsertBiometricImportRowAsync(importRowModel);
        SetMessage(result.IsSuccess ? Text("Import row saved.", "تم حفظ صف الاستيراد.") : Error(result), result.IsSuccess ? "alert-success" : "alert-danger");
        if (result.IsSuccess) { ResetImportRow(); batches = (await AttendanceService.GetBiometricImportBatchesAsync(companyId)).Data ?? []; }
    }
    private async Task ReviewImportRowAsync(Guid rowId, bool accept) => await ApplyRosterActionAsync(() => AttendanceService.ReviewBiometricImportRowAsync(new ReviewBiometricImportRowDto { RowId = rowId, IsAccepted = accept }), async () => batches = (await AttendanceService.GetBiometricImportBatchesAsync(companyId)).Data ?? []);
    private void EditImportRow(BiometricImportRowDto row) { importRowModel = new() { Id = row.Id, BatchId = row.BatchId, CompanyId = row.CompanyId, EmployeeId = row.EmployeeId, DeviceEmployeeCode = row.DeviceEmployeeCode, PunchTimeUtc = row.PunchTimeUtc, IsCheckOut = row.IsCheckOut, ErrorMessage = row.ErrorMessage }; importRowEmployeeId = row.EmployeeId?.ToString(); importRowPunchDate = row.PunchTimeUtc.Date; importRowPunchTime = row.PunchTimeUtc.ToString("HH:mm"); }
    private void ResetImportRow() { importRowModel = new() { CompanyId = companyId, BatchId = selectedBatchId, PunchTimeUtc = DateTime.UtcNow }; importRowEmployeeId = null; importRowPunchDate = DateTime.Today; importRowPunchTime = DateTime.Now.ToString("HH:mm"); }
    private static UpsertShiftScheduleDto NewSchedule(Guid companyId = default) => new() { CompanyId = companyId, StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(6) };
    private string EmployeeName(Guid id) => employees.FirstOrDefault(x => x.Id == id) is { } employee ? EmployeeName(employee) : id.ToString();
    private string EmployeeName(EmployeeDto employee) => SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);
    private string ShiftName(Guid id) => shifts.FirstOrDefault(x => x.Id == id)?.Name ?? id.ToString();
    private static string Date(DateTime value) => value.ToString("yyyy-MM-dd");
    private List<ShiftScheduleDto> ActiveSchedules => schedules
        .Where(x => x.Status != AttendanceRosterStatus.Cancelled)
        .ToList();
    private void ToggleAssignmentEmployee(Guid employeeId, bool isSelected)
    {
        if (isSelected)
        {
            assignmentEmployeeIds.Add(employeeId);
        }
        else
        {
            assignmentEmployeeIds.Remove(employeeId);
        }
    }
    private Task OnAssignmentEmployeesChanged(HashSet<Guid> selectedIds)
    {
        assignmentEmployeeIds = selectedIds;
        return Task.CompletedTask;
    }
    private static ApiResult<object> ToObjectResult<T>(ApiResult<T> result)
        => new() { IsSuccess = result.IsSuccess, Data = result.Data, Error = result.Error };
    private static string FormatDateTimeLocal(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-ddTHH:mm") : string.Empty;
    private static DateTime? ParseDateTimeLocal(string? value)
        => DateTime.TryParse(value, out var parsed) ? parsed : null;
    private string CorrectionSituation(DateTime? checkIn, DateTime? checkOut)
        => $"{TimeValue(checkIn)} - {TimeValue(checkOut)}";
    private string TimeValue(DateTime? value)
        => value.HasValue ? value.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm") : Text("Missing", "غير مسجل");
    private static string RosterCss(AttendanceRosterStatus status) => status switch { AttendanceRosterStatus.Published => "primary", AttendanceRosterStatus.Locked => "dark", AttendanceRosterStatus.Cancelled => "secondary", _ => "light" };
    private string RosterStatusText(AttendanceRosterControlStatus status) => status switch
    {
        AttendanceRosterControlStatus.Active => Text("Active", "نشط"),
        AttendanceRosterControlStatus.OnBreak => Text("On break", "في استراحة"),
        AttendanceRosterControlStatus.Completed => Text("Completed", "مكتمل"),
        AttendanceRosterControlStatus.OnApprovedLeave => Text("On approved leave", "في إجازة معتمدة"),
        AttendanceRosterControlStatus.Absent => Text("Absent", "غائب"),
        _ => Text("Planned", "مخطط")
    };
    private static string RosterStatusTone(AttendanceRosterControlStatus status) => status switch
    {
        AttendanceRosterControlStatus.Active => "success",
        AttendanceRosterControlStatus.OnBreak => "warning",
        AttendanceRosterControlStatus.Completed => "primary",
        AttendanceRosterControlStatus.OnApprovedLeave => "info",
        AttendanceRosterControlStatus.Absent => "danger",
        _ => "muted"
    };
    private static bool IsPresent(AttendanceRosterControlStatus status)
        => status is AttendanceRosterControlStatus.Active or AttendanceRosterControlStatus.OnBreak or AttendanceRosterControlStatus.Completed;
    private static string ExceptionCss(AttendanceExceptionStatus status) => status switch { AttendanceExceptionStatus.Approved => "success", AttendanceExceptionStatus.Rejected => "danger", AttendanceExceptionStatus.Cancelled => "secondary", _ => "warning" };
    private static string ImportRowCss(AttendanceImportRowStatus status) => status switch { AttendanceImportRowStatus.Accepted => "success", AttendanceImportRowStatus.Rejected => "danger", AttendanceImportRowStatus.Posted => "dark", _ => "warning" };
    private bool Can(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private static Guid Parse(string? value) => Guid.TryParse(value, out var id) ? id : Guid.Empty;
    private static Guid? ParseNullable(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private string Error<T>(ApiResult<T> result) => result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Operation failed.", "تعذر تنفيذ العملية.");
    private void SetMessage(string text, string css) { message = text; messageClass = css; }
    private async Task<Guid> ResolveCompanyIdAsync() => Guid.TryParse((await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync()).User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string? TextValue(string? en, string? ar)
    {
        var value = SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }
    private string RosterEmployeeName(AttendanceRosterControlRowDto row)
        => TextValue(row.EmployeeNameEng, row.EmployeeName) ?? row.EmployeeId.ToString()[..8];
    private string RosterCandidateName(AttendanceRosterSubstituteCandidateDto candidate)
        => TextValue(candidate.EmployeeNameEng, candidate.EmployeeName) ?? candidate.EmployeeId.ToString()[..8];
    private string CandidateSourceText(AttendanceRosterSubstituteCandidateSource source)
        => source == AttendanceRosterSubstituteCandidateSource.Department
            ? Text("Department", "القسم")
            : Text("Administration", "الإدارة");
    private string ConfigurationEmployeeName(AttendanceRosterSubstituteConfigurationDto config)
        => TextValue(config.EmployeeNameEng, config.EmployeeName)
            ?? (employees.FirstOrDefault(x => x.Id == config.EmployeeId) is { } employee ? EmployeeName(employee) : config.EmployeeId.ToString()[..8]);
    private string ConfigurationAdministrationName(AttendanceRosterSubstituteConfigurationDto config)
        => employees.FirstOrDefault(x => x.Id == config.EmployeeId)?.AdministrationName ?? config.AdministrationId.ToString()[..8];
    private string ConfigurationDepartmentName(AttendanceRosterSubstituteConfigurationDto config)
        => employees.FirstOrDefault(x => x.Id == config.EmployeeId)?.DepartmentName ?? Text("Administration fallback", "بديل حسب الإدارة");
    private static bool IsChecked(ChangeEventArgs args) => args.Value is bool value && value;
    private List<AttendanceRosterSubstituteConfigurationDto> FilteredSubstituteConfigurations
    {
        get
        {
            if (string.IsNullOrWhiteSpace(substituteSearch))
            {
                return substituteConfigurations
                    .OrderBy(ConfigurationEmployeeName)
                    .ToList();
            }

            var search = substituteSearch.Trim();
            return substituteConfigurations
                .Where(x => Contains(ConfigurationEmployeeName(x), search)
                    || Contains(x.EmployeeNo, search)
                    || Contains(x.EmployeeCode, search)
                    || Contains(ConfigurationDepartmentName(x), search)
                    || Contains(ConfigurationAdministrationName(x), search))
                .OrderBy(ConfigurationEmployeeName)
                .ToList();
        }
    }
    private static bool Contains(string? value, string search)
        => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase);
    private IEnumerable<DepartmentOption> DepartmentOptions => employees
        .Where(x => x.DepartmentId.HasValue)
        .GroupBy(x => x.DepartmentId!.Value)
        .Select(x => new DepartmentOption(x.Key, x.Select(e => e.DepartmentName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n)) ?? x.Key.ToString()[..8]))
        .OrderBy(x => x.Name);
    private RenderFragment RosterKpi(string label, int value, string icon) => builder =>
    {
        builder.OpenElement(0, "div");
        builder.AddAttribute(1, "class", "roster-kpi");
        builder.OpenElement(2, "i");
        builder.AddAttribute(3, "class", $"bi {icon}");
        builder.CloseElement();
        builder.OpenElement(4, "div");
        builder.OpenElement(5, "span");
        builder.AddContent(6, label);
        builder.CloseElement();
        builder.OpenElement(7, "strong");
        builder.AddContent(8, value);
        builder.CloseElement();
        builder.CloseElement();
        builder.CloseElement();
    };
    private sealed record DepartmentOption(Guid Id, string Name);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}

