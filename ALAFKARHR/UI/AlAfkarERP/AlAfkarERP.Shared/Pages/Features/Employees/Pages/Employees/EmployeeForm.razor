        selectedPosition = position;
        employee.PositionId = selectedPosition?.Id??null;
    }




    
    private SpecializationDto? selectedSpecialization;
    private async Task OnSpecializationSelected(SpecializationDto specialization)
    {
        selectedSpecialization = specialization;

        employee.SpecializationId = selectedSpecialization?.Id??null;
    }

