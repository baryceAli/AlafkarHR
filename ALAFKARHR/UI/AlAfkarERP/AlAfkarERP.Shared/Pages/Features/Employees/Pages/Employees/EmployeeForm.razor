@layout AdminLayout
@implements IDisposable
@page "/Employee/Employee/Form/{Id:guid?}"

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Employees.Enums
@using SharedWithUI.Permissions
@using SharedWithUI.Attendance.Enums
@inject IBranchService BranchService
@inject IAdministrationService AdministrationService
@inject IDepartmentService DepartmentService
@inject IEmployeeService EmployeeService
@inject IPositionService PositionService
@inject IAcademicInistitutionService AcademicInistitutionService
@inject ISpecializationService SpecializationService
@inject ApiConfig ApiConfig
@inject AuthenticationStateProvider AuthenticationStateProvider

@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager

@if (!AuthState.User.Claims.Any(c => c.Value == PermissionList.EmployeePermissions.Create) ||
    !AuthState.User.Claims.Any(c => c.Value == PermissionList.EmployeePermissions.Edit))
{
    <div class="alert alert-warning">
        <span>
            @SharedDataService.SelectViewLang("You don't have permissions to view this page",
            "ليس لديك الصلاحية لعرض هذه الصفحة")
        </span>
    </div>
    return;
}
<div class="erp-page employee-form-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@title"
                Overline="@(SharedDataService.SelectViewLang("People", "الأفراد"))"
                Icon="bi-person-badge"
                Subtitle="@(SharedDataService.SelectViewLang("Create and maintain employee identity, position, qualification, and attendance settings.", "إنشاء وتحديث بيانات الهوية والموقع الوظيفي والمؤهلات وإعدادات الحضور للموظف."))">
        <Actions>
            <button type="button" class="btn btn-outline-secondary employee-form-action" @onclick="onCancel">
                <i class="bi bi-x-lg"></i>
                @SharedDataService.SelectViewLang("Cancel", "إلغاء")
            </button>
            <button type="submit" form="employee-form" class="btn btn-primary employee-form-action">
                <i class="bi bi-floppy2-fill"></i>
                @(Id.HasValue ? SharedDataService.SelectViewLang("Update", "تعديل") : SharedDataService.SelectViewLang("Save", "حفظ"))
            </button>
        </Actions>
    </PageHeader>

    <EditForm id="employee-form" Model="employee" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />

        <div class="employee-form-stack">
            <AppCard Title="@(SharedDataService.SelectViewLang("Employment Location", "الموقع الوظيفي"))"
                     Subtitle="@(SharedDataService.SelectViewLang("Connect the employee to the correct branch, administration, and department.", "ربط الموظف بالفرع والإدارة والقسم المناسب."))">
                @if (!Id.HasValue || 1 == 1)
                {
                    <div class="employee-form-grid employee-form-grid-three">
                        <div class="employee-field">
                            <label class="form-label">@SharedDataService.SelectViewLang("Branch", "الفرع")</label>
                            <AutoCompleteComponent TItem="BranchDto"
                                                   Items="branches"
                                                   Value="selectedBranch"
                                                   ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                                   ValueChanged="OnBranchSelected">
                            </AutoCompleteComponent>
                            <ValidationMessage For="() => employee.BranchId" />
                        </div>

                        <div class="employee-field">
                            <label class="form-label">@SharedDataService.SelectViewLang("Administration", "الإدارة")</label>
                            <AutoCompleteComponent TItem="AdministrationDto"
                                                   Items="administrations"
                                                   Value="selectedAdministration"
                                                   ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                                   ValueChanged="OnAdministrationSelected">
                            </AutoCompleteComponent>
                            <ValidationMessage For="() => employee.AdministrationId" />
                        </div>

                        <div class="employee-field">
                            <label class="form-label">@SharedDataService.SelectViewLang("Department", "القسم")</label>
                            <AutoCompleteComponent TItem="DepartmentDto"
                                                   Items="departments"
                                                   Value="selectedDepartment"
                                                   ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                                   ValueChanged="OnDepartmentSelected">
                            </AutoCompleteComponent>
                            @* <ValidationMessage For="() => employee.DepartmentId" /> *@
                        </div>
                    </div>
                }
            </AppCard>

            <AppCard Title="@(SharedDataService.SelectViewLang("Profile & Identity", "الملف والهوية"))"
                     Subtitle="@(SharedDataService.SelectViewLang("Core personal information used across employee records and authentication.", "البيانات الشخصية الأساسية المستخدمة في سجلات الموظفين وتسجيل الدخول."))">
                <div class="employee-profile-layout">
                    <div class="employee-photo-panel">
                        <label for="profileUpload" class="employee-avatar-upload">
                            <img src="@(string.IsNullOrEmpty(employee?.PhotoUrl)
                                ? "_content/AlAfkarERP.Shared/images/empPlaceholder.png"
                                : (employee.PhotoUrl.Contains("data:")
                                    ? employee.PhotoUrl
                                    : $"{ApiConfig.BaseURL}/Images/Employees/{employee.PhotoUrl}"))"
                                 alt="@(SharedDataService.SelectViewLang("Employee photo", "صورة الموظف"))"
                                 class="employee-avatar" />
                            <span class="btn btn-outline-primary btn-sm employee-photo-button">
                                <i class="bi bi-camera"></i>
                                @SharedDataService.SelectViewLang("Change photo", "تغيير الصورة")
                            </span>
                        </label>

                        <InputFile id="profileUpload"
                                   class="employee-file-input"
                                   OnChange="OnEmployeeImageSelected"
                                   accept="image/*" />
                        <div class="employee-help-text">
                            @SharedDataService.SelectViewLang("Upload a clear profile image for employee records.", "ارفع صورة واضحة لملف الموظف.")
                        </div>
                        <ValidationMessage For="@(() => employee.PhotoUrl)" class="text-danger" />
                    </div>

                    <div class="employee-profile-fields">
                        <div class="employee-form-grid">
                            <div class="employee-field">
                                <label for="employee-code" class="form-label">@SharedDataService.SelectViewLang("Code", "الكود")</label>
                                <InputText class="form-control" id="employee-code" @bind-Value="employee.Code" />
                                <div class="employee-help-text">
                                    @SharedDataService.SelectViewLang("Used as the username when the employee signs in.", "يمثل اسم المستخدم ويتم استخدامه عند تسجيل الدخول.")
                                </div>
                                <ValidationMessage For="() => employee.Code" />
                            </div>

                            @if (!Id.HasValue || 1 == 1)
                            {
                                <div class="employee-field">
                                    <label for="employee-date-of-birth" class="form-label">@SharedDataService.SelectViewLang("Date Of Birth", "تاريخ الميلاد")</label>
                                    <InputDate class="form-control" id="employee-date-of-birth" @bind-Value="employee.DateOfBirth" />
                                    <ValidationMessage For="() => employee.DateOfBirth" />
                                </div>
                            }
                        </div>

                        <div class="employee-name-group">
                            <div class="employee-group-label">@SharedDataService.SelectViewLang("Employee Name (Ar)", "اسم الموظف (ع)")</div>
                            <div class="employee-form-grid employee-form-grid-three">
                                <div class="employee-field">
                                    <label for="employee-first-name-ar" class="form-label">@SharedDataService.SelectViewLang("First", "الأول")</label>
                                    <InputText class="form-control" id="employee-first-name-ar" @bind-Value="employee.FirstName" />
                                    <ValidationMessage For="() => employee.FirstName" />
                                </div>
                                <div class="employee-field">
                                    <label for="employee-middle-name-ar" class="form-label">@SharedDataService.SelectViewLang("Middle", "الأوسط")</label>
                                    <InputText class="form-control" id="employee-middle-name-ar" @bind-Value="employee.MiddleName" />
                                    <ValidationMessage For="() => employee.MiddleName" />
                                </div>
                                <div class="employee-field">
                                    <label for="employee-last-name-ar" class="form-label">@SharedDataService.SelectViewLang("Last", "الأخير")</label>
                                    <InputText class="form-control" id="employee-last-name-ar" @bind-Value="employee.LastName" />
                                    <ValidationMessage For="() => employee.LastName" />
                                </div>
                            </div>
                        </div>

                        <div class="employee-name-group">
                            <div class="employee-group-label">@SharedDataService.SelectViewLang("Employee Name (Eng.)", "اسم الموظف (E)")</div>
                            <div class="employee-form-grid employee-form-grid-three">
                                <div class="employee-field">
                                    <label for="employee-first-name-en" class="form-label">@SharedDataService.SelectViewLang("First", "الأول")</label>
                                    <InputText class="form-control" id="employee-first-name-en" @bind-Value="employee.FirstNameEng" />
                                    <ValidationMessage For="() => employee.FirstNameEng" />
                                </div>
                                <div class="employee-field">
                                    <label for="employee-middle-name-en" class="form-label">@SharedDataService.SelectViewLang("Middle", "الأوسط")</label>
                                    <InputText class="form-control" id="employee-middle-name-en" @bind-Value="employee.MiddleNameEng" />
                                    <ValidationMessage For="() => employee.MiddleNameEng" />
                                </div>
                                <div class="employee-field">
                                    <label for="employee-last-name-en" class="form-label">@SharedDataService.SelectViewLang("Last", "الأخير")</label>
                                    <InputText class="form-control" id="employee-last-name-en" @bind-Value="employee.LastNameEng" />
                                    <ValidationMessage For="() => employee.LastNameEng" />
                                </div>
                            </div>
                        </div>

                        <div class="employee-form-grid">
                            @if (!Id.HasValue || 1 == 1)
                            {
                                <div class="employee-field">
                                    <label for="employee-nationality" class="form-label">@SharedDataService.SelectViewLang("Nationality", "الجنسية")</label>
                                    <InputSelect class="form-select" id="employee-nationality" @bind-Value="employee.Nationality">
                                        @foreach (var nationality in Enum.GetValues<Nationality>())
                                        {
                                            <option value="@nationality">
                                                @NationalityTranslator.GetDisplay(nationality, SharedDataService.Language)
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => employee.Nationality" />
                                </div>
                            }

                            <div class="employee-field">
                                <label for="employee-national-id" class="form-label">@SharedDataService.SelectViewLang("NationalId", "رقم الهوية")</label>
                                <InputText class="form-control" id="employee-national-id" @bind-Value="employee.NationalId" />
                                <ValidationMessage For="() => employee.NationalId" />
                            </div>

                            <div class="employee-field">
                                <label for="employee-identity-type" class="form-label">@SharedDataService.SelectViewLang("Identity Type", "نوع الهوية")</label>
                                <InputSelect class="form-select" id="employee-identity-type" @bind-Value="employee.IdentityType">
                                    @foreach (var type in Enum.GetValues<IdentityType>())
                                    {
                                        <option value="@type">
                                            @GetIdentityTypeDisplay(type)
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => employee.IdentityType" />
                            </div>

                            @if (!Id.HasValue)
                            {
                                <div class="employee-field">
                                    <label for="employee-gender" class="form-label">@SharedDataService.SelectViewLang("Gender", "النوع")</label>
                                    <InputSelect class="form-select" id="employee-gender" @bind-Value="employee.Gender">
                                        @foreach (var gender in Enum.GetValues<Gender>())
                                        {
                                            <option value="@gender">
                                                @GetGenderDisplay(gender)
                                            </option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => employee.Gender" />
                                </div>
                            }

                            <div class="employee-field">
                                <label for="employee-marital-status" class="form-label">@SharedDataService.SelectViewLang("Marital status", "الحالة الاجتماعية")</label>
                                <InputSelect class="form-select" id="employee-marital-status" @bind-Value="employee.MaritalStatus">
                                    @foreach (var maritalStatus in Enum.GetValues<MaritalStatus>())
                                    {
                                        <option value="@maritalStatus">
                                            @GetMaritalStatusDisplay(maritalStatus)
                                        </option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => employee.MaritalStatus" />
                            </div>
                        </div>
                    </div>
                </div>
            </AppCard>

            <AppCard Title="@(SharedDataService.SelectViewLang("Contact Details", "بيانات التواصل"))"
                     Subtitle="@(SharedDataService.SelectViewLang("Keep employee communication details current.", "حافظ على تحديث بيانات التواصل الخاصة بالموظف."))">
                <div class="employee-form-grid">
                    <div class="employee-field">
                        <label for="employee-email" class="form-label">@SharedDataService.SelectViewLang("Email", "الايميل")</label>
                        <InputText class="form-control" id="employee-email" @bind-Value="employee.Email" />
                        <ValidationMessage For="() => employee.Email" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-phone" class="form-label">@SharedDataService.SelectViewLang("Phone", "الهاتف")</label>
                        <InputText class="form-control" id="employee-phone" @bind-Value="employee.Phone" />
                        <ValidationMessage For="() => employee.Phone" />
                    </div>

                    <div class="employee-field employee-field-wide">
                        <label for="employee-address" class="form-label">@SharedDataService.SelectViewLang("Address", "العنوان الحالي")</label>
                        <InputText class="form-control" id="employee-address" @bind-Value="employee.Address" />
                        <ValidationMessage For="() => employee.Address" />
                    </div>
                </div>
            </AppCard>

            <AppCard Title="@(SharedDataService.SelectViewLang("Scientific Qualifications", "المؤهلات العلمية"))"
                     Subtitle="@(SharedDataService.SelectViewLang("Academic background and specialization details.", "الخلفية العلمية وبيانات التخصص."))">
                <div class="employee-form-grid">
                    <div class="employee-field">
                        <label for="employee-qualification" class="form-label">@SharedDataService.SelectViewLang("Qualification", "الدرجة العلمية")</label>
                        <InputSelect class="form-select" id="employee-qualification" @bind-Value="employee.Qualification">
                            @foreach (var qualification in Enum.GetValues<Qualification>())
                            {
                                <option value="@qualification">
                                    @GetQualificationDisplay(qualification)
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => employee.IdentityType" />
                    </div>

                    <div class="employee-field">
                        <label class="form-label">@SharedDataService.SelectViewLang("Specialization", "التخصص")</label>
                        <AutoCompleteComponent TItem="SpecializationDto"
                                               Items="specializations"
                                               Value="selectedSpecialization"
                                               ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                               ValueChanged="OnSpecializationSelected">
                        </AutoCompleteComponent>
                        <ValidationMessage For="() => employee.SpecializationId" />
                    </div>

                    <div class="employee-field">
                        <label class="form-label">@SharedDataService.SelectViewLang("Academic Institution", "جهة الدراسة")</label>
                        <AutoCompleteComponent TItem="AcademicInstitutionDto"
                                               Items="academicInstitutions"
                                               Value="selectedAcademicInistitution"
                                               ItemText="(b=> SharedDataService.SelectViewLang(b.NameEng,b.Name))"
                                               ValueChanged="OnAcademicInistitutionSelected">
                        </AutoCompleteComponent>
                        <ValidationMessage For="() => employee.AcademicInstituteId" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-graduation-year" class="form-label">@SharedDataService.SelectViewLang("Graduation Year", "سنة التخرج")</label>
                        <InputSelect class="form-select" id="employee-graduation-year" @bind-Value="employee.GraduationYear">
                            @foreach (var gy in graduationYears.ToList())
                            {
                                <option value="@gy">
                                    @gy
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => employee.GraduationYear" />
                    </div>
                </div>
            </AppCard>

            <AppCard Title="@(SharedDataService.SelectViewLang("Employment & Attendance", "الوظيفة والحضور"))"
                     Subtitle="@(SharedDataService.SelectViewLang("Employment identifiers, position assignment, and attendance rules.", "الأرقام الوظيفية والمسمى وقواعد الحضور."))">
                <div class="employee-form-grid">
                    <div class="employee-field">
                        <label for="employee-number" class="form-label">@SharedDataService.SelectViewLang("Employee No", "الرقم الوظيفي")</label>
                        <InputText class="form-control" id="employee-number" @bind-Value="employee.EmployeeNo" />
                        <ValidationMessage For="() => employee.EmployeeNo" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-hire-date" class="form-label">@SharedDataService.SelectViewLang("HireDate", "تاريخ التعيين")</label>
                        <InputDate class="form-control" id="employee-hire-date" @bind-Value="employee.HireDate" />
                        <ValidationMessage For="() => employee.HireDate" />
                    </div>

                    <div class="employee-field">
                        <label class="form-label">@SharedDataService.SelectViewLang("Position", "المسمى الوظيفي")</label>
                        <AutoCompleteComponent TItem="PositionDto"
                                               Items="positions"
                                               Value="selectedPosition"
                                               ValueChanged="OnPositionSelected"
                                               ItemText="(b=> SharedDataService.SelectViewLang(b.TitleEng,b.Title))">
                        </AutoCompleteComponent>
                        <ValidationMessage For="() => employee.PositionId" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-employment-type" class="form-label">@SharedDataService.SelectViewLang("Employment Type", "نوع الدوام")</label>
                        <InputSelect class="form-select" id="employee-employment-type" @bind-Value="employee.EmploymentType">
                            @foreach (var employmentType in Enum.GetValues<EmploymentType>())
                            {
                                <option value="@employmentType">
                                    @GetEmploymentTypeDisplay(employmentType)
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => employee.EmploymentType" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-attendance-type" class="form-label">@SharedDataService.SelectViewLang("Attendance Type", "نوع الحضور")</label>
                        <InputSelect class="form-select" id="employee-attendance-type" @bind-Value="employee.AttendanceType">
                            @foreach (var attendanceType in Enum.GetValues<EmployeeAttendanceType>())
                            {
                                <option value="@attendanceType">
                                    @GetAttendanceTypeDisplay(attendanceType)
                                </option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => employee.AttendanceType" />
                    </div>

                    <div class="employee-field">
                        <label for="employee-allowed-radius" class="form-label">@SharedDataService.SelectViewLang("Allowed Radius (meters)", "النطاق المسموح بالمتر")</label>
                        <InputNumber class="form-control"
                                     id="employee-allowed-radius"
                                     min="1"
                                     @bind-Value="employee.AllowedRadiusMeters" />
                        <div class="employee-help-text">
                            @SharedDataService.SelectViewLang(
                                "Used for fixed-location attendance. If left empty, the assigned department radius is used.",
                                "يستخدم لحضور الموقع الثابت. عند تركه فارغا سيتم استخدام نطاق القسم.")
                        </div>
                        <ValidationMessage For="() => employee.AllowedRadiusMeters" />
                    </div>
                </div>
            </AppCard>

            <div class="employee-validation-summary">
                <ValidationSummary />
            </div>

            <div class="employee-form-footer">
                <button type="button" class="btn btn-outline-secondary employee-form-action" @onclick="onCancel">
                    <i class="bi bi-x-lg"></i>
                    @SharedDataService.SelectViewLang("Cancel", "إلغاء")
                </button>
                <button type="submit" class="btn btn-primary employee-form-action">
                    <i class="bi bi-floppy2-fill"></i>
                    @(Id.HasValue ? SharedDataService.SelectViewLang("Update", "تعديل") : SharedDataService.SelectViewLang("Save", "حفظ"))
                </button>
            </div>
        </div>
    </EditForm>
</div>

<style>
    .employee-form-page {
        max-width: 1320px;
    }

    .employee-form-stack {
        display: grid;
        gap: var(--erp-space-4);
    }

    .employee-form-grid {
        display: grid;
        gap: var(--erp-space-4);
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .employee-form-grid-three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .employee-field,
    .employee-profile-fields {
        min-width: 0;
    }

    .employee-field-wide {
        grid-column: 1 / -1;
    }

    .employee-field .form-label {
        align-items: center;
        display: flex;
        gap: var(--erp-space-2);
        margin-bottom: var(--erp-space-2);
    }

    .employee-profile-layout {
        align-items: flex-start;
        display: grid;
        gap: var(--erp-space-5);
        grid-template-columns: minmax(180px, 220px) minmax(0, 1fr);
    }

    .employee-photo-panel {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        display: grid;
        justify-items: center;
        padding: var(--erp-space-5);
        text-align: center;
    }

    .employee-avatar-upload {
        cursor: pointer;
        display: grid;
        gap: var(--erp-space-3);
        justify-items: center;
        margin: 0;
    }

    .employee-avatar {
        aspect-ratio: 1;
        background: var(--erp-surface);
        border: 4px solid var(--erp-surface);
        border-radius: 50%;
        box-shadow: var(--erp-shadow-sm);
        height: 132px;
        object-fit: cover;
        width: 132px;
    }

    .employee-photo-button {
        align-items: center;
        display: inline-flex;
        gap: var(--erp-space-2);
    }

    .employee-file-input {
        height: 1px;
        opacity: 0;
        overflow: hidden;
        position: absolute;
        width: 1px;
    }

    .employee-help-text {
        color: var(--erp-text-muted);
        font-size: var(--erp-font-size-sm);
        margin-top: var(--erp-space-2);
    }

    .employee-name-group {
        border-top: 1px solid var(--erp-border);
        margin-top: var(--erp-space-4);
        padding-top: var(--erp-space-4);
    }

    .employee-group-label {
        color: var(--erp-text);
        font-weight: 800;
        margin-bottom: var(--erp-space-3);
    }

    .employee-form-action {
        align-items: center;
        display: inline-flex;
        gap: var(--erp-space-2);
        min-height: 42px;
    }

    .employee-form-footer {
        align-items: center;
        background: color-mix(in srgb, var(--erp-surface) 96%, transparent);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        bottom: var(--erp-space-3);
        box-shadow: var(--erp-shadow-sm);
        display: flex;
        gap: var(--erp-space-3);
        justify-content: flex-end;
        padding: var(--erp-space-3);
        position: sticky;
        z-index: 4;
    }

    .employee-validation-summary ul {
        margin-bottom: 0;
    }

    .employee-validation-summary:not(:has(ul)) {
        display: none;
    }

    @@media (max-width: 991.98px) {
        .employee-profile-layout {
            grid-template-columns: 1fr;
        }

        .employee-photo-panel {
            justify-items: flex-start;
            text-align: start;
        }
    }

    @@media (max-width: 767.98px) {
        .employee-form-grid,
        .employee-form-grid-three {
            grid-template-columns: 1fr;
        }

        .employee-form-footer {
            align-items: stretch;
            flex-direction: column-reverse;
        }

        .employee-form-footer .btn {
            justify-content: center;
            width: 100%;
        }
    }
</style>
@code {
    [Parameter]
    public Guid? Id { get; set; }

    private List<BranchDto> branches = [];
    private List<AdministrationDto> administrations = [];
    private List<DepartmentDto> departments = [];
    private List<PositionDto> positions = [];
    private List<AcademicInstitutionDto> academicInstitutions = [];
    private List<SpecializationDto> specializations = [];
    private List<int> graduationYears = [];
    private EmployeeDto employee = new();

    private Guid companyId;

    private string title;
    private AuthenticationState AuthState;
    protected override async Task OnInitializedAsync()
    {

        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        ResetEmployee();
        title = SharedDataService.SelectViewLang("New Employee", "موظف جديد");
        var bResponse = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (bResponse.IsSuccess)
        {
            branches = bResponse.Data?.Data?.ToList() ?? [];
        }

        var posResponse = await PositionService.GetAsync(companyId, 0, 1000);
        if (posResponse.IsSuccess)
        {
            positions = posResponse.Data?.Data?.ToList() ?? [];
        }
        var academicResponse = await AcademicInistitutionService.GetByCompanyAsync(companyId, 0, 1000);
        if (academicResponse.IsSuccess)
        {
            academicInstitutions = academicResponse.Data?.Data?.ToList() ?? [];
        }

        var specResponse = await SpecializationService.GetByCompanyAsync(companyId, 0, 1000);
        if (specResponse.IsSuccess)
        {
            specializations = specResponse.Data?.Data?.ToList() ?? [];
        }

        int thisYear = DateTime.Now.Year;

        graduationYears = Enumerable
            .Range(thisYear - 30, 31) // start, count
            .Reverse()
            .ToList();

        if (Id.HasValue)
        {
            title = SharedDataService.SelectViewLang("Edit Employee", "تعديل بيانات موظف");
            var empResponse = await EmployeeService.GetByIdAsync(Id.Value);
            if (empResponse.IsSuccess)
            {
                employee = empResponse.Data;
                selectedPosition = positions.FirstOrDefault(p => p.Id == employee.PositionId);
                selectedAcademicInistitution = academicInstitutions.FirstOrDefault(a => a.Id == employee.AcademicInstituteId);
                selectedSpecialization = specializations.FirstOrDefault(s => s.Id == employee.SpecializationId);
                selectedBranch = branches.FirstOrDefault(b => b.Id == employee.BranchId);
                await OnBranchSelected(selectedBranch);
                selectedAdministration = administrations.FirstOrDefault(a => a.Id == employee.AdministrationId);
                await OnAdministrationSelected(selectedAdministration);
                selectedDepartment = departments.FirstOrDefault(d => d.Id == employee.DepartmentId);
                StateHasChanged();
            }
            else
            {
                //show employee not found msg and return to employee list page
                await ModalService.ShowAsync(
                    new ModalOptions
                    {
                        Title = SharedDataService.SelectViewLang("Edit Employee", "تعديل بيانات موظف"),
                        Message = SharedDataService.SelectViewLang("Employee not found", "لم يتم العثور على بيانات الموظف"),
                        IsError = false,
                        OnOk = async () =>
                        {
                            NavigationManager.NavigateTo("/Employee/Employee/List");
                        }
                    }
                );
            }
        }
        else
        {

        }
    }
    private void ResetEmployee()
    {
        employee = new()
        {
            CompanyId = companyId,
            HireDate = DateTime.UtcNow,
            DateOfBirth = DateTime.UtcNow.AddYears(-20),
            Nationality = NationalityTranslator.GetDisplay(Nationality.SaudiArabian, SharedDataService.Language),
            IdentityType = IdentityType.Iqama,
            Gender = Gender.Male,
            MaritalStatus = MaritalStatus.Single,
            Qualification = Qualification.Bachelor,
            GraduationYear = DateTime.Now.Year - 1,
            EmploymentType = EmploymentType.Full,
            AttendanceType = EmployeeAttendanceType.FixedLocation,
            AllowedRadiusMeters = 100,


        };

        selectedBranch = null;
        selectedAdministration=null;
        selectedDepartment = null;

    }
    private async Task HandleSubmit()
    {
        LoadingService.Show();

        if (!Id.HasValue || Id == Guid.Empty)
        {
            //Create

            var empResponse = await EmployeeService.CreateAsync(employee);
            if (empResponse.IsSuccess)
            {
                //show success toast
                ToastService.Show(
                    new ToastMessage
                    {
                        Message = "Employee Created successfully",
                        Type = "Success"
                    }
                );
                //Reset Fields
                ResetEmployee();
            }
            else
            {
                //Show Error message
                await ModalService.ShowAsync(
                    new ModalOptions
                    {
                        Title = SharedDataService.SelectViewLang("Add Employee", "إضافة موظف"),
                        Message = SharedDataService.SelectViewLang("An error has occured, please try again", "حدث خطأ أثناء ما، الرجاء المحاولة مرة أخرى"),
                        Details = empResponse.Error?.Detail ?? "",
                        IsError = true,
                        OnOk = async () =>
                        {

                        }
                    }
               );

            }
        }
        else
        {
            //Update
            var empResp = await EmployeeService.UpdateAsync(employee);
            if (empResp.IsSuccess)
            {
                ToastService.Show(
                    new ToastMessage
                    {
                        Message = SharedDataService
                                        .SelectViewLang("Employee's data has been modified successfully", "تم تعديل بيانات الموظف بنجاح"),
                        Type = "Success"

                    }
                );

                NavigationManager.NavigateTo("/Employee/Employee/List");
            }
            else
            {
                await ModalService.ShowAsync(
                    new ModalOptions
                    {
                        Title = SharedDataService.SelectViewLang("Add Employee", "إضافة موظف"),
                        Message = SharedDataService.SelectViewLang("An Error has occured, please try again", "حدث خطأ ما، الرجاء المحاولة مرة أخرى"),
                        Details = empResp.Error?.Detail ?? "",
                        IsError = true,
                        OnOk = async () =>
                        {

                        }
                    }
                );
            }
        }
        LoadingService.Hide();
    }
    private BranchDto? selectedBranch;
    private async Task OnBranchSelected(BranchDto? branch)
    {
        if(branch is null)
        {
            selectedAdministration = null;
            administrations = [];

            selectedDepartment=null;
            departments=[];
            if (!branches.Any())
            {
                var brRes=await BranchService.GetByCompanyIdAsync(companyId,0,10000);
                if (brRes.IsSuccess)
                {
                    branches = brRes.Data?.Data?.ToList() ?? [];
                }
            }
            return;
        }
        selectedAdministration = new AdministrationDto();
        selectedBranch = branch;
        var admResponse = await AdministrationService.GetByBranchAsync(branch.Id, 0, 1000);
        if (admResponse.IsSuccess)
        {
            administrations = admResponse.Data?.Data?.ToList() ?? [];

        }
        employee.BranchId = selectedBranch?.Id??null;
        StateHasChanged();
    }

    private AdministrationDto? selectedAdministration;
    private async Task OnAdministrationSelected(AdministrationDto administration)
    {
        if (administration == null)
        {
            departments = [];
            selectedDepartment = new DepartmentDto();
            employee.AdministrationId = null;
            employee.DepartmentId = null;
            StateHasChanged();
            
            return;
        }
        selectedDepartment = new DepartmentDto();
        selectedAdministration = administration;
        var deptResponse = await DepartmentService.GetByAdministrationAsync(administration.Id, 0, 1000);
        if (deptResponse.IsSuccess)
        {

            departments = deptResponse.Data?.Data?.ToList() ?? [];
        }
        employee.AdministrationId = selectedAdministration?.Id??null;
        StateHasChanged();
    }
    private DepartmentDto? selectedDepartment = new();
    private void OnDepartmentSelected(DepartmentDto department)
    {
        selectedDepartment = department;
        employee.DepartmentId = selectedDepartment?.Id??null;
    }
    private AcademicInstitutionDto? selectedAcademicInistitution;
