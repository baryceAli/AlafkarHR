@layout AdminLayout
@page "/Employee/Position/List"

@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions


@inject IPositionService PositionService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService


@if (!AuthState.User.Claims.Any(c => c.Value == PermissionList.PositionPermissions.View))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="employee-lookup-page" dir="@SharedDataService.PageDirection">
    <div class="employee-lookup-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Employee Setup", "اعدادات الموظفين")</div>
            <h3 class="mb-1">@Text("Positions Management", "ادارة المسميات الوظيفية")</h3>
            <div class="text-muted">@Text("Maintain job titles and salary references used by employee profiles.", "ادارة المسميات الوظيفية ومراجع الرواتب المستخدمة في ملفات الموظفين.")</div>
        </div>
        <button class="btn btn-primary"
                @onclick="CreateNew"
                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.PositionPermissions.Create))">
            <i class="bi bi-plus-lg"></i>
            @Text("Create New", "اضافة جديد")
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="employee-lookup-stat border-primary">
                <div class="employee-lookup-stat-icon text-primary"><i class="bi bi-briefcase"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Positions", "المسميات المعروضة")</div>
                    <div class="employee-lookup-stat-value">@positions.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-success">
                <div class="employee-lookup-stat-icon text-success"><i class="bi bi-cash-stack"></i></div>
                <div>
                    <div class="text-muted small">@Text("With Base Salary", "لديها راتب اساسي")</div>
                    <div class="employee-lookup-stat-value">@positions.Count(p => p.BaseSalary > 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-info">
                <div class="employee-lookup-stat-icon text-info"><i class="bi bi-translate"></i></div>
                <div>
                    <div class="text-muted small">@Text("English Titles", "مسميات انجليزية")</div>
                    <div class="employee-lookup-stat-value">@positions.Count(p => !string.IsNullOrWhiteSpace(p.TitleEng))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="employee-lookup-toolbar mb-3">
                <div class="employee-lookup-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search positions...", "بحث في المسميات الوظيفية...")"
                           @bind="searchText" />
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select employee-lookup-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

    <div class="table-responsive">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table employee-lookup-table align-middle mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(PositionDto.Title))" class="sortable">
                    @SharedDataService.SelectViewLang("Title", "المسمى الوظيفي")
                    <i class="@SortIcon(nameof(PositionDto.Title))"></i>
                </th>
                <th @onclick="() => Sort(nameof(PositionDto.TitleEng))" class="sortable">
                    @SharedDataService.SelectViewLang("Title Eng", "المسمى الوظيفي بالانجليزية")
                    <i class="@SortIcon(nameof(PositionDto.TitleEng))"></i>
                </th>
                <th @onclick="() => Sort(nameof(PositionDto.BaseSalary))" class="sortable">
                    @SharedDataService.SelectViewLang("Base Salary", "الراتب الاساسي")
                    <i class="@SortIcon(nameof(PositionDto.BaseSalary))"></i>
                </th>
                <th class="text-center">@Text("Actions", "الاجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @if (editingPositionId != null)
            {
                var position = positions.FirstOrDefault(p => p.Id == editingPositionId);
                <tr>
                    <td colspan="4">
                        <EditForm Model="position" OnValidSubmit="() => SavePosition(position)">
                            <DataAnnotationsValidator />
                                <div class="employee-lookup-edit-panel">

                                    

                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Title", "المسمى الوظيفي")</label>
                                    <div class="col-sm-10">
                                        <InputText class="form-control" @bind-Value="position.Title" />
                                        <ValidationMessage For="() => position.Title" />
                                    </div>
                                </div>

                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Title (En)", "المسمى الوظيفي (انجليزي)")</label>
                                    <div class="col-sm-10">
                                        <InputText class="form-control" @bind-Value="position.TitleEng" />
                                        <ValidationMessage For="() => position.TitleEng" />
                                         
                                    </div>
                                </div>


                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("BaseSalary", "الراتب الأساسي")</label>
                                    <div class="col-sm-10">
                                        <InputNumber class="form-control" @bind-Value="position.BaseSalary" />
                                        <ValidationMessage For="() => position.BaseSalary" />
                                    </div>
                                </div>


                                    
                                <div class="mb-3 row">
                                    <label for="inputFirstName" class="col-sm-2 col-form-label"></label>
                                    <div class="col-sm-10">
                                    
                                        <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                            
                                    </div>
                                </div>


                            </div>
                        </EditForm>
                    </td>
                </tr>
            }
            @foreach (var position in ProcessedBranches.Where(p => p.Id != editingPositionId))
            {

                
                <tr>
                    <td class="fw-semibold">@EmptyValue(position.Title)</td>
                    <td>@EmptyValue(position.TitleEng)</td>
                    <td><span class="badge rounded-pill text-bg-light">@position.BaseSalary.ToString("N2")</span></td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end gap-2">
                        <button class="btn btn-outline-warning btn-sm employee-lookup-action"
                                @onclick="() => EditPosition(position.Id)"
                                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.PositionPermissions.Edit))"
                                title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                            <i class="bi bi-pencil-square"></i>
                        </button>
                        <button class="btn btn-outline-danger btn-sm employee-lookup-action"
                                @onclick="() => DeletePosition(position)"
                                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.PositionPermissions.Delete))"
                                title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                            <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>

                
            }
        </tbody>
    </table>
    </div>
    <div class="employee-lookup-pagination">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            <i class="bi bi-chevron-left"></i> @Text("Previous", "السابق")
        </button>

        <span class="mx-3">@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @Text("Next", "التالي") <i class="bi bi-chevron-right"></i>
        </button>

    </div>
        </div>
    </div>
</div>

<style>
    .employee-lookup-page {
        max-width: 1320px;
    }

    .employee-lookup-header {
        align-items: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
    }

    .employee-lookup-stat {
        align-items: center;
        background: var(--erp-surface);
        border-inline-start: 4px solid;
        border-radius: var(--erp-radius-lg);
        box-shadow: var(--erp-shadow-sm);
        display: flex;
        gap: 0.875rem;
        min-height: 86px;
        padding: 1rem;
    }

    .employee-lookup-stat-icon {
        align-items: center;
        background: var(--erp-surface-muted);
        border-radius: var(--erp-radius-lg);
        display: inline-flex;
        font-size: 1.4rem;
        height: 44px;
        justify-content: center;
        width: 44px;
    }

    .employee-lookup-stat-value {
        color: var(--erp-text);
        font-size: 1.55rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .employee-lookup-toolbar {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: space-between;
    }

    .employee-lookup-search {
        flex: 1 1 320px;
        position: relative;
    }

    .employee-lookup-search i {
        color: var(--erp-text-muted);
        inset-inline-start: 0.85rem;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .employee-lookup-search .form-control {
        padding-inline-start: 2.5rem;
    }

    .employee-lookup-page-size {
        min-width: 86px;
    }

    .employee-lookup-table thead th {
        background: var(--erp-surface-muted);
        color: var(--erp-text-muted);
        font-size: 0.82rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .employee-lookup-table .sortable {
        cursor: pointer;
        user-select: none;
    }

    .employee-lookup-table tbody tr:hover {
        background: var(--erp-surface-muted);
    }

    .employee-lookup-edit-panel {
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        padding: 1rem;
    }

    .employee-lookup-action {
        align-items: center;
        display: inline-flex;
        height: 32px;
        justify-content: center;
        padding: 0;
        width: 36px;
    }

    .employee-lookup-pagination {
        align-items: center;
        border-top: 1px solid var(--erp-border);
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        justify-content: flex-end;
        margin-top: 1rem;
        padding-top: 1rem;
    }

    [dir="rtl"] .employee-lookup-stat {
        border-inline-start: 0;
        border-inline-end: 4px solid;
    }

    [dir="rtl"] .employee-lookup-search i {
        inset-inline-start: auto;
        inset-inline-end: 0.85rem;
    }

    [dir="rtl"] .employee-lookup-search .form-control {
        padding-inline-start: 0.75rem;
        padding-inline-end: 2.5rem;
    }
</style>

@code {
    private List<PositionDto> positions = new();
    private Guid? editingPositionId;
    private Guid companyId;
    private AuthenticationState AuthState;

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadPositions();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }

    void CreateNew()
    {
        var newItem = new PositionDto
        {
            Id = Guid.Empty // IMPORTANT FIX
        };

        positions.Insert(0, newItem);
        editingPositionId = newItem.Id;
    }


    void EditPosition(Guid id) => editingPositionId = id;

    async Task SavePosition(PositionDto p)
    {
        if (p.Id == Guid.Empty)
        {
            Random rnd = new Random();
            p.Code = p.Title.Substring(0, 1) + rnd.Next(100, 999);
            p.CompanyId = companyId;

            var bResponse = await PositionService.CreateAsync(p);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Position has been created successfully", "تم انشاء الموقع الوظيفي بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {

            var bresponse = await PositionService.UpdateAsync(p);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Position has been Edited successfully", "تم تعديل الموقع الوظيفي بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadPositions();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingPositionId = null;
    }

    async Task DeletePosition(PositionDto position)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Position: {position.Title}?",
                                                        $"هل ترغب فعلا في حذف المسمى الوظيفي: {position.Title}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await PositionService.DeleteAsync(position.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadPositions();
                    await InvokeAsync(StateHasChanged);
                    // var response = await BranchService.GetByCompanyIdAsync(companyId);
                    // if (response.IsSuccess)
                    // {
                    //     branches = response.Data?.ToList() ?? [];
                    //     await InvokeAsync(StateHasChanged);
                    // }
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the position", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }


    async Task CancelEdit()
    {
        var item = positions.FirstOrDefault(x => x.Id == editingPositionId);

        if (item != null && item.Id != Guid.Empty)
        {
            // optional: reload from DB if needed

        }

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var posRes = await PositionService.GetAsync(companyId, 0, 1000);
            if (posRes.IsSuccess)
            {
                positions = posRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            positions.Remove(item);
        }

        editingPositionId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(PositionDto.Title);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadPositions()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await PositionService.GetAsync(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            positions = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadPositions();
    }
    private IEnumerable<PositionDto> ProcessedBranches =>
    positions
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Title?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.Code?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        )


        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadPositions();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadPositions();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
