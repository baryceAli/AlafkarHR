@layout AdminLayout
@page "/Employee/Specialization/List"


@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Features.Organization.Pages.Administrations
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions


@inject ISpecializationService SpecializationService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.SpecializationPermissions.View}")){
    <div class="alert alert-warning">
    <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page","ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
</div>
    return;
}

<div class="employee-lookup-page" dir="@SharedDataService.PageDirection">
    <div class="employee-lookup-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Employee Setup", "اعدادات الموظفين")</div>
            <h3 class="mb-1">@Text("Specialization Management", "ادارة التخصصات العلمية")</h3>
            <div class="text-muted">@Text("Organize academic and professional specializations used in employee records.", "تنظيم التخصصات العلمية والمهنية المستخدمة في سجلات الموظفين.")</div>
        </div>
        <button class="btn btn-primary"
                @onclick="CreateNew"
                disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.SpecializationPermissions.Create))">
            <i class="bi bi-plus-lg"></i>
            @Text("Create New", "اضافة جديد")
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="employee-lookup-stat border-primary">
                <div class="employee-lookup-stat-icon text-primary"><i class="bi bi-journal-bookmark"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Specializations", "التخصصات المعروضة")</div>
                    <div class="employee-lookup-stat-value">@specializations.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-success">
                <div class="employee-lookup-stat-icon text-success"><i class="bi bi-type"></i></div>
                <div>
                    <div class="text-muted small">@Text("Arabic Names", "اسماء عربية")</div>
                    <div class="employee-lookup-stat-value">@specializations.Count(s => !string.IsNullOrWhiteSpace(s.Name))</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="employee-lookup-stat border-info">
                <div class="employee-lookup-stat-icon text-info"><i class="bi bi-translate"></i></div>
                <div>
                    <div class="text-muted small">@Text("English Names", "اسماء انجليزية")</div>
                    <div class="employee-lookup-stat-value">@specializations.Count(s => !string.IsNullOrWhiteSpace(s.NameEng))</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="employee-lookup-toolbar mb-3">
                <div class="employee-lookup-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search specializations...", "بحث في التخصصات...")"
                           @bind="searchText" />
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select employee-lookup-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

    <div class="table-responsive">
    <table class="table employee-lookup-table align-middle mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(SpecializationDto.Name))" class="sortable">
                    @SharedDataService.SelectViewLang("Name", "الاسم")
                    <i class="@SortIcon(nameof(SpecializationDto.Name))"></i>
                </th>
                <th @onclick="() => Sort(nameof(SpecializationDto.NameEng))" class="sortable">
                    @SharedDataService.SelectViewLang("Name (Eng.)", "الاسم بالانجليزية")
                    <i class="@SortIcon(nameof(SpecializationDto.NameEng))"></i>
                </th>
                <th class="text-center">@Text("Actions", "الاجراءات")</th>
            </tr>
        </thead>
        <tbody>
            @if (editingSpecializationId != null)
                {
                    var specialization = specializations.FirstOrDefault(s => s.Id == editingSpecializationId);  

                    <tr>
                        <td colspan="3">
                            <EditForm Model="specialization" OnValidSubmit="() => SaveSpecialization(specialization)">
                                <DataAnnotationsValidator />
                                <div class="employee-lookup-edit-panel">
                                    
                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Specialization", "التخصص")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="specialization.Name" />
                                            <ValidationMessage For="() => specialization.Name" />
                                        </div>
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label">@SharedDataService.SelectViewLang("Specialization (Eng)", "التخصص (انجليزي)")</label>
                                        <div class="col-sm-10">
                                            <InputText class="form-control" @bind-Value="specialization.NameEng" />
                                            <ValidationMessage For="() => specialization.NameEng" />
                                        </div>
                                    </div>

                                    <div class="col">
                                    </div>

                                    <div class="mb-3 row">
                                        <label for="inputFirstName" class="col-sm-2 col-form-label"></label>
                                        <div class="col-sm-10">
                                            <button type="submit" class="btn btn-success btn-sm"><i class="bi bi-check-lg"></i> @SharedDataService.SelectViewLang("Save", "حفظ")</button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelEdit"><i class="bi bi-x-lg"></i> @SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                                        </div>
                                    </div>

                                </div>
                            </EditForm>
                        </td>
                    </tr>
                }
                @foreach (var specialization in ProcessedSpecializations.Where(s=> s.Id!= editingSpecializationId))
            {
                
                
                <tr>

                        <td class="fw-semibold">@EmptyValue(specialization.Name)</td>
                        <td>@EmptyValue(specialization.NameEng)</td>
                        <td class="text-end">
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm employee-lookup-action"
                                    @onclick="() => EditSpecialization(specialization.Id)"
                                    disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.SpecializationPermissions.Edit))"
                                    title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm employee-lookup-action"
                                    @onclick="() => DeleteSpecialization(specialization)"
                                    disabled="@(!AuthState.User.Claims.Any(c => c.Value == PermissionList.SpecializationPermissions.Delete))"
                                    title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                                <i class="bi bi-trash"></i>
                            </button>
                            </div>
                        </td>
                    </tr>
                
            }
        </tbody>
    </table>
    </div>
    <div class="employee-lookup-pagination">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            <i class="bi bi-chevron-left"></i> @Text("Previous", "السابق")
        </button>

        <span class="mx-3">@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @Text("Next", "التالي") <i class="bi bi-chevron-right"></i>
        </button>

    </div>
        </div>
    </div>
</div>

<style>
    .employee-lookup-page { max-width: 1320px; }
    .employee-lookup-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .employee-lookup-stat { align-items: center; background: #fff; border-left: 4px solid; border-radius: 8px; box-shadow: 0 0.125rem 0.35rem rgba(15, 23, 42, 0.08); display: flex; gap: 0.875rem; min-height: 86px; padding: 1rem; }
    .employee-lookup-stat-icon { align-items: center; background: #f8fafc; border-radius: 8px; display: inline-flex; font-size: 1.4rem; height: 44px; justify-content: center; width: 44px; }
    .employee-lookup-stat-value { color: #111827; font-size: 1.55rem; font-weight: 700; line-height: 1.1; }
    .employee-lookup-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: space-between; }
    .employee-lookup-search { flex: 1 1 320px; position: relative; }
    .employee-lookup-search i { color: #64748b; left: 0.85rem; position: absolute; top: 50%; transform: translateY(-50%); }
    .employee-lookup-search .form-control { padding-left: 2.5rem; }
    .employee-lookup-page-size { min-width: 86px; }
    .employee-lookup-table thead th { background: #f8fafc; color: #334155; font-size: 0.82rem; font-weight: 700; letter-spacing: 0; text-transform: uppercase; white-space: nowrap; }
    .employee-lookup-table .sortable { cursor: pointer; user-select: none; }
    .employee-lookup-table tbody tr:hover { background: #f8fafc; }
    .employee-lookup-edit-panel { background: #f8fafc; border: 1px solid #dbeafe; border-radius: 8px; padding: 1rem; }
    .employee-lookup-action { align-items: center; display: inline-flex; height: 32px; justify-content: center; width: 34px; }
    .employee-lookup-pagination { align-items: center; border-top: 1px solid #e2e8f0; display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-end; margin-top: 1rem; padding-top: 1rem; }
    [dir="rtl"] .employee-lookup-stat { border-left: 0; border-right: 4px solid; }
    [dir="rtl"] .employee-lookup-search i { left: auto; right: 0.85rem; }
    [dir="rtl"] .employee-lookup-search .form-control { padding-left: 0.75rem; padding-right: 2.5rem; }
</style>

@code {
    private List<SpecializationDto> specializations = new();
    private Guid? editingSpecializationId;
    private Guid companyId;
    private AuthenticationState AuthState;

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        await LoadSpecialization();

    }

    void CreateNew()
    {
        var newItem = new SpecializationDto
        {
            Id = Guid.Empty // IMPORTANT FIX
        };

        specializations.Insert(0, newItem);
        editingSpecializationId = newItem.Id;
    }


    void EditSpecialization(Guid id) => editingSpecializationId = id;

    async Task SaveSpecialization(SpecializationDto specialization)
    {
        if (specialization.Id == Guid.Empty)
        {
            Random rnd = new Random();
            // academic.Code = academic.Title.Substring(0, 1) + rnd.Next(100, 999);
            specialization.CompanyId = companyId;

            var bResponse = await SpecializationService.CreateAsync(specialization);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Specialization has been created successfully", "تم انشاء التخصص العلمي بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {

            var bresponse = await SpecializationService.UpdateAsync(specialization);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Specialization has been Edited successfully", "تم تعديل التخصص العلمي بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadSpecialization();

        editingSpecializationId = null;
    }

    async Task DeleteSpecialization(SpecializationDto specialization)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Specialization: {specialization.NameEng}?",
                                                        $"هل ترغب فعلا في حذف التخصص العلمي: {specialization.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await SpecializationService.DeleteAsync(specialization.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadSpecialization();
                    await InvokeAsync(StateHasChanged);
                    // var response = await BranchService.GetByCompanyIdAsync(companyId);
                    // if (response.IsSuccess)
                    // {
                    //     branches = response.Data?.ToList() ?? [];
                    //     await InvokeAsync(StateHasChanged);
                    // }
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the position", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }


    async Task CancelEdit()
    {
        var item = specializations.FirstOrDefault(x => x.Id == editingSpecializationId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            var specRes = await SpecializationService.GetByCompanyAsync(companyId, 0, 1000);
            if (specRes.IsSuccess)
            {
                specializations = specRes.Data?.Data?.ToList() ?? [];
            }
        }
        else
        {
            // new record → remove it
            specializations.Remove(item);
        }

        editingSpecializationId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";

    // Sorting
    private string sortColumn = nameof(SpecializationDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private async Task LoadSpecialization()
    {
        // var request = new PaginationRequest(pageIndex, pageSize, searchText);

        var response = await SpecializationService.GetByCompanyAsync(companyId, pageIndex, pageSize);//,searchText);

        if (response.IsSuccess)
        {
            // var result = response.Data!.Data;

            // branches = result.Data.ToList();
            specializations = response.Data?.Data.ToList() ?? [];
            // TotalPages = (int)response.Data!.Count;
            TotalPages = (int)Math.Ceiling(response.Data!.Count / (double)pageSize);
        }
    }
    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadSpecialization();
    }
    private IEnumerable<SpecializationDto> ProcessedSpecializations =>
    specializations
        // 🔍 Search
        .Where(b =>
            string.IsNullOrWhiteSpace(searchText) ||
            (b.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (b.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)
        )


        // 🎯 Filter
        // .Where(b =>
        //     filterMainBranch == null || b.IsMainBranch == filterMainBranch
        // )

        // 🔃 Sorting
        .OrderByDynamic(sortColumn, sortAscending);

        // 📄 Pagination
        // .Skip((pageIndex) * pageSize)
        // .Take(pageSize);



    // Filtering example
    private bool? filterMainBranch = null;
    // private long totalCount = 0;
    private int TotalPages = 1;
    // private int TotalPages =>
    // (int)Math.Ceiling(
    //     totalCount/ (double)pageSize);

    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadSpecialization();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadSpecialization();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }
    #endregion Table helpers
}
