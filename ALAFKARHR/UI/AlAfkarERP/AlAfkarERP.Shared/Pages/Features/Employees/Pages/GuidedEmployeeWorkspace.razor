    {
        if (CurrentStep is null || CurrentStep.IsRequired)
        {
            return;
        }

        await CompleteCurrentStepAsync(Text("Skipped", "\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a"));
    }

