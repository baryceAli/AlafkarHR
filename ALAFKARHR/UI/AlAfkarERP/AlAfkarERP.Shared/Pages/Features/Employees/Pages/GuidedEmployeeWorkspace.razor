            _ => Text("Coming later as a guided conversation.", "\u0633\u064a\u062a\u0645 \u0631\u0628\u0637\u0647\u0627 \u0644\u0627\u062d\u0642\u0627 \u0643\u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0648\u062c\u0647\u0629.")
