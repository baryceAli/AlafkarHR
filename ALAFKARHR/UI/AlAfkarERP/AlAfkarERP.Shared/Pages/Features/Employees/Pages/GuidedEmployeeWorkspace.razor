    private async Task ReviewDraftAsync()
    {
        isReviewing = true;
        AddAssistant(MissingRequiredFields.Any()
            ? Text("Review the draft. Some required fields are still missing.", "\u0631\u0627\u062c\u0639 \u0627\u0644\u0645\u0633\u0648\u062f\u0629. \u0644\u0627 \u062a\u0632\u0627\u0644 \u0628\u0639\u0636 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0646\u0627\u0642\u0635\u0629.")
            : Text("Everything required is captured. You can submit the employee now.", "\u062a\u0645 \u062c\u0645\u0639 \u0643\u0644 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629. \u064a\u0645\u0643\u0646\u0643 \u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0648\u0638\u0641 \u0627\u0644\u0622\u0646."));
        await Task.CompletedTask;
    }

    private async Task ContinueEditingAsync()
    {
        isReviewing = false;
        var missingStep = steps.FindIndex(step => DraftFields.Any(field => field.IsRequired && field.IsMissing && IsStepForField(step, field.Label)));
        currentStepIndex = missingStep >= 0 ? missingStep : Math.Min(currentStepIndex, steps.Count - 1);
        returnToReviewAfterEdit = false;
        PromptCurrentStep();
        await Task.CompletedTask;
    }

    private bool IsStepForField(GuidedStep step, string label)
        => DraftFields.Any(field => field.Label == label && FieldMatchesStep(field, step));

    private static bool FieldMatchesStep(DraftField field, GuidedStep step)
        => field.Key == step.Key;

    private bool CanEditField(DraftField field)
        => steps.Any(step => FieldMatchesStep(field, step));

    private async Task EditDraftFieldAsync(string fieldKey)
    {
        var stepIndex = steps.FindIndex(step => string.Equals(step.Key, fieldKey, StringComparison.OrdinalIgnoreCase));
        if (stepIndex < 0)
        {
            return;
        }

        returnToReviewAfterEdit = isReviewing;
        isReviewing = false;
        currentStepIndex = stepIndex;
        currentInput = CurrentTextValue(fieldKey);
        PromptCurrentStep();
        await Task.CompletedTask;
    }

    private string CurrentTextValue(string fieldKey)
        => fieldKey switch
        {
            "EmployeeNo" => employee.EmployeeNo,
            "Code" => employee.Code,
            "FirstName" => employee.FirstName,
            "FirstNameEng" => employee.FirstNameEng,
            "MiddleName" => employee.MiddleName,
            "MiddleNameEng" => employee.MiddleNameEng,
            "LastName" => employee.LastName,
            "LastNameEng" => employee.LastNameEng,
            "Email" => employee.Email,
            "Phone" => employee.Phone,
            "DateOfBirth" => FormatDate(employee.DateOfBirth),
            "NationalId" => employee.NationalId,
            "HireDate" => FormatDate(employee.HireDate),
            "Nationality" => employee.Nationality,
            "Address" => employee.Address,
            "GraduationYear" => employee.GraduationYear > 0 ? employee.GraduationYear.ToString() : "",
            "AllowedRadiusMeters" => employee.AllowedRadiusMeters?.ToString() ?? "",
            _ => string.Empty
        };

    private async Task BackAsync()
    {
        if (currentStepIndex <= 0)
        {
            return;
        }

        currentStepIndex--;
        isReviewing = false;
        PromptCurrentStep();
        await Task.CompletedTask;
    }

    private async Task CancelFlowAsync()
    {
        mode = GuidedMode.Actions;
        isReviewing = false;
        isSubmitted = false;
        returnToReviewAfterEdit = false;
        ResetEmployee();
        ResetWelcome();
        await Task.CompletedTask;
    }

    private async Task SubmitEmployeeAsync()
    {
        if (MissingRequiredFields.Any())
        {
            AddAssistant(Text("Complete the missing required fields before submitting.", "\u0623\u0643\u0645\u0644 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0627\u0644\u0646\u0627\u0642\u0635\u0629 \u0642\u0628\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644."));
            return;
        }

        isSaving = true;
        employee.CompanyId = companyId;
        employee.PhotoUrl ??= string.Empty;
        var result = await EmployeeService.CreateAsync(employee);
        isSaving = false;

        if (result.IsSuccess)
        {
            isSubmitted = true;
            isReviewing = false;
            var created = result.Data;
            createdEmployeeId = created?.Id == Guid.Empty ? null : created?.Id;
            ToastService.Show(new ToastMessage { Message = Text("Employee created successfully", "\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0648\u0638\u0641 \u0628\u0646\u062c\u0627\u062d"), Type = "Success" });
            AddAssistant(Text("Employee created successfully. What would you like to do next?", "\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0648\u0638\u0641 \u0628\u0646\u062c\u0627\u062d. \u0645\u0627\u0630\u0627 \u062a\u0631\u064a\u062f \u0628\u0639\u062f \u0630\u0644\u0643\u061f"));
        }
        else
        {
            AddAssistant($"{Text("The employee could not be created.", "\u062a\u0639\u0630\u0631 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0648\u0638\u0641.")} {result.Error?.Detail}");
        }
    }

    private void ResetEmployee()
    {
        employee = new EmployeeDto
        {
            CompanyId = companyId,
            HireDate = DateTime.Today,
            DateOfBirth = DateTime.Today.AddYears(-20),
            Nationality = "Saudi Arabian",
            IdentityType = IdentityType.Iqama,
            Gender = Gender.Male,
            MaritalStatus = MaritalStatus.Single,
            Qualification = Qualification.Bachelor,
            GraduationYear = DateTime.Today.Year - 1,
            EmploymentType = EmploymentType.Full,
            AttendanceType = EmployeeAttendanceType.FixedLocation,
            AllowedRadiusMeters = 100,
            PhotoUrl = string.Empty
        };

        selectedBranch = null;
        selectedAdministration = null;
        selectedDepartment = null;
        selectedPosition = null;
        selectedManager = null;
        selectedAcademicInstitution = null;
        selectedSpecialization = null;
        createdEmployeeId = null;
        currentStepIndex = 0;
        currentInput = string.Empty;
        returnToReviewAfterEdit = false;
    }

