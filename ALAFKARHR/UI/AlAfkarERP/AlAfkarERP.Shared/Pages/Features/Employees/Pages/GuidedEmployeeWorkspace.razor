@layout AdminLayout
@page "/GuidedWorkspace/{WorkspaceKey}"
@page "/GuidedWorkspace/{WorkspaceKey}/{FunctionalGroupKey}"
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.GuidedAssistant.Models
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Employees.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IBranchService BranchService
@inject IAdministrationService AdministrationService
@inject IDepartmentService DepartmentService
@inject IEmployeeService EmployeeService
@inject IPositionService PositionService
@inject IAcademicInistitutionService AcademicInistitutionService
@inject ISpecializationService SpecializationService
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject NavigationManager NavigationManager

<main class="erp-page guided-workspace-page" dir="@SharedDataService.PageDirection">
    <section class="guided-chat-surface" aria-label="@Text("Guided workspace", "\u0645\u0633\u0627\u062d\u0629 \u0639\u0645\u0644 \u0645\u0648\u062c\u0647\u0629")">
        <header class="guided-chat-topbar">
            <div>
                <span>@WorkspaceTitle</span>
                <strong>@AreaTitle</strong>
            </div>
            <div class="guided-chat-topbar-actions">
                @if (IsEmployeeArea)
                {
                    <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="GoToEmployeeDirectory">
                        <i class="bi bi-list-ul"></i>
                        @Text("Directory", "\u0627\u0644\u062f\u0644\u064a\u0644")
                    </button>
                }
            </div>
        </header>

        <div class="guided-chat-layout @(IsEmployeeArea ? "has-draft-panel" : "is-full-width")">
            <main class="guided-chat-thread" role="log" aria-live="polite">
                @if (IsWorkspaceLanding)
                {
                    <article class="guided-message is-system">
                        <span class="guided-message-avatar"><i class="bi bi-chat-square-text"></i></span>
                        <div class="guided-message-stack">
                            <div class="guided-message-bubble">
                                @Text("Welcome to HR. Choose a functional area to start a guided conversation.", "\u0645\u0631\u062d\u0628\u0627 \u0628\u0643 \u0641\u064a \u0627\u0644\u0645\u0648\u0627\u0631\u062f \u0627\u0644\u0628\u0634\u0631\u064a\u0629. \u0627\u062e\u062a\u0631 \u0645\u0646\u0637\u0642\u0629 \u0648\u0638\u064a\u0641\u064a\u0629 \u0644\u0628\u062f\u0621 \u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0648\u062c\u0647\u0629.")
                            </div>
                            <small>@Text("Assistant", "\u0627\u0644\u0645\u0633\u0627\u0639\u062f")</small>
                        </div>
                    </article>

                    <section class="guided-area-grid" aria-label="@Text("HR functional areas", "\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u0648\u0627\u0631\u062f")">
                        @foreach (var area in GuidedAreas)
                        {
                            <button type="button"
                                    class="guided-area-card"
                                    disabled="@(!area.IsEnabled)"
                                    @onclick="() => OpenGuidedArea(area)">
                                <i class="bi @area.Icon"></i>
                                <span>
                                    <strong>@area.Title</strong>
                                    <small>@area.Description</small>
                                </span>
                            </button>
                        }
                    </section>
                }
                else if (!IsEmployeeArea)
                {
                    <article class="guided-message is-system">
                        <span class="guided-message-avatar"><i class="bi bi-chat-square-text"></i></span>
                        <div class="guided-message-stack">
                            <div class="guided-message-bubble">
                                @Text("This guided area is not connected yet. Choose Employees to use the first guided HR assistant.", "\u0647\u0630\u0647 \u0627\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u0648\u062c\u0647\u0629 \u063a\u064a\u0631 \u0645\u0631\u0628\u0648\u0637\u0629 \u0628\u0639\u062f. \u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0648\u0644 \u0645\u0633\u0627\u0639\u062f \u0645\u0648\u062c\u0647 \u0644\u0644\u0645\u0648\u0627\u0631\u062f.")
                            </div>
                        </div>
                    </article>
                }
                else
                {
                    @foreach (var message in messages)
                    {
                        <article class="guided-message @(message.IsUser ? "is-user" : "is-system")">
                            @if (!message.IsUser)
                            {
                                <span class="guided-message-avatar"><i class="bi bi-stars"></i></span>
                            }
                            <div class="guided-message-stack">
                                <div class="guided-message-bubble">@message.Text</div>
                                <small>@(message.IsUser ? Text("You", "\u0623\u0646\u062a") : Text("Assistant", "\u0627\u0644\u0645\u0633\u0627\u0639\u062f"))</small>
                            </div>
                        </article>
                    }

                    @if (mode == GuidedMode.Actions)
                    {
                        <section class="guided-action-grid" aria-label="@Text("Employee actions", "\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646")">
                            @foreach (var action in EmployeeActions)
                            {
                                <button type="button"
                                        class="guided-action-card"
                                        disabled="@(!action.IsEnabled)"
                                        @onclick="() => RunActionAsync(action.Key)">
                                    <i class="bi @action.Icon"></i>
                                    <span>
                                        <strong>@action.Title</strong>
                                        <small>@action.Description</small>
                                    </span>
                                </button>
                            }
                        </section>
                    }

                    @if (mode == GuidedMode.AddEmployee && CurrentStep is not null && !isReviewing && !isSubmitted)
                    {
                        <section class="guided-current-step">
                            @if (CurrentStep.Kind == GuidedStepKind.Text || CurrentStep.Kind == GuidedStepKind.Number || CurrentStep.Kind == GuidedStepKind.Date)
                            {
                                <div class="guided-message-bar">
                                    <input class="form-control"
                                           type="@InputType"
                                           value="@currentInput"
                                           @oninput="OnInputChanged"
                                           @onkeydown="OnInputKeyDown"
                                           placeholder="@CurrentStep.Placeholder" />
                                    <button type="button" class="btn btn-primary" @onclick="SubmitCurrentInputAsync" disabled="@isSaving">
                                        <i class="bi bi-send"></i>
                                    </button>
                                </div>
                            }
                            else if (CurrentStep.Kind == GuidedStepKind.Choice)
                            {
                                <div class="guided-choice-grid">
                                    @foreach (var choice in ChoiceOptions)
                                    {
                                        <button type="button"
                                                class="guided-choice-card @(choice.IsDefault ? "is-default" : "")"
                                                @onclick="() => SubmitChoiceAsync(choice)">
                                            <span>@choice.Label</span>
                                            @if (choice.IsDefault)
                                            {
                                                <small>@Text("Default", "\u0627\u0641\u062a\u0631\u0627\u0636\u064a")</small>
                                            }
                                        </button>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="guided-selector-card">
                                    @SelectorForCurrentStep()
                                    @if (!CurrentStep.IsRequired)
                                    {
                                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="SkipCurrentStepAsync">
                                            <i class="bi bi-skip-forward"></i>
                                            @Text("Skip", "\u062a\u062e\u0637\u064a")
                                        </button>
                                    }
                                </div>
                            }
                        </section>
                    }

                    @if (mode == GuidedMode.AddEmployee)
                    {
                        <section class="guided-flow-actions" aria-label="@Text("Flow actions", "\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u062f\u0641\u0642")">
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="BackAsync" disabled="@(currentStepIndex <= 0 || isSaving || isSubmitted)">
                                <i class="bi bi-arrow-left"></i>
                                @Text("Back", "\u0631\u062c\u0648\u0639")
                            </button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelFlowAsync" disabled="@isSaving">
                                <i class="bi bi-x-lg"></i>
                                @Text("Cancel", "\u0625\u0644\u063a\u0627\u0621")
                            </button>
                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="ReviewDraftAsync" disabled="@isSaving">
                                <i class="bi bi-clipboard-check"></i>
                                @Text("Review Draft", "\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0645\u0633\u0648\u062f\u0629")
                            </button>
                        </section>
                    }

                    @if (isReviewing)
                    {
                        <section class="guided-review-panel">
                            <header>
                                <strong>@Text("Review employee draft", "\u0645\u0631\u0627\u062c\u0639\u0629 \u0645\u0633\u0648\u062f\u0629 \u0627\u0644\u0645\u0648\u0638\u0641")</strong>
                                <span>@Text("Missing required fields are marked before submit.", "\u062a\u0645 \u062a\u0645\u064a\u064a\u0632 \u0627\u0644\u062d\u0642\u0648\u0644 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0627\u0644\u0646\u0627\u0642\u0635\u0629 \u0642\u0628\u0644 \u0627\u0644\u0625\u0631\u0633\u0627\u0644.")
                                </span>
                            </header>
                            <div class="guided-review-grid">
                                @foreach (var field in DraftFields)
                                {
                                    <div class="guided-review-row @(field.IsMissing ? "is-missing" : "")">
                                        <span>@field.Label</span>
                                        <strong>@(string.IsNullOrWhiteSpace(field.Value) ? Text("Missing", "\u0646\u0627\u0642\u0635") : field.Value)</strong>
                                        @if (CanEditField(field))
                                        {
                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-sm guided-edit-field"
                                                    @onclick="() => EditDraftFieldAsync(field.Key)"
                                                    disabled="@isSaving">
                                                <i class="bi bi-pencil"></i>
                                                @Text("Edit", "\u062a\u0639\u062f\u064a\u0644")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                            <div class="guided-review-actions">
                                <button type="button" class="btn btn-outline-secondary" @onclick="ContinueEditingAsync" disabled="@isSaving">
                                    <i class="bi bi-pencil"></i>
                                    @Text("Edit", "\u062a\u0639\u062f\u064a\u0644")
                                </button>
                                <button type="button" class="btn btn-primary" @onclick="SubmitEmployeeAsync" disabled="@(isSaving || MissingRequiredFields.Any())">
                                    <i class="bi bi-check2-circle"></i>
                                    @(isSaving ? Text("Submitting...", "\u062c\u0627\u0631\u064a \u0627\u0644\u0625\u0631\u0633\u0627\u0644...") : Text("Submit Employee", "\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0645\u0648\u0638\u0641"))
                                </button>
                            </div>
                        </section>
                    }

                    @if (isSubmitted)
                    {
                        <section class="guided-success-actions" aria-label="@Text("Next actions", "\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629")">
                            @if (createdEmployeeId.HasValue)
                            {
                                <button type="button" class="btn btn-outline-primary" @onclick="ViewCreatedEmployee">
                                    <i class="bi bi-person-lines-fill"></i>
                                    @Text("View Employee", "\u0639\u0631\u0636 \u0627\u0644\u0645\u0648\u0638\u0641")
                                </button>
                            }
                            <button type="button" class="btn btn-primary" @onclick="StartAnotherEmployeeAsync">
                                <i class="bi bi-person-plus"></i>
                                @Text("Add Another", "\u0625\u0636\u0627\u0641\u0629 \u0622\u062e\u0631")
                            </button>
                            <button type="button" class="btn btn-outline-secondary" @onclick="GoToEmployeeDirectory">
                                <i class="bi bi-list-ul"></i>
                                @Text("Directory", "\u0627\u0644\u062f\u0644\u064a\u0644")
                            </button>
                        </section>
                    }
                }
            </main>

            @if (IsEmployeeArea)
            {
                <aside class="guided-draft-panel" aria-label="@Text("Draft summary", "\u0645\u0644\u062e\u0635 \u0627\u0644\u0645\u0633\u0648\u062f\u0629")">
                    <header>
                        <span>@Text("Employee draft", "\u0645\u0633\u0648\u062f\u0629 \u0627\u0644\u0645\u0648\u0638\u0641")</span>
                        <strong>@(string.IsNullOrWhiteSpace(employee.FullNameEng.Trim()) ? Text("New employee", "\u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f") : employee.FullNameEng)</strong>
                    </header>
                    <div class="guided-draft-progress">
                        <span>@Text("Completed", "\u0645\u0643\u062a\u0645\u0644")</span>
                        <strong>@CompletedRequiredCount / @RequiredFieldCount</strong>
                    </div>
                    <div class="guided-draft-list">
                        @foreach (var field in DraftFields.Take(10))
                        {
                            <div class="guided-draft-row @(field.IsMissing ? "is-missing" : "")">
                                <span>@field.Label</span>
                                <strong>@(string.IsNullOrWhiteSpace(field.Value) ? Text("Missing", "\u0646\u0627\u0642\u0635") : field.Value)</strong>
                                @if (CanEditField(field) && mode == GuidedMode.AddEmployee && !isSubmitted)
                                {
                                    <button type="button"
                                            class="btn btn-outline-secondary btn-sm guided-edit-field"
                                            @onclick="() => EditDraftFieldAsync(field.Key)"
                                            disabled="@isSaving">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    @if (MissingRequiredFields.Any())
                    {
                        <div class="guided-draft-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            <span>@Text($"{MissingRequiredFields.Count()} required fields left.", $"{MissingRequiredFields.Count()} \u062d\u0642\u0648\u0644 \u0645\u0637\u0644\u0648\u0628\u0629 \u0645\u062a\u0628\u0642\u064a\u0629.")</span>
                        </div>
                    }
                </aside>
            }
        </div>
    </section>
</main>

@code {
    [Parameter] public string WorkspaceKey { get; set; } = string.Empty;
    [Parameter] public string? FunctionalGroupKey { get; set; }
    [SupplyParameterFromQuery(Name = "action")] public string? ActionKey { get; set; }

    private AuthenticationState? authState;
    private Guid companyId;
    private EmployeeDto employee = new();
    private List<BranchDto> branches = [];
    private List<AdministrationDto> administrations = [];
    private List<DepartmentDto> departments = [];
    private List<PositionDto> positions = [];
    private List<EmployeeDto> managerEmployees = [];
    private List<AcademicInstitutionDto> academicInstitutions = [];
    private List<SpecializationDto> specializations = [];
    private BranchDto? selectedBranch;
    private AdministrationDto? selectedAdministration;
    private DepartmentDto? selectedDepartment;
    private PositionDto? selectedPosition;
    private EmployeeDto? selectedManager;
    private AcademicInstitutionDto? selectedAcademicInstitution;
    private SpecializationDto? selectedSpecialization;
    private readonly List<ChatMessage> messages = [];
    private List<GuidedStep> steps = [];
    private int currentStepIndex;
    private string currentInput = string.Empty;
    private bool isLoaded;
    private bool isSaving;
    private bool isReviewing;
    private bool isSubmitted;
    private bool returnToReviewAfterEdit;
    private Guid? createdEmployeeId;
    private GuidedMode mode = GuidedMode.Actions;
    private string? handledActionKey;

    private bool IsEmployeeArea
        => string.Equals(WorkspaceKey, NavigationMenuResolver.WorkspaceHr, StringComparison.OrdinalIgnoreCase)
           && string.Equals(FunctionalGroupKey, NavigationMenuResolver.HrFunctionalGroupEmployees, StringComparison.OrdinalIgnoreCase);

    private bool IsWorkspaceLanding
        => string.Equals(WorkspaceKey, NavigationMenuResolver.WorkspaceHr, StringComparison.OrdinalIgnoreCase)
           && string.IsNullOrWhiteSpace(FunctionalGroupKey);

    private string WorkspaceTitle => Text("HR", "\u0627\u0644\u0645\u0648\u0627\u0631\u062f");
    private string AreaTitle => IsEmployeeArea
        ? Text("Employees", "\u0627\u0644\u0645\u0648\u0638\u0641\u0648\u0646")
        : IsWorkspaceLanding
            ? Text("HR guided workspace", "\u0645\u0633\u0627\u062d\u0629 \u0645\u0648\u0627\u0631\u062f \u0645\u0648\u062c\u0647\u0629")
            : Text("Guided workspace", "\u0645\u0633\u0627\u062d\u0629 \u0645\u0648\u062c\u0647\u0629");
    private GuidedStep? CurrentStep => mode == GuidedMode.AddEmployee && currentStepIndex >= 0 && currentStepIndex < steps.Count ? steps[currentStepIndex] : null;
    private string InputType => CurrentStep?.Kind == GuidedStepKind.Date ? "date" : CurrentStep?.Kind == GuidedStepKind.Number ? "number" : "text";
    private bool CanCreateEmployee => HasPermission(PermissionList.EmployeePermissions.Create) && HasPermission(PermissionList.EmployeePermissions.Edit);
    private bool CanViewEmployee => HasPermission(PermissionList.EmployeePermissions.View) || HasPermission(PermissionList.EmployeePermissions.Select);
    private int RequiredFieldCount => DraftFields.Count(item => item.IsRequired);
    private int CompletedRequiredCount => DraftFields.Count(item => item.IsRequired && !item.IsMissing);
    private IEnumerable<DraftField> MissingRequiredFields => DraftFields.Where(item => item.IsRequired && item.IsMissing);
    private List<DepartmentDto> DepartmentSelectorItems => selectedAdministration is null ? [] : departments;

    private IReadOnlyList<GuidedArea> GuidedAreas
        => NavigationMenuResolver.GetAuthorizedWorkspaceFunctionalGroups(authState?.User, NavigationMenuResolver.WorkspaceHr, null)
            .Select(group => new GuidedArea(
                group.Key,
                group.WorkspaceKey,
                Text(group.TextEn, group.TextAr),
                AreaDescription(group.Key),
                group.Icon,
                string.Equals(group.Key, NavigationMenuResolver.HrFunctionalGroupEmployees, StringComparison.OrdinalIgnoreCase)))
            .ToList();

    private IReadOnlyList<GuidedAction> EmployeeActions =>
    [
        new("add-employee", Text("Add New Employee", "\u0625\u0636\u0627\u0641\u0629 \u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f"), Text("Onboard a new team member step by step.", "\u0625\u062f\u062e\u0627\u0644 \u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629."), "bi-person-plus", CanCreateEmployee),
        new("change-department", Text("Change Department", "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0642\u0633\u0645"), Text("Reassign an employee to another department.", "\u0646\u0642\u0644 \u0645\u0648\u0638\u0641 \u0625\u0644\u0649 \u0642\u0633\u0645 \u0622\u062e\u0631."), "bi-arrow-left-right", false),
        new("change-position", Text("Change Position", "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0633\u0645\u0649"), Text("Move an employee to a new position.", "\u0646\u0642\u0644 \u0645\u0648\u0638\u0641 \u0625\u0644\u0649 \u0645\u0633\u0645\u0649 \u062c\u062f\u064a\u062f."), "bi-briefcase", false),
        new("terminate", Text("Terminate Employee", "\u0625\u0646\u0647\u0627\u0621 \u062e\u062f\u0645\u0629"), Text("Prepare an employee termination request.", "\u062a\u062c\u0647\u064a\u0632 \u0637\u0644\u0628 \u0625\u0646\u0647\u0627\u0621 \u062e\u062f\u0645\u0629."), "bi-person-dash", false),
        new("directory", Text("Employee Directory", "\u062f\u0644\u064a\u0644 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646"), Text("Open the existing employee list.", "\u0641\u062a\u062d \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646 \u0627\u0644\u062d\u0627\u0644\u064a\u0629."), "bi-list-ul", CanViewEmployee)
    ];

    private IReadOnlyList<DraftField> DraftFields =>
    [
        Field("CompanyId", Text("Company", "\u0627\u0644\u0634\u0631\u0643\u0629"), companyId == Guid.Empty ? "" : companyId.ToString(), true),
        Field("BranchId", Text("Branch", "\u0627\u0644\u0641\u0631\u0639"), selectedBranch is null ? "" : BranchLabel(selectedBranch), true),
        Field("EmployeeNo", Text("Employee No", "\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u0638\u0641"), employee.EmployeeNo, true),
        Field("Code", Text("Code", "\u0627\u0644\u0643\u0648\u062f"), employee.Code, true),
        Field("FirstName", Text("First Name", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644"), employee.FirstName, true),
        Field("FirstNameEng", Text("First Name Eng", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0644 \u0625\u0646\u062c\u0644\u064a\u0632\u064a"), employee.FirstNameEng, true),
        Field("MiddleName", Text("Middle Name", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0633\u0637"), employee.MiddleName, true),
        Field("MiddleNameEng", Text("Middle Name Eng", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u0648\u0633\u0637 \u0625\u0646\u062c\u0644\u064a\u0632\u064a"), employee.MiddleNameEng, true),
        Field("LastName", Text("Last Name", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u062e\u064a\u0631"), employee.LastName, true),
        Field("LastNameEng", Text("Last Name Eng", "\u0627\u0644\u0627\u0633\u0645 \u0627\u0644\u0623\u062e\u064a\u0631 \u0625\u0646\u062c\u0644\u064a\u0632\u064a"), employee.LastNameEng, true),
        Field("Email", Text("Email", "\u0627\u0644\u0628\u0631\u064a\u062f"), employee.Email, true),
        Field("Phone", Text("Phone", "\u0627\u0644\u0647\u0627\u062a\u0641"), employee.Phone, true),
        Field("DateOfBirth", Text("Birth date", "\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u064a\u0644\u0627\u062f"), FormatDate(employee.DateOfBirth), true),
        Field("NationalId", Text("National ID", "\u0631\u0642\u0645 \u0627\u0644\u0647\u0648\u064a\u0629"), employee.NationalId, true),
