    private async Task LoadLookupsAsync()
    {
        var branchAccessResponse = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        var branchAccess = branchAccessResponse.IsSuccess ? branchAccessResponse.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();

        var branchResponse = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = branchResponse.IsSuccess ? branchResponse.Data?.Data?.ToList() ?? [] : [];
        if (!branchAccess.CanViewAllBranches)
        {
            branches = branches.Where(branch => branchAccess.BranchIds.Contains(branch.Id)).ToList();
        }

        if (!branchAccess.CanViewAllBranches && branches.Count == 1)
        {
            await OnBranchSelected(branches[0], false);
        }

        var positionResponse = await PositionService.GetAsync(companyId, 0, 1000);
        positions = positionResponse.IsSuccess ? positionResponse.Data?.Data?.ToList() ?? [] : [];

        var managerResponse = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 1000);
        managerEmployees = managerResponse.IsSuccess ? managerResponse.Data?.Data?.ToList() ?? [] : [];

        var academicResponse = await AcademicInistitutionService.GetByCompanyAsync(companyId, 0, 1000);
        academicInstitutions = academicResponse.IsSuccess ? academicResponse.Data?.Data?.ToList() ?? [] : [];

        var specializationResponse = await SpecializationService.GetByCompanyAsync(companyId, 0, 1000);
        specializations = specializationResponse.IsSuccess ? specializationResponse.Data?.Data?.ToList() ?? [] : [];
    }

