    private void OpenGuidedArea(GuidedArea area)
    {
        if (!area.IsEnabled)
        {
            return;
        }

        NavigationManager.NavigateTo($"/GuidedWorkspace/{area.WorkspaceKey}/{area.Key}");
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }

        ResetEmployee();
        BuildSteps();
        await LoadLookupsAsync();
        isLoaded = true;
        ResetAreaState();
        ResetWelcome();
        if (IsEmployeeArea && !string.IsNullOrWhiteSpace(ActionKey))
        {
            handledActionKey = ActionKey;
            await RunActionAsync(ActionKey);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!isLoaded)
        {
            return;
        }

        ResetAreaState();
        ResetWelcome();
        if (IsEmployeeArea && !string.IsNullOrWhiteSpace(ActionKey) && !string.Equals(handledActionKey, ActionKey, StringComparison.OrdinalIgnoreCase))
        {
            handledActionKey = ActionKey;
            await RunActionAsync(ActionKey);
        }
    }

    private void ResetWelcome()
    {
        if (!IsEmployeeArea || mode != GuidedMode.Actions)
        {
            return;
        }

        messages.Clear();
        AddAssistant(Text("Welcome to Employees. What would you like to do?", "\u0645\u0631\u062d\u0628\u0627 \u0628\u0643 \u0641\u064a \u0627\u0644\u0645\u0648\u0638\u0641\u064a\u0646. \u0645\u0627\u0630\u0627 \u062a\u0631\u064a\u062f \u0623\u0646 \u062a\u0641\u0639\u0644\u061f"));
    }

    private async Task RunActionAsync(string key)
    {
        if (string.Equals(key, "directory", StringComparison.OrdinalIgnoreCase))
        {
            GoToEmployeeDirectory();
            return;
        }

        if (!string.Equals(key, "add-employee", StringComparison.OrdinalIgnoreCase))
        {
            AddAssistant(Text("This guided action is not connected yet. Add New Employee is available in this first slice.", "\u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u0627\u0644\u0645\u0648\u062c\u0647 \u063a\u064a\u0631 \u0645\u0631\u0628\u0648\u0637 \u0628\u0639\u062f. \u0625\u0636\u0627\u0641\u0629 \u0645\u0648\u0638\u0641 \u062c\u062f\u064a\u062f \u0645\u062a\u0627\u062d\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u0631\u062d\u0644\u0629."));
            return;
        }

        if (!CanCreateEmployee)
        {
            AddAssistant(Text("You do not have permission to add employees.", "\u0644\u064a\u0633 \u0644\u062f\u064a\u0643 \u0635\u0644\u0627\u062d\u064a\u0629 \u0625\u0636\u0627\u0641\u0629 \u0645\u0648\u0638\u0641\u064a\u0646."));
            return;
        }

        ResetEmployee();
        BuildSteps();
        mode = GuidedMode.AddEmployee;
        isReviewing = false;
        isSubmitted = false;
        returnToReviewAfterEdit = false;
        createdEmployeeId = null;
        currentStepIndex = 0;
        currentInput = string.Empty;
        messages.Clear();
        AddAssistant(Text("Great. Let's add a new employee.", "\u0631\u0627\u0626\u0639. \u0644\u0646\u0636\u0641 \u0645\u0648\u0638\u0641\u0627 \u062c\u062f\u064a\u062f\u0627."));
        PromptCurrentStep();
        await Task.CompletedTask;
    }

