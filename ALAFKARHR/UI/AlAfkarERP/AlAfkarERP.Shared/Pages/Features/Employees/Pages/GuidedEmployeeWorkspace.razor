    private async Task SubmitCurrentInputAsync()
    {
        if (CurrentStep is null)
        {
            return;
        }

        var value = currentInput.Trim();
        if (CurrentStep.IsRequired && string.IsNullOrWhiteSpace(value))
        {
            AddAssistant(Text("This field is required. Please enter a value.", "\u0647\u0630\u0627 \u0627\u0644\u062d\u0642\u0644 \u0645\u0637\u0644\u0648\u0628. \u0627\u0644\u0631\u062c\u0627\u0621 \u0625\u062f\u062e\u0627\u0644 \u0642\u064a\u0645\u0629."));
            return;
        }

        if (!ApplyInput(CurrentStep, value))
        {
            return;
        }

        await CompleteCurrentStepAsync(value);
    }

    private bool ApplyInput(GuidedStep step, string value)
    {
        switch (step.Key)
        {
            case "EmployeeNo": employee.EmployeeNo = value; break;
            case "Code": employee.Code = value; break;
            case "FirstName": employee.FirstName = value; break;
            case "FirstNameEng": employee.FirstNameEng = value; break;
            case "MiddleName": employee.MiddleName = value; break;
            case "MiddleNameEng": employee.MiddleNameEng = value; break;
            case "LastName": employee.LastName = value; break;
            case "LastNameEng": employee.LastNameEng = value; break;
            case "Email": employee.Email = value; break;
            case "Phone": employee.Phone = value; break;
            case "NationalId": employee.NationalId = value; break;
            case "Nationality": employee.Nationality = value; break;
            case "Address": employee.Address = value; break;
            case "GraduationYear":
                if (!int.TryParse(value, out var graduationYear) || graduationYear <= 0)
                {
                    AddAssistant(Text("Enter a valid graduation year.", "\u0623\u062f\u062e\u0644 \u0633\u0646\u0629 \u062a\u062e\u0631\u062c \u0635\u062d\u064a\u062d\u0629."));
                    return false;
                }
                employee.GraduationYear = graduationYear;
                break;
            case "AllowedRadiusMeters":
                if (string.IsNullOrWhiteSpace(value))
                {
                    employee.AllowedRadiusMeters = null;
                    break;
                }

                if (!int.TryParse(value, out var allowedRadiusMeters) || allowedRadiusMeters <= 0)
                {
                    AddAssistant(Text("Enter a valid radius greater than zero.", "\u0623\u062f\u062e\u0644 \u0646\u0637\u0627\u0642\u0627 \u0635\u062d\u064a\u062d\u0627 \u0623\u0643\u0628\u0631 \u0645\u0646 \u0635\u0641\u0631."));
                    return false;
                }
                employee.AllowedRadiusMeters = allowedRadiusMeters;
                break;
            case "DateOfBirth":
                if (!DateTime.TryParse(value, out var dateOfBirth))
                {
                    AddAssistant(Text("Select a valid date of birth.", "\u062d\u062f\u062f \u062a\u0627\u0631\u064a\u062e \u0645\u064a\u0644\u0627\u062f \u0635\u062d\u064a\u062d."));
                    return false;
                }
                employee.DateOfBirth = dateOfBirth;
                break;
            case "HireDate":
                if (!DateTime.TryParse(value, out var hireDate))
                {
                    AddAssistant(Text("Select a valid hire date.", "\u062d\u062f\u062f \u062a\u0627\u0631\u064a\u062e \u062a\u0639\u064a\u064a\u0646 \u0635\u062d\u064a\u062d."));
                    return false;
                }
                employee.HireDate = hireDate;
                break;
        }

        return true;
    }

    private async Task SubmitChoiceAsync(GuidedChoice choice)
    {
        if (CurrentStep is null)
        {
            return;
        }

        if (!ApplyChoice(CurrentStep.Key, choice.Key))
        {
            return;
        }

        await CompleteCurrentStepAsync(choice.Label);
    }

    private bool ApplyChoice(string stepKey, string value)
    {
        switch (stepKey)
        {
            case "IdentityType":
                if (!Enum.TryParse<IdentityType>(value, out var identityType))
                {
                    return false;
                }
                employee.IdentityType = identityType;
                break;
            case "Gender":
                if (!Enum.TryParse<Gender>(value, out var gender))
                {
                    return false;
                }
                employee.Gender = gender;
                break;
            case "MaritalStatus":
                if (!Enum.TryParse<MaritalStatus>(value, out var maritalStatus))
                {
                    return false;
                }
                employee.MaritalStatus = maritalStatus;
                break;
            case "EmploymentType":
                if (!Enum.TryParse<EmploymentType>(value, out var employmentType))
                {
                    return false;
                }
                employee.EmploymentType = employmentType;
                break;
            case "Qualification":
                if (!Enum.TryParse<Qualification>(value, out var qualification))
                {
                    return false;
                }
                employee.Qualification = qualification;
                break;
            case "AttendanceType":
                if (!Enum.TryParse<EmployeeAttendanceType>(value, out var attendanceType))
                {
                    return false;
                }
                employee.AttendanceType = attendanceType;
                break;
        }

        return true;
    }

    private async Task CompleteCurrentStepAsync(string answer)
    {
        AddUser(answer);
        currentInput = string.Empty;
        currentStepIndex++;

        if (currentStepIndex >= steps.Count)
        {
            await ReviewDraftAsync();
            return;
        }

        if (returnToReviewAfterEdit)
        {
            returnToReviewAfterEdit = false;
            await ReviewDraftAsync();
            return;
        }

        PromptCurrentStep();
    }

    private void PromptCurrentStep()
    {
        if (CurrentStep is null)
        {
            return;
        }

        AddAssistant(CurrentStep.Prompt);
    }

    private async Task OnBranchSelected(BranchDto? branch) => await OnBranchSelected(branch, true);

    private async Task OnBranchSelected(BranchDto? branch, bool completeStep)
    {
        selectedBranch = branch;
        employee.BranchId = branch?.Id;
        selectedAdministration = null;
        selectedDepartment = null;
        employee.AdministrationId = null;
        employee.DepartmentId = null;
        administrations = [];
        departments = [];

        if (branch is not null)
        {
            var response = await AdministrationService.GetByBranchAsync(branch.Id, 0, 1000);
            administrations = response.IsSuccess ? response.Data?.Data?.ToList() ?? [] : [];
        }

        if (completeStep && CurrentStep?.Key == "BranchId" && branch is not null)
        {
            await CompleteCurrentStepAsync(BranchLabel(branch));
        }
    }

    private async Task OnAdministrationSelected(AdministrationDto? administration)
    {
        selectedAdministration = administration;
        employee.AdministrationId = administration?.Id;
        selectedDepartment = null;
        employee.DepartmentId = null;
        departments = [];

        if (administration is not null)
        {
            var response = await DepartmentService.GetByAdministrationAsync(administration.Id, 0, 1000);
            departments = response.IsSuccess ? response.Data?.Data?.ToList() ?? [] : [];
            if (CurrentStep?.Key == "AdministrationId")
            {
                await CompleteCurrentStepAsync(NameLabel(administration.NameEng, administration.Name));
            }
        }
        else if (CurrentStep?.Key == "AdministrationId")
        {
            await CompleteCurrentStepAsync(Text("Skipped", "\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a"));
        }
    }

    private async Task OnDepartmentSelected(DepartmentDto? department)
    {
        selectedDepartment = department;
        employee.DepartmentId = department?.Id;
        if (CurrentStep?.Key == "DepartmentId")
        {
            await CompleteCurrentStepAsync(department is null ? Text("Skipped", "\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a") : NameLabel(department.NameEng, department.Name));
        }
    }

    private async Task OnPositionSelected(PositionDto? position)
    {
        selectedPosition = position;
        employee.PositionId = position?.Id;
        if (CurrentStep?.Key == "PositionId" && position is not null)
        {
            await CompleteCurrentStepAsync(PositionLabel(position));
        }
    }

    private async Task OnManagerSelected(EmployeeDto? manager)
    {
        selectedManager = manager;
        employee.ManagerEmployeeId = manager?.Id;
        if (CurrentStep?.Key == "ManagerEmployeeId")
        {
            await CompleteCurrentStepAsync(manager is null ? Text("Skipped", "\u062a\u0645 \u0627\u0644\u062a\u062e\u0637\u064a") : EmployeeLabel(manager));
        }
    }

    private async Task OnAcademicInstitutionSelected(AcademicInstitutionDto? academicInstitution)
    {
        selectedAcademicInstitution = academicInstitution;
        employee.AcademicInstituteId = academicInstitution?.Id;
        if (CurrentStep?.Key == "AcademicInstituteId" && academicInstitution is not null)
