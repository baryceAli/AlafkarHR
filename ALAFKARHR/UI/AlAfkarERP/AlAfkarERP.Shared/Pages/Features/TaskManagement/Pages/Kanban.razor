@layout AdminLayout
@page "/TaskManagement/Kanban"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus
@using AlAfkarERP.Shared.Utilities

@inject ITaskManagementService TaskService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject IJSRuntime JS

<section class="erp-page task-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
        return;
    }
    <PageHeader Title="@Text("Kanban Board", "لوحة كانبان")"
                Subtitle="@Text("Move tasks between workflow states.", "انقل المهام بين حالات سير العمل.")"
                Icon="bi-kanban" />
    <div class="kanban-wrapper" @onkeydown="HandleKeyDown" tabindex="0">
        <div class="kanban-container" #kanbanContainer @ref="containerRef" dir="ltr">
            <div class="kanban-flex-wrapper">
                @foreach (var status in Enum.GetValues<TaskWorkflowStatus>())
                {
                    <div class="erp-card kanban-panel p-2 @KanbanPanelClass(status)" dir="@SharedDataService.PageDirection"
                         @ondragover:preventDefault
                         @ondrop="() => DropOnStatus(status)">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="text-dark">@StatusText(status)</strong>
                            <StatusChip Text="@tasks.Count(x => x.Status == status).ToString()" Tone="@StatusTone(status)" />
                        </div>
                        @foreach (var task in tasks.Where(x => x.Status == status))
                        {
                            <div class="kanban-task-card p-2 mb-2" draggable="@(CanEdit || CanClose)" @ondragstart="() => StartDrag(task)">
                                <div class="fw-semibold">@task.Title</div>
                                <small class="text-muted" dir="ltr">@task.TaskNumber</small>
                                <div class="d-flex justify-content-between mt-2">
                                    <StatusChip Text="@PriorityText(task.Priority)" Tone="muted" />
                                    <button class="btn btn-sm btn-link p-0" @onclick='() => NavigationManager.NavigateTo($"/TaskManagement/View/{task.Id}")'>@Text("Open", "فتح")</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private List<TaskItemDto> tasks = [];
    private TaskItemDto? draggedTask;
    private ElementReference containerRef;
    private bool CanView;
    private bool CanEdit;
    private bool CanClose;

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.View);
        CanEdit = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.Edit);
        CanClose = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.Close);
        if (!CanView)
            return;

        var response = await TaskService.GetAsync(0, 200);
        if (response.IsSuccess)
            tasks = response.Data?.Data.ToList() ?? [];
    }

    private void StartDrag(TaskItemDto task)
    {
        if (CanEdit || CanClose)
            draggedTask = task;
    }

    private async Task DropOnStatus(TaskWorkflowStatus status)
    {
        if (!CanChangeToStatus(status) || draggedTask is null || draggedTask.Status == status)
            return;

        var response = await TaskService.ChangeStatusAsync(draggedTask.Id, status);
        if (response.IsSuccess)
            draggedTask.Status = status;
    }

    private async Task ScrollLeft()
    {
        await containerRef.FocusAsync();
        await ScrollContainer(-300);
    }

    private async Task ScrollRight()
    {
        await containerRef.FocusAsync();
        await ScrollContainer(300);
    }

    private async Task ScrollContainer(int amount)
    {
        await JS.InvokeVoidAsync("scrollKanbanContainer", containerRef, amount);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft")
        {
            await ScrollLeft();
        }
        else if (e.Key == "ArrowRight")
        {
            await ScrollRight();
        }
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private bool CanChangeToStatus(TaskWorkflowStatus status)
    {
        return status is TaskWorkflowStatus.Completed or TaskWorkflowStatus.Cancelled
            ? CanClose
            : CanEdit;
    }

    private string StatusText(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => Text("Draft", "مسودة"),
        TaskWorkflowStatus.Assigned => Text("Assigned", "مسندة"),
        TaskWorkflowStatus.InProgress => Text("In Progress", "قيد التنفيذ"),
        TaskWorkflowStatus.OnHold => Text("On Hold", "معلقة"),
        TaskWorkflowStatus.Completed => Text("Completed", "مكتملة"),
        TaskWorkflowStatus.Cancelled => Text("Cancelled", "ملغاة"),
        TaskWorkflowStatus.Overdue => Text("Overdue", "متأخرة"),
        _ => status.ToString()
    };

    private string PriorityText(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => Text("Low", "منخفضة"),
        TaskPriority.Normal => Text("Normal", "عادية"),
        TaskPriority.High => Text("High", "عالية"),
        TaskPriority.Urgent => Text("Urgent", "عاجلة"),
        TaskPriority.Critical => Text("Critical", "حرجة"),
        _ => priority.ToString()
    };
    private static string KanbanPanelClass(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => "kanban-panel-draft",
        TaskWorkflowStatus.Assigned => "kanban-panel-assigned",
        TaskWorkflowStatus.InProgress => "kanban-panel-inprogress",
        TaskWorkflowStatus.OnHold => "kanban-panel-onhold",
        TaskWorkflowStatus.Completed => "kanban-panel-completed",
        TaskWorkflowStatus.Cancelled => "kanban-panel-cancelled",
        TaskWorkflowStatus.Overdue => "kanban-panel-overdue",
        _ => "kanban-panel-draft"
    };

    private static string StatusTone(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Completed => "success",
        TaskWorkflowStatus.OnHold => "warning",
        TaskWorkflowStatus.InProgress or TaskWorkflowStatus.Overdue => "danger",
        TaskWorkflowStatus.Cancelled => "muted",
        _ => "primary"
    };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
