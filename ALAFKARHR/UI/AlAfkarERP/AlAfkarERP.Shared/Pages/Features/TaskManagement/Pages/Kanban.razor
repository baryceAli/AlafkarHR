@layout AdminLayout
@page "/TaskManagement/Kanban"

@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus

@inject ITaskManagementService TaskService
@inject NavigationManager NavigationManager

<style>
    .kanban-wrapper {
        position: relative;
        margin-bottom: 20px;
    }

    .kanban-container {
        scrollbar-width: auto;
        scrollbar-color: #888 #f1f1f1;
        display: block;
        width: 100%;
        overflow-x: auto; /* allow horizontal scroll when needed */
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        border: 1px solid #ddd;
        border-radius: 4px;
        scroll-behavior: smooth;
    }

    .kanban-container::-webkit-scrollbar {
        height: 12px;
    }

    .kanban-container::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .kanban-container::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
        cursor: grab;
    }

    .kanban-container::-webkit-scrollbar-thumb:hover {
        background: #555;
        cursor: grabbing;
    }

    .kanban-flex-wrapper {
        display: flex;
        flex-wrap: nowrap; /* keep panels in single row */
        gap: 1rem;
        padding: 10px;
        min-width: max-content; /* ensure wrapper expands to fit all panels */
    }

    .kanban-panel {
        flex: 0 0 280px; /* don't shrink, fixed width */
        width: 280px !important;
        min-height: 480px;
    }

    .scroll-button {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        background-color: rgba(0, 0, 0, 0.7);
        color: white;
        border: none;
        border-radius: 4px;
        width: 36px;
        height: 36px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        transition: background-color 0.3s;
    }

    .scroll-button:hover {
        background-color: rgba(0, 0, 0, 0.9);
    }

    .scroll-button-left {
        left: 5px;
    }

    .scroll-button-right {
        right: 5px;
    }

    .scroll-button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .scroll-button:disabled:hover {
        background-color: rgba(0, 0, 0, 0.7);
    }
</style>

<h5 class="text-black mb-3">Kanban Board</h5>

<div class="kanban-wrapper" @onkeydown="HandleKeyDown" tabindex="0">
    <button class="scroll-button scroll-button-left" @onclick="ScrollLeft" title="Scroll Left">
        ‹
    </button>
    <div class="kanban-container" #kanbanContainer @ref="containerRef">
        <div class="kanban-flex-wrapper">
            @foreach (var status in Enum.GetValues<TaskWorkflowStatus>())
            {
                var backgroundColor = GetStatusColor(status);
                <div class="card kanban-panel p-2" style="background-color: @backgroundColor; border: 2px solid @GetStatusBorderColor(status); border-radius: 8px;"
                     @ondragover:preventDefault
                     @ondrop="() => DropOnStatus(status)">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong class="text-dark">@status</strong>
                        <span class="badge bg-dark">@tasks.Count(x => x.Status == status)</span>
                    </div>
                    @foreach (var task in tasks.Where(x => x.Status == status))
                    {
                        <div class="border rounded p-2 mb-2 bg-white" draggable="true" @ondragstart="() => draggedTask = task" style="cursor: grab;">
                            <div class="fw-semibold">@task.Title</div>
                            <small class="text-muted">@task.TaskNumber</small>
                            <div class="d-flex justify-content-between mt-2">
                                <span class="badge bg-light text-dark">@task.Priority</span>
                                <button class="btn btn-sm btn-link p-0" @onclick='() => NavigationManager.NavigateTo($"/TaskManagement/View/{task.Id}")'>Open</button>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    <button class="scroll-button scroll-button-right" @onclick="ScrollRight" title="Scroll Right">
        ›
    </button>
</div>
@code {
    private List<TaskItemDto> tasks = [];
    private TaskItemDto? draggedTask;
    private ElementReference containerRef;

    protected override async Task OnInitializedAsync()
    {
        var response = await TaskService.GetAsync(0, 200);
        if (response.IsSuccess)
            tasks = response.Data?.Data.ToList() ?? [];
    }

    private async Task DropOnStatus(TaskWorkflowStatus status)
    {
        if (draggedTask is null || draggedTask.Status == status)
            return;

        var response = await TaskService.ChangeStatusAsync(draggedTask.Id, status);
        if (response.IsSuccess)
            draggedTask.Status = status;
    }

    private async Task ScrollLeft()
    {
        await containerRef.FocusAsync();
        await ScrollContainer(-300);
    }

    private async Task ScrollRight()
    {
        await containerRef.FocusAsync();
        await ScrollContainer(300);
    }

    private async Task ScrollContainer(int amount)
    {
        await JS.InvokeVoidAsync("scrollKanbanContainer", containerRef, amount);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "ArrowLeft")
        {
            await ScrollLeft();
        }
        else if (e.Key == "ArrowRight")
        {
            await ScrollRight();
        }
    }

    private string GetStatusColor(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => "#f0f4ff",           // Light Blue
        TaskWorkflowStatus.Assigned => "#fff4e6",        // Light Orange
        TaskWorkflowStatus.InProgress => "#fff0f0",      // Light Red
        TaskWorkflowStatus.OnHold => "#fff9e6",          // Light Yellow
        TaskWorkflowStatus.Completed => "#e6ffe6",       // Light Green
        TaskWorkflowStatus.Cancelled => "#f5f5f5",       // Light Gray
        TaskWorkflowStatus.Overdue => "#ffe6e6",         // Light Red/Pink
        _ => "#ffffff"                                    // White (fallback)
    };

    private string GetStatusBorderColor(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => "#0056b3",           // Dark Blue
        TaskWorkflowStatus.Assigned => "#ff8c00",        // Dark Orange
        TaskWorkflowStatus.InProgress => "#dc3545",      // Dark Red
        TaskWorkflowStatus.OnHold => "#ffc107",          // Dark Yellow
        TaskWorkflowStatus.Completed => "#28a745",       // Dark Green
        TaskWorkflowStatus.Cancelled => "#6c757d",       // Dark Gray
        TaskWorkflowStatus.Overdue => "#c82333",         // Dark Red
        _ => "#cccccc"                                    // Gray (fallback)
    };
}

@inject IJSRuntime JS
