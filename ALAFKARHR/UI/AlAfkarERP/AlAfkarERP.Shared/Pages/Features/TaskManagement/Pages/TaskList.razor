@layout AdminLayout
@page "/TaskManagement/List"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus

@inject ITaskManagementService TaskService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!CanView)
{
    <div class="alert alert-warning" dir="@SharedDataService.PageDirection">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
    return;
}

<div class="erp-page task-page" dir="@SharedDataService.PageDirection">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="text-black mb-0">@Text("Task List", "قائمة المهام")</h5>
        <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/TaskManagement/Create")' disabled="@(!CanCreate)">
            <i class="bi bi-plus-square"></i> @Text("Create New", "إضافة جديد")
        </button>
    </div>

    <AppCard Title="@Text("Tasks", "Ø§Ù„Ù…Ù‡Ø§Ù…")" CssClass="mb-3">
        <div class="row g-2 mb-3">
            <div class="col-md-3">
                <input class="form-control" placeholder="@Text("Search...", "بحث...")" @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="col-md-3">
                <input class="form-control" placeholder="@Text("Task number", "رقم المهمة")" @bind="taskNumber" />
            </div>
            <div class="col-md-3">
                <input class="form-control" placeholder="@Text("Title", "العنوان")" @bind="title" />
            </div>
            <div class="col-md-3">
                <input class="form-control" placeholder="@Text("Assigned user", "الموظف المسند")" @bind="assignedToUser" />
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedDepartmentId">
                    <option value="">@Text("All departments", "كل الأقسام")</option>
                    @foreach (var department in departments)
                    {
                        <option value="@department.Id">@Text(department.NameEng, department.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedStatus">
                    <option value="">@Text("All statuses", "كل الحالات")</option>
                    @foreach (var status in Enum.GetValues<TaskWorkflowStatus>())
                    {
                        <option value="@status">@StatusText(status)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="selectedPriority">
                    <option value="">@Text("All priorities", "كل الأولويات")</option>
                    @foreach (var priority in Enum.GetValues<TaskPriority>())
                    {
                        <option value="@priority">@PriorityText(priority)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <InputDate class="form-control" @bind-Value="fromDate" />
            </div>
            <div class="col-md-3">
                <InputDate class="form-control" @bind-Value="toDate" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-primary w-100" @onclick="SearchTasks"><i class="bi bi-search"></i></button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters"><i class="bi bi-x-circle"></i></button>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

        <div class="erp-table-wrap">
        <table class="table erp-table align-middle mb-0">
            <thead>
                <tr>
                    <th>@Text("Number", "الرقم")</th>
                    <th>@Text("Title", "العنوان")</th>
                    <th>@Text("Priority", "الأولوية")</th>
                    <th>@Text("Status", "الحالة")</th>
                    <th>@Text("Due", "تاريخ الاستحقاق")</th>
                    <th>@Text("Progress", "التقدم")</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (!tasks.Any())
                {
                    <tr>
                        <td colspan="7" class="text-muted text-center py-4">@Text("No tasks found.", "لا توجد مهام.")</td>
                    </tr>
                }
                @foreach (var task in tasks)
                {
                    <tr>
                        <td>@task.TaskNumber</td>
                        <td>@task.Title</td>
                        <td><StatusChip Text="@PriorityText(task.Priority)" Tone="@PriorityTone(task.Priority)" /></td>
                        <td><StatusChip Text="@StatusText(task.Status)" Tone="@StatusTone(task.Status)" /></td>
                        <td>@task.DueDate.ToShortDateString()</td>
                        <td class="erp-min-width-progress">
                            <div class="progress">
                                <div class="progress-bar" style="--erp-progress-value:@task.ProgressPercentage%">@task.ProgressPercentage%</div>
                            </div>
                        </td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-secondary erp-row-action" @onclick='() => NavigationManager.NavigateTo($"/TaskManagement/View/{task.Id}")' title="@Text("View", "عرض")"><i class="bi bi-eye"></i></button>
                            <button class="btn btn-sm btn-outline-warning erp-row-action" @onclick='() => NavigationManager.NavigateTo($"/TaskManagement/Edit/{task.Id}")' disabled="@(!CanEdit)" title="@Text("Edit", "تعديل")"><i class="bi bi-pencil-square"></i></button>
                            <button class="btn btn-sm btn-outline-danger erp-row-action" @onclick='() => ArchiveTask(task.Id)' disabled="@(!CanDelete)" title="@Text("Archive", "أرشفة")"><i class="bi bi-archive"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>

        <div class="d-flex justify-content-end align-items-center gap-2">
            <button class="btn btn-sm btn-secondary" @onclick="PrevPage" disabled="@(pageIndex == 0)">@Text("Previous", "السابق")</button>
            <span>@Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @TotalPages</span>
            <button class="btn btn-sm btn-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages - 1)">@Text("Next", "التالي")</button>
        </div>
    </AppCard>
</div>

@code {
    private List<TaskItemDto> tasks = [];
    private List<DepartmentDto> departments = [];
    private string searchText = string.Empty;
    private string taskNumber = string.Empty;
    private string title = string.Empty;
    private string assignedToUser = string.Empty;
    private string selectedDepartmentId = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedPriority = string.Empty;
    private DateTime? fromDate;
    private DateTime? toDate;
    private int pageIndex;
    private int pageSize = 10;
    private int TotalPages = 1;
    private bool CanView;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanDelete;

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.View);
        CanCreate = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.Create);
        CanEdit = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.Edit);
        CanDelete = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.Delete);

        var departmentResponse = await DepartmentService.GetAsync(0, 10000);
        if (departmentResponse.IsSuccess)
            departments = departmentResponse.Data?.Data?.ToList() ?? [];

        await LoadTasks();
    }

    private async Task LoadTasks()
    {
        Enum.TryParse<TaskWorkflowStatus>(selectedStatus, out var status);
        Enum.TryParse<TaskPriority>(selectedPriority, out var priority);
        Guid.TryParse(selectedDepartmentId, out var departmentId);
        Guid? departmentFilter = string.IsNullOrWhiteSpace(selectedDepartmentId) ? null : departmentId;

        var response = await TaskService.GetAsync(pageIndex, pageSize, searchText,
            taskNumber: taskNumber,
            title: title,
            assignedToUser: assignedToUser,
            departmentId: departmentFilter,
            status: string.IsNullOrWhiteSpace(selectedStatus) ? null : status,
            priority: string.IsNullOrWhiteSpace(selectedPriority) ? null : priority,
            fromDate: fromDate,
            toDate: toDate);

        if (response.IsSuccess)
        {
            tasks = response.Data?.Data.ToList() ?? [];
            TotalPages = Math.Max(1, (int)Math.Ceiling((response.Data?.Count ?? 0) / (double)pageSize));
        }
    }

    private async Task SearchTasks()
    {
        pageIndex = 0;
        await LoadTasks();
    }

    private async Task ClearFilters()
    {
        searchText = string.Empty;
        taskNumber = string.Empty;
        title = string.Empty;
        assignedToUser = string.Empty;
        selectedDepartmentId = string.Empty;
        selectedStatus = string.Empty;
        selectedPriority = string.Empty;
        fromDate = null;
        toDate = null;
        pageIndex = 0;
        await LoadTasks();
    }

    private async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadTasks();
        }
    }

    private async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadTasks();
        }
    }

    private async Task ArchiveTask(Guid id)
    {
        var response = await TaskService.ArchiveAsync(id);
        if (response.IsSuccess)
            await LoadTasks();
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private string StatusText(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => Text("Draft", "مسودة"),
        TaskWorkflowStatus.Assigned => Text("Assigned", "مسندة"),
        TaskWorkflowStatus.InProgress => Text("In Progress", "قيد التنفيذ"),
        TaskWorkflowStatus.OnHold => Text("On Hold", "معلقة"),
        TaskWorkflowStatus.Completed => Text("Completed", "مكتملة"),
        TaskWorkflowStatus.Cancelled => Text("Cancelled", "ملغاة"),
        TaskWorkflowStatus.Overdue => Text("Overdue", "متأخرة"),
        _ => status.ToString()
    };

    private string PriorityText(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => Text("Low", "منخفضة"),
        TaskPriority.Normal => Text("Normal", "عادية"),
        TaskPriority.High => Text("High", "عالية"),
        TaskPriority.Urgent => Text("Urgent", "عاجلة"),
        TaskPriority.Critical => Text("Critical", "حرجة"),
        _ => priority.ToString()
    };

    private static string StatusTone(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Completed => "success",
        TaskWorkflowStatus.OnHold => "warning",
        TaskWorkflowStatus.InProgress => "info",
        TaskWorkflowStatus.Overdue => "danger",
        TaskWorkflowStatus.Cancelled => "muted",
        _ => "primary"
    };

    private static string PriorityTone(TaskPriority priority) => priority switch
    {
        TaskPriority.Critical or TaskPriority.Urgent => "danger",
        TaskPriority.High => "warning",
        TaskPriority.Low => "muted",
        _ => "primary"
    };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
