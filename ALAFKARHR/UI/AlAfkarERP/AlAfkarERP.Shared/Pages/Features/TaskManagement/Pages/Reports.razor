@layout AdminLayout
@page "/TaskManagement/Reports"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus

@inject ITaskManagementService TaskService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

@if (!CanViewReports)
{
    <div class="alert alert-warning" dir="@SharedDataService.PageDirection">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
    return;
}

<section class="task-page" dir="@SharedDataService.PageDirection">
    <h5 class="text-black">@Text("Task Reports", "تقارير المهام")</h5>

    <div class="card p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">@Text("Department", "القسم")</label>
                <select class="form-select" @bind="selectedDepartmentId">
                    <option value="">@Text("All departments", "كل الأقسام")</option>
                    @foreach (var department in departments)
                    {
                        <option value="@department.Id">@Text(department.NameEng, department.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("User code", "رمز المستخدم")</label>
                <input class="form-control" @bind="userId" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("Status", "الحالة")</label>
                <select class="form-select" @bind="selectedStatus">
                    <option value="">@Text("All statuses", "كل الحالات")</option>
                    @foreach (var status in Enum.GetValues<TaskWorkflowStatus>())
                    {
                        <option value="@status">@StatusText(status)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("Priority", "الأولوية")</label>
                <select class="form-select" @bind="selectedPriority">
                    <option value="">@Text("All priorities", "كل الأولويات")</option>
                    @foreach (var priority in Enum.GetValues<TaskPriority>())
                    {
                        <option value="@priority">@PriorityText(priority)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("From", "من")</label>
                <InputDate class="form-control" @bind-Value="fromDate" />
            </div>
            <div class="col-md-3">
                <label class="form-label">@Text("To", "إلى")</label>
                <InputDate class="form-control" @bind-Value="toDate" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-primary w-100" @onclick="LoadReports"><i class="bi bi-arrow-repeat"></i> @Text("Refresh", "تحديث")</button>
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="ClearFilters"><i class="bi bi-x-circle"></i></button>
            </div>
        </div>
    </div>

    @if (summary is not null)
    {
        <div class="row g-3 mb-3">
            <KpiCard Title="@Text("Total", "الإجمالي")" Value="@summary.TotalTasks.ToString()" Icon="bi-list-task" />
            <KpiCard Title="@Text("Open", "مفتوحة")" Value="@summary.OpenTasks.ToString()" Icon="bi-hourglass" />
            <KpiCard Title="@Text("Completed", "مكتملة")" Value="@summary.CompletedTasks.ToString()" Icon="bi-check-circle" />
            <KpiCard Title="@Text("Overdue", "متأخرة")" Value="@summary.OverdueTasks.ToString()" Icon="bi-exclamation-circle" />
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card p-3">
                <h6>@Text("Employee Productivity", "إنتاجية الموظفين")</h6>
                @if (!employeeReport.Any())
                {
                    <div class="text-muted">@Text("No employee productivity data.", "لا توجد بيانات لإنتاجية الموظفين.")</div>
                }
                @foreach (var item in employeeReport)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>@item.UserCode</span>
                        <span dir="ltr">@item.CompletedTasks / @item.AssignedTasks (@item.CompletionRate%)</span>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card p-3">
                <h6>@Text("Department Performance", "أداء الأقسام")</h6>
                @if (!departmentReport.Any())
                {
                    <div class="text-muted">@Text("No department performance data.", "لا توجد بيانات لأداء الأقسام.")</div>
                }
                @foreach (var item in departmentReport)
                {
                    <div class="d-flex justify-content-between border-bottom py-2">
                        <span>@DepartmentName(item.DepartmentId)</span>
                        <span dir="ltr">@Text($"{item.CompletionPercentage}% complete, {item.OverdueTasks} overdue", $"مكتملة {item.CompletionPercentage}%، متأخرة {item.OverdueTasks}")</span>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@code {
    private TaskSummaryReportDto? summary;
    private List<EmployeeProductivityReportDto> employeeReport = [];
    private List<DepartmentPerformanceDto> departmentReport = [];
    private List<DepartmentDto> departments = [];
    private string selectedDepartmentId = string.Empty;
    private string userId = string.Empty;
    private string selectedStatus = string.Empty;
    private string selectedPriority = string.Empty;
    private DateTime? fromDate;
    private DateTime? toDate;
    private bool CanViewReports;

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        CanViewReports = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.ViewReports);
        if (!CanViewReports)
            return;

        var departmentsResponse = await DepartmentService.GetAsync(0, 10000);
        if (departmentsResponse.IsSuccess)
            departments = departmentsResponse.Data?.Data?.ToList() ?? [];

        await LoadReports();
    }

    private async Task LoadReports()
    {
        Enum.TryParse<TaskWorkflowStatus>(selectedStatus, out var status);
        Enum.TryParse<TaskPriority>(selectedPriority, out var priority);
        Guid.TryParse(selectedDepartmentId, out var departmentId);

        Guid? departmentFilter = string.IsNullOrWhiteSpace(selectedDepartmentId) ? null : departmentId;
        TaskWorkflowStatus? statusFilter = string.IsNullOrWhiteSpace(selectedStatus) ? null : status;
        TaskPriority? priorityFilter = string.IsNullOrWhiteSpace(selectedPriority) ? null : priority;
        string? userFilter = string.IsNullOrWhiteSpace(userId) ? null : userId;

        var summaryResponse = await TaskService.GetSummaryReportAsync(departmentFilter, userFilter, statusFilter, priorityFilter, fromDate, toDate);
        if (summaryResponse.IsSuccess)
            summary = summaryResponse.Data;

        var employeeResponse = await TaskService.GetEmployeeProductivityReportAsync(departmentFilter, userFilter, fromDate, toDate);
        if (employeeResponse.IsSuccess)
            employeeReport = employeeResponse.Data ?? [];

        var departmentResponse = await TaskService.GetDepartmentPerformanceReportAsync(departmentFilter, fromDate, toDate);
        if (departmentResponse.IsSuccess)
            departmentReport = departmentResponse.Data ?? [];
    }

    private async Task ClearFilters()
    {
        selectedDepartmentId = string.Empty;
        userId = string.Empty;
        selectedStatus = string.Empty;
        selectedPriority = string.Empty;
        fromDate = null;
        toDate = null;
        await LoadReports();
    }

    private string DepartmentName(Guid departmentId)
    {
        var department = departments.FirstOrDefault(d => d.Id == departmentId);
        return department is null ? string.Empty : Text(department.NameEng, department.Name);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private string StatusText(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => Text("Draft", "مسودة"),
        TaskWorkflowStatus.Assigned => Text("Assigned", "مسندة"),
        TaskWorkflowStatus.InProgress => Text("In Progress", "قيد التنفيذ"),
        TaskWorkflowStatus.OnHold => Text("On Hold", "معلقة"),
        TaskWorkflowStatus.Completed => Text("Completed", "مكتملة"),
        TaskWorkflowStatus.Cancelled => Text("Cancelled", "ملغاة"),
        TaskWorkflowStatus.Overdue => Text("Overdue", "متأخرة"),
        _ => status.ToString()
    };

    private string PriorityText(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => Text("Low", "منخفضة"),
        TaskPriority.Normal => Text("Normal", "عادية"),
        TaskPriority.High => Text("High", "عالية"),
        TaskPriority.Urgent => Text("Urgent", "عاجلة"),
        TaskPriority.Critical => Text("Critical", "حرجة"),
        _ => priority.ToString()
    };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
