@layout AdminLayout
@page "/TaskManagement/View/{Id:guid}"

@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus

@inject ITaskManagementService TaskService
@inject ToastService ToastService

@if (task is null)
{
    <p>Loading...</p>
}
else
{
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h5 class="text-black">@task.Title</h5>
            <div class="text-muted">@task.TaskNumber</div>
        </div>
        <div class="d-flex gap-2">
            <select class="form-select form-select-sm" @bind="selectedStatus">
                @foreach (var status in Enum.GetValues<TaskWorkflowStatus>())
                {
                    <option value="@status">@status</option>
                }
            </select>
            <button class="btn btn-sm btn-primary" @onclick="ChangeStatus"><i class="bi bi-arrow-repeat"></i></button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card p-3 mb-3">
                <p>@task.Description</p>
                <div class="row">
                    <div class="col-md-3"><strong>Priority</strong><div>@task.Priority</div></div>
                    <div class="col-md-3"><strong>Status</strong><div>@task.Status</div></div>
                    <div class="col-md-3"><strong>Due</strong><div>@task.DueDate.ToShortDateString()</div></div>
                    <div class="col-md-3"><strong>Progress</strong><div>@task.ProgressPercentage%</div></div>
                </div>
                <div class="mt-3">
                    <label class="form-label">Progress</label>
                    <div class="d-flex gap-2">
                        <InputNumber class="form-control" @bind-Value="progress" />
                        <button class="btn btn-outline-primary" @onclick="UpdateProgress">Update</button>
                    </div>
                </div>
            </div>

            <div class="card p-3">
                <h6>Comments</h6>
                <div class="mb-3">
                    <textarea class="form-control" rows="3" @bind="commentText"></textarea>
                    <button class="btn btn-sm btn-primary mt-2" @onclick="AddComment"><i class="bi bi-chat-left-text"></i> Add Comment</button>
                </div>
                @foreach (var comment in task.Comments.OrderByDescending(x => x.CreatedDate))
                {
                    <div class="border-top py-2">
                        <div>@comment.Comment</div>
                        <small class="text-muted">@comment.CreatedDate.ToLocalTime()</small>
                    </div>
                }
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card p-3">
                <h6>History</h6>
                @foreach (var history in task.History.OrderByDescending(x => x.ActionDate))
                {
                    <div class="border-bottom py-2">
                        <strong>@history.Action</strong>
                        <div class="small text-muted">@history.ActionDate.ToLocalTime()</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private TaskItemDto? task;
    private TaskWorkflowStatus selectedStatus;
    private decimal progress;
    private string commentText = string.Empty;

    protected override async Task OnInitializedAsync() => await LoadTask();

    private async Task LoadTask()
    {
        var response = await TaskService.GetByIdAsync(Id);
        if (response.IsSuccess && response.Data is not null)
        {
            task = response.Data;
            selectedStatus = task.Status;
            progress = task.ProgressPercentage;
        }
    }

    private async Task ChangeStatus()
    {
        var response = await TaskService.ChangeStatusAsync(Id, selectedStatus);
        if (response.IsSuccess)
            await LoadTask();
    }

    private async Task UpdateProgress()
    {
        var response = await TaskService.UpdateProgressAsync(Id, progress);
        if (response.IsSuccess)
            await LoadTask();
    }

    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(commentText))
            return;

        var response = await TaskService.AddCommentAsync(Id, commentText);
        if (response.IsSuccess)
        {
            commentText = string.Empty;
            await LoadTask();
        }
        else
        {
            ToastService.Show(new ToastMessage { Message = response.Error?.Detail ?? "Unable to add comment.", Type = "error" });
        }
    }
}
