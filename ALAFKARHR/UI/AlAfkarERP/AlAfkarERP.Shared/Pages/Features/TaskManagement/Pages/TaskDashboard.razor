@layout AdminLayout
@page "/TaskManagement/Dashboard"

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using SharedWithUI.TaskManagement.Dtos
@using AlAfkarERP.Shared.Utilities

@inject ITaskManagementService TaskService
@inject IDepartmentService DepartmentService
@inject SharedDataService SharedDataService

<section class="task-page" dir="@SharedDataService.PageDirection">
    <h5 class="text-black">@Text("Task Management Dashboard", "لوحة إدارة المهام")</h5>

    @if (dashboard is null)
    {
        <p>@Text("Loading...", "جاري التحميل...")</p>
    }
    else
    {
        <div class="row g-3 mb-3">
            <KpiCard Title="@Text("Total Tasks", "إجمالي المهام")" Value="@dashboard.TotalTasks.ToString()" Icon="bi-list-task" />
            <KpiCard Title="@Text("Open Tasks", "المهام المفتوحة")" Value="@dashboard.OpenTasks.ToString()" Icon="bi-hourglass-split" />
            <KpiCard Title="@Text("Completed", "مكتملة")" Value="@dashboard.CompletedTasks.ToString()" Icon="bi-check2-circle" />
            <KpiCard Title="@Text("Overdue", "متأخرة")" Value="@dashboard.OverdueTasks.ToString()" Icon="bi-exclamation-triangle" />
        </div>

        <div class="row g-3">
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6>@Text("Employee Workload", "عبء عمل الموظفين")</h6>
                    @if (!dashboard.EmployeeWorkload.Any())
                    {
                        <div class="text-muted">@Text("No employee workload data.", "لا توجد بيانات لعبء عمل الموظفين.")</div>
                    }
                    @foreach (var item in dashboard.EmployeeWorkload)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>@item.UserCode</span>
                            <span dir="ltr">@Text($"{item.OpenTasks} open / {item.CompletedTasks} done", $"{item.OpenTasks} مفتوحة / {item.CompletedTasks} مكتملة")</span>
                        </div>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="card p-3">
                    <h6>@Text("Department Performance Ranking", "ترتيب أداء الأقسام")</h6>
                    @if (!dashboard.DepartmentPerformanceRanking.Any())
                    {
                        <div class="text-muted">@Text("No department performance data.", "لا توجد بيانات لأداء الأقسام.")</div>
                    }
                    @foreach (var item in dashboard.DepartmentPerformanceRanking)
                    {
                        <div class="d-flex justify-content-between border-bottom py-2">
                            <span>@DepartmentName(item.DepartmentId)</span>
                            <span dir="ltr">@item.CompletionPercentage%</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</section>

@code {
    private TaskDashboardDto? dashboard;
    private List<DepartmentDto> departments = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await TaskService.GetDashboardAsync("all");
        if (response.IsSuccess)
            dashboard = response.Data;

        var departmentResponse = await DepartmentService.GetAsync(0, 10000);
        if (departmentResponse.IsSuccess)
            departments = departmentResponse.Data?.Data?.ToList() ?? [];
    }

    private string DepartmentName(Guid departmentId)
    {
        var department = departments.FirstOrDefault(d => d.Id == departmentId);
        return department is null ? string.Empty : Text(department.NameEng, department.Name);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
