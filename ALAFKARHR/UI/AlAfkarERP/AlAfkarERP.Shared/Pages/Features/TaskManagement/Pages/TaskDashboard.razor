@layout AdminLayout
@page "/TaskManagement/Dashboard"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.TaskManagement.Enums
@using AlAfkarERP.Shared.Utilities
@using TaskWorkflowStatus = SharedWithUI.TaskManagement.Enums.TaskStatus

@inject ITaskManagementService TaskService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager

<section class="erp-page task-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
        return;
    }

    <PageHeader Title="@Text("Task Management Dashboard", "لوحة إدارة المهام")"
                Subtitle="@Text("Track workload, completion, overdue risk, and drill into the tasks behind each card.", "تابع عبء العمل والإنجاز والمهام المتأخرة وافتح المهام المرتبطة بكل بطاقة.")"
                Overline="@Text("Task Management", "إدارة المهام")"
                Icon="bi-kanban">
        <Actions>
            @if (CanManageAll)
            {
                <button class="btn btn-outline-secondary" @onclick="ProcessWorkflowJobsAsync" disabled="@isProcessingJobs">
                    <i class="bi bi-arrow-repeat"></i> @Text("Run workflow jobs", "تشغيل مهام سير العمل")
                </button>
            }
        </Actions>
    </PageHeader>

    @if (dashboard is null)
    {
        <div class="erp-loading">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2">@Text("Loading dashboard...", "جاري تحميل اللوحة...")</div>
        </div>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(workflowJobResult))
        {
            <div class="alert alert-info">@workflowJobResult</div>
        }

        <div class="row g-3 mb-3">
            <KpiCard Title="@Text("Total Tasks", "إجمالي المهام")" Value="@dashboard.TotalTasks.ToString()" Icon="bi-list-task" Tone="primary" IsActive="@(selectedFilter == TaskDashboardFilter.Total)" OnClick="@(() => SelectFilterAsync(TaskDashboardFilter.Total))" />
            <KpiCard Title="@Text("Open Tasks", "المهام المفتوحة")" Value="@dashboard.OpenTasks.ToString()" Icon="bi-hourglass-split" Tone="warning" IsActive="@(selectedFilter == TaskDashboardFilter.Open)" OnClick="@(() => SelectFilterAsync(TaskDashboardFilter.Open))" />
            <KpiCard Title="@Text("Completed", "مكتملة")" Value="@dashboard.CompletedTasks.ToString()" Icon="bi-check2-circle" Tone="success" IsActive="@(selectedFilter == TaskDashboardFilter.Completed)" OnClick="@(() => SelectFilterAsync(TaskDashboardFilter.Completed))" />
            <KpiCard Title="@Text("Overdue", "متأخرة")" Value="@dashboard.OverdueTasks.ToString()" Icon="bi-exclamation-triangle" Tone="danger" IsActive="@(selectedFilter == TaskDashboardFilter.Overdue)" OnClick="@(() => SelectFilterAsync(TaskDashboardFilter.Overdue))" />
        </div>

        <AppCard Title="@SelectedFilterTitle"
                 Subtitle="@Text("Click a card above to switch the related task list.", "اضغط على أي بطاقة بالأعلى لتغيير قائمة المهام المرتبطة.")"
                 CssClass="mb-3">
            @if (isLoadingTasks)
            {
                <div class="erp-loading py-4">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <div class="mt-2">@Text("Loading related tasks...", "جاري تحميل المهام المرتبطة...")</div>
                </div>
            }
            else if (!relatedTasks.Any())
            {
                <EmptyState Title="@Text("No related tasks", "لا توجد مهام مرتبطة")"
                            Message="@Text("This card has no tasks to show right now.", "لا توجد مهام لعرضها لهذه البطاقة حالياً.")"
                            Icon="bi-inboxes" />
            }
            else
            {
                <div class="erp-table-wrap">
                    <table class="table erp-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Number", "الرقم")</th>
                                <th>@Text("Title", "العنوان")</th>
                                <th>@Text("Status", "الحالة")</th>
                                <th>@Text("Priority", "الأولوية")</th>
                                <th>@Text("Due", "الاستحقاق")</th>
                                <th>@Text("Progress", "التقدم")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in relatedTasks)
                            {
                                <tr>
                                    <td class="text-nowrap fw-semibold">@task.TaskNumber</td>
                                    <td class="task-dashboard-title">@task.Title</td>
                                    <td><StatusChip Text="@StatusText(task.Status)" Tone="@StatusTone(task.Status)" /></td>
                                    <td><StatusChip Text="@PriorityText(task.Priority)" Tone="@PriorityTone(task.Priority)" /></td>
                                    <td class="text-nowrap">@task.DueDate.ToShortDateString()</td>
                                    <td class="task-dashboard-progress">
                                        <div class="progress">
                                            <div class="progress-bar" style="--erp-progress-value:@task.ProgressPercentage%">@task.ProgressPercentage%</div>
                                        </div>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-secondary erp-row-action" @onclick='() => NavigationManager.NavigateTo($"/TaskManagement/View/{task.Id}")' title="@Text("View", "عرض")">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </AppCard>

        <div class="row g-3">
            <div class="col-lg-6">
                <AppCard Title="@Text("Employee Workload", "عبء عمل الموظفين")">
                    @if (!dashboard.EmployeeWorkload.Any())
                    {
                        <div class="text-muted">@Text("No employee workload data.", "لا توجد بيانات لعبء عمل الموظفين.")</div>
                    }
                    @foreach (var item in dashboard.EmployeeWorkload)
                    {
                        <div class="task-dashboard-summary-row">
                            <span>@item.UserCode</span>
                            <span dir="ltr">@Text($"{item.OpenTasks} open / {item.CompletedTasks} done", $"{item.OpenTasks} مفتوحة / {item.CompletedTasks} مكتملة")</span>
                        </div>
                    }
                </AppCard>
            </div>
            <div class="col-lg-6">
                <AppCard Title="@Text("Department Performance Ranking", "ترتيب أداء الأقسام")">
                    @if (!dashboard.DepartmentPerformanceRanking.Any())
                    {
                        <div class="text-muted">@Text("No department performance data.", "لا توجد بيانات لأداء الأقسام.")</div>
                    }
                    @foreach (var item in dashboard.DepartmentPerformanceRanking)
                    {
                        <div class="task-dashboard-summary-row">
                            <span>@DepartmentName(item.DepartmentId)</span>
                            <span dir="ltr">@item.CompletionPercentage%</span>
                        </div>
                    }
                </AppCard>
            </div>
        </div>
    }
</section>

@code {
    private TaskDashboardDto? dashboard;
    private List<DepartmentDto> departments = [];
    private List<TaskItemDto> relatedTasks = [];
    private TaskDashboardFilter selectedFilter = TaskDashboardFilter.Total;
    private bool isLoadingTasks;
    private bool isProcessingJobs;
    private bool CanView;
    private bool CanManageAll;
    private string workflowJobResult = string.Empty;
    private const int RelatedTaskPageSize = 50;

    private string SelectedFilterTitle => selectedFilter switch
    {
        TaskDashboardFilter.Open => Text("Open Tasks", "المهام المفتوحة"),
        TaskDashboardFilter.Completed => Text("Completed Tasks", "المهام المكتملة"),
        TaskDashboardFilter.Overdue => Text("Overdue Tasks", "المهام المتأخرة"),
        _ => Text("All Tasks", "كل المهام")
    };

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.View);
        CanManageAll = authState.User.Claims.Any(c => c.Value == PermissionList.TaskManagementPermissions.ManageAllTasks);
        if (!CanView)
            return;

        await LoadDashboardAsync();

        var departmentResponse = await DepartmentService.GetAsync(0, 10000);
        if (departmentResponse.IsSuccess)
            departments = departmentResponse.Data?.Data?.ToList() ?? [];

        await LoadRelatedTasksAsync();
    }

    private async Task ProcessWorkflowJobsAsync()
    {
        if (!CanManageAll)
            return;

        isProcessingJobs = true;
        var recurringResponse = await TaskService.GenerateRecurringTasksAsync();
        var remindersResponse = await TaskService.ProcessRemindersAsync();
        var overdueResponse = await TaskService.MarkOverdueTasksAsync();

        workflowJobResult = Text(
            $"Workflow jobs completed. Generated: {recurringResponse.Data?.GeneratedCount ?? 0}, reminders: {remindersResponse.Data?.NotificationCount ?? 0}, overdue: {overdueResponse.Data?.UpdatedCount ?? 0}.",
            $"اكتملت مهام سير العمل. تم الإنشاء: {recurringResponse.Data?.GeneratedCount ?? 0}، التذكيرات: {remindersResponse.Data?.NotificationCount ?? 0}، المتأخرة: {overdueResponse.Data?.UpdatedCount ?? 0}.");

        await LoadDashboardAsync();
        await LoadRelatedTasksAsync();
        isProcessingJobs = false;
    }

    private async Task LoadDashboardAsync()
    {
        var scope = CanManageAll ? "all" : "mine";
        var response = await TaskService.GetDashboardAsync(scope);
        if (response.IsSuccess)
            dashboard = response.Data;
    }

    private async Task SelectFilterAsync(TaskDashboardFilter filter)
    {
        if (selectedFilter == filter && relatedTasks.Any())
        {
            return;
        }

        selectedFilter = filter;
        await LoadRelatedTasksAsync();
    }

    private async Task LoadRelatedTasksAsync()
    {
        isLoadingTasks = true;

        try
        {
            relatedTasks = selectedFilter switch
            {
                TaskDashboardFilter.Open => await LoadOpenTasksAsync(),
                TaskDashboardFilter.Completed => await LoadTasksByStatusAsync(TaskWorkflowStatus.Completed),
                TaskDashboardFilter.Overdue => await LoadTasksByStatusAsync(TaskWorkflowStatus.Overdue),
                _ => await LoadTasksByStatusAsync(null)
            };
        }
        finally
        {
            isLoadingTasks = false;
        }
    }

    private async Task<List<TaskItemDto>> LoadOpenTasksAsync()
    {
        var statuses = new[]
        {
            TaskWorkflowStatus.Draft,
            TaskWorkflowStatus.Assigned,
            TaskWorkflowStatus.InProgress,
            TaskWorkflowStatus.OnHold
        };

        var requests = statuses.Select(status => TaskService.GetAsync(0, RelatedTaskPageSize, status: status));
        var responses = await Task.WhenAll(requests);

        return responses
            .Where(response => response.IsSuccess)
            .SelectMany(response => response.Data?.Data ?? [])
            .OrderBy(task => task.DueDate)
            .ThenBy(task => task.TaskNumber)
            .Take(RelatedTaskPageSize)
            .ToList();
    }

    private async Task<List<TaskItemDto>> LoadTasksByStatusAsync(TaskWorkflowStatus? status)
    {
        var response = await TaskService.GetAsync(0, RelatedTaskPageSize, status: status);
        if (!response.IsSuccess)
        {
            return [];
        }

        return response.Data?.Data
            .OrderBy(task => task.DueDate)
            .ThenBy(task => task.TaskNumber)
            .ToList() ?? [];
    }

    private string DepartmentName(Guid departmentId)
    {
        var department = departments.FirstOrDefault(d => d.Id == departmentId);
        return department is null ? string.Empty : Text(department.NameEng, department.Name);
    }

    private string StatusText(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Draft => Text("Draft", "مسودة"),
        TaskWorkflowStatus.Assigned => Text("Assigned", "مسندة"),
        TaskWorkflowStatus.InProgress => Text("In Progress", "قيد التنفيذ"),
        TaskWorkflowStatus.OnHold => Text("On Hold", "معلقة"),
        TaskWorkflowStatus.Completed => Text("Completed", "مكتملة"),
        TaskWorkflowStatus.Cancelled => Text("Cancelled", "ملغاة"),
        TaskWorkflowStatus.Overdue => Text("Overdue", "متأخرة"),
        _ => status.ToString()
    };

    private string PriorityText(TaskPriority priority) => priority switch
    {
        TaskPriority.Low => Text("Low", "منخفضة"),
        TaskPriority.Normal => Text("Normal", "عادية"),
        TaskPriority.High => Text("High", "عالية"),
        TaskPriority.Urgent => Text("Urgent", "عاجلة"),
        TaskPriority.Critical => Text("Critical", "حرجة"),
        _ => priority.ToString()
    };

    private static string StatusTone(TaskWorkflowStatus status) => status switch
    {
        TaskWorkflowStatus.Completed => "success",
        TaskWorkflowStatus.Overdue => "danger",
        TaskWorkflowStatus.OnHold => "warning",
        TaskWorkflowStatus.InProgress => "info",
        TaskWorkflowStatus.Cancelled => "muted",
        _ => "primary"
    };

    private static string PriorityTone(TaskPriority priority) => priority switch
    {
        TaskPriority.Critical or TaskPriority.Urgent => "danger",
        TaskPriority.High => "warning",
        TaskPriority.Low => "muted",
        _ => "primary"
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private enum TaskDashboardFilter
    {
        Total,
        Open,
        Completed,
        Overdue
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .task-dashboard-title {
        min-width: 220px;
        overflow-wrap: anywhere;
    }

    .task-dashboard-progress {
        min-width: 150px;
    }

    .task-dashboard-summary-row {
        align-items: center;
        border-bottom: 1px solid var(--erp-border);
        display: flex;
        gap: var(--erp-space-3);
        justify-content: space-between;
        padding-block: var(--erp-space-3);
    }

    .task-dashboard-summary-row:last-child {
        border-bottom: 0;
    }
</style>
