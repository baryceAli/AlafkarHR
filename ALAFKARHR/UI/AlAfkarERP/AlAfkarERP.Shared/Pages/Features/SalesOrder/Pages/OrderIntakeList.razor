@code {
    private bool CanView;
    private bool isLoading;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private int pageIndex;
    private const int PageSize = 20;
    private long totalCount;
    private string? searchText;
    private OrderIntakeStatus? statusFilter;
    private List<OrderIntakeDto> orders = [];

    private bool HasNextPage => (pageIndex + 1) * PageSize < totalCount;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.OrderIntakePermissions.View);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))

        {

            NavigationManager.NavigateTo("/Dashboard");

            return;

        }
        if (CanView)
        {
            await LoadCurrencyAsync();
            await LoadAsync();
        }
    }

    private async Task LoadCurrencyAsync()
    {
        var result = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencies = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await OrderIntakeService.GetByCompanyAsync(companyId, pageIndex, PageSize, statusFilter, searchText);
        if (result.IsSuccess && result.Data is not null)
        {
            orders = result.Data.Data.ToList();
            totalCount = result.Data.Count;
        }
        isLoading = false;
    }

    private async Task ResetFilters()
    {
        searchText = null;
        statusFilter = null;
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task PreviousPage()
    {
        if (pageIndex == 0)
            return;
        pageIndex--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (!HasNextPage)
            return;
        pageIndex++;
        await LoadAsync();
    }

    private string StatusText(OrderIntakeStatus status) => status switch
    {
        OrderIntakeStatus.Submitted => Text("Submitted", "Ù…Ø±Ø³Ù„"),
        OrderIntakeStatus.Validated => Text("Validated", "ØªÙ… Ø§Ù„ØªØ­Ù‚Ù‚"),
        OrderIntakeStatus.Rejected => Text("Rejected", "Ù…Ø±ÙÙˆØ¶"),
        OrderIntakeStatus.Accepted => Text("Accepted", "Ù…Ù‚Ø¨ÙˆÙ„"),
        OrderIntakeStatus.ConvertedToSales => Text("Converted", "Ù…Ø­ÙˆÙ„ Ù„Ù„Ø¨ÙŠØ¹"),
        OrderIntakeStatus.Cancelled => Text("Cancelled", "Ù…Ù„ØºÙŠ"),
        _ => Text("Draft", "Ù…Ø³ÙˆØ¯Ø©")
    };

    private static string StatusTone(OrderIntakeStatus status) => status switch
    {
        OrderIntakeStatus.Rejected or OrderIntakeStatus.Cancelled => "danger",
        OrderIntakeStatus.Accepted or OrderIntakeStatus.ConvertedToSales => "success",
        OrderIntakeStatus.Submitted or OrderIntakeStatus.Validated => "primary",
        _ => "muted"
    };

    private string DateText(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";
    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
