@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEdit => Id.HasValue && Id.Value != Guid.Empty;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanUsePage => IsEdit ? CanEdit : CanCreate;
    private bool isLoading;
    private bool isSaving;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private SalesQuotationDto quotation = new();
    private List<CustomerDto> customers = [];
    private List<ProductDto> products = [];
    private List<ProductSkuDto> skus = [];
    private List<SalesQuotationTemplateDto> quotationTemplates = [];

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanCreate = permissions.Contains(PermissionList.SalesQuotationPermissions.Create);
        CanEdit = permissions.Contains(PermissionList.SalesQuotationPermissions.Edit);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }

        if (CanUsePage)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var customerTask = CustomerService.GetByCompany(companyId, 0, 1000);
        var productTask = ProductService.GetPricedByCompanyAsync(companyId, null, 0, 1000);
        var currencyTask = CurrencyService.GetAsync(companyId, 0, 1000);
        var templateTask = SalesService.GetQuotationTemplatesAsync(companyId, activeOnly: true);
        await Task.WhenAll(customerTask, productTask, currencyTask, templateTask);

        customers = customerTask.Result.IsSuccess ? customerTask.Result.Data?.Data.ToList() ?? [] : [];
        products = productTask.Result.IsSuccess ? productTask.Result.Data?.Data.ToList() ?? [] : [];
        skus = products.SelectMany(x => x.Skus).Where(x => x.IsActive && x.IsSellable).OrderBy(x => Text(x.NameEng, x.Name)).ToList();
        quotationTemplates = templateTask.Result.IsSuccess ? templateTask.Result.Data ?? [] : [];
        var currencies = currencyTask.Result.IsSuccess ? currencyTask.Result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;

        if (IsEdit)
        {
            var result = await SalesService.GetQuotationByIdAsync(Id!.Value);
            quotation = result.IsSuccess && result.Data is not null ? result.Data : NewQuotation();
            ApplyCustomerDefaults(false);
            await ReloadProductsForCustomerAsync();
        }
        else
        {
            quotation = NewQuotation();
            AddLine();
        }

        isLoading = false;
    }

    private SalesQuotationDto NewQuotation() => new()
    {
        Number = $"QUO-{DateTime.UtcNow:yyyyMMddHHmmss}",
        CompanyId = companyId,
        QuotationDate = DateTime.Today,
        ValidUntil = DateTime.Today.AddDays(14),
        Lines = []
    };

    private async Task OnCustomerChanged(ChangeEventArgs args)
    {
        quotation.CustomerId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
        var selectedCustomer = customers.FirstOrDefault(x => x.Id == quotation.CustomerId);
        quotation.CustomerName = selectedCustomer?.Name;
        ApplyCustomerDefaults(true);
        await ReloadProductsForCustomerAsync();
    }

    private void OnQuotationTemplateChanged(ChangeEventArgs args)
    {
        quotation.QuotationTemplateId = Guid.TryParse(args.Value?.ToString(), out var templateId) ? templateId : null;
        var template = quotationTemplates.FirstOrDefault(x => x.Id == quotation.QuotationTemplateId);
        if (template is null)
            return;

        quotation.Notes = template.Notes;
        quotation.Terms = template.Terms;
        quotation.RequiresCustomerSignature = template.RequiresCustomerSignature;
        quotation.RequiresOnlinePayment = template.RequiresOnlinePayment;
        quotation.DownPaymentAmount = template.DownPaymentAmount;
        quotation.DownPaymentPercent = template.DownPaymentPercent;
        quotation.IsProForma = template.IsProForma;
        if (template.ValidityDays > 0)
            quotation.ValidUntil = (quotation.QuotationDate == default ? DateTime.Today : quotation.QuotationDate.Date).AddDays(template.ValidityDays);

        quotation.Lines = template.Lines.Select(line => new SalesQuotationLineDto
        {
            ProductId = line.ProductId,
            ProductSkuId = line.ProductSkuId,
            ProductName = line.ProductName,
            ProductNameEng = line.ProductNameEng,
            SkuCode = line.SkuCode,
            UnitOfMeasureId = line.UnitOfMeasureId,
            Quantity = line.Quantity,
            UnitPrice = line.UnitPrice,
            DiscountRate = line.DiscountRate,
            TaxRate = line.TaxRate,
            Notes = line.Notes,
            IsOptional = line.IsOptional
        }).ToList();
        Recalculate();
    }

    private async Task ReloadProductsForCustomerAsync()
    {
        var customerId = quotation.CustomerId == Guid.Empty ? (Guid?)null : quotation.CustomerId;
        var productResult = await ProductService.GetPricedByCompanyAsync(companyId, customerId, 0, 1000, quotation.PriceListId);
        if (productResult.IsSuccess)
        {
            products = productResult.Data?.Data.ToList() ?? [];
            skus = products.SelectMany(x => x.Skus).Where(x => x.IsActive && x.IsSellable).OrderBy(x => Text(x.NameEng, x.Name)).ToList();
        }
    }

    private void AddLine()
    {
        quotation.Lines.Add(new SalesQuotationLineDto { Quantity = 1 });
        Recalculate();
    }

    private void RemoveLine(SalesQuotationLineDto line)
    {
        quotation.Lines.Remove(line);
        Recalculate();
    }

    private void SelectSku(SalesQuotationLineDto line, string? value)
    {
        if (!Guid.TryParse(value, out var skuId))
            return;

        var sku = skus.FirstOrDefault(x => x.Id == skuId);
        if (sku is null)
            return;

        line.ProductId = sku.ProductId;
        line.ProductSkuId = sku.Id;
        line.ProductName = sku.Name;
        line.ProductNameEng = sku.NameEng;
        line.SkuCode = sku.SkuCode;
        line.UnitOfMeasureId = sku.UnitId ?? Guid.Empty;
        line.UnitPrice = sku.Price;
        line.DiscountRate = sku.DiscountRate;
        line.TaxRate = sku.TaxRate;
        Recalculate();
    }

    private async Task SaveAsync()
    {
        if (quotation.CustomerId == Guid.Empty)
        {
            ToastService.ShowWarning(Text("Select a customer.", "Ø§Ø®ØªØ± Ø¹Ù…ÙŠÙ„Ø§."));
            return;
        }

        quotation.CompanyId = companyId;
        quotation.Lines = quotation.Lines.Where(x => x.ProductSkuId != Guid.Empty && x.Quantity > 0).ToList();
        if (quotation.Lines.Count == 0)
        {
            ToastService.ShowWarning(Text("Add at least one SKU line.", "Ø£Ø¶Ù Ø¨Ù†Ø¯ ÙˆØ­Ø¯Ø© Ù…Ù†ØªØ¬ ÙˆØ§Ø­Ø¯Ø§ Ø¹Ù„Ù‰ Ø§Ù„Ø£Ù‚Ù„."));
            AddLine();
            return;
        }

        Recalculate();
        isSaving = true;
        var isSuccess = false;
        string? errorDetail = null;
        if (IsEdit)
        {
            var updateResult = await SalesService.UpdateQuotationAsync(quotation);
            isSuccess = updateResult.IsSuccess;
            errorDetail = updateResult.Error?.Detail;
        }
        else
        {
            var createResult = await SalesService.CreateQuotationAsync(quotation);
            isSuccess = createResult.IsSuccess;
            errorDetail = createResult.Error?.Detail;
        }

        if (isSuccess)
        {
            ToastService.ShowSuccess(Text("Quotation saved.", "ØªÙ… Ø­ÙØ¸ Ø¹Ø±Ø¶ Ø§Ù„Ø³Ø¹Ø±."));
            NavigationManager.NavigateTo("/Sales/Quotations");
        }
        else
        {
            ToastService.ShowError(errorDetail ?? Text("Unable to save quotation.", "ØªØ¹Ø°Ø± Ø­ÙØ¸ Ø¹Ø±Ø¶ Ø§Ù„Ø³Ø¹Ø±."));
        }
        isSaving = false;
    }

    private void Recalculate()
    {
        quotation.Subtotal = quotation.Lines.Sum(x => x.NetAmount);
        quotation.TaxAmount = quotation.Lines.Sum(x => x.TaxAmount);
        quotation.TotalAmount = quotation.Subtotal + quotation.TaxAmount;
    }

    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private CustomerDto? SelectedCustomer => customers.FirstOrDefault(x => x.Id == quotation.CustomerId);
    private List<AddressDto> CustomerAddresses => SelectedCustomer?.Addresses
        .Where(x => x.AddressType is PartnerAddressType.Invoice or PartnerAddressType.Delivery or PartnerAddressType.Contact or PartnerAddressType.Other)
        .ToList() ?? [];

    private void ApplyCustomerDefaults(bool overwrite)
    {
        var addresses = CustomerAddresses;
        if (overwrite || !quotation.InvoiceAddressId.HasValue)
            quotation.InvoiceAddressId = addresses.FirstOrDefault(x => x.IsDefaultBilling)?.Id
                ?? addresses.FirstOrDefault(x => x.AddressType == PartnerAddressType.Invoice)?.Id;

        if (overwrite || !quotation.DeliveryAddressId.HasValue)
            quotation.DeliveryAddressId = addresses.FirstOrDefault(x => x.IsDefaultShipping)?.Id
                ?? addresses.FirstOrDefault(x => x.AddressType == PartnerAddressType.Delivery)?.Id;

        if (quotation.InvoiceAddressId.HasValue && !addresses.Any(x => x.Id == quotation.InvoiceAddressId.Value))
            quotation.InvoiceAddressId = null;

        if (quotation.DeliveryAddressId.HasValue && !addresses.Any(x => x.Id == quotation.DeliveryAddressId.Value))
            quotation.DeliveryAddressId = null;
    }

    private string AddressLabel(AddressDto address)
    {
        var type = address.AddressType switch
        {
            PartnerAddressType.Invoice => Text("Invoice", "ÙØ§ØªÙˆØ±Ø©"),
            PartnerAddressType.Delivery => Text("Delivery", "ØªØ³Ù„ÙŠÙ…"),
            PartnerAddressType.Private => Text("Private", "Ø®Ø§Øµ"),
            PartnerAddressType.Other => Text("Other", "Ø£Ø®Ø±Ù‰"),
            _ => Text("Contact", "Ø¬Ù‡Ø© Ø§ØªØµØ§Ù„")
        };

        return $"{type} - {address.Title} - {address.City}";
    }
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

