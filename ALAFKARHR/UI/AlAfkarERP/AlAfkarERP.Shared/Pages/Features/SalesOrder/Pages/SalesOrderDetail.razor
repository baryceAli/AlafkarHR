<section class="sales-page erp-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "Ù„ÙŠØ³ Ù„Ø¯ÙŠÙƒ Ø§Ù„ØµÙ„Ø§Ø­ÙŠØ© Ù„Ø¹Ø±Ø¶ Ù‡Ø°Ù‡ Ø§Ù„ØµÙØ­Ø©")</div>
        return;
    }

    <PageHeader Title="@(order?.Number ?? Text("Sales Order", "Ø£Ù…Ø± Ø¨ÙŠØ¹"))"
                Subtitle="@Text("Review sales order lines, totals, and fulfillment workflow.", "Ù…Ø±Ø§Ø¬Ø¹Ø© Ø§Ù„Ø£ØµÙ†Ø§Ù ÙˆØ§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠØ§Øª ÙˆØ³ÙŠØ± Ø§Ù„ØªÙ†ÙÙŠØ°.")"
