    @if (isLoading)
    {
        <div class="erp-loading py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2">@Text("Loading sales order...", "Ø¬Ø§Ø±ÙŠ ØªØ­Ù…ÙŠÙ„ Ø£Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹...")</div>
        </div>
    }
    else if (order is null)
    {
        <EmptyState Title="@Text("Sales order not found", "Ù„Ù… ÙŠØªÙ… Ø§Ù„Ø¹Ø«ÙˆØ± Ø¹Ù„Ù‰ Ø§Ù„Ø£Ù…Ø±")"
                    Message="@Text("The requested sales order could not be loaded.", "ØªØ¹Ø°Ø± ØªØ­Ù…ÙŠÙ„ Ø£Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹ Ø§Ù„Ù…Ø·Ù„ÙˆØ¨.")"
                    Icon="bi-exclamation-circle" />
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-8">
                <AppCard Title="@Text("Lines", "Ø§Ù„Ø£ØµÙ†Ø§Ù")">
                    <div class="erp-table-wrap">
                        <table class="table erp-table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>@Text("Item", "Ø§Ù„ØµÙ†Ù")</th>
                                    <th>@Text("SKU", "Ø§Ù„Ø±Ù…Ø²")</th>
                                    <th>@Text("Qty", "Ø§Ù„ÙƒÙ…ÙŠØ©")</th>
                                    <th>@Text("Reserved", "Ù…Ø­Ø¬ÙˆØ²")</th>
                                    <th>@Text("Delivered", "Ù…Ø³Ù„Ù…")</th>
                                    <th>@Text("Remaining", "Ù…ØªØ¨Ù‚ÙŠ")</th>
                                    <th>@Text("Invoiced", "Ù…ÙÙˆØªØ±")</th>
                                    <th>@Text("Total", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in order.Lines)
                                {
                                    <tr>
                                        <td>@Text(line.ProductNameEng, line.ProductName)</td>
