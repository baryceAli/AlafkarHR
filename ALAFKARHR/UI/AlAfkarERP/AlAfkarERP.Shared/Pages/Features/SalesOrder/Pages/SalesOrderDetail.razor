                                                        }
                                                    </div>
                                                </details>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>
            <div class="col-lg-4">
                <AppCard Title="@Text("Summary", "Ø§Ù„Ù…Ù„Ø®Øµ")" CssClass="mb-3">
                    <div class="summary-row"><span>@Text("Status", "Ø§Ù„Ø­Ø§Ù„Ø©")</span><strong>@StatusText(order.Status)</strong></div>
                    @if (order.BranchId.HasValue)
                    {
                        <div class="summary-row"><span>@Text("Branch", "Ø§Ù„ÙØ±Ø¹")</span><strong>@BranchName(order.BranchId.Value)</strong></div>
                    }
                    <div class="summary-row"><span>@Text("Order date", "ØªØ§Ø±ÙŠØ® Ø§Ù„Ø£Ù…Ø±")</span><strong>@order.OrderDate.ToString("yyyy-MM-dd")</strong></div>
                    <div class="summary-row"><span>@Text("Subtotal", "Ø§Ù„Ù…Ø¬Ù…ÙˆØ¹")</span><strong>@Money(order.Subtotal)</strong></div>
                    <div class="summary-row"><span>@Text("Tax", "Ø§Ù„Ø¶Ø±ÙŠØ¨Ø©")</span><strong>@Money(order.TaxAmount)</strong></div>
                    <div class="summary-row summary-total"><span>@Text("Total", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ")</span><strong>@Money(order.TotalAmount)</strong></div>
                </AppCard>

                <AppCard Title="@Text("Quotation & Invoicing", "Quotation & Invoicing")" CssClass="mb-3">
                    <div class="summary-row">
                        <span>@Text("Source quotation", "Source quotation")</span>
                        @if (order.SourceQuotationId.HasValue)
                        {
                            <a href="@($"/Sales/Quotations/{order.SourceQuotationId.Value}")">@SourceQuotationLabel()</a>
                        }
                        else
                        {
                            <strong>-</strong>
                        }
                    </div>
                    <div class="summary-row"><span>@Text("Quotation template", "Quotation template")</span><strong>@TemplateLabel()</strong></div>
                    <div class="summary-row"><span>@Text("Invoice address", "Invoice address")</span><strong>@AddressValue(order.InvoiceAddressId)</strong></div>
                    <div class="summary-row"><span>@Text("Delivery address", "Delivery address")</span><strong>@AddressValue(order.DeliveryAddressId)</strong></div>
                    <div class="summary-row"><span>@Text("Invoicing policy", "Invoicing policy")</span><strong>@InvoicingPolicyText(order.InvoicingPolicy)</strong></div>
                    <div class="summary-row"><span>@Text("Down payment", "Down payment")</span><strong>@DownPaymentText()</strong></div>
                    <div class="quote-control-chips mt-3">
                        @if (order.RequiresCustomerSignature)
                        {
                    <StatusChip Text="@Text("Signature required", "Signature required")" Tone="muted" />
                        }
                        @if (order.RequiresOnlinePayment)
                        {
                    <StatusChip Text="@Text("Online payment required", "Online payment required")" Tone="primary" />
                        }
                        @if (order.IsProForma)
                        {
                    <StatusChip Text="@Text("Pro-forma", "Pro-forma")" Tone="info" />
                        }
                    </div>
                </AppCard>

                @if ((CanEdit || CanConfirm) && !order.IsCancelled && !order.IsCompleted)
                {
                    <AppCard Title="@Text("Workflow", "Ø³ÙŠØ± Ø§Ù„Ø¹Ù…Ù„")">
                        @if (order.Status == SalesOrderStatus.Draft && CanConfirm)
                        {
                            <button class="btn btn-primary w-100 mb-2" @onclick="ConfirmAsync" disabled="@isSaving">
                                <i class="bi bi-check2-circle"></i> @Text("Confirm order", "ØªØ£ÙƒÙŠØ¯ Ø§Ù„Ø£Ù…Ø±")
                            </button>
                        }
                        @if (CanReserve && CanReserveOrder)
                        {
                            <label class="form-label">@Text("Reservation warehouse", "Ù…Ø³ØªÙˆØ¯Ø¹ Ø§Ù„Ø­Ø¬Ø²")</label>
                            <select class="form-select mb-2" @bind="selectedWarehouseId" disabled="@(isSaving || warehouses.Count == 0)">
                                <option value="@Guid.Empty">@Text("Select warehouse", "Ø§Ø®ØªØ± Ø§Ù„Ù…Ø³ØªÙˆØ¯Ø¹")</option>
                                @foreach (var warehouse in warehouses)
                                {
                                    <option value="@warehouse.Id">@Text(warehouse.NameEng, warehouse.Name)</option>
                                }
                            </select>

                            <div class="reservation-lines mb-2">
                                @foreach (var line in reservationLines)
                                {
                                    <div class="reservation-line">
                                        <span>@line.SkuCode</span>
                                        <input class="form-control form-control-sm" type="number" min="0" step="0.01" @bind="line.Quantity" />
                                    </div>
                                }
                            </div>

                            <button class="btn btn-outline-primary w-100 mb-2" @onclick="ReserveAsync" disabled="@(isSaving || selectedWarehouseId == Guid.Empty)">
                                <i class="bi bi-box-seam"></i> @Text("Reserve stock", "Ø­Ø¬Ø² Ø§Ù„Ù…Ø®Ø²ÙˆÙ†")
                            </button>
                            <button class="btn btn-outline-secondary w-100 mb-2" @onclick="ReleaseReservationAsync" disabled="@(isSaving || selectedWarehouseId == Guid.Empty)">
                                <i class="bi bi-unlock"></i> @Text("Release reservation", "ÙÙƒ Ø§Ù„Ø­Ø¬Ø²")
                            </button>
                        }
                        <button class="btn btn-outline-primary w-100 mb-2" @onclick="DeliverAsync" disabled="@(isSaving || order.Status == SalesOrderStatus.Draft || !CanEdit)">
                            <i class="bi bi-truck"></i> @Text("Mark delivered", "ØªØ­Ø¯ÙŠØ¯ ÙƒÙ…Ø³Ù„Ù…")
                        </button>
                        <button class="btn btn-outline-success w-100 mb-2" @onclick="InvoiceAsync" disabled="@(isSaving || order.Status == SalesOrderStatus.Draft || !CanEdit)">
                            <i class="bi bi-receipt"></i> @Text("Mark invoiced", "ØªØ­Ø¯ÙŠØ¯ ÙƒÙ…ÙÙˆØªØ±")
                        </button>
                        <label class="form-label">@Text("Cancel reason", "Ø³Ø¨Ø¨ Ø§Ù„Ø¥Ù„ØºØ§Ø¡")</label>
                        <textarea class="form-control mb-2" rows="2" @bind="cancelReason"></textarea>
                        <button class="btn btn-outline-danger w-100" @onclick="CancelAsync" disabled="@isSaving">
                            <i class="bi bi-x-circle"></i> @Text("Cancel order", "Ø¥Ù„ØºØ§Ø¡ Ø§Ù„Ø£Ù…Ø±")
                        </button>
                    </AppCard>
                }
            </div>
        </div>
    }
</section>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool CanView;
    private bool CanEdit;
    private bool CanConfirm;
    private bool CanReserve;
    private bool isLoading;
    private bool isSaving;
    private string cancelReason = string.Empty;
    private string currencyCode = string.Empty;
    private List<BranchDto> branches = [];
    private List<WarehouseDto> warehouses = [];
    private List<ProductSkuDto> catalogSkus = [];
    private List<ReservationLineModel> reservationLines = [];
    private Guid selectedWarehouseId;
    private SalesOrderDto? order;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = permissions.Contains(PermissionList.SalesOrderPermissions.View);
        CanEdit = permissions.Contains(PermissionList.SalesOrderPermissions.Edit);
        CanConfirm = permissions.Contains(PermissionList.SalesOrderPermissions.Confirm);
        CanReserve = permissions.Contains(PermissionList.SalesOrderPermissions.Reserve);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetOrderByIdAsync(Id);
        order = result.IsSuccess ? result.Data : null;
        if (order is not null)
        {
            await LoadCurrencyAsync(order.CompanyId);
            await LoadCatalogSkusAsync(order.CompanyId);
            await LoadBranchesAsync(order.CompanyId);
            await LoadWarehousesAsync(order.CompanyId, order.BranchId);
            ResetReservationLines();
        }
        isLoading = false;
    }

    private async Task LoadBranchesAsync(Guid companyId)
    {
        var result = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        if (result.IsSuccess)
        {
            branches = result.Data?.Data?.ToList() ?? [];
        }
    }

    private async Task LoadCurrencyAsync(Guid companyId)
    {
        var result = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencies = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task LoadCatalogSkusAsync(Guid companyId)
    {
        var result = await ProductService.GetPricedByCompanyAsync(companyId, null, 0, 1000);
        catalogSkus = result.IsSuccess
            ? result.Data?.Data?.SelectMany(product => product.Skus).ToList() ?? []
            : [];
    }

    private async Task LoadWarehousesAsync(Guid companyId, Guid? branchId)
    {
        var result = await WarehouseService.GetAsync(companyId, 0, 1000, string.Empty, branchId);
        warehouses = result.IsSuccess ? result.Data?.Data?.ToList() ?? [] : [];
        selectedWarehouseId = warehouses.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private async Task ConfirmAsync() => await RunWorkflowAsync(() => WorkflowService.ConfirmAsync(Id), Text("Order confirmed.", "ØªÙ… ØªØ£ÙƒÙŠØ¯ Ø§Ù„Ø£Ù…Ø±."));

    private async Task ReserveAsync() => await RunWorkflowAsync(
        () => WorkflowService.ReserveAsync(Id, BuildReservationRequest()),
        Text("Stock reserved.", "ØªÙ… Ø­Ø¬Ø² Ø§Ù„Ù…Ø®Ø²ÙˆÙ†."));

    private async Task ReleaseReservationAsync() => await RunWorkflowAsync(
        () => WorkflowService.ReleaseReservationAsync(Id, BuildReservationRequest()),
        Text("Reservation released.", "ØªÙ… ÙÙƒ Ø§Ù„Ø­Ø¬Ø²."));

    private async Task DeliverAsync() => await RunWorkflowAsync(() => WorkflowService.DeliverAsync(order!), Text("Order delivered.", "ØªÙ… ØªØ­Ø¯ÙŠØ¯ Ø§Ù„Ø£Ù…Ø± ÙƒÙ…Ø³Ù„Ù…."));

    private async Task InvoiceAsync() => await RunWorkflowAsync(() => WorkflowService.InvoiceAsync(order!), Text("Order invoiced.", "ØªÙ… ØªØ­Ø¯ÙŠØ¯ Ø§Ù„Ø£Ù…Ø± ÙƒÙ…ÙÙˆØªØ±."));

    private async Task CancelAsync()
    {
        if (string.IsNullOrWhiteSpace(cancelReason))
        {
            ToastService.ShowWarning(Text("Enter a cancel reason.", "Ø£Ø¯Ø®Ù„ Ø³Ø¨Ø¨ Ø§Ù„Ø¥Ù„ØºØ§Ø¡."));
            return;
        }

        await RunWorkflowAsync(() => WorkflowService.CancelAsync(Id, cancelReason), Text("Order cancelled.", "ØªÙ… Ø¥Ù„ØºØ§Ø¡ Ø§Ù„Ø£Ù…Ø±."));
    }

    private async Task RunWorkflowAsync(Func<Task<AlAfkarERP.Shared.Dtos.ApiResult<bool>>> action, string successMessage)
    {
        if (order is null)
            return;

        isSaving = true;
        var result = await action();
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(successMessage);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Workflow action failed.", "ÙØ´Ù„ Ø¥Ø¬Ø±Ø§Ø¡ Ø³ÙŠØ± Ø§Ù„Ø¹Ù…Ù„."));
        }
        isSaving = false;
    }

    private SalesOrderReservationRequestDto BuildReservationRequest() => new()
    {
        WarehouseId = selectedWarehouseId,
        Lines = reservationLines
            .Where(x => x.Quantity > 0)
            .Select(x => new SalesOrderReservationLineDto
            {
                SalesOrderLineId = x.SalesOrderLineId,
                Quantity = x.Quantity
            })
            .ToList()
    };

    private void ResetReservationLines()
    {
        reservationLines = order?.Lines
            .Where(x => x.RemainingToDeliverQuantity > 0)
            .Select(x => new ReservationLineModel
            {
                SalesOrderLineId = x.Id,
                SkuCode = x.SkuCode,
                Quantity = x.UnreservedQuantity > 0 ? x.UnreservedQuantity : x.ReservedQuantity
            })
            .ToList() ?? [];
    }

    private bool CanReserveOrder =>
        order?.Status is SalesOrderStatus.Confirmed or SalesOrderStatus.PartiallyReserved or SalesOrderStatus.Reserved;

    private string StatusText(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Confirmed => Text("Confirmed", "Ù…Ø¤ÙƒØ¯"),
        SalesOrderStatus.PartiallyReserved => Text("Partially reserved", "Ù…Ø­Ø¬ÙˆØ² Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Reserved => Text("Reserved", "Ù…Ø­Ø¬ÙˆØ²"),
        SalesOrderStatus.PartiallyDelivered => Text("Partially delivered", "Ù…Ø³Ù„Ù… Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Delivered => Text("Delivered", "Ù…Ø³Ù„Ù…"),
        SalesOrderStatus.PartiallyInvoiced => Text("Partially invoiced", "Ù…ÙÙˆØªØ± Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Invoiced => Text("Invoiced", "Ù…ÙÙˆØªØ±"),
        SalesOrderStatus.Completed => Text("Completed", "Ù…ÙƒØªÙ…Ù„"),
        SalesOrderStatus.Cancelled => Text("Cancelled", "Ù…Ù„ØºÙŠ"),
        _ => Text("Draft", "Ù…Ø³ÙˆØ¯Ø©")
    };

    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";

    private string SourceQuotationLabel()
    {
        if (order is null)
            return "-";

        return string.IsNullOrWhiteSpace(order.SourceDocumentNumber)
            ? order.SourceQuotationId?.ToString("N")[..8] ?? "-"
            : order.SourceDocumentNumber;
    }

    private string TemplateLabel()
    {
        if (order?.QuotationTemplateId is not Guid templateId)
            return Text("Template storage planned in Phase 4", "Template storage planned in Phase 4");

        return templateId.ToString("N")[..8];
    }

    private string AddressValue(Guid? addressId) =>
        addressId.HasValue ? addressId.Value.ToString("N")[..8] : Text("Customer default", "Customer default");

    private string InvoicingPolicyText(SalesInvoicingPolicy policy) => policy switch
    {
        SalesInvoicingPolicy.InvoiceOrderedQuantity => Text("Invoice ordered quantities", "Invoice ordered quantities"),
        SalesInvoicingPolicy.InvoiceDeliveredQuantity => Text("Invoice delivered quantities", "Invoice delivered quantities"),
        _ => policy.ToString()
    };

    private string DownPaymentText()
    {
        if (order is null || (order.DownPaymentAmount <= 0 && order.DownPaymentPercent <= 0))
            return Text("None", "None");

        var parts = new List<string>();
        if (order.DownPaymentAmount > 0)
            parts.Add(Money(order.DownPaymentAmount));
        if (order.DownPaymentPercent > 0)
            parts.Add($"{order.DownPaymentPercent:N2}%");

        return string.Join(" / ", parts);
    }

    private bool TryGetComboSku(Guid productSkuId, out ProductSkuDto sku)
    {
        sku = catalogSkus.FirstOrDefault(x => x.Id == productSkuId &&
            (x.ProductType == CatalogProductType.Combo || x.ProductionType == SkuProductionType.CompositeBundle))!;
        return sku is not null && sku.Components.Any();
    }

    private string BranchName(Guid branchId)
    {
        var branch = branches.FirstOrDefault(x => x.Id == branchId);
        return branch is null ? branchId.ToString("N")[..8] : Text(branch.NameEng, branch.Name);
    }

    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }

    private sealed class ReservationLineModel
    {
        public Guid SalesOrderLineId { get; set; }
        public string SkuCode { get; set; } = string.Empty;
        public decimal Quantity { get; set; }
    }
}

<style>
    .summary-row {
        align-items: center;
        border-bottom: 1px solid var(--erp-border);
        display: flex;
