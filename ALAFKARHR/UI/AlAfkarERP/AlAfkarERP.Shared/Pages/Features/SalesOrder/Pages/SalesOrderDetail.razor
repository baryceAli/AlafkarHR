    .summary-row:last-child {
        border-bottom: 0;
    }

    .summary-total {
        font-size: 1.1rem;
    }

    .reservation-lines {
        display: grid;
        gap: var(--erp-space-2);
    }

    .reservation-line {
        align-items: center;
        display: grid;
        gap: var(--erp-space-2);
        grid-template-columns: minmax(0, 1fr) 7rem;
    }

    .kit-impact-row td {
        background: var(--erp-surface-muted);
    }

    .kit-impact-list {
