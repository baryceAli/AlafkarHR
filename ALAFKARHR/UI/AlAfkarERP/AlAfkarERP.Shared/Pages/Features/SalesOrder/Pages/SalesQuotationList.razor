@code {
    private bool CanView;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanSend;
    private bool CanConvert;
    private bool isLoading;
    private bool isExpiring;
    private Guid companyId;
    private List<SalesQuotationDto> quotations = [];
    [SupplyParameterFromQuery] public Guid? CustomerId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductSkuId { get; set; }
    private bool HasSmartFilter => CustomerId.HasValue || ProductId.HasValue || ProductSkuId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = permissions.Contains(PermissionList.SalesQuotationPermissions.View);
        CanCreate = permissions.Contains(PermissionList.SalesQuotationPermissions.Create);
        CanEdit = permissions.Contains(PermissionList.SalesQuotationPermissions.Edit);
        CanSend = permissions.Contains(PermissionList.SalesQuotationPermissions.Send);
        CanConvert = permissions.Contains(PermissionList.SalesQuotationPermissions.Convert);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetQuotationsByCompanyAsync(companyId, 0, 50, CustomerId, ProductId, ProductSkuId);
        quotations = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        isLoading = false;
    }

    private string SmartFilterText()
    {
        if (CustomerId.HasValue)
            return Text("Filtered by customer", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ Ø§Ù„Ø¹Ù…ÙŠÙ„");
        if (ProductSkuId.HasValue)
            return Text("Filtered by SKU", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ ÙˆØ­Ø¯Ø© Ø§Ù„Ù…Ù†ØªØ¬");
        if (ProductId.HasValue)
            return Text("Filtered by product", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ Ø§Ù„Ù…Ù†ØªØ¬");
        return Text("Filtered", "Ù…ØµÙÙ‰");
    }

    private async Task SendAsync(Guid id)
    {
        var result = await SalesService.SendQuotationAsync(id);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Quotation updated.", "ØªÙ… ØªØ­Ø¯ÙŠØ« Ø¹Ø±Ø¶ Ø§Ù„Ø³Ø¹Ø±."));
            ToastService.ShowSuccess(Text("Marked sent. Email delivery depends on the configured mail infrastructure.", "ØªÙ… ØªØ¹ÙŠÙŠÙ†Ù‡ ÙƒÙ…Ø±Ø³Ù„. ÙŠØ¹ØªÙ…Ø¯ Ø¥Ø±Ø³Ø§Ù„ Ø§Ù„Ø¨Ø±ÙŠØ¯ Ø¹Ù„Ù‰ Ø¥Ø¹Ø¯Ø§Ø¯Ø§Øª Ø§Ù„Ø¨Ù†ÙŠØ© Ø§Ù„Ø¨Ø±ÙŠØ¯ÙŠØ©."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Action failed.", "ØªØ¹Ø°Ø± ØªÙ†ÙÙŠØ° Ø§Ù„Ø¥Ø¬Ø±Ø§Ø¡."));
        }
    }

    private async Task ConvertAsync(Guid id)
    {
        var result = await SalesService.ConvertQuotationAsync(id);
        if (result.IsSuccess && result.Data.HasValue)
            NavigationManager.NavigateTo($"/Sales/Orders/{result.Data.Value}");
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to convert quotation.", "ØªØ¹Ø°Ø± ØªØ­ÙˆÙŠÙ„ Ø¹Ø±Ø¶ Ø§Ù„Ø³Ø¹Ø±."));
    }

    private async Task ExpireOverdueAsync()
    {
        isExpiring = true;
        var result = await SalesService.ExpireOverdueQuotationsAsync(companyId);
        if (result.IsSuccess)
        {
            var count = result.Data?.ExpiredCount ?? 0;
            ToastService.ShowSuccess(Text($"{count} overdue quotation(s) expired.", $"ØªÙ… Ø¥Ù†Ù‡Ø§Ø¡ {count} Ø¹Ø±Ø¶ Ø³Ø¹Ø± Ù…ØªØ£Ø®Ø±."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Could not expire overdue quotations.", "ØªØ¹Ø°Ø± Ø¥Ù†Ù‡Ø§Ø¡ Ø¹Ø±ÙˆØ¶ Ø§Ù„Ø£Ø³Ø¹Ø§Ø± Ø§Ù„Ù…ØªØ£Ø®Ø±Ø©."));
        }
        isExpiring = false;
    }

    private static string StatusTone(SalesQuotationStatus status) => status switch
    {
        SalesQuotationStatus.ConvertedToSalesOrder or SalesQuotationStatus.Accepted => "success",
        SalesQuotationStatus.Rejected or SalesQuotationStatus.Cancelled or SalesQuotationStatus.Expired => "danger",
        SalesQuotationStatus.Sent => "primary",
        _ => "muted"
    };

    private string StatusText(SalesQuotationStatus status) => status switch
    {
        SalesQuotationStatus.Draft => Text("Draft", "Ù…Ø³ÙˆØ¯Ø©"),
        SalesQuotationStatus.Sent => Text("Sent", "Ù…Ø±Ø³Ù„"),
        SalesQuotationStatus.Accepted => Text("Accepted", "Ù…Ù‚Ø¨ÙˆÙ„"),
        SalesQuotationStatus.Rejected => Text("Rejected", "Ù…Ø±ÙÙˆØ¶"),
        SalesQuotationStatus.Expired => Text("Expired", "Ù…Ù†ØªÙ‡ÙŠ"),
        SalesQuotationStatus.ConvertedToSalesOrder => Text("Converted", "Ù…Ø­ÙˆÙ„"),
        SalesQuotationStatus.Cancelled => Text("Cancelled", "Ù…Ù„ØºÙ‰"),
        _ => status.ToString()
    };

    private static bool IsExpiredDraftOrSent(SalesQuotationDto quotation) =>
        quotation.ValidUntil.HasValue
        && quotation.ValidUntil.Value.Date < DateTime.Today
        && quotation.Status is SalesQuotationStatus.Draft or SalesQuotationStatus.Sent;

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}

