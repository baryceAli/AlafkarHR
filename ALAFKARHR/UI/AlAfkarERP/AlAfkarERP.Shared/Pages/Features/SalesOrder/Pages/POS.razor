@layout AdminLayout
@page "/SalesOrder/POS"
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Features.SalesOrder.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Cart.Dtos
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Orders.Enums
@using SharedWithUI.Payments.Enums
@using SharedWithUI.Permissions

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IBrandService BrandService
@inject ICartService CartService
@inject ICompanySettingService CompanySettingService
@inject ICurrencyService CurrencyService
@inject ToastService ToastService
@inject LoadingService LoadingService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ApiConfig ApiConfig
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="pos-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
        <div class="alert alert-info">
            <div>@Text("StoreFront branch cashiers should use the StoreFront POS workflow.", "يجب على كاشيري فروع الواجهة استخدام نقطة بيع الواجهة.")</div>
            <a class="btn btn-sm btn-outline-primary mt-2" href="/StoreFront/POS">
                <i class="bi bi-shop"></i> @Text("Open StoreFront POS", "فتح نقطة بيع الواجهة")
            </a>
        </div>
        return;
    }

    <PageHeader Title="@Text("Point of Sale", "نقطة البيع")"
                Subtitle="@Text("Sell priced SKUs, manage the active cart, and submit checkout to order intake.", "بيع المنتجات المسعرة وإدارة السلة وإرسال الطلب.")"
                Overline="@Text("Sales", "المبيعات")"
                Icon="bi-receipt">
        <Actions>
            <a class="btn btn-outline-secondary" href="/Orders/Intakes">
                <i class="bi bi-card-checklist"></i> @Text("Order Intakes", "طلبات البيع")
            </a>
        </Actions>
    </PageHeader>

    <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2">
        <span>@Text("This is the company-level POS. Use StoreFront POS for branch-scoped stores, cashier sessions, handovers, and StoreFront inventory.", "هذه نقطة بيع عامة على مستوى الشركة. استخدم نقطة بيع الواجهة للمتاجر المرتبطة بالفروع وجلسات الكاشير والمناقلات ومخزون الواجهة.")</span>
        <a class="btn btn-sm btn-outline-primary" href="/StoreFront/POS">
            <i class="bi bi-shop"></i> @Text("StoreFront POS", "نقطة بيع الواجهة")
        </a>
    </div>

    <div class="row g-3">
        <div class="col-xl-8">
            <AppCard Title="@Text("Catalog", "الكتالوج")" CssClass="mb-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-5">
                        <label class="form-label">@Text("Search", "بحث")</label>
                        <input class="form-control" @bind="searchText" @bind:after="ApplyFilters" placeholder="@Text("Search products or SKU codes", "ابحث باسم المنتج أو الرمز")" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Text("Category", "الفئة")</label>
                        <select class="form-select" @bind="selectedCategoryId" @bind:after="ApplyFilters">
                            <option value="">@Text("All categories", "كل الفئات")</option>
                            @foreach (var category in categories)
                            {
                                <option value="@category.Id">@Text(category.NameEng, category.Name)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Text("Brand", "العلامة")</label>
                        <select class="form-select" @bind="selectedBrandId" @bind:after="ApplyFilters">
                            <option value="">@Text("All brands", "كل العلامات")</option>
                            @foreach (var brand in brands)
                            {
                                <option value="@brand.Id">@Text(brand.NameEng, brand.Name)</option>
                            }
                        </select>
                    </div>
                </div>
            </AppCard>

            @if (isLoading)
            {
                <div class="erp-loading py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2">@Text("Loading products...", "جاري تحميل المنتجات...")</div>
                </div>
            }
            else if (!displaySkus.Any())
            {
                <EmptyState Title="@Text("No products found", "لا توجد منتجات")"
                            Message="@Text("Try changing the search or filters.", "جرب تغيير البحث أو التصفية.")"
                            Icon="bi-box-seam" />
            }
            else
            {
                <div class="row g-3">
                    @foreach (var sku in displaySkus)
                    {
                        <div class="col-lg-4 col-md-6">
                            <div class="card h-100 border-0 shadow-sm sku-card">
                                <div class="sku-image-container">
                                    <img src="@ImageUrl(sku)" class="sku-image" alt="@Text(sku.NameEng, sku.Name)" />
                                </div>
                                <div class="card-body d-flex flex-column">
                                    <div class="d-flex justify-content-between gap-2 mb-2">
                                        <span class="badge text-bg-light">@Text(sku.BrandNameEng, sku.BrandName)</span>
                                        <span class="fw-bold text-success">@Money(sku.Price)</span>
                                    </div>
                                    <h6 class="fw-bold mb-1">@Text(sku.NameEng, sku.Name)</h6>
                                    <div class="text-muted small mb-3">@Text(sku.SkuCodeEng, sku.SkuCode)</div>
                                    <button class="btn btn-success mt-auto" @onclick="() => AddToCartAsync(sku)" disabled="@(isCartBusy || !CanManageCart)">
                                        <i class="bi bi-cart-plus"></i> @Text("Add To Cart", "إضافة للسلة")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-xl-4">
            <AppCard Title="@Text("Active Cart", "السلة الحالية")"
                     Subtitle="@(cart is null ? Text("Add an item to create a cart.", "أضف منتجا لإنشاء سلة.") : Text($"{cart.Lines.Count} lines", $"{cart.Lines.Count} صنف"))">
                @if (checkoutResult is not null)
                {
                    <div class="alert alert-success">
                        <div class="fw-semibold">@Text("Checkout completed", "تم إكمال الدفع")</div>
                        <div>@Text("Sales order", "أمر بيع"): @(checkoutResult.SalesOrderNumber ?? checkoutResult.Number)</div>
                        <div>@Text("Total", "الإجمالي"): @Money(checkoutResult.CheckoutTotal)</div>
                        @if (checkoutResult.SalesOrderId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-success mt-2" href="@($"/Sales/Orders/{checkoutResult.SalesOrderId}")">@Text("View sales order", "عرض أمر البيع")</a>
                        }
                        else if (checkoutResult.OrderIntakeId.HasValue)
                        {
                            <a class="btn btn-sm btn-outline-success mt-2" href="@($"/Orders/Intakes/{checkoutResult.OrderIntakeId}")">@Text("View intake", "عرض الطلب")</a>
                        }
                    </div>
                }

                @if (!CanManageCart)
                {
                    <div class="alert alert-warning">@Text("You need cart permissions to add or edit cart lines.", "تحتاج إلى صلاحيات السلة لإضافة أو تعديل الأصناف.")</div>
                }

                @if (cart is null || !cart.Lines.Any())
                {
                    <EmptyState Title="@Text("Cart is empty", "السلة فارغة")"
                                Message="@Text("Selected products will appear here.", "ستظهر المنتجات المختارة هنا.")"
                                Icon="bi-cart" />
                }
                else
                {
                    <div class="cart-lines">
                        @foreach (var line in cart.Lines)
                        {
                            <div class="cart-line">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@Text(line.ProductNameEng, line.ProductName)</div>
                                    <div class="text-muted small">@line.SkuCode</div>
                                    <div class="small">@Money(line.UnitPrice) x @line.Quantity = <strong>@Money(line.TotalAmount)</strong></div>
                                </div>
                                <div class="cart-actions">
                                    <input class="form-control form-control-sm" type="number" min="1" step="1" value="@line.Quantity" @onchange="args => UpdateQuantityAsync(line, args.Value?.ToString())" disabled="@(isCartBusy || !CanManageCart)" />
                                    <button class="btn btn-sm btn-outline-danger" title="@Text("Remove", "حذف")" @onclick="() => RemoveLineAsync(line)" disabled="@(isCartBusy || !CanManageCart)">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="cart-total">
                        <span>@Text("Subtotal", "المجموع")</span>
                        <strong>@Money(cart.Subtotal)</strong>
                    </div>
                    <div class="cart-total">
                        <span>@Text("Tax", "الضريبة")</span>
                        <strong>@Money(cart.TaxAmount)</strong>
                    </div>
                    <div class="cart-total cart-grand-total">
                        <span>@Text("Total", "الإجمالي")</span>
                        <strong>@Money(cart.TotalAmount)</strong>
                    </div>

                    <hr />

                    <div class="mb-2">
                        <label class="form-label">@Text("Payment method", "طريقة الدفع")</label>
                        <select class="form-select" @bind="paymentMethod">
                            @foreach (var method in Enum.GetValues<PaymentMethodType>())
                            {
                                <option value="@method">@method</option>
                            }
                        </select>
                    </div>
                    <div class="mb-2">
                        <label class="form-label">@Text("Payment reference", "مرجع الدفع")</label>
                        <input class="form-control" @bind="paymentReference" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">@Text("Notes", "ملاحظات")</label>
                        <textarea class="form-control" rows="2" @bind="paymentNotes"></textarea>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-primary flex-grow-1" @onclick="CheckoutAsync" disabled="@(isCartBusy || !CanCheckoutCart)">
                            <i class="bi bi-check2-circle"></i> @Text("Checkout", "إتمام الطلب")
                        </button>
                        <button class="btn btn-outline-secondary" @onclick="ClearCartAsync" disabled="@(isCartBusy || !CanManageCart)">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                }
            </AppCard>
        </div>
    </div>
</section>

@code {
    private bool CanView;
    private bool isLoading;
    private bool isCartBusy;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private Guid? defaultPosCustomerId;
    private string? userId;
    private string searchText = string.Empty;
    private Guid? selectedCategoryId;
    private Guid? selectedBrandId;
    private PaymentMethodType paymentMethod = PaymentMethodType.Cash;
    private string? paymentReference;
    private string? paymentNotes;
    private CartDto? cart;
    private CheckoutCartResultDto? checkoutResult;
    private List<ProductDto> products = [];
    private List<CategoryDto> categories = [];
    private List<BrandDto> brands = [];
    private HashSet<string> permissions = [];
    private bool CanManageCart => permissions.Contains(PermissionList.CartPermissions.Create) && permissions.Contains(PermissionList.CartPermissions.Edit);
    private bool CanCheckoutCart => permissions.Contains(PermissionList.CartPermissions.Checkout);

    private IEnumerable<ProductSkuDto> displaySkus => products
        .Where(product => !selectedCategoryId.HasValue || product.CategoryId == selectedCategoryId)
        .SelectMany(product => product.Skus)
        .Where(sku => (!selectedBrandId.HasValue || sku.BrandId == selectedBrandId) &&
                      (string.IsNullOrWhiteSpace(searchText) ||
                       (sku.NameEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (sku.Name?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (sku.SkuCode?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                       (sku.SkuCodeEng?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false)))
        .OrderBy(sku => Text(sku.NameEng, sku.Name));

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.View);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))

        {

            NavigationManager.NavigateTo("/Dashboard");

            return;

        }
        userId = authState.User.Claims.FirstOrDefault(c => c.Type.EndsWith("nameidentifier", StringComparison.OrdinalIgnoreCase))?.Value;

        if (CanView)
            await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;
        LoadingService.Show();
        try
        {
            var productTask = ProductService.GetPricedByCompanyAsync(companyId, null, 0, 1000);
            var categoryTask = CategoryService.GetByCompanyIdAsync(companyId, 0, 1000);
            var brandTask = BrandService.GetByCompanyIdAsync(companyId, 0, 1000);
            var settingTask = CompanySettingService.GetAsync(companyId);
            var currencyTask = CurrencyService.GetAsync(companyId, 0, 1000);
            await Task.WhenAll(productTask, categoryTask, brandTask, settingTask, currencyTask);

            products = productTask.Result.IsSuccess ? productTask.Result.Data?.Data?.ToList() ?? [] : [];
            categories = categoryTask.Result.IsSuccess ? categoryTask.Result.Data?.Data?.ToList() ?? [] : [];
            brands = brandTask.Result.IsSuccess ? brandTask.Result.Data?.Data?.ToList() ?? [] : [];
            defaultPosCustomerId = settingTask.Result.IsSuccess ? settingTask.Result.Data?.DefaultPosCustomerId : null;
            var currencies = currencyTask.Result.IsSuccess ? currencyTask.Result.Data?.Data?.ToList() ?? [] : [];
            currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
        }
        finally
        {
            LoadingService.Hide();
            isLoading = false;
        }
    }

    private Task ApplyFilters() => InvokeAsync(StateHasChanged);

    private async Task AddToCartAsync(ProductSkuDto sku)
    {
        if (!CanView || !CanManageCart)
            return;

        checkoutResult = null;
        isCartBusy = true;
        try
        {
            await EnsureCartAsync();
            if (cart is null)
                return;

            var existing = cart.Lines.FirstOrDefault(x => x.ProductSkuId == sku.Id);
            ApiResult<bool> result;
            if (existing is not null)
            {
                result = await CartService.UpdateLineAsync(cart.Id, existing.Id, existing.Quantity + 1);
            }
            else
            {
                result = await CartService.AddLineAsync(cart.Id, new CartLineDto
                {
                    ProductId = sku.ProductId,
                    ProductSkuId = sku.Id,
                    ProductName = sku.Name,
                    ProductNameEng = sku.NameEng,
                    SkuCode = sku.SkuCode,
                    UnitOfMeasureId = sku.UnitId ?? Guid.Empty,
                    Quantity = 1,
                    UnitPrice = sku.Price,
                    DiscountRate = sku.DiscountRate,
                    TaxRate = sku.TaxRate
                });
            }

            if (result.IsSuccess)
            {
                await RefreshCartAsync();
                ToastService.ShowSuccess(Text("Item added to cart.", "تمت إضافة الصنف للسلة."));
            }
            else
            {
                ToastService.ShowError(result.Error?.Detail ?? Text("Unable to update cart.", "تعذر تحديث السلة."));
            }
        }
        finally
        {
            isCartBusy = false;
        }
    }

    private async Task EnsureCartAsync()
    {
        if (cart is not null)
            return;

        if (!defaultPosCustomerId.HasValue)
        {
            ToastService.ShowError(Text(
                "Default POS customer is not configured. Please configure it in System Settings.",
                "لم يتم ضبط عميل نقطة البيع الافتراضي. يرجى ضبطه من إعدادات النظام."));
            return;
        }

        var result = await CartService.CreateAsync(new CartDto
        {
            CompanyId = companyId,
            CustomerId = defaultPosCustomerId,
            UserId = userId,
            Source = OrderIntakeSource.Pos,
            Channel = "POS"
        });

        if (!result.IsSuccess || result.Data is null)
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to create cart.", "تعذر إنشاء السلة."));
            return;
        }

        var loaded = await CartService.GetByIdAsync(result.Data.Id);
        cart = loaded.IsSuccess ? loaded.Data : new CartDto
        {
            Id = result.Data.Id,
            CompanyId = companyId,
            CustomerId = defaultPosCustomerId,
            Source = OrderIntakeSource.Pos,
            Channel = "POS"
        };
    }

    private async Task RefreshCartAsync()
    {
        if (cart is null)
            return;

        var result = await CartService.GetByIdAsync(cart.Id);
        if (result.IsSuccess)
            cart = result.Data;
    }

    private async Task UpdateQuantityAsync(CartLineDto line, string? value)
    {
        if (!decimal.TryParse(value, out var quantity) || quantity <= 0 || cart is null)
            return;

        isCartBusy = true;
        var result = await CartService.UpdateLineAsync(cart.Id, line.Id, quantity);
        if (result.IsSuccess)
            await RefreshCartAsync();
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to update quantity.", "تعذر تحديث الكمية."));
        isCartBusy = false;
    }

    private async Task RemoveLineAsync(CartLineDto line)
    {
        if (cart is null)
            return;

        isCartBusy = true;
        var result = await CartService.RemoveLineAsync(cart.Id, line.Id);
        if (result.IsSuccess)
            await RefreshCartAsync();
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to remove item.", "تعذر حذف الصنف."));
        isCartBusy = false;
    }

    private async Task ClearCartAsync()
    {
        if (cart is null)
            return;

        isCartBusy = true;
        var result = await CartService.ClearAsync(cart.Id);
        if (result.IsSuccess)
            await RefreshCartAsync();
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to clear cart.", "تعذر تفريغ السلة."));
        isCartBusy = false;
    }

    private async Task CheckoutAsync()
    {
        if (cart is null || !cart.Lines.Any())
            return;

        if (!cart.CustomerId.HasValue)
        {
            ToastService.ShowError(Text(
                "Default POS customer is not configured. Please configure it in System Settings.",
                "لم يتم ضبط عميل نقطة البيع الافتراضي. يرجى ضبطه من إعدادات النظام."));
            return;
        }

        isCartBusy = true;
        var result = await CartService.CheckoutAsync(cart.Id, paymentMethod, paymentReference, paymentNotes);
        if (result.IsSuccess)
        {
            checkoutResult = result.Data;
            cart = null;
            paymentReference = null;
            paymentNotes = null;
            ToastService.ShowSuccess(Text("Checkout completed.", "تم إكمال الطلب."));
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to checkout cart.", "تعذر إتمام الطلب."));
        }
        isCartBusy = false;
    }

    private string ImageUrl(ProductSkuDto sku) =>
        string.IsNullOrWhiteSpace(sku.ImageUrl)
            ? "_content/AlAfkarERP.Shared/images/productPlaceHolder.jpg"
            : sku.ImageUrl.Contains("data:", StringComparison.OrdinalIgnoreCase)
                ? sku.ImageUrl
                : $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}";

    private string Money(decimal amount) => string.IsNullOrWhiteSpace(currencyCode) ? $"{amount:N2}" : $"{amount:N2} {currencyCode}";

    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .pos-page .sku-card {
        border-radius: var(--erp-radius-lg);
        transition: transform .15s ease, box-shadow .15s ease;
    }

    .pos-page .sku-card:hover {
        box-shadow: var(--erp-shadow-md);
        transform: translateY(-2px);
    }

    .sku-image-container {
        align-items: center;
        aspect-ratio: 4 / 3;
        background: var(--erp-surface-muted);
        display: flex;
        justify-content: center;
        overflow: hidden;
        border-start-start-radius: var(--erp-radius-lg);
        border-start-end-radius: var(--erp-radius-lg);
    }

    .sku-image {
        height: 100%;
        object-fit: contain;
        padding: var(--erp-space-3);
        width: 100%;
    }

    .cart-lines {
        display: grid;
        gap: var(--erp-space-3);
    }

    .cart-line {
        align-items: flex-start;
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-md);
        display: flex;
        gap: var(--erp-space-3);
        padding: var(--erp-space-3);
    }

    .cart-actions {
        display: grid;
        gap: var(--erp-space-2);
        width: 96px;
    }

    .cart-total {
        align-items: center;
        border-top: 1px solid var(--erp-border);
        display: flex;
        justify-content: space-between;
        padding-block: var(--erp-space-2);
    }

    .cart-grand-total {
        font-size: 1.1rem;
    }
</style>
