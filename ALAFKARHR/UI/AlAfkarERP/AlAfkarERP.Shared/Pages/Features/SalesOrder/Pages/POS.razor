@layout AdminLayout
@page "/SalesOrder/POS"
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions



@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IBrandService BrandService
@inject IVariantService VariantService
@inject IUnitService UnitService

@inject ApiConfig ApiConfig
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<!-- POS -->
<h5 class="text-black">@SharedDataService.SelectViewLang("POS", "نقطة بيع")</h5>
<PageTitle>POS Catalog</PageTitle>

<div class="container-fluid py-3">
    <!-- FILTER BAR -->
    <div class="card shadow-sm border-0 rounded-4 mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">@SharedDataService.SelectViewLang("Search", "بحث")</label>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search products...", "ابحث عن المنتجات...")"
                           @bind="SearchText" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">@SharedDataService.SelectViewLang("Category", "الفئة")</label>
                    <select class="form-select" @bind="SelectedCategoryId">
                        <option value="">@SharedDataService.SelectViewLang("All Categories", "جميع الفئات")</option>

                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id">
                                @SharedDataService.SelectViewLang(category.NameEng, category.Name)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">@SharedDataService.SelectViewLang("Brand", "العلامة التجارية")</label>
                    <select class="form-select" @bind="SelectedBrandId">
                        <option value="">@SharedDataService.SelectViewLang("All Brands", "جميع العلامات التجارية")</option>

                        @foreach (var brand in Brands)
                        {
                            <option value="@brand.Id">
                                @SharedDataService.SelectViewLang(brand.NameEng, brand.Name)
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary"
                            @onclick="ApplyFilters">
                        @SharedDataService.SelectViewLang("Filter", "تصفية")
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- PRODUCTS AS PILLS -->
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body">

            <div class="d-flex flex-wrap gap-2">

                @foreach (var product in FilteredProducts)
                {
                    var isSelected = SelectedProduct?.Id == product.Id;

                    <button class="btn @(isSelected
                                                                                ? "btn-primary"
                                                                                : "btn-outline-primary") rounded-pill px-4"
                            @onclick="() => SelectProduct(product)">

                        @SharedDataService.SelectViewLang(product.NameEng, product.Name)

                        <span class="badge bg-light text-dark ms-2">
                            @product.Skus.Count
                        </span>

                    </button>
                }

            </div>

        </div>
    </div>

    @if (SelectedProduct is not null)
    {
        <!-- PRODUCT HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-3">

            <div>
                <h4 class="fw-bold mb-1">
                    @SharedDataService.SelectViewLang(SelectedProduct.NameEng, SelectedProduct.Name)
                </h4>

                <div class="text-muted">
                    @SharedDataService.SelectViewLang(SelectedProduct?.CategoryNameEng??"", SelectedProduct?.CategoryName??"")
                </div>
            </div>

        </div>

        <!-- BRAND FILTER -->
        @if (AvailableBrands.Any())
        {
            <div class="mb-4">

                <div class="fw-bold mb-2">
                    @SharedDataService.SelectViewLang("Brand", "العلامة التجارية")
                </div>

                <div class="d-flex flex-wrap gap-2">

                    <button class="btn @(SelectedBrandForSkuId == null
                                                                                ? "btn-dark"
                                                                                : "btn-outline-dark") rounded-pill"
                            @onclick="() => SelectBrand(null)">
                        @SharedDataService.SelectViewLang("All", "الكل")
                    </button>

                    @foreach (var brand in AvailableBrands)
                    {
                        var isSelected = SelectedBrandForSkuId == brand.Id;

                        <button class="btn @(isSelected
                                                                                            ? "btn-primary"
                                                                                            : "btn-outline-primary") rounded-pill"
                                @onclick="() => SelectBrand(brand.Id)">
                            @SharedDataService.SelectViewLang(brand.NameEng, brand.Name)
                        </button>
                    }

                </div>

            </div>
        }

        <!-- SKU CARDS -->
        <div class="row g-3">

            @foreach (var sku in SelectedProduct?.Skus?
                .Where(x =>
                    !SelectedBrandForSkuId.HasValue
                    || x.BrandId == SelectedBrandForSkuId))
            {
                <div class="col-xl-3 col-lg-4 col-md-6">

                    <div class="card h-100 border-0 shadow-sm rounded-4 sku-card">

                        <div class="sku-image-container">
                            <img src="@(string.IsNullOrEmpty(sku?.ImageUrl)? 
                                            "_content/AlAfkarERP.Shared/images/productPlaceHolder.jpg": 
                                            (sku.ImageUrl.Contains("data:")? 
                                                sku.ImageUrl: 
                                                $"{ApiConfig.BaseURL}/Images/Products/{sku.ImageUrl}"))"
                                 class="sku-image" />
                        </div>

                        <div class="card-body d-flex flex-column">

                            <div class="flex-grow-1">

                                <div class="d-flex justify-content-between mb-2">

                                    <span class="badge bg-primary">
                                        @SharedDataService.SelectViewLang(sku?.BrandNameEng??"", sku?.BrandName??"")
                                    </span>

                                    <span class="fw-bold text-success">
                                        @(sku?.Price??0) SAR
                                    </span>

                                </div>

                                <h5 class="fw-bold mb-1">
                                    @SharedDataService.SelectViewLang(sku?.NameEng??"", sku?.Name??"")
                                </h5>

                                <div class="text-muted small mb-2">
                                    @SharedDataService.SelectViewLang(sku?.SkuCodeEng??"", sku?.SkuCode??"")
                                </div>

                                <div class="small mb-3">

                                    @foreach (var variant in sku?.Variants)
                                    {
                                        var variantName = SharedDataService.SelectViewLang(
                                            Variants.FirstOrDefault(v => v.Id == variant.VariantId)?.NameEng??"",
                                            Variants.FirstOrDefault(v => v.Id == variant.VariantId)?.Name??""
                                        );

                                        var variantValue = SharedDataService.SelectViewLang(
                                            Variants.FirstOrDefault(v => v.Id == variant.VariantId)?
                                            .Values?
                                            .FirstOrDefault(v => v.Id == variant.VariantValueId)?
                                            .ValueEng??"",
                                            Variants.FirstOrDefault(v => v.Id == variant.VariantId)?
                                            .Values?
                                            .FirstOrDefault(v => v.Id == variant.VariantValueId)?
                                            .Value??""
                                        );

                                        <span class="badge bg-light text-dark me-1 mb-1">
                                            @variantName: @variantValue
                                        </span>
                                    }

                                </div>

                            </div>

                            <div class="d-grid mt-auto">
                                <button class="btn btn-success rounded-3">
                                    @SharedDataService.SelectViewLang("Add To Cart", "إضافة إلى السلة")
                                </button>
                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }
</div>

<style>

    body {
        background: #f5f7fb;
    }

    .product-card {
        cursor: pointer;
        transition: all .2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
        }

    .sku-card {
        transition: all .2s ease;
    }

        .sku-card:hover {
            transform: translateY(-4px);
        }

    .sku-image-container {
        width: 100%;
        height: 240px;
        overflow: hidden;
        border-top-left-radius: 1rem;
        border-top-right-radius: 1rem;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sku-image {
        width: 100%;
        height: 100%;
        object-fit: contain;
        padding: 12px;
    }
</style>


@code {




    private string SearchText = string.Empty;

    private Guid? SelectedCategoryId;

    private Guid? SelectedBrandId;
    private Guid? SelectedBrandForSkuId;

    private ProductDto? SelectedProduct;

    private ProductSkuDto? MatchedSku;


    private Dictionary<Guid, Guid> SelectedVariantValues = new();

    // MOCK DATA

    private List<BrandDto> Brands = new();
    private List<BrandDto> AvailableBrands = new();
    private List<CategoryDto> Categories = new();
    private List<VariantDto> Variants = new();
    private List<VariantDto> AvailableVariants = new();
    private List<ProductDto> Products = new();
    private List<UnitDto> Units = new();


    private List<ProductDto> FilteredProducts => Products
            .Where(x =>
                (string.IsNullOrWhiteSpace(SearchText)
                    || x.NameEng.Contains(SearchText, StringComparison.OrdinalIgnoreCase))

                && (!SelectedCategoryId.HasValue
                    || x.CategoryId == SelectedCategoryId)

                && (!SelectedBrandId.HasValue
                    || x.Skus.Any(s => s.BrandId == SelectedBrandId))
            )
            .ToList();






    AuthenticationState AuthState;
    Guid companyId;
    private List<ProductDto> products = [];
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState!.User!.Identity!.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);
        // LoadingService.Show();
        // var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        // if (prodRes.IsSuccess)
        // {
        //     products = prodRes.Data?.Data?.ToList() ?? [];
        // }
        // LoadingService.Hide();
        await LoadData();
    }

    private void SelectBrand(Guid? brandId)
    {
        SelectedBrandForSkuId = brandId;

        SelectedVariantValues.Clear();

        MatchedSku = null;
    }

    private async Task LoadData()
    {
        LoadingService.Show();
        var brandTask = BrandService.GetByCompanyIdAsync(companyId, 0, 100);
        var categoryTask = CategoryService.GetByCompanyIdAsync(companyId, 0, 100);
        var productTask = ProductService.GetByCompanyAsync(companyId, 0, 100);
        var variantTask = VariantService.GetByCompanyAsync(companyId, 0, 100);

        var unitTask = UnitService.GetByCompanyAsync(companyId, 0, 1000);
        await Task.WhenAll(brandTask, categoryTask, productTask, variantTask, unitTask);

        if (brandTask.Result.IsSuccess)
            Brands = brandTask.Result.Data?.Data?.ToList() ?? [];
        if (categoryTask.Result.IsSuccess)
            Categories = categoryTask.Result.Data?.Data?.ToList() ?? [];
        if (productTask.Result.IsSuccess)
            Products = productTask.Result.Data?.Data?.ToList() ?? [];
        if (variantTask.Result.IsSuccess)
            Variants = variantTask.Result.Data?.Data?.ToList() ?? [];
        if (unitTask.Result.IsSuccess)
            Units = unitTask.Result.Data?.Data?.ToList() ?? [];

        AvailableBrands = Products.SelectMany(p => p.Skus)
        .GroupBy(x => x.BrandId)
        .Select(g => new BrandDto
        {
            Id = g.Key,
            NameEng = g.FirstOrDefault()?.BrandNameEng??"",
            Name = g.FirstOrDefault()?.BrandName??""
        })
        .ToList();
        LoadingService.Hide();
    }


    private async Task ApplyFilters()
    {
        // if selected product is no longer visible after filtering
        if (SelectedProduct is not null &&
            !FilteredProducts.Any(p => p.Id == SelectedProduct.Id))
        {
            SelectedProduct = null;
            return;
        }

        // refresh selected product from filtered list
        if (SelectedProduct is not null)
        {
            SelectedProduct = FilteredProducts
                .FirstOrDefault(p => p.Id == SelectedProduct.Id);
        }

        await InvokeAsync(StateHasChanged);
    }


    private void SelectProduct(ProductDto product)
    {
        SelectedProduct = product;
        MatchedSku = null;

        SelectedBrandForSkuId = null;

        SelectedVariantValues.Clear();

        BuildBrands(product);

        BuildVariants(product);
    }

    private void BuildBrands(ProductDto product)
    {
        var brandIds = product.Skus
            .Select(x => x.BrandId)
            .Distinct()
            .ToList();

        AvailableBrands = Brands
            .Where(x => brandIds.Contains(x.Id))
            .ToList();
    }

    private void ClosePanel()
    {
        SelectedProduct = null;
    }

    private void BuildVariants(ProductDto product)
    {
        AvailableVariants.Clear();

        // all variant ids used by this product
        var variantIds = product.Skus
            .SelectMany(x => x.Variants)
            .Select(x => x.VariantId)
            .Distinct()
            .ToList();

        foreach (var variantId in variantIds)
        {
            // find variant from master list
            var masterVariant = Variants
                .FirstOrDefault(x => x.Id == variantId);

            if (masterVariant is null)
                continue;

            // collect only values used by this product
            var usedValueIds = product.Skus
                .SelectMany(x => x.Variants)
                .Where(x => x.VariantId == variantId)
                .Select(x => x.VariantValueId)
                .Distinct()
                .ToList();

            var variant = new VariantDto
            {
                Id = masterVariant.Id,
                Name = masterVariant.Name,
                NameEng = masterVariant.NameEng,
                CompanyId = masterVariant.CompanyId,

                Values = masterVariant.Values
                    .Where(v => usedValueIds.Contains(v.Id))
                    .ToList()
            };

            AvailableVariants.Add(variant);
        }
    }


    private void SelectVariantValue(Guid variantId, Guid valueId)
    {
        SelectedVariantValues[variantId] = valueId;

        ResolveSku();
    }

    private void ResolveSku()
    {
        if (SelectedProduct is null)
            return;

        var selectedValueIds = SelectedVariantValues.Values.ToList();

        MatchedSku = SelectedProduct.Skus
            .Where(x => !SelectedBrandForSkuId.HasValue
                        || x.BrandId == SelectedBrandForSkuId)
            .FirstOrDefault(sku =>
                selectedValueIds.All(selected =>
                    sku.Variants.Any(v => v.VariantValueId == selected)));
    }

    private bool IsVariantValueAvailable(Guid variantId, Guid valueId)
    {
        if (SelectedProduct is null)
            return false;

        var tempSelections = new Dictionary<Guid, Guid>(SelectedVariantValues)
        {
            [variantId] = valueId
        };

        var selectedIds = tempSelections.Values.ToList();

        // return SelectedProduct.Skus.Any(sku =>
        //     selectedIds.All(id =>
        //         sku.Variants.Any(v => v.VariantValueId == id))

        
        // );

        return SelectedProduct.Skus
                .Where(x => !SelectedBrandForSkuId.HasValue
                            || x.BrandId == SelectedBrandForSkuId)
                .Any(sku =>
                    selectedIds.All(id =>
                        sku.Variants.Any(v => v.VariantValueId == id)));
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
