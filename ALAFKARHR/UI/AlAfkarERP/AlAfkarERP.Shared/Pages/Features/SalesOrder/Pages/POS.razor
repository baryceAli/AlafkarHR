    private List<ProductDto> products = [];
    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!AuthState.User.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);
        // LoadingService.Show();
        // var prodRes = await ProductService.GetByCompanyAsync(companyId, 0, 10000);
        // if (prodRes.IsSuccess)
        // {
        //     products = prodRes.Data?.Data?.ToList() ?? [];
        // }
        // LoadingService.Hide();
        await LoadData();
    }

    private void SelectBrand(Guid brandId)
    {
        SelectedBrandForSkuId = brandId;

        SelectedVariantValues.Clear();

        MatchedSku = null;
    }

    private async Task LoadData()
    {
        LoadingService.Show();
        var brandTask = BrandService.GetByCompanyIdAsync(companyId, 0, 100);
        var categoryTask = CategoryService.GetByCompanyIdAsync(companyId, 0, 100);
        var productTask = ProductService.GetByCompanyAsync(companyId, 0, 100);
        var variantTask = VariantService.GetByCompanyAsync(companyId, 0, 100);

        var unitTask = UnitService.GetByCompanyAsync(companyId, 0, 1000);
        await Task.WhenAll(brandTask, categoryTask, productTask, variantTask, unitTask);

        if (brandTask.Result.IsSuccess)
            Brands = brandTask.Result.Data?.Data?.ToList() ?? [];
        if (categoryTask.Result.IsSuccess)
            Categories = categoryTask.Result.Data?.Data?.ToList() ?? [];
        if (productTask.Result.IsSuccess)
            Products = productTask.Result.Data?.Data?.ToList() ?? [];
        if (variantTask.Result.IsSuccess)
            Variants = variantTask.Result.Data?.Data?.ToList() ?? [];
        if (unitTask.Result.IsSuccess)
            Units = unitTask.Result.Data?.Data?.ToList() ?? [];
    
        AvailableBrands = Products.SelectMany(p => p.Skus)
        .GroupBy(x => x.BrandId)
        .Select(g => new BrandDto
        {
            Id = g.Key,
            NameEng = g.First().BrandName
        })
        .ToList();
        LoadingService.Hide();
    }
    protected override void OnInitialized()
    {
        // SeedData();
    }

    private void ApplyFilters()
    {
    }


    private void SelectProduct(ProductDto product)
    {
        SelectedProduct = product;
        MatchedSku = null;

        SelectedBrandForSkuId = null;

        SelectedVariantValues.Clear();

        BuildBrands(product);

        BuildVariants(product);
    }

    private void BuildBrands(ProductDto product)
    {
        var brandIds = product.Skus
            .Select(x => x.BrandId)
            .Distinct()
            .ToList();

        AvailableBrands = Brands
            .Where(x => brandIds.Contains(x.Id))
            .ToList();
    }

    private void ClosePanel()
    {
        SelectedProduct = null;
    }

    private void BuildVariants(ProductDto product)
    {
        AvailableVariants.Clear();

        // all variant ids used by this product
        var variantIds = product.Skus
            .SelectMany(x => x.Variants)
            .Select(x => x.VariantId)
            .Distinct()
            .ToList();

        foreach (var variantId in variantIds)
        {
            // find variant from master list
            var masterVariant = Variants
                .FirstOrDefault(x => x.Id == variantId);

            if (masterVariant is null)
                continue;

            // collect only values used by this product
            var usedValueIds = product.Skus
                .SelectMany(x => x.Variants)
                .Where(x => x.VariantId == variantId)
                .Select(x => x.VariantValueId)
                .Distinct()
                .ToList();

            var variant = new VariantDto
            {
                Id = masterVariant.Id,
                Name = masterVariant.Name,
                NameEng = masterVariant.NameEng,
                CompanyId = masterVariant.CompanyId,

                Values = masterVariant.Values
                    .Where(v => usedValueIds.Contains(v.Id))
                    .ToList()
            };

            AvailableVariants.Add(variant);
        }
    }


    private void SelectVariantValue(Guid variantId, Guid valueId)
    {
        SelectedVariantValues[variantId] = valueId;

        ResolveSku();
    }

    private void ResolveSku()
    {
        if (SelectedProduct is null)
            return;

        var selectedValueIds = SelectedVariantValues.Values.ToList();

        MatchedSku = SelectedProduct.Skus
            .Where(x => !SelectedBrandForSkuId.HasValue
                        || x.BrandId == SelectedBrandForSkuId)
            .FirstOrDefault(sku =>
                selectedValueIds.All(selected =>
                    sku.Variants.Any(v => v.VariantValueId == selected)));
    }

    private bool IsVariantValueAvailable(Guid variantId, Guid valueId)
    {
        if (SelectedProduct is null)
            return false;

        var tempSelections = new Dictionary<Guid, Guid>(SelectedVariantValues)
        {
            [variantId] = valueId
        };

        var selectedIds = tempSelections.Values.ToList();

        // return SelectedProduct.Skus.Any(sku =>
        //     selectedIds.All(id =>
        //         sku.Variants.Any(v => v.VariantValueId == id))

        
        // );

        return SelectedProduct.Skus
                .Where(x => !SelectedBrandForSkuId.HasValue
                            || x.BrandId == SelectedBrandForSkuId)
                .Any(sku =>
                    selectedIds.All(id =>
                        sku.Variants.Any(v => v.VariantValueId == id)));
    }

