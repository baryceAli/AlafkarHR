@layout AdminLayout
@page "/SalesOrder/POS"
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Permissions



@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider

@inject IProductService ProductService
@inject ICategoryService CategoryService
@inject IBrandService BrandService
@inject IVariantService VariantService
@inject IUnitService UnitService

@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.VariantPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<!-- Branches -->
<h5 class="text-black">@SharedDataService.SelectViewLang("POS", "نقطة بيع")</h5>
<PageTitle>POS Catalog</PageTitle>

<div class="container-fluid py-3">
    <!-- FILTER BAR -->
    <div class="card shadow-sm border-0 rounded-4 mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">

                <div class="col-md-4">
                    <label class="form-label fw-semibold">Search</label>
                    <input class="form-control"
                           placeholder="Search products..."
                           @bind="SearchText" />
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select class="form-select" @bind="SelectedCategoryId">
                        <option value="">All Categories</option>

                        @foreach (var category in Categories)
                        {
                            <option value="@category.Id">
                                @category.NameEng
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-semibold">Brand</label>
                    <select class="form-select" @bind="SelectedBrandId">
                        <option value="">All Brands</option>

                        @foreach (var brand in Brands)
                        {
                            <option value="@brand.Id">
                                @brand.NameEng
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary"
                            @onclick="ApplyFilters">
                        Filter
                    </button>
                </div>

            </div>
        </div>
    </div>

    <!-- PRODUCT GRID -->
    <div class="row g-4">

        @foreach (var product in FilteredProducts)
        {
            <div class="col-xl-3 col-lg-4 col-md-6">

                <div class="card h-100 shadow-sm border-0 rounded-4 product-card"
                     @onclick="() => SelectProduct(product)">

                    @* <img src="https://placehold.co/600x400/png" *@
                    <img src="https://placehold.co/600x400/png"
                         class="card-img-top rounded-top-4"
                         style="height:220px; object-fit:cover;" />

                    <div class="card-body d-flex flex-column">

                        <h5 class="fw-bold mb-1">
                            @product.NameEng
                        </h5>

                        <div class="text-muted small mb-2">
                            @product.CategoryNameEng
                        </div>

                        <div class="mt-auto d-flex justify-content-between align-items-center">

                            <span class="badge bg-primary rounded-pill px-3 py-2">
                                @product.Skus.Count SKU(s)
                            </span>

                            <span class="fw-bold text-success">
                                @product.Skus.Min(x => x.Price) SAR
                            </span>

                        </div>

                    </div>
                </div>
            </div>
        }

    </div>



</div>

@if (SelectedProduct is not null)
{
    <div class="sku-panel-backdrop" @onclick="ClosePanel"></div>

    <div class="sku-panel shadow-lg">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1">
                    @SelectedProduct.NameEng
                </h3>

                <div class="text-muted">
                    Select Variants
                </div>
            </div>

            <button class="btn btn-light"
                    @onclick="ClosePanel">
                ✕
            </button>
        </div>

        <div class="mb-4 text-black">

            <div class="fw-bold mb-2 fs-5">
                Brand
            </div>

            <div class="d-flex flex-wrap gap-2 text-black">

                @foreach (var brand in AvailableBrands)
                {
                    var isSelected = SelectedBrandForSkuId == brand.Id;

                    <button class="btn @(isSelected ? "btn-primary" : "btn-outline-secondary") rounded-pill"
                            @onclick="() => SelectBrand(brand.Id)">
                        @brand.NameEng
                    </button>
                }

            </div>

        </div>

        <!-- VARIANT GROUPS -->
        @foreach (var variant in AvailableVariants)
        {
            <div class="mb-4 text-black">

                <div class="fw-bold mb-2 fs-5">
                    @variant.NameEng
                </div>

                <div class="d-flex flex-wrap gap-2">

                    @foreach (var value in variant.Values)
                    {
                        var isSelected = SelectedVariantValues.ContainsKey(variant.Id)
                                         && SelectedVariantValues[variant.Id] == value.Id;

                        var isDisabled = !IsVariantValueAvailable(variant.Id, value.Id);

                        <button class="btn @(isSelected ? "btn-primary" : "btn-outline-secondary") rounded-pill"
                                disabled="@isDisabled"
                                @onclick="() => SelectVariantValue(variant.Id, value.Id)">
                            @value.ValueEng
                        </button>
                    }

                </div>

            </div>
        }

        <!-- MATCHED SKU -->
        @if (MatchedSku is not null)
        {
            <div class="card border-0 bg-light rounded-4 mb-4">
                <div class="card-body">

                    <h5 class="fw-bold mb-3">
                        Selected SKU
                    </h5>

                    <div class="row g-3">

                        <div class="col-6">
                            <div class="text-muted small">Name</div>
                            <div class="fw-bold">@MatchedSku.Name</div>
                        </div>

                        <div class="col-6">
                            <div class="text-muted small">SKU</div>
                            <div class="fw-bold">@MatchedSku.SkuCodeEng</div>
                        </div>

                        <div class="col-6">
                            <div class="text-muted small">Barcode</div>
                            <div class="fw-bold">@MatchedSku.Barcode</div>
                        </div>

                        <div class="col-6">
                            <div class="text-muted small">Price</div>
                            <div class="fw-bold text-success">
                                @MatchedSku.Price SAR
                            </div>
                        </div>

                        <div class="col-6">
                            <div class="text-muted small">Selling Unit</div>
                            <div class="fw-bold">
                                @(Units.FirstOrDefault(u => u.Id == MatchedSku.UnitId)?.UnitName ?? "")
                            </div>
                        </div>

                    </div>

                </div>
            </div>

            <div class="d-grid">
                <button class="btn btn-success btn-lg rounded-4">
                    Add To Cart
                </button>
            </div>
        }
    </div>
}


<style>

    body {
        background: #f5f7fb;
    }

    .product-card {
        cursor: pointer;
        transition: all .2s ease;
    }

        .product-card:hover {
            transform: translateY(-4px);
        }

    .sku-panel-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,.3);
        z-index: 1000;
    }

    .sku-panel {
        position: fixed;
        top: 0;
        right: 0;
        width: 480px;
        max-width: 100%;
        height: 100vh;
        background: white;
        z-index: 1001;
        padding: 24px;
        overflow-y: auto;
    }

</style>


@code {




    private string SearchText = string.Empty;

