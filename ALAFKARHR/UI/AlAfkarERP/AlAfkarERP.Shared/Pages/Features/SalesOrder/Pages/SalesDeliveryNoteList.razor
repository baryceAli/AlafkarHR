@layout AdminLayout
@page "/Sales/DeliveryNotes"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.SalesOrder.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components
@using SharedWithUI.Permissions
@using SharedWithUI.SalesOrder.Dtos
@using SharedWithUI.SalesOrder.Enums

@inject ISalesService SalesService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<section class="sales-page erp-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "Ù„ÙŠØ³ Ù„Ø¯ÙŠÙƒ Ø§Ù„ØµÙ„Ø§Ø­ÙŠØ© Ù„Ø¹Ø±Ø¶ Ù‡Ø°Ù‡ Ø§Ù„ØµÙØ­Ø©")</div>
        return;
    }

    <PageHeader Title="@Text("Delivery Notes", "Ø¥Ø´Ø¹Ø§Ø±Ø§Øª Ø§Ù„ØªØ³Ù„ÙŠÙ…")"
                Subtitle="@Text("Post sales deliveries and track warehouse shipment documents.", "ØªØ±Ø­ÙŠÙ„ ØªØ³Ù„ÙŠÙ…Ø§Øª Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª ÙˆÙ…ØªØ§Ø¨Ø¹Ø© Ù…Ø³ØªÙ†Ø¯Ø§Øª Ø§Ù„Ø´Ø­Ù†.")"
                Overline="@Text("Sales", "Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª")"
                Icon="bi-truck" />

    <AppCard Title="@Text("Delivery Notes", "Ø¥Ø´Ø¹Ø§Ø±Ø§Øª Ø§Ù„ØªØ³Ù„ÙŠÙ…")">
        @if (HasSmartFilter)
        {
            <div class="erp-chip-row mb-3">
                <StatusChip Tone="info" Text="@SmartFilterText()" />
                <button class="btn btn-sm btn-outline-secondary" @onclick="ClearSmartFilter">
                    <i class="bi bi-x-lg"></i>
                    @Text("Clear", "Ù…Ø³Ø­")
                </button>
            </div>
        }

        @if (isLoading)
        {
            <div class="erp-loading py-4"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (!deliveryNotes.Any())
        {
            <EmptyState Title="@Text("No delivery notes", "Ù„Ø§ ØªÙˆØ¬Ø¯ Ø¥Ø´Ø¹Ø§Ø±Ø§Øª ØªØ³Ù„ÙŠÙ…")"
                        Message="@Text("Delivery notes created from sales orders will appear here.", "Ø³ØªØ¸Ù‡Ø± Ø¥Ø´Ø¹Ø§Ø±Ø§Øª Ø§Ù„ØªØ³Ù„ÙŠÙ… Ø§Ù„Ù…Ù†Ø´Ø£Ø© Ù…Ù† Ø£ÙˆØ§Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹ Ù‡Ù†Ø§.")"
