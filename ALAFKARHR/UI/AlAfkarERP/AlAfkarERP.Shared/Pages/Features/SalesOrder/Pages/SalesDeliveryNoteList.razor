                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </AppCard>
</section>

@code {
    private bool CanView;
    private bool CanPost;
    private bool CanCancel;
    private bool isLoading;
    private Guid companyId;
    private List<SalesDeliveryNoteDto> deliveryNotes = [];

    [SupplyParameterFromQuery] public Guid? CustomerId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductSkuId { get; set; }
    private bool HasSmartFilter => CustomerId.HasValue || ProductId.HasValue || ProductSkuId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = permissions.Contains(PermissionList.SalesDeliveryNotePermissions.View);
        CanPost = permissions.Contains(PermissionList.SalesDeliveryNotePermissions.Post);
        CanCancel = permissions.Contains(PermissionList.SalesDeliveryNotePermissions.Cancel);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetDeliveryNotesByCompanyAsync(companyId, 0, 50, CustomerId, ProductId, ProductSkuId);
        deliveryNotes = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        isLoading = false;
    }

    private async Task PostAsync(Guid id)
    {
        var result = await SalesService.PostDeliveryNoteAsync(id);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Delivery note posted.", "ØªÙ… ØªØ±Ø­ÙŠÙ„ Ø¥Ø´Ø¹Ø§Ø± Ø§Ù„ØªØ³Ù„ÙŠÙ…."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to post delivery note.", "ØªØ¹Ø°Ø± ØªØ±Ø­ÙŠÙ„ Ø¥Ø´Ø¹Ø§Ø± Ø§Ù„ØªØ³Ù„ÙŠÙ…."));
        }
    }

    private async Task CancelAsync(Guid id)
    {
        var result = await SalesService.CancelDeliveryNoteAsync(id);
        if (result.IsSuccess)
            await LoadAsync();
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to cancel delivery note.", "ØªØ¹Ø°Ø± Ø¥Ù„ØºØ§Ø¡ Ø¥Ø´Ø¹Ø§Ø± Ø§Ù„ØªØ³Ù„ÙŠÙ…."));
    }

    private static string StatusTone(SalesDeliveryNoteStatus status) => status switch
    {
        SalesDeliveryNoteStatus.Delivered or SalesDeliveryNoteStatus.PartiallyDelivered => "success",
        SalesDeliveryNoteStatus.Submitted => "primary",
        SalesDeliveryNoteStatus.Cancelled => "danger",
        _ => "muted"
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string SmartFilterText()
    {
        if (CustomerId.HasValue)
            return Text("Filtered by customer", "Ù…ØµÙÙŠ Ø­Ø³Ø¨ Ø§Ù„Ø¹Ù…ÙŠÙ„");
        if (ProductSkuId.HasValue)
            return Text("Filtered by SKU", "Ù…ØµÙÙŠ Ø­Ø³Ø¨ ÙˆØ­Ø¯Ø© Ø§Ù„Ù…Ù†ØªØ¬");
        return Text("Filtered by product", "Ù…ØµÙÙŠ Ø­Ø³Ø¨ Ø§Ù„Ù…Ù†ØªØ¬");
    }

    private void ClearSmartFilter() => NavigationManager.NavigateTo("/Sales/DeliveryNotes");
    private static string OperationLink(Guid sourceDocumentId) =>
        $"/Inventory/Operations/Execution?sourceDocumentType=SalesDeliveryNote&sourceDocumentId={sourceDocumentId}";
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
