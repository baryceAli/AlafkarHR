                            <th>@Text("Status", "Ø§Ù„Ø­Ø§Ù„Ø©")</th>
                            <th>@Text("Delivery date", "ØªØ§Ø±ÙŠØ® Ø§Ù„ØªØ³Ù„ÙŠÙ…")</th>
                            <th>@Text("Lines", "Ø§Ù„Ø£ØµÙ†Ø§Ù")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var note in deliveryNotes)
                        {
                            <tr>
                                <td class="fw-semibold">@note.Number</td>
                                <td>@(note.SalesOrderNumber ?? note.SalesOrderId.ToString())</td>
                                <td><StatusChip Text="@note.Status.ToString()" Tone="@StatusTone(note.Status)" /></td>
                                <td>@note.DeliveryDate.ToString("yyyy-MM-dd")</td>
                                <td>@note.Lines.Count</td>
                          <td class="text-end">
                              <a class="btn btn-sm btn-outline-secondary" href="@OperationLink(note.Id)">
                                  <i class="bi bi-list-check"></i>
                              </a>
                              @if (note.Status == SalesDeliveryNoteStatus.Draft && CanPost)
                              {
                                        <button class="btn btn-sm btn-primary" @onclick="() => PostAsync(note.Id)">
                                            <i class="bi bi-check2-circle"></i> @Text("Post", "ØªØ±Ø­ÙŠÙ„")
                                        </button>
                                    }
                                    @if (note.Status == SalesDeliveryNoteStatus.Draft && CanCancel)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => CancelAsync(note.Id)">
                                            <i class="bi bi-x-circle"></i>
