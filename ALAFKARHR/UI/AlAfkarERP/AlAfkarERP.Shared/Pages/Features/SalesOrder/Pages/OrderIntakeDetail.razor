@code {
    [Parameter] public Guid Id { get; set; }

    private bool CanView;
    private bool CanAccept;
    private bool CanReject;
    private bool isLoading;
    private bool isSaving;
    private string rejectReason = string.Empty;
    private string currencyCode = string.Empty;
    private OrderIntakeDto? order;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = permissions.Contains(PermissionList.OrderIntakePermissions.View);
        CanAccept = permissions.Contains(PermissionList.OrderIntakePermissions.Accept);
        CanReject = permissions.Contains(PermissionList.OrderIntakePermissions.Reject);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await OrderIntakeService.GetByIdAsync(Id);
        order = result.IsSuccess ? result.Data : null;
        if (order is not null)
            await LoadCurrencyAsync(order.CompanyId);
        isLoading = false;
    }

    private async Task LoadCurrencyAsync(Guid companyId)
    {
        var result = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencies = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task AcceptAsync()
    {
        isSaving = true;
        var result = await OrderIntakeService.AcceptAsync(Id);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Order intake accepted.", "ØªÙ… Ù‚Ø¨ÙˆÙ„ Ø§Ù„Ø·Ù„Ø¨."));
            if (result.Data?.SalesOrderId != Guid.Empty)
                NavigationManager.NavigateTo($"/Sales/Orders/{result.Data!.SalesOrderId}");
            else
                await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to accept intake.", "ØªØ¹Ø°Ø± Ù‚Ø¨ÙˆÙ„ Ø§Ù„Ø·Ù„Ø¨."));
        }
        isSaving = false;
    }

    private async Task RejectAsync()
    {
        if (string.IsNullOrWhiteSpace(rejectReason))
        {
            ToastService.ShowWarning(Text("Enter a rejection reason.", "Ø£Ø¯Ø®Ù„ Ø³Ø¨Ø¨ Ø§Ù„Ø±ÙØ¶."));
            return;
        }

        isSaving = true;
        var result = await OrderIntakeService.RejectAsync(Id, rejectReason);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Order intake rejected.", "ØªÙ… Ø±ÙØ¶ Ø§Ù„Ø·Ù„Ø¨."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to reject intake.", "ØªØ¹Ø°Ø± Ø±ÙØ¶ Ø§Ù„Ø·Ù„Ø¨."));
        }
        isSaving = false;
    }

    private string StatusText(OrderIntakeStatus status) => status switch
    {
        OrderIntakeStatus.Submitted => Text("Submitted", "Ù…Ø±Ø³Ù„"),
        OrderIntakeStatus.Validated => Text("Validated", "ØªÙ… Ø§Ù„ØªØ­Ù‚Ù‚"),
        OrderIntakeStatus.Rejected => Text("Rejected", "Ù…Ø±ÙÙˆØ¶"),
        OrderIntakeStatus.Accepted => Text("Accepted", "Ù…Ù‚Ø¨ÙˆÙ„"),
        OrderIntakeStatus.ConvertedToSales => Text("Converted", "Ù…Ø­ÙˆÙ„ Ù„Ù„Ø¨ÙŠØ¹"),
        OrderIntakeStatus.Cancelled => Text("Cancelled", "Ù…Ù„ØºÙŠ"),
        _ => Text("Draft", "Ù…Ø³ÙˆØ¯Ø©")
    };

    private string DateText(DateTime? value) => value?.ToString("yyyy-MM-dd HH:mm") ?? "-";
    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

