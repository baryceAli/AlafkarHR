    }
    else
    {
        <EditForm Model="order" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-xl-8">
                    <AppCard Title="@Text("Order Details", "ØªÙØ§ØµÙŠÙ„ Ø§Ù„Ø£Ù…Ø±")" CssClass="mb-3">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">@Text("Order number", "Ø±Ù‚Ù… Ø§Ù„Ø£Ù…Ø±")</label>
                                <input class="form-control" @bind="order.Number" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@Text("Order date", "ØªØ§Ø±ÙŠØ® Ø§Ù„Ø£Ù…Ø±")</label>
                                <InputDate class="form-control" @bind-Value="order.OrderDate" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">@Text("Delivery date", "ØªØ§Ø±ÙŠØ® Ø§Ù„ØªØ³Ù„ÙŠÙ…")</label>
                                <InputDate class="form-control" @bind-Value="order.DeliveryDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Customer", "Ø§Ù„Ø¹Ù…ÙŠÙ„")</label>
                                <select class="form-select" @onchange="OnCustomerChanged">
                                    <option value="">@Text("Select customer", "Ø§Ø®ØªØ± Ø§Ù„Ø¹Ù…ÙŠÙ„")</option>
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id" selected="@(customer.Id == order.CustomerId)">@customer.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Customer purchase order", "Ø£Ù…Ø± Ø´Ø±Ø§Ø¡ Ø§Ù„Ø¹Ù…ÙŠÙ„")</label>
                                <input class="form-control" @bind="order.CustomerPurchaseOrderNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Notes", "Ù…Ù„Ø§Ø­Ø¸Ø§Øª")</label>
                                <textarea class="form-control" rows="3" @bind="order.Notes"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@Text("Terms", "Ø§Ù„Ø´Ø±ÙˆØ·")</label>
                                <textarea class="form-control" rows="3" @bind="order.Terms"></textarea>
                            </div>
                        </div>
                    </AppCard>

                    <AppCard Title="@Text("Order Lines", "Ø£ØµÙ†Ø§Ù Ø§Ù„Ø£Ù…Ø±")">
                        <div class="d-flex justify-content-end mb-2">
                            <button class="btn btn-outline-primary btn-sm" type="button" @onclick="AddLine">
                                <i class="bi bi-plus-lg"></i> @Text("Add line", "Ø¥Ø¶Ø§ÙØ© ØµÙ†Ù")
                            </button>
                        </div>

                        <div class="erp-table-wrap">
                            <table class="table erp-table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>@Text("SKU", "Ø§Ù„Ø±Ù…Ø²")</th>
                                        <th>@Text("Qty", "Ø§Ù„ÙƒÙ…ÙŠØ©")</th>
                                        <th>@Text("Unit price", "Ø³Ø¹Ø± Ø§Ù„ÙˆØ­Ø¯Ø©")</th>
                                        <th>@Text("Discount", "Ø§Ù„Ø®ØµÙ…")</th>
                                        <th>@Text("Tax", "Ø§Ù„Ø¶Ø±ÙŠØ¨Ø©")</th>
                                        <th>@Text("Total", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ")</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in order.Lines)
                                    {
                                        <tr>
                                            <td>
                                                <select class="form-select form-select-sm" @onchange="e => SelectSku(line, e.Value?.ToString())">
                                                    <option value="">@Text("Select SKU", "Ø§Ø®ØªØ± Ø§Ù„Ø±Ù…Ø²")</option>
                                                    @foreach (var sku in skus)
                                                    {
                                                        <option value="@sku.Id" selected="@(sku.Id == line.ProductSkuId)">@Text(sku.NameEng, sku.Name) - @sku.SkuCode</option>
                                                    }
                                                </select>
                                                @if (!string.IsNullOrWhiteSpace(line.ProductName))
                                                {
                                                    <div class="text-muted small mt-1">@Text(line.ProductNameEng, line.ProductName)</div>
                                                }
                                            </td>
                                            <td><input class="form-control form-control-sm" type="number" min="0.01" step="0.01" @bind="line.Quantity" @bind:after="Recalculate" /></td>
                                            <td>@Money(line.UnitPrice)</td>
                                            <td>@($"{line.DiscountRate:N2}%")</td>
