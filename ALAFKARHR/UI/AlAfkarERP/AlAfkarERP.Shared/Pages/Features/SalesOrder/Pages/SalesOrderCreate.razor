                                            <td class="fw-semibold">@Money(line.TotalAmount)</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-danger" type="button" @onclick="() => RemoveLine(line)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </AppCard>
                </div>

                <div class="col-xl-4">
                    <AppCard Title="@Text("Quick Customer", "Ø¹Ù…ÙŠÙ„ Ø³Ø±ÙŠØ¹")" CssClass="mb-3">
                        <div class="mb-2">
                            <label class="form-label">@Text("Organization name", "Ø§Ø³Ù… Ø§Ù„Ù…Ø¤Ø³Ø³Ø©")</label>
                            <input class="form-control" @bind="quickCustomer.Name" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">@Text("Commercial name", "Ø§Ù„Ø§Ø³Ù… Ø§Ù„ØªØ¬Ø§Ø±ÙŠ")</label>
                            <input class="form-control" @bind="quickCustomer.CommercialName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">@Text("VAT number", "Ø§Ù„Ø±Ù‚Ù… Ø§Ù„Ø¶Ø±ÙŠØ¨ÙŠ")</label>
                            <input class="form-control" @bind="quickCustomer.VatNumber" />
                        </div>
                        <button class="btn btn-outline-primary w-100" type="button" @onclick="CreateCustomerAsync" disabled="@isSaving">
                            <i class="bi bi-person-plus"></i> @Text("Create and select", "Ø¥Ù†Ø´Ø§Ø¡ ÙˆØ§Ø®ØªÙŠØ§Ø±")
                        </button>
                    </AppCard>

                    <AppCard Title="@Text("Totals", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠØ§Øª")">
                        <div class="summary-row"><span>@Text("Subtotal", "Ø§Ù„Ù…Ø¬Ù…ÙˆØ¹")</span><strong>@Money(order.Subtotal)</strong></div>
                        <div class="summary-row"><span>@Text("Tax", "Ø§Ù„Ø¶Ø±ÙŠØ¨Ø©")</span><strong>@Money(order.TaxAmount)</strong></div>
                        <div class="summary-row summary-total"><span>@Text("Total", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ")</span><strong>@Money(order.TotalAmount)</strong></div>
                        <button class="btn btn-primary w-100 mt-3" type="submit" disabled="@isSaving">
