    @if (isLoading)
    {
        <div class="erp-loading py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2">@Text("Loading sales order form...", "Ø¬Ø§Ø±ÙŠ ØªØ­Ù…ÙŠÙ„ Ù†Ù…ÙˆØ°Ø¬ Ø£Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹...")</div>
