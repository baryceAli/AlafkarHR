</section>

@code {
    private bool CanCreate;
    private bool isLoading;
    private bool isSaving;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private CreateManualSalesOrderDto order = new();
    private CustomerDto quickCustomer = NewQuickCustomer();
    private List<CustomerDto> customers = [];
    private List<ProductDto> products = [];
    private List<ProductSkuDto> skus = [];

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanCreate = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.Create);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }

        order = new CreateManualSalesOrderDto
        {
            Number = $"SO-{DateTime.UtcNow:yyyyMMddHHmmss}",
            CompanyId = companyId,
            OrderDate = DateTime.Today,
            DeliveryDate = DateTime.Today,
            SourceType = SalesOrderSourceType.Manual,
            Lines = []
        };

        if (CanCreate)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var customerTask = CustomerService.GetByCompany(companyId, 0, 1000);
        var productTask = ProductService.GetPricedByCompanyAsync(companyId, null, 0, 1000);
        var currencyTask = CurrencyService.GetAsync(companyId, 0, 1000);

        await Task.WhenAll(customerTask, productTask, currencyTask);

        customers = customerTask.Result.IsSuccess ? customerTask.Result.Data?.Data.ToList() ?? [] : [];
        products = productTask.Result.IsSuccess ? productTask.Result.Data?.Data.ToList() ?? [] : [];
        skus = products.SelectMany(x => x.Skus).OrderBy(x => Text(x.NameEng, x.Name)).ToList();
        var currencies = currencyTask.Result.IsSuccess ? currencyTask.Result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
        AddLine();
        isLoading = false;
    }

    private async Task OnCustomerChanged(ChangeEventArgs args)
    {
        if (Guid.TryParse(args.Value?.ToString(), out var id))
        {
            order.CustomerId = id;
            var productResult = await ProductService.GetPricedByCompanyAsync(companyId, id, 0, 1000, order.PriceListId);
            products = productResult.IsSuccess ? productResult.Data?.Data.ToList() ?? [] : products;
            skus = products.SelectMany(x => x.Skus).OrderBy(x => Text(x.NameEng, x.Name)).ToList();
        }
        else
        {
            order.CustomerId = Guid.Empty;
        }
    }

    private void AddLine()
    {
        order.Lines.Add(new SalesOrderLineDto { Quantity = 1 });
        Recalculate();
    }

    private void RemoveLine(SalesOrderLineDto line)
    {
        order.Lines.Remove(line);
        Recalculate();
    }

    private void SelectSku(SalesOrderLineDto line, string? value)
    {
        if (!Guid.TryParse(value, out var skuId))
            return;

        var sku = skus.FirstOrDefault(x => x.Id == skuId);
        if (sku is null)
            return;

        line.ProductId = sku.ProductId;
        line.ProductSkuId = sku.Id;
        line.ProductName = sku.Name;
        line.ProductNameEng = sku.NameEng;
        line.SkuCode = sku.SkuCode;
        line.UnitOfMeasureId = sku.UnitId ?? Guid.Empty;
        line.UnitPrice = sku.Price;
        line.DiscountRate = sku.DiscountRate;
        line.TaxRate = sku.TaxRate;
        Recalculate();
    }

    private async Task CreateCustomerAsync()
    {
        if (string.IsNullOrWhiteSpace(quickCustomer.Name))
        {
            ToastService.ShowWarning(Text("Enter the organization name.", "Ø£Ø¯Ø®Ù„ Ø§Ø³Ù… Ø§Ù„Ù…Ø¤Ø³Ø³Ø©."));
            return;
        }

        isSaving = true;
        quickCustomer.CompanyId = companyId;
        var result = await CustomerService.CreateAsync(quickCustomer);
        if (result.IsSuccess && result.Data is not null)
        {
            ToastService.ShowSuccess(Text("Customer created.", "ØªÙ… Ø¥Ù†Ø´Ø§Ø¡ Ø§Ù„Ø¹Ù…ÙŠÙ„."));
            var customerResult = await CustomerService.GetByCompany(companyId, 0, 1000);
            customers = customerResult.IsSuccess ? customerResult.Data?.Data.ToList() ?? [] : customers;
            order.CustomerId = result.Data.Id;
            quickCustomer = NewQuickCustomer();
            await OnCustomerChanged(new ChangeEventArgs { Value = order.CustomerId.ToString() });
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to create customer.", "ØªØ¹Ø°Ø± Ø¥Ù†Ø´Ø§Ø¡ Ø§Ù„Ø¹Ù…ÙŠÙ„."));
        }
        isSaving = false;
    }

    private async Task SaveAsync()
    {
        if (order.CustomerId == Guid.Empty)
        {
            ToastService.ShowWarning(Text("Select a customer.", "Ø§Ø®ØªØ± Ø§Ù„Ø¹Ù…ÙŠÙ„."));
            return;
        }

        order.Lines = order.Lines.Where(x => x.ProductSkuId != Guid.Empty && x.Quantity > 0).ToList();
        if (order.Lines.Count == 0)
        {
            ToastService.ShowWarning(Text("Add at least one SKU line.", "Ø£Ø¶Ù ØµÙ†ÙØ§ ÙˆØ§Ø­Ø¯Ø§ Ø¹Ù„Ù‰ Ø§Ù„Ø£Ù‚Ù„."));
            AddLine();
            return;
        }

        Recalculate();
        isSaving = true;
        var result = await SalesService.CreateManualOrderAsync(order);
        if (result.IsSuccess && result.Data is not null)
        {
            ToastService.ShowSuccess(Text("Sales order draft created.", "ØªÙ… Ø¥Ù†Ø´Ø§Ø¡ Ù…Ø³ÙˆØ¯Ø© Ø£Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹."));
            NavigationManager.NavigateTo($"/Sales/Orders/{result.Data.Id}");
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to create sales order.", "ØªØ¹Ø°Ø± Ø¥Ù†Ø´Ø§Ø¡ Ø£Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹."));
        }
        isSaving = false;
    }

    private void Recalculate()
    {
        order.Subtotal = order.Lines.Sum(x => x.NetAmount);
        order.TaxAmount = order.Lines.Sum(x => x.TaxAmount);
        order.TotalAmount = order.Subtotal + order.TaxAmount;
    }

    private static CustomerDto NewQuickCustomer() => new()
    {
        Status = CustomerStatus.Active,
        PaymentTerm = PaymentTermType.Cash,
        CreditStatus = CreditStatus.Good,
        Addresses = [],
        Contacts = []
    };

    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

