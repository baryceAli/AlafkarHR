</section>

@code {
    private bool CanView;
    private bool CanCreate;
    private bool CanPost;
    private bool CanCancel;
    private bool isLoading;
    private Guid companyId;
    private List<SalesReturnDto> returns = [];

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var permissions = authState.User.Claims.Select(c => c.Value).ToHashSet();
        CanView = permissions.Contains(PermissionList.SalesReturnPermissions.View);
        CanCreate = permissions.Contains(PermissionList.SalesReturnPermissions.Create);
        CanPost = permissions.Contains(PermissionList.SalesReturnPermissions.Post);
        CanCancel = permissions.Contains(PermissionList.SalesReturnPermissions.Cancel);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetReturnsByCompanyAsync(companyId, 0, 50);
        returns = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        isLoading = false;
    }

    private async Task PostAsync(Guid id)
    {
        var result = await SalesService.PostReturnAsync(id);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Return posted.", "ØªÙ… ØªØ±Ø­ÙŠÙ„ Ø§Ù„Ù…Ø±ØªØ¬Ø¹."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to post return.", "ØªØ¹Ø°Ø± ØªØ±Ø­ÙŠÙ„ Ø§Ù„Ù…Ø±ØªØ¬Ø¹."));
        }
    }

    private async Task CancelAsync(Guid id)
    {
        var result = await SalesService.CancelReturnAsync(id);
        if (result.IsSuccess)
            await LoadAsync();
        else
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to cancel return.", "ØªØ¹Ø°Ø± Ø¥Ù„ØºØ§Ø¡ Ø§Ù„Ù…Ø±ØªØ¬Ø¹."));
    }

    private static string StatusTone(SalesReturnStatus status) => status switch
    {
        SalesReturnStatus.Posted => "success",
        SalesReturnStatus.Cancelled => "danger",
        _ => "muted"
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
