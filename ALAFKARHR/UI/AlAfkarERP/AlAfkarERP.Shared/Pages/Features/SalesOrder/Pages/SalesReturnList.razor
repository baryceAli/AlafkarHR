@layout AdminLayout
@page "/Sales/Returns"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.SalesOrder.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@using SharedWithUI.SalesOrder.Dtos
@using SharedWithUI.SalesOrder.Enums

@inject ISalesService SalesService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<section class="sales-page erp-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "Ù„ÙŠØ³ Ù„Ø¯ÙŠÙƒ Ø§Ù„ØµÙ„Ø§Ø­ÙŠØ© Ù„Ø¹Ø±Ø¶ Ù‡Ø°Ù‡ Ø§Ù„ØµÙØ­Ø©")</div>
        return;
    }

    <PageHeader Title="@Text("Sales Returns", "Ù…Ø±ØªØ¬Ø¹Ø§Øª Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª")"
                Subtitle="@Text("Post customer returns and optional credit notes.", "ØªØ±Ø­ÙŠÙ„ Ù…Ø±ØªØ¬Ø¹Ø§Øª Ø§Ù„Ø¹Ù…Ù„Ø§Ø¡ ÙˆØ¥Ø´Ø¹Ø§Ø±Ø§Øª Ø§Ù„Ø¯Ø§Ø¦Ù† Ø¹Ù†Ø¯ Ø§Ù„Ø­Ø§Ø¬Ø©.")"
                Overline="@Text("Sales", "Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª")"
                Icon="bi-arrow-counterclockwise">
        <Actions>
            @if (CanCreate)
            {
                <a class="btn btn-primary" href="/Sales/Returns/Create">
                    <i class="bi bi-plus-lg"></i> @Text("Register Return", "ØªØ³Ø¬ÙŠÙ„ Ù…Ø±ØªØ¬Ø¹")
                </a>
            }
        </Actions>
    </PageHeader>

    <AppCard Title="@Text("Returns", "Ø§Ù„Ù…Ø±ØªØ¬Ø¹Ø§Øª")">
        @if (isLoading)
        {
            <div class="erp-loading py-4"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (!returns.Any())
        {
            <EmptyState Title="@Text("No returns", "Ù„Ø§ ØªÙˆØ¬Ø¯ Ù…Ø±ØªØ¬Ø¹Ø§Øª")"
                        Message="@Text("Customer returns will appear here.", "Ø³ØªØ¸Ù‡Ø± Ù…Ø±ØªØ¬Ø¹Ø§Øª Ø§Ù„Ø¹Ù…Ù„Ø§Ø¡ Ù‡Ù†Ø§.")"
