@layout AdminLayout
@page "/Sales/Orders"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.SalesOrder.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions
@using SharedWithUI.SalesOrder.Dtos
@using SharedWithUI.SalesOrder.Enums

@inject ISalesService SalesService
@inject ICurrencyService CurrencyService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="sales-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</div>
        return;
    }

    <PageHeader Title="@Text("Sales Orders", "أوامر البيع")"
                Subtitle="@Text("Browse converted sales orders and inspect fulfillment progress.", "استعراض أوامر البيع ومتابعة التنفيذ.")"
                Overline="@Text("Sales", "المبيعات")"
                Icon="bi-list-check">
        <Actions>
            @if (CanCreate)
            {
                <a class="btn btn-primary" href="/Sales/Orders/Create">
                    <i class="bi bi-plus-lg"></i> @Text("New Sales Order", "أمر بيع جديد")
                </a>
            }
            <a class="btn btn-outline-secondary" href="/Sales/Dashboard">
                <i class="bi bi-graph-up-arrow"></i> @Text("Dashboard", "لوحة المبيعات")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title="@Text("Orders", "الأوامر")">
        @if (isLoading)
        {
            <div class="erp-loading py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2">@Text("Loading sales orders...", "جاري تحميل أوامر البيع...")</div>
            </div>
        }
        else if (!orders.Any())
        {
            <EmptyState Title="@Text("No sales orders", "لا توجد أوامر بيع")"
                        Message="@Text("Accepted order intakes will appear here.", "ستظهر الطلبات المقبولة هنا.")"
                        Icon="bi-inboxes" />
        }
        else
        {
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Number", "الرقم")</th>
                            <th>@Text("Status", "الحالة")</th>
                            <th>@Text("Order date", "تاريخ الأمر")</th>
                            <th>@Text("Subtotal", "المجموع")</th>
                            <th>@Text("Tax", "الضريبة")</th>
                            <th>@Text("Total", "الإجمالي")</th>
                            <th>@Text("Branch", "الفرع")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="fw-semibold">@order.Number</td>
                                <td><span class="badge rounded-pill @StatusBadge(order.Status)">@StatusText(order.Status)</span></td>
                                <td>@order.OrderDate.ToString("yyyy-MM-dd")</td>
                                <td>@Money(order.Subtotal)</td>
                                <td>@Money(order.TaxAmount)</td>
                                <td>@Money(order.TotalAmount)</td>
                                <td>@BranchText(order.BranchId)</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo($"/Sales/Orders/{order.Id}")'>
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <button class="btn btn-outline-secondary" @onclick="PreviousPage" disabled="@(pageIndex == 0 || isLoading)">@Text("Previous", "السابق")</button>
                <span class="text-muted">@Text($"Page {pageIndex + 1}", $"صفحة {pageIndex + 1}")</span>
                <button class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(!HasNextPage || isLoading)">@Text("Next", "التالي")</button>
            </div>
        }
    </AppCard>
</section>

@code {
    private bool CanView;
    private bool CanCreate;
    private bool isLoading;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private int pageIndex;
    private const int PageSize = 20;
    private long totalCount;
    private List<SalesOrderDto> orders = [];
    private List<BranchDto> branches = [];
    private bool HasNextPage => (pageIndex + 1) * PageSize < totalCount;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.View);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        CanCreate = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.Create);
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))

        {

            NavigationManager.NavigateTo("/Dashboard");

            return;

        }
        if (CanView)
        {
            await LoadCurrencyAsync();
            await LoadBranchesAsync();
            await LoadAsync();
        }
    }

    private async Task LoadCurrencyAsync()
    {
        var result = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencies = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task LoadBranchesAsync()
    {
        var result = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetOrdersByCompanyAsync(companyId, pageIndex, PageSize);
        if (result.IsSuccess && result.Data is not null)
        {
            orders = result.Data.Data.ToList();
            totalCount = result.Data.Count;
        }
        isLoading = false;
    }

    private async Task PreviousPage()
    {
        if (pageIndex == 0)
            return;
        pageIndex--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (!HasNextPage)
            return;
        pageIndex++;
        await LoadAsync();
    }

    private string StatusText(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Confirmed => Text("Confirmed", "مؤكد"),
        SalesOrderStatus.PartiallyReserved => Text("Partially reserved", "محجوز جزئيا"),
        SalesOrderStatus.Reserved => Text("Reserved", "محجوز"),
        SalesOrderStatus.PartiallyDelivered => Text("Partially delivered", "مسلم جزئيا"),
        SalesOrderStatus.Delivered => Text("Delivered", "مسلم"),
        SalesOrderStatus.PartiallyInvoiced => Text("Partially invoiced", "مفوتر جزئيا"),
        SalesOrderStatus.Invoiced => Text("Invoiced", "مفوتر"),
        SalesOrderStatus.Completed => Text("Completed", "مكتمل"),
        SalesOrderStatus.Cancelled => Text("Cancelled", "ملغي"),
        _ => Text("Draft", "مسودة")
    };

    private static string StatusBadge(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Completed or SalesOrderStatus.Invoiced or SalesOrderStatus.Delivered => "text-bg-success",
        SalesOrderStatus.Cancelled or SalesOrderStatus.Rejected => "text-bg-danger",
        SalesOrderStatus.Confirmed or SalesOrderStatus.PartiallyReserved or SalesOrderStatus.Reserved => "text-bg-primary",
        _ => "text-bg-secondary"
    };

    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string BranchText(Guid? branchId)
    {
        if (!branchId.HasValue)
            return Text("Company", "الشركة");

        var branch = branches.FirstOrDefault(x => x.Id == branchId.Value);
        return branch is null ? branchId.Value.ToString("N")[..8] : Text(branch.NameEng, branch.Name);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
