        }
    </AppCard>
</section>

@code {
    private bool CanView;
    private bool CanCreate;
    private bool isLoading;
    private Guid companyId;
    private string currencyCode = string.Empty;
    private int pageIndex;
    private const int PageSize = 20;
    private long totalCount;
    private List<SalesOrderDto> orders = [];
    private List<BranchDto> branches = [];
    [SupplyParameterFromQuery] public Guid? CustomerId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductId { get; set; }
    [SupplyParameterFromQuery] public Guid? ProductSkuId { get; set; }
    private bool HasNextPage => (pageIndex + 1) * PageSize < totalCount;
    private bool HasSmartFilter => CustomerId.HasValue || ProductId.HasValue || ProductSkuId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanView = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.View);
        if (!authState.User.Identity?.IsAuthenticated ?? true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }
        CanCreate = authState.User.Claims.Any(c => c.Value == PermissionList.SalesOrderPermissions.Create);
        if (!CompanyContext.TryGetCompanyId(authState.User, out companyId))

        {

            NavigationManager.NavigateTo("/Dashboard");

            return;

        }
        if (CanView)
        {
            await LoadCurrencyAsync();
            await LoadBranchesAsync();
            await LoadAsync();
        }
    }

    private async Task LoadCurrencyAsync()
    {
        var result = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencies = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
        currencyCode = currencies.FirstOrDefault(c => c.IsDefault)?.Code ?? currencies.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task LoadBranchesAsync()
    {
        var result = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await SalesService.GetOrdersByCompanyAsync(companyId, pageIndex, PageSize, CustomerId, ProductId, ProductSkuId);
        if (result.IsSuccess && result.Data is not null)
        {
            orders = result.Data.Data.ToList();
            totalCount = result.Data.Count;
        }
        isLoading = false;
    }

    private async Task PreviousPage()
    {
        if (pageIndex == 0)
            return;
        pageIndex--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (!HasNextPage)
            return;
        pageIndex++;
        await LoadAsync();
    }

    private string SmartFilterText()
    {
        if (CustomerId.HasValue)
            return Text("Filtered by customer", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ Ø§Ù„Ø¹Ù…ÙŠÙ„");
        if (ProductSkuId.HasValue)
            return Text("Filtered by SKU", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ ÙˆØ­Ø¯Ø© Ø§Ù„Ù…Ù†ØªØ¬");
        if (ProductId.HasValue)
            return Text("Filtered by product", "Ù…ØµÙÙ‰ Ø­Ø³Ø¨ Ø§Ù„Ù…Ù†ØªØ¬");
        return Text("Filtered", "Ù…ØµÙÙ‰");
    }

    private string StatusText(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Confirmed => Text("Confirmed", "Ù…Ø¤ÙƒØ¯"),
        SalesOrderStatus.PartiallyReserved => Text("Partially reserved", "Ù…Ø­Ø¬ÙˆØ² Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Reserved => Text("Reserved", "Ù…Ø­Ø¬ÙˆØ²"),
        SalesOrderStatus.PartiallyDelivered => Text("Partially delivered", "Ù…Ø³Ù„Ù… Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Delivered => Text("Delivered", "Ù…Ø³Ù„Ù…"),
        SalesOrderStatus.PartiallyInvoiced => Text("Partially invoiced", "Ù…ÙÙˆØªØ± Ø¬Ø²Ø¦ÙŠØ§"),
        SalesOrderStatus.Invoiced => Text("Invoiced", "Ù…ÙÙˆØªØ±"),
        SalesOrderStatus.Completed => Text("Completed", "Ù…ÙƒØªÙ…Ù„"),
        SalesOrderStatus.Cancelled => Text("Cancelled", "Ù…Ù„ØºÙŠ"),
        _ => Text("Draft", "Ù…Ø³ÙˆØ¯Ø©")
    };

    private static string StatusTone(SalesOrderStatus status) => status switch
    {
        SalesOrderStatus.Completed or SalesOrderStatus.Invoiced or SalesOrderStatus.Delivered => "success",
        SalesOrderStatus.Cancelled or SalesOrderStatus.Rejected => "danger",
        SalesOrderStatus.Confirmed or SalesOrderStatus.PartiallyReserved or SalesOrderStatus.Reserved => "primary",
        _ => "muted"
    };

    private string Money(decimal value) => string.IsNullOrWhiteSpace(currencyCode) ? $"{value:N2}" : $"{value:N2} {currencyCode}";
    private string BranchText(Guid? branchId)
    {
        if (!branchId.HasValue)
            return Text("Company", "Ø§Ù„Ø´Ø±ÙƒØ©");

        var branch = branches.FirstOrDefault(x => x.Id == branchId.Value);
        return branch is null ? branchId.Value.ToString("N")[..8] : Text(branch.NameEng, branch.Name);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
