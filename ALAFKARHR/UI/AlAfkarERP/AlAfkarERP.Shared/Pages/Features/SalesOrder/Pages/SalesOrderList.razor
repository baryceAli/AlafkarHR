@inject ISalesService SalesService
@inject ICurrencyService CurrencyService
@inject IBranchService BranchService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="sales-page erp-page" dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "Ù„ÙŠØ³ Ù„Ø¯ÙŠÙƒ Ø§Ù„ØµÙ„Ø§Ø­ÙŠØ© Ù„Ø¹Ø±Ø¶ Ù‡Ø°Ù‡ Ø§Ù„ØµÙØ­Ø©")</div>
        return;
    }

    <PageHeader Title="@Text("Sales Orders", "Ø£ÙˆØ§Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹")"
                Subtitle="@Text("Browse converted sales orders and inspect fulfillment progress.", "Ø§Ø³ØªØ¹Ø±Ø§Ø¶ Ø£ÙˆØ§Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹ ÙˆÙ…ØªØ§Ø¨Ø¹Ø© Ø§Ù„ØªÙ†ÙÙŠØ°.")"
                Overline="@Text("Sales", "Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª")"
                Icon="bi-list-check">
        <Actions>
            @if (CanCreate)
            {
                <a class="btn btn-primary" href="/Sales/Orders/Create">
                    <i class="bi bi-plus-lg"></i> @Text("New Sales Order", "Ø£Ù…Ø± Ø¨ÙŠØ¹ Ø¬Ø¯ÙŠØ¯")
                </a>
            }
            <a class="btn btn-outline-secondary" href="/Sales/Dashboard">
                <i class="bi bi-graph-up-arrow"></i> @Text("Dashboard", "Ù„ÙˆØ­Ø© Ø§Ù„Ù…Ø¨ÙŠØ¹Ø§Øª")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title="@Text("Orders", "Ø§Ù„Ø£ÙˆØ§Ù…Ø±")">
        @if (HasSmartFilter)
        {
            <div class="erp-chip-row mb-3">
                <StatusChip Tone="info" Text="@SmartFilterText()" />
                <button class="btn btn-outline-secondary btn-sm" @onclick='() => NavigationManager.NavigateTo("/Sales/Orders")'>
                    <i class="bi bi-x-lg"></i>
                    @Text("Clear filter", "Ù…Ø³Ø­ Ø§Ù„ØªØµÙÙŠØ©")
                </button>
            </div>
        }
        @if (isLoading)
        {
            <div class="erp-loading py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="mt-2">@Text("Loading sales orders...", "Ø¬Ø§Ø±ÙŠ ØªØ­Ù…ÙŠÙ„ Ø£ÙˆØ§Ù…Ø± Ø§Ù„Ø¨ÙŠØ¹...")</div>
            </div>
        }
        else if (!orders.Any())
        {
            <EmptyState Title="@Text("No sales orders", "Ù„Ø§ ØªÙˆØ¬Ø¯ Ø£ÙˆØ§Ù…Ø± Ø¨ÙŠØ¹")"
                        Message="@Text("Accepted order intakes will appear here.", "Ø³ØªØ¸Ù‡Ø± Ø§Ù„Ø·Ù„Ø¨Ø§Øª Ø§Ù„Ù…Ù‚Ø¨ÙˆÙ„Ø© Ù‡Ù†Ø§.")"
                        Icon="bi-inboxes" />
        }
        else
        {
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Number", "Ø§Ù„Ø±Ù‚Ù…")</th>
                            <th>@Text("Status", "Ø§Ù„Ø­Ø§Ù„Ø©")</th>
                            <th>@Text("Order date", "ØªØ§Ø±ÙŠØ® Ø§Ù„Ø£Ù…Ø±")</th>
                            <th>@Text("Subtotal", "Ø§Ù„Ù…Ø¬Ù…ÙˆØ¹")</th>
                            <th>@Text("Tax", "Ø§Ù„Ø¶Ø±ÙŠØ¨Ø©")</th>
                            <th>@Text("Total", "Ø§Ù„Ø¥Ø¬Ù…Ø§Ù„ÙŠ")</th>
                            <th>@Text("Branch", "Ø§Ù„ÙØ±Ø¹")</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <td class="fw-semibold">@order.Number</td>
