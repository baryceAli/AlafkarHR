            <div class="d-flex justify-content-between align-items-center mt-3">
                <button class="btn btn-outline-secondary" @onclick="PreviousPage" disabled="@(pageIndex == 0 || isLoading)">@Text("Previous", "Ø§Ù„Ø³Ø§Ø¨Ù‚")</button>
                <span class="text-muted">@Text($"Page {pageIndex + 1}", $"ØµÙØ­Ø© {pageIndex + 1}")</span>
                <button class="btn btn-outline-secondary" @onclick="NextPage" disabled="@(!HasNextPage || isLoading)">@Text("Next", "Ø§Ù„ØªØ§Ù„ÙŠ")</button>
