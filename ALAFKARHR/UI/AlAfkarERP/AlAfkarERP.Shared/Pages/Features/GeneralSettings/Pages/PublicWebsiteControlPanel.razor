@page "/PublicWebsite/ControlPanel"
@layout AdminLayout
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Permissions
@implements IDisposable
@inject AuthenticationStateProvider Authentication
@inject SharedDataService SharedDataService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@T("Alafkar Public Website", "موقع الأفكار العام")" Subtitle="@T("Static website managed in code", "موقع ثابت يُدار محتواه من الشفرة البرمجية")" Icon="bi-window" />
    @if (loading)
    {
        <div class="erp-loading">@T("Loading…", "جاري التحميل…")</div>
    }
    else if (!Can(PermissionList.PublicWebsitePermissions.View))
    {
        <div class="alert alert-warning" role="alert">@T("Sign in with an authorized website management account.", "يرجى تسجيل الدخول بحساب مخول لإدارة الموقع.") <a href="/login">@T("Sign in", "تسجيل الدخول")</a></div>
    }
    else
    {
        <AppCard Title="@T("Website editor inactive", "محرر الموقع غير نشط")">
            <p>@T("The public website now uses approved Arabic static content maintained in code. Changes to saved drafts or publications do not update this website.", "يستخدم الموقع العام الآن محتوى عربيًا ثابتًا معتمدًا يُحدّث من الشفرة البرمجية. لا تؤثر تعديلات المسودات أو المنشورات المحفوظة في محتوى هذا الموقع.")</p>
            <p>@T("Existing drafts, publications and media remain preserved. Configuration and media storage settings remain available with their existing permissions.", "تظل المسودات والمنشورات والوسائط السابقة محفوظة. وتبقى إعدادات التهيئة وتخزين الوسائط متاحة وفق الصلاحيات الحالية.")</p>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-primary" href="/" target="_blank" rel="noopener">@T("Open website", "فتح الموقع")</a>
                @if (Can(PermissionList.PublicWebsiteConfigurationPermissions.View))
                {
                    <a class="btn btn-outline-secondary" href="/PublicWebsite/Configuration">@T("Configuration", "التهيئة")</a>
                }
            </div>
        </AppCard>
    }
</div>
@code {
    private System.Security.Claims.ClaimsPrincipal? user;
    private bool loading = true;
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private bool Can(string permission) => user?.Claims.Any(x => x.Type == "Permission" && x.Value == permission) == true;
    protected override void OnInitialized() => SharedDataService.OnChange1 += LanguageChanged;
    private Task LanguageChanged() => InvokeAsync(StateHasChanged);
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        user = (await Authentication.GetAuthenticationStateAsync()).User;
        loading = false;
        await InvokeAsync(StateHasChanged);
    }
    public void Dispose() => SharedDataService.OnChange1 -= LanguageChanged;
}
