@layout AdminLayout
@page "/GeneralSettings/SystemSettings"
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Permissions
@implements IDisposable

@inject ICompanySettingService CompanySettingService
@inject ICustomerService CustomerService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject IJSRuntime JSRuntime

<div class="system-settings-page erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("System Settings", "إعدادات النظام")"
                Subtitle="@Text("Control company-wide defaults used by organization, branch, warehouse, and map screens.", "التحكم في الإعدادات الافتراضية المستخدمة في شاشات الشركة والفروع والمستودعات والخرائط.")"
                Overline="@Text("General Settings", "الإعدادات العامة")"
                Icon="bi-gear-wide-connected">
        <Actions>
        <button class="btn btn-outline-primary" @onclick="LoadSettingsAsync" disabled="@isLoading">
            <i class="bi bi-arrow-clockwise"></i>
            @Text("Refresh", "تحديث")
        </button>
        </Actions>
    </PageHeader>

    <AppPageMessage Message="@pageMessage"
                    Type="@pageMessageType"
                    Direction="@SharedDataService.PageDirection"
                    OnDismiss="ClearPageMessage" />

    @if (isLoading)
    {
        <AppCard>
            <div class="py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@Text("Loading settings...", "جاري تحميل الإعدادات...")</div>
            </div>
        </AppCard>
    }
    else if (!CanView)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-shield-lock"></i>
            <span>@Text("You don't have permissions to view system settings.", "ليس لديك الصلاحية لعرض إعدادات النظام.")</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <AppPageMessage Message="@errorMessage"
                        Type="error"
                        Direction="@SharedDataService.PageDirection"
                        Dismissible="false" />
    }
    else
    {
        <EditForm Model="settings" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="row g-4">
                <div class="col-xl-5">
                    <AppCard CssClass="h-100" BodyClass="settings-form-card-body">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <span class="settings-icon"><i class="bi bi-geo-alt"></i></span>
                                <div>
                                    <h5 class="mb-0">@Text("Default Location", "الموقع الافتراضي")</h5>
                                    <div class="text-muted small">@Text("Used when a branch or company location is not set.", "يستخدم عند عدم تحديد موقع للشركة أو الفرع.")</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@Text("Location Name", "اسم الموقع")</label>
                                <InputText class="form-control" @bind-Value="settings.DefaultLocation" disabled="@(!CanEdit)" />
                                <ValidationMessage For="@(() => settings.DefaultLocation)" />
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Latitude", "خط العرض")</label>
                                    <InputNumber class="form-control" @bind-Value="settings.DefaultLatitude" disabled="@(!CanEdit)" />
                                    <ValidationMessage For="@(() => settings.DefaultLatitude)" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Longitude", "خط الطول")</label>
                                    <InputNumber class="form-control" @bind-Value="settings.DefaultLongitude" disabled="@(!CanEdit)" />
                                    <ValidationMessage For="@(() => settings.DefaultLongitude)" />
                                </div>
                            </div>

                            <div class="mt-3">
                                <label class="form-label">@Text("Default POS Customer", "عميل نقطة البيع الافتراضي")</label>
                                <InputSelect class="form-select" @bind-Value="settings.DefaultPosCustomerId" disabled="@(!CanEdit)">
                                    <option value="">@Text("Select walk-in customer", "اختر عميل البيع المباشر")</option>
                                    @foreach (var customer in customers)
                                    {
                                        <option value="@customer.Id">@CustomerDisplay(customer)</option>
                                    }
                                </InputSelect>
                                <div class="form-text">
                                    @Text("Used automatically when POS creates a new cart.", "يستخدم تلقائيا عند إنشاء سلة جديدة في نقطة البيع.")
                                </div>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                <button type="button" class="btn btn-outline-secondary" @onclick="UseKsaDefaultAsync" disabled="@(!CanEdit)">
                                    <i class="bi bi-pin-map"></i>
                                    @Text("Use KSA Default", "استخدام موقع السعودية")
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="UseCurrentLocationAsync" disabled="@(!CanEdit)">
                                    <i class="bi bi-crosshair"></i>
                                    @Text("Current Location", "الموقع الحالي")
                                </button>
                                <button type="button" class="btn btn-outline-secondary" @onclick="CenterMapAsync">
                                    <i class="bi bi-bullseye"></i>
                                    @Text("Center Map", "توسيط الخريطة")
                                </button>
                            </div>

                            <div class="settings-save-actions">
                            <button type="submit" class="btn btn-primary" disabled="@(!CanEdit || isSaving)">
                                @if (isSaving)
                                {
                                    <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                }
                                else
                                {
                                    <i class="bi bi-save"></i>
                                }
                                @Text("Save Settings", "حفظ الإعدادات")
                            </button>
                            </div>
                    </AppCard>
                </div>

                <div class="col-xl-7">
                    <AppCard CssClass="h-100"
                             Title="@Text("Company Map Default", "الخريطة الافتراضية للشركة")"
                             Subtitle="@Text("Click or drag the map to choose the default coordinates.", "اضغط أو حرّك الخريطة لاختيار الإحداثيات الافتراضية.")">
                        <Actions>
                            <div class="btn-group">
                                <button type="button" class="btn btn-outline-secondary" title="@Text("Zoom in", "تكبير")" @onclick="ZoomInAsync">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" title="@Text("Zoom out", "تصغير")" @onclick="ZoomOutAsync">
                                    <i class="bi bi-dash-lg"></i>
                                </button>
                            </div>
                        </Actions>
                        <ChildContent>
                            <div id="@mapElementId" class="settings-map"></div>
                        </ChildContent>
                    </AppCard>
                </div>
            </div>
        </EditForm>
    }
</div>

@code {
    private const double KsaDefaultLatitude = 24.7136;
    private const double KsaDefaultLongitude = 46.6753;

    private readonly string mapElementId = $"system-settings-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<SystemSettings>? dotNetReference;
    private AuthenticationState? AuthState;
    private CompanySettingDto settings = new();
    private List<CustomerDto> customers = [];
    private Guid companyId;
    private bool isLoading = true;
    private bool isSaving;
    private bool mapReady;
    private string? errorMessage;
    private string? pageMessage;
    private string pageMessageType = "warning";

    private bool CanView => AuthState?.User.Claims.Any(c => c.Value == PermissionList.SystemSettingsPermissions.View) == true;
    private bool CanEdit => AuthState?.User.Claims.Any(c => c.Value == PermissionList.SystemSettingsPermissions.Edit) == true;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleLanguageChangeAsync;

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!Guid.TryParse(AuthState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out companyId))
        {
            errorMessage = Text("No company is assigned to the current user.", "لا توجد شركة مرتبطة بالمستخدم الحالي.");
            isLoading = false;
            return;
        }

        await LoadSettingsAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (isLoading || !CanView || mapReady)
        {
            return;
        }

        dotNetReference ??= DotNetObjectReference.Create(this);
        await JSRuntime.InvokeVoidAsync(
            "alafkarLocationPicker.init",
            mapElementId,
            MapLatitude,
            MapLongitude,
            8,
            dotNetReference);

        mapReady = true;
    }

    private async Task LoadSettingsAsync()
    {
        isLoading = true;
        errorMessage = null;

        if (!CanView)
        {
            isLoading = false;
            return;
        }

        var response = await CompanySettingService.GetAsync(companyId);
        await LoadCustomersAsync();

        if (response.IsSuccess && response.Data is not null)
        {
            settings = response.Data;
        }
        else
        {
            errorMessage = response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load system settings.", "تعذر تحميل إعدادات النظام.");
        }

        isLoading = false;
        mapReady = false;
    }

    private async Task LoadCustomersAsync()
    {
        var response = await CustomerService.GetByCompany(companyId, 0, 1000);
        if (response.IsSuccess)
        {
            customers = response.Data?.Data?.ToList() ?? [];
            return;
        }

        customers = [];
        ShowPageError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load customers.", "تعذر تحميل العملاء."));
    }

    private async Task SaveAsync()
    {
        if (!CanEdit)
        {
            return;
        }

        isSaving = true;
        settings.CompanyId = companyId;

        var response = await CompanySettingService.UpdateAsync(companyId, settings);
        if (response.IsSuccess && response.Data is not null)
        {
            settings = response.Data;
            ClearPageMessage();
            ToastService.ShowSuccess(Text("System settings saved successfully.", "تم حفظ إعدادات النظام بنجاح."));
            await CenterMapAsync();
        }
        else
        {
            ShowPageError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to save system settings.", "تعذر حفظ إعدادات النظام."));
        }

        isSaving = false;
    }

    private async Task UseKsaDefaultAsync()
    {
        settings.DefaultLocation = "Riyadh, Saudi Arabia";
        settings.DefaultLatitude = KsaDefaultLatitude;
        settings.DefaultLongitude = KsaDefaultLongitude;
        await CenterMapAsync();
    }

    private async Task UseCurrentLocationAsync()
    {
        var supported = await JSRuntime.InvokeAsync<bool>("alafkarLocationPicker.useCurrentLocation", mapElementId);
        if (!supported)
        {
            ToastService.Show(new ToastMessage
            {
                Message = Text("Location access is not available in this browser.", "الوصول للموقع غير متاح في هذا المتصفح."),
                Type = "warning"
            });
        }
    }

    private async Task CenterMapAsync()
    {
        if (!mapReady)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync("alafkarLocationPicker.setCenter", mapElementId, MapLatitude, MapLongitude, false);
    }

    private async Task ZoomInAsync()
    {
        if (mapReady)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomIn", mapElementId);
        }
    }

    private async Task ZoomOutAsync()
    {
        if (mapReady)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomOut", mapElementId);
        }
    }

    [JSInvokable]
    public Task OnMapLocationSelected(double latitude, double longitude)
    {
        if (!CanEdit)
        {
            return Task.CompletedTask;
        }

        settings.DefaultLatitude = Math.Round(latitude, 6);
        settings.DefaultLongitude = Math.Round(longitude, 6);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private double MapLatitude => settings.DefaultLatitude == 0 ? KsaDefaultLatitude : settings.DefaultLatitude;
    private double MapLongitude => settings.DefaultLongitude == 0 ? KsaDefaultLongitude : settings.DefaultLongitude;
    private static string CustomerDisplay(CustomerDto customer) =>
        string.IsNullOrWhiteSpace(customer.CustomerCode)
            ? customer.Name
            : $"{customer.Name} ({customer.CustomerCode})";

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private void ShowPageError(string message)
    {
        pageMessage = message;
        pageMessageType = "error";
        ToastService.ShowError(message);
    }

    private void ClearPageMessage()
    {
        pageMessage = null;
        pageMessageType = "warning";
    }

    private async Task HandleLanguageChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleLanguageChangeAsync;
        if (mapReady)
        {
            _ = JSRuntime.InvokeVoidAsync("alafkarLocationPicker.dispose", mapElementId);
        }

        dotNetReference?.Dispose();
    }
}

<style>
    .system-settings-page {
        margin-inline: auto;
        max-inline-size: 1280px;
    }

    .settings-icon {
        align-items: center;
        background: var(--erp-primary-soft);
        block-size: 42px;
        border-radius: var(--erp-radius-lg);
        color: var(--erp-primary);
        display: inline-flex;
        flex: 0 0 auto;
        font-size: 1.2rem;
        inline-size: 42px;
        justify-content: center;
    }

    .settings-form-card-body {
        display: flex;
        flex-direction: column;
    }

    .settings-save-actions {
        border-block-start: 1px solid var(--erp-border);
        display: flex;
        gap: var(--erp-space-2);
        justify-content: flex-end;
        margin-block-start: auto;
        padding-block-start: var(--erp-space-4);
    }

    .settings-map {
        background: var(--erp-surface-muted);
        block-size: clamp(280px, 38vh, 380px);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        inline-size: 100%;
        overflow: hidden;
    }

    .validation-message {
        color: var(--erp-danger);
        font-size: var(--erp-font-size-sm);
        margin-block-start: var(--erp-space-1);
    }

    .location-picker-map {
        cursor: grab;
        position: relative;
        touch-action: none;
    }

    .location-picker-map.is-dragging {
        cursor: grabbing;
    }

    .location-picker-tile {
        block-size: 256px;
        inline-size: 256px;
        position: absolute;
        user-select: none;
    }

    .location-picker-marker {
        color: var(--erp-danger);
        font-size: 2rem;
        inset-block-start: 50%;
        inset-inline-start: 50%;
        line-height: 1;
        pointer-events: none;
        position: absolute;
        text-shadow: 0 2px 4px color-mix(in srgb, var(--erp-color-inverse-surface) 25%, transparent);
        transform: translate(-50%, -100%);
        z-index: 2;
    }

    @@media (max-width: 767.98px) {
        .settings-map {
            block-size: 280px;
        }
    }
</style>
