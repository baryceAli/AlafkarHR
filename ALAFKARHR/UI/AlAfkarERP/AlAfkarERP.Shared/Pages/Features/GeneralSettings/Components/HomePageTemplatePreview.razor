@namespace AlAfkarERP.Shared.Pages.Features.GeneralSettings.Components

<div class="homepage-template-preview homepage-template-preview-@TemplateKey.ToLowerInvariant()" dir="@Direction" aria-hidden="true">
    <div class="template-preview-topbar">
        <span></span>
        <span></span>
        <span></span>
    </div>

    @switch (TemplateKey)
    {
        case "MinimalistLanding":
            <div class="template-preview-body minimalist">
                <div class="preview-copy">
                    <span class="preview-kicker"></span>
                    <strong></strong>
                    <span></span>
                    <span class="short"></span>
                </div>
                <div class="preview-panel">
                    <i class="bi bi-bounding-box"></i>
                </div>
                <div class="preview-metric-row">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            break;
        case "SoftSaasLanding":
            <div class="template-preview-body soft-saas">
                <div class="preview-large-product">
                    <i class="bi bi-magic"></i>
                </div>
                <div class="preview-copy">
                    <span class="preview-kicker"></span>
                    <strong></strong>
                    <span></span>
                </div>
                <div class="preview-product-row">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            break;
        case "BoldEnergeticLanding":
            <div class="template-preview-body energetic">
                <div class="preview-offer">
                    <i class="bi bi-lightning-charge"></i>
                </div>
                <div class="preview-copy">
                    <span class="preview-kicker"></span>
                    <strong></strong>
                    <span></span>
                    <span class="preview-button"></span>
                </div>
            </div>
            break;
        case "CorporateTrustLanding":
            <div class="template-preview-body corporate">
                <div class="preview-search"></div>
                <div class="preview-compact-grid">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            break;
        case "ModernDarkModeLanding":
            <div class="template-preview-body dark-mode">
                <div class="preview-offer">
                    <i class="bi bi-cpu"></i>
                </div>
                <div class="preview-copy">
                    <span class="preview-kicker"></span>
                    <strong></strong>
                    <span></span>
                    <span class="preview-button"></span>
                </div>
            </div>
            break;
        default:
            <div class="template-preview-body storefront">
                <div class="preview-copy">
                    <span class="preview-kicker"></span>
                    <strong></strong>
                    <span></span>
                    <span class="short"></span>
                </div>
                <div class="preview-product-card">
                    <i class="bi bi-cup-hot"></i>
                </div>
                <div class="preview-product-row">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </div>
            break;
    }
</div>

@code {
    [Parameter] public string TemplateKey { get; set; } = "CurrentStorefront";
    [Parameter] public string Direction { get; set; } = "ltr";
}

<style>
    .homepage-template-preview {
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--erp-primary) 6%, var(--erp-surface)) 0%, var(--erp-surface) 100%);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        block-size: 164px;
        box-sizing: border-box;
        display: grid;
        grid-template-rows: 24px 1fr;
        inline-size: 100%;
        min-inline-size: 0;
        overflow: hidden;
    }

    .template-preview-topbar {
        align-items: center;
        background: color-mix(in srgb, var(--erp-surface) 88%, var(--erp-primary));
        border-block-end: 1px solid var(--erp-border);
        display: flex;
        gap: var(--erp-space-1);
        padding-inline: var(--erp-space-2);
    }

    .template-preview-topbar span {
        background: color-mix(in srgb, var(--erp-primary) 36%, var(--erp-surface));
        border-radius: var(--erp-radius-full);
        block-size: 6px;
        inline-size: 6px;
    }

    .template-preview-body {
        display: grid;
        gap: var(--erp-space-2);
        min-block-size: 0;
        min-inline-size: 0;
        overflow: hidden;
        padding: var(--erp-space-3);
    }

    .template-preview-body.storefront,
    .template-preview-body.corporate {
        grid-template-columns: minmax(0, 1.1fr) 72px;
        grid-template-rows: 1fr 34px;
    }

    .template-preview-body.product-focus {
        grid-template-columns: 82px minmax(0, 1fr);
        grid-template-rows: 1fr 30px;
    }

    .template-preview-body.campaign {
        grid-template-columns: 78px minmax(0, 1fr);
    }

    .template-preview-body.minimal {
        grid-template-rows: 28px 1fr;
    }

    .preview-copy {
        align-content: center;
        display: grid;
        gap: 6px;
        min-block-size: 0;
        min-inline-size: 0;
        overflow: hidden;
    }

    .preview-copy span,
    .preview-copy strong,
    .preview-search,
    .preview-product-row span,
    .preview-metric-row span,
    .preview-compact-grid span,
    .preview-copy .preview-button {
        background: color-mix(in srgb, var(--erp-text-muted) 22%, var(--erp-surface));
        border: 0;
        border-radius: var(--erp-radius-sm);
        display: block;
    }

    .preview-copy .preview-kicker {
        background: color-mix(in srgb, var(--erp-primary) 46%, var(--erp-surface));
        block-size: 7px;
        inline-size: 42%;
    }

    .preview-copy strong {
        background: color-mix(in srgb, var(--erp-text) 34%, var(--erp-surface));
        block-size: 12px;
        inline-size: 86%;
    }

    .preview-copy span {
        block-size: 8px;
        inline-size: 72%;
    }

    .preview-copy span.short {
        inline-size: 52%;
    }

    .preview-copy .preview-button {
        background: var(--erp-primary);
        block-size: 18px;
        inline-size: 54px;
        margin-block-start: 2px;
    }

    .preview-product-card,
    .preview-panel,
    .preview-large-product,
    .preview-offer {
        align-items: center;
        background: color-mix(in srgb, var(--erp-primary) 10%, var(--erp-surface));
        border: 1px solid color-mix(in srgb, var(--erp-primary) 20%, var(--erp-border));
        border-radius: var(--erp-radius-md);
        color: var(--erp-primary);
        display: flex;
        justify-content: center;
        min-block-size: 0;
        min-inline-size: 0;
        overflow: hidden;
    }

    .preview-product-card i,
    .preview-panel i,
    .preview-large-product i,
    .preview-offer i {
        font-size: 1.45rem;
    }

    .preview-product-row,
    .preview-metric-row {
        display: grid;
        gap: var(--erp-space-2);
        grid-column: 1 / -1;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        min-inline-size: 0;
    }

    .preview-product-row span,
    .preview-metric-row span {
        block-size: 100%;
    }

    .template-preview-body.product-focus .preview-product-row {
        grid-column: 1 / -1;
    }

    .preview-large-product {
        background: color-mix(in srgb, var(--erp-warning) 16%, var(--erp-surface));
        color: color-mix(in srgb, var(--erp-warning) 78%, var(--erp-text));
    }

    .preview-offer {
        background: color-mix(in srgb, var(--erp-success) 14%, var(--erp-surface));
        color: var(--erp-success);
    }

    .preview-search {
        block-size: 100%;
    }

    .preview-compact-grid {
        display: grid;
        gap: var(--erp-space-2);
        grid-template-columns: repeat(3, minmax(0, 1fr));
        min-inline-size: 0;
        overflow: hidden;
    }

    .preview-compact-grid span {
        min-block-size: 34px;
    }

    .homepage-template-preview-boldenergeticlanding {
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--erp-warning) 13%, var(--erp-surface)) 0%, var(--erp-surface) 72%);
    }

    .homepage-template-preview-minimalistlanding {
        background: var(--erp-surface);
    }

    .homepage-template-preview-softsaaslanding {
        background:
            linear-gradient(135deg, color-mix(in srgb, var(--erp-info) 12%, var(--erp-surface)) 0%, var(--erp-surface) 72%);
    }

    .homepage-template-preview-corporatetrustlanding {
        background:
            linear-gradient(180deg, color-mix(in srgb, var(--erp-primary) 9%, var(--erp-surface)) 0%, var(--erp-surface) 100%);
    }

    .homepage-template-preview-moderndarkmodelanding {
        background: color-mix(in srgb, var(--erp-text) 88%, var(--erp-primary));
        border-color: color-mix(in srgb, var(--erp-primary) 40%, var(--erp-border));
    }

    .homepage-template-preview-moderndarkmodelanding .template-preview-topbar,
    .homepage-template-preview-moderndarkmodelanding .preview-copy span,
    .homepage-template-preview-moderndarkmodelanding .preview-copy strong,
    .homepage-template-preview-moderndarkmodelanding .preview-offer {
        border-color: color-mix(in srgb, var(--erp-primary) 44%, transparent);
    }

    @@media (max-width: 575.98px) {
        .homepage-template-preview {
            block-size: 150px;
        }

        .template-preview-body.storefront,
        .template-preview-body.corporate,
        .template-preview-body.product-focus,
        .template-preview-body.campaign {
            grid-template-columns: minmax(0, 1fr) 64px;
        }

        .template-preview-body {
            padding: var(--erp-space-2);
        }
    }
</style>
