@page "/RealEstate/Expenses"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.RealEstate.Services
@using AlAfkarERP.Shared.Pages.Features.Suppliers.Services
@using SharedWithUI.RealEstate.Dtos
@using SharedWithUI.RealEstate.Enums
@using SharedWithUI.Suppliers.Dtos
@inject IRealEstateService RealEstateService
@inject ISupplierService SupplierService
@inject SharedDataService SharedDataService
@inject ApiConfig ApiConfig

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Property Expenses", "مصاريف العقارات")" Subtitle="@Text("Owner rent, utilities, furnishing, renovation, maintenance, and services.", "إيجار المالك والخدمات والتأثيث والترميم والصيانة.")" Icon="bi-receipt" />

    <article class="erp-card mb-3">
        <div class="erp-card-header"><strong>@(editingExpense.Id == Guid.Empty ? Text("New Expense", "مصروف جديد") : Text("Edit Expense", "تعديل مصروف"))</strong></div>
        <div class="erp-card-body">
            <EditForm Model="editingExpense" OnValidSubmit="SaveAsync">
                <div class="row g-3">
                    <div class="col-12 col-md-3"><label class="form-label">@Text("Property", "العقار")</label><select class="form-select" @bind="propertyIdText"><option value="">@Text("Select property", "اختر العقار")</option>@foreach (var property in properties) { <option value="@property.Id">@property.Name</option> }</select></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Category", "التصنيف")</label><InputSelect class="form-select" @bind-Value="editingExpense.Category">@foreach (var category in Enum.GetValues<ExpenseCategory>()) { <option value="@category">@category</option> }</InputSelect></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Date", "التاريخ")</label><InputDate class="form-control" @bind-Value="editingExpense.ExpenseDate" /></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Amount", "المبلغ")</label><InputNumber class="form-control" @bind-Value="editingExpense.Amount" /></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Tax", "الضريبة")</label><InputNumber class="form-control" @bind-Value="editingExpense.TaxAmount" /></div>
                    <div class="col-12 col-md-3"><label class="form-label">@Text("Supplier", "المورد")</label><select class="form-select" @bind="supplierIdText" @bind:after="OnSupplierChanged"><option value="">@Text("No supplier", "بدون مورد")</option>@foreach (var supplier in suppliers) { <option value="@supplier.Id">@supplier.Name</option> }</select></div>
                    <div class="col-12 col-md-3"><label class="form-label">@Text("Procurement Document", "مستند المشتريات")</label><InputText class="form-control" @bind-Value="editingExpense.SourceDocumentNumber" /></div>
                    <div class="col-12 col-md-3"><label class="form-label">@Text("Source Document Id", "معرف المستند")</label><input class="form-control" @bind="sourceDocumentIdText" /></div>
                    <div class="col-12 col-md-3 d-flex align-items-end"><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="editingExpense.IsRecoverableFromTenant" /><label class="form-check-label">@Text("Recoverable from tenant", "قابل للاسترداد من المستأجر")</label></div></div>
                    <div class="col-12"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputTextArea class="form-control" rows="2" @bind-Value="editingExpense.Notes" /></div>
                </div>
                <div class="d-flex gap-2 justify-content-end mt-3">
                    <button class="btn btn-outline-secondary" type="button" @onclick="ResetForm">@Text("Clear", "مسح")</button>
                    <button class="btn btn-primary" type="submit"><i class="bi bi-check2"></i> @Text("Save", "حفظ")</button>
                </div>
            </EditForm>
        </div>
    </article>

    <article class="erp-card">
        <div class="erp-card-body">
            @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger">@errorMessage</div> }
            <div class="row g-3 align-items-end mb-3">
                <div class="col-12 col-md-3"><label class="form-label">@Text("Filter Property", "تصفية العقار")</label><select class="form-select" @bind="filterPropertyIdText"><option value="">@Text("All", "الكل")</option>@foreach (var property in properties) { <option value="@property.Id">@property.Name</option> }</select></div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Category", "التصنيف")</label><select class="form-select" @bind="filterCategoryText"><option value="">@Text("All", "الكل")</option>@foreach (var category in Enum.GetValues<ExpenseCategory>()) { <option value="@category">@category</option> }</select></div>
                <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" @onclick="LoadExpensesAsync"><i class="bi bi-search"></i> @Text("Filter", "تصفية")</button></div>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>@Text("Date", "التاريخ")</th><th>@Text("Property", "العقار")</th><th>@Text("Category", "التصنيف")</th><th>@Text("Total", "الإجمالي")</th><th>@Text("Supplier", "المورد")</th><th>@Text("Source", "المصدر")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                    <tbody>@foreach (var item in expenses) { <tr><td>@item.ExpenseDate.ToShortDateString()</td><td>@item.PropertyName</td><td>@item.Category</td><td>@item.TotalAmount.ToString("N2")</td><td>@item.SupplierName</td><td>@item.SourceDocumentNumber</td><td class="text-end text-nowrap"><button class="btn btn-sm btn-outline-primary" @onclick="@(() => Edit(item))"><i class="bi bi-pencil"></i></button><button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteAsync(item.Id))"><i class="bi bi-trash"></i></button></td></tr> }</tbody>
                </table>
            </div>
        </div>
    </article>
</main>

@code {
    private List<PropertyDto> properties = [];
    private List<SupplierDto> suppliers = [];
    private List<PropertyExpenseDto> expenses = [];
    private PropertyExpenseDto editingExpense = NewExpense();
    private string propertyIdText = string.Empty;
    private string supplierIdText = string.Empty;
    private string sourceDocumentIdText = string.Empty;
    private string filterPropertyIdText = string.Empty;
    private string filterCategoryText = string.Empty;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        await LoadLookupsAsync();
        await LoadExpensesAsync();
    }

    private async Task LoadLookupsAsync()
    {
        var companyId = ApiConfig.CompanyId == Guid.Empty ? (Guid?)null : ApiConfig.CompanyId;
        properties = (await RealEstateService.GetPropertiesAsync(1, 500, companyId: companyId)).Data?.Data.ToList() ?? [];
        if (ApiConfig.CompanyId != Guid.Empty)
            suppliers = (await SupplierService.GetByCompanyAsync(ApiConfig.CompanyId, 1, 500)).Data?.Data.ToList() ?? [];
    }

    private async Task LoadExpensesAsync()
    {
        Guid? propertyId = Guid.TryParse(filterPropertyIdText, out var p) ? p : null;
        ExpenseCategory? category = Enum.TryParse<ExpenseCategory>(filterCategoryText, out var c) ? c : null;
        var companyId = ApiConfig.CompanyId == Guid.Empty ? (Guid?)null : ApiConfig.CompanyId;
        var result = await RealEstateService.GetExpensesAsync(1, 500, companyId, propertyId, category);
        expenses = result.Data?.Data.ToList() ?? [];
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
    }

    private async Task SaveAsync()
    {
        if (!Guid.TryParse(propertyIdText, out var propertyId))
        {
            errorMessage = Text("Property is required.", "العقار مطلوب.");
            return;
        }
        editingExpense.CompanyId = ApiConfig.CompanyId;
        editingExpense.PropertyId = propertyId;
        editingExpense.SourceDocumentId = Guid.TryParse(sourceDocumentIdText, out var sourceId) ? sourceId : null;
        OnSupplierChanged();
        var isSuccess = false;
        if (editingExpense.Id == Guid.Empty)
        {
            var result = await RealEstateService.CreateExpenseAsync(editingExpense);
            isSuccess = result.IsSuccess;
            errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        else
        {
            var result = await RealEstateService.UpdateExpenseAsync(editingExpense);
            isSuccess = result.IsSuccess;
            errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        if (isSuccess)
        {
            ResetForm();
            await LoadExpensesAsync();
        }
    }

    private void Edit(PropertyExpenseDto expense)
    {
        editingExpense = new PropertyExpenseDto
        {
            Id = expense.Id,
            CompanyId = expense.CompanyId,
            PropertyId = expense.PropertyId,
            UnitId = expense.UnitId,
            LeaseId = expense.LeaseId,
            Category = expense.Category,
            ExpenseDate = expense.ExpenseDate,
            Amount = expense.Amount,
            TaxAmount = expense.TaxAmount,
            SupplierId = expense.SupplierId,
            SupplierName = expense.SupplierName,
            IsRecoverableFromTenant = expense.IsRecoverableFromTenant,
            SourceDocumentId = expense.SourceDocumentId,
            SourceDocumentNumber = expense.SourceDocumentNumber,
            Notes = expense.Notes
        };
        propertyIdText = expense.PropertyId.ToString();
        supplierIdText = expense.SupplierId?.ToString() ?? string.Empty;
        sourceDocumentIdText = expense.SourceDocumentId?.ToString() ?? string.Empty;
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await RealEstateService.DeleteExpenseAsync(id);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        if (result.IsSuccess) await LoadExpensesAsync();
    }

    private void OnSupplierChanged()
    {
        editingExpense.SupplierId = Guid.TryParse(supplierIdText, out var supplierId) ? supplierId : null;
        editingExpense.SupplierName = suppliers.FirstOrDefault(x => x.Id == editingExpense.SupplierId)?.Name;
    }

    private void ResetForm()
    {
        editingExpense = NewExpense();
        propertyIdText = string.Empty;
        supplierIdText = string.Empty;
        sourceDocumentIdText = string.Empty;
    }

    private static PropertyExpenseDto NewExpense() => new() { ExpenseDate = DateTime.UtcNow.Date, Category = ExpenseCategory.Other };
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
