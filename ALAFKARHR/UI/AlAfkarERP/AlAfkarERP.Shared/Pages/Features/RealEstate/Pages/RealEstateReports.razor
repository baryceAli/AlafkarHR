@page "/RealEstate/Reports"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.RealEstate.Services
@using SharedWithUI.RealEstate.Dtos
@inject IRealEstateService RealEstateService
@inject SharedDataService SharedDataService
@inject ApiConfig ApiConfig

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Real Estate Reports", "تقارير العقارات")" Subtitle="@Text("Profitability, occupancy, overdue rent, owner payables, utilities, and expense breakdown.", "الربحية والإشغال والمتأخرات ومستحقات الملاك والخدمات وتفصيل المصاريف.")" Icon="bi-bar-chart-line" />

    @if (isLoading)
    {
        <AppCard CssClass="allow-overflow"><div class="text-muted">@Text("Loading reports...", "جاري تحميل التقارير...")</div></AppCard>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else if (reports is not null)
    {
        <AppCard CssClass="allow-overflow">

                <ul class="nav nav-tabs mb-3">
                    @foreach (var tab in tabs)
                    {
                        <li class="nav-item"><button class="nav-link @(activeTab == tab ? "active" : "")" @onclick="() => activeTab = tab">@TabTitle(tab)</button></li>
                    }
                </ul>

                @if (activeTab == "Profitability")
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Property", "العقار")</th><th>@Text("Expected", "المتوقع")</th><th>@Text("Collected", "المحصل")</th><th>@Text("Expenses", "المصاريف")</th><th>@Text("Net Profit", "صافي الربح")</th></tr></thead><tbody>@foreach (var item in reports.Profitability) { <tr><td>@item.PropertyName</td><td>@item.ExpectedRent.ToString("N2")</td><td>@item.CollectedRent.ToString("N2")</td><td>@item.Expenses.ToString("N2")</td><td>@item.NetProfit.ToString("N2")</td></tr> }</tbody></table></div>
                }
                else if (activeTab == "Occupancy")
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Property", "العقار")</th><th>@Text("Units", "الوحدات")</th><th>@Text("Occupied", "مشغولة")</th><th>@Text("Rate", "النسبة")</th></tr></thead><tbody>@foreach (var item in reports.Occupancy) { <tr><td>@item.PropertyName</td><td>@item.Units</td><td>@item.OccupiedUnits</td><td>@item.OccupancyRate.ToString("N2")%</td></tr> }</tbody></table></div>
                }
                else if (activeTab == "Overdue")
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Due", "الاستحقاق")</th><th>@Text("Period", "الفترة")</th><th>@Text("Amount", "المبلغ")</th><th>@Text("Paid", "المدفوع")</th><th>@Text("Remaining", "المتبقي")</th><th>@Text("Status", "الحالة")</th></tr></thead><tbody>@foreach (var item in reports.OverdueInstallments) { <tr><td>@item.DueDate.ToShortDateString()</td><td>@item.PeriodStart.ToShortDateString() - @item.PeriodEnd.ToShortDateString()</td><td>@item.Amount.ToString("N2")</td><td>@item.PaidAmount.ToString("N2")</td><td>@item.RemainingAmount.ToString("N2")</td><td><StatusChip Text="@item.Status.ToString()" Tone="muted" /></td></tr> }</tbody></table></div>
                }
                else if (activeTab == "OwnerPayables")
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Due", "الاستحقاق")</th><th>@Text("Period", "الفترة")</th><th>@Text("Amount", "المبلغ")</th><th>@Text("Paid", "المدفوع")</th><th>@Text("Remaining", "المتبقي")</th><th>@Text("Status", "الحالة")</th></tr></thead><tbody>@foreach (var item in reports.UpcomingOwnerPayables) { <tr><td>@item.DueDate.ToShortDateString()</td><td>@item.PeriodStart.ToShortDateString() - @item.PeriodEnd.ToShortDateString()</td><td>@item.Amount.ToString("N2")</td><td>@item.PaidAmount.ToString("N2")</td><td>@item.RemainingAmount.ToString("N2")</td><td><StatusChip Text="@item.Status.ToString()" Tone="muted" /></td></tr> }</tbody></table></div>
                }
                else if (activeTab == "Utilities")
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Due", "الاستحقاق")</th><th>@Text("Total", "الإجمالي")</th><th>@Text("Reference", "المرجع")</th></tr></thead><tbody>@foreach (var item in reports.UtilityAging) { <tr><td>@item.DueDate.ToShortDateString()</td><td>@item.TotalAmount.ToString("N2")</td><td>@item.Reference</td></tr> }</tbody></table></div>
                }
                else
                {
                    <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Category", "التصنيف")</th><th>@Text("Amount", "المبلغ")</th><th>@Text("Tax", "الضريبة")</th><th>@Text("Total", "الإجمالي")</th></tr></thead><tbody>@foreach (var item in reports.ExpenseSummary) { <tr><td>@item.Category</td><td>@item.Amount.ToString("N2")</td><td>@item.TaxAmount.ToString("N2")</td><td>@item.TotalAmount.ToString("N2")</td></tr> }</tbody></table></div>
                }

        </AppCard>
    }
</main>

@code {
    private RealEstateReportsDto? reports;
    private bool isLoading;
    private string? errorMessage;
    private readonly string[] tabs = ["Profitability", "Occupancy", "Overdue", "OwnerPayables", "Utilities", "Expenses"];
    private string activeTab = "Profitability";

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var companyId = ApiConfig.CompanyId == Guid.Empty ? (Guid?)null : ApiConfig.CompanyId;
        var result = await RealEstateService.GetReportsAsync(companyId);
        reports = result.Data;
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        isLoading = false;
    }

    private string TabTitle(string tab) => tab switch
    {
        "Profitability" => Text("Profitability", "الربحية"),
        "Occupancy" => Text("Occupancy", "الإشغال"),
        "Overdue" => Text("Overdue Rent", "الإيجارات المتأخرة"),
        "OwnerPayables" => Text("Owner Payables", "مستحقات الملاك"),
        "Utilities" => Text("Utilities", "الخدمات"),
        _ => Text("Expenses", "المصاريف")
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
