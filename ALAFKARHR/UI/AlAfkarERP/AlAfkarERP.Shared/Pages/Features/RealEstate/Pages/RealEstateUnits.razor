@page "/RealEstate/Units"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.RealEstate.Services
@using SharedWithUI.RealEstate.Dtos
@using SharedWithUI.RealEstate.Enums
@inject IRealEstateService RealEstateService
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Units", "الوحدات")" Subtitle="@Text("Apartments, offices, rooms, floors, and rentable spaces.", "الشقق والمكاتب والغرف والأدوار والمساحات القابلة للتأجير.")" Icon="bi-door-open">
        <Actions>
            <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/RealEstate/Units/Form"))"><i class="bi bi-plus-lg"></i> @Text("New Unit", "وحدة جديدة")</button>
        </Actions>
    </PageHeader>

    <AppCard CssClass="mb-3 allow-overflow">

            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">@Text("Search", "بحث")</label>
                    <input class="form-control" @bind="searchText" @bind:event="oninput" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label">@Text("Property", "العقار")</label>
                    <select class="form-select" @bind="propertyIdText">
                        <option value="">@Text("All properties", "كل العقارات")</option>
                        @foreach (var property in properties)
                        {
                            <option value="@property.Id">@property.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">@Text("Status", "الحالة")</label>
                    <select class="form-select" @bind="statusText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var status in Enum.GetValues<UnitStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-outline-primary w-100" @onclick="LoadAsync"><i class="bi bi-search"></i> @Text("Filter", "تصفية")</button>
                </div>
            </div>

    </AppCard>

    <AppCard CssClass="allow-overflow">

            @if (isLoading)
            {
                <div class="text-muted">@Text("Loading units...", "جاري تحميل الوحدات...")</div>
            }
            else if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="alert alert-danger">@errorMessage</div>
            }
            else if (FilteredUnits.Count == 0)
            {
                <div class="text-muted">@Text("No units found.", "لا توجد وحدات.")</div>
            }
            else
            {
                <div class="erp-table-wrap">
                    <table class="table align-middle erp-table">
                        <thead><tr><th>@Text("Property", "العقار")</th><th>@Text("Unit", "الوحدة")</th><th>@Text("Type", "النوع")</th><th>@Text("Status", "الحالة")</th><th>@Text("Floor", "الدور")</th><th>@Text("Maintenance", "الصيانة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                        <tbody>
                            @foreach (var item in FilteredUnits)
                            {
                                <tr>
                                    <td>@item.PropertyName</td>
                                    <td><strong>@item.UnitNumber</strong><div class="text-muted small">@item.Name</div></td>
                                    <td>@item.UnitType</td>
                                    <td><StatusChip Text="@item.Status.ToString()" Tone="muted" /></td>
                                    <td>@item.Floor</td>
                                    <td>@Text("Linked asset", "أصل مرتبط")</td>
                                    <td class="text-end text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="@(() => NavigationManager.NavigateTo($"/RealEstate/Units/Form/{item.Id}"))"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="@(() => DeleteAsync(item.Id))"><i class="bi bi-trash"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

    </AppCard>
</main>

@code {
    private List<PropertyDto> properties = [];
    private List<PropertyUnitDto> units = [];
    private bool isLoading;
    private string searchText = string.Empty;
    private string propertyIdText = string.Empty;
    private string? errorMessage;
    private List<PropertyUnitDto> FilteredUnits => units.Where(x => string.IsNullOrWhiteSpace(statusText) || x.Status.ToString() == statusText).ToList();
    private string statusText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        await LoadLookupsAsync();
        await LoadAsync();
    }

    private async Task LoadLookupsAsync()
    {
        var result = await RealEstateService.GetPropertiesAsync(1, 500);
        properties = result.Data?.Data.ToList() ?? [];
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        Guid? propertyId = Guid.TryParse(propertyIdText, out var parsed) ? parsed : null;
        var result = await RealEstateService.GetUnitsAsync(1, 200, searchText, propertyId);
        units = result.Data?.Data.ToList() ?? [];
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        isLoading = false;
    }

    private async Task DeleteAsync(Guid id)
    {
        var result = await RealEstateService.DeleteUnitAsync(id);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        if (result.IsSuccess) await LoadAsync();
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
