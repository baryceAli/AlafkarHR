@layout AdminLayout
@page "/DocumentManagement/SharedWithMe"
@implements IDisposable

@using SharedWithUI.DocumentManagement.Enums

@inject SharedDataService SharedDataService

<DocumentLibraryView Title="@Text("Shared With Me", "مشاركة معي")"
                     Subtitle="@Text("Documents other employees invited you to access.", "المستندات التي دعاك موظفون آخرون للوصول إليها.")"
                     Icon="bi-people"
                     Scope="DocumentListScope.SharedWithMe" />

@code {
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
