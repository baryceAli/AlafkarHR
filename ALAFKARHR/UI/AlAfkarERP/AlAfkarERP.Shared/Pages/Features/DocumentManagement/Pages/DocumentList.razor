@layout AdminLayout
@page "/DocumentManagement/List"
@implements IDisposable

@using SharedWithUI.DocumentManagement.Enums

@inject SharedDataService SharedDataService

<div dir="@SharedDataService.PageDirection">
<DocumentLibraryView Title="@Text("Document Library", "مكتبة المستندات")"
                     Subtitle="@Text("All documents you can view, edit, or manage.", "كل المستندات التي يمكنك عرضها أو تحريرها أو إدارتها.")"
                     Icon="bi-folder2-open"
                     Scope="DocumentListScope.All" />
</div>

@code {
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
