@layout AdminLayout
@page "/DocumentManagement/View/{Id:guid}"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.DocumentManagement.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.DocumentManagement.Dtos
@using SharedWithUI.DocumentManagement.Enums
@using SharedWithUI.Permissions

@inject IDocumentManagementService DocumentService
@inject IUserService UserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject ModalService ModalService
@inject IJSRuntime JS

@if (!CanView)
{
    <div class="alert alert-warning" dir="@SharedDataService.PageDirection">@Text("You do not have permission to view this document.", "ليس لديك صلاحية لعرض هذا المستند.")</div>
    return;
}

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@(document?.Title ?? Text("Document", "مستند"))"
                Subtitle="@Text("Versions and collaboration", "الإصدارات والتعاون")"
                Icon="bi-file-earmark-text"
                Actions="@HeaderActions" />

    @if (document is null)
    {
        <AppCard>
            <div class="text-center text-muted py-4">@Text("Loading document...", "جاري تحميل المستند...")</div>
        </AppCard>
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-7">
                <AppCard Title="@Text("Metadata", "البيانات")" CssClass="mb-3">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@Text("Title", "العنوان")</label>
                            <input class="form-control" disabled="@(!document.CanWrite)" @bind="editModel.Title" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Text("Source module", "الوحدة المرتبطة")</label>
                            <input class="form-control" disabled="@(!document.CanWrite)" @bind="editModel.SourceModule" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Text("Source entity", "الكيان المرتبط")</label>
                            <input class="form-control" disabled="@(!document.CanWrite)" @bind="editModel.SourceEntity" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@Text("Source record id", "رقم السجل المرتبط")</label>
                            <input class="form-control" disabled="@(!document.CanWrite)" @bind="editSourceRecordIdText" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Text("Description", "الوصف")</label>
                            <textarea class="form-control" rows="3" disabled="@(!document.CanWrite)" @bind="editModel.Description"></textarea>
                        </div>
                        <div class="col-12 d-flex justify-content-end">
                            <button class="btn btn-primary" disabled="@(!document.CanWrite || isSaving)" @onclick="SaveMetadata">
                                <i class="bi bi-save"></i> @Text("Save", "حفظ")
                            </button>
                        </div>
                    </div>
                </AppCard>

                <AppCard Title="@Text("Versions", "الإصدارات")">
                    @if (document.CanWrite)
                    {
                        <div class="mb-3">
                            <DocumentMediaUpload Mode="DocumentMediaUploadMode.UploadVersion"
                                                 Preset="DocumentUploadPreset.All"
                                                 DocumentId="@document.Id"
                                                 IsBusy="@isSaving"
                                                 OnVersionUploaded="HandleVersionUploaded"
                                                 UploadButtonText="@Text("Upload version", "رفع إصدار")" />
                        </div>
                    }

                    <div class="erp-table-wrap">
                        <table class="table erp-table align-middle">
                            <thead>
                                <tr>
                                    <th>@Text("Version", "الإصدار")</th>
                                    <th>@Text("File", "الملف")</th>
                                    <th>@Text("Uploaded", "تاريخ الرفع")</th>
                                    <th class="text-end">@Text("Actions", "الإجراءات")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var version in document.Versions)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">v@version.VersionNumber</span></td>
                                        <td>
                                            <div>@version.OriginalFileName</div>
                                            <small class="text-muted">@FormatFileSize(version.FileSize)</small>
                                        </td>
                                        <td>@version.UploadedAt.ToLocalTime()</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary erp-row-action" @onclick="() => Download(version.Id)" title="@Text("Download", "تنزيل")">
                                                <i class="bi bi-download"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </AppCard>
            </div>

            <div class="col-lg-5">
                <AppCard Title="@Text("Collaborators", "المتعاونون")">
                    @if (document.CanShare)
                    {
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <AutoCompleteComponent TItem="UserDto"
                                                       Items="@users"
                                                       ItemText="UserDisplayName"
                                                       Value="@inviteUser"
                                                       ValueChanged="OnInviteUserChanged"
                                                       PlaceHolder="@Text("Search employee", "ابحث عن موظف")" />
                            </div>
                            <div class="col-5">
                                <select class="form-select" @bind="inviteAccess">
                                    <option value="@DocumentAccessLevel.Read">@Text("Read only", "قراءة فقط")</option>
                                    <option value="@DocumentAccessLevel.ReadWrite">@Text("Read/write", "قراءة وكتابة")</option>
                                </select>
                            </div>
                            <div class="col-12 d-flex justify-content-end">
                                <button class="btn btn-outline-primary" disabled="@(inviteUser is null || isSaving)" @onclick="InviteCollaborator">
                                    <i class="bi bi-person-plus"></i> @Text("Invite", "دعوة")
                                </button>
                            </div>
                        </div>
                    }

                    @if (!document.Collaborators.Any())
                    {
                        <div class="text-muted py-3">@Text("No collaborators yet.", "لا يوجد متعاونون بعد.")</div>
                    }
                    @foreach (var collaborator in document.Collaborators)
                    {
                        <div class="d-flex align-items-center justify-content-between gap-2 border-bottom py-2">
                            <div>
                                <div class="fw-semibold">@(!string.IsNullOrWhiteSpace(collaborator.UserName) ? collaborator.UserName : collaborator.UserId)</div>
                                <small class="text-muted">@AccessText(collaborator.AccessLevel)</small>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select form-select-sm document-collaborator-access" disabled="@(!document.CanShare)" value="@GetCollaboratorAccess(collaborator)" @onchange="args => SetCollaboratorAccess(collaborator.Id, args.Value?.ToString())">
                                    <option value="@DocumentAccessLevel.Read">@Text("Read only", "قراءة فقط")</option>
                                    <option value="@DocumentAccessLevel.ReadWrite">@Text("Read/write", "قراءة وكتابة")</option>
                                </select>
                                <button class="btn btn-sm btn-outline-primary" title="@Text("Save access", "حفظ الصلاحية")" disabled="@(!document.CanShare || isSaving || !CollaboratorAccessChanged(collaborator))" @onclick="() => UpdateCollaboratorAccess(collaborator)">
                                    <i class="bi bi-save"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" title="@Text("Remove", "حذف")" disabled="@(!document.CanShare || isSaving)" @onclick="() => RemoveCollaborator(collaborator.Id)">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </div>
                    }
                </AppCard>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private DocumentDetailDto? document;
    private UpdateDocumentDto editModel = new();
    private string editSourceRecordIdText = string.Empty;
    private List<UserDto> users = [];
    private Dictionary<Guid, DocumentAccessLevel> collaboratorAccessEdits = [];
    private UserDto? inviteUser;
    private DocumentAccessLevel inviteAccess = DocumentAccessLevel.Read;
    private Guid companyId;
    private bool CanView;
    private bool isSaving;

    private RenderFragment HeaderActions => @<div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/DocumentManagement/List")'>
            <i class="bi bi-arrow-return-left"></i> @Text("Back", "رجوع")
        </button>
        <button class="btn btn-primary" disabled="@(document is null)" @onclick="() => Download(null)">
            <i class="bi bi-download"></i> @Text("Download Latest", "تنزيل الأحدث")
        </button>
        <button class="btn btn-outline-danger" disabled="@(document?.CanDelete != true || isSaving)" @onclick="ConfirmArchive" title="@Text("Archive metadata only", "أرشفة البيانات فقط")">
            <i class="bi bi-archive"></i> @Text("Archive", "أرشفة")
        </button>
        <button class="btn btn-outline-danger" disabled="@(document?.CanDeleteStorage != true || isSaving)" @onclick="ConfirmDeleteStorage" title="@Text("Delete stored files", "حذف الملفات المخزنة")">
            <i class="bi bi-trash3"></i>
        </button>
    </div>;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        CanView = authState.User.Claims.Any(c =>
            c.Value == PermissionList.DocumentManagementPermissions.View
            || c.Value == PermissionList.DocumentManagementPermissions.Select
            || c.Value == PermissionList.DocumentManagementPermissions.ManageAll);
        if (!CanView)
            return;

        Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out companyId);
        await LoadDocument();
        await LoadUsers();
    }

    private async Task LoadDocument()
    {
        var response = await DocumentService.GetByIdAsync(Id);
        if (response.IsSuccess && response.Data is not null)
        {
            document = response.Data;
            editModel = new UpdateDocumentDto
            {
                Id = document.Id,
                Title = document.Title,
                Description = document.Description,
                SourceModule = document.SourceModule,
                SourceEntity = document.SourceEntity,
                SourceRecordId = document.SourceRecordId
            };
            editSourceRecordIdText = document.SourceRecordId?.ToString() ?? string.Empty;
            collaboratorAccessEdits = document.Collaborators.ToDictionary(x => x.Id, x => x.AccessLevel);
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load document.", "تعذر تحميل المستند."));
        }
    }

    private async Task LoadUsers()
    {
        if (companyId == Guid.Empty)
            return;

        var response = await UserService.GetUsersByCompany(companyId, 0, 10000);
        if (response.IsSuccess)
            users = response.Data?.Data.ToList() ?? [];
    }

    private async Task SaveMetadata()
    {
        if (document is null || string.IsNullOrWhiteSpace(editModel.Title))
            return;

        if (!string.IsNullOrWhiteSpace(editSourceRecordIdText) && !Guid.TryParse(editSourceRecordIdText, out _))
        {
            ToastService.ShowError(Text("Source record id must be a valid GUID.", "رقم السجل المرتبط يجب أن يكون معرف GUID صحيح."));
            return;
        }

        editModel.SourceRecordId = Guid.TryParse(editSourceRecordIdText, out var sourceRecordId) ? sourceRecordId : null;
        isSaving = true;
        var response = await DocumentService.UpdateAsync(editModel);
        isSaving = false;
        if (response.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Document saved.", "تم حفظ المستند."));
            await LoadDocument();
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to save document.", "تعذر حفظ المستند."));
        }
    }

    private async Task HandleVersionUploaded() => await LoadDocument();

    private async Task ConfirmArchive()
    {
        if (document is null || !document.CanDelete)
            return;

        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Archive document", "أرشفة المستند"),
            Message = Text("Archive metadata only? Stored files will remain in the configured storage location.", "هل تريد أرشفة البيانات فقط؟ ستبقى الملفات في موقع التخزين المكون."),
            Details = document.Title,
            ShowCancel = true,
            Variant = ModalVariant.Warning,
            OkText = Text("Archive", "أرشفة"),
            CancelText = Text("Cancel", "إلغاء"),
            OnOk = ArchiveDocument
        });
    }

    private async Task ArchiveDocument()
    {
        if (document is null || !document.CanDelete)
            return;

        isSaving = true;
        try
        {
            var response = await DocumentService.DeleteAsync(document.Id);
            if (response.IsSuccess)
            {
                ToastService.ShowSuccess(Text("Document archived.", "تمت أرشفة المستند."));
                NavigationManager.NavigateTo("/DocumentManagement/List");
            }
            else
            {
                ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to archive document.", "تعذر أرشفة المستند."));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ConfirmDeleteStorage()
    {
        if (document is null || !document.CanDeleteStorage)
            return;

        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Delete stored files", "حذف الملفات المخزنة"),
            Message = Text("Delete every stored version file, then archive the document metadata? This requires document delete permission.", "هل تريد حذف كل ملفات الإصدارات المخزنة ثم أرشفة بيانات المستند؟ يتطلب ذلك صلاحية حذف المستندات."),
            Details = document.Title,
            ShowCancel = true,
            Variant = ModalVariant.Danger,
            OkText = Text("Delete files", "حذف الملفات"),
            CancelText = Text("Cancel", "إلغاء"),
            OnOk = DeleteStorage
        });
    }

    private async Task DeleteStorage()
    {
        if (document is null || !document.CanDeleteStorage)
            return;

        isSaving = true;
        try
        {
            var response = await DocumentService.DeleteStorageAsync(document.Id);
            if (response.IsSuccess)
            {
                ToastService.ShowSuccess(Text("Stored files deleted and document archived.", "تم حذف الملفات المخزنة وأرشفة المستند."));
                NavigationManager.NavigateTo("/DocumentManagement/List");
            }
            else
            {
                ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to delete stored files.", "تعذر حذف الملفات المخزنة."));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private Task OnInviteUserChanged(UserDto? user)
    {
        inviteUser = user;
        return Task.CompletedTask;
    }

    private string UserDisplayName(UserDto user) =>
        !string.IsNullOrWhiteSpace(user.UserName) ? user.UserName : user.Id.ToString();

    private async Task InviteCollaborator()
    {
        if (document is null || inviteUser is null)
            return;

        isSaving = true;
        try
        {
            var response = await DocumentService.InviteCollaboratorAsync(document.Id, new InviteDocumentCollaboratorDto
            {
                UserId = inviteUser.Id,
                UserName = inviteUser.UserName,
                AccessLevel = inviteAccess
            });

            if (response.IsSuccess)
            {
                ToastService.ShowSuccess(Text("Collaborator saved.", "تم حفظ المتعاون."));
                inviteUser = null;
                await LoadDocument();
            }
            else
            {
                ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to invite collaborator.", "تعذر دعوة المتعاون."));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private DocumentAccessLevel GetCollaboratorAccess(DocumentCollaboratorDto collaborator) =>
        collaboratorAccessEdits.TryGetValue(collaborator.Id, out var accessLevel) ? accessLevel : collaborator.AccessLevel;

    private void SetCollaboratorAccess(Guid collaboratorId, string? value)
    {
        if (Enum.TryParse<DocumentAccessLevel>(value, out var accessLevel))
            collaboratorAccessEdits[collaboratorId] = accessLevel;
    }

    private bool CollaboratorAccessChanged(DocumentCollaboratorDto collaborator) =>
        GetCollaboratorAccess(collaborator) != collaborator.AccessLevel;

    private async Task UpdateCollaboratorAccess(DocumentCollaboratorDto collaborator)
    {
        if (document is null)
            return;

        isSaving = true;
        var response = await DocumentService.InviteCollaboratorAsync(document.Id, new InviteDocumentCollaboratorDto
        {
            UserId = collaborator.UserId,
            UserName = collaborator.UserName,
            AccessLevel = GetCollaboratorAccess(collaborator)
        });
        isSaving = false;

        if (response.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Collaborator access saved.", "تم حفظ صلاحية المتعاون."));
            await LoadDocument();
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to save collaborator access.", "تعذر حفظ صلاحية المتعاون."));
        }
    }

    private async Task RemoveCollaborator(Guid collaboratorId)
    {
        if (document is null)
            return;

        var response = await DocumentService.RemoveCollaboratorAsync(document.Id, collaboratorId);
        if (response.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Collaborator removed.", "تم حذف المتعاون."));
            await LoadDocument();
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to remove collaborator.", "تعذر حذف المتعاون."));
        }
    }

    private async Task Download(Guid? versionId)
    {
        if (document is null)
            return;

        var response = await DocumentService.DownloadAsync(document.Id, versionId);
        if (response.IsSuccess && response.Data is not null)
            await JS.InvokeVoidAsync("alafkarDocumentDownload.downloadBase64", response.Data.FileName, response.Data.ContentType, response.Data.Base64Content);
        else
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Download failed.", "فشل التنزيل."));
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024d:0.#} KB";
        return $"{bytes / 1024d / 1024d:0.#} MB";
    }

    private string AccessText(DocumentAccessLevel accessLevel) =>
        accessLevel == DocumentAccessLevel.ReadWrite ? Text("Read and write", "قراءة وكتابة") : Text("Read only", "قراءة فقط");

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
