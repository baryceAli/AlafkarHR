@layout AdminLayout
@page "/DocumentManagement/MyDocuments"
@implements IDisposable

@using SharedWithUI.DocumentManagement.Enums

@inject SharedDataService SharedDataService

<DocumentLibraryView Title="@Text("My Documents", "مستنداتي")"
                     Subtitle="@Text("Documents you created and own.", "المستندات التي أنشأتها وتملكها.")"
                     Icon="bi-person-lines-fill"
                     Scope="DocumentListScope.OwnedByMe" />

@code {
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
