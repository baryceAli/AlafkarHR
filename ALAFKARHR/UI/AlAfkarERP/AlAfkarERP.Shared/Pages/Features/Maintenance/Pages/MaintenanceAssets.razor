@page "/Maintenance/Assets"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Maintenance.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.Maintenance.Dtos
@using SharedWithUI.Maintenance.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions
@inject IMaintenanceService MaintenanceService
@inject IBranchService BranchService
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Maintenance Assets", "أصول الصيانة")"
                Subtitle="@Text("Browse buildings, apartments, offices, equipment, and future fleet assets.", "استعراض المباني والشقق والمكاتب والمعدات وأصول الأسطول المستقبلية.")"
                Icon="bi-buildings">
        <Actions>
            @if (Can(PermissionList.MaintenanceAssetPermissions.Create))
            {
                <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/Maintenance/Assets/Form"))">
                    <i class="bi bi-plus-lg"></i>
                    @Text("New Asset", "أصل جديد")
                </button>
            }
        </Actions>
    </PageHeader>

    <AppCard CssClass="mb-3 allow-overflow">

            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label">@Text("Search", "بحث")</label>
                    <input class="form-control" @bind="searchText" @bind:event="oninput" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Type", "النوع")</label>
                    <select class="form-select" @bind="assetTypeText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var type in Enum.GetValues<MaintenanceAssetType>())
                        {
                            <option value="@type">@type</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Status", "الحالة")</label>
                    <select class="form-select" @bind="statusText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var status in Enum.GetValues<MaintenanceAssetStatus>())
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-2">
                    <label class="form-label">@Text("Branch", "الفرع")</label>
                    <select class="form-select" @bind="branchIdText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var branch in branches)
                        {
                            <option value="@branch.Id">@LocalizedName(branch.NameEng, branch.Name)</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-lg-2">
                    <label class="form-label">@Text("Parent Asset", "الأصل الرئيسي")</label>
                    <AutoCompleteComponent TItem="MaintenanceAssetDto"
                                           Items="parentAssetOptions"
                                           ItemText="AssetText"
                                           Value="selectedParentAsset"
                                           ValueChanged="OnParentFilterChanged"
                                           PlaceHolder="@Text("Search parent", "ابحث عن أصل رئيسي")" />
                </div>
                <div class="col-12 col-lg-1">
                    <button class="btn btn-outline-secondary w-100" @onclick="ApplyFiltersAsync" title="@Text("Apply", "تطبيق")">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>

    </AppCard>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <AppCard>
        <div class="erp-table-wrap">
            <table class="erp-table table">
                <thead>
                    <tr>
                        <th>@Text("Code", "الكود")</th>
                        <th>@Text("Name", "الاسم")</th>
                        <th>@Text("Type", "النوع")</th>
                        <th>@Text("Status", "الحالة")</th>
                        <th>@Text("Branch scope", "نطاق الفرع")</th>
                        <th>@Text("Parent", "الأصل الرئيسي")</th>
                        <th>@Text("Location", "الموقع")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="8" class="text-muted">@Text("Loading assets...", "جاري تحميل الأصول...")</td></tr>
                    }
                    else if (!assets.Any())
                    {
                        <tr><td colspan="8" class="text-muted">@Text("No assets found.", "لا توجد أصول.")</td></tr>
                    }
                    else
                    {
                        @foreach (var asset in assets)
                        {
                            <tr>
                                <td class="fw-semibold">@asset.AssetCode</td>
                                <td>@LocalizedName(asset.NameEng, asset.Name)</td>
                                <td><StatusChip Text="@asset.AssetType.ToString()" Tone="info" /></td>
                                <td><StatusChip Text="@asset.Status.ToString()" Tone="@AssetStatusTone(asset.Status)" /></td>
                                <td><span class="badge bg-light text-dark border">@BranchScopeLabel(asset.BranchId)</span></td>
                                <td>@asset.ParentAssetName</td>
                                <td>@asset.Location</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="@Text("View", "عرض")" @onclick="@(() => NavigationManager.NavigateTo($"/Maintenance/Assets/View/{asset.Id}"))">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        @if (Can(PermissionList.MaintenanceAssetPermissions.Edit))
                                        {
                                            <button class="btn btn-outline-secondary" title="@Text("Edit", "تعديل")" @onclick="@(() => NavigationManager.NavigateTo($"/Maintenance/Assets/Form/{asset.Id}"))">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                        }
                                        @if (Can(PermissionList.MaintenanceAssetPermissions.Delete))
                                        {
                                            <button class="btn btn-outline-danger" title="@Text("Delete", "حذف")" @onclick="@(() => DeleteAsync(asset))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="text-muted small">@Text("Total", "الإجمالي"): @totalCount</div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(pageIndex == 0 || isLoading)" @onclick="PreviousPageAsync">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="small">@Text("Page", "صفحة") @(pageIndex + 1)</span>
                    <button class="btn btn-sm btn-outline-secondary" disabled="@(!HasNextPage || isLoading)" @onclick="NextPageAsync">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                    <select class="form-select form-select-sm" @bind="pageSize" @bind:after="ApplyFiltersAsync">
                        <option value="10">10</option>
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

    </AppCard>
</main>

@code {
    private List<MaintenanceAssetDto> assets = [];
    private List<MaintenanceAssetDto> parentAssetOptions = [];
    private List<BranchDto> branches = [];
    private MaintenanceAssetDto? selectedParentAsset;
    private string searchText = string.Empty;
    private string assetTypeText = string.Empty;
    private string statusText = string.Empty;
    private string branchIdText = string.Empty;
    private Guid companyId;
    private int pageIndex;
    private int pageSize = 25;
    private long totalCount;
    private bool isLoading = true;
    private string? errorMessage;
    private AuthenticationState? authState;

    private bool HasNextPage => (pageIndex + 1) * pageSize < totalCount;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthStateProvider.GetAuthenticationStateAsync();
        companyId = ResolveCompanyId();
        await LoadBranchesAsync();
        await LoadParentOptionsAsync();
        ReadQueryFilters();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        errorMessage = null;
        var result = await MaintenanceService.GetAssetsAsync(
            pageIndex,
            pageSize,
            searchText,
            ParseAssetType(),
            ParseAssetStatus(),
            companyId == Guid.Empty ? null : companyId,
            ParseGuid(branchIdText),
            selectedParentAsset?.Id);

        if (result.IsSuccess)
        {
            assets = result.Data?.Data.ToList() ?? [];
            totalCount = result.Data?.Count ?? 0;
        }
        else
        {
            assets = [];
            totalCount = 0;
            errorMessage = result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load assets.", "تعذر تحميل الأصول.");
        }
        isLoading = false;
    }

    private async Task ApplyFiltersAsync()
    {
        pageIndex = 0;
        await LoadAsync();
    }

    private async Task NextPageAsync()
    {
        if (!HasNextPage)
            return;
        pageIndex++;
        await LoadAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (pageIndex == 0)
            return;
        pageIndex--;
        await LoadAsync();
    }

    private async Task DeleteAsync(MaintenanceAssetDto asset)
    {
        var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", Text("Delete this asset?", "هل تريد حذف هذا الأصل؟"));
        if (!confirmed)
            return;

        var result = await MaintenanceService.DeleteAssetAsync(asset.Id);
        if (!result.IsSuccess)
        {
            errorMessage = result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to delete asset.", "تعذر حذف الأصل.");
            return;
        }

        await LoadParentOptionsAsync();
        await LoadAsync();
    }

    private async Task LoadBranchesAsync()
    {
        if (companyId == Guid.Empty)
            return;

        var result = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadParentOptionsAsync()
    {
        var result = await MaintenanceService.GetAssetsAsync(0, 1000, companyId: companyId == Guid.Empty ? null : companyId);
        parentAssetOptions = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private void ReadQueryFilters()
    {
        var query = ParseQuery();
        if (query.TryGetValue("assetType", out var assetType))
            assetTypeText = assetType;
        if (query.TryGetValue("status", out var status))
            statusText = status;
        if (query.TryGetValue("branchId", out var branchId))
            branchIdText = branchId;
        if (query.TryGetValue("parentAssetId", out var parentAssetId) && Guid.TryParse(parentAssetId, out var parentId))
            selectedParentAsset = parentAssetOptions.FirstOrDefault(x => x.Id == parentId);
    }

    private Dictionary<string, string> ParseQuery()
    {
        var uri = new Uri(NavigationManager.Uri);
        return uri.Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2)
            .ToDictionary(parts => Uri.UnescapeDataString(parts[0]), parts => Uri.UnescapeDataString(parts[1]));
    }

    private Task OnParentFilterChanged(MaintenanceAssetDto? asset)
    {
        selectedParentAsset = asset;
        return Task.CompletedTask;
    }

    private MaintenanceAssetType? ParseAssetType() => Enum.TryParse<MaintenanceAssetType>(assetTypeText, out var value) ? value : null;
    private MaintenanceAssetStatus? ParseAssetStatus() => Enum.TryParse<MaintenanceAssetStatus>(statusText, out var value) ? value : null;
    private Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private Guid ResolveCompanyId() => Guid.TryParse(authState?.User.Claims.FirstOrDefault(claim => claim.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    private bool Can(string permission) => authState?.User.Claims.Any(claim => claim.Value == permission) == true;
    private string AssetStatusTone(MaintenanceAssetStatus status) => status == MaintenanceAssetStatus.Active ? "success" : status == MaintenanceAssetStatus.UnderMaintenance ? "warning" : "muted";
    private string AssetText(MaintenanceAssetDto asset) => $"{asset.AssetCode} - {LocalizedName(asset.NameEng, asset.Name)}";
    private string BranchScopeLabel(Guid? branchId) =>
        branchId.HasValue
            ? BranchName(branchId.Value)
            : Text("Company-level/shared", "على مستوى الشركة / مشترك");

    private string BranchName(Guid branchId)
    {
        var branch = branches.FirstOrDefault(x => x.Id == branchId);
        return branch is null ? Text("Unknown branch", "فرع غير معروف") : LocalizedName(branch.NameEng, branch.Name);
    }

    private string LocalizedName(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
