@page "/Maintenance/Assets/Form"
@page "/Maintenance/Assets/Form/{Id:guid}"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Maintenance.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Maintenance.Dtos
@using SharedWithUI.Maintenance.Enums
@using SharedWithUI.Organization.Dtos
@inject IMaintenanceService MaintenanceService
@inject IBranchService BranchService
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text(Id.HasValue ? "Edit Asset" : "New Asset", Id.HasValue ? "تعديل أصل" : "أصل جديد")"
                Subtitle="@Text("Register a maintainable asset for facilities, offices, equipment, or future fleet use.", "تسجيل أصل قابل للصيانة للمرافق أو المكاتب أو المعدات أو الأسطول مستقبلا.")"
                Icon="bi-buildings" />

    <EditForm Model="model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />
        <section class="erp-card">
            <div class="erp-card-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                <div class="row g-3">
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("Asset Code", "كود الأصل")</label>
                        <InputText class="form-control" @bind-Value="model.AssetCode" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("Arabic Name", "الاسم العربي")</label>
                        <InputText class="form-control" @bind-Value="model.Name" />
                        <ValidationMessage For="@(() => model.Name)" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("English Name", "الاسم الإنجليزي")</label>
                        <InputText class="form-control" @bind-Value="model.NameEng" />
                        <ValidationMessage For="@(() => model.NameEng)" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Type", "النوع")</label>
                        <InputSelect class="form-select" @bind-Value="model.AssetType">
                            @foreach (var type in Enum.GetValues<MaintenanceAssetType>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Status", "الحالة")</label>
                        <InputSelect class="form-select" @bind-Value="model.Status">
                            @foreach (var status in Enum.GetValues<MaintenanceAssetStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Company", "الشركة")</label>
                        <input class="form-control" value="@companyId" readonly dir="ltr" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Branch", "الفرع")</label>
                        <select class="form-select" @bind="branchIdText">
                            <option value="">@Text("No branch", "بدون فرع")</option>
                            @foreach (var branch in branches)
                            {
                                <option value="@branch.Id">@LocalizedName(branch.NameEng, branch.Name)</option>
                            }
                        </select>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Text("Parent Asset", "الأصل الرئيسي")</label>
                        <AutoCompleteComponent TItem="MaintenanceAssetDto"
                                               Items="parentAssetOptions"
                                               ItemText="AssetText"
                                               Value="selectedParentAsset"
                                               ValueChanged="OnParentAssetChanged"
                                               PlaceHolder="@Text("Search parent asset", "ابحث عن الأصل الرئيسي")" />
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label">@Text("Location", "الموقع")</label>
                        <InputText class="form-control" @bind-Value="model.Location" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("Serial Number", "الرقم التسلسلي")</label>
                        <InputText class="form-control" @bind-Value="model.SerialNumber" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("Purchase Date", "تاريخ الشراء")</label>
                        <InputDate class="form-control" @bind-Value="model.PurchaseDate" />
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">@Text("Warranty End", "نهاية الضمان")</label>
                        <InputDate class="form-control" @bind-Value="model.WarrantyEndDate" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@Text("Description", "الوصف")</label>
                        <InputTextArea class="form-control" @bind-Value="model.Description" />
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4">
                    <button class="btn btn-primary" type="submit" disabled="@isSaving">
                        <i class="bi bi-save"></i>
                        @Text("Save", "حفظ")
                    </button>
                    <button class="btn btn-outline-secondary" type="button" @onclick="@(() => NavigationManager.NavigateTo("/Maintenance/Assets"))">
                        @Text("Cancel", "إلغاء")
                    </button>
                </div>
            </div>
        </section>
    </EditForm>
</main>

@code {
    [Parameter] public Guid? Id { get; set; }

    private UpdateMaintenanceAssetDto model = new();
    private List<BranchDto> branches = [];
    private List<MaintenanceAssetDto> parentAssetOptions = [];
    private MaintenanceAssetDto? selectedParentAsset;
    private Guid companyId;
    private string branchIdText = string.Empty;
    private bool isSaving;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        companyId = Guid.TryParse(authState.User.Claims.FirstOrDefault(claim => claim.Type == "company_id")?.Value, out var claimCompanyId) ? claimCompanyId : Guid.Empty;
        model.CompanyId = companyId;
        await LoadBranchesAsync();
        await LoadParentOptionsAsync();

        if (Id.HasValue)
            await LoadAssetAsync(Id.Value);
        else
            ApplyQueryDefaults();
    }

    private async Task LoadAssetAsync(Guid id)
    {
        var result = await MaintenanceService.GetAssetByIdAsync(id);
        if (!result.IsSuccess || result.Data is null)
            return;

        model = new UpdateMaintenanceAssetDto
        {
            Id = result.Data.Id,
            AssetCode = result.Data.AssetCode,
            Name = result.Data.Name,
            NameEng = result.Data.NameEng,
            AssetType = result.Data.AssetType,
            Status = result.Data.Status,
            CompanyId = result.Data.CompanyId,
            BranchId = result.Data.BranchId,
            ParentAssetId = result.Data.ParentAssetId,
            Description = result.Data.Description,
            Location = result.Data.Location,
            SerialNumber = result.Data.SerialNumber,
            PurchaseDate = result.Data.PurchaseDate,
            WarrantyEndDate = result.Data.WarrantyEndDate
        };
        companyId = model.CompanyId;
        branchIdText = model.BranchId?.ToString() ?? string.Empty;
        selectedParentAsset = parentAssetOptions.FirstOrDefault(x => x.Id == model.ParentAssetId);
    }

    private void ApplyQueryDefaults()
    {
        var query = ParseQuery();
        if (query.TryGetValue("parentAssetId", out var parentAssetId) && Guid.TryParse(parentAssetId, out var parentId))
            selectedParentAsset = parentAssetOptions.FirstOrDefault(x => x.Id == parentId);
        if (query.TryGetValue("branchId", out var branchId))
            branchIdText = branchId;
    }

    private async Task SaveAsync()
    {
        if (companyId == Guid.Empty)
        {
            errorMessage = Text("Valid company id is required.", "معرف شركة صحيح مطلوب.");
            return;
        }

        model.CompanyId = companyId;
        model.BranchId = Guid.TryParse(branchIdText, out var branchId) ? branchId : null;
        model.ParentAssetId = selectedParentAsset?.Id;
        isSaving = true;
        var isSuccess = false;
        string? error = null;
        if (Id.HasValue)
        {
            var result = await MaintenanceService.UpdateAssetAsync(model);
            isSuccess = result.IsSuccess;
            error = result.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        else
        {
            var result = await MaintenanceService.CreateAssetAsync(model);
            isSuccess = result.IsSuccess;
            error = result.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        isSaving = false;
        if (isSuccess)
            NavigationManager.NavigateTo("/Maintenance/Assets");
        else
            errorMessage = error ?? Text("Unable to save asset.", "تعذر حفظ الأصل.");
    }

    private async Task LoadBranchesAsync()
    {
        if (companyId == Guid.Empty)
            return;

        var result = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        branches = result.IsSuccess ? result.Data?.Data.ToList() ?? [] : [];
    }

    private async Task LoadParentOptionsAsync()
    {
        var result = await MaintenanceService.GetAssetsAsync(0, 1000, companyId: companyId == Guid.Empty ? null : companyId);
        parentAssetOptions = result.IsSuccess ? result.Data?.Data.Where(x => x.Id != Id).ToList() ?? [] : [];
    }

    private Dictionary<string, string> ParseQuery()
    {
        var uri = new Uri(NavigationManager.Uri);
        return uri.Query.TrimStart('?')
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2)
            .ToDictionary(parts => Uri.UnescapeDataString(parts[0]), parts => Uri.UnescapeDataString(parts[1]));
    }

    private Task OnParentAssetChanged(MaintenanceAssetDto? asset)
    {
        selectedParentAsset = asset;
        return Task.CompletedTask;
    }

    private string AssetText(MaintenanceAssetDto asset) => $"{asset.AssetCode} - {LocalizedName(asset.NameEng, asset.Name)}";
    private string LocalizedName(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
