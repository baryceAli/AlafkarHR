@page "/ProjectManagement/Reports/CustomerDistribution"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.ProjectManagement.Services
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.ProjectManagement.Dtos
@using SharedWithUI.ProjectManagement.Enums
@inject IProjectManagementService ProjectManagementService
@inject SharedDataService SharedDataService
@inject ApiConfig ApiConfig

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Customer Distribution Report", "تقرير توزيع العملاء")" Subtitle="@Text("Totals by day, week, month, or selected date range.", "إجماليات حسب اليوم أو الأسبوع أو الشهر أو نطاق تاريخ.")" Icon="bi-bar-chart" />
    <article class="erp-card mb-3">
        <div class="erp-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-3"><label class="form-label">@Text("Project", "Project")</label><select class="form-select" @bind="projectIdText" @bind:after="LoadProjectFiltersAsync"><option value="">@Text("All", "All")</option>@foreach (var project in projects) { <option value="@project.Id">@project.Name</option> }</select></div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Customer", "Customer")</label><select class="form-select" @bind="customerIdText"><option value="">@Text("All", "All")</option>@foreach (var customer in selectedProject.Customers) { <option value="@customer.Id">@customer.CustomerName</option> }</select></div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Place", "Place")</label><select class="form-select" @bind="placeIdText"><option value="">@Text("All", "All")</option>@foreach (var place in places) { <option value="@place.Id">@place.Name</option> }</select></div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Meal", "Meal")</label><select class="form-select" @bind="deliverableIdText"><option value="">@Text("All", "All")</option>@foreach (var deliverable in selectedProject.Deliverables) { <option value="@deliverable.Id">@deliverable.ProductSkuName</option> }</select></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("From", "من")</label><InputDate class="form-control" @bind-Value="fromDate" /></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("To", "إلى")</label><InputDate class="form-control" @bind-Value="toDate" /></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Group By", "تجميع")</label><InputSelect class="form-select" @bind-Value="groupBy">@foreach (var item in Enum.GetValues<ProjectReportGroupBy>()) { <option value="@item">@item</option> }</InputSelect></div>
                <div class="col-12 col-md-2"><button class="btn btn-primary w-100" @onclick="LoadReportAsync"><i class="bi bi-search"></i> @Text("Run", "تشغيل")</button></div>
            </div>
        </div>
    </article>
    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger">@errorMessage</div> }
    <article class="erp-card">
        <div class="erp-card-body table-responsive">
            <table class="table align-middle">
                <thead><tr><th>@Text("Period", "Period")</th><th>@Text("Project", "Project")</th><th>@Text("Customer", "Customer")</th><th>@Text("Place", "Place")</th><th>@Text("Meal", "Meal")</th><th>@Text("Planned", "Planned")</th><th>@Text("Shipped", "Shipped")</th><th>@Text("Delivered", "Delivered")</th><th>@Text("Actual", "Actual")</th><th>@Text("Variance", "Variance")</th></tr></thead>
                <tbody>@foreach (var row in report) { <tr><td>@row.PeriodKey</td><td>@row.ProjectName</td><td>@row.CustomerName</td><td>@row.PlaceName</td><td>@row.DeliverableName</td><td>@row.PlannedQuantity.ToString("N0")</td><td>@row.ShippedQuantity.ToString("N0")</td><td>@row.DeliveredQuantity.ToString("N0")</td><td>@row.ActualQuantity.ToString("N0")</td><td>@row.VarianceQuantity.ToString("N0")</td></tr> }</tbody>
            </table>
        </div>
    </article>
</main>

@code {
    private List<ProjectDto> projects = [];
    private List<DistributionPlaceDto> places = [];
    private ProjectDto selectedProject = new();
    private List<ProjectDistributionReportRowDto> report = [];
    private string projectIdText = string.Empty;
    private string customerIdText = string.Empty;
    private string placeIdText = string.Empty;
    private string deliverableIdText = string.Empty;
    private DateTime? fromDate = DateTime.UtcNow.Date.AddDays(-7);
    private DateTime? toDate = DateTime.UtcNow.Date;
    private ProjectReportGroupBy groupBy = ProjectReportGroupBy.Day;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var companyId = ApiConfig.CompanyId == Guid.Empty ? (Guid?)null : ApiConfig.CompanyId;
        projects = (await ProjectManagementService.GetProjectsAsync(1, 500, companyId)).Data?.Data.ToList() ?? [];
        places = (await ProjectManagementService.GetPlacesAsync(1, 500, companyId)).Data?.Data.ToList() ?? [];
        await LoadReportAsync();
    }

    private async Task LoadProjectFiltersAsync()
    {
        customerIdText = string.Empty;
        deliverableIdText = string.Empty;
        selectedProject = new();
        if (Guid.TryParse(projectIdText, out var projectId))
        {
            var result = await ProjectManagementService.GetProjectByIdAsync(projectId);
            selectedProject = result.Data ?? new();
            errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        var companyId = ApiConfig.CompanyId == Guid.Empty ? (Guid?)null : ApiConfig.CompanyId;
        Guid? projectId = Guid.TryParse(projectIdText, out var id) ? id : null;
        Guid? customerId = Guid.TryParse(customerIdText, out var parsedCustomerId) ? parsedCustomerId : null;
        Guid? placeId = Guid.TryParse(placeIdText, out var parsedPlaceId) ? parsedPlaceId : null;
        Guid? deliverableId = Guid.TryParse(deliverableIdText, out var parsedDeliverableId) ? parsedDeliverableId : null;
        var result = await ProjectManagementService.GetCustomerDistributionReportAsync(companyId, projectId, customerId, placeId, deliverableId, fromDate, toDate, groupBy);
        report = result.Data ?? [];
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
