    private async Task LoadLookupsAsync()
    {
        if (ApiConfig.CompanyId == Guid.Empty) return;

        var customerResult = await CustomerService.GetByCompany(ApiConfig.CompanyId, 0, 1000);
        if (customerResult.IsSuccess)
            customers = customerResult.Data?.Data.ToList() ?? [];

        var customerGroupResult = await CustomerGroupService.GetByCompanyAsync(ApiConfig.CompanyId, 0, 1000);
        if (customerGroupResult.IsSuccess)
            customerGroups = customerGroupResult.Data?.Data.ToList() ?? [];

        var employeeResult = await EmployeeService.GetByCompanyIdAsync(ApiConfig.CompanyId, 0, 1000);
        if (employeeResult.IsSuccess)
            employees = employeeResult.Data?.Data.ToList() ?? [];

        await LoadProjectTeamsAsync();

        var branchResult = await BranchService.GetByCompanyIdAsync(ApiConfig.CompanyId, 0, 1000);
        if (branchResult.IsSuccess)
            branches = branchResult.Data?.Data.ToList() ?? [];

        var departmentResult = await DepartmentService.GetAsync(0, 1000);
        if (departmentResult.IsSuccess)
            departments = departmentResult.Data?.Data.ToList() ?? [];

        var currencyResult = await CurrencyService.GetAsync(ApiConfig.CompanyId, 0, 1000);
        if (currencyResult.IsSuccess)
            currencies = currencyResult.Data?.Data.ToList() ?? [];

        var warehouseResult = await WarehouseService.GetAsync(ApiConfig.CompanyId, 0, 1000);
        if (warehouseResult.IsSuccess)
            warehouses = warehouseResult.Data?.Data.ToList() ?? [];

        var batchResult = await BatchService.GetAsync(ApiConfig.CompanyId, 0, 1000);
        if (batchResult.IsSuccess)
            batches = batchResult.Data?.Data.ToList() ?? [];

        var skuResult = await ProductService.GetPublicStoreProductSkusAsync(new PublicStoreProductSkuRequest { PageIndex = 0, PageSize = 500 });
        if (skuResult.IsSuccess)
            productSkus = skuResult.Data?.Data.ToList() ?? [];
    }

    private async Task LoadCustomersAsync()
    {
        var customerResult = await CustomerService.GetByCompany(ApiConfig.CompanyId, 0, 1000);
        if (customerResult.IsSuccess)
            customers = customerResult.Data?.Data.ToList() ?? [];
    }

