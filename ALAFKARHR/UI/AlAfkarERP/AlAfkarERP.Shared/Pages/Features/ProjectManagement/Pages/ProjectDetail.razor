    private async Task LoadAsync()
    {
        var result = await ProjectManagementService.GetProjectByIdAsync(Id);
        project = result.Data ?? new();
        editingProject = CloneProject(project);
        branchIdText = project.BranchId?.ToString() ?? string.Empty;
        sourceOrderIdText = project.SourceOrderId?.ToString() ?? string.Empty;
        selectedManager = employees.FirstOrDefault(item => EmployeeDisplay(item) == project.ManagerName || item.FullName == project.ManagerName || item.FullNameEng == project.ManagerName);
        selectedBranch = project.BranchId.HasValue ? branches.FirstOrDefault(item => item.Id == project.BranchId.Value) : null;
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        var budgetResult = await ProjectManagementService.GetBudgetSummaryAsync(Id);
        budget = budgetResult.Data ?? new();
    }

    private async Task UpdateProjectAsync()
    {
        editingProject.Id = Id;
        editingProject.BranchId = ParseGuid(branchIdText);
        editingProject.SourceOrderId = ParseGuid(sourceOrderIdText);
        var result = await ProjectManagementService.UpdateProjectAsync(editingProject);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
