    private void OnResourceReferenceChanged(ChangeEventArgs args)
    {
        resourceReferenceIdText = args.Value?.ToString() ?? string.Empty;
        resource.ReferenceId = ParseGuid(resourceReferenceIdText);

        if (!resource.ReferenceId.HasValue)
            return;

        var name = resource.ResourceType switch
        {
            ProjectResourceType.Employee => employees.FirstOrDefault(x => x.Id == resource.ReferenceId.Value) is { } employee ? EmployeeDisplay(employee) : null,
            ProjectResourceType.Team => projectTeams.FirstOrDefault(x => x.Id == resource.ReferenceId.Value) is { } team ? TeamDisplay(team) : null,
            ProjectResourceType.Warehouse => warehouses.FirstOrDefault(x => x.Id == resource.ReferenceId.Value) is { } warehouse ? WarehouseDisplay(warehouse) : null,
            _ => null
        };

        if (!string.IsNullOrWhiteSpace(name))
            resource.Name = name;
    }

