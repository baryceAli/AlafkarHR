    private void AddCustomerProductPlanDraft()
    {
        if (!ValidateProductPlan(customerProductPlan))
            return;

        if (customer.ProductPlans.Any(x => x.ProductSkuId == customerProductPlan.ProductSkuId))
        {
            errorMessage = Text("This SKU has already been added.", "تمت إضافة هذا الصنف مسبقاً.");
            return;
        }

        customer.ProductPlans.Add(CloneProductPlan(customerProductPlan));
        customerProductPlan = NewProductPlan();
        selectedProductSku = null;
        errorMessage = null;
    }

    private void RemoveCustomerProductPlanDraft(ProjectCustomerProductPlanDto plan)
    {
        if (editingProductPlan == plan)
            CancelCustomerProductPlanDraftEdit();

        customer.ProductPlans.Remove(plan);
    }

    private void EditCustomerProductPlanDraft(ProjectCustomerProductPlanDto plan)
    {
        editingProductPlan = plan;
        editingProductPlanQuantity = plan.Quantity;
        editingProductPlanNotes = plan.Notes;
    }

    private void SaveCustomerProductPlanDraftEdit()
    {
        if (editingProductPlan is null)
            return;

        if (editingProductPlanQuantity <= 0)
        {
            errorMessage = Text("SKU quantity must be greater than zero.", "يجب أن تكون كمية الصنف أكبر من صفر.");
            return;
        }

        editingProductPlan.Quantity = editingProductPlanQuantity;
        editingProductPlan.Notes = editingProductPlanNotes;
        CancelCustomerProductPlanDraftEdit();
        errorMessage = null;
    }

    private void CancelCustomerProductPlanDraftEdit()
    {
        editingProductPlan = null;
        editingProductPlanQuantity = 1;
        editingProductPlanNotes = null;
    }

    private async Task SaveExistingCustomerProductPlanAsync()
    {
        if (!Guid.TryParse(productPlanCustomerIdText, out var projectCustomerId))
        {
            errorMessage = Text("Project customer is required.", "عميل المشروع مطلوب.");
            return;
        }

        if (!ValidateProductPlan(existingCustomerProductPlan))
            return;

        var result = await ProjectManagementService.CreateCustomerProductPlanAsync(Id, projectCustomerId, existingCustomerProductPlan);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        if (result.IsSuccess)
        {
            existingCustomerProductPlan = NewProductPlan();
            selectedExistingProductSku = null;
            productPlanCustomerIdText = string.Empty;
            await LoadAsync();
        }
    }

