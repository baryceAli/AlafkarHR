@page "/ProjectManagement/Projects/{Id:guid}"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.ProjectManagement.Services
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Features.TaskManagement.Services
@using AlAfkarERP.Shared.Utilities
@using AlAfkarERP.Shared.Pages.Reuable2
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Catalog.Enums
@using SharedWithUI.TaskManagement.Dtos
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Customers.Enums
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Employees.Enums
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.TaskManagement.Enums
@using SharedWithUI.ProjectManagement.Dtos
@using SharedWithUI.ProjectManagement.Enums
@inject IProjectManagementService ProjectManagementService
@inject IEmployeeTeamService EmployeeTeamService
@inject IProductService ProductService
@inject ICustomerService CustomerService
@inject ICustomerGroupService CustomerGroupService
@inject IEmployeeService EmployeeService
@inject IBranchService BranchService
@inject IDepartmentService DepartmentService
@inject ICurrencyService CurrencyService
@inject IWarehouseService WarehouseService
@inject IBatchService BatchService
@inject ITaskManagementService TaskManagementService
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ApiConfig ApiConfig

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@project.Name" Subtitle="@project.ProjectNumber" Icon="bi-kanban" />

    <div class="d-flex flex-wrap gap-2 mb-3">
        <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Planned))" disabled="@(project.Status == ProjectStatus.Planned)"><i class="bi bi-calendar-check"></i> @Text("Plan", "Plan")</button>
        <button class="btn btn-outline-info btn-sm" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Active))" disabled="@(project.Status == ProjectStatus.Active)"><i class="bi bi-play"></i> @Text("Activate", "Activate")</button>
        <button class="btn btn-outline-warning btn-sm" @onclick="@(() => ChangeStatusAsync(ProjectStatus.OnHold))" disabled="@(project.Status == ProjectStatus.OnHold)"><i class="bi bi-pause"></i> @Text("Hold", "Hold")</button>
        <button class="btn btn-outline-success btn-sm" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Completed))" disabled="@(project.Status == ProjectStatus.Completed)"><i class="bi bi-check2"></i> @Text("Complete", "Complete")</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="@(() => ChangeStatusAsync(ProjectStatus.Cancelled))" disabled="@(project.Status == ProjectStatus.Cancelled)"><i class="bi bi-x-circle"></i> @Text("Cancel", "Cancel")</button>
        <button class="btn btn-outline-danger btn-sm" @onclick="DeleteProjectAsync"><i class="bi bi-trash"></i> @Text("Delete", "Delete")</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger">@errorMessage</div> }

    <AppCard CssClass="mb-3 allow-overflow">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 erp-table-toolbar">
            <strong>@Text("Project Details", "Project Details")</strong>
            <StatusChip Text="@project.Status.ToString()" Tone="@StatusTone(project.Status)" />
        </div>

            <EditForm Model="editingProject" OnValidSubmit="UpdateProjectAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-12 col-md-3"><label class="form-label">@Text("Name", "Name")</label><InputText class="form-control" @bind-Value="editingProject.Name" /><ValidationMessage For="@(() => editingProject.Name)" /></div>
                    <div class="col-12 col-md-3"><label class="form-label">@Text("English Name", "English Name")</label><InputText class="form-control" @bind-Value="editingProject.NameEng" /></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Type", "Type")</label><InputSelect class="form-select" @bind-Value="editingProject.Type">@foreach (var type in Enum.GetValues<ProjectType>()) { <option value="@type">@ProjectTypeLabel(type)</option> }</InputSelect></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Planned Start", "Planned Start")</label><InputDate class="form-control" @bind-Value="editingProject.PlannedStartDate" /></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Planned End", "Planned End")</label><InputDate class="form-control" @bind-Value="editingProject.PlannedEndDate" /></div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Manager", "مدير المشروع")</label>
                        <AutoCompleteComponent TItem="EmployeeDto"
                                               Items="employees"
                                               ItemText="EmployeeDisplay"
                                               Value="selectedManager"
                                               ValueChanged="OnManagerChanged"
                                               PlaceHolder="@Text("Search employee", "ابحث عن موظف")" />
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label">@Text("Branch", "الفرع")</label>
                        <AutoCompleteComponent TItem="BranchDto"
                                               Items="branches"
                                               ItemText="BranchDisplay"
                                               Value="selectedBranch"
                                               ValueChanged="OnBranchChanged"
                                               PlaceHolder="@Text("Select branch", "اختر الفرع")" />
                    </div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Actual Start", "Actual Start")</label><InputDate class="form-control" @bind-Value="editingProject.ActualStartDate" /></div>
                    <div class="col-12 col-md-2"><label class="form-label">@Text("Actual End", "Actual End")</label><InputDate class="form-control" @bind-Value="editingProject.ActualEndDate" /></div>
                    <div class="col-12 col-md-7"><label class="form-label">@Text("Notes", "Notes")</label><InputText class="form-control" @bind-Value="editingProject.Notes" /></div>
                    <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit"><i class="bi bi-save"></i> @Text("Save Details", "Save Details")</button></div>
                </div>
            </EditForm>

    </AppCard>

    <div class="d-flex flex-wrap gap-2 mb-3">
        @foreach (var tab in tabs)
        {
            <button class="btn @(activeTab == tab ? "btn-primary" : "btn-outline-secondary")" @onclick="@(() => activeTab = tab)">@TabLabel(tab)</button>
        }
    </div>

    @if (activeTab == "Overview")
    {
        <AppCard CssClass="allow-overflow">

                <div class="row g-3">
                    <div class="col-12 col-md-3"><StatsCard Title="@Text("Status", "الحالة")" Value="@project.Status.ToString()" Icon="bi-activity" /></div>
                    <div class="col-12 col-md-3"><StatsCard Title="@Text("Customers", "العملاء")" Value="@project.Customers.Count.ToString("N0")" Icon="bi-people" /></div>
                    <div class="col-12 col-md-3"><StatsCard Title="@Text("Deliverables", "المخرجات")" Value="@project.Deliverables.Count.ToString("N0")" Icon="bi-box-seam" /></div>
                    <div class="col-12 col-md-3"><StatsCard Title="@Text("Cost", "التكلفة")" Value="@project.TotalActualCost.ToString("N2")" Icon="bi-cash-stack" /></div>
                </div>

        </AppCard>
    }
    else if (activeTab == "Customers")
    {
        <AppCard CssClass="mb-3 allow-overflow">
            <EditForm Model="customer" OnValidSubmit="SaveCustomerAsync"><div class="row g-3 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label">@Text("Customer Selector", "اختيار العميل")</label>
                    <AutoCompleteComponent TItem="CustomerDto"
                                           Items="AvailableCustomers"
                                           ItemText="CustomerDisplay"
                                           Value="selectedCustomer"
                                           ValueChanged="OnCustomerChanged"
                                           ActionText="@Text("Add new Customer", "إضافة عميل جديد")"
                                           ActionIcon="bi-plus-lg"
                                           OnActionSelected="OpenNewCustomerModal"
                                           PlaceHolder="@Text("Search customer", "ابحث عن عميل")" />
                </div>
                <div class="col-6 col-lg-2"><label class="form-label">@Text("Calculated Qty", "الكمية المحتسبة")</label><input class="form-control" value="@DraftCalculatedQuantity.ToString("N0")" readonly /></div>
                <div class="col-6 col-lg-2"><label class="form-label">@Text("Contracted Amount", "المبلغ المتعاقد عليه")</label><InputNumber class="form-control" @bind-Value="customer.ContractedAmount" /></div>
                <div class="col-12 col-lg-3"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="customer.Notes" /></div>
                <div class="col-12 col-lg-5">
                    <label class="form-label">@Text("Product / Combo SKU", "الصنف أو الحزمة")</label>
                    <AutoCompleteComponent TItem="ProductSkuDto"
                                           Items="AvailableProductSkus"
                                           ItemText="ProductSkuDisplay"
                                           Value="selectedProductSku"
                                           ValueChanged="OnProductSkuChanged"
                                           PlaceHolder="@Text("Search SKU", "ابحث عن صنف")" />
                </div>
                <div class="col-6 col-lg-2"><label class="form-label">@Text("SKU Qty", "كمية الصنف")</label><InputNumber class="form-control" @bind-Value="customerProductPlan.Quantity" /></div>
                <div class="col-12 col-lg-3"><label class="form-label">@Text("SKU Notes", "ملاحظات الصنف")</label><InputText class="form-control" @bind-Value="customerProductPlan.Notes" /></div>
                <div class="col-12 col-lg-2"><button class="btn btn-outline-secondary w-100" type="button" @onclick="AddCustomerProductPlanDraft"><i class="bi bi-plus"></i> @Text("Add SKU", "إضافة صنف")</button></div>
                <div class="col-12 d-flex justify-content-end"><button class="btn btn-primary" type="submit"><i class="bi bi-plus"></i> @Text("Add Customer", "إضافة عميل")</button></div>
            </div></EditForm>
            <div class="row g-3 mt-1">
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@Text("Calculated Quantity", "الكمية المحتسبة")</div>
                        <div class="fw-semibold">@DraftCalculatedQuantity.ToString("N0")</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@Text("Actual Amount", "المبلغ الفعلي")</div>
                        <div class="fw-semibold">@DraftActualAmount.ToString("N2")</div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted small">@Text("Difference", "الفرق")</div>
                        <div class="fw-semibold">@DraftAmountDifference.ToString("N2")</div>
                    </div>
                </div>
            </div>
            @if (customer.ProductPlans.Any())
            {
                <div class="erp-table-wrap mt-3">
                    <table class="table align-middle mb-0 erp-table">
                        <thead><tr><th>@Text("SKU", "الصنف")</th><th>@Text("Type", "النوع")</th><th>@Text("Quantity", "الكمية")</th><th>@Text("Unit Price", "سعر الوحدة")</th><th>@Text("Line Amount", "مبلغ السطر")</th><th>@Text("Notes", "ملاحظات")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                        <tbody>
                            @foreach (var plan in customer.ProductPlans)
                            {
                                <tr>
                                    <td>@PlanDisplay(plan)</td>
                                    <td>@PlanType(plan)</td>
                                    @if (editingProductPlan == plan)
                                    {
                                        <td><InputNumber class="form-control form-control-sm" @bind-Value="editingProductPlanQuantity" /></td>
                                        <td>@ProductPlanUnitPrice(plan).ToString("N2")</td>
                                        <td>@(ProductPlanUnitPrice(plan) * editingProductPlanQuantity).ToString("N2")</td>
                                        <td><InputText class="form-control form-control-sm" @bind-Value="editingProductPlanNotes" /></td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" type="button" @onclick="SaveCustomerProductPlanDraftEdit"><i class="bi bi-check2"></i></button>
                                                <button class="btn btn-outline-secondary" type="button" @onclick="CancelCustomerProductPlanDraftEdit"><i class="bi bi-x"></i></button>
                                            </div>
                                        </td>
                                    }
                                    else
                                    {
                                        <td>@plan.Quantity.ToString("N0")</td>
                                        <td>@ProductPlanUnitPrice(plan).ToString("N2")</td>
                                        <td>@ProductPlanLineAmount(plan).ToString("N2")</td>
                                        <td>@plan.Notes</td>
                                        <td class="text-end">
                                            <div class="btn-group btn-group-sm">
                                                <button class="btn btn-outline-primary" type="button" @onclick="@(() => EditCustomerProductPlanDraft(plan))"><i class="bi bi-pencil"></i></button>
                                                <button class="btn btn-outline-danger" type="button" @onclick="@(() => RemoveCustomerProductPlanDraft(plan))"><i class="bi bi-x"></i></button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </AppCard>
        <AppCard CssClass="mb-3 allow-overflow"><div class="erp-table-toolbar"><strong>@Text("Add SKU Plan To Existing Customer", "إضافة صنف لعميل موجود")</strong></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-3"><label class="form-label">@Text("Project Customer", "عميل المشروع")</label><select class="form-select" @bind="productPlanCustomerIdText"><option value="">@Text("Select", "اختر")</option>@foreach (var item in project.Customers) { <option value="@item.Id">@item.CustomerName</option> }</select></div>
                <div class="col-12 col-lg-5">
                    <label class="form-label">@Text("Product / Combo SKU", "الصنف أو الحزمة")</label>
                    <AutoCompleteComponent TItem="ProductSkuDto"
                                           Items="productSkus"
                                           ItemText="ProductSkuDisplay"
                                           Value="selectedExistingProductSku"
                                           ValueChanged="OnExistingProductSkuChanged"
                                           PlaceHolder="@Text("Search SKU", "ابحث عن صنف")" />
                </div>
                <div class="col-6 col-lg-2"><label class="form-label">@Text("Quantity", "الكمية")</label><InputNumber class="form-control" @bind-Value="existingCustomerProductPlan.Quantity" /></div>
                <div class="col-12 col-lg-2"><button class="btn btn-outline-primary w-100" type="button" @onclick="SaveExistingCustomerProductPlanAsync"><i class="bi bi-plus"></i> @Text("Add SKU", "إضافة صنف")</button></div>
                <div class="col-12"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="existingCustomerProductPlan.Notes" /></div>
            </div>
        </AppCard>
        @Table(project.Customers.Select(x => new[] { x.CustomerName, x.ContractedQuantity.ToString("N0"), x.ContractedAmount.ToString("N2"), ProductPlanSummary(x.ProductPlans) }), Text("Customer", "العميل"), Text("Quantity", "الكمية"), Text("Amount", "المبلغ"), Text("Products", "الأصناف"))
    }
    else if (activeTab == "Deliverables")
    {
        <AppCard CssClass="mb-3 allow-overflow">
            <EditForm Model="deliverable" OnValidSubmit="SaveDeliverableAsync"><div class="row g-3 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">@Text("Product / Combo SKU", "الصنف أو الحزمة")</label>
                    <AutoCompleteComponent TItem="ProductSkuDto"
                                           Items="productSkus"
                                           ItemText="ProductSkuDisplay"
                                           Value="selectedDeliverableSku"
                                           ValueChanged="OnDeliverableSkuChanged"
                                           PlaceHolder="@Text("Search SKU", "ابحث عن صنف")" />
                </div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Meal Name", "اسم الوجبة")</label><InputText class="form-control" @bind-Value="deliverable.ProductSkuName" /></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Handling", "التعامل")</label><InputSelect class="form-select" @bind-Value="deliverable.HandlingType">@foreach (var type in Enum.GetValues<MealHandlingType>()) { <option value="@type">@type</option> }</InputSelect></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Planned Qty", "الكمية المخططة")</label><InputNumber class="form-control" @bind-Value="deliverable.PlannedQuantity" /></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Ordered Qty", "كمية الطلب")</label><InputNumber class="form-control" @bind-Value="deliverable.OrderedQuantity" /></div>
                <div class="col-12 col-md-1"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-plus"></i></button></div>
            </div></EditForm>
        </AppCard>
        <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Meal", "الوجبة")</th><th>@Text("Handling", "التعامل")</th><th>@Text("Planned", "مخطط")</th><th>@Text("Produced", "منتج")</th><th></th></tr></thead><tbody>
            @foreach (var item in project.Deliverables)
            {
                <tr><td>@item.ProductSkuName</td><td>@item.HandlingType</td><td>@item.PlannedQuantity.ToString("N0")</td><td>@item.ProducedQuantity.ToString("N0")</td><td class="text-end"><button class="btn btn-sm btn-outline-secondary" @onclick="@(() => GenerateRequirementsAsync(item.Id))">@Text("Generate Materials", "توليد المواد")</button></td></tr>
            }
        </tbody></table></div>
    }
    else if (activeTab == "Team & Resources")
    {
        <AppCard CssClass="mb-3 allow-overflow">
            <EditForm Model="resource" OnValidSubmit="SaveResourceAsync"><div class="row g-3 align-items-end">
                <div class="col-12 col-md-2"><label class="form-label">@Text("Type", "Type")</label><select class="form-select" value="@resource.ResourceType" @onchange="OnResourceTypeChanged">@foreach (var type in Enum.GetValues<ProjectResourceType>()) { <option value="@type">@type</option> }</select></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Reference", "المرجع")</label><select class="form-select" value="@resourceReferenceIdText" @onchange="OnResourceReferenceChanged"><option value="">@Text("None", "بدون")</option>@foreach (var item in ResourceReferenceOptions()) { <option value="@item.Id">@item.Name</option> }</select></div>
                @if (resource.ResourceType == ProjectResourceType.Team)
                {
                    <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="button" @onclick="OpenProjectTeamModal"><i class="bi bi-people"></i> @Text("New Team", "فريق جديد")</button></div>
                }
                <div class="col-12 col-md-3"><label class="form-label">@Text("Name", "Name")</label><InputText class="form-control" @bind-Value="resource.Name" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Plan Qty", "Plan Qty")</label><InputNumber class="form-control" @bind-Value="resource.PlannedQuantity" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Plan Rate", "Plan Rate")</label><InputNumber class="form-control" @bind-Value="resource.PlannedRate" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Actual Qty", "Actual Qty")</label><InputNumber class="form-control" @bind-Value="resource.ActualQuantity" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Actual Rate", "Actual Rate")</label><InputNumber class="form-control" @bind-Value="resource.ActualRate" /></div>
                <div class="col-12 col-md-2">
                    <label class="form-label">@Text("Currency", "العملة")</label>
                    <AutoCompleteComponent TItem="CurrencyDto"
                                           Items="currencies"
                                           ItemText="CurrencyDisplay"
                                           Value="selectedResourceCurrency"
                                           ValueChanged="OnResourceCurrencyChanged"
                                           PlaceHolder="@Text("Select currency", "اختر العملة")" />
                </div>
                <div class="col-12"><label class="form-label">@Text("Notes", "Notes")</label><InputText class="form-control" @bind-Value="resource.Notes" /></div>
                <div class="col-12 col-md-2"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-plus"></i> @Text("Add", "Add")</button></div>
            </div></EditForm>
        </AppCard>
        @Table(project.Resources.Select(x => new[] { x.ResourceType.ToString(), x.Name, x.PlannedCost.ToString("N2"), x.ActualCost.ToString("N2"), x.Notes ?? "" }), Text("Type", "Type"), Text("Name", "Name"), Text("Planned", "Planned"), Text("Actual", "Actual"), Text("Notes", "Notes"))
    }
    else if (activeTab == "Materials")
    {
        <AppCard CssClass="mb-3 allow-overflow">
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-outline-primary btn-sm" @onclick="RefreshMaterialsAsync"><i class="bi bi-arrow-clockwise"></i> @Text("Refresh Requirements", "Refresh Requirements")</button>
                @foreach (var item in project.Deliverables)
                {
                    <button class="btn btn-outline-secondary btn-sm" @onclick="@(() => GenerateRequirementsAsync(item.Id))"><i class="bi bi-arrow-repeat"></i> @Text("Regenerate", "Regenerate") @item.ProductSkuName</button>
                }
            </div>
        </AppCard>
        @Table(project.MaterialRequirements.Select(x => new[] { x.ComponentSkuName, x.RequiredQuantity.ToString("N4"), x.ReservedQuantity.ToString("N4"), x.IssuedQuantity.ToString("N4"), x.ConsumedQuantity.ToString("N4"), x.ReturnedQuantity.ToString("N4"), x.VarianceQuantity.ToString("N4") }), Text("Component", "Component"), Text("Required", "Required"), Text("Reserved", "Reserved"), Text("Issued", "Issued"), Text("Consumed", "Consumed"), Text("Returned", "Returned"), Text("Variance", "Variance"))
    }
    else if (activeTab == "Preparation/Packaging")
    {
        <AppCard CssClass="mb-3 allow-overflow"><div class="erp-table-toolbar"><strong>@Text("New Handoff", "New Handoff")</strong></div>
            <EditForm Model="handoff" OnValidSubmit="PostHandoffAsync"><div class="row g-3 align-items-end">
                <div class="col-12 col-md-2"><label class="form-label">@Text("Type", "Type")</label><InputSelect class="form-select" @bind-Value="handoff.HandoffType">@foreach (var type in Enum.GetValues<ProjectHandoffType>()) { <option value="@type">@type</option> }</InputSelect></div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Date", "Date")</label><InputDate class="form-control" @bind-Value="handoff.HandoffDate" /></div>
                <div class="col-12 col-md-4"><label class="form-label">@Text("Notes", "Notes")</label><InputText class="form-control" @bind-Value="handoff.Notes" /></div>
                <div class="col-12 col-md-2"><label class="form-label d-block">@Text("Consume Reserved", "Consume Reserved")</label><InputCheckbox class="form-check-input" @bind-Value="handoff.ConsumeReservedQuantity" /></div>
                <div class="col-12 col-md-2"><button class="btn btn-primary w-100" type="submit"><i class="bi bi-box-arrow-in-down"></i> @Text("Post", "Post")</button></div>
            </div></EditForm>
            <div class="row g-2 align-items-end mt-3">
                <div class="col-12 col-md-3"><label class="form-label">@Text("Allocation", "Allocation")</label><select class="form-select" @bind="handoffLineAllocationIdText"><option value="">@Text("None", "None")</option>@foreach (var item in ProjectAllocations()) { <option value="@item.Id">@item.DistributionDate.ToShortDateString() - @item.CustomerName - @item.DeliverableName</option> }</select></div>
                <div class="col-12 col-md-3"><label class="form-label">@Text("Deliverable", "Deliverable")</label><select class="form-select" @onchange="OnHandoffDeliverableChanged"><option value="">@Text("Select", "Select")</option>@foreach (var item in project.Deliverables) { <option value="@item.Id">@item.ProductSkuName</option> }</select></div>
                <div class="col-12 col-md-4">
                    <label class="form-label">@Text("Product / Combo SKU", "الصنف أو الحزمة")</label>
                    <AutoCompleteComponent TItem="ProductSkuDto"
                                           Items="productSkus"
                                           ItemText="ProductSkuDisplay"
                                           Value="selectedHandoffSku"
                                           ValueChanged="OnHandoffSkuChanged"
                                           PlaceHolder="@Text("Search SKU", "ابحث عن صنف")" />
                </div>
                <div class="col-12 col-md-2"><label class="form-label">@Text("Item", "Item")</label><InputText class="form-control" @bind-Value="handoffLine.ItemName" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Qty", "Qty")</label><InputNumber class="form-control" @bind-Value="handoffLine.Quantity" /></div>
                <div class="col-6 col-md-1"><label class="form-label">@Text("Cost", "Cost")</label><InputNumber class="form-control" @bind-Value="handoffLine.UnitCost" /></div>
                <div class="col-12 col-md-2">
                    <label class="form-label">@Text("Warehouse", "المستودع")</label>
                    <AutoCompleteComponent TItem="WarehouseDto"
                                           Items="warehouses"
                                           ItemText="WarehouseDisplay"
                                           Value="selectedHandoffWarehouse"
                                           ValueChanged="OnHandoffWarehouseChanged"
                                           PlaceHolder="@Text("Select warehouse", "اختر المستودع")" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">@Text("Batch", "التشغيلة")</label>
                    <AutoCompleteComponent TItem="BatchDto"
                                           Items="batches"
                                           ItemText="BatchDisplay"
                                           Value="selectedHandoffBatch"
                                           ValueChanged="OnHandoffBatchChanged"
                                           PlaceHolder="@Text("Select batch", "اختر التشغيلة")" />
                </div>
                <div class="col-12 col-md-2">
                    <label class="form-label">@Text("Currency", "العملة")</label>
                    <AutoCompleteComponent TItem="CurrencyDto"
                                           Items="currencies"
                                           ItemText="CurrencyDisplay"
                                           Value="selectedHandoffCurrency"
                                           ValueChanged="OnHandoffCurrencyChanged"
                                           PlaceHolder="@Text("Select currency", "اختر العملة")" />
                </div>
                <div class="col-12 col-md-2"><button class="btn btn-outline-primary w-100" type="button" @onclick="AddHandoffLine">@Text("Add Line", "Add Line")</button></div>
            </div>
            @Table(handoff.Lines.Select(x => new[] { x.ItemName, x.Quantity.ToString("N4"), x.UnitCost.ToString("N4"), x.TotalCost.ToString("N4") }), Text("Item", "Item"), Text("Qty", "Qty"), Text("Cost", "Cost"), Text("Total", "Total"))
        </AppCard>
        @Table(project.Handoffs.Select(x => new[] { x.HandoffDate.ToShortDateString(), x.HandoffType.ToString(), x.ReferenceNumber ?? "", x.Lines.Count.ToString("N0"), x.Lines.Sum(l => l.TotalCost).ToString("N2") }), Text("Date", "Date"), Text("Type", "Type"), Text("Reference", "Reference"), Text("Lines", "Lines"), Text("Cost", "Cost"))
    }
    else if (activeTab == "Distribution")
    {
        <div class="mb-3"><button class="btn btn-outline-primary" @onclick='() => NavigationManager.NavigateTo("/ProjectManagement/DistributionSchedule")'><i class="bi bi-calendar-event"></i> @Text("Open Schedule", "Open Schedule")</button></div>
        @Table(project.DistributionSchedules.SelectMany(x => x.Allocations).OrderBy(x => x.DistributionDate).Select(x => new[] { x.DistributionDate.ToShortDateString(), x.CustomerName, x.PlaceName, x.DeliverableName, x.PlannedQuantity.ToString("N0"), x.ShippedQuantity.ToString("N0"), x.DeliveredQuantity.ToString("N0"), x.ActualQuantity.ToString("N0"), x.VarianceQuantity.ToString("N0") }), Text("Date", "Date"), Text("Customer", "Customer"), Text("Place", "Place"), Text("Meal", "Meal"), Text("Planned", "Planned"), Text("Shipped", "Shipped"), Text("Delivered", "Delivered"), Text("Actual", "Actual"), Text("Variance", "Variance"))
    }
    else if (activeTab == "Tasks")
    {
        <AppCard CssClass="mb-3 allow-overflow"><div class="erp-table-toolbar"><strong>@Text("Create / Link Task", "Create / Link Task")</strong></div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-md-4"><label class="form-label">@Text("Title", "Title")</label><InputText class="form-control" @bind-Value="taskLink.Title" /></div>
                <div class="col-12 col-md-4">
                    <label class="form-label">@Text("Assigned To", "Assigned To")</label>
                    <AutoCompleteComponent TItem="EmployeeDto"
                                           Items="ProjectTaskAssignees"
                                           ItemText="EmployeeSearchText"
                                           Value="selectedTaskEmployee"
                                           ValueChanged="OnTaskEmployeeChanged"
                                           PlaceHolder="@Text("Select project employee", "اختر موظف المشروع")" />
                </div>
                <div class="col-12 col-md-4 d-flex gap-2">
                    <button class="btn btn-primary flex-fill" @onclick="CreateTaskFromProjectAsync"><i class="bi bi-plus-lg"></i> @Text("Create Task", "Create Task")</button>
                    <button class="btn btn-outline-primary flex-fill" @onclick="OpenExistingTaskModal"><i class="bi bi-link-45deg"></i> @Text("Link Existing", "Link Existing")</button>
                </div>
                <div class="col-12"><label class="form-label">@Text("Description", "Description")</label><InputText class="form-control" @bind-Value="taskLink.Notes" /></div>
                @if (!ProjectTaskAssignees.Any())
                {
                    <div class="col-12"><div class="alert alert-warning mb-0">@Text("Add or select a project team resource before assigning a project task.", "أضف أو اختر فريق مشروع كمورد قبل إسناد مهمة المشروع.")</div></div>
                }
            </div>
        </AppCard>
        <div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr><th>@Text("Title", "Title")</th><th>@Text("Task No.", "Task No.")</th><th class="text-end">@Text("Open", "Open")</th></tr></thead><tbody>
            @foreach (var item in project.TaskLinks)
            {
                <tr><td>@item.Title</td><td>@item.TaskNumber</td><td class="text-end">@if (item.TaskId.HasValue) { <button class="btn btn-sm btn-outline-primary" @onclick="@(() => NavigationManager.NavigateTo($"/TaskManagement/View/{item.TaskId}"))"><i class="bi bi-box-arrow-up-right"></i></button> }</td></tr>
            }
        </tbody></table></div>
    }
    else if (activeTab == "Timeline")
    {
        @Table(TimelineRows(), Text("Date", "Date"), Text("Event", "Event"), Text("Details", "Details"))
    }
    else if (activeTab == "Budget")
    {
        <div class="row g-3 mb-3">
            <div class="col-12 col-lg-6"><AppCard CssClass="allow-overflow"><div class="erp-table-toolbar"><strong>@Text("Resource", "مورد")</strong></div><EditForm Model="resource" OnValidSubmit="SaveResourceAsync"><div class="row g-2">
                <div class="col-12 col-md-4"><select class="form-select" value="@resource.ResourceType" @onchange="OnResourceTypeChanged">@foreach (var type in Enum.GetValues<ProjectResourceType>()) { <option value="@type">@type</option> }</select></div>
                <div class="col-12 col-md-4"><select class="form-select" value="@resourceReferenceIdText" @onchange="OnResourceReferenceChanged"><option value="">@Text("No reference", "بدون مرجع")</option>@foreach (var item in ResourceReferenceOptions()) { <option value="@item.Id">@item.Name</option> }</select></div>
                @if (resource.ResourceType == ProjectResourceType.Team)
                {
                    <div class="col-12 col-md-4"><button class="btn btn-outline-primary w-100" type="button" @onclick="OpenProjectTeamModal"><i class="bi bi-people"></i> @Text("New Project Team", "فريق مشروع جديد")</button></div>
                }
                <div class="col-12 col-md-4"><InputText class="form-control" placeholder="@Text("Name", "الاسم")" @bind-Value="resource.Name" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="resource.PlannedQuantity" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="resource.PlannedRate" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="resource.ActualQuantity" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="resource.ActualRate" /></div>
                <div class="col-12 col-md-4">
                    <AutoCompleteComponent TItem="CurrencyDto"
                                           Items="currencies"
                                           ItemText="CurrencyDisplay"
                                           Value="selectedResourceCurrency"
                                           ValueChanged="OnResourceCurrencyChanged"
                                           PlaceHolder="@Text("Select currency", "اختر العملة")" />
                </div>
                <div class="col-12 col-md-8"><InputText class="form-control" placeholder="@Text("Notes", "Notes")" @bind-Value="resource.Notes" /></div>
                <div class="col-12"><button class="btn btn-primary btn-sm" type="submit">@Text("Add Resource", "إضافة مورد")</button></div>
            </div></EditForm></AppCard></div>
            <div class="col-12 col-lg-6"><AppCard CssClass="allow-overflow"><div class="erp-table-toolbar"><strong>@Text("Expense", "مصروف")</strong></div><EditForm Model="expense" OnValidSubmit="SaveExpenseAsync"><div class="row g-2">
                <div class="col-12 col-md-4"><InputSelect class="form-select" @bind-Value="expense.Category">@foreach (var category in Enum.GetValues<ProjectExpenseCategory>()) { <option value="@category">@category</option> }</InputSelect></div>
                <div class="col-12 col-md-4"><InputDate class="form-control" @bind-Value="expense.ExpenseDate" /></div>
                <div class="col-12 col-md-4"><InputText class="form-control" placeholder="@Text("Description", "الوصف")" @bind-Value="expense.Description" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="expense.PlannedAmount" /></div>
                <div class="col-6 col-md-3"><InputNumber class="form-control" @bind-Value="expense.ActualAmount" /></div>
                <div class="col-12 col-md-3">
                    <AutoCompleteComponent TItem="CurrencyDto"
                                           Items="currencies"
                                           ItemText="CurrencyDisplay"
                                           Value="selectedExpenseCurrency"
                                           ValueChanged="OnExpenseCurrencyChanged"
                                           PlaceHolder="@Text("Select currency", "اختر العملة")" />
                </div>
                <div class="col-12 col-md-3"><InputText class="form-control" placeholder="@Text("Notes", "Notes")" @bind-Value="expense.Notes" /></div>
                <div class="col-12"><button class="btn btn-primary btn-sm" type="submit">@Text("Add", "إضافة")</button></div>
            </div></EditForm></AppCard></div>
        </div>
        <div class="row g-3">
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Planned", "مخطط")" Value="@budget.TotalPlannedCost.ToString("N2")" Icon="bi-cash" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Actual", "فعلي")" Value="@budget.TotalActualCost.ToString("N2")" Icon="bi-receipt" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Variance", "الفرق")" Value="@budget.CostVariance.ToString("N2")" Icon="bi-graph-up" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Cost/Meal", "تكلفة الوجبة")" Value="@budget.CostPerMeal.ToString("N2")" Icon="bi-calculator" /></div>
        </div>
    }
</main>

@if (showNewCustomerModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="newCustomer" OnValidSubmit="SaveNewCustomerAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title">@Text("Add new Customer", "إضافة عميل جديد")</h5>
                            <div class="text-muted small">@Text("Create a customer record, then continue adding project quantities and products.", "أنشئ سجل عميل ثم تابع إضافة كميات وأصناف المشروع.")</div>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseNewCustomerModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(newCustomerError))
                        {
                            <div class="alert alert-danger">@newCustomerError</div>
                        }

                        <div class="row g-3">
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Text("Name", "الاسم")</label>
                                <InputText class="form-control" @bind-Value="newCustomer.Name" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Text("Customer Code", "رقم العميل")</label>
                                <InputText class="form-control" @bind-Value="newCustomer.CustomerCode" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Text("Commercial Name", "الاسم التجاري")</label>
                                <InputText class="form-control" @bind-Value="newCustomer.CommercialName" />
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label">@Text("Customer Group", "فئة العميل")</label>
                                <AutoCompleteComponent TItem="CustomerGroupDto"
                                                       Items="customerGroups"
                                                       ItemText="CustomerGroupDisplay"
                                                       Value="selectedNewCustomerGroup"
                                                       ValueChanged="OnNewCustomerGroupChanged"
                                                       PlaceHolder="@Text("Select customer group", "اختر فئة العميل")" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("VAT Number", "الرقم الضريبي")</label>
                                <InputText class="form-control" @bind-Value="newCustomer.VatNumber" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("Commercial Registration", "السجل التجاري")</label>
                                <InputText class="form-control" @bind-Value="newCustomer.CommercialRegistrationNumber" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("Credit Limit", "حد الائتمان")</label>
                                <InputNumber class="form-control" @bind-Value="newCustomer.CreditLimit" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("Status", "الحالة")</label>
                                <InputSelect class="form-select" @bind-Value="newCustomer.Status">
                                    @foreach (var status in Enum.GetValues<CustomerStatus>())
                                    {
                                        <option value="@status">@status</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("Payment Term", "شروط الدفع")</label>
                                <InputSelect class="form-select" @bind-Value="newCustomer.PaymentTerm">
                                    @foreach (var term in Enum.GetValues<PaymentTermType>())
                                    {
                                        <option value="@term">@term</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label">@Text("Credit Status", "حالة الائتمان")</label>
                                <InputSelect class="form-select" @bind-Value="newCustomer.CreditStatus">
                                    @foreach (var creditStatus in Enum.GetValues<CreditStatus>())
                                    {
                                        <option value="@creditStatus">@creditStatus</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-12">
                                <label class="form-label">@Text("Notes", "ملاحظات")</label>
                                <InputTextArea class="form-control" rows="2" @bind-Value="newCustomer.Notes" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseNewCustomerModal" disabled="@isSavingNewCustomer">@Text("Cancel", "إلغاء")</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSavingNewCustomer">
                            <i class="bi bi-check2"></i>
                            @(isSavingNewCustomer ? Text("Saving...", "جاري الحفظ...") : Text("Save Customer", "حفظ العميل"))
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showProjectTeamModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <EditForm Model="newProjectTeam" OnValidSubmit="SaveProjectTeamAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title">@Text("Create Project Team", "إنشاء فريق مشروع")</h5>
                            <div class="text-muted small">@Text("Project teams are reusable in future projects.", "فرق المشاريع قابلة لإعادة الاستخدام في المشاريع القادمة.")</div>
                        </div>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseProjectTeamModal"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrWhiteSpace(projectTeamError))
                        {
                            <div class="alert alert-danger">@projectTeamError</div>
                        }
                        <div class="row g-3">
                            <div class="col-12 col-md-6"><label class="form-label">@Text("Team Name", "اسم الفريق")</label><InputText class="form-control" @bind-Value="newProjectTeam.Name" /><ValidationMessage For="@(() => newProjectTeam.Name)" /></div>
                            <div class="col-12 col-md-6"><label class="form-label">@Text("English Name", "الاسم بالإنجليزية")</label><InputText class="form-control" @bind-Value="newProjectTeam.NameEng" /></div>
                            <div class="col-12"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="newProjectTeam.Notes" /></div>
                            <div class="col-12">
                                <div class="d-flex flex-wrap justify-content-between gap-2 mb-2">
                                    <strong>@Text("Members", "الأعضاء")</strong>
                                    <span class="text-muted small">@Text("Selected", "المحدد"): @newProjectTeamEmployeeIds.Count</span>
                                </div>
                                <input class="form-control mb-2" @bind="projectTeamEmployeeSearchText" @bind:event="oninput" placeholder="@Text("Search employees", "ابحث عن موظفين")" />
                                <div class="erp-table-wrap project-team-member-list">
                                    <table class="table align-middle mb-0 erp-table">
                                        <thead><tr><th></th><th>@Text("Employee", "الموظف")</th><th>@Text("Employee No.", "رقم الموظف")</th></tr></thead>
                                        <tbody>
                                            @foreach (var employee in FilteredProjectTeamEmployees)
                                            {
                                                <tr>
                                                    <td><input class="form-check-input" type="checkbox" checked="@newProjectTeamEmployeeIds.Contains(employee.Id)" @onchange="args => ToggleProjectTeamEmployee(employee.Id, args)" /></td>
                                                    <td>@EmployeeDisplay(employee)</td>
                                                    <td>@employee.EmployeeNo</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseProjectTeamModal" disabled="@isSavingProjectTeam">@Text("Cancel", "إلغاء")</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSavingProjectTeam"><i class="bi bi-save"></i> @Text("Save Team", "حفظ الفريق")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@if (showExistingTaskModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-xl modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title">@Text("Link Existing Task", "ربط مهمة موجودة")</h5>
                        <div class="text-muted small">@Text("Select a visible task to link it with this project.", "اختر مهمة ظاهرة لربطها بهذا المشروع.")</div>
                    </div>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseExistingTaskModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-12 col-md-9">
                            <label class="form-label">@Text("Search", "بحث")</label>
                            <input class="form-control" @bind="existingTaskSearchText" @bind:event="oninput" placeholder="@Text("Search by task no. or title", "ابحث برقم المهمة أو العنوان")" />
                        </div>
                        <div class="col-12 col-md-3">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="LoadExistingTasksAsync" disabled="@isLoadingExistingTasks">
                                <i class="bi bi-search"></i>
                                @(isLoadingExistingTasks ? Text("Loading...", "جاري التحميل...") : Text("Search", "بحث"))
                            </button>
                        </div>
                    </div>

                    <div class="erp-table-wrap">
                        <table class="table align-middle mb-0 erp-table">
                            <thead>
                                <tr>
                                    <th>@Text("Task No.", "رقم المهمة")</th>
                                    <th>@Text("Title", "العنوان")</th>
                                    <th>@Text("Assigned To", "مسندة إلى")</th>
                                    <th>@Text("Status", "الحالة")</th>
                                    <th>@Text("Due Date", "تاريخ الاستحقاق")</th>
                                    <th class="text-end">@Text("Select", "اختيار")</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLoadingExistingTasks)
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-4">@Text("Loading tasks...", "جاري تحميل المهام...")</td></tr>
                                }
                                else if (!AvailableExistingTasks.Any())
                                {
                                    <tr><td colspan="6" class="text-center text-muted py-4">@Text("No available tasks found.", "لم يتم العثور على مهام متاحة.")</td></tr>
                                }
                                else
                                {
                                    @foreach (var task in AvailableExistingTasks)
                                    {
                                        <tr>
                                            <td>@task.TaskNumber</td>
                                            <td>@task.Title</td>
                                            <td>@task.AssignedToUser</td>
                                            <td>@task.Status</td>
                                            <td>@task.DueDate.ToShortDateString()</td>
                                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => SelectExistingTaskAsync(task)"><i class="bi bi-check2"></i></button></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseExistingTaskModal" disabled="@isLinkingExistingTask">@Text("Cancel", "إلغاء")</button>
                </div>
            </div>
        </div>
    </div>
}

