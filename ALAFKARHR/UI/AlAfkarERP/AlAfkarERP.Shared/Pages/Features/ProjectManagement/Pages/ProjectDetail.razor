        if (isSavingNewCustomer)
            return;

        showNewCustomerModal = false;
        newCustomer = NewCustomer();
        selectedNewCustomerGroup = null;
        newCustomerError = null;
    }

    private void OpenProjectTeamModal()
    {
        newProjectTeam = new()
        {
            CompanyId = ApiConfig.CompanyId,
            Category = EmployeeTeamCategory.Projects,
            IsActive = true,
            CreatedForProjectId = Id
        };
        newProjectTeamEmployeeIds = [];
        projectTeamEmployeeSearchText = string.Empty;
        projectTeamError = null;
        showProjectTeamModal = true;
    }

    private void CloseProjectTeamModal()
    {
        if (isSavingProjectTeam)
            return;

        showProjectTeamModal = false;
        newProjectTeam = new();
        newProjectTeamEmployeeIds = [];
        projectTeamEmployeeSearchText = string.Empty;
        projectTeamError = null;
    }

    private async Task SaveProjectTeamAsync()
    {
        projectTeamError = ValidateProjectTeam();
        if (!string.IsNullOrWhiteSpace(projectTeamError))
            return;

        isSavingProjectTeam = true;
        newProjectTeam.CompanyId = ApiConfig.CompanyId;
        newProjectTeam.Category = EmployeeTeamCategory.Projects;
        newProjectTeam.IsActive = true;
        newProjectTeam.CreatedForProjectId = Id;
        newProjectTeam.Members = newProjectTeamEmployeeIds.Select(employeeId => new EmployeeTeamMemberDto { EmployeeId = employeeId }).ToList();

        var result = await EmployeeTeamService.CreateProjectTeamAsync(newProjectTeam);
        isSavingProjectTeam = false;

        if (!result.IsSuccess || result.Data is null)
        {
            projectTeamError = result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Team save failed.", "فشل حفظ الفريق.");
            return;
        }

        await LoadProjectTeamsAsync();
        var createdTeam = projectTeams.FirstOrDefault(x => x.Id == result.Data.Id) ?? result.Data;
        resource.ResourceType = ProjectResourceType.Team;
        resource.ReferenceId = createdTeam.Id;
        resourceReferenceIdText = createdTeam.Id.ToString();
        resource.Name = TeamDisplay(createdTeam);
        CloseProjectTeamModal();
        errorMessage = null;
    }

    private string? ValidateProjectTeam()
    {
        if (ApiConfig.CompanyId == Guid.Empty)
            return Text("Company is required.", "الشركة مطلوبة.");

        if (string.IsNullOrWhiteSpace(newProjectTeam.Name))
            return Text("Team name is required.", "اسم الفريق مطلوب.");

        if (newProjectTeamEmployeeIds.Count == 0)
            return Text("Select at least one employee.", "اختر موظفاً واحداً على الأقل.");

        return null;
    }

    private void ToggleProjectTeamEmployee(Guid employeeId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked) newProjectTeamEmployeeIds.Add(employeeId);
        else newProjectTeamEmployeeIds.Remove(employeeId);
    }

    private async Task SaveNewCustomerAsync()
    {
        newCustomerError = ValidateNewCustomer();
        if (!string.IsNullOrWhiteSpace(newCustomerError))
            return;

        isSavingNewCustomer = true;
        newCustomer.CompanyId = ApiConfig.CompanyId;
        NormalizeCustomer(newCustomer);

        var result = await CustomerService.CreateAsync(newCustomer);
        isSavingNewCustomer = false;

        if (!result.IsSuccess || result.Data is null)
        {
            newCustomerError = result.Error?.GetDisplayMessage(SharedDataService.Language)
                ?? Text("Customer save failed.", "فشل حفظ العميل.");
            return;
        }

        await LoadCustomersAsync();
        var createdCustomer = customers.FirstOrDefault(x => x.Id == result.Data.Id);
        if (createdCustomer is null)
        {
            var createdResult = await CustomerService.GetByIdAsync(result.Data.Id);
            if (createdResult.IsSuccess)
                createdCustomer = createdResult.Data;
        }

        if (createdCustomer is not null)
        {
            selectedCustomer = createdCustomer;
            customer.CustomerId = createdCustomer.Id;
            customer.CustomerName = createdCustomer.Name;
            customer.CustomerNameEng = null;
        }

        showNewCustomerModal = false;
        newCustomer = NewCustomer();
        selectedNewCustomerGroup = null;
        newCustomerError = null;
        errorMessage = null;
    }

    private void ResetCustomerDraft()
    {
        customer = new();
        customerProductPlan = NewProductPlan();
        selectedCustomer = null;
        selectedProductSku = null;
        CancelCustomerProductPlanDraftEdit();
    }

    private string? ValidateNewCustomer()
    {
        if (ApiConfig.CompanyId == Guid.Empty)
            return Text("Company is required.", "الشركة مطلوبة.");

        if (string.IsNullOrWhiteSpace(newCustomer.Name))
            return Text("Customer name is required.", "اسم العميل مطلوب.");

        return null;
    }

    private static CustomerDto NormalizeCustomer(CustomerDto customer)
    {
        customer.Name = customer.Name?.Trim() ?? string.Empty;
        customer.CustomerCode = NormalizeText(customer.CustomerCode);
        customer.CommercialName = NormalizeText(customer.CommercialName);
        customer.VatNumber = NormalizeText(customer.VatNumber);
        customer.CommercialRegistrationNumber = NormalizeText(customer.CommercialRegistrationNumber);
        customer.CreditHoldReason = NormalizeText(customer.CreditHoldReason);
        customer.Notes = NormalizeText(customer.Notes);
        customer.Addresses ??= [];
        customer.Contacts ??= [];
        return customer;
    }

    private IEnumerable<string[]> TimelineRows()
    {
        var rows = new List<(DateTime Date, string Event, string Details)>
        {
            (project.PlannedStartDate, Text("Planned Start", "Planned Start"), project.ProjectNumber),
            (project.PlannedEndDate, Text("Planned End", "Planned End"), project.ProjectNumber)
        };
        rows.AddRange(project.DistributionSchedules.Select(x => (x.DistributionDate, Text("Distribution Day", "Distribution Day"), $"{x.Allocations.Count} allocations")));
        rows.AddRange(project.Handoffs.Select(x => (x.HandoffDate, x.HandoffType.ToString(), x.ReferenceNumber ?? "")));
        rows.AddRange(project.Expenses.Select(x => (x.ExpenseDate, Text("Expense", "Expense"), x.Description)));
        return rows.OrderBy(x => x.Date).Select(x => new[] { x.Date.ToShortDateString(), x.Event, x.Details });
    }

    private RenderFragment Table(IEnumerable<string[]> rows, params string[] headers) => @<div class="erp-table-wrap"><table class="table align-middle erp-table"><thead><tr>@foreach (var header in headers) { <th>@header</th> }</tr></thead><tbody>@foreach (var row in rows) { <tr>@foreach (var cell in row) { <td>@cell</td> }</tr> }</tbody></table></div>;
    private string TabLabel(string tab) => tab switch { "Overview" => Text("Overview", "نظرة عامة"), "Customers" => Text("Customers", "العملاء"), "Deliverables" => Text("Deliverables", "المخرجات"), "Budget" => Text("Budget", "الميزانية"), _ => tab };
    private IEnumerable<ProjectDistributionAllocationDto> ProjectAllocations() => project.DistributionSchedules.SelectMany(x => x.Allocations).OrderBy(x => x.DistributionDate);
    private IEnumerable<LookupOption> ResourceReferenceOptions() => resource.ResourceType switch
    {
        ProjectResourceType.Employee => employees.Select(item => new LookupOption(item.Id, EmployeeDisplay(item))),
        ProjectResourceType.Team => projectTeams.Select(item => new LookupOption(item.Id, TeamDisplay(item))),
        ProjectResourceType.Warehouse => warehouses.Select(item => new LookupOption(item.Id, WarehouseDisplay(item))),
        _ => []
    };
    private IEnumerable<EmployeeDto> FilteredProjectTeamEmployees => employees
        .Where(employee => string.IsNullOrWhiteSpace(projectTeamEmployeeSearchText)
            || EmployeeDisplay(employee).Contains(projectTeamEmployeeSearchText, StringComparison.OrdinalIgnoreCase)
            || (employee.EmployeeNo?.Contains(projectTeamEmployeeSearchText, StringComparison.OrdinalIgnoreCase) ?? false))
        .OrderBy(employee => EmployeeDisplay(employee));
    private List<EmployeeDto> ProjectTaskAssignees => project.Resources
        .Where(resource => resource.ResourceType == ProjectResourceType.Team && resource.ReferenceId.HasValue)
        .Select(resource => projectTeams.FirstOrDefault(team => team.Id == resource.ReferenceId!.Value))
        .Where(team => team is not null)
        .SelectMany(team => team!.Members)
        .GroupBy(member => member.EmployeeId)
        .Select(group => employees.FirstOrDefault(employee => employee.Id == group.Key))
        .Where(employee => employee is not null)
        .Select(employee => employee!)
        .OrderBy(EmployeeDisplay)
        .ToList();
    private IEnumerable<TaskItemDto> AvailableExistingTasks => existingTasks
        .Where(task => !project.TaskLinks.Any(link => link.TaskId == task.Id))
        .Where(task => string.IsNullOrWhiteSpace(existingTaskSearchText)
            || task.TaskNumber.Contains(existingTaskSearchText, StringComparison.OrdinalIgnoreCase)
            || task.Title.Contains(existingTaskSearchText, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(task => task.CreatedDate);
    private string EmployeeSearchText(EmployeeDto employee)
        => $"{EmployeeDisplay(employee)} | {employee.Code} | {employee.EmployeeNo} | {employee.Email}";
    private static Guid? ParseGuid(string value) => Guid.TryParse(value, out var id) ? id : null;
    private static string? NormalizeText(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    private static string StatusTone(ProjectStatus status) => status switch { ProjectStatus.Completed => "success", ProjectStatus.Active => "info", ProjectStatus.Cancelled => "danger", ProjectStatus.OnHold => "warning", ProjectStatus.Planned => "primary", _ => "muted" };
