    private void AddHandoffLine()
    {
        if (!Guid.TryParse(handoffLineSkuIdText, out var skuId)) { errorMessage = Text("SKU Id is required.", "SKU Id is required."); return; }
        handoffLine.AllocationId = ParseGuid(handoffLineAllocationIdText);
        handoffLine.ProductId = ParseGuid(handoffLineProductIdText);
        handoffLine.ProductSkuId = skuId;
        handoffLine.ProductPackageId = ParseGuid(handoffLinePackageIdText);
        if (Guid.TryParse(handoffLineWarehouseIdText, out var warehouseId)) handoffLine.WarehouseId = warehouseId;
        if (Guid.TryParse(handoffLineBatchIdText, out var batchId)) handoffLine.BatchId = batchId;
        handoffLine.CurrencyId = ParseGuid(handoffLineCurrencyIdText);
        handoffLine.TotalCost = handoffLine.Quantity * handoffLine.UnitCost;
        handoff.Lines.Add(handoffLine);
        handoffLine = new() { Quantity = 1 };
        handoffLineAllocationIdText = string.Empty;
        handoffLineSkuIdText = string.Empty;
        handoffLineProductIdText = string.Empty;
        handoffLinePackageIdText = string.Empty;
        handoffLineWarehouseIdText = string.Empty;
        handoffLineBatchIdText = string.Empty;
        handoffLineCurrencyIdText = string.Empty;
        selectedHandoffSku = null;
        selectedHandoffWarehouse = null;
        selectedHandoffBatch = null;
        selectedHandoffCurrency = null;
    }

