    private async Task SaveCustomerAsync()
    {
        if (!customer.CustomerId.HasValue || selectedCustomer is null || string.IsNullOrWhiteSpace(customer.CustomerName))
        {
            errorMessage = Text("Customer selection is required.", "اختيار العميل مطلوب.");
            return;
        }

        if (project.Customers.Any(x => x.CustomerId == customer.CustomerId))
        {
            errorMessage = Text("This customer has already been added.", "تمت إضافة هذا العميل مسبقاً.");
            return;
        }

        customer.ContractedQuantity = DraftCalculatedQuantity;
        customer.CustomerName = customer.CustomerName.Trim();
        var result = await ProjectManagementService.CreateCustomerAsync(Id, customer);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        if (result.IsSuccess)
        {
            ResetCustomerDraft();
            await LoadAsync();
        }
    }

