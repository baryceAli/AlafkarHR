    private async Task CreateTaskFromProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(taskLink.Title))
        {
            errorMessage = Text("Task title is required.", "عنوان المهمة مطلوب.");
            return;
        }

        if (!ProjectTaskAssignees.Any())
        {
            errorMessage = Text("Add or select a project team resource before assigning a project task.", "أضف أو اختر فريق مشروع كمورد قبل إسناد مهمة المشروع.");
            return;
        }

        if (selectedTaskEmployee is null)
        {
            errorMessage = Text("Assigned employee is required.", "الموظف المسند إليه مطلوب.");
            return;
        }

        var result = await TaskManagementService.CreateAsync(new CreateTaskItemDto
        {
            Title = taskLink.Title,
            Description = taskLink.Notes ?? $"Project {project.ProjectNumber}",
            DueDate = project.PlannedEndDate,
            AssignedToUser = selectedTaskEmployee.Code,
            DepartmentId = selectedTaskEmployee.DepartmentId,
            Priority = TaskPriority.Normal
        });

        if (!result.IsSuccess || result.Data is null)
        {
            errorMessage = result.Error?.GetDisplayMessage(SharedDataService.Language);
            return;
        }

        var createdTaskResult = await TaskManagementService.GetByIdAsync(result.Data.Id);
        var createdTask = createdTaskResult.Data;
        await LinkTaskAsync(new ProjectTaskLinkDto
        {
            TaskId = result.Data.Id,
            TaskNumber = createdTask?.TaskNumber,
            Title = createdTask?.Title ?? taskLink.Title,
            Notes = taskLink.Notes
        });
    }

