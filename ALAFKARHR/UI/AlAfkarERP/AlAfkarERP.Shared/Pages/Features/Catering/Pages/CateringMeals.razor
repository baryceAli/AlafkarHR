@page "/Catering/Meals"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Catering.Services
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Catering.Dtos
@using SharedWithUI.Catering.Enums
@inject ICateringService CateringService
@inject IProductService ProductService
@inject ApiConfig ApiConfig
@inject SharedDataService SharedDataService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Meals", "الوجبات")" Subtitle="@Text("Define meal recipes, calories, and catalog SKU components.", "تعريف الوجبات والسعرات ومكونات الأصناف من الكتالوج.")" Icon="bi-box-seam" />

    @StatusBlock()

    <AppCard CssClass="mb-3 allow-overflow">

            <EditForm Model="meal" OnValidSubmit="SaveMealAsync">
                <DataAnnotationsValidator />
                <div class="row g-2">
                    <div class="col-md-3"><label class="form-label">@Text("Name", "الاسم")</label><InputText class="form-control" @bind-Value="meal.Name" /></div>
                    <div class="col-md-3"><label class="form-label">@Text("English name", "الاسم الإنجليزي")</label><InputText class="form-control" @bind-Value="meal.NameEng" /></div>
                    <div class="col-md-2"><label class="form-label">@Text("Type", "النوع")</label><InputSelect class="form-select" @bind-Value="meal.MealType">@foreach (var type in Enum.GetValues<CateringMealType>()) { <option value="@type">@type</option> }</InputSelect></div>
                    <div class="col-md-2"><label class="form-label">@Text("Structure", "التركيب")</label><InputSelect class="form-select" @bind-Value="meal.StructureType"><option value="@CateringMealStructureType.Product">@Text("Product", "منتج")</option><option value="@CateringMealStructureType.Combo">@Text("Combo", "كومبو")</option></InputSelect></div>
                    @if (meal.StructureType == CateringMealStructureType.Product)
                    {
                        <div class="col-md-4"><label class="form-label">@Text("Product SKU", "صنف المنتج")</label><select class="form-select" value="@meal.ProductSkuId?.ToString()" @onchange="OnMealSkuChanged"><option value="">@Text("Select SKU", "اختر الصنف")</option>@foreach (var sku in skus) { <option value="@sku.Id">@SkuName(sku)</option> }</select></div>
                    }
                    <div class="col-md-2"><label class="form-label">@Text("Calories", "السعرات")</label><input class="form-control" value="@(meal.Calories?.ToString("N0") ?? Text("Calculated", "تحسب تلقائيا"))" readonly /></div>
                    <div class="col-md-1 d-flex align-items-end"><div class="form-check"><InputCheckbox class="form-check-input" @bind-Value="meal.IsActive" /><label class="form-check-label">@Text("Active", "نشط")</label></div></div>
                    <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary w-100" type="submit" disabled="@busy" title="@Text("Save", "حفظ")"><i class="bi bi-save"></i></button></div>
                    <div class="col-12"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputTextArea class="form-control" @bind-Value="meal.Notes" /></div>
                </div>
            </EditForm>

    </AppCard>

    @if (selectedMeal is not null && selectedMeal.StructureType == CateringMealStructureType.Combo)
    {
        <AppCard CssClass="mb-3 allow-overflow">

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">@Text("Meal components", "مكونات الوجبة") - @Display(selectedMeal.Name, selectedMeal.NameEng)</h6>
                    <button class="btn btn-outline-secondary btn-sm" @onclick="ClearSelection" disabled="@busy" title="@Text("Close", "إغلاق")"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-5"><label class="form-label">@Text("Catalog SKU", "صنف الكتالوج")</label><select class="form-select" value="@componentSkuId?.ToString()" @onchange="OnComponentSkuChanged"><option value="">@Text("Select SKU", "اختر الصنف")</option>@foreach (var sku in skus) { <option value="@sku.Id">@SkuName(sku)</option> }</select></div>
                    <div class="col-md-2"><label class="form-label">@Text("Qty per meal", "الكمية للوجبة")</label><InputNumber class="form-control" @bind-Value="component.QuantityPerMeal" /></div>
                    <div class="col-md-2"><label class="form-label">@Text("Unit", "الوحدة")</label><input class="form-control" value="@SelectedSkuUnitName()" readonly /></div>
                    <div class="col-md-2"><label class="form-label">@Text("Notes", "ملاحظات")</label><InputText class="form-control" @bind-Value="component.Notes" /></div>
                    <div class="col-md-1"><button class="btn btn-primary w-100" @onclick="AddComponentAsync" disabled="@(busy || IsComponentAddDisabled)" title="@Text("Add", "إضافة")"><i class="bi bi-plus-lg"></i></button></div>
                </div>
                <div class="erp-table-wrap mt-3"><table class="table erp-table align-middle"><thead><tr><th>@Text("Component", "المكون")</th><th>@Text("Qty", "الكمية")</th><th>@Text("Unit", "الوحدة")</th><th>@Text("Calories/unit", "السعرات/الوحدة")</th><th>@Text("Total calories", "إجمالي السعرات")</th><th></th></tr></thead><tbody>
                    @if (!selectedMeal.Components.Any()) { <tr><td colspan="6" class="text-muted">@Text("No components yet.", "لا توجد مكونات بعد.")</td></tr> }
                    @foreach (var item in selectedMeal.Components) { <tr><td>@Display(item.ComponentName, item.ComponentNameEng)</td><td>@item.QuantityPerMeal.ToString("N2")</td><td>@item.UnitName</td><td>@(item.CaloriesPerUnit?.ToString("N2") ?? "-")</td><td>@(item.TotalCalories?.ToString("N2") ?? "-")</td><td class="text-end"><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteComponentAsync(item)" disabled="@busy" title="@Text("Remove", "حذف")"><i class="bi bi-trash"></i></button></td></tr> }
                </tbody></table></div>

        </AppCard>
    }

    <div class="erp-table-wrap"><table class="table erp-table align-middle"><thead><tr><th>@Text("Meal", "الوجبة")</th><th>@Text("Type", "النوع")</th><th>@Text("Structure", "التركيب")</th><th>@Text("Calories", "السعرات")</th><th>@Text("Components", "المكونات")</th><th>@Text("State", "الحالة")</th><th></th></tr></thead><tbody>
        @if (loading) { <tr><td colspan="7" class="text-muted">@Text("Loading meals...", "جاري تحميل الوجبات...")</td></tr> }
        else if (!meals.Any()) { <tr><td colspan="7" class="text-muted">@Text("No meals found.", "لا توجد وجبات.")</td></tr> }
        @foreach (var item in meals)
        {
            <tr><td>@Display(item.Name, item.NameEng)</td><td>@item.MealType</td><td>@item.StructureType</td><td>@(item.Calories?.ToString("N0") ?? "-")</td><td>@(item.StructureType == CateringMealStructureType.Product ? item.ProductSkuName : item.Components.Count)</td><td>@(item.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))</td><td class="text-end"><button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditMeal(item)" disabled="@busy" title="@Text("Edit", "تعديل")"><i class="bi bi-pencil-square"></i></button><button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => SelectMealAsync(item.Id)" disabled="@(busy || item.StructureType != CateringMealStructureType.Combo)" title="@Text("Components", "المكونات")"><i class="bi bi-list-check"></i></button><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMealAsync(item)" disabled="@busy" title="@Text("Delete", "حذف")"><i class="bi bi-trash"></i></button></td></tr>
        }
    </tbody></table></div>
</div>

@code {
    private MealDefinitionDto meal = NewMeal();
    private MealComponentDto component = new() { QuantityPerMeal = 1 };
    private List<MealDefinitionDto> meals = [];
    private List<ProductSkuDto> skus = [];
    private MealDefinitionDto? selectedMeal;
    private Guid? componentSkuId;
    private bool loading;
    private bool busy;
    private string? message;
    private string? errorMessage;

    protected override async Task OnInitializedAsync() { SharedDataService.OnChange1 += HandleChangeAsync; await LoadAsync(); }

    private async Task LoadAsync()
    {
        loading = true; errorMessage = null;
        var mealResult = await CateringService.GetMealsAsync(0, 200, ApiConfig.CompanyId, activeOnly: false);
        var skuResult = await ProductService.GetPublicStoreProductSkusAsync(new PublicStoreProductSkuRequest { PageIndex = 0, PageSize = 500 });
        if (mealResult.IsSuccess) meals = mealResult.Data?.Data.ToList() ?? []; else errorMessage = Error(mealResult.Error);
        if (skuResult.IsSuccess) skus = skuResult.Data?.Data.ToList() ?? [];
        loading = false;
    }

    private async Task SaveMealAsync()
    {
        if (meal.StructureType == CateringMealStructureType.Product && (!meal.ProductSkuId.HasValue || meal.ProductSkuId.Value == Guid.Empty))
        {
            errorMessage = Text("Select a product SKU for product meals.", "اختر صنف المنتج للوجبة المفردة.");
            return;
        }
        if (meal.StructureType == CateringMealStructureType.Combo)
        {
            meal.ProductId = null;
            meal.ProductSkuId = null;
            meal.ProductPackageId = null;
            meal.ProductSkuName = null;
            meal.ProductSkuNameEng = null;
        }
        busy = true; meal.CompanyId = ApiConfig.CompanyId;
        var success = false;
        string? failure = null;
        if (meal.Id == Guid.Empty)
        {
            var result = await CateringService.CreateMealAsync(meal);
            success = result.IsSuccess;
            failure = Error(result.Error);
        }
        else
        {
            var result = await CateringService.UpdateMealAsync(meal);
            success = result.IsSuccess;
            failure = Error(result.Error);
        }
        SetStatus(success, Text("Meal saved.", "تم حفظ الوجبة."), failure);
        meal = NewMeal(); selectedMeal = null; await LoadAsync(); busy = false;
    }

    private void EditMeal(MealDefinitionDto item) { meal = new() { Id = item.Id, CompanyId = item.CompanyId, MealType = item.MealType, StructureType = item.StructureType, ProductId = item.ProductId, ProductSkuId = item.ProductSkuId, ProductPackageId = item.ProductPackageId, ProductSkuName = item.ProductSkuName, ProductSkuNameEng = item.ProductSkuNameEng, Name = item.Name, NameEng = item.NameEng, Calories = item.Calories, IsActive = item.IsActive, Notes = item.Notes, Components = item.Components }; selectedMeal = item; }
    private async Task SelectMealAsync(Guid id) { var result = await CateringService.GetMealByIdAsync(id); if (result.IsSuccess) selectedMeal = result.Data; else errorMessage = Error(result.Error); }

    private void OnMealSkuChanged(ChangeEventArgs args)
    {
        meal.ProductSkuId = Guid.TryParse(args.Value?.ToString(), out var skuId) ? skuId : null;
        var sku = meal.ProductSkuId.HasValue ? skus.FirstOrDefault(x => x.Id == meal.ProductSkuId.Value) : null;
        if (sku is null)
        {
            meal.ProductId = null;
            meal.ProductPackageId = null;
            meal.ProductSkuName = null;
            meal.ProductSkuNameEng = null;
            return;
        }
        meal.ProductId = sku.ProductId;
        meal.ProductPackageId = sku.PackageId;
        meal.ProductSkuName = SkuName(sku);
        meal.ProductSkuNameEng = string.IsNullOrWhiteSpace(sku.NameEng) ? sku.Name : sku.NameEng;
        meal.Calories = sku.Calories.HasValue ? (int)Math.Round(sku.Calories.Value, MidpointRounding.AwayFromZero) : meal.Calories;
    }

    private void OnComponentSkuChanged(ChangeEventArgs args)
    {
        componentSkuId = Guid.TryParse(args.Value?.ToString(), out var skuId) ? skuId : null;
        ApplySelectedSkuToComponent();
    }

    private async Task AddComponentAsync()
    {
        if (selectedMeal is null || componentSkuId is null) { errorMessage = Text("Select a meal and SKU first.", "اختر الوجبة والصنف أولا."); return; }
        if (string.IsNullOrWhiteSpace(component.UnitName)) { errorMessage = Text("Selected SKU must have a configured unit.", "يجب أن يحتوي صنف الكتالوج المحدد على وحدة معرفة."); return; }
        var sku = skus.FirstOrDefault(x => x.Id == componentSkuId.Value); if (sku is null) return;
        ApplySkuToComponent(sku);
        busy = true; var result = await CateringService.AddMealComponentAsync(selectedMeal.Id, component); SetStatus(result.IsSuccess, Text("Component added.", "تمت إضافة المكون."), Error(result.Error)); component = new() { QuantityPerMeal = 1 }; componentSkuId = null; await SelectMealAsync(selectedMeal.Id); await LoadAsync(); busy = false;
    }

    private async Task DeleteComponentAsync(MealComponentDto item) { if (selectedMeal is null) return; busy = true; var result = await CateringService.DeleteMealComponentAsync(selectedMeal.Id, item.Id); SetStatus(result.IsSuccess, Text("Component removed.", "تم حذف المكون."), Error(result.Error)); await SelectMealAsync(selectedMeal.Id); await LoadAsync(); busy = false; }
    private async Task DeleteMealAsync(MealDefinitionDto item) { busy = true; var result = await CateringService.DeleteMealAsync(item.Id); SetStatus(result.IsSuccess, Text("Meal deleted.", "تم حذف الوجبة."), Error(result.Error)); await LoadAsync(); busy = false; }
    private void ClearSelection() { selectedMeal = null; component = new() { QuantityPerMeal = 1 }; componentSkuId = null; }

    private RenderFragment StatusBlock() => @<div>@if (!string.IsNullOrWhiteSpace(message)) { <div class="alert alert-success py-2">@message</div> } @if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger py-2">@errorMessage</div> }</div>;
    private void SetStatus(bool success, string successMessage, string? failureMessage) { message = success ? successMessage : null; errorMessage = success ? null : failureMessage; }
    private static MealDefinitionDto NewMeal() => new() { MealType = CateringMealType.Dry, StructureType = CateringMealStructureType.Product, IsActive = true };
    private bool IsComponentAddDisabled => selectedMeal is null || componentSkuId is null || component.QuantityPerMeal <= 0 || string.IsNullOrWhiteSpace(component.UnitName);
    private ProductSkuDto? SelectedSku => componentSkuId.HasValue ? skus.FirstOrDefault(x => x.Id == componentSkuId.Value) : null;
    private string SkuName(ProductSkuDto sku) => Display($"{sku.SkuCode} - {sku.Name}", string.IsNullOrWhiteSpace(sku.NameEng) ? $"{sku.SkuCode} - {sku.Name}" : $"{sku.SkuCodeEng} - {sku.NameEng}");
    private string SelectedSkuUnitName()
    {
        var sku = SelectedSku;
        if (sku is null) return Text("Select SKU", "اختر الصنف");
        return Display(sku.UnitName ?? string.Empty, sku.UnitNameEng);
    }
    private void ApplySelectedSkuToComponent()
    {
        var sku = SelectedSku;
        if (sku is null)
        {
            component.ProductId = null;
            component.ProductSkuId = Guid.Empty;
            component.ProductPackageId = null;
            component.ComponentName = string.Empty;
            component.ComponentNameEng = null;
            component.UnitName = null;
            return;
        }

        ApplySkuToComponent(sku);
    }

    private void ApplySkuToComponent(ProductSkuDto sku)
    {
        component.ProductId = sku.ProductId;
        component.ProductSkuId = sku.Id;
        component.ProductPackageId = sku.PackageId;
        component.ComponentName = SkuName(sku);
        component.ComponentNameEng = string.IsNullOrWhiteSpace(sku.NameEng) ? sku.Name : sku.NameEng;
        component.UnitName = Display(sku.UnitName ?? string.Empty, sku.UnitNameEng);
    }
    private string Display(string name, string? nameEng) => SharedDataService.Language == "Ar" ? name : (string.IsNullOrWhiteSpace(nameEng) ? name : nameEng);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string Error(ErrorResponseDto? error) => error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Operation failed.", "تعذرت العملية.");
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}

