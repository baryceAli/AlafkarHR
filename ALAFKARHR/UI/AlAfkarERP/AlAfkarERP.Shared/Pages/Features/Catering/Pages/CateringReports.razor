@page "/Catering/Reports"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Catering.Services
@using SharedWithUI.Catering.Dtos
@inject ICateringService CateringService
@inject ApiConfig ApiConfig
@inject SharedDataService SharedDataService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Catering Reports", "تقارير الإعاشة")" Subtitle="@Text("Operational variance by day, contract, charity, and square.", "فروقات التشغيل حسب اليوم والعقد والجمعية والمربع.")" Icon="bi-bar-chart-line" />
    @StatusBlock()

    <div class="erp-card mb-3"><div class="erp-card-body"><div class="row g-2 align-items-end">
        <div class="col-md-4"><label class="form-label">@Text("Contract", "العقد")</label><select class="form-select" @bind="contractId"><option value="">@Text("All contracts", "كل العقود")</option>@foreach (var item in contracts) { <option value="@item.Id">@item.Number - @Display(item.CustomerName, item.CustomerNameEng)</option> }</select></div>
        <div class="col-md-2"><label class="form-label">@Text("From", "من")</label><InputDate class="form-control" @bind-Value="fromDate" /></div>
        <div class="col-md-2"><label class="form-label">@Text("To", "إلى")</label><InputDate class="form-control" @bind-Value="toDate" /></div>
        <div class="col-md-2"><button class="btn btn-outline-primary w-100" @onclick="LoadAsync" disabled="@loading"><i class="bi bi-funnel"></i> @Text("Apply", "تطبيق")</button></div>
    </div></div></div>

    <div class="row g-3 mb-3">
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Contracted", "المتعاقد")</div><h5>@TotalContracted.ToString("N0")</h5></div></div></div>
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Scheduled", "المجدول")</div><h5>@TotalScheduled.ToString("N0")</h5></div></div></div>
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Received", "المستلم")</div><h5>@TotalReceived.ToString("N0")</h5></div></div></div>
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Distributed", "الموزع")</div><h5>@TotalDistributed.ToString("N0")</h5></div></div></div>
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Remaining", "المتبقي")</div><h5>@Remaining.ToString("N0")</h5></div></div></div>
        <div class="col-md-2"><div class="erp-card"><div class="erp-card-body"><div class="text-muted">@Text("Variance", "الفرق")</div><h5>@TotalVariance.ToString("N0")</h5></div></div></div>
    </div>

    <div class="erp-table-wrap"><table class="table erp-table align-middle"><thead><tr><th>@Text("Period", "الفترة")</th><th>@Text("Date", "التاريخ")</th><th>@Text("Contract", "العقد")</th><th>@Text("Charity", "الجمعية")</th><th>@Text("Square", "المربع")</th><th>@Text("Vehicle", "المركبة")</th><th>@Text("Contracted", "المتعاقد")</th><th>@Text("Scheduled", "المجدول")</th><th>@Text("Received", "المستلم")</th><th>@Text("Distributed", "الموزع")</th><th>@Text("Variance", "الفرق")</th></tr></thead><tbody>
        @if (loading) { <tr><td colspan="11" class="text-muted">@Text("Loading report...", "جاري تحميل التقرير...")</td></tr> }
        else if (!rows.Any()) { <tr><td colspan="11" class="text-muted">@Text("No report data found.", "لا توجد بيانات للتقرير.")</td></tr> }
        @foreach (var item in rows) { <tr><td>@item.PeriodKey</td><td>@(item.ServiceDate?.ToString("yyyy-MM-dd") ?? "-")</td><td>@item.ContractNumber</td><td>@item.CustomerName</td><td>@item.SquareName</td><td>@item.VehicleName</td><td>@item.ContractedQuantity.ToString("N0")</td><td>@item.ScheduledQuantity.ToString("N0")</td><td>@item.ReceivedQuantity.ToString("N0")</td><td>@item.DistributedQuantity.ToString("N0")</td><td>@item.VarianceQuantity.ToString("N0")</td></tr> }
    </tbody></table></div>
</div>

@code {
    private List<CateringReportRowDto> rows = [];
    private List<CateringContractDto> contracts = [];
    private Guid? contractId;
    private DateTime? fromDate;
    private DateTime? toDate;
    private bool loading;
    private string? errorMessage;
    private decimal TotalContracted => rows.Sum(x => x.ContractedQuantity);
    private decimal TotalScheduled => rows.Sum(x => x.ScheduledQuantity);
    private decimal TotalReceived => rows.Sum(x => x.ReceivedQuantity);
    private decimal TotalDistributed => rows.Sum(x => x.DistributedQuantity);
    private decimal TotalVariance => rows.Sum(x => x.VarianceQuantity);
    private decimal Remaining => TotalContracted - TotalDistributed;

    protected override async Task OnInitializedAsync() { SharedDataService.OnChange1 += HandleChangeAsync; var contractResult = await CateringService.GetContractsAsync(0, 300, ApiConfig.CompanyId); if (contractResult.IsSuccess) contracts = contractResult.Data?.Data.ToList() ?? []; await LoadAsync(); }
    private async Task LoadAsync() { loading = true; errorMessage = null; var result = await CateringService.GetOperationsReportAsync(ApiConfig.CompanyId, contractId, fromDate, toDate); if (result.IsSuccess) rows = result.Data ?? []; else errorMessage = Error(result.Error); loading = false; }
    private RenderFragment StatusBlock() => @<div>@if (!string.IsNullOrWhiteSpace(errorMessage)) { <div class="alert alert-danger py-2">@errorMessage</div> }</div>;
    private string Display(string name, string? nameEng) => SharedDataService.Language == "Ar" ? name : (string.IsNullOrWhiteSpace(nameEng) ? name : nameEng);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string Error(ErrorResponseDto? error) => error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Operation failed.", "تعذرت العملية.");
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
