@layout AdminLayout
@page "/Attendance/MyAttendance"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.JSInterop
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums

@inject IAttendanceService AttendanceService
@inject IJSRuntime JSRuntime
@inject SharedDataService SharedDataService

<section class="erp-page attendance-terminal" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Check in for today", "تسجيل حضور اليوم")"
                Overline="@Text("My attendance", "حضوري")"
                Icon="bi-fingerprint">
        <Actions>
            <button class="btn btn-outline-primary" @onclick="CaptureLocationAndRefreshPreviewAsync" disabled="@isBusy">
                <i class="bi bi-crosshair"></i>
                @Text("Refresh location", "تحديث الموقع")
            </button>
            <button class="btn btn-outline-secondary" @onclick="ReloadPageDataAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Reload", "إعادة تحميل")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="terminal-grid">
        <AppCard CssClass="terminal-panel identity-panel">
            <div class="panel-title">
                <h2>@Text("Employee", "الموظف")</h2>
                @if (preview is not null)
                {
                    <span class="badge text-bg-light">@AttendanceTypeText(preview.AttendanceType)</span>
                }
            </div>

            @if (preview is null)
            {
                <EmptyState Icon="bi-person-exclamation"
                            Title="@Text("Loading your employee profile.", "جاري تحميل بيانات الموظف.")" />
            }
            else
            {
                <div class="profile-block">
                    <div class="avatar">@Initials(preview.EmployeeName)</div>
                    <div>
                        <strong>@EmptyValue(preview.EmployeeName)</strong>
                        <span>@EmptyValue(preview.EmployeeEmail)</span>
                    </div>
                </div>
                <div class="detail-list">
                    <div>
                        <span>@Text("Employee code / username", "كود الموظف / اسم المستخدم")</span>
                        <strong>@EmptyValue(preview.EmployeeCode)</strong>
                    </div>
                    <div>
                        <span>@Text("Employee id", "معرف الموظف")</span>
                        <strong>@preview.EmployeeId</strong>
                    </div>
                    <div>
                        <span>@Text("Attendance mode", "نوع الحضور")</span>
                        <strong>@AttendanceTypeText(preview.AttendanceType)</strong>
                    </div>
                </div>
            }
        </AppCard>

        <AppCard CssClass="terminal-panel">
            <div class="panel-title">
                <h2>@Text("Effective shift", "الوردية الفعلية")</h2>
                @if (preview?.ShiftName is not null)
                {
                    <span class="badge text-bg-primary">@preview.ShiftName</span>
                }
            </div>

            <div class="detail-list">
                <div>
                    <span>@Text("Start", "البداية")</span>
                    <strong>@FormatDate(preview?.ShiftStart)</strong>
                </div>
                <div>
                    <span>@Text("End", "النهاية")</span>
                    <strong>@FormatDate(preview?.ShiftEnd)</strong>
                </div>
                <div>
                    <span>@Text("Late after", "التأخير بعد")</span>
                    <strong>@FormatDate(preview?.LateAfterUtc)</strong>
                </div>
                <div>
                    <span>@Text("Check-in closes", "إغلاق تسجيل الحضور")</span>
                    <strong>@FormatDate(preview?.ProhibitCheckInAfterUtc)</strong>
                </div>
            </div>
        </AppCard>

        <AppCard CssClass="terminal-panel">
            <div class="panel-title">
                <h2>@Text("Location", "الموقع")</h2>
                <StatusChip Text="@LocationBadgeText" Tone="@LocationTone" />
            </div>

            <div class="detail-list">
                <div>
                    <span>@Text("Latitude", "خط العرض")</span>
                    <strong>@Coordinate(latitude)</strong>
                </div>
                <div>
                    <span>@Text("Longitude", "خط الطول")</span>
                    <strong>@Coordinate(longitude)</strong>
                </div>
                <div>
                    <span>@Text("Accuracy", "الدقة")</span>
                    <strong>@Meters(accuracyMeters)</strong>
                </div>
                <div>
                    <span>@Text("Distance to allowed location", "المسافة إلى الموقع المسموح")</span>
                    <strong>@Meters(preview?.DistanceMeters)</strong>
                </div>
                <div>
                    <span>@Text("Allowed radius", "نطاق السماح")</span>
                    <strong>@Meters(preview?.AllowedRadiusMeters)</strong>
                </div>
            </div>
        </AppCard>

        <AppCard CssClass="terminal-panel action-panel">
            <div class="panel-title">
                <h2>@Text("Session", "الجلسة")</h2>
                @if (activeSession is not null)
                {
                    <StatusChip Text="@SessionStatusText(activeSession.Status)" Tone="@SessionTone(activeSession.Status)" />
                }
                else if (preview is not null)
                {
                    <StatusChip Text="@(preview.CanCheckIn ? Text("Ready", "جاهز") : preview.IsAttendanceCompleted ? Text("Completed", "مكتمل") : Text("Blocked", "غير متاح"))"
                                Tone="@(preview.CanCheckIn ? "success" : preview.IsAttendanceCompleted ? "muted" : "warning")" />
                }
            </div>

            <div class="readiness-card @(preview?.CanCheckIn == true ? "ready" : preview?.IsAttendanceCompleted == true ? "completed" : "blocked")">
                <i class="bi @(preview?.CanCheckIn == true ? "bi-check-circle" : preview?.IsAttendanceCompleted == true ? "bi-calendar-check" : "bi-info-circle")"></i>
                <div>
                    <strong>@ReadinessTitle</strong>
                    <span>@(preview?.Message ?? Text("Loading employee, shift, and current location...", "جاري تحميل بيانات الموظف والوردية والموقع الحالي..."))</span>
                </div>
            </div>

            <div class="action-row">
                <button class="btn btn-primary" @onclick="StartSessionAsync" disabled="@(!CanStartSession)">
                    <i class="bi bi-play-circle"></i>
                    @Text("Check in", "تسجيل حضور")
                </button>
                <button class="btn btn-outline-warning" @onclick="StartBreakAsync" disabled="@(activeSession is null || activeSession.Status != AttendanceSessionStatus.Active || isBusy)">
                    <i class="bi bi-pause-circle"></i>
                    @Text("Break", "استراحة")
                </button>
                <button class="btn btn-outline-success" @onclick="EndBreakAsync" disabled="@(activeSession is null || activeSession.Status != AttendanceSessionStatus.OnBreak || isBusy)">
                    <i class="bi bi-play"></i>
                    @Text("Resume", "استئناف")
                </button>
                <button class="btn btn-outline-danger" @onclick="EndSessionAsync" disabled="@(activeSession is null || isBusy)">
                    <i class="bi bi-stop-circle"></i>
                    @Text("End", "إنهاء")
                </button>
                <button class="btn btn-outline-primary" @onclick="EndMissingCheckInSessionAsync" disabled="@(!CanEndMissingCheckInSession)">
                    <i class="bi bi-box-arrow-right"></i>
                    @Text("Checkout without check-in", "انصراف بدون حضور")
                </button>
                <button class="btn btn-outline-warning" @onclick="OpenLateRequestModal" disabled="@(!CanSubmitLateRequest)">
                    <i class="bi bi-clock-history"></i>
                    @Text("Late attendance", "حضور متأخر")
                </button>
            </div>

            @if (activeSession is not null)
            {
                <div class="session-card">
                    <div>
                        <span>@Text("Session", "الجلسة")</span>
                        <strong>@activeSession.Id</strong>
                    </div>
                    <div>
                        <span>@Text("Started", "بدأت")</span>
                        <strong>@FormatDate(activeSession.ActualStartTime)</strong>
                    </div>
                    <div>
                        <span>@Text("Shift", "الوردية")</span>
                        <strong>@FormatDate(activeSession.ShiftStart) - @FormatDate(activeSession.ShiftEnd)</strong>
                    </div>
                </div>
            }
        </AppCard>
    </div>

    @if (IsMobileEmployee)
    {
        <div class="terminal-grid secondary-grid">
        <AppCard CssClass="terminal-panel">
            <div class="panel-title">
                <h2>@Text("Mobile actions", "إجراءات الموظف المتنقل")</h2>
            </div>

            <div class="action-stack">
                <button class="btn btn-outline-primary" @onclick="SubmitPingAsync" disabled="@(activeSession is null || activeSession.Status != AttendanceSessionStatus.Active || isBusy || !HasTrustedLocation)">
                    <i class="bi bi-geo-alt"></i>
                    @Text("Submit GPS ping", "إرسال إحداثيات GPS")
                </button>

                <label>
                    @Text("Site name", "اسم الموقع")
                    <input class="form-control" @bind="siteName" />
                </label>
                <label>
                    @Text("Notes", "ملاحظات")
                    <textarea class="form-control" rows="3" @bind="siteNotes"></textarea>
                </label>
                <button class="btn btn-outline-primary" @onclick="CreateSiteCheckInAsync" disabled="@(activeSession is null || activeSession.Status != AttendanceSessionStatus.Active || isBusy || !HasTrustedLocation)">
                    <i class="bi bi-pin-map"></i>
                    @Text("Check in at site", "تسجيل حضور في الموقع")
                </button>
            </div>
        </AppCard>
        </div>
    }
</section>

@if (isLateRequestModalOpen)
{
    <div class="late-modal-backdrop"></div>
    <div class="late-modal modal show d-block"
         tabindex="-1"
         role="dialog"
         aria-modal="true"
         aria-labelledby="late-request-title"
         dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="late-request-title">@Text("Late check-in request", "طلب تسجيل حضور متأخر")</h5>
                        <p class="late-modal-subtitle">@Text("Available after the check-in closing time.", "متاح بعد وقت إغلاق تسجيل الحضور.")</p>
                    </div>
                    <button type="button" class="btn-close" aria-label="@Text("Close", "إغلاق")" @onclick="CloseLateRequestModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert @messageClass">@message</div>
                    }

                    <div class="form-grid late-modal-form">
                        <label>
                            @Text("Requested check-in time", "وقت الحضور المطلوب")
                            <input class="form-control" type="datetime-local" @bind="lateRequestedLocal" />
                        </label>
                        <label class="wide">
                            @Text("Reason", "السبب")
                            <textarea class="form-control" rows="3" @bind="lateReason"></textarea>
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseLateRequestModal" disabled="@isBusy">
                        @Text("Cancel", "إلغاء")
                    </button>
                    <button type="button" class="btn btn-warning" @onclick="CreateLateRequestAsync" disabled="@(!CanSubmitLateRequest)">
                        <i class="bi bi-send"></i>
                        @Text("Send request", "إرسال الطلب")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private AttendanceCheckInPreviewDto? preview;
    private StartAttendanceSessionDto startModel = new();
    private AttendanceSessionDto? activeSession;
    private DateTime lateRequestedLocal = DateTime.Now;
    private double? latitude;
    private double? longitude;
    private double? accuracyMeters;
    private bool isMockedLocation;
    private string? locationIntegrityNote;
    private string siteName = "";
    private string? siteNotes;
    private string lateReason = "";
    private string? message;
    private string messageClass = "alert-info";
    private bool isBusy;
    private bool firstLocationCheckCompleted;
    private bool isLateRequestModalOpen;

    private bool HasLocation => latitude.HasValue && longitude.HasValue;
    private bool HasTrustedLocation => HasLocation && !isMockedLocation;
    private bool IsMobileEmployee => preview?.AttendanceType == EmployeeAttendanceType.Mobile;
    private bool HasGeofencePreview => preview?.AttendanceType != EmployeeAttendanceType.FixedLocation
        || (preview?.DistanceMeters.HasValue == true && preview?.AllowedRadiusMeters.HasValue == true);
    private bool CanStartSession => !isBusy && preview?.CanCheckIn == true && activeSession is null && HasTrustedLocation;
    private bool CanSubmitLateRequest => !isBusy && preview?.CanSubmitLateRequest == true && HasTrustedLocation;
    private bool CanEndMissingCheckInSession => !isBusy
        && activeSession is null
        && preview?.ShiftStart.HasValue == true
        && preview?.ShiftEnd.HasValue == true
        && !preview.IsAttendanceCompleted
        && DateTime.UtcNow >= (preview.ProhibitCheckInAfterUtc ?? preview.ShiftStart.Value);
    private string ReadinessTitle => preview?.CanCheckIn == true
        ? Text("Ready to check in", "جاهز لتسجيل الحضور")
        : preview?.IsAttendanceCompleted == true
            ? Text("Attendance completed", "تم إكمال الحضور")
            : Text("Check-in is not available", "تسجيل الحضور غير متاح");
    private string LocationBadgeText => !HasLocation
        ? Text("Waiting", "بانتظار الموقع")
        : isMockedLocation
            ? Text("Rejected", "مرفوض")
        : !HasGeofencePreview
            ? Text("Validating", "جاري التحقق")
            : preview?.IsWithinAllowedRadius == false
                ? Text("Outside", "خارج النطاق")
                : Text("Captured", "تم التقاط الموقع");
    private string LocationBadgeClass => !HasLocation
        ? "text-bg-secondary"
        : isMockedLocation
            ? "text-bg-danger"
        : !HasGeofencePreview
            ? "text-bg-warning"
            : preview?.IsWithinAllowedRadius == false
                ? "text-bg-danger"
                : "text-bg-success";

    private string LocationTone => !HasLocation
        ? "muted"
        : isMockedLocation
            ? "danger"
        : !HasGeofencePreview
            ? "warning"
            : preview?.IsWithinAllowedRadius == false
                ? "danger"
                : "success";

    protected override async Task OnInitializedAsync()
    {
        await RefreshPreviewAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || firstLocationCheckCompleted)
        {
            return;
        }

        firstLocationCheckCompleted = true;
        await CaptureLocationAndRefreshPreviewAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ReloadPageDataAsync()
    {
        await CaptureLocationAndRefreshPreviewAsync();
    }

    private async Task CaptureLocationAndRefreshPreviewAsync()
    {
        isBusy = true;
        SetMessage(Text("Reading your current GPS location...", "جاري قراءة موقع GPS الحالي..."), "alert-info");

        try
        {
            var result = await JSRuntime.InvokeAsync<LocationResult>("attendanceLocation.getCurrentPosition");
            if (result.Success)
            {
                latitude = result.Latitude;
                longitude = result.Longitude;
                accuracyMeters = result.AccuracyMeters;
                isMockedLocation = result.IsMockedLocation;
                locationIntegrityNote = result.LocationIntegrityNote;
            }
            else
            {
                SetMessage(result.Message ?? Text("Unable to read your current location.", "تعذرت قراءة موقعك الحالي."), "alert-warning");
            }
        }
        catch (JSException)
        {
            SetMessage(Text("Unable to access the location service. Refresh the page and allow location access.", "تعذر الوصول إلى خدمة الموقع. حدث الصفحة واسمح بالوصول إلى الموقع."), "alert-warning");
        }

        isBusy = false;
        await RefreshPreviewAsync();
    }

    private async Task RefreshPreviewAsync()
    {
        isBusy = true;
        var response = await AttendanceService.GetMyCheckInPreviewAsync(
            latitude,
            longitude,
            accuracyMeters,
            isMockedLocation,
            locationIntegrityNote,
            DateTime.UtcNow);

        if (response.IsSuccess && response.Data is not null)
        {
            preview = response.Data;
            activeSession = preview.ActiveSession;
            lateRequestedLocal = DateTime.Now;

            SetMessage(preview.Message, PreviewMessageClass(preview));
        }
        else
        {
            SetMessage(response.Error?.Detail ?? Text("Unable to validate check-in readiness.", "تعذر التحقق من جاهزية تسجيل الحضور."), "alert-danger");
        }

        isBusy = false;
    }

    private async Task StartSessionAsync()
    {
        if (!CanStartSession || preview is null)
        {
            SetMessage(preview?.Message ?? Text("Check-in is not available yet.", "تسجيل الحضور غير متاح حاليا."), "alert-warning");
            return;
        }

        isBusy = true;
        startModel.EmployeeId = preview.EmployeeId;
        startModel.ShiftId = preview.ShiftId;
        startModel.ShiftStart = preview.ShiftStart!.Value;
        startModel.ShiftEnd = preview.ShiftEnd!.Value;
        startModel.Latitude = latitude;
        startModel.Longitude = longitude;
        startModel.AccuracyMeters = accuracyMeters;
        startModel.IsMockedLocation = isMockedLocation;
        startModel.LocationIntegrityNote = locationIntegrityNote;
        startModel.ManualOverrideReason = null;

        var response = await AttendanceService.StartSessionAsync(startModel);
        if (response.IsSuccess && response.Data is not null)
        {
            activeSession = response.Data;
            SetMessage(Text("Attendance session started.", "تم بدء جلسة الحضور."), "alert-success");
        }
        else
        {
            SetMessage(response.Error?.Detail ?? Text("Unable to start session.", "تعذر بدء الجلسة."), "alert-danger");
        }

        isBusy = false;
        await RefreshPreviewAsync();
    }

    private async Task EndSessionAsync()
    {
        if (activeSession is null) return;

        isBusy = true;
        var response = await AttendanceService.EndSessionAsync(activeSession.Id);
        if (response.IsSuccess)
        {
            activeSession = response.Data;
            SetMessage(Text("Attendance session ended.", "تم إنهاء جلسة الحضور."), "alert-success");
        }
        else
        {
            SetMessage(response.Error?.Detail ?? Text("Unable to end session.", "تعذر إنهاء الجلسة."), "alert-danger");
        }

        isBusy = false;
        await RefreshPreviewAsync();
    }

    private async Task EndMissingCheckInSessionAsync()
    {
        if (!CanEndMissingCheckInSession || preview is null)
        {
            SetMessage(preview?.Message ?? Text("Checkout is not available yet.", "الانصراف غير متاح حاليا."), "alert-warning");
            return;
        }

        isBusy = true;
        var response = await AttendanceService.EndMissingCheckInSessionAsync(new EndMissingCheckInAttendanceSessionDto
        {
            EmployeeId = preview.EmployeeId,
            ShiftId = preview.ShiftId,
            ShiftStart = preview.ShiftStart!.Value,
            ShiftEnd = preview.ShiftEnd!.Value
        });

        if (response.IsSuccess && response.Data is not null)
        {
            activeSession = response.Data;
            SetMessage(Text("Checkout recorded. A manager must normalize the missing check-in before hours are calculated.", "تم تسجيل الانصراف. يجب على المدير تصحيح الحضور المفقود قبل احتساب الساعات."), "alert-warning");
        }
        else
        {
            SetMessage(response.Error?.Detail ?? Text("Unable to record checkout.", "تعذر تسجيل الانصراف."), "alert-danger");
        }

        isBusy = false;
        await RefreshPreviewAsync();
    }

    private async Task StartBreakAsync() => await ChangeBreakStateAsync(true);
    private async Task EndBreakAsync() => await ChangeBreakStateAsync(false);

    private async Task ChangeBreakStateAsync(bool startBreak)
    {
        if (activeSession is null) return;

        isBusy = true;
        var response = startBreak
            ? await AttendanceService.StartBreakAsync(activeSession.Id)
            : await AttendanceService.EndBreakAsync(activeSession.Id);

        if (response.IsSuccess)
        {
            activeSession = response.Data;
            SetMessage(startBreak ? Text("Break started.", "بدأت الاستراحة.") : Text("Break ended.", "انتهت الاستراحة."), "alert-success");
        }
        else
        {
            SetMessage(response.Error?.Detail ?? Text("Unable to update break state.", "تعذر تحديث حالة الاستراحة."), "alert-danger");
        }

        isBusy = false;
        await RefreshPreviewAsync();
    }

    private async Task SubmitPingAsync()
    {
        if (activeSession is null || !HasLocation) return;

        isBusy = true;
        var response = await AttendanceService.SubmitLocationPingAsync(new AttendanceLocationPingDto
        {
            ClientPingId = Guid.NewGuid(),
            SessionId = activeSession.Id,
            EmployeeId = activeSession.EmployeeId,
            Latitude = latitude!.Value,
            Longitude = longitude!.Value,
            AccuracyMeters = accuracyMeters,
            IsMockedLocation = isMockedLocation,
            LocationIntegrityNote = locationIntegrityNote,
            RecordedAtUtc = DateTime.UtcNow
        });

        SetMessage(response.IsSuccess ? Text("Location ping submitted.", "تم إرسال إحداثيات الموقع.") : response.Error?.Detail ?? Text("Unable to submit ping.", "تعذر إرسال إحداثيات الموقع."), response.IsSuccess ? "alert-success" : "alert-danger");
        isBusy = false;
    }

    private async Task CreateSiteCheckInAsync()
    {
        if (activeSession is null || !HasLocation) return;
        if (string.IsNullOrWhiteSpace(siteName))
        {
            SetMessage(Text("Site name is required.", "اسم الموقع مطلوب."), "alert-warning");
            return;
        }

        isBusy = true;
        var response = await AttendanceService.CreateCheckInAsync(new AttendanceCheckInDto
        {
            ClientCheckInId = Guid.NewGuid(),
            SessionId = activeSession.Id,
            EmployeeId = activeSession.EmployeeId,
            SiteName = siteName.Trim(),
            Latitude = latitude!.Value,
            Longitude = longitude!.Value,
            ArrivedAtUtc = DateTime.UtcNow,
            IsMockedLocation = isMockedLocation,
            LocationIntegrityNote = locationIntegrityNote,
            Notes = siteNotes
        });

        SetMessage(response.IsSuccess ? Text("Site check-in saved.", "تم حفظ تسجيل الحضور في الموقع.") : response.Error?.Detail ?? Text("Unable to save site check-in.", "تعذر حفظ تسجيل الحضور في الموقع."), response.IsSuccess ? "alert-success" : "alert-danger");
        isBusy = false;
    }

    private void OpenLateRequestModal()
    {
        if (!CanSubmitLateRequest)
        {
            SetMessage(preview?.Message ?? Text("Late check-in request is not available now.", "طلب تسجيل الحضور المتأخر غير متاح الآن."), "alert-warning");
            return;
        }

        isLateRequestModalOpen = true;
    }

    private void CloseLateRequestModal()
    {
        if (isBusy)
        {
            return;
        }

        isLateRequestModalOpen = false;
    }

    private async Task CreateLateRequestAsync()
    {
        if (!CanSubmitLateRequest || preview is null)
        {
            SetMessage(preview?.Message ?? Text("Late check-in request is not available now.", "طلب تسجيل الحضور المتأخر غير متاح الآن."), "alert-warning");
            return;
        }

        if (string.IsNullOrWhiteSpace(lateReason))
        {
            SetMessage(Text("Reason is required for late check-in request.", "السبب مطلوب لطلب تسجيل الحضور المتأخر."), "alert-warning");
            return;
        }

        isBusy = true;
        var response = await AttendanceService.CreateLateCheckInRequestAsync(new CreateLateCheckInRequestDto
        {
            EmployeeId = preview.EmployeeId,
            ShiftId = preview.ShiftId,
            ShiftStart = preview.ShiftStart!.Value,
            ShiftEnd = preview.ShiftEnd!.Value,
            RequestedCheckInTimeUtc = lateRequestedLocal.ToUniversalTime(),
            Reason = lateReason,
            Latitude = latitude,
            Longitude = longitude,
            AccuracyMeters = accuracyMeters,
            IsMockedLocation = isMockedLocation,
            LocationIntegrityNote = locationIntegrityNote
        });

        if (response.IsSuccess)
        {
            isLateRequestModalOpen = false;
        }

        SetMessage(response.IsSuccess ? Text("Late check-in request sent.", "تم إرسال طلب تسجيل الحضور المتأخر.") : response.Error?.Detail ?? Text("Unable to send late request.", "تعذر إرسال طلب التأخير."), response.IsSuccess ? "alert-success" : "alert-danger");
        isBusy = false;
    }

    private void SetMessage(string text, string cssClass)
    {
        message = text;
        messageClass = cssClass;
    }

    private static string PreviewMessageClass(AttendanceCheckInPreviewDto preview)
    {
        if (preview.CanCheckIn)
        {
            return preview.IsLate ? "alert-warning" : "alert-success";
        }

        return preview.CanSubmitLateRequest || preview.IsWithinAllowedRadius == false ? "alert-warning" : "alert-info";
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "E";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts.Length > 0 ? parts[0][..1] : "";
        var last = parts.Length > 1 ? parts[^1][..1] : "";
        return $"{first}{last}".ToUpperInvariant();
    }

    private static string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("g") : "-";
    private static string Coordinate(double? value) => value.HasValue ? value.Value.ToString("F6") : "-";
    private string Meters(double? value) => value.HasValue ? $"{value.Value:N0} {Text("m", "م")}" : "-";

    private string AttendanceTypeText(EmployeeAttendanceType type) => type switch
    {
        EmployeeAttendanceType.FixedLocation => Text("Fixed location", "موقع ثابت"),
        EmployeeAttendanceType.Mobile => Text("Mobile", "متنقل"),
        _ => type.ToString()
    };

    private string SessionStatusText(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => Text("Active", "نشط"),
        AttendanceSessionStatus.OnBreak => Text("On break", "في استراحة"),
        AttendanceSessionStatus.Completed => Text("Completed", "مكتمل"),
        AttendanceSessionStatus.Cancelled => Text("Cancelled", "ملغى"),
        _ => status.ToString()
    };

    private static string StatusClass(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => "text-bg-success",
        AttendanceSessionStatus.OnBreak => "text-bg-warning",
        AttendanceSessionStatus.Completed => "text-bg-secondary",
        _ => "text-bg-light"
    };

    private static string SessionTone(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => "success",
        AttendanceSessionStatus.OnBreak => "warning",
        AttendanceSessionStatus.Completed => "muted",
        AttendanceSessionStatus.Cancelled => "danger",
        _ => "muted"
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private sealed class LocationResult
    {
        public bool Success { get; set; }
        public double? Latitude { get; set; }
        public double? Longitude { get; set; }
        public double? AccuracyMeters { get; set; }
        public bool IsMockedLocation { get; set; }
        public string? LocationIntegrityNote { get; set; }
        public string? Message { get; set; }
    }
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

