@layout AdminLayout
@page "/Attendance/Configuration"

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums

@inject IAttendanceService AttendanceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <p class="text-muted mb-1">@Text("Attendance", "الحضور والانصراف")</p>
            <h3 class="mb-1">@Text("Attendance Configuration", "اعدادات الحضور")</h3>
            <p class="text-muted mb-0">@Text("Configure weekly working times, weekend days, and break policy rules.", "تحديد أوقات العمل الأسبوعية وأيام نهاية الأسبوع وسياسات الاستراحة.")</p>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@isBusy">@Text("Refresh", "تحديث")</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@Text("Weekly Working Time", "أوقات العمل الأسبوعية")</h5>
                <button class="btn btn-primary" @onclick="SaveConfigurationAsync" disabled="@isBusy">@Text("Save", "حفظ")</button>
            </div>
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">@Text("First day of week", "أول يوم في الأسبوع")</label>
                    <select class="form-select" @bind="configuration.FirstDayOfWeek">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@day">@DayName(day)</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <div class="alert alert-info mb-0">
                        @Text("Working days require start and end times. Weekend days are treated as non-working days in reports and summaries.", "أيام العمل تتطلب وقت بداية ونهاية. أيام نهاية الأسبوع تعامل كأيام غير عمل في التقارير والملخصات.")
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Day", "اليوم")</th>
                            <th>@Text("Working", "عمل")</th>
                            <th>@Text("Weekend", "نهاية الأسبوع")</th>
                            <th>@Text("Start", "البداية")</th>
                            <th>@Text("End", "النهاية")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in configuration.DaySchedules.OrderBy(x => DayOrder(x.DayOfWeek)))
                        {
                            <tr>
                                <td>@DayName(day.DayOfWeek)</td>
                                <td><input class="form-check-input" type="checkbox" @bind="day.IsWorkingDay" /></td>
                                <td><input class="form-check-input" type="checkbox" checked="@configuration.WeekendDays.Contains(day.DayOfWeek)" @onchange="args => ToggleWeekend(day.DayOfWeek, args)" /></td>
                                <td><input class="form-control" type="time" value="@FormatTimeInput(day.StartTime)" @onchange="args => SetStartTime(day, args)" disabled="@(!day.IsWorkingDay)" /></td>
                                <td><input class="form-control" type="time" value="@FormatTimeInput(day.EndTime)" @onchange="args => SetEndTime(day, args)" disabled="@(!day.IsWorkingDay)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            <h5>@Text("Break Policy", "سياسة الاستراحة")</h5>
            <div class="alert alert-info">
                @Text("Flexible: employees can start break anytime during the working day. Strict: employees can start break only between the configured break start and end time.", "المرن: يمكن للموظف بدء الاستراحة في أي وقت خلال يوم العمل. المحدد: يمكن بدء الاستراحة فقط بين وقت بداية ونهاية الاستراحة المحددين.")
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Text("Scope", "النطاق")</label>
                    <select class="form-select" @bind="breakPolicy.Scope">
                        <option value="@ShiftAssignmentScope.Company">@Text("Organization", "المنظمة")</option>
                        <option value="@ShiftAssignmentScope.Administration">@Text("Administration", "الادارة")</option>
                        <option value="@ShiftAssignmentScope.Department">@Text("Department", "القسم")</option>
                        <option value="@ShiftAssignmentScope.Employee">@Text("Employee", "الموظف")</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Text("Administration Id", "معرف الادارة")</label>
                    <input class="form-control" @bind="administrationIdText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Text("Department Id", "معرف القسم")</label>
                    <input class="form-control" @bind="departmentIdText" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Text("Employee Id", "معرف الموظف")</label>
                    <input class="form-control" @bind="employeeIdText" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Enabled", "مفعل")</label>
                    <select class="form-select" @bind="breakPolicy.IsEnabled">
                        <option value="true">@Text("Yes", "نعم")</option>
                        <option value="false">@Text("No", "لا")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Mode", "الوضع")</label>
                    <select class="form-select" @bind="breakPolicy.BreakMode">
                        <option value="@AttendanceBreakMode.Flexible">@Text("Flexible", "مرن")</option>
                        <option value="@AttendanceBreakMode.Strict">@Text("Strict", "محدد")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Start", "البداية")</label>
                    <input class="form-control" type="time" @bind="breakStart" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("End", "النهاية")</label>
                    <input class="form-control" type="time" @bind="breakEnd" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Allowed minutes", "الدقائق المسموحة")</label>
                    <input class="form-control" type="number" min="0" @bind="breakPolicy.AllowedDurationMinutes" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Paid", "مدفوعة")</label>
                    <select class="form-select" @bind="breakPolicy.IsPaid">
                        <option value="true">@Text("Yes", "نعم")</option>
                        <option value="false">@Text("No", "لا")</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="SaveBreakPolicyAsync" disabled="@isBusy">@Text("Save Policy", "حفظ السياسة")</button>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h5>@Text("Configured Policies", "السياسات المحفوظة")</h5>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@Text("Scope", "النطاق")</th>
                            <th>@Text("Enabled", "مفعل")</th>
                            <th>@Text("Mode", "الوضع")</th>
                            <th>@Text("Time", "الوقت")</th>
                            <th>@Text("Minutes", "الدقائق")</th>
                            <th>@Text("Paid", "مدفوعة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var policy in policies)
                        {
                            <tr>
                                <td>@policy.Scope</td>
                                <td>@YesNo(policy.IsEnabled)</td>
                                <td>@BreakModeText(policy.BreakMode)</td>
                                <td>@policy.BreakStartTime - @policy.BreakEndTime</td>
                                <td>@policy.AllowedDurationMinutes</td>
                                <td>@YesNo(policy.IsPaid)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@code {
    private AttendanceConfigurationDto configuration = new();
    private UpsertAttendanceBreakPolicyDto breakPolicy = new() { AllowedDurationMinutes = 60 };
    private List<AttendanceBreakPolicyDto> policies = [];
    private TimeOnly breakStart = new(12, 0);
    private TimeOnly breakEnd = new(13, 0);
    private string? administrationIdText;
    private string? departmentIdText;
    private string? employeeIdText;
    private Guid companyId;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        configuration.CompanyId = companyId;
        breakPolicy.CompanyId = companyId;
        EnsureWeekRows();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (companyId == Guid.Empty) return;
        isBusy = true;
        var configResult = await AttendanceService.GetConfigurationAsync(companyId);
        if (configResult.IsSuccess && configResult.Data is not null)
        {
            configuration = configResult.Data;
            EnsureWeekRows();
        }

        var policyResult = await AttendanceService.GetBreakPoliciesAsync(companyId);
        if (policyResult.IsSuccess)
        {
            policies = policyResult.Data ?? [];
        }
        else
        {
            SetMessage(policyResult.Error?.Detail ?? Text("Unable to load configuration.", "تعذر تحميل الاعدادات."), "alert-danger");
        }

        isBusy = false;
    }

    private async Task SaveConfigurationAsync()
    {
        var validation = ValidateConfiguration();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            SetMessage(validation, "alert-warning");
            return;
        }

        configuration.CompanyId = companyId;
        var result = await AttendanceService.UpsertConfigurationAsync(new UpsertAttendanceConfigurationDto
        {
            CompanyId = companyId,
            FirstDayOfWeek = configuration.FirstDayOfWeek,
            DaySchedules = configuration.DaySchedules,
            WeekendDays = configuration.WeekendDays
        });
        SetMessage(result.IsSuccess ? Text("Configuration saved.", "تم حفظ الاعدادات.") : result.Error?.Detail ?? Text("Unable to save.", "تعذر الحفظ."), result.IsSuccess ? "alert-success" : "alert-danger");
    }

    private async Task SaveBreakPolicyAsync()
    {
        breakPolicy.CompanyId = companyId;
        breakPolicy.AdministrationId = ParseGuid(administrationIdText);
        breakPolicy.DepartmentId = ParseGuid(departmentIdText);
        breakPolicy.EmployeeId = ParseGuid(employeeIdText);
        breakPolicy.BreakStartTime = breakStart.ToTimeSpan();
        breakPolicy.BreakEndTime = breakEnd.ToTimeSpan();

        if (breakPolicy.BreakMode == AttendanceBreakMode.Strict && breakPolicy.BreakEndTime <= breakPolicy.BreakStartTime)
        {
            SetMessage(Text("Strict break end time must be after start time.", "وقت نهاية الاستراحة المحددة يجب أن يكون بعد وقت البداية."), "alert-warning");
            return;
        }

        var result = await AttendanceService.UpsertBreakPolicyAsync(breakPolicy);
        if (result.IsSuccess)
        {
            SetMessage(Text("Break policy saved.", "تم حفظ سياسة الاستراحة."), "alert-success");
            await LoadAsync();
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to save break policy.", "تعذر حفظ سياسة الاستراحة."), "alert-danger");
        }
    }

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        var value = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        return Guid.TryParse(value, out var id) ? id : Guid.Empty;
    }

    private static Guid? ParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private string YesNo(bool value) => value ? Text("Yes", "نعم") : Text("No", "لا");
    private string BreakModeText(AttendanceBreakMode mode) => mode == AttendanceBreakMode.Strict ? Text("Strict", "محدد") : Text("Flexible", "مرن");
    private string DayName(DayOfWeek day) => Text(day.ToString(), day.ToString());
    private static int DayOrder(DayOfWeek day) => day == DayOfWeek.Saturday ? 0 : (int)day + 1;

    private void ToggleWeekend(DayOfWeek day, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked && !configuration.WeekendDays.Contains(day))
        {
            configuration.WeekendDays.Add(day);
        }
        else if (!isChecked)
        {
            configuration.WeekendDays.Remove(day);
        }
    }

    private static string FormatTimeInput(TimeSpan? value)
        => value.HasValue ? value.Value.ToString(@"hh\:mm") : string.Empty;

    private static void SetStartTime(AttendanceDayScheduleDto day, ChangeEventArgs args)
        => day.StartTime = TimeSpan.TryParse(args.Value?.ToString(), out var value) ? value : null;

    private static void SetEndTime(AttendanceDayScheduleDto day, ChangeEventArgs args)
        => day.EndTime = TimeSpan.TryParse(args.Value?.ToString(), out var value) ? value : null;

    private void EnsureWeekRows()
    {
        var existing = configuration.DaySchedules.ToDictionary(x => x.DayOfWeek);
        configuration.DaySchedules = AttendanceDayScheduleDto.DefaultWeek()
            .Select(defaultDay => existing.TryGetValue(defaultDay.DayOfWeek, out var day) ? day : defaultDay)
            .ToList();

        if (configuration.WeekendDays.Count == 0)
        {
            configuration.WeekendDays = [DayOfWeek.Friday, DayOfWeek.Saturday];
        }
    }

    private string? ValidateConfiguration()
    {
        if (configuration.WeekendDays.Count == 0)
        {
            return Text("Select at least one weekend day.", "اختر يوما واحدا على الأقل لنهاية الأسبوع.");
        }

        foreach (var day in configuration.DaySchedules.Where(x => x.IsWorkingDay))
        {
            if (!day.StartTime.HasValue || !day.EndTime.HasValue)
            {
                return Text($"{day.DayOfWeek} requires start and end time.", $"{day.DayOfWeek} requires start and end time.");
            }

            if (day.EndTime <= day.StartTime)
            {
                return Text($"{day.DayOfWeek} end time must be after start time.", $"{day.DayOfWeek} end time must be after start time.");
            }
        }

        return null;
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }
}
