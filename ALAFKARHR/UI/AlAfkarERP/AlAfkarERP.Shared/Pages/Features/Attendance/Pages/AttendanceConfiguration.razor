@layout AdminLayout
@page "/Attendance/Configuration"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Organization.Dtos

@inject IAttendanceService AttendanceService
@inject IAdministrationService AdministrationService
@inject IDepartmentService DepartmentService
@inject IEmployeeService EmployeeService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Attendance Configuration", "إعدادات الحضور")"
                Subtitle="@Text("Configure weekly working times and break policy rules.", "تحديد أوقات العمل الأسبوعية وسياسات الاستراحة.")"
                Overline="@Text("Attendance", "الحضور والانصراف")"
                Icon="bi-sliders">
        <Actions>
            <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="erp-card mb-3">
        <div class="erp-card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@Text("Weekly Working Time", "أوقات العمل الأسبوعية")</h5>
                <button class="btn btn-primary" @onclick="SaveConfigurationAsync" disabled="@isBusy">@Text("Save", "حفظ")</button>
            </div>
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-4">
                    <label class="form-label">@Text("First day of week", "أول يوم في الأسبوع")</label>
                    <select class="form-select" @bind="configuration.FirstDayOfWeek">
                        @foreach (var day in Enum.GetValues<DayOfWeek>())
                        {
                            <option value="@day">@DayName(day)</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <div class="alert alert-info mb-0">
                        @Text($"Working days require start and end times. Current weekend days: {CurrentWeekendDaysText()}. Manage weekends from Attendance > Holidays.", $"أيام العمل تتطلب وقت بداية ونهاية. أيام نهاية الأسبوع الحالية: {CurrentWeekendDaysText()}. تتم إدارة نهاية الأسبوع من الحضور > العطلات.")
                    </div>
                </div>
            </div>

            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Day", "اليوم")</th>
                            <th>@Text("Working", "عمل")</th>
                            <th>@Text("Start", "البداية")</th>
                            <th>@Text("End", "النهاية")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var day in configuration.DaySchedules.OrderBy(x => DayOrder(x.DayOfWeek)))
                        {
                            <tr>
                                <td>@DayName(day.DayOfWeek)</td>
                                <td><input class="form-check-input" type="checkbox" checked="@day.IsWorkingDay" @onchange="args => ToggleWorkingDay(day, args)" disabled="@configuration.WeekendDays.Contains(day.DayOfWeek)" /></td>
                                <td><input class="form-control" type="time" value="@FormatTimeInput(day.StartTime)" @onchange="args => SetStartTime(day, args)" disabled="@(!day.IsWorkingDay)" /></td>
                                <td><input class="form-control" type="time" value="@FormatTimeInput(day.EndTime)" @onchange="args => SetEndTime(day, args)" disabled="@(!day.IsWorkingDay)" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="erp-card mb-3">
        <div class="erp-card-body">
            <h5>@Text("Break Policy", "سياسة الاستراحة")</h5>
            <div class="alert alert-info">
                @Text("Flexible: employees can start break anytime during the working day. Strict: employees can start break only between the configured break start and end time.", "المرن: يمكن للموظف بدء الاستراحة في أي وقت خلال يوم العمل. المحدد: يمكن بدء الاستراحة فقط بين وقت بداية ونهاية الاستراحة المحددين.")
            </div>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">@Text("Scope", "النطاق")</label>
                    <select class="form-select" @bind="breakPolicy.Scope" @bind:after="OnBreakPolicyScopeChanged">
                        <option value="@ShiftAssignmentScope.Company">@Text("Organization", "المنظمة")</option>
                        <option value="@ShiftAssignmentScope.Administration">@Text("Administration", "الادارة")</option>
                        <option value="@ShiftAssignmentScope.Department">@Text("Department", "القسم")</option>
                        <option value="@ShiftAssignmentScope.Employee">@Text("Employee", "الموظف")</option>
                    </select>
                </div>
                @if (breakPolicy.Scope == ShiftAssignmentScope.Administration)
                {
                    <div class="col-md-3">
                        <label class="form-label">@Text("Administration", "الادارة")</label>
                        <AutoCompleteComponent TItem="AdministrationDto"
                                               Items="administrations"
                                               ItemText="AdministrationSearchText"
                                               Value="selectedAdministration"
                                               PlaceHolder="@Text("Search administration by name or code", "ابحث عن الإدارة بالاسم أو الكود")"
                                               ValueChanged="OnAdministrationSelected" />
                    </div>
                }
                @if (breakPolicy.Scope == ShiftAssignmentScope.Department)
                {
                    <div class="col-md-3">
                        <label class="form-label">@Text("Department", "القسم")</label>
                        <AutoCompleteComponent TItem="DepartmentDto"
                                               Items="departments"
                                               ItemText="DepartmentSearchText"
                                               Value="selectedDepartment"
                                               PlaceHolder="@Text("Search department by name or code", "ابحث عن القسم بالاسم أو الكود")"
                                               ValueChanged="OnDepartmentSelected" />
                    </div>
                }
                @if (breakPolicy.Scope == ShiftAssignmentScope.Employee)
                {
                    <div class="col-md-3">
                        <label class="form-label">@Text("Employee", "الموظف")</label>
                        <AutoCompleteComponent TItem="EmployeeDto"
                                               Items="employees"
                                               ItemText="EmployeeSearchText"
                                               Value="selectedEmployee"
                                               PlaceHolder="@Text("Search employee by name, code, number, or email", "ابحث عن الموظف بالاسم أو الكود أو الرقم أو البريد")"
                                               ValueChanged="OnEmployeeSelected" />
                    </div>
                }
                <div class="col-md-2">
                    <label class="form-label">@Text("Enabled", "مفعل")</label>
                    <select class="form-select" @bind="breakPolicy.IsEnabled">
                        <option value="true">@Text("Yes", "نعم")</option>
                        <option value="false">@Text("No", "لا")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Mode", "الوضع")</label>
                    <select class="form-select" @bind="breakPolicy.BreakMode">
                        <option value="@AttendanceBreakMode.Flexible">@Text("Flexible", "مرن")</option>
                        <option value="@AttendanceBreakMode.Strict">@Text("Strict", "محدد")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Start", "البداية")</label>
                    <input class="form-control" type="time" @bind="breakStart" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("End", "النهاية")</label>
                    <input class="form-control" type="time" @bind="breakEnd" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Allowed minutes", "الدقائق المسموحة")</label>
                    <input class="form-control" type="number" min="0" @bind="breakPolicy.AllowedDurationMinutes" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">@Text("Paid", "مدفوعة")</label>
                    <select class="form-select" @bind="breakPolicy.IsPaid">
                        <option value="true">@Text("Yes", "نعم")</option>
                        <option value="false">@Text("No", "لا")</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="SaveBreakPolicyAsync" disabled="@isBusy">@Text("Save Policy", "حفظ السياسة")</button>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-card">
        <div class="erp-card-body">
            <h5>@Text("Configured Policies", "السياسات المحفوظة")</h5>
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Scope", "النطاق")</th>
                            <th>@Text("Enabled", "مفعل")</th>
                            <th>@Text("Mode", "الوضع")</th>
                            <th>@Text("Time", "الوقت")</th>
                            <th>@Text("Minutes", "الدقائق")</th>
                            <th>@Text("Paid", "مدفوعة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var policy in policies)
                        {
                            <tr>
                                <td>@policy.Scope</td>
                                <td>@YesNo(policy.IsEnabled)</td>
                                <td>@BreakModeText(policy.BreakMode)</td>
                                <td>@policy.BreakStartTime - @policy.BreakEndTime</td>
                                <td>@policy.AllowedDurationMinutes</td>
                                <td>@YesNo(policy.IsPaid)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@code {
    private AttendanceConfigurationDto configuration = new();
    private UpsertAttendanceBreakPolicyDto breakPolicy = new() { AllowedDurationMinutes = 60 };
    private List<AttendanceBreakPolicyDto> policies = [];
    private List<AdministrationDto> administrations = [];
    private List<DepartmentDto> departments = [];
    private List<EmployeeDto> employees = [];
    private AdministrationDto? selectedAdministration;
    private DepartmentDto? selectedDepartment;
    private EmployeeDto? selectedEmployee;
    private TimeOnly breakStart = new(12, 0);
    private TimeOnly breakEnd = new(13, 0);
    private Guid companyId;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        configuration.CompanyId = companyId;
        breakPolicy.CompanyId = companyId;
        EnsureWeekRows();
        await LoadAsync();
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task LoadAsync()
    {
        if (companyId == Guid.Empty) return;
        isBusy = true;
        await LoadReferenceDataAsync();

        var configResult = await AttendanceService.GetConfigurationAsync(companyId);
        if (configResult.IsSuccess && configResult.Data is not null)
        {
            configuration = configResult.Data;
            EnsureWeekRows();
        }

        var policyResult = await AttendanceService.GetBreakPoliciesAsync(companyId);
        if (policyResult.IsSuccess)
        {
            policies = policyResult.Data ?? [];
        }
        else
        {
            SetMessage(policyResult.Error?.Detail ?? Text("Unable to load configuration.", "تعذر تحميل الاعدادات."), "alert-danger");
        }

        isBusy = false;
    }

    private async Task SaveConfigurationAsync()
    {
        var validation = ValidateConfiguration();
        if (!string.IsNullOrWhiteSpace(validation))
        {
            SetMessage(validation, "alert-warning");
            return;
        }

        configuration.CompanyId = companyId;
        var result = await AttendanceService.UpsertConfigurationAsync(new UpsertAttendanceConfigurationDto
        {
            CompanyId = companyId,
            FirstDayOfWeek = configuration.FirstDayOfWeek,
            DaySchedules = configuration.DaySchedules,
            WeekendDays = configuration.WeekendDays
        });
        SetMessage(result.IsSuccess ? Text("Configuration saved.", "تم حفظ الاعدادات.") : result.Error?.Detail ?? Text("Unable to save.", "تعذر الحفظ."), result.IsSuccess ? "alert-success" : "alert-danger");
    }

    private async Task SaveBreakPolicyAsync()
    {
        breakPolicy.CompanyId = companyId;
        ClearUnusedBreakPolicyTargets();

        var targetValidation = ValidateBreakPolicyTarget();
        if (!string.IsNullOrWhiteSpace(targetValidation))
        {
            SetMessage(targetValidation, "alert-warning");
            return;
        }

        breakPolicy.BreakStartTime = breakStart.ToTimeSpan();
        breakPolicy.BreakEndTime = breakEnd.ToTimeSpan();

        if (breakPolicy.BreakMode == AttendanceBreakMode.Strict && breakPolicy.BreakEndTime <= breakPolicy.BreakStartTime)
        {
            SetMessage(Text("Strict break end time must be after start time.", "وقت نهاية الاستراحة المحددة يجب أن يكون بعد وقت البداية."), "alert-warning");
            return;
        }

        var result = await AttendanceService.UpsertBreakPolicyAsync(breakPolicy);
        if (result.IsSuccess)
        {
            SetMessage(Text("Break policy saved.", "تم حفظ سياسة الاستراحة."), "alert-success");
            await LoadAsync();
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to save break policy.", "تعذر حفظ سياسة الاستراحة."), "alert-danger");
        }
    }

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        var value = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        return Guid.TryParse(value, out var id) ? id : Guid.Empty;
    }

    private async Task LoadReferenceDataAsync()
    {
        var administrationsResult = await AdministrationService.GetAsync(0, 5000);
        if (administrationsResult.IsSuccess)
        {
            administrations = administrationsResult.Data?.Data.ToList() ?? [];
        }

        var departmentsResult = await DepartmentService.GetAsync(0, 5000);
        if (departmentsResult.IsSuccess)
        {
            departments = departmentsResult.Data?.Data.ToList() ?? [];
        }

        var employeesResult = await EmployeeService.GetByCompanyIdAsync(companyId, 0, 5000);
        if (employeesResult.IsSuccess)
        {
            employees = employeesResult.Data?.Data.ToList() ?? [];
        }
    }

    private void OnBreakPolicyScopeChanged()
    {
        ClearUnusedBreakPolicyTargets();
    }

    private void ClearUnusedBreakPolicyTargets()
    {
        if (breakPolicy.Scope != ShiftAssignmentScope.Administration)
        {
            breakPolicy.AdministrationId = null;
            selectedAdministration = null;
        }

        if (breakPolicy.Scope != ShiftAssignmentScope.Department)
        {
            breakPolicy.DepartmentId = null;
            selectedDepartment = null;
        }

        if (breakPolicy.Scope != ShiftAssignmentScope.Employee)
        {
            breakPolicy.EmployeeId = null;
            selectedEmployee = null;
        }
    }

    private string? ValidateBreakPolicyTarget() => breakPolicy.Scope switch
    {
        ShiftAssignmentScope.Administration when !breakPolicy.AdministrationId.HasValue => Text("Select an administration.", "اختر الإدارة."),
        ShiftAssignmentScope.Department when !breakPolicy.DepartmentId.HasValue => Text("Select a department.", "اختر القسم."),
        ShiftAssignmentScope.Employee when !breakPolicy.EmployeeId.HasValue => Text("Select an employee.", "اختر الموظف."),
        _ => null
    };

    private Task OnAdministrationSelected(AdministrationDto? administration)
    {
        selectedAdministration = administration;
        breakPolicy.AdministrationId = administration?.Id;
        return Task.CompletedTask;
    }

    private Task OnDepartmentSelected(DepartmentDto? department)
    {
        selectedDepartment = department;
        breakPolicy.DepartmentId = department?.Id;
        return Task.CompletedTask;
    }

    private Task OnEmployeeSelected(EmployeeDto? employee)
    {
        selectedEmployee = employee;
        breakPolicy.EmployeeId = employee?.Id;
        return Task.CompletedTask;
    }
    private string YesNo(bool value) => value ? Text("Yes", "نعم") : Text("No", "لا");
    private string BreakModeText(AttendanceBreakMode mode) => mode == AttendanceBreakMode.Strict ? Text("Strict", "محدد") : Text("Flexible", "مرن");
    private string DayName(DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday => Text("Sunday", "الأحد"),
        DayOfWeek.Monday => Text("Monday", "الإثنين"),
        DayOfWeek.Tuesday => Text("Tuesday", "الثلاثاء"),
        DayOfWeek.Wednesday => Text("Wednesday", "الأربعاء"),
        DayOfWeek.Thursday => Text("Thursday", "الخميس"),
        DayOfWeek.Friday => Text("Friday", "الجمعة"),
        DayOfWeek.Saturday => Text("Saturday", "السبت"),
        _ => day.ToString()
    };
    private static int DayOrder(DayOfWeek day) => day == DayOfWeek.Saturday ? 0 : (int)day + 1;
    private string CurrentWeekendDaysText()
        => string.Join(", ", configuration.WeekendDays.OrderBy(DayOrder).Select(DayName));
    private string EmployeeName(EmployeeDto employee)
    {
        var name = SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);
        return !string.IsNullOrWhiteSpace(name) ? name : employee.Id.ToString()[..8];
    }

    private string DepartmentName(DepartmentDto department)
    {
        var name = SharedDataService.SelectViewLang(department.NameEng, department.Name);
        return !string.IsNullOrWhiteSpace(name) ? name : department.Id.ToString()[..8];
    }

    private string AdminName(AdministrationDto administration)
    {
        var name = SharedDataService.SelectViewLang(administration.NameEng, administration.Name);
        return !string.IsNullOrWhiteSpace(name) ? name : administration.Id.ToString()[..8];
    }

    private string EmployeeSearchText(EmployeeDto employee) => $"{EmployeeName(employee)} | {employee.Code} | {employee.EmployeeNo} | {employee.Email}";
    private string DepartmentSearchText(DepartmentDto department) => $"{DepartmentName(department)} | {department.Code}";
    private string AdministrationSearchText(AdministrationDto administration) => $"{AdminName(administration)} | {administration.Code}";

    private void ToggleWorkingDay(AttendanceDayScheduleDto day, ChangeEventArgs args)
    {
        day.IsWorkingDay = args.Value is bool value && value;
        if (day.IsWorkingDay)
        {
            day.StartTime ??= new TimeSpan(8, 0, 0);
            day.EndTime ??= new TimeSpan(17, 0, 0);
        }
        else
        {
            day.StartTime = null;
            day.EndTime = null;
        }
    }

    private static string FormatTimeInput(TimeSpan? value)
        => value.HasValue ? value.Value.ToString(@"hh\:mm") : string.Empty;

    private static void SetStartTime(AttendanceDayScheduleDto day, ChangeEventArgs args)
        => day.StartTime = TimeSpan.TryParse(args.Value?.ToString(), out var value) ? value : null;

    private static void SetEndTime(AttendanceDayScheduleDto day, ChangeEventArgs args)
        => day.EndTime = TimeSpan.TryParse(args.Value?.ToString(), out var value) ? value : null;

    private void EnsureWeekRows()
    {
        var existing = configuration.DaySchedules.ToDictionary(x => x.DayOfWeek);
        configuration.DaySchedules = AttendanceDayScheduleDto.DefaultWeek()
            .Select(defaultDay => existing.TryGetValue(defaultDay.DayOfWeek, out var day) ? day : defaultDay)
            .ToList();

        if (configuration.WeekendDays.Count == 0)
        {
            configuration.WeekendDays = [DayOfWeek.Friday, DayOfWeek.Saturday];
        }

        foreach (var day in configuration.DaySchedules.Where(x => configuration.WeekendDays.Contains(x.DayOfWeek)))
        {
            day.IsWorkingDay = false;
            day.StartTime = null;
            day.EndTime = null;
        }
    }

    private string? ValidateConfiguration()
    {
        if (configuration.WeekendDays.Count == 0)
        {
            return Text("Select at least one weekend day.", "اختر يوما واحدا على الأقل لنهاية الأسبوع.");
        }

        foreach (var day in configuration.DaySchedules.Where(x => x.IsWorkingDay))
        {
            if (configuration.WeekendDays.Contains(day.DayOfWeek))
            {
                return Text($"{DayName(day.DayOfWeek)} cannot be both a working day and a weekend day.", $"لا يمكن أن يكون {DayName(day.DayOfWeek)} يوم عمل ويوم نهاية أسبوع في نفس الوقت.");
            }

            if (!day.StartTime.HasValue || !day.EndTime.HasValue)
            {
                return Text($"{DayName(day.DayOfWeek)} requires start and end time.", $"يتطلب {DayName(day.DayOfWeek)} وقت بداية ونهاية.");
            }

            if (day.EndTime <= day.StartTime)
            {
                return Text($"{DayName(day.DayOfWeek)} end time must be after start time.", $"يجب أن يكون وقت نهاية {DayName(day.DayOfWeek)} بعد وقت البداية.");
            }
        }

        return null;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
