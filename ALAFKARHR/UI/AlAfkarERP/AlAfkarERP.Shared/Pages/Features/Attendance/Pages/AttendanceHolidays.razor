@layout AdminLayout
@page "/Attendance/Holidays"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums

@inject IAttendanceService AttendanceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ModalService ModalService
@inject SharedDataService SharedDataService

<section class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Calendar & Holidays", "التقويم والعطلات")"
                Subtitle="@Text("Company holidays and weekends apply automatically to all employees in the company.", "تطبق عطلات الشركة وأيام نهاية الأسبوع تلقائيا على جميع موظفي الشركة.")"
                Overline="@Text("Attendance", "الحضور والانصراف")"
                Icon="bi-calendar-event">
        <Actions>
            <button class="btn btn-outline-primary" @onclick="LoadAsync" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-xl-8">
            <div class="erp-card h-100">
                <div class="erp-card-header bg-white">
                    <strong>@Text("Holiday Details", "تفاصيل العطلة")</strong>
                </div>
                <div class="erp-card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">@Text("Holiday Name", "اسم العطلة")</label>
                            <input class="form-control" @bind="model.Name" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@Text("Holiday Type", "نوع العطلة")</label>
                            <select class="form-select" @bind="model.HolidayType">
                                @foreach (var type in holidayTypes)
                                {
                                    <option value="@type">@HolidayTypeText(type)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Text("Start Date", "تاريخ البداية")</label>
                            <input class="form-control" type="date" @bind="model.StartDate" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@Text("End Date", "تاريخ النهاية")</label>
                            <input class="form-control" type="date" @bind="model.EndDate" />
                        </div>
                        <div class="col-md-1 d-flex align-items-end">
                            <button class="btn btn-primary w-100" @onclick="SaveHolidayAsync" disabled="@isBusy">@Text("Save", "حفظ")</button>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="model.IsRecurringYearly" />
                                <label class="form-check-label">@Text("Recurring yearly", "تتكرر سنويا")</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" role="switch" @bind="model.IsActive" />
                                <label class="form-check-label">@Text("Active", "نشطة")</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">@Text("Description / Notes", "الوصف / الملاحظات")</label>
                            <textarea class="form-control" rows="2" @bind="model.Description"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="erp-card h-100">
                <div class="erp-card-header bg-white">
                    <strong>@Text("Weekend Configuration", "إعداد نهاية الأسبوع")</strong>
                </div>
                <div class="erp-card-body">
                    <p class="text-muted small">@Text("Select the first day of the week and one or more company weekend days. Attendance reports use these calendar settings.", "اختر أول يوم في الأسبوع ويوما واحدا أو أكثر لنهاية الأسبوع على مستوى الشركة. تستخدم تقارير الحضور هذه الإعدادات.")</p>
                    <div class="mb-3">
                        <label class="form-label">@Text("First day of week", "أول يوم في الأسبوع")</label>
                        <select class="form-select" @bind="settings.FirstDayOfWeek">
                            @foreach (var day in weekDays)
                            {
                                <option value="@day">@DayText(day)</option>
                            }
                        </select>
                    </div>
                    <div class="row g-2">
                        @foreach (var day in weekDays)
                        {
                            <div class="col-6">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" checked="@settings.WeekendDays.Contains(day)" @onchange="args => ToggleWeekend(day, args)" />
                                    <label class="form-check-label">@DayText(day)</label>
                                </div>
                            </div>
                        }
                    </div>
                    <button class="btn btn-outline-primary mt-3" @onclick="SaveWeekendAsync" disabled="@isBusy">@Text("Save Weekend", "حفظ نهاية الأسبوع")</button>
                </div>
            </div>
        </div>
    </div>

    <div class="erp-card">
        <div class="erp-table-wrap">
            <table class="table erp-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Text("Name", "الاسم")</th>
                        <th>@Text("Type", "النوع")</th>
                        <th>@Text("Dates", "التاريخ")</th>
                        <th>@Text("Recurring", "التكرار")</th>
                        <th>@Text("Status", "الحالة")</th>
                        <th>@Text("Notes", "الملاحظات")</th>
                        <th class="text-end">@Text("Actions", "الإجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (holidays.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">@Text("No company holidays configured.", "لا توجد عطلات شركة محددة.")</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var holiday in holidays)
                        {
                            <tr>
                                <td>@holiday.Name</td>
                                <td>@HolidayTypeText(holiday.HolidayType)</td>
                                <td>@holiday.StartDate.ToShortDateString() - @holiday.EndDate.ToShortDateString()</td>
                                <td>@(holiday.IsRecurringYearly ? Text("Yearly", "سنوي") : Text("Once", "مرة واحدة"))</td>
                                <td>
                                    <StatusChip Text="@HolidayStatusText(holiday)" Tone="@HolidayStatusTone(holiday)" />
                                </td>
                                <td>@holiday.Description</td>
                                <td class="text-end">
                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => Edit(holiday)">@Text("Edit", "تعديل")</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => DeleteAsync(holiday)">@Text("Delete", "حذف")</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@code {
    private UpsertAttendanceHolidayDto model = NewHoliday();
    private AttendanceCalendarSettingsDto settings = new();
    private List<AttendanceHolidayDto> holidays = [];
    private Guid companyId;
    private bool isBusy;
    private string? message;
    private string messageClass = "alert-info";
    private readonly DayOfWeek[] weekDays =
    [
        DayOfWeek.Sunday,
        DayOfWeek.Monday,
        DayOfWeek.Tuesday,
        DayOfWeek.Wednesday,
        DayOfWeek.Thursday,
        DayOfWeek.Friday,
        DayOfWeek.Saturday
    ];
    private readonly AttendanceHolidayType[] holidayTypes = Enum.GetValues<AttendanceHolidayType>();

    protected override async Task OnInitializedAsync()
    {
        companyId = await ResolveCompanyIdAsync();
        model.CompanyId = companyId;
        await LoadAsync();
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task LoadAsync()
    {
        isBusy = true;
        var holidayResult = await AttendanceService.GetHolidaysAsync(companyId);
        holidays = holidayResult.IsSuccess ? holidayResult.Data ?? [] : [];
        if (!holidayResult.IsSuccess)
        {
            SetMessage(holidayResult.Error?.Detail ?? Text("Unable to load holidays.", "تعذر تحميل العطلات."), "alert-danger");
        }

        var settingsResult = await AttendanceService.GetCalendarSettingsAsync(companyId);
        settings = settingsResult.IsSuccess
            ? settingsResult.Data ?? new AttendanceCalendarSettingsDto { CompanyId = companyId }
            : new AttendanceCalendarSettingsDto { CompanyId = companyId };
        settings.CompanyId = companyId;
        isBusy = false;
    }

    private async Task SaveHolidayAsync()
    {
        model.CompanyId = companyId;
        var result = await AttendanceService.UpsertHolidayAsync(model);
        if (result.IsSuccess)
        {
            SetMessage(Text("Holiday saved.", "تم حفظ العطلة."), "alert-success");
            model = NewHoliday(companyId);
            await LoadAsync();
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to save holiday.", "تعذر حفظ العطلة."), "alert-danger");
        }
    }

    private async Task SaveWeekendAsync()
    {
        if (settings.WeekendDays.Count == 0)
        {
            SetMessage(Text("Select at least one weekend day.", "اختر يوما واحدا على الأقل لنهاية الأسبوع."), "alert-danger");
            return;
        }

        var result = await AttendanceService.UpsertCalendarSettingsAsync(new UpsertAttendanceCalendarSettingsDto
        {
            CompanyId = companyId,
            FirstDayOfWeek = settings.FirstDayOfWeek,
            WeekendDays = settings.WeekendDays
        });

        if (result.IsSuccess)
        {
            settings = result.Data ?? settings;
            SetMessage(Text("Weekend configuration saved.", "تم حفظ إعداد نهاية الأسبوع."), "alert-success");
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to save weekend configuration.", "تعذر حفظ إعداد نهاية الأسبوع."), "alert-danger");
        }
    }

    private void ToggleWeekend(DayOfWeek day, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked && !settings.WeekendDays.Contains(day))
        {
            settings.WeekendDays.Add(day);
        }
        else if (!isChecked)
        {
            settings.WeekendDays.Remove(day);
        }
    }

    private void Edit(AttendanceHolidayDto holiday)
    {
        model = new UpsertAttendanceHolidayDto
        {
            Id = holiday.Id,
            CompanyId = holiday.CompanyId,
            HolidayType = holiday.HolidayType,
            StartDate = holiday.StartDate,
            EndDate = holiday.EndDate,
            IsRecurringYearly = holiday.IsRecurringYearly,
            IsActive = holiday.IsActive,
            Name = holiday.Name,
            Description = holiday.Description
        };
    }

    private async Task DeleteAsync(AttendanceHolidayDto holiday)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Confirm delete", "تأكيد الحذف"),
            Message = Text("Delete this company holiday?", "هل تريد حذف عطلة الشركة هذه؟"),
            ShowCancel = true,
            OnOk = async () =>
            {
                var result = await AttendanceService.DeleteHolidayAsync(holiday.Id);
                SetMessage(result.IsSuccess ? Text("Holiday deleted.", "تم حذف العطلة.") : result.Error?.Detail ?? Text("Unable to delete.", "تعذر الحذف."), result.IsSuccess ? "alert-success" : "alert-danger");
                await LoadAsync();
            }
        });
    }

    private async Task<Guid> ResolveCompanyIdAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        return Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    }

    private static UpsertAttendanceHolidayDto NewHoliday(Guid companyId = default)
        => new()
        {
            CompanyId = companyId,
            StartDate = DateTime.Today,
            EndDate = DateTime.Today,
            HolidayType = AttendanceHolidayType.PublicHoliday,
            IsActive = true
        };

    private string HolidayTypeText(AttendanceHolidayType type) => type switch
    {
        AttendanceHolidayType.PublicHoliday => Text("Public Holiday", "عطلة رسمية"),
        AttendanceHolidayType.Weekend => Text("Weekend", "نهاية الأسبوع"),
        AttendanceHolidayType.SpecialHoliday => Text("Special Holiday", "عطلة خاصة"),
        AttendanceHolidayType.CompanyHoliday => Text("Company Holiday", "عطلة الشركة"),
        _ => Text("Other", "أخرى")
    };

    private string DayText(DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday => Text("Sunday", "الأحد"),
        DayOfWeek.Monday => Text("Monday", "الإثنين"),
        DayOfWeek.Tuesday => Text("Tuesday", "الثلاثاء"),
        DayOfWeek.Wednesday => Text("Wednesday", "الأربعاء"),
        DayOfWeek.Thursday => Text("Thursday", "الخميس"),
        DayOfWeek.Friday => Text("Friday", "الجمعة"),
        DayOfWeek.Saturday => Text("Saturday", "السبت"),
        _ => day.ToString()
    };

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string HolidayStatusText(AttendanceHolidayDto holiday)
        => holiday.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط");

    private static string HolidayStatusTone(AttendanceHolidayDto holiday)
        => holiday.IsActive ? "success" : "muted";

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private void SetMessage(string text, string cssClass) { message = text; messageClass = cssClass; }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
