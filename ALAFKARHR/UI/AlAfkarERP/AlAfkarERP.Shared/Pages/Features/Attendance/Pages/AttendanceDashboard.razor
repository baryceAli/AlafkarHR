@layout AdminLayout
@page "/Attendance/Dashboard"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums

@inject IAttendanceService AttendanceService
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="erp-page attendance-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@PageTitle"
                Subtitle="@PageSubtitle"
                Overline="@PageOverline"
                Icon="bi-person-check">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="LoadDashboard">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "?????")
            </button>
            <button class="btn btn-primary" @onclick='() => NavigationManager.NavigateTo("/Attendance/MyAttendance")'>
                <i class="bi bi-person-check"></i>
                @Text("Employee terminal", "????? ??????")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <div class="erp-loading py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="mt-2">@Text("Loading attendance dashboard...", "???? ????? ???? ??????...")</div>
        </div>
    }
    else if (dashboard is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Active", "???")" Value="@dashboard.ActiveSessions.ToString("N0")" Icon="bi-play-circle" Tone="primary" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("On break", "?? ???????")" Value="@dashboard.OnBreakSessions.ToString("N0")" Icon="bi-cup-hot" Tone="warning" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Completed today", "????? ?????")" Value="@dashboard.CompletedToday.ToString("N0")" Icon="bi-check2-circle" Tone="success" /></div>
            <div class="col-12 col-md-3"><StatsCard Title="@Text("Pending requests", "????? ?????")" Value="@dashboard.PendingLateCheckInRequests.ToString("N0")" Icon="bi-exclamation-triangle" Tone="danger" /></div>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <AppCard Title="@AttendanceTypeCardTitle" CssClass="h-100">
                    <div class="attendance-type-bars">
                        <div>
                            <div class="d-flex justify-content-between">
                                <span>@Text("Fixed location", "???? ????")</span>
                                <strong>@dashboard.FixedLocationSessionsToday</strong>
                            </div>
                            <div class="erp-progress">
                                <div class="progress-bar" style="--erp-progress-value:@FixedPercent%"></div>
                            </div>
                        </div>
                        <div>
                            <div class="d-flex justify-content-between">
                                <span>@Text("Mobile", "?????")</span>
                                <strong>@dashboard.MobileSessionsToday</strong>
                            </div>
                            <div class="erp-progress">
                                <div class="progress-bar bg-info" style="--erp-progress-value:@MobilePercent%"></div>
                            </div>
                        </div>
                    </div>
                </AppCard>
            </div>

            <div class="col-lg-5">
                <AppCard Title="@PendingCardTitle" CssClass="h-100">
                    <Actions>
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => NavigationManager.NavigateTo("/Attendance/LateRequests")'>@Text("Review", "??????")</button>
                    </Actions>

                    <ChildContent>
                        @if (!dashboard.PendingRequests.Any())
                        {
                            <EmptyState Title="@NoPendingTitle"
                                        Message="@NoPendingMessage"
                                        Icon="bi-inboxes" />
                        }
                        else
                        {
                            <div class="attendance-request-list">
                                @foreach (var request in dashboard.PendingRequests)
                                {
                                    <div class="attendance-request-row">
                                        <div>
                                            <strong>@ShortId(request.EmployeeId)</strong>
                                            <span>@request.RequestedCheckInTimeUtc.ToLocalTime().ToString("g")</span>
                                        </div>
                                        <StatusChip Text="@LateRequestStatusText(request.Status)" Tone="warning" />
                                    </div>
                                }
                            </div>
                        }
                    </ChildContent>
                </AppCard>
            </div>
        </div>

        <AppCard Title="@RecentSessionsTitle" CssClass="mt-3">
            <Actions>
                <button class="btn btn-sm btn-outline-primary" @onclick='() => NavigationManager.NavigateTo("/Attendance/Sessions")'>@Text("View all", "??? ????")</button>
            </Actions>

            <ChildContent>
                <div class="erp-table-toolbar">
                    <TableExportActions />
                </div>

                <div class="erp-table-wrap">
                    <table class="table erp-table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Employee", "??????")</th>
                                <th>@Text("Type", "?????")</th>
                                <th>@Text("Status", "??????")</th>
                                <th>@Text("Start", "???????")</th>
                                <th>@Text("End", "???????")</th>
                                <th>@Text("Hours", "???????")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in dashboard.RecentSessions)
                            {
                                <tr>
                                    <td>@EmployeeLabel(session)</td>
                                    <td>@AttendanceTypeText(session.AttendanceType)</td>
                                    <td><StatusChip Text="@SessionStatusText(session.Status)" Tone="@StatusTone(session.Status)" /></td>
                                    <td>@FormatDate(session.ActualStartTime ?? session.ShiftStart)</td>
                                    <td>@FormatNullable(session.ActualEndTime)</td>
                                    <td>@session.TotalHours</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </ChildContent>
        </AppCard>
    }
</section>

@code {
    private AttendanceDashboardDto? dashboard;
    private bool isLoading;
    private string? errorMessage;

    private int TotalToday => (dashboard?.FixedLocationSessionsToday ?? 0) + (dashboard?.MobileSessionsToday ?? 0);
    private int FixedPercent => TotalToday == 0 ? 0 : (dashboard!.FixedLocationSessionsToday * 100 / TotalToday);
    private int MobilePercent => TotalToday == 0 ? 0 : (dashboard!.MobileSessionsToday * 100 / TotalToday);
    private string PageTitle => Text("Live attendance dashboard", "???? ?????? ????????");
    private string PageSubtitle => Text("Monitor attendance sessions, pending requests, and today's attendance type split.", "?????? ????? ?????? ???????? ??????? ?????? ????? ?????? ?????.");
    private string PageOverline => Text("Attendance", "?????? ?????????");
    private string AttendanceTypeCardTitle => Text("Today by attendance type", "????? ??? ??? ??????");
    private string PendingCardTitle => Text("Pending late check-ins", "????? ?????? ??????? ???????");
    private string NoPendingTitle => Text("No pending requests", "?? ???? ????? ?????");
    private string NoPendingMessage => Text("Late check-in requests that need review will appear here.", "????? ??? ????? ?????? ??????? ???? ????? ??? ??????.");
    private string RecentSessionsTitle => Text("Recent sessions", "???? ????? ??????");

    protected override async Task OnInitializedAsync() => await LoadDashboard();

    private async Task LoadDashboard()
    {
        isLoading = true;
        errorMessage = null;

        var result = await AttendanceService.GetDashboardAsync();
        if (result.IsSuccess)
        {
            dashboard = result.Data;
        }
        else
        {
            errorMessage = result.Error?.Detail ?? Text("Unable to load attendance dashboard.", "???? ????? ???? ??????.");
        }

        isLoading = false;
    }

    private static string ShortId(Guid id) => id.ToString()[..8];
    private static string EmployeeLabel(AttendanceSessionDto session)
        => string.IsNullOrWhiteSpace(session.EmployeeName) ? ShortId(session.EmployeeId) : session.EmployeeName;

    private static string FormatDate(DateTime value) => value.ToLocalTime().ToString("g");
    private static string FormatNullable(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("g") : "-";

    private string AttendanceTypeText(EmployeeAttendanceType type) => type switch
    {
        EmployeeAttendanceType.FixedLocation => Text("Fixed location", "???? ????"),
        EmployeeAttendanceType.Mobile => Text("Mobile", "?????"),
        _ => type.ToString()
    };

    private string SessionStatusText(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => Text("Active", "???"),
        AttendanceSessionStatus.OnBreak => Text("On break", "?? ???????"),
        AttendanceSessionStatus.Completed => Text("Completed", "?????"),
        AttendanceSessionStatus.Cancelled => Text("Cancelled", "????"),
        _ => status.ToString()
    };

    private string LateRequestStatusText(AttendanceExceptionStatus status) => status switch
    {
        AttendanceExceptionStatus.Pending => Text("Pending", "????"),
        AttendanceExceptionStatus.Approved => Text("Approved", "????? ????"),
        AttendanceExceptionStatus.Rejected => Text("Rejected", "?????"),
        _ => status.ToString()
    };

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private static string StatusTone(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => "success",
        AttendanceSessionStatus.OnBreak => "warning",
        AttendanceSessionStatus.Completed => "muted",
        AttendanceSessionStatus.Cancelled => "danger",
        _ => "muted"
    };

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .attendance-type-bars,
    .attendance-request-list {
        display: grid;
        gap: var(--erp-space-4);
    }

    .attendance-request-row {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        display: flex;
        gap: var(--erp-space-3);
        justify-content: space-between;
        padding: var(--erp-space-3);
    }

    .attendance-request-row span {
        color: var(--erp-text-muted);
        display: block;
        margin-top: var(--erp-space-1);
    }
</style>
