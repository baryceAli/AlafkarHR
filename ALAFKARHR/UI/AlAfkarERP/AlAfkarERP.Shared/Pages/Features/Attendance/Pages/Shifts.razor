@layout AdminLayout
@page "/Attendance/Shifts"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Attendance.Dtos

@inject IAttendanceService AttendanceService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ModalService ModalService
@inject SharedDataService SharedDataService

<section class="erp-page attendance-shift-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Shifts", "الورديات")"
                Subtitle="@Text("Create and maintain company shifts, late rules, and check-in cutoff rules.", "إنشاء وإدارة ورديات الشركة وقواعد التأخير ومنع تسجيل الحضور.")"
                Overline="@Text("Attendance", "الحضور والانصراف")"
                Icon="bi-calendar2-week">
        <Actions>
            <button class="btn btn-primary" @onclick="StartCreateShift" disabled="@isBusy">
                <i class="bi bi-plus-circle"></i>
                @Text("Create shift", "انشاء وردية")
            </button>
            <button class="btn btn-outline-primary" @onclick="LoadShifts" disabled="@isBusy">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </Actions>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="alert @messageClass">@message</div>
    }

    @if (isFormVisible)
    {
    <section class="attendance-workspace-card">
        <div class="attendance-section-title">
            <div>
                <h2>@(isEditing ? Text("Update shift", "تعديل الوردية") : Text("Create shift", "انشاء وردية"))</h2>
                <span>@Text("The shift will be saved for the signed-in user's company.", "سيتم حفظ الوردية على شركة المستخدم الحالي.")</span>
            </div>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelForm" disabled="@isBusy">
                    <i class="bi bi-x-lg"></i>
                    @(isEditing ? Text("Cancel edit", "الغاء التعديل") : Text("Cancel", "الغاء"))
            </button>
        </div>

        <div class="form-grid">
            <label>
                @Text("Shift name", "اسم الوردية")
                <input class="form-control" @bind="model.Name" placeholder="@Text("Morning shift", "وردية صباحية")" />
            </label>
            <label>
                @Text("Beginning time (local)", "وقت البداية (المحلي)")
                <input class="form-control" type="time" @bind="startTime" />
            </label>
            <label>
                @Text("End time (local)", "وقت النهاية (المحلي)")
                <input class="form-control" type="time" @bind="endTime" />
            </label>
            <label>
                @Text("Grace period minutes", "دقائق فترة السماح")
                <input class="form-control" type="number" min="0" @bind="model.GracePeriodMinutes" />
            </label>
            <label>
                @Text("Consider late after minutes", "اعتبار الموظف متأخرا بعد")
                <input class="form-control" type="number" min="0" @bind="model.LateAfterMinutes" />
            </label>
            <label>
                @Text("Prohibit check-in after minutes", "منع تسجيل الحضور بعد")
                <input class="form-control" type="number" min="0" @bind="model.ProhibitCheckInAfterMinutes" />
            </label>
            <label>
                @Text("Break minutes", "دقائق الاستراحة")
                <input class="form-control" type="number" min="0" @bind="model.BreakMinutes" />
            </label>
        </div>

        <div class="action-row">
            <button class="btn btn-primary" @onclick="SaveShiftAsync" disabled="@isBusy">
                <i class="bi @(isEditing ? "bi-check-circle" : "bi-plus-circle")"></i>
                @(isEditing ? Text("Update shift", "تعديل الوردية") : Text("Create shift", "انشاء وردية"))
            </button>
        </div>
    </section>
    }

    <section class="attendance-workspace-card mt-3">
        <div class="attendance-section-title">
            <div>
                <h2>@Text("Existing shifts", "الورديات الحالية")</h2>
                <span>@Text($"{shifts.Count} shift(s)", $"{shifts.Count} وردية")</span>
            </div>
        </div>
        <div class="erp-table-wrap">
                    <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

            <table class="table erp-table align-middle shift-table">
                <thead>
                    <tr>
                        <th>@Text("Name", "الاسم")</th>
                        <th>@Text("Time (local)", "الوقت (المحلي)")</th>
                        <th>@Text("Grace", "السماح")</th>
                        <th>@Text("Late after", "التأخير بعد")</th>
                        <th>@Text("Prohibit after", "المنع بعد")</th>
                        <th>@Text("Break", "الاستراحة")</th>
                        <th class="text-center">@Text("Actions", "الاجراءات")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!shifts.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                @Text("No shifts found.", "لا توجد ورديات.")
                            </td>
                        </tr>
                    }
                    @foreach (var shift in shifts)
                    {
                        <tr class="@(isFormVisible && model.Id == shift.Id ? "table-active" : "")">
                            <td class="fw-semibold">@shift.Name</td>
                            <td>@FormatLocalShiftTime(shift.StartTime) - @FormatLocalShiftTime(shift.EndTime)</td>
                            <td>@shift.GracePeriodMinutes @Text("min", "دقيقة")</td>
                            <td>@shift.LateAfterMinutes @Text("min", "دقيقة")</td>
                            <td>@shift.ProhibitCheckInAfterMinutes @Text("min", "دقيقة")</td>
                            <td>@shift.BreakMinutes @Text("min", "دقيقة")</td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <button type="button"
                                            class="btn btn-outline-warning btn-sm shift-action"
                                            title="@Text("Edit", "تعديل")"
                                            @onclick="() => EditShift(shift)"
                                            disabled="@isBusy">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm shift-action"
                                            title="@Text("Delete", "حذف")"
                                            @onclick="() => DeleteShiftAsync(shift)"
                                            disabled="@isBusy">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</section>

@code {
    private ShiftDto model = new();
    private List<ShiftDto> shifts = [];
    private Guid companyId;
    private TimeOnly startTime = new(8, 0);
    private TimeOnly endTime = new(17, 0);
    private bool isBusy;
    private bool isEditing;
    private bool isFormVisible;
    private string? message;
    private string messageClass = "alert-info";

    protected override async Task OnInitializedAsync()
    {
        var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        var companyClaim = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;

        if (!Guid.TryParse(companyClaim, out companyId))
        {
            SetMessage(Text("The signed-in user does not have a valid company.", "المستخدم الحالي لا يحتوي على شركة صحيحة."), "alert-danger");
            return;
        }

        ResetModel();
        await LoadShifts();
    }

    private async Task LoadShifts()
    {
        if (companyId == Guid.Empty)
        {
            return;
        }

        isBusy = true;
        var result = await AttendanceService.GetShiftsAsync(companyId);
        if (result.IsSuccess)
        {
            shifts = result.Data ?? [];
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to load shifts.", "تعذر تحميل الورديات."), "alert-danger");
        }

        isBusy = false;
    }

    private async Task SaveShiftAsync()
    {
        if (!ValidateModel())
        {
            return;
        }

        model.CompanyId = companyId;
        model.StartTime = ToUtcTimeSpan(startTime);
        model.EndTime = ToUtcTimeSpan(endTime);

        isBusy = true;
        var result = isEditing
            ? await AttendanceService.UpdateShiftAsync(model)
            : await AttendanceService.CreateShiftAsync(ToCreateDto(model));

        if (result.IsSuccess)
        {
            SetMessage(
                isEditing ? Text("Shift updated.", "تم تعديل الوردية.") : Text("Shift created.", "تم انشاء الوردية."),
                "alert-success");

            ResetModel();
            isFormVisible = false;
            await LoadShifts();
        }
        else
        {
            SetMessage(result.Error?.Detail ?? Text("Unable to save shift.", "تعذر حفظ الوردية."), "alert-danger");
        }

        isBusy = false;
    }

    private void EditShift(ShiftDto shift)
    {
        model = new ShiftDto
        {
            Id = shift.Id,
            Name = shift.Name,
            CompanyId = shift.CompanyId,
            StartTime = shift.StartTime,
            EndTime = shift.EndTime,
            GracePeriodMinutes = shift.GracePeriodMinutes,
            LateAfterMinutes = shift.LateAfterMinutes,
            ProhibitCheckInAfterMinutes = shift.ProhibitCheckInAfterMinutes,
            BreakMinutes = shift.BreakMinutes,
            IsFlexible = shift.IsFlexible
        };

        startTime = ToLocalTimeOnly(shift.StartTime);
        endTime = ToLocalTimeOnly(shift.EndTime);
        isEditing = true;
        isFormVisible = true;
        message = null;
    }

    private async Task DeleteShiftAsync(ShiftDto shift)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = Text("Confirm Delete", "تأكيد الحذف"),
            Message = Text($"Are you sure you want to delete shift: {shift.Name}?", $"هل ترغب فعلا في حذف الوردية: {shift.Name}؟"),
            ShowCancel = true,
            OkText = Text("Yes", "نعم"),
            CancelText = Text("No", "لا"),
            OnOk = async () =>
            {
                isBusy = true;
                var result = await AttendanceService.DeleteShiftAsync(shift.Id);
                if (result.IsSuccess)
                {
                    SetMessage(Text("Shift deleted.", "تم حذف الوردية."), "alert-success");
                    if (model.Id == shift.Id)
                    {
                        ResetModel();
                        isFormVisible = false;
                    }

                    await LoadShifts();
                }
                else
                {
                    SetMessage(result.Error?.Detail ?? Text("Unable to delete shift.", "تعذر حذف الوردية."), "alert-danger");
                }

                isBusy = false;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void StartCreateShift()
    {
        ResetModel();
        isFormVisible = true;
        message = null;
    }

    private void CancelForm()
    {
        ResetModel();
        isFormVisible = false;
        message = null;
    }

    private bool ValidateModel()
    {
        if (companyId == Guid.Empty)
        {
            SetMessage(Text("The signed-in user's company could not be resolved.", "تعذر تحديد شركة المستخدم الحالي."), "alert-warning");
            return false;
        }

        if (string.IsNullOrWhiteSpace(model.Name))
        {
            SetMessage(Text("Shift name is required.", "اسم الوردية مطلوب."), "alert-warning");
            return false;
        }

        if (model.ProhibitCheckInAfterMinutes < model.LateAfterMinutes)
        {
            SetMessage(Text("Prohibit check-in time must be after or equal to late time.", "وقت منع تسجيل الحضور يجب أن يكون بعد وقت التأخير أو مساويا له."), "alert-warning");
            return false;
        }

        return true;
    }

    private void ResetModel()
    {
        model = new ShiftDto
        {
            CompanyId = companyId,
            GracePeriodMinutes = 15,
            LateAfterMinutes = 15,
            ProhibitCheckInAfterMinutes = 120
        };
        startTime = new TimeOnly(8, 0);
        endTime = new TimeOnly(17, 0);
        isEditing = false;
    }

    private static CreateShiftDto ToCreateDto(ShiftDto shift) => new()
    {
        Name = shift.Name,
        StartTime = shift.StartTime,
        EndTime = shift.EndTime,
        GracePeriodMinutes = shift.GracePeriodMinutes,
        LateAfterMinutes = shift.LateAfterMinutes,
        ProhibitCheckInAfterMinutes = shift.ProhibitCheckInAfterMinutes,
        BreakMinutes = shift.BreakMinutes,
        CompanyId = shift.CompanyId
    };

    private static TimeSpan ToUtcTimeSpan(TimeOnly localTime)
    {
        var today = DateTime.Today;
        var localDateTime = new DateTime(
            today.Year,
            today.Month,
            today.Day,
            localTime.Hour,
            localTime.Minute,
            localTime.Second,
            DateTimeKind.Local);

        return localDateTime.ToUniversalTime().TimeOfDay;
    }

    private static TimeOnly ToLocalTimeOnly(TimeSpan utcTime)
    {
        var utcDateTime = DateTime.SpecifyKind(DateTime.UtcNow.Date.Add(utcTime), DateTimeKind.Utc);
        return TimeOnly.FromDateTime(utcDateTime.ToLocalTime());
    }

    private static string FormatLocalShiftTime(TimeSpan utcTime)
        => ToLocalTimeOnly(utcTime).ToString("HH:mm");

    private void SetMessage(string text, string cssClass)
    {
        message = text;
        messageClass = cssClass;
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .shift-page {
        color: var(--erp-text);
    }

    .shift-header,
    .attendance-section-title,
    .action-row {
        align-items: center;
        display: flex;
        gap: .75rem;
        justify-content: space-between;
    }

    .shift-header {
        margin-bottom: 1rem;
    }

    .shift-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0;
    }

    .subtitle {
        color: var(--erp-text-muted);
        margin: .25rem 0 0;
    }

    .eyebrow {
        color: var(--erp-text-muted);
        font-size: .78rem;
        letter-spacing: 0;
        margin: 0 0 .25rem;
        text-transform: uppercase;
    }

    .attendance-workspace-card {
        background: var(--erp-surface);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        box-shadow: var(--erp-shadow-sm);
        padding: 1rem;
    }

    .attendance-section-title {
        margin-bottom: .75rem;
    }

    .attendance-section-title h2 {
        font-size: 1rem;
        font-weight: 700;
        margin: 0;
    }

    .attendance-section-title span {
        color: var(--erp-text-muted);
        font-size: .9rem;
    }

    .form-grid {
        display: grid;
        gap: .75rem;
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .form-grid label {
        color: var(--erp-text-muted);
        display: grid;
        font-size: .9rem;
        font-weight: 600;
        gap: .35rem;
    }

    .action-row {
        justify-content: flex-start;
        margin-top: 1rem;
    }

    .shift-table thead th {
        background: var(--erp-surface-muted);
        color: var(--erp-text-muted);
        font-size: .82rem;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .shift-table tbody tr:hover {
        background: var(--erp-surface-muted);
    }

    .shift-action {
        align-items: center;
        display: inline-flex;
        height: 32px;
        justify-content: center;
        padding: 0;
        width: 36px;
    }

    @@media (max-width: 760px) {
        .shift-header,
        .attendance-section-title {
            align-items: stretch;
            flex-direction: column;
        }

        .form-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
