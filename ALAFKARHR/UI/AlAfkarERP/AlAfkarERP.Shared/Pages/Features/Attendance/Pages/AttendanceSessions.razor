@layout AdminLayout
@page "/Attendance/Sessions"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Attendance.Services
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.Attendance.Dtos
@using SharedWithUI.Attendance.Enums
@using SharedWithUI.Employees.Dtos
@using SharedWithUI.Permissions
@using Microsoft.AspNetCore.Components.Authorization;
@inject IAttendanceService AttendanceService
@inject IEmployeeService EmployeeService

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService

<section class="sessions-page" dir="@SharedDataService.PageDirection">
    <div class="sessions-header">
        <div>
            <p class="eyebrow">@Text("Attendance", "الحضور والانصراف")</p>
            <h1>@Text("Attendance sessions", "جلسات الحضور")</h1>
        </div>
        <button class="btn btn-outline-primary" @onclick="LoadSessions">
            <i class="bi bi-arrow-clockwise"></i>
            @Text("Refresh", "تحديث")
        </button>
    </div>

    <section class="filter-panel">
        <select class="form-select" @bind="employeeIdFilter">
            <option value="">@Text("All employees", "كل الموظفين")</option>
            @foreach (var employee in employees)
            {
                <option value="@employee.Id">@EmployeeName(employee)</option>
            }
        </select>
        <input class="form-control" type="date" @bind="fromDate" />
        <input class="form-control" type="date" @bind="toDate" />
        <button class="btn btn-primary" @onclick="LoadSessions">
            <i class="bi bi-funnel"></i>
            @Text("Apply", "تطبيق")
        </button>
    </section>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="sessions-panel mb-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <h5 class="mb-0">@Text("Configured Working Week", "أسبوع العمل المحدد")</h5>
            <span class="badge bg-light text-dark">@Text("Weekend:", "نهاية الأسبوع:") @string.Join(", ", configuration.WeekendDays.Select(DayName))</span>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var day in configuration.DaySchedules.OrderBy(x => DayOrder(x.DayOfWeek)))
            {
                <span class="badge @(day.IsWorkingDay ? "text-bg-primary" : "text-bg-secondary")">
                    @DayName(day.DayOfWeek): @(day.IsWorkingDay ? $"{FormatTime(day.StartTime)} - {FormatTime(day.EndTime)}" : Text("Non-working", "غير عمل"))
                </span>
            }
        </div>
    </section>

    <section class="sessions-panel">
        @if (isLoading)
        {
            <div class="empty-state">@Text("Loading sessions...", "جاري تحميل الجلسات...")</div>
        }
        else if (!sessions.Any())
        {
            <div class="empty-state">@Text("No attendance sessions found.", "لا توجد جلسات حضور.")</div>
        }
        else
        {
            <div class="table-responsive">
                        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>@Text("Employee", "الموظف")</th>
                            <th>@Text("Type", "النوع")</th>
                            <th>@Text("Status", "الحالة")</th>
                            <th>@Text("Actual start", "وقت البداية الفعلي")</th>
                            <th>@Text("Actual end", "وقت النهاية الفعلي")</th>
                            <th>@Text("Shift window", "وقت الوردية")</th>
                            <th>@Text("Hours", "الساعات")</th>
                            <th>@Text("Distance", "المسافة")</th>
                            <th>@Text("Review", "مراجعة")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in sessions)
                        {
                            <tr class="@SessionRowClass(session)">
                                <td>@EmployeeLabel(session.EmployeeId)</td>
                                <td>@AttendanceTypeText(session.AttendanceType)</td>
                                <td>
                                    <span class="badge @StatusClass(session.Status)">@SessionStatusText(session.Status)</span>
                                    @if (session.RequiresNormalization)
                                    {
                                        <span class="badge text-bg-warning ms-1">@NormalizationStatusText(session.NormalizationStatus)</span>
                                    }
                                </td>
                                <td dir="ltr">@FormatDate(session.ActualStartTime)</td>
                                <td>@FormatDate(session.ActualEndTime)</td>
                                <td dir="ltr">@FormatShiftWindowDate(session.ShiftStart) <br /> @FormatShiftWindowDate(session.ShiftEnd)</td>
                                <td>@session.TotalHours</td>
                                <td>@session.TotalDistanceKm @Text("km", "كم")</td>
                                <td>
                                    @if (canReviewNormalization && session.RequiresNormalization)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => BeginNormalize(session)">
                                            <i class="bi bi-pencil-square"></i>
                                            @Text("Normalize", "تصحيح")
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            @if (normalizingSession?.Id == session.Id)
                            {
                                <tr class="normalization-row">
                                    <td colspan="9">
                                        <div class="normalization-panel">
                                            <div class="normalization-title">
                                                <strong>@Text("Normalize attendance", "تصحيح الحضور")</strong>
                                                <span>@NormalizationStatusText(session.NormalizationStatus)</span>
                                            </div>
                                            <div class="normalization-form">
                                                <label>
                                                    @Text("Check-in", "الحضور")
                                                    <input class="form-control" type="datetime-local" @bind="normalizeCheckInLocal" disabled="@normalizeMarkAbsent" />
                                                </label>
                                                <label>
                                                    @Text("Check-out", "الانصراف")
                                                    <input class="form-control" type="datetime-local" @bind="normalizeCheckOutLocal" disabled="@normalizeMarkAbsent" />
                                                </label>
                                                <label class="form-check normalization-check">
                                                    <input class="form-check-input" type="checkbox" @bind="normalizeMarkAbsent" />
                                                    <span class="form-check-label">@Text("Mark absent", "تسجيل غياب")</span>
                                                </label>
                                                <label class="normalization-note">
                                                    @Text("Manager note", "ملاحظة المدير")
                                                    <input class="form-control" @bind="normalizeNote" />
                                                </label>
                                            </div>
                                            <div class="normalization-actions">
                                                <button type="button" class="btn btn-primary btn-sm" @onclick="NormalizeSessionAsync" disabled="@isSavingNormalization">
                                                    <i class="bi bi-check2-circle"></i>
                                                    @Text("Save", "حفظ")
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CancelNormalize" disabled="@isSavingNormalization">
                                                    @Text("Cancel", "إلغاء")
                                                </button>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</section>

@code {
    private List<AttendanceSessionDto> sessions = [];
    private List<EmployeeDto> employees = [];
    private AttendanceConfigurationDto configuration = new();
    private Guid? employeeIdFilter;
    private DateTime? fromDate = DateTime.Today.AddDays(-7);
    private DateTime? toDate = DateTime.Today;
    private bool isLoading;
    private string? errorMessage;
    private Guid companyId;
    private AuthenticationState AuthState = default!;
    private bool canReviewNormalization;
    private bool isSavingNormalization;
    private AttendanceSessionDto? normalizingSession;
    private DateTime? normalizeCheckInLocal;
    private DateTime? normalizeCheckOutLocal;
    private bool normalizeMarkAbsent;
    private string? normalizeNote;

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);
        canReviewNormalization = AuthState.User.Claims.Any(c => c.Value == PermissionList.AttendancePermissions.ReviewRequests);

        await LoadConfiguration();
        await LoadEmployees();
        await LoadSessions();
    }

    private async Task LoadConfiguration()
    {
        var response = await AttendanceService.GetConfigurationAsync(companyId);
        if (response.IsSuccess && response.Data is not null)
        {
            configuration = response.Data;
        }
    }

    private async Task LoadEmployees()
    {
        var response = await EmployeeService.GetByCompanyIdAsync(companyId,0, 50000);
        if (response.IsSuccess)
        {
            employees = response.Data?.Data.ToList() ?? [];
        }
    }

    private async Task LoadSessions()
    {
        isLoading = true;
        errorMessage = null;

        var fromUtc = fromDate?.Date.ToUniversalTime();
        var toUtc = toDate?.Date.AddDays(1).AddTicks(-1).ToUniversalTime();
        var response = await AttendanceService.GetSessionsAsync(0, 200, employeeIdFilter, fromUtc, toUtc);

        if (response.IsSuccess)
        {
            sessions = response.Data?.Data.ToList() ?? [];
        }
        else
        {
            errorMessage = response.Error?.Detail ?? Text("Unable to load sessions.", "تعذر تحميل الجلسات.");
        }

        isLoading = false;
    }

    private void BeginNormalize(AttendanceSessionDto session)
    {
        normalizingSession = session;
        normalizeCheckInLocal = session.ActualStartTime?.ToLocalTime();
        normalizeCheckOutLocal = session.ActualEndTime?.ToLocalTime();
        normalizeMarkAbsent = session.NormalizationStatus == AttendanceNormalizationStatus.MarkedAbsent;
        normalizeNote = session.NormalizationNote;
    }

    private void CancelNormalize()
    {
        normalizingSession = null;
        normalizeCheckInLocal = null;
        normalizeCheckOutLocal = null;
        normalizeMarkAbsent = false;
        normalizeNote = null;
    }

    private async Task NormalizeSessionAsync()
    {
        if (normalizingSession is null)
        {
            return;
        }

        isSavingNormalization = true;
        var result = await AttendanceService.NormalizeSessionAsync(new NormalizeAttendanceSessionDto
        {
            SessionId = normalizingSession.Id,
            CheckInTimeUtc = normalizeCheckInLocal?.ToUniversalTime(),
            CheckOutTimeUtc = normalizeCheckOutLocal?.ToUniversalTime(),
            MarkAbsent = normalizeMarkAbsent,
            ManagerNote = normalizeNote
        });

        if (result.IsSuccess)
        {
            CancelNormalize();
            await LoadSessions();
        }
        else
        {
            errorMessage = result.Error?.Detail ?? Text("Unable to normalize attendance session.", "تعذر تصحيح جلسة الحضور.");
        }

        isSavingNormalization = false;
    }

    private string EmployeeLabel(Guid employeeId)
    {
        var employee = employees.FirstOrDefault(x => x.Id == employeeId);
        return employee is null ? employeeId.ToString()[..8] : EmployeeName(employee);
    }

    private string EmployeeName(EmployeeDto employee)
    {
        var name = SharedDataService.SelectViewLang(employee.FullNameEng, employee.FullName);
        return !string.IsNullOrWhiteSpace(name) ? name : employee.Id.ToString();
    }

    private static string FormatDate(DateTime? value) => value.HasValue ? value.Value.ToLocalTime().ToString("g") : "-";
    private static string FormatShiftWindowDate(DateTime value) => value.ToString("g");
    private static string FormatTime(TimeSpan? value) => value.HasValue ? value.Value.ToString(@"hh\:mm") : "-";
    private static int DayOrder(DayOfWeek day) => day == DayOfWeek.Saturday ? 0 : (int)day + 1;
    private string DayName(DayOfWeek day) => day switch
    {
        DayOfWeek.Sunday => Text("Sunday", "الأحد"),
        DayOfWeek.Monday => Text("Monday", "الإثنين"),
        DayOfWeek.Tuesday => Text("Tuesday", "الثلاثاء"),
        DayOfWeek.Wednesday => Text("Wednesday", "الأربعاء"),
        DayOfWeek.Thursday => Text("Thursday", "الخميس"),
        DayOfWeek.Friday => Text("Friday", "الجمعة"),
        DayOfWeek.Saturday => Text("Saturday", "السبت"),
        _ => day.ToString()
    };

    private string AttendanceTypeText(EmployeeAttendanceType type) => type switch
    {
        EmployeeAttendanceType.FixedLocation => Text("Fixed location", "موقع ثابت"),
        EmployeeAttendanceType.Mobile => Text("Mobile", "متنقل"),
        _ => type.ToString()
    };

    private string SessionStatusText(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => Text("Active", "نشط"),
        AttendanceSessionStatus.OnBreak => Text("On break", "في استراحة"),
        AttendanceSessionStatus.Completed => Text("Completed", "مكتمل"),
        AttendanceSessionStatus.Cancelled => Text("Cancelled", "ملغى"),
        _ => status.ToString()
    };

    private string NormalizationStatusText(AttendanceNormalizationStatus status) => status switch
    {
        AttendanceNormalizationStatus.Normal => Text("Normal", "طبيعي"),
        AttendanceNormalizationStatus.MissingCheckIn => Text("Missing check-in", "حضور مفقود"),
        AttendanceNormalizationStatus.MissingCheckOut => Text("Missing checkout", "انصراف مفقود"),
        AttendanceNormalizationStatus.MarkedAbsent => Text("Absent", "غياب"),
        _ => status.ToString()
    };

    private static string StatusClass(AttendanceSessionStatus status) => status switch
    {
        AttendanceSessionStatus.Active => "text-bg-success",
        AttendanceSessionStatus.OnBreak => "text-bg-warning",
        AttendanceSessionStatus.Completed => "text-bg-secondary",
        _ => "text-bg-light"
    };

    private static string SessionRowClass(AttendanceSessionDto session)
        => session.RequiresNormalization ? "session-needs-normalization" : "";

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

<style>
    .sessions-page {
        color: #172033;
    }

    .sessions-header,
    .filter-panel {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
    }

    .sessions-header {
        margin-bottom: 1rem;
    }

    .sessions-header h1 {
        margin: 0;
        font-size: 1.6rem;
        font-weight: 700;
    }

    .eyebrow {
        margin: 0 0 .25rem;
        color: #65758b;
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06em;
    }

    .filter-panel,
    .sessions-panel {
        background: #fff;
        border: 1px solid #e5e9f0;
        border-radius: 8px;
        padding: 1rem;
        box-shadow: 0 8px 22px rgba(15, 23, 42, .04);
    }

    .filter-panel {
        margin-bottom: .75rem;
        justify-content: flex-start;
    }

    .filter-panel .form-select {
        max-width: 320px;
    }

    .filter-panel .form-control {
        max-width: 180px;
    }

    .empty-state {
        padding: 2rem;
        color: #65758b;
        text-align: center;
    }

    .session-needs-normalization {
        background: color-mix(in srgb, var(--erp-warning, #f59e0b) 10%, transparent);
    }

    .normalization-row td {
        background: var(--erp-bg-subtle, #f8fafc);
    }

    .normalization-panel {
        display: grid;
        gap: .75rem;
        padding: .85rem;
        border: 1px solid var(--erp-border, #e5e9f0);
        border-radius: 8px;
        background: var(--erp-surface, #fff);
    }

    .normalization-title,
    .normalization-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        flex-wrap: wrap;
    }

    .normalization-title span {
        color: var(--erp-text-muted, #65758b);
        font-size: .9rem;
    }

    .normalization-form {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        align-items: end;
    }

    .normalization-form label:not(.form-check) {
        display: grid;
        gap: .35rem;
        color: var(--erp-text-muted, #526174);
        font-size: .9rem;
        font-weight: 600;
    }

    .normalization-check {
        min-height: 38px;
        display: flex;
        align-items: center;
        gap: .45rem;
        margin: 0;
    }

    .normalization-note {
        grid-column: span 1;
    }

    @@media (max-width: 760px) {
        .sessions-header,
        .filter-panel {
            align-items: stretch;
            flex-direction: column;
        }

        .filter-panel .form-select,
        .filter-panel .form-control,
        .filter-panel .btn {
            max-width: none;
            width: 100%;
        }

        .normalization-form {
            grid-template-columns: 1fr;
        }
    }
</style>
