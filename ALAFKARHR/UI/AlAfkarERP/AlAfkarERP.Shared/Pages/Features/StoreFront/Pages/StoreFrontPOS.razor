@layout AdminLayout
@page "/StoreFront/POS"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Accounting.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.SalesOrder.Services
@using AlAfkarERP.Shared.Pages.Features.StoreFront.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Cart.Dtos
@using SharedWithUI.Accounting.Dtos
@using SharedWithUI.Orders.Enums
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Payments.Enums
@using SharedWithUI.Permissions
@using SharedWithUI.StoreFront.Dtos

@inject IStoreFrontService StoreFrontService
@inject IAccountingService AccountingService
@inject IBranchService BranchService
@inject ICartService CartService
@inject ICurrencyService CurrencyService
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section class="pos-page" dir="@SharedDataService.PageDirection">
    @if (isAccessLoading)
    {
        <div class="alert alert-info">@Text("Loading StoreFront access...", "جاري تحميل صلاحيات واجهة المتجر...")</div>
        return;
    }
    @if (!CanAccessPosPage)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك صلاحية لعرض هذه الصفحة")</div>
        return;
    }

    <PageHeader Title="@Text("Store Front POS", "نقطة بيع المتجر")"
                Subtitle="@Text("Sell from a selected store and only its assigned goods or services.", "بيع من متجر محدد وبالأصناف أو الخدمات المرتبطة به فقط.")"
                Overline="@Text("Store Front", "واجهة المتجر")"
                Icon="bi-receipt">
        <Actions>
            @if (CanOpenStoresPage)
            {
                <a class="btn btn-outline-secondary" href="/StoreFront/Stores"><i class="bi bi-shop"></i> @Text("Stores", "المتاجر")</a>
            }
            @if (selectedStoreId != Guid.Empty && CanManageCashAccountsSelectedStore)
            {
                <button class="btn btn-outline-secondary" @onclick="OpenCashAccountsModal">
                    <i class="bi bi-cash-stack"></i> @Text("Cash accounts", "حسابات النقد")
                </button>
            }
        </Actions>
    </PageHeader>

    <AppCard CssClass="mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-5">
                <label class="form-label">@Text("Store", "المتجر")</label>
                <select class="form-select" value="@selectedStoreId" @onchange="OnStoreChangedAsync">
                    <option value="">@Text("Select store", "اختر متجر")</option>
                    @foreach (var store in stores.Where(x => x.IsActive))
                    {
                        <option value="@store.Id">@Text(store.NameEng, store.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-5">
                <label class="form-label">@Text("Search", "بحث")</label>
                <input class="form-control" @bind="searchText" @bind:after="LoadCatalogAsync" disabled="@(selectedStoreId == Guid.Empty)" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-outline-secondary w-100" @onclick="LoadCatalogAsync" disabled="@(selectedStoreId == Guid.Empty)"><i class="bi bi-arrow-clockwise"></i></button>
            </div>
        </div>
    </AppCard>

    @if (selectedStoreId != Guid.Empty)
    {
        @if (ReadinessWarnings.Any())
        {
            <div class="alert alert-warning">
                <div class="fw-semibold">@Text("StoreFront readiness", "جاهزية واجهة المتجر")</div>
                <ul class="mb-0">
                    @foreach (var warning in ReadinessWarnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <AppCard CssClass="mb-3">
            <div class="row g-3 align-items-end">
                <div class="col-lg-4">
                    <div class="text-muted small">@Text("Cashier session", "جلسة الكاشير")</div>
                    @if (activeSession is null)
                    {
                        <div class="fw-semibold text-warning">@Text("No open session", "لا توجد جلسة مفتوحة")</div>
                    }
                    else
                    {
                        <div class="fw-semibold text-success">@Text("Open", "مفتوحة")</div>
                        <div class="small text-muted">@Text("Expected cash", "النقد المتوقع"): @Money(activeSession.ExpectedCashAmount)</div>
                        <div class="small text-muted">@Text("Cash account", "حساب النقد"): @CashAccountName(activeSession.CashAccountId)</div>
                    }
                </div>
                <div class="col-lg-2">
                    <label class="form-label">@Text("Opening cash", "نقد البداية")</label>
                    <InputNumber class="form-control" @bind-Value="openingAmount" disabled="@(activeSession is not null || !CanOpenSessionSelectedStore)" />
                </div>
                <div class="col-lg-3">
                    <label class="form-label">@Text("Cash account", "حساب النقد")</label>
                    <select class="form-select" @bind="selectedCashAccountId" disabled="@(activeSession is not null || !CanOpenSessionSelectedStore)">
                        <option value="">@Text("Default branch cash", "النقد الافتراضي للفرع")</option>
                        @foreach (var account in cashAccounts.Where(x => x.IsActive))
                        {
                            <option value="@account.Id">@account.DisplayName</option>
                        }
                    </select>
                </div>
                <div class="col-lg-2">
                    <button class="btn btn-outline-success w-100" @onclick="OpenSessionAsync" disabled="@(activeSession is not null || !CanOpenSessionSelectedStore)">
                        <i class="bi bi-play-circle"></i> @Text("Open", "فتح")
                    </button>
                </div>
                <div class="col-lg-2">
                    <label class="form-label">@Text("Counted cash", "النقد المعدود")</label>
                    <InputNumber class="form-control" @bind-Value="countedCashAmount" disabled="@(activeSession is null || !CanCloseSessionSelectedStore)" />
                </div>
                <div class="col-lg-3">
                    <label class="form-label">@Text("Handover mode", "طريقة التسليم")</label>
                    <select class="form-select" @bind="handoverMode" disabled="@(activeSession is null || !CanCloseSessionSelectedStore || !CanHandoverSelectedStore)">
                        <option value="none">@Text("No handover", "بدون تسليم")</option>
                        <option value="account">@Text("Branch cash account", "حساب نقد الفرع")</option>
                        <option value="session">@Text("Open cashier session", "جلسة كاشير مفتوحة")</option>
                    </select>
                </div>
                @if (handoverMode == "account")
                {
                    <div class="col-lg-3">
                        <label class="form-label">@Text("Cash account target", "حساب النقد المستلم")</label>
                        <select class="form-select" @bind="handoverCashAccountId" disabled="@(activeSession is null || !CanCloseSessionSelectedStore || !CanHandoverSelectedStore)">
                            <option value="">@Text("Select account", "اختر الحساب")</option>
                            @foreach (var account in cashAccounts.Where(x => x.IsActive && x.Id != activeSession?.CashAccountId))
                            {
                                <option value="@account.Id">@account.DisplayName</option>
                            }
                        </select>
                    </div>
                }
                @if (handoverMode == "session")
                {
                    <div class="col-lg-3">
                        <label class="form-label">@Text("Cashier target", "الكاشير المستلم")</label>
                        <select class="form-select" @bind="handoverSessionId" disabled="@(activeSession is null || !CanCloseSessionSelectedStore || !CanHandoverSelectedStore)">
                            <option value="">@Text("Select session", "اختر الجلسة")</option>
                            @foreach (var session in openHandoverSessions)
                            {
                                <option value="@session.Id">@SessionLabel(session)</option>
                            }
                        </select>
                    </div>
                }
                @if (activeSession is not null && !CanHandoverSelectedStore && handoverMode != "none")
                {
                    <div class="col-12">
                        <div class="alert alert-warning mb-0">@Text("Cash handover requires StoreFront.POS.HandoverCash.", "تسليم النقد يتطلب صلاحية تسليم النقد في نقطة البيع.")</div>
                    </div>
                }
                <div class="col-lg-2">
                    <button class="btn btn-outline-primary w-100" @onclick="CloseSessionAsync" disabled="@(activeSession is null || !CanCloseSessionSelectedStore)">
                        <i class="bi bi-stop-circle"></i> @Text("Close", "إغلاق")
                    </button>
                </div>
                @if (activeSession is not null)
                {
                    <div class="col-12 small text-muted">
                        @Text("Variance", "الفرق"): <strong>@Money(countedCashAmount - activeSession.ExpectedCashAmount)</strong>
                    </div>
                }
                @if (sessionSummary is not null)
                {
                    <div class="col-12">
                        <div class="d-flex flex-wrap gap-3 small text-muted">
                            <span>@Text("Cash", "نقدا"): <strong>@Money(sessionSummary.CashSalesAmount)</strong></span>
                            <span>@Text("Card", "بطاقة"): <strong>@Money(sessionSummary.CardSalesAmount)</strong></span>
                            <span>@Text("Expected", "المتوقع"): <strong>@Money(sessionSummary.ExpectedCashAmount)</strong></span>
                            <span>@Text("Counted", "المعدود"): <strong>@Money(sessionSummary.CountedCashAmount)</strong></span>
                            <span>@Text("Variance", "الفرق"): <strong>@Money(sessionSummary.VarianceAmount)</strong></span>
                            <span>@Text("Sessions", "الجلسات"): <strong>@sessionSummary.SessionCount</strong></span>
                        </div>
                    </div>
                }
            </div>
        </AppCard>

        <AppCard CssClass="mb-3" Title="@Text("Cashier work range", "نطاق عمل الكاشير")">
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label">@Text("From", "من")</label>
                    <InputDate class="form-control" @bind-Value="summaryFromDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@Text("To", "إلى")</label>
                    <InputDate class="form-control" @bind-Value="summaryToDate" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="LoadSessionRangeAsync" disabled="@(!CanViewAnySummarySelectedStore)">
                        <i class="bi bi-arrow-clockwise"></i> @Text("Refresh", "تحديث")
                    </button>
                </div>
                @if (!CanViewAnySummarySelectedStore)
                {
                    <div class="col-12">
                        <div class="alert alert-warning mb-0">@Text("Range summary requires StoreFront.POS.ViewOwnSummary or StoreFront.POS.ViewBranchSummaries.", "ملخص النطاق يتطلب صلاحية عرض ملخصك أو ملخصات الفرع.")</div>
                    </div>
                }
                else if (UseOwnSessionRange)
                {
                    <div class="col-12">
                        <div class="alert alert-info mb-0">@Text("Showing your own cashier sessions.", "يتم عرض جلسات الكاشير الخاصة بك.")</div>
                    </div>
                }
            </div>
            @if (!sessionRows.Any())
            {
                <EmptyState Title="@Text("No sessions in range", "لا توجد جلسات ضمن النطاق")"
                            Message="@Text("Open and close cashier sessions to build the daily record.", "افتح وأغلق جلسات الكاشير لبناء السجل اليومي.")"
                            Icon="bi-calendar-range" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>@Text("Cashier", "الكاشير")</th>
                                <th>@Text("Status", "الحالة")</th>
                                <th>@Text("Cash account", "حساب النقد")</th>
                                <th>@Text("Expected", "المتوقع")</th>
                                <th>@Text("Counted", "المعدود")</th>
                                <th>@Text("Variance", "الفرق")</th>
                                <th>@Text("Sales", "المبيعات")</th>
                                <th>@Text("Handover", "التسليم")</th>
                                <th>@Text("Opened", "فتح")</th>
                                <th>@Text("Closed", "إغلاق")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var session in sessionRows)
                            {
                                <tr>
                                    <td><span class="small">@ShortUser(session.CashierUserId)</span></td>
                                    <td><StatusChip Text="@SessionStatusText(session.Status)" Tone="@(session.Status == PosCashierSessionStatus.Open ? "success" : "secondary")" /></td>
                                    <td>@CashAccountName(session.CashAccountId)</td>
                                    <td>@Money(session.ExpectedCashAmount)</td>
                                    <td>@Money(session.CountedCashAmount ?? 0)</td>
                                    <td>@Money(session.VarianceAmount ?? 0)</td>
                                    <td>
                                        <div class="small">@Text("Cash", "نقدا"): @Money(session.CashSalesAmount)</div>
                                        <div class="small">@Text("Card", "بطاقة"): @Money(session.CardSalesAmount)</div>
                                        <div class="text-muted small">@session.PaymentCount @Text("payments", "دفعات")</div>
                                    </td>
                                    <td>@HandoverLabel(session)</td>
                                    <td>@session.OpenedAt.ToLocalTime().ToString("g")</td>
                                    <td>@(session.ClosedAt.HasValue ? session.ClosedAt.Value.ToLocalTime().ToString("g") : "-")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </AppCard>
    }

    <div class="row g-3">
        <div class="col-xl-8">
            @if (selectedStoreId == Guid.Empty)
            {
                <EmptyState Title="@Text("Select a store", "اختر متجر")" Message="@Text("POS catalog is scoped by store front.", "كتالوج نقطة البيع مرتبط بواجهة المتجر.")" Icon="bi-shop" />
            }
            else if (isLoading)
            {
                <AppLoader />
            }
            else if (!catalog.Any())
            {
                <EmptyState Title="@Text("No sellable items", "لا توجد أصناف للبيع")" Message="@Text("Assign goods or services to this store first.", "اربط أصنافا أو خدمات بهذا المتجر أولا.")" Icon="bi-box-seam" />
            }
            else
            {
                <div class="row g-3">
                    @foreach (var item in catalog)
                    {
                        var draft = DraftFor(item);
                        <div class="col-md-6 col-xl-4">
                            <div class="card h-100 border-0 shadow-sm">
                                <div class="card-body d-flex flex-column">
                                    <div class="fw-semibold">@Text(item.Sku.NameEng, item.Sku.Name)</div>
                                    <div class="text-muted small mb-2">@item.Sku.SkuCode</div>
                                    <div class="fw-bold text-success mb-3">@Money(EffectivePrice(item))</div>
                                    @if (item.Settings.AllowManualPrice && CanPriceOverrideSelectedStore)
                                    {
                                        <div class="mb-2">
                                            <label class="form-label small">@Text("Manual price", "سعر يدوي")</label>
                                            <InputNumber class="form-control form-control-sm" @bind-Value="draft.ManualPrice" />
                                            <div class="text-muted small">@ManualPriceHint(item)</div>
                                        </div>
                                        @if (item.Settings.RequireManualPriceNote)
                                        {
                                            <div class="mb-2">
                                                <label class="form-label small">@Text("Override note", "ملاحظة التعديل")</label>
                                                <InputText class="form-control form-control-sm" @bind-Value="draft.Note" />
                                            </div>
                                        }
                                    }
                                    else if (item.Settings.AllowManualPrice && !CanPriceOverrideSelectedStore)
                                    {
                                        <div class="alert alert-light py-1 small">@Text("Manual price requires permission.", "السعر اليدوي يتطلب صلاحية.")</div>
                                    }
                                    <button class="btn btn-success mt-auto" @onclick="() => AddToCartAsync(item)" disabled="@isCartBusy"><i class="bi bi-cart-plus"></i> @Text("Add", "إضافة")</button>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
        <div class="col-xl-4">
            <AppCard Title="@Text("Cart", "السلة")">
                @if (checkoutResult is not null)
                {
                    <div class="alert alert-success">
                        <div class="fw-semibold">@Text("Checkout completed", "تم إتمام الطلب")</div>
                        <div>@Text("Number", "الرقم"): @(checkoutResult.SalesOrderNumber ?? checkoutResult.Number)</div>
                        <div>@Text("Payment", "الدفع"): @checkoutResult.PaymentStatus</div>
                        <div>@Text("Total", "الإجمالي"): @Money(checkoutResult.CheckoutTotal)</div>
                        <div class="text-muted small">@Text("Payment ID", "رقم الدفع"): @checkoutResult.PaymentId</div>
                        @if (checkoutResult.AccountingDocumentId.HasValue)
                        {
                            <div class="text-muted small">@Text("Accounting document", "المستند المحاسبي"): @checkoutResult.AccountingDocumentId</div>
                        }
                        @if (checkoutResult.ZatcaEInvoiceId.HasValue)
                        {
                            <div class="text-muted small">@Text("ZATCA invoice", "فاتورة الزكاة"): @checkoutResult.ZatcaEInvoiceId</div>
                        }
                    </div>
                }

                @if (cart is null || !cart.Lines.Any())
                {
                    <EmptyState Title="@Text("Cart is empty", "السلة فارغة")" Message="@Text("Selected store items will appear here.", "ستظهر أصناف المتجر هنا.")" Icon="bi-cart" />
                }
                else
                {
                    @foreach (var line in cart.Lines)
                    {
                        <div class="border rounded p-2 mb-2">
                            <div class="d-flex gap-2 align-items-start">
                                <div class="flex-grow-1">
                                    <div class="fw-semibold">@Text(line.ProductNameEng, line.ProductName)</div>
                                    <div class="small">@Money(line.UnitPrice) x @line.Quantity = <strong>@Money(line.TotalAmount)</strong></div>
                                    @if (!string.IsNullOrWhiteSpace(line.Notes))
                                    {
                                        <div class="text-muted small">@line.Notes</div>
                                    }
                                </div>
                                <div class="d-flex gap-1 align-items-center">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeLineQuantityAsync(line, line.Quantity - 1)" disabled="@(isCartBusy || !CanManageSelectedCart || line.Quantity <= 1)"><i class="bi bi-dash"></i></button>
                                    <input class="form-control form-control-sm text-center" type="number" min="1" step="1" value="@line.Quantity" @onchange="args => UpdateLineQuantityAsync(line, args.Value?.ToString())" disabled="@(isCartBusy || !CanManageSelectedCart)" />
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ChangeLineQuantityAsync(line, line.Quantity + 1)" disabled="@(isCartBusy || !CanManageSelectedCart)"><i class="bi bi-plus"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveLineAsync(line)" disabled="@(isCartBusy || !CanManageSelectedCart)"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    }
                    <div class="d-flex justify-content-between border-top pt-2"><span>@Text("Total", "الإجمالي")</span><strong>@Money(cart.TotalAmount)</strong></div>
                    <div class="mt-3"><label class="form-label">@Text("Payment method", "طريقة الدفع")</label><select class="form-select" @bind="paymentMethod">@foreach (var method in Enum.GetValues<PaymentMethodType>()){<option value="@method">@method</option>}</select></div>
                    @if (paymentMethod == PaymentMethodType.CardRecorded)
                    {
                        <div class="mt-2">
                            <label class="form-label">@Text("Branch bank account", "حساب البنك للفرع")</label>
                            <select class="form-select" @bind="selectedBankAccountId">
                                <option value="">@Text("Default branch bank account", "الحساب البنكي الافتراضي للفرع")</option>
                                @foreach (var account in bankAccounts.Where(x => x.IsActive))
                                {
                                    <option value="@account.Id">@account.DisplayName</option>
                                }
                            </select>
                            <div class="form-text">
                                @if (bankAccounts.Any(x => x.IsActive))
                                {
                                    @Text("Leave empty to use the default branch bank account.", "اتركه فارغاً لاستخدام الحساب البنكي الافتراضي للفرع.")
                                }
                                else
                                {
                                    @Text("Card receipts will use the default branch bank account.", "إيصالات البطاقة ستستخدم الحساب البنكي الافتراضي للفرع.")
                                }
                            </div>
                        </div>
                    }
                    <div class="mt-2"><label class="form-label">@Text("Payment reference", "مرجع الدفع")</label><input class="form-control" @bind="paymentReference" /></div>
                    <div class="mt-2"><label class="form-label">@Text("Payment notes", "ملاحظات الدفع")</label><textarea class="form-control" rows="2" @bind="paymentNotes"></textarea></div>
                    @if (!CanCheckoutSelectedStore)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@Text("Checkout requires StoreFront.POS.Checkout.", "إتمام البيع يتطلب صلاحية إتمام نقطة البيع.")</div>
                    }
                    @if (CashCheckoutNeedsSession)
                    {
                        <div class="alert alert-warning mt-3 mb-0">@Text("Cash checkout is blocked until you open a cashier session for this StoreFront.", "إتمام الدفع نقداً متوقف حتى تفتح جلسة كاشير لهذا المتجر.")</div>
                    }
                    <div class="d-flex gap-2 mt-3">
                        <button class="btn btn-primary flex-grow-1" @onclick="CheckoutAsync" disabled="@(isCartBusy || !CanCheckoutSelectedStore || CashCheckoutNeedsSession)"><i class="bi bi-check2-circle"></i> @Text("Checkout", "إتمام الطلب")</button>
                        <button class="btn btn-outline-secondary" @onclick="ClearCartAsync" disabled="@(isCartBusy || !CanManageSelectedCart)"><i class="bi bi-x-circle"></i></button>
                    </div>
                }
            </AppCard>
        </div>
    </div>
</section>

@if (showCashAccountsModal)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Text("Store cash accounts", "حسابات نقد المتجر")</h5>
                    <button type="button" class="btn-close" @onclick="CloseCashAccountsModal"></button>
                </div>
                <div class="modal-body">
                    @if (SelectedStore?.BranchId is not Guid)
                    {
                        <div class="alert alert-warning">@Text("Save the store with a StoreFront branch before managing branch cash accounts.", "احفظ المتجر بفرع واجهة متجر قبل إدارة حسابات النقد.")</div>
                    }
                    else
                    {
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <div class="fw-semibold">@Text("Cashier ledgers", "دفاتر الكاشير")</div>
                                <div class="text-muted small">@Text("These are accounting cash accounts scoped to the selected StoreFront branch.", "هذه حسابات نقد محاسبية مرتبطة بفرع واجهة المتجر المحدد.")</div>
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="NewCashAccount" disabled="@(!CanManageCashAccountsSelectedStore)">
                                <i class="bi bi-plus-lg"></i> @Text("Cash account", "حساب نقد")
                            </button>
                        </div>
                        @if (!cashAccounts.Any())
                        {
                            <EmptyState Title="@Text("No branch cash accounts", "لا توجد حسابات نقد للفرع")"
                                        Message="@Text("Create a cashier cash account before assigning it to an opening session.", "أنشئ حساب نقد للكاشير قبل ربطه بجلسة افتتاحية.")"
                                        Icon="bi-cash-stack" />
                        }
                        else
                        {
                            <div class="table-responsive mb-3">
                                <table class="table align-middle mb-0">
                                    <thead><tr><th>@Text("Account", "الحساب")</th><th>@Text("Currency", "العملة")</th><th>@Text("Default", "افتراضي")</th><th>@Text("Status", "الحالة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                                    <tbody>
                                        @foreach (var account in cashAccounts)
                                        {
                                            <tr>
                                                <td>@account.DisplayName</td>
                                                <td>@account.CurrencyCode</td>
                                                <td>@(account.IsDefault ? Text("Yes", "نعم") : Text("No", "لا"))</td>
                                                <td><StatusChip Text="@(account.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))" Tone="@(account.IsActive ? "success" : "secondary")" /></td>
                                                <td class="text-end">
                                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCashAccount(account)" disabled="@(!CanManageCashAccountsSelectedStore)">
                                                        <i class="bi bi-pencil"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (editingCashAccount is not null)
                        {
                            <EditForm Model="editingCashAccount" OnValidSubmit="SaveCashAccountAsync">
                                <DataAnnotationsValidator />
                                <div class="row g-3 border rounded p-3">
                                    <div class="col-md-6">
                                        <label class="form-label">@Text("Display name", "اسم العرض")</label>
                                        <InputText class="form-control" @bind-Value="editingCashAccount.DisplayName" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">@Text("Currency", "العملة")</label>
                                        <InputText class="form-control" @bind-Value="editingCashAccount.CurrencyCode" />
                                    </div>
                                    <div class="col-md-3 d-flex align-items-end gap-3">
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingCashAccount.IsDefault" />
                                            <label class="form-check-label">@Text("Default", "افتراضي")</label>
                                        </div>
                                        <div class="form-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="editingCashAccount.IsActive" />
                                            <label class="form-check-label">@Text("Active", "نشط")</label>
                                        </div>
                                    </div>
                                    <div class="col-12 d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelCashAccountEdit">@Text("Cancel", "إلغاء")</button>
                                        <button type="submit" class="btn btn-primary" disabled="@(!CanManageCashAccountsSelectedStore)">@Text("Save", "حفظ")</button>
                                    </div>
                                </div>
                            </EditForm>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseCashAccountsModal">@Text("Close", "إغلاق")</button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private bool CanView;
    private bool CanViewStores;
    private bool isAccessLoading = true;
    private bool isLoading;
    private bool isCartBusy;
    private Guid companyId;
    private Guid selectedStoreId;
    private string currencyCode = string.Empty;
    private string searchText = string.Empty;
    private string? userId;
    private string? paymentReference;
    private string? paymentNotes;
    private PaymentMethodType paymentMethod = PaymentMethodType.Cash;
    private decimal openingAmount;
    private decimal countedCashAmount;
    private Guid? selectedCashAccountId;
    private Guid? selectedBankAccountId;
    private Guid? handoverCashAccountId;
    private Guid? handoverSessionId;
    private string handoverMode = "none";
    private DateTime summaryFromDate = DateTime.Today;
    private DateTime summaryToDate = DateTime.Today;
    private List<StoreFrontDto> stores = [];
    private List<CashAccountDto> cashAccounts = [];
    private List<BankAccountDto> bankAccounts = [];
    private List<PosCashierSessionDto> openHandoverSessions = [];
    private List<PosCashierSessionDto> sessionRows = [];
    private List<StoreFrontCatalogItemDto> catalog = [];
    private Dictionary<Guid, PosItemDraft> drafts = new();
    private CartDto? cart;
    private CheckoutCartResultDto? checkoutResult;
    private PosCashierSessionDto? activeSession;
    private PosCashierSessionSummaryDto? sessionSummary;
    private CashAccountDto? editingCashAccount;
    private CurrentUserBranchRoleAccessDto branchRoleAccess = new();
    private HashSet<string> companyPermissions = new(StringComparer.Ordinal);
    private bool showCashAccountsModal;
    private StoreFrontDto? SelectedStore => stores.FirstOrDefault(x => x.Id == selectedStoreId);
    private bool CanAccessPosPage => CanView || branchRoleAccess.Assignments.Any(x => x.Permissions.Contains(PermissionList.StoreFrontPosPermissions.View, StringComparer.Ordinal));
    private bool CanOpenStoresPage => CanViewStores || branchRoleAccess.Assignments.Any(assignment =>
        assignment.Permissions.Contains(PermissionList.StoreFrontStorePermissions.View, StringComparer.Ordinal)
        || assignment.Permissions.Contains(PermissionList.StoreFrontStorePermissions.Edit, StringComparer.Ordinal)
        || assignment.Permissions.Contains(PermissionList.StoreFrontItemPermissions.View, StringComparer.Ordinal)
        || assignment.Permissions.Contains(PermissionList.StoreFrontItemPermissions.Edit, StringComparer.Ordinal));
    private bool CanManageSelectedCart => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.View);
    private bool CanCheckoutSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.Checkout);
    private bool CanPriceOverrideSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.PriceOverride);
    private bool CanOpenSessionSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.OpenSession);
    private bool CanCloseSessionSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.CloseSession);
    private bool CanHandoverSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.HandoverCash);
    private bool CanViewOwnSummarySelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.ViewOwnSummary);
    private bool CanViewBranchSummariesSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.ViewBranchSummaries);
    private bool CanViewAnySummarySelectedStore => CanViewOwnSummarySelectedStore || CanViewBranchSummariesSelectedStore;
    private bool UseOwnSessionRange => !CanViewBranchSummariesSelectedStore && CanViewOwnSummarySelectedStore;
    private bool CanManageCashAccountsSelectedStore => SelectedStoreHasPermission(PermissionList.StoreFrontPosPermissions.ManageCashAccounts);
    private bool CashCheckoutNeedsSession => paymentMethod == PaymentMethodType.Cash && activeSession is null;
    private IEnumerable<string> ReadinessWarnings
    {
        get
        {
            var store = SelectedStore;
            if (store is null)
                yield break;
            if (!store.BranchId.HasValue)
                yield return Text("This store is not linked to a StoreFront branch.", "هذا المتجر غير مرتبط بفرع واجهة متجر.");
            if (store.DefaultWarehouseId == Guid.Empty)
                yield return Text("Default warehouse is missing, so POS stock-out cannot be posted.", "المستودع الافتراضي غير محدد، لذلك لا يمكن ترحيل صرف المخزون من نقطة البيع.");
            if (store.ActiveItemsCount <= 0)
                yield return Text("No active sellable SKUs are configured for this store.", "لا توجد أصناف مفعلة للبيع في هذا المتجر.");
            if (!cashAccounts.Any(x => x.IsActive))
                yield return Text("No active branch cash accounts are available for cashier ledgers.", "لا توجد حسابات نقد نشطة للفرع لاستخدامها كدفاتر كاشير.");
            if (CashCheckoutNeedsSession)
                yield return Text("Cash checkout is blocked until an open cashier session exists.", "الدفع النقدي متوقف حتى توجد جلسة كاشير مفتوحة.");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        companyPermissions = auth.User.Claims
            .Where(c => c.Type == "Permission")
            .Select(c => c.Value)
            .ToHashSet(StringComparer.Ordinal);
        CanView = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontPosPermissions.View);
        CanViewStores = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontStorePermissions.View);
        userId = auth.User.Claims.FirstOrDefault(c => c.Type.EndsWith("nameidentifier", StringComparison.OrdinalIgnoreCase))?.Value;
        if (!CompanyContext.TryGetCompanyId(auth.User, out companyId))
        {
            isAccessLoading = false;
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        await LoadAsync();
        isAccessLoading = false;
    }

    private async Task LoadAsync()
    {
        var storesResult = await StoreFrontService.GetStoresAsync(companyId);
        stores = storesResult.IsSuccess ? storesResult.Data ?? [] : [];
        var accessResult = await BranchService.GetCurrentUserBranchRoleAccessAsync(companyId);
        branchRoleAccess = accessResult.IsSuccess ? accessResult.Data ?? new CurrentUserBranchRoleAccessDto() : new CurrentUserBranchRoleAccessDto();
        var currencies = await CurrencyService.GetAsync(companyId, 0, 1000);
        var currencyList = currencies.IsSuccess ? currencies.Data?.Data?.ToList() ?? [] : [];
        currencyCode = currencyList.FirstOrDefault(x => x.IsDefault)?.Code ?? currencyList.FirstOrDefault()?.Code ?? string.Empty;
    }

    private async Task OnStoreChangedAsync(ChangeEventArgs args)
    {
        cart = null;
        checkoutResult = null;
        activeSession = null;
        sessionSummary = null;
        openingAmount = 0;
        countedCashAmount = 0;
        selectedCashAccountId = null;
        handoverCashAccountId = null;
        handoverSessionId = null;
        handoverMode = "none";
        cashAccounts = [];
        bankAccounts = [];
        openHandoverSessions = [];
        sessionRows = [];
        paymentReference = null;
        paymentNotes = null;
        selectedBankAccountId = null;
        catalog = [];
        drafts.Clear();
        selectedStoreId = Guid.TryParse(args.Value?.ToString(), out var id) ? id : Guid.Empty;
        await LoadSessionAsync();
        await LoadCatalogAsync();
    }

    private async Task LoadSessionAsync()
    {
        if (selectedStoreId == Guid.Empty)
            return;

        var store = SelectedStore;
        var cashResult = await StoreFrontService.GetCashAccountsAsync(selectedStoreId);
        cashAccounts = cashResult.IsSuccess ? cashResult.Data ?? [] : [];

        if (store?.BranchId is Guid branchId)
        {
            var bankResult = await AccountingService.GetBankAccountsAsync(companyId);
            bankAccounts = bankResult.IsSuccess
                ? (bankResult.Data ?? []).Where(account => account.IsActive && account.BranchId == branchId).ToList()
                : [];
            if (selectedBankAccountId.HasValue && bankAccounts.All(account => account.Id != selectedBankAccountId.Value))
                selectedBankAccountId = null;
        }
        else
        {
            bankAccounts = [];
            selectedBankAccountId = null;
        }

        var open = await StoreFrontService.GetOpenSessionAsync(selectedStoreId);
        activeSession = open.IsSuccess ? open.Data : null;
        selectedCashAccountId = activeSession?.CashAccountId;
        countedCashAmount = activeSession?.ExpectedCashAmount ?? 0;
        handoverMode = "none";
        handoverCashAccountId = null;
        handoverSessionId = null;

        if (CanHandoverSelectedStore)
        {
            var targets = await StoreFrontService.GetOpenSessionsAsync(selectedStoreId);
            openHandoverSessions = targets.IsSuccess ? targets.Data ?? [] : [];
        }

        await LoadSessionRangeAsync();
    }

    private async Task LoadSessionRangeAsync()
    {
        if (selectedStoreId == Guid.Empty || !CanViewAnySummarySelectedStore)
            return;

        var summary = await StoreFrontService.GetSessionSummaryAsync(selectedStoreId, summaryFromDate, summaryToDate, UseOwnSessionRange);
        sessionSummary = summary.IsSuccess ? summary.Data : null;
        var sessions = await StoreFrontService.GetSessionsAsync(selectedStoreId, summaryFromDate, summaryToDate, UseOwnSessionRange);
        sessionRows = sessions.IsSuccess ? sessions.Data ?? [] : [];
    }

    private async Task OpenSessionAsync()
    {
        if (selectedStoreId == Guid.Empty || !CanOpenSessionSelectedStore)
            return;

        var result = await StoreFrontService.OpenSessionAsync(new OpenPosCashierSessionDto
        {
            StoreFrontId = selectedStoreId,
            CashAccountId = selectedCashAccountId,
            OpeningAmount = openingAmount
        });
        if (result.IsSuccess)
        {
            activeSession = result.Data;
            countedCashAmount = activeSession?.ExpectedCashAmount ?? 0;
            ToastService.ShowSuccess(Text("Cashier session opened.", "تم فتح جلسة الكاشير."));
            await LoadSessionAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to open cashier session.", "تعذر فتح جلسة الكاشير."));
        }
    }

    private async Task CloseSessionAsync()
    {
        if (activeSession is null || !CanCloseSessionSelectedStore)
            return;

        var result = await StoreFrontService.CloseSessionAsync(activeSession.Id, new ClosePosCashierSessionDto
        {
            CountedCashAmount = countedCashAmount,
            HandoverToCashAccountId = handoverMode == "account" ? handoverCashAccountId : null,
            HandoverToSessionId = handoverMode == "session" ? handoverSessionId : null
        });
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Cashier session closed.", "تم إغلاق جلسة الكاشير."));
            activeSession = null;
            countedCashAmount = 0;
            selectedCashAccountId = null;
            handoverCashAccountId = null;
            handoverSessionId = null;
            handoverMode = "none";
            await LoadSessionAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to close cashier session.", "تعذر إغلاق جلسة الكاشير."));
        }
    }

    private async Task LoadCatalogAsync()
    {
        if (selectedStoreId == Guid.Empty) return;
        isLoading = true;
        var result = await StoreFrontService.GetCatalogAsync(selectedStoreId, null, searchText);
        catalog = result.IsSuccess ? result.Data ?? [] : [];
        foreach (var item in catalog)
            _ = DraftFor(item);
        isLoading = false;
    }

    private async Task AddToCartAsync(StoreFrontCatalogItemDto item)
    {
        var store = stores.FirstOrDefault(x => x.Id == selectedStoreId);
        if (store is null) return;

        checkoutResult = null;
        var draft = DraftFor(item);
        var unitPrice = EffectivePrice(item);
        if (!ValidateManualPrice(item, draft, unitPrice))
            return;

        isCartBusy = true;
        try
        {
            if (cart is null)
            {
                var created = await CartService.CreateAsync(new CartDto { CompanyId = companyId, CustomerId = store.DefaultCustomerId, UserId = userId, Source = OrderIntakeSource.Pos, Channel = $"StoreFront:{selectedStoreId}", PriceListId = store.PriceListId });
                if (!created.IsSuccess || created.Data is null)
                {
                    ToastService.ShowError(created.Error?.Detail ?? Text("Unable to create cart.", "تعذر إنشاء السلة."));
                    return;
                }
                var loaded = await CartService.GetByIdAsync(created.Data.Id);
                cart = loaded.Data ?? new CartDto { Id = created.Data.Id, CompanyId = companyId, Channel = $"StoreFront:{selectedStoreId}" };
            }

            var existing = cart.Lines.FirstOrDefault(x => x.ProductSkuId == item.Sku.Id && x.UnitPrice == unitPrice);
            var result = existing is null
                ? await CartService.AddLineAsync(cart.Id, new CartLineDto { ProductId = item.Sku.ProductId, ProductSkuId = item.Sku.Id, ProductName = item.Sku.Name, ProductNameEng = item.Sku.NameEng, SkuCode = item.Sku.SkuCode, UnitOfMeasureId = item.Sku.UnitId ?? Guid.Empty, Quantity = 1, UnitPrice = unitPrice, DiscountRate = item.Sku.DiscountRate, TaxRate = item.Sku.TaxRate, Notes = draft.Note })
                : await CartService.UpdateLineAsync(cart.Id, existing.Id, existing.Quantity + 1);

            if (result.IsSuccess)
                cart = (await CartService.GetByIdAsync(cart.Id)).Data;
            else
                ToastService.ShowError(result.Error?.Detail ?? Text("Unable to update cart.", "تعذر تحديث السلة."));
        }
        finally
        {
            isCartBusy = false;
        }
    }

    private async Task ChangeLineQuantityAsync(CartLineDto line, decimal quantity)
    {
        if (quantity <= 0)
            return;
        await UpdateLineQuantityAsync(line, quantity.ToString());
    }

    private async Task UpdateLineQuantityAsync(CartLineDto line, string? value)
    {
        if (cart is null || !CanManageSelectedCart || !decimal.TryParse(value, out var quantity) || quantity <= 0)
            return;

        isCartBusy = true;
        try
        {
            var result = await CartService.UpdateLineAsync(cart.Id, line.Id, quantity);
            if (result.IsSuccess)
                cart = (await CartService.GetByIdAsync(cart.Id)).Data;
            else
                ToastService.ShowError(result.Error?.Detail ?? Text("Unable to update quantity.", "تعذر تحديث الكمية."));
        }
        finally
        {
            isCartBusy = false;
        }
    }

    private async Task RemoveLineAsync(CartLineDto line)
    {
        if (cart is null || !CanManageSelectedCart)
            return;

        isCartBusy = true;
        try
        {
            var result = await CartService.RemoveLineAsync(cart.Id, line.Id);
            if (result.IsSuccess)
                cart = (await CartService.GetByIdAsync(cart.Id)).Data;
            else
                ToastService.ShowError(result.Error?.Detail ?? Text("Unable to remove cart line.", "تعذر حذف صنف السلة."));
        }
        finally
        {
            isCartBusy = false;
        }
    }

    private async Task ClearCartAsync()
    {
        if (cart is null || !CanManageSelectedCart)
            return;

        isCartBusy = true;
        try
        {
            var result = await CartService.ClearAsync(cart.Id);
            if (result.IsSuccess)
                cart = (await CartService.GetByIdAsync(cart.Id)).Data;
            else
                ToastService.ShowError(result.Error?.Detail ?? Text("Unable to clear cart.", "تعذر تفريغ السلة."));
        }
        finally
        {
            isCartBusy = false;
        }
    }

    private bool ValidateManualPrice(StoreFrontCatalogItemDto item, PosItemDraft draft, decimal unitPrice)
    {
        if (!item.Settings.AllowManualPrice || !draft.ManualPrice.HasValue)
            return true;
        if (!CanPriceOverrideSelectedStore)
        {
            ToastService.ShowError(Text("You do not have permission to override prices.", "ليست لديك صلاحية تعديل الأسعار."));
            return false;
        }
        if (item.Settings.MinimumManualPrice.HasValue && unitPrice < item.Settings.MinimumManualPrice.Value)
        {
            ToastService.ShowError(Text("Manual price is below the minimum allowed price.", "السعر اليدوي أقل من الحد الأدنى المسموح."));
            return false;
        }
        if (item.Settings.MaximumManualPrice.HasValue && unitPrice > item.Settings.MaximumManualPrice.Value)
        {
            ToastService.ShowError(Text("Manual price is above the maximum allowed price.", "السعر اليدوي أعلى من الحد الأعلى المسموح."));
            return false;
        }
        if (item.Settings.RequireManualPriceNote && string.IsNullOrWhiteSpace(draft.Note))
        {
            ToastService.ShowError(Text("Manual price note is required.", "ملاحظة السعر اليدوي مطلوبة."));
            return false;
        }
        return true;
    }

    private async Task CheckoutAsync()
    {
        if (!CanCheckoutSelectedStore || cart is null) return;
        if (CashCheckoutNeedsSession)
        {
            ToastService.ShowError(Text("Open a cashier session before cash checkout.", "افتح جلسة كاشير قبل الدفع النقدي."));
            return;
        }
        isCartBusy = true;
        var bankAccountId = paymentMethod == PaymentMethodType.CardRecorded ? selectedBankAccountId : null;
        var result = await CartService.CheckoutAsync(cart.Id, paymentMethod, paymentReference, paymentNotes, bankAccountId);
        if (result.IsSuccess)
        {
            checkoutResult = result.Data;
            ToastService.ShowSuccess(Text("Checkout completed.", "تم إتمام الطلب."));
            cart = null;
            paymentReference = null;
            paymentNotes = null;
            selectedBankAccountId = null;
            await LoadSessionAsync();
        }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to checkout cart.", "تعذر إتمام الطلب."));
        isCartBusy = false;
    }

    private void OpenCashAccountsModal()
    {
        editingCashAccount = null;
        showCashAccountsModal = true;
    }

    private void CloseCashAccountsModal()
    {
        editingCashAccount = null;
        showCashAccountsModal = false;
    }

    private void NewCashAccount()
    {
        if (SelectedStore?.BranchId is not Guid branchId)
            return;

        editingCashAccount = new CashAccountDto
        {
            CompanyId = companyId,
            BranchId = branchId,
            DisplayName = Text("Cashier cash", "نقد الكاشير"),
            CurrencyCode = string.IsNullOrWhiteSpace(currencyCode) ? "SAR" : currencyCode,
            CreateLinkedLedger = true,
            IsDefault = !cashAccounts.Any(),
            IsActive = true
        };
    }

    private void EditCashAccount(CashAccountDto account)
    {
        editingCashAccount = new CashAccountDto
        {
            Id = account.Id,
            CompanyId = account.CompanyId,
            BranchId = account.BranchId,
            DisplayName = account.DisplayName,
            CurrencyCode = account.CurrencyCode,
            LedgerAccountId = account.LedgerAccountId,
            JournalId = account.JournalId,
            CreateLinkedLedger = false,
            IsDefault = account.IsDefault,
            IsActive = account.IsActive
        };
    }

    private void CancelCashAccountEdit() => editingCashAccount = null;

    private async Task SaveCashAccountAsync()
    {
        if (editingCashAccount is null || !CanManageCashAccountsSelectedStore || SelectedStore?.BranchId is not Guid branchId)
            return;

        editingCashAccount.CompanyId = companyId;
        editingCashAccount.BranchId = branchId;
        var result = await StoreFrontService.SaveCashAccountAsync(selectedStoreId, editingCashAccount);
        if (result.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Cash account saved.", "تم حفظ حساب النقد."));
            editingCashAccount = null;
            await LoadSessionAsync();
        }
        else
        {
            ToastService.ShowError(result.Error?.Detail ?? Text("Unable to save cash account.", "تعذر حفظ حساب النقد."));
        }
    }

    private PosItemDraft DraftFor(StoreFrontCatalogItemDto item)
    {
        if (!drafts.TryGetValue(item.Sku.Id, out var draft))
        {
            draft = new PosItemDraft();
            drafts[item.Sku.Id] = draft;
        }
        return draft;
    }

    private decimal EffectivePrice(StoreFrontCatalogItemDto item)
    {
        var draft = DraftFor(item);
        return item.Settings.AllowManualPrice && CanPriceOverrideSelectedStore && draft.ManualPrice.HasValue ? draft.ManualPrice.Value : item.Sku.Price;
    }

    private string ManualPriceHint(StoreFrontCatalogItemDto item)
    {
        var parts = new List<string>();
        if (item.Settings.MinimumManualPrice.HasValue) parts.Add($"Min {Money(item.Settings.MinimumManualPrice.Value)}");
        if (item.Settings.MaximumManualPrice.HasValue) parts.Add($"Max {Money(item.Settings.MaximumManualPrice.Value)}");
        return parts.Count == 0 ? Text("Optional override", "تعديل اختياري") : string.Join(" / ", parts);
    }

    private string SessionLabel(PosCashierSessionDto session) =>
        $"{ShortUser(session.CashierUserId)} - {Money(session.ExpectedCashAmount)} - {CashAccountName(session.CashAccountId)}";

    private string ShortUser(string cashierUserId) =>
        string.IsNullOrWhiteSpace(cashierUserId)
            ? "-"
            : cashierUserId.Length <= 8 ? cashierUserId : cashierUserId[..8];

    private string SessionStatusText(PosCashierSessionStatus status) =>
        status == PosCashierSessionStatus.Open ? Text("Open", "مفتوحة") : Text("Closed", "مغلقة");

    private string HandoverLabel(PosCashierSessionDto session)
    {
        if (session.HandoverToCashAccountId.HasValue)
            return $"{Money(session.HandoverAmount ?? 0)} -> {CashAccountName(session.HandoverToCashAccountId)}";
        if (session.HandoverToSessionId.HasValue)
            return $"{Money(session.HandoverAmount ?? 0)} -> {Text("cashier session", "جلسة كاشير")}";
        return "-";
    }

    private string Money(decimal amount) => string.IsNullOrWhiteSpace(currencyCode) ? $"{amount:N2}" : $"{amount:N2} {currencyCode}";
    private string CashAccountName(Guid? id) => id.HasValue
        ? cashAccounts.FirstOrDefault(x => x.Id == id.Value)?.DisplayName ?? id.Value.ToString("N")
        : Text("Default branch cash", "النقد الافتراضي للفرع");
    private bool SelectedStoreHasPermission(string permission)
    {
        if (companyPermissions.Contains(permission))
            return true;

        var store = stores.FirstOrDefault(x => x.Id == selectedStoreId);
        return store?.BranchId is Guid branchId
            && branchRoleAccess.Assignments.Any(assignment =>
                assignment.BranchId == branchId
                && assignment.Permissions.Contains(permission, StringComparer.Ordinal));
    }

    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;

    private sealed class PosItemDraft
    {
        public decimal? ManualPrice { get; set; }
        public string? Note { get; set; }
    }
}
