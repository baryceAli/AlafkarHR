@layout AdminLayout
@page "/StoreFront/Stores"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Features.StoreFront.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions
@using SharedWithUI.Pricing.Dtos
@using SharedWithUI.StoreFront.Dtos

@inject IStoreFrontService StoreFrontService
@inject IProductService ProductService
@inject IWarehouseService WarehouseService
@inject IBranchService BranchService
@inject ICustomerService CustomerService
@inject IPriceListService PriceListService
@inject IJSRuntime JSRuntime
@inject ToastService ToastService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

<section dir="@SharedDataService.PageDirection">
    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view this page", "ليس لديك صلاحية لعرض هذه الصفحة")</div>
        return;
    }

    <PageHeader Title="@Text("Store Fronts", "واجهات المتاجر")"
                Subtitle="@Text("Define stores, shop types, warehouses, customers, price lists, and sellable goods or services.", "إدارة المتاجر وأنواعها والمستودعات والعملاء وقوائم الأسعار والأصناف والخدمات القابلة للبيع.")"
                Overline="@Text("Store Front", "واجهة المتجر")"
                Icon="bi-shop">
        <Actions>
            @if (CanCreate)
            {
                <button class="btn btn-outline-secondary" @onclick="NewType"><i class="bi bi-tags"></i> @Text("Store Type", "نوع متجر")</button>
                <button class="btn btn-primary" @onclick="NewStore"><i class="bi bi-plus-lg"></i> @Text("Store", "متجر")</button>
            }
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <AppLoader />
    }
    else
    {
        <AppCard CssClass="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <div>
                    <div class="fw-semibold">@Text("Store Types", "أنواع المتاجر")</div>
                    <div class="text-muted small">@Text("Types are required before creating stores.", "الأنواع مطلوبة قبل إنشاء المتاجر.")</div>
                </div>
                @if (CanCreate)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NewType"><i class="bi bi-plus-lg"></i></button>
                }
            </div>
            @if (!types.Any())
            {
                <EmptyState Title="@Text("No store types yet", "لا توجد أنواع متاجر")"
                            Message="@Text("Create a type such as Retail, Grocery, or Service Counter.", "أنشئ نوعا مثل تجزئة أو بقالة أو نقطة خدمة.")"
                            Icon="bi-tags" />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>@Text("Type", "النوع")</th><th>@Text("Code", "الرمز")</th><th>@Text("Status", "الحالة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                        <tbody>
                            @foreach (var type in types)
                            {
                                <tr>
                                    <td><div class="fw-semibold">@Text(type.NameEng, type.Name)</div><div class="text-muted small">@type.Name</div></td>
                                    <td>@type.Code</td>
                                    <td><StatusChip Text="@(type.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))" Tone="@(type.IsActive ? "success" : "secondary")" /></td>
                                    <td class="text-end">
                                        @if (CanEdit)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditType(type)"><i class="bi bi-pencil"></i></button>
                                        }
                                        @if (CanDelete)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteTypeAsync(type)"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </AppCard>

        @if (!stores.Any())
        {
            <EmptyState Title="@Text("No stores yet", "لا توجد متاجر")"
                        Message="@Text("Create a store front to start using store-aware POS.", "أنشئ واجهة متجر لاستخدام نقطة بيع مرتبطة بالمتجر.")"
                        Icon="bi-shop" />
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>@Text("Store", "المتجر")</th><th>@Text("Type", "النوع")</th><th>@Text("Branch", "الفرع")</th><th>@Text("Warehouse", "المستودع")</th><th>@Text("Customer", "العميل")</th><th>@Text("Price List", "قائمة الأسعار")</th><th>@Text("Items", "الأصناف")</th><th>@Text("Status", "الحالة")</th><th class="text-end">@Text("Actions", "الإجراءات")</th></tr></thead>
                    <tbody>
                        @foreach (var store in stores)
                        {
                            <tr>
                                <td><div class="fw-semibold">@Text(store.NameEng, store.Name)</div><div class="text-muted small">@store.Code</div></td>
                                <td>@Text(store.StoreFrontTypeNameEng, store.StoreFrontTypeName)</td>
                                <td>@BranchName(store.BranchId)</td>
                                <td>@WarehouseName(store.DefaultWarehouseId)</td>
                                <td>@CustomerName(store.DefaultCustomerId)</td>
                                <td>@PriceListName(store.PriceListId)</td>
                                <td>@store.ActiveItemsCount</td>
                                <td><StatusChip Text="@(store.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))" Tone="@(store.IsActive ? "success" : "secondary")" /></td>
                                <td class="text-end">
                                    @if (CanEdit)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditStore(store)"><i class="bi bi-pencil"></i></button>
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => ToggleStoreAsync(store)"><i class="bi bi-power"></i></button>
                                    }
                                    @if (CanViewItems || CanEditItems)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => EditItemsAsync(store)"><i class="bi bi-box-seam"></i></button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteStoreAsync(store)"><i class="bi bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@if (showStoreModal && selectedStore is not null)
{
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="selectedStore" OnValidSubmit="SaveStoreAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header"><h5 class="modal-title">@Text("Store Front", "واجهة متجر")</h5><button type="button" class="btn-close" @onclick="CloseModals"></button></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">@Text("Name", "الاسم")</label><InputText class="form-control" @bind-Value="selectedStore.NameEng" /></div>
                            <div class="col-md-6"><label class="form-label">@Text("Arabic Name", "الاسم العربي")</label><InputText class="form-control" @bind-Value="selectedStore.Name" /></div>
                            <div class="col-md-3"><label class="form-label">@Text("Code", "الرمز")</label><InputText class="form-control" @bind-Value="selectedStore.Code" /></div>
                            <div class="col-md-3"><label class="form-label">@Text("Type", "النوع")</label><InputSelect class="form-select" @bind-Value="selectedStore.StoreFrontTypeId"><option value="@Guid.Empty">@Text("Select", "اختر")</option>@foreach (var type in types.Where(x => x.IsActive || x.Id == selectedStore.StoreFrontTypeId)){<option value="@type.Id">@Text(type.NameEng, type.Name)</option>}</InputSelect></div>
                            <div class="col-md-3"><label class="form-label">@Text("Branch", "الفرع")</label><InputSelect class="form-select" @bind-Value="selectedStore.BranchId"><option value="">@Text("Company-wide", "على مستوى الشركة")</option>@foreach (var branch in SelectableBranches){<option value="@branch.Id">@Text(branch.NameEng, branch.Name)</option>}</InputSelect></div>
                            <div class="col-md-3"><label class="form-label">@Text("Warehouse", "المستودع")</label><InputSelect class="form-select" @bind-Value="selectedStore.DefaultWarehouseId"><option value="@Guid.Empty">@Text("Select", "اختر")</option>@foreach (var warehouse in SelectableWarehouses){<option value="@warehouse.Id">@Text(warehouse.NameEng, warehouse.Name)</option>}</InputSelect></div>
                            <div class="col-md-6"><label class="form-label">@Text("Default Customer", "العميل الافتراضي")</label><InputSelect class="form-select" @bind-Value="selectedStore.DefaultCustomerId"><option value="">@Text("No default customer", "بدون عميل افتراضي")</option>@foreach (var customer in customers){<option value="@customer.Id">@customer.Name</option>}</InputSelect></div>
                            <div class="col-md-6"><label class="form-label">@Text("Price List", "قائمة الأسعار")</label><InputSelect class="form-select" @bind-Value="selectedStore.PriceListId"><option value="">@Text("Default pricing", "التسعير الافتراضي")</option>@foreach (var priceList in priceLists.Where(x => x.IsActive || x.Id == selectedStore.PriceListId)){<option value="@priceList.Id">@PriceListLabel(priceList)</option>}</InputSelect></div>
                            <div class="col-md-6"><label class="form-label">@Text("Receipt Header", "رأس الإيصال")</label><InputTextArea class="form-control" @bind-Value="selectedStore.ReceiptHeader" /></div>
                            <div class="col-md-6"><label class="form-label">@Text("Receipt Footer", "تذييل الإيصال")</label><InputTextArea class="form-control" @bind-Value="selectedStore.ReceiptFooter" /></div>
                            <div class="col-12 form-check"><InputCheckbox class="form-check-input" @bind-Value="selectedStore.IsActive" /><label class="form-check-label">@Text("Active", "نشط")</label></div>
                        </div>
                    </div>
                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">@Text("Cancel", "إلغاء")</button><button type="submit" class="btn btn-primary">@Text("Save", "حفظ")</button></div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (showTypeModal && selectedType is not null)
{
    <div class="modal fade show d-block" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><EditForm Model="selectedType" OnValidSubmit="SaveTypeAsync"><DataAnnotationsValidator /><div class="modal-header"><h5 class="modal-title">@Text("Store Type", "نوع متجر")</h5><button type="button" class="btn-close" @onclick="CloseModals"></button></div><div class="modal-body"><div class="row g-3"><div class="col-md-6"><label class="form-label">@Text("Name", "الاسم")</label><InputText class="form-control" @bind-Value="selectedType.NameEng" /></div><div class="col-md-6"><label class="form-label">@Text("Arabic Name", "الاسم العربي")</label><InputText class="form-control" @bind-Value="selectedType.Name" /></div><div class="col-md-6"><label class="form-label">@Text("Code", "الرمز")</label><InputText class="form-control" @bind-Value="selectedType.Code" /></div><div class="col-md-6 form-check align-self-end"><InputCheckbox class="form-check-input" @bind-Value="selectedType.IsActive" /><label class="form-check-label">@Text("Active", "نشط")</label></div></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">@Text("Cancel", "إلغاء")</button><button type="submit" class="btn btn-primary">@Text("Save", "حفظ")</button></div></EditForm></div></div></div><div class="modal-backdrop fade show"></div>
}

@if (showItemsModal && selectedStore is not null)
{
    <div class="modal fade show d-block" tabindex="-1"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title">@Text("Sellable Items", "الأصناف القابلة للبيع")</h5><button type="button" class="btn-close" @onclick="CloseModals"></button></div><div class="modal-body"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>@Text("Sell", "بيع")</th><th>@Text("SKU", "الصنف")</th><th>@Text("Manual Price", "سعر يدوي")</th><th>@Text("Require Note", "يتطلب ملاحظة")</th><th>@Text("Min", "الحد الأدنى")</th><th>@Text("Max", "الحد الأعلى")</th><th>@Text("Order", "الترتيب")</th></tr></thead><tbody>@foreach (var sku in allSkus){var item = ItemFor(sku);<tr><td><input type="checkbox" checked="@item.IsActive" disabled="@(!CanEditItems)" @onchange="args => ToggleSku(sku, args)" /></td><td><div class="fw-semibold">@Text(sku.NameEng, sku.Name)</div><div class="text-muted small">@sku.SkuCode</div></td><td><input type="checkbox" checked="@item.AllowManualPrice" disabled="@(!CanEditItems)" @onchange="args => ToggleManualPrice(item, args)" /></td><td><input type="checkbox" checked="@item.RequireManualPriceNote" disabled="@(!CanEditItems || !item.AllowManualPrice)" @onchange="args => item.RequireManualPriceNote = IsChecked(args)" /></td><td><InputNumber class="form-control form-control-sm" @bind-Value="item.MinimumManualPrice" disabled="@(!CanEditItems || !item.AllowManualPrice)" /></td><td><InputNumber class="form-control form-control-sm" @bind-Value="item.MaximumManualPrice" disabled="@(!CanEditItems || !item.AllowManualPrice)" /></td><td><InputNumber class="form-control form-control-sm" @bind-Value="item.DisplayOrder" disabled="@(!CanEditItems)" /></td></tr>}</tbody></table></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" @onclick="CloseModals">@Text("Cancel", "إلغاء")</button>@if (CanEditItems){<button type="button" class="btn btn-primary" @onclick="SaveItemsAsync">@Text("Save Items", "حفظ الأصناف")</button>}</div></div></div></div><div class="modal-backdrop fade show"></div>
}

@code {
    private bool CanView;
    private bool CanCreate;
    private bool CanEdit;
    private bool CanDelete;
    private bool CanViewItems;
    private bool CanEditItems;
    private bool isLoading;
    private Guid companyId;
    private List<StoreFrontDto> stores = [];
    private List<StoreFrontTypeDto> types = [];
    private List<WarehouseDto> warehouses = [];
    private List<BranchDto> branches = [];
    private List<CustomerDto> customers = [];
    private List<PriceListDto> priceLists = [];
    private List<ProductSkuDto> allSkus = [];
    private List<StoreFrontSellableItemDto> selectedItems = [];
    private CurrentUserBranchAccessDto branchAccess = new();
    private StoreFrontDto? selectedStore;
    private StoreFrontTypeDto? selectedType;
    private bool showStoreModal;
    private bool showTypeModal;
    private bool showItemsModal;

    private IEnumerable<BranchDto> SelectableBranches => branchAccess.CanViewAllBranches ? branches : branches.Where(branch => branchAccess.BranchIds.Contains(branch.Id));
    private IEnumerable<WarehouseDto> SelectableWarehouses => selectedStore?.BranchId is Guid branchId ? warehouses.Where(warehouse => warehouse.BranchId is null || warehouse.BranchId == branchId) : warehouses;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        CanView = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontStorePermissions.View);
        CanCreate = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontStorePermissions.Create);
        CanEdit = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontStorePermissions.Edit);
        CanDelete = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontStorePermissions.Delete);
        CanViewItems = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontItemPermissions.View);
        CanEditItems = auth.User.Claims.Any(c => c.Value == PermissionList.StoreFrontItemPermissions.Edit);
        if (!CompanyContext.TryGetCompanyId(auth.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
        if (CanView)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var typeResult = await StoreFrontService.GetTypesAsync(companyId);
        var storeResult = await StoreFrontService.GetStoresAsync(companyId);
        var warehouseResult = await WarehouseService.GetAsync(companyId, 0, 500);
        var branchResult = await BranchService.GetByCompanyIdAsync(companyId, 0, 1000);
        var accessResult = await BranchService.GetCurrentUserBranchAccessAsync(companyId);
        var customerResult = await CustomerService.GetByCompany(companyId, 0, 1000);
        var priceListResult = await PriceListService.GetByCompanyId(companyId, 0, 1000);
        types = typeResult.IsSuccess ? typeResult.Data ?? [] : [];
        stores = storeResult.IsSuccess ? storeResult.Data ?? [] : [];
        warehouses = warehouseResult.IsSuccess ? warehouseResult.Data?.Data?.ToList() ?? [] : [];
        branches = branchResult.IsSuccess ? branchResult.Data?.Data?.ToList() ?? [] : [];
        branchAccess = accessResult.IsSuccess ? accessResult.Data ?? new CurrentUserBranchAccessDto() : new CurrentUserBranchAccessDto();
        customers = customerResult.IsSuccess ? customerResult.Data?.Data?.ToList() ?? [] : [];
        priceLists = priceListResult.IsSuccess ? priceListResult.Data?.Data?.ToList() ?? [] : [];
        isLoading = false;
    }

    private void NewStore() { selectedStore = new StoreFrontDto { CompanyId = companyId, IsActive = true }; showStoreModal = true; }
    private void NewType() { selectedType = new StoreFrontTypeDto { CompanyId = companyId, IsActive = true }; showTypeModal = true; }
    private void EditType(StoreFrontTypeDto type) { selectedType = new StoreFrontTypeDto { Id = type.Id, CompanyId = type.CompanyId, Name = type.Name, NameEng = type.NameEng, Code = type.Code, IsActive = type.IsActive }; showTypeModal = true; }

    private void EditStore(StoreFrontDto store)
    {
        selectedStore = new StoreFrontDto { Id = store.Id, CompanyId = store.CompanyId, BranchId = store.BranchId, StoreFrontTypeId = store.StoreFrontTypeId, DefaultWarehouseId = store.DefaultWarehouseId, DefaultCustomerId = store.DefaultCustomerId, PriceListId = store.PriceListId, Name = store.Name, NameEng = store.NameEng, Code = store.Code, ReceiptHeader = store.ReceiptHeader, ReceiptFooter = store.ReceiptFooter, IsActive = store.IsActive };
        showStoreModal = true;
    }

    private async Task SaveStoreAsync()
    {
        if (selectedStore is null) return;
        if (!branchAccess.CanViewAllBranches && selectedStore.BranchId.HasValue && !branchAccess.BranchIds.Contains(selectedStore.BranchId.Value))
        {
            ToastService.ShowError(Text("You cannot assign this store to an inaccessible branch.", "لا يمكنك ربط المتجر بفرع غير متاح لك."));
            return;
        }
        var result = await StoreFrontService.SaveStoreAsync(selectedStore);
        if (result.IsSuccess) { ToastService.ShowSuccess(Text("Store saved.", "تم حفظ المتجر.")); CloseModals(); await LoadAsync(); }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to save store.", "تعذر حفظ المتجر."));
    }

    private async Task SaveTypeAsync()
    {
        if (selectedType is null) return;
        var result = await StoreFrontService.SaveTypeAsync(selectedType);
        if (result.IsSuccess) { ToastService.ShowSuccess(Text("Store type saved.", "تم حفظ نوع المتجر.")); CloseModals(); await LoadAsync(); }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to save store type.", "تعذر حفظ نوع المتجر."));
    }

    private async Task DeleteTypeAsync(StoreFrontTypeDto type)
    {
        if (!await ConfirmAsync(Text("Delete this store type?", "حذف نوع المتجر؟"))) return;
        var result = await StoreFrontService.DeleteTypeAsync(type.Id);
        if (result.IsSuccess) { ToastService.ShowSuccess(Text("Store type deleted.", "تم حذف نوع المتجر.")); await LoadAsync(); }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to delete store type.", "تعذر حذف نوع المتجر."));
    }

    private async Task DeleteStoreAsync(StoreFrontDto store)
    {
        if (!await ConfirmAsync(Text("Delete this store front?", "حذف واجهة المتجر؟"))) return;
        var result = await StoreFrontService.DeleteStoreAsync(store.Id);
        if (result.IsSuccess) { ToastService.ShowSuccess(Text("Store deleted.", "تم حذف المتجر.")); await LoadAsync(); }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to delete store.", "تعذر حذف المتجر."));
    }

    private async Task ToggleStoreAsync(StoreFrontDto store)
    {
        var result = await StoreFrontService.SetStoreStatusAsync(store.Id, !store.IsActive);
        if (result.IsSuccess) await LoadAsync();
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to update status.", "تعذر تحديث الحالة."));
    }

    private async Task EditItemsAsync(StoreFrontDto store)
    {
        selectedStore = store;
        var products = await ProductService.GetPricedByCompanyAsync(companyId, store.PriceListId, 0, 1000);
        allSkus = products.IsSuccess ? products.Data?.Data?.SelectMany(x => x.Skus).Where(x => x.IsSellable).ToList() ?? [] : [];
        var itemResult = await StoreFrontService.GetItemsAsync(store.Id);
        selectedItems = itemResult.IsSuccess ? itemResult.Data ?? [] : [];
        showItemsModal = true;
    }

    private StoreFrontSellableItemDto ItemFor(ProductSkuDto sku)
    {
        var item = selectedItems.FirstOrDefault(x => x.ProductSkuId == sku.Id);
        if (item is not null) return item;
        item = new StoreFrontSellableItemDto { StoreFrontId = selectedStore?.Id ?? Guid.Empty, ProductSkuId = sku.Id, ProductName = sku.Name, ProductNameEng = sku.NameEng, SkuCode = sku.SkuCode, IsActive = false };
        selectedItems.Add(item);
        return item;
    }

    private void ToggleSku(ProductSkuDto sku, ChangeEventArgs args) => ItemFor(sku).IsActive = IsChecked(args);
    private void ToggleManualPrice(StoreFrontSellableItemDto item, ChangeEventArgs args) { item.AllowManualPrice = IsChecked(args); if (!item.AllowManualPrice) { item.RequireManualPriceNote = false; item.MinimumManualPrice = null; item.MaximumManualPrice = null; } }
    private static bool IsChecked(ChangeEventArgs args) => args.Value is bool value && value;

    private async Task SaveItemsAsync()
    {
        if (selectedStore is null) return;
        var invalid = selectedItems.FirstOrDefault(item => item.IsActive && item.MinimumManualPrice.HasValue && item.MaximumManualPrice.HasValue && item.MinimumManualPrice.Value > item.MaximumManualPrice.Value);
        if (invalid is not null) { ToastService.ShowError(Text("Minimum manual price cannot be greater than maximum manual price.", "لا يمكن أن يكون الحد الأدنى للسعر اليدوي أكبر من الحد الأعلى.")); return; }
        var result = await StoreFrontService.SaveItemsAsync(selectedStore.Id, selectedItems.Where(x => x.IsActive).ToList());
        if (result.IsSuccess) { ToastService.ShowSuccess(Text("Sellable items saved.", "تم حفظ الأصناف.")); CloseModals(); await LoadAsync(); }
        else ToastService.ShowError(result.Error?.Detail ?? Text("Unable to save items.", "تعذر حفظ الأصناف."));
    }

    private string WarehouseName(Guid id) => Text(warehouses.FirstOrDefault(x => x.Id == id)?.NameEng, warehouses.FirstOrDefault(x => x.Id == id)?.Name) ?? id.ToString();
    private string BranchName(Guid? id) => id.HasValue ? Text(branches.FirstOrDefault(x => x.Id == id)?.NameEng, branches.FirstOrDefault(x => x.Id == id)?.Name) ?? id.Value.ToString() : Text("Company-wide", "على مستوى الشركة");
    private string CustomerName(Guid? id) => id.HasValue ? customers.FirstOrDefault(x => x.Id == id)?.Name ?? id.Value.ToString() : Text("Default", "افتراضي");
    private string PriceListName(Guid? id) => id.HasValue ? PriceListLabel(priceLists.FirstOrDefault(x => x.Id == id)) ?? id.Value.ToString() : Text("Default", "افتراضي");
    private static string? PriceListLabel(PriceListDto? priceList) => priceList is null ? null : string.IsNullOrWhiteSpace(priceList.Code) ? priceList.Name : $"{priceList.Name} ({priceList.Code})";
    private async Task<bool> ConfirmAsync(string message) => await JSRuntime.InvokeAsync<bool>("confirm", message);
    private void CloseModals() { showStoreModal = showTypeModal = showItemsModal = false; selectedStore = null; selectedType = null; }
    private string Text(string? en, string? ar) => SharedDataService.SelectViewLang(en ?? string.Empty, ar ?? string.Empty);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
