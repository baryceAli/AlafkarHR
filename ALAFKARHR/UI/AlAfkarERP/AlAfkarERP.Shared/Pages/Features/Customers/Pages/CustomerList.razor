@layout AdminLayout
@page "/Customers/Customer/List"
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Customers.Enums
@using SharedWithUI.Permissions

@inject ICustomerService CustomerService
@inject ICustomerGroupService CustomerGroupService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (isLoading)
{
    <div class="branches-page">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading customers...", "جاري تحميل العملاء...")</div>
            </div>
        </div>
    </div>
}
else if (!CanView)
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
}
else
{
    <div class="branches-page">
    <div class="branches-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@SharedDataService.SelectViewLang("Customers", "العملاء")</div>
            <h3 class="mb-1">@SharedDataService.SelectViewLang("Customers Management", "ادارة العملاء")</h3>
            <div class="text-muted">
                @SharedDataService.SelectViewLang("Create, edit, search, and archive customer records.", "انشاء وتعديل وبحث وارشفة بيانات العملاء.")
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="LoadCustomers"
                    disabled="@(editingCustomerId is not null)">
                <i class="bi bi-arrow-clockwise"></i>
                @SharedDataService.SelectViewLang("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanCreate || editingCustomerId is not null)">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create New", "اضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="branch-stat border-primary">
                <div class="branch-stat-icon text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Visible Customers", "العملاء المعروضون")</div>
                    <div class="branch-stat-value">@customers.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-success">
                <div class="branch-stat-icon text-success"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Active", "نشط")</div>
                    <div class="branch-stat-value">@customers.Count(c => c.Status == CustomerStatus.Active)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-info">
                <div class="branch-stat-icon text-info"><i class="bi bi-receipt-cutoff"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Tax Exempt", "معفى من الضريبة")</div>
                    <div class="branch-stat-value">@customers.Count(c => c.IsTaxExempt)</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-warning">
                <div class="branch-stat-icon text-warning"><i class="bi bi-person-lines-fill"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Contacts", "جهات الاتصال")</div>
                    <div class="branch-stat-value">@customers.Sum(c => c.Contacts?.Count ?? 0)</div>
                </div>
            </div>
        </div>
    </div>

    @if (editingCustomerId is not null)
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
            <EditForm Model="editingCustomer" OnValidSubmit="SaveCustomer">
                <DataAnnotationsValidator />

                <div class="branch-edit-panel">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                    <div>
                        <h5 class="mb-1">
                            @(isEdit
                                ? SharedDataService.SelectViewLang("Edit Customer", "تعديل العميل")
                                : SharedDataService.SelectViewLang("New Customer", "عميل جديد"))
                        </h5>
                        <div class="text-muted small">@SharedDataService.SelectViewLang("Update customer identity, group, addresses, and contacts.", "تحديث بيانات العميل والفئة والعناوين وجهات الاتصال.")</div>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                            @SharedDataService.SelectViewLang("Cancel", "الغاء")
                        </button>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check2"></i>
                            @SharedDataService.SelectViewLang("Save", "حفظ")
                        </button>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.Name" />
                        <ValidationMessage For="() => editingCustomer.Name" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("Customer Code", "رقم العميل")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.CustomerCode" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("Commercial Name", "الاسم التجاري")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.CommercialName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("VAT Number", "الرقم الضريبي")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.VatNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("Commercial Registration", "السجل التجاري")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.CommercialRegistrationNumber" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@SharedDataService.SelectViewLang("Customer Group", "فئة العميل")</label>
                        <AutoCompleteComponent TItem="CustomerGroupDto"
                                               Items="customerGroups"
                                               ItemText="c=>SharedDataService.SelectViewLang(c.NameEng, c.Name)"
                                               Value="selectedCustomerGroup"
                                               Placeholder="@SharedDataService.SelectViewLang("Select customer group...", "اختر فئة العميل...")"
                                               ValueChanged="onSelectedCustomerGroupChanged" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Status", "الحالة")</label>
                        <InputSelect class="form-select" @bind-Value="editingCustomer.Status">
                            @foreach (var status in Enum.GetValues<CustomerStatus>())
                            {
                                <option value="@status">@status</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Credit Limit", "حد الائتمان")</label>
                        <InputNumber class="form-control" @bind-Value="editingCustomer.CreditLimit" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Available Credit", "الائتمان المتاح")</label>
                        <InputNumber class="form-control" @bind-Value="editingCustomer.AvailableCredit" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Payment Term", "شروط الدفع")</label>
                        <InputSelect class="form-select" @bind-Value="editingCustomer.PaymentTerm">
                            @foreach (var term in Enum.GetValues<PaymentTermType>())
                            {
                                <option value="@term">@term</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Credit Status", "حالة الائتمان")</label>
                        <InputSelect class="form-select" @bind-Value="editingCustomer.CreditStatus">
                            @foreach (var creditStatus in Enum.GetValues<CreditStatus>())
                            {
                                <option value="@creditStatus">@creditStatus</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("Credit Hold Reason", "سبب إيقاف الائتمان")</label>
                        <InputText class="form-control" @bind-Value="editingCustomer.CreditHoldReason" />
                    </div>

                    <div class="col-md-3">
                        <div class="form-check mt-4">
                            <InputCheckbox class="form-check-input border-dark" @bind-Value="editingCustomer.IsTaxExempt" />
                            <label class="form-check-label">@SharedDataService.SelectViewLang("Tax Exempt", "معفي من الضريبة")</label>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label">@SharedDataService.SelectViewLang("Notes", "ملاحظات")</label>
                        <InputTextArea class="form-control" rows="2" @bind-Value="editingCustomer.Notes" />
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">@SharedDataService.SelectViewLang("Addresses", "العناوين")</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddAddress">
                        @SharedDataService.SelectViewLang("Add Address", "اضافة عنوان")
                    </button>
                </div>

                @if (!editingCustomer.Addresses.Any())
                {
                    <div class="text-muted small mb-3">@SharedDataService.SelectViewLang("No addresses added.", "لا توجد عناوين.")</div>
                }
                else
                {
                    @foreach (var address in editingCustomer.Addresses)
                    {
                        <div class="border rounded p-3 mb-2">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Title", "العنوان")</label>
                                    <InputText class="form-control" @bind-Value="address.Title" />
                                </div>
                                <div class="col-md-5">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Address Line 1", "العنوان 1")</label>
                                    <InputText class="form-control" @bind-Value="address.AddressLine1" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Address Line 2", "العنوان 2")</label>
                                    <InputText class="form-control" @bind-Value="address.AddressLine2" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("City", "المدينة")</label>
                                    <InputText class="form-control" @bind-Value="address.City" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("State", "المنطقة")</label>
                                    <InputText class="form-control" @bind-Value="address.State" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Country", "الدولة")</label>
                                    <InputText class="form-control" @bind-Value="address.Country" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Postal Code", "الرمز البريدي")</label>
                                    <InputText class="form-control" @bind-Value="address.PostalCode" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Longitude", "خط الطول")</label>
                                    <InputNumber class="form-control" @bind-Value="address.Longitude" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Latitude", "خط العرض")</label>
                                    <InputNumber class="form-control" @bind-Value="address.Latitude" />
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check mt-4">
                                        <InputCheckbox class="form-check-input" @bind-Value="address.IsDefaultBilling" />
                                        <label class="form-check-label">@SharedDataService.SelectViewLang("Default Billing", "الفوترة الافتراضية")</label>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-check mt-4">
                                        <InputCheckbox class="form-check-input" @bind-Value="address.IsDefaultShipping" />
                                        <label class="form-check-label">@SharedDataService.SelectViewLang("Default Shipping", "الشحن الافتراضي")</label>
                                    </div>
                                </div>
                                <div class="col-md-3 d-flex align-items-end justify-content-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveAddress(address)">
                                        @SharedDataService.SelectViewLang("Remove", "حذف")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="mb-0">@SharedDataService.SelectViewLang("Contacts", "جهات الاتصال")</h6>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddContact">
                        @SharedDataService.SelectViewLang("Add Contact", "اضافة جهة اتصال")
                    </button>
                </div>

                @if (!editingCustomer.Contacts.Any())
                {
                    <div class="text-muted small">@SharedDataService.SelectViewLang("No contacts added.", "لا توجد جهات اتصال.")</div>
                }
                else
                {
                    @foreach (var contact in editingCustomer.Contacts)
                    {
                        <div class="border rounded p-3 mb-2">
                            <div class="row g-2">
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Full Name", "الاسم الكامل")</label>
                                    <InputText class="form-control" @bind-Value="contact.FullName" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Job Title", "المسمى الوظيفي")</label>
                                    <InputText class="form-control" @bind-Value="contact.JobTitle" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Email", "البريد الالكتروني")</label>
                                    <InputText class="form-control" @bind-Value="contact.Email" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Phone", "الهاتف")</label>
                                    <InputText class="form-control" @bind-Value="contact.PhoneNumber" />
                                </div>
                                <div class="col-md-6">
                                    <div class="form-check mt-2">
                                        <InputCheckbox class="form-check-input" @bind-Value="contact.IsPrimaryContact" />
                                        <label class="form-check-label">@SharedDataService.SelectViewLang("Primary Contact", "جهة الاتصال الرئيسية")</label>
                                    </div>
                                </div>
                                <div class="col-md-6 d-flex justify-content-end">
                                    <button type="button" class="btn btn-outline-danger btn-sm" @onclick="() => RemoveContact(contact)">
                                        @SharedDataService.SelectViewLang("Remove", "حذف")
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                </div>
            </EditForm>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
        <div class="branch-toolbar mb-3">
            <div class="branch-search">
                <i class="bi bi-search"></i>
                <input class="form-control"
                       placeholder="@SharedDataService.SelectViewLang("Search customers...", "بحث في العملاء...")"
                       @bind="searchText"
                       @bind:event="oninput"
                       @bind:after="OnSearchChanged" />
            </div>

            <div class="d-flex align-items-center gap-2">
                <label class="text-muted small mb-0">@SharedDataService.SelectViewLang("Rows", "الصفوف")</label>
                <select class="form-select branch-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                    <option value="5">5</option>
                    <option value="10">10</option>
                    <option value="20">20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
        </div>

        @if (!customers.Any())
        {
            <div class="text-muted py-4 text-center">
                @SharedDataService.SelectViewLang("No customers found.", "لا يوجد عملاء.")
            </div>
        }
        else
        {
            <div class="table-responsive branch-table-wrap">
                        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

                <table class="table branch-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick="() => Sort(nameof(CustomerDto.Name))">
                                @SharedDataService.SelectViewLang("Name", "الاسم")
                                <i class="@SortIcon(nameof(CustomerDto.Name))"></i>
                            </th>
                            <th>@SharedDataService.SelectViewLang("Code", "الرقم")</th>
                            <th>@SharedDataService.SelectViewLang("Commercial Name", "الاسم التجاري")</th>
                            <th>@SharedDataService.SelectViewLang("Group", "الفئة")</th>
                            <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                            @* <th>@SharedDataService.SelectViewLang("Payment", "الدفع")</th> *@
                            <th>@SharedDataService.SelectViewLang("Credit Limit", "حد الائتمان")</th>
                            <th>@SharedDataService.SelectViewLang("Contacts", "جهات الاتصال")</th>
                            <th class="text-end"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in ProcessedCustomers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@customer.Name</div>
                                    @if (customer.IsTaxExempt)
                                    {
                                        <span class="badge text-bg-info">@SharedDataService.SelectViewLang("Tax Exempt", "معفي من الضريبة")</span>
                                    }
                                </td>
                                <td>@customer.CustomerCode</td>
                                <td>@customer.CommercialName</td>
                                <td>@SharedDataService.SelectViewLang(customerGroups.FirstOrDefault(g => g.Id == customer.CustomerGroupId)?.NameEng ?? "", customerGroups.FirstOrDefault(g => g.Id == customer.CustomerGroupId)?.Name ?? "")</td>
                                <td><span class="badge @GetStatusClass(customer.Status)">@customer.Status</span></td>
                                @* <td>@customer.PaymentTerm</td> *@
                                <td>@customer.CreditLimit.ToString("N2")</td>
                                <td>@(customer.Contacts?.Count ?? 0)</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-outline-warning btn-sm branch-action"
                                            @onclick="() => EditCustomer(customer.Id)"
                                            disabled="@(!CanEdit || editingCustomerId is not null)"
                                            title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm branch-action"
                                            @onclick="() => DeleteCustomer(customer)"
                                            disabled="@(!CanDelete || editingCustomerId is not null)"
                                            title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="branch-pagination">
            <div class="text-muted small">
                @SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @Math.Max(TotalPages, 1)
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(pageIndex == 0)">
                    <i class="bi bi-chevron-left"></i>
                    @SharedDataService.SelectViewLang("Previous", "السابق")
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages - 1)">
                    @SharedDataService.SelectViewLang("Next", "التالي")
                    <i class="bi bi-chevron-right"></i>
                </button>
            </div>
        </div>
        </div>
    </div>
    </div>
}

<style>
    .branches-page { max-width: 1400px; }
    .branches-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-stat { align-items: center; background: var(--erp-surface); border-left: 4px solid; border-radius: 8px; box-shadow: var(--erp-shadow-sm); display: flex; gap: 0.875rem; min-height: 88px; padding: 1rem; }
    .branch-stat-icon { align-items: center; background: var(--erp-surface-muted); border-radius: 8px; display: inline-flex; font-size: 1.35rem; height: 44px; justify-content: center; width: 44px; }
    .branch-stat-value { color: var(--erp-text); font-size: 1.35rem; font-weight: 700; line-height: 1.15; }
    .branch-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-search { max-width: 420px; position: relative; width: min(100%, 420px); }
    .branch-search i { color: var(--erp-text-muted); left: 0.875rem; position: absolute; top: 50%; transform: translateY(-50%); }
    .branch-search .form-control { padding-left: 2.5rem; }
    .branch-page-size { min-width: 82px; }
    .branch-table-wrap { border: 1px solid var(--erp-border); border-radius: 8px; }
    .branch-table thead th { background: var(--erp-surface-muted); color: var(--erp-text-muted); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
    .branch-table tbody tr:hover { background: var(--erp-primary-soft); }
    .branch-table .sortable { cursor: pointer; user-select: none; }
    .branch-table .sortable i { color: var(--erp-text-muted); font-size: 0.75rem; margin-inline-start: 0.35rem; }
    .branch-action { align-items: center; display: inline-flex; height: 32px; justify-content: center; width: 36px; }
    .branch-edit-panel { background: var(--erp-surface); border: 1px solid var(--erp-border); border-radius: 8px; padding: 1rem; }
    .branch-pagination { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-top: 1rem; }
    [dir="rtl"] .branch-stat { border-left: 0; border-right: 4px solid; }
    [dir="rtl"] .branch-search i { left: auto; right: 0.875rem; }
    [dir="rtl"] .branch-search .form-control { padding-left: 0.75rem; padding-right: 2.5rem; }
</style>

@code {
    private List<CustomerDto> customers = new();
    private CustomerDto editingCustomer = NewCustomer();
    private Guid? editingCustomerId;
    private Guid companyId;
    private bool isEdit;
    private bool isLoading = true;
    private AuthenticationState? AuthState;
    private string customerGroupIdText = "";
    private List<CustomerGroupDto> customerGroups = [];
    private CustomerGroupDto? selectedCustomerGroup;
    private string searchText = "";
    private string sortColumn = nameof(CustomerDto.Name);
    private bool sortAscending = true;
    private int pageSize = 10;
    private int pageIndex;
    private int TotalPages = 1;

    private bool CanView => HasPermission(PermissionList.CustomerPermissions.View);
    private bool CanCreate => HasPermission(PermissionList.CustomerPermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.CustomerPermissions.Edit);
    private bool CanDelete => HasPermission(PermissionList.CustomerPermissions.Delete);

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        var companyClaim = AuthState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        if (!Guid.TryParse(companyClaim, out companyId))
        {
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Company id is missing from the current user.", "معرف الشركة غير موجود للمستخدم الحالي."),
                Type = "error"
            });
            isLoading = false;
            return;
        }

        customerGroups = [];
        var cgRes = await CustomerGroupService.GetByCompanyAsync(companyId, 0, 10000);
        if (cgRes.IsSuccess && cgRes.Data is not null)
        {
            customerGroups = cgRes.Data.Data.ToList();
        }

        if (CanView)
            await LoadCustomers();

        isLoading = false;
    }

    private void CreateNew()
    {
        editingCustomer = NewCustomer();
        editingCustomer.CompanyId = companyId;
        editingCustomerId = editingCustomer.Id;
        customerGroupIdText = "";
        selectedCustomerGroup = null;
        isEdit = false;
    }

    private async Task EditCustomer(Guid id)
    {
        var response = await CustomerService.GetByIdAsync(id);
        if (!response.IsSuccess || response.Data is null)
        {
            ShowError(SharedDataService.SelectViewLang("Unable to load customer.", "تعذر تحميل العميل."));
            return;
        }
        editingCustomer = Normalize(response.Data);
        selectedCustomerGroup = customerGroups.FirstOrDefault(cg => cg.Id == editingCustomer.CustomerGroupId) ?? null;
        editingCustomerId = editingCustomer.Id;
        customerGroupIdText = editingCustomer.CustomerGroupId?.ToString() ?? "";
        isEdit = true;
    }

    private async Task SaveCustomer()
    {
        if (string.IsNullOrWhiteSpace(editingCustomer.Name))
        {
            ShowError(SharedDataService.SelectViewLang("Customer name is required.", "اسم العميل مطلوب."));
            return;
        }

        if (!string.IsNullOrWhiteSpace(customerGroupIdText))
        {
            if (!Guid.TryParse(customerGroupIdText, out var groupId))
            {
                ShowError(SharedDataService.SelectViewLang("Customer group id is invalid.", "معرف مجموعة العميل غير صحيح."));
                return;
            }

            editingCustomer.CustomerGroupId = groupId;
        }
        else
        {
            editingCustomer.CustomerGroupId = null;
        }

        editingCustomer.CompanyId = companyId;
        Normalize(editingCustomer);

        var isSuccess = false;
        string? errorMessage = null;

        if (isEdit)
        {
            var response = await CustomerService.UpdateAsync(editingCustomer);
            isSuccess = response.IsSuccess;
            errorMessage = response.Error?.Detail;
        }
        else
        {
            var response = await CustomerService.CreateAsync(editingCustomer);
            isSuccess = response.IsSuccess;
            errorMessage = response.Error?.Detail;
        }

        if (isSuccess)
        {
            ToastService.Show(new ToastMessage
            {
                Message = isEdit
                    ? SharedDataService.SelectViewLang("Customer has been updated successfully.", "تم تعديل العميل بنجاح.")
                    : SharedDataService.SelectViewLang("Customer has been created successfully.", "تم انشاء العميل بنجاح."),
                Type = "success"
            });

            editingCustomerId = null;
            isEdit = false;
            await LoadCustomers();
            return;
        }

        ShowError(errorMessage ?? SharedDataService.SelectViewLang("Customer save failed.", "فشل حفظ العميل."));
    }

    private void CancelEdit()
    {
        editingCustomerId = null;
        editingCustomer = NewCustomer();
        customerGroupIdText = "";
        isEdit = false;
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang(
                $"Are you sure you want to delete customer: {customer.Name}?",
                $"هل ترغب فعلا في حذف العميل: {customer.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),
            OnOk = async () =>
            {
                var response = await CustomerService.DeleteAsync(customer.Id);
                if (response.IsSuccess)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully.", "تم الحذف بنجاح."),
                        Type = "success"
                    });
                    await LoadCustomers();
                }
                else
                {
                    ShowError(response.Error?.Detail ?? SharedDataService.SelectViewLang("Delete failed.", "فشلت عملية الحذف."));
                }
            }
        });
    }

    private async Task LoadCustomers()
    {
        var response = await CustomerService.GetByCompany(companyId, pageIndex, pageSize, searchText);
        if (response.IsSuccess && response.Data is not null)
        {
            customers = response.Data.Data.Select(Normalize).ToList();
            TotalPages = Math.Max(1, (int)Math.Ceiling(response.Data.Count / (double)pageSize));
        }
        else
        {
            customers = [];
            TotalPages = 1;
            ShowError(response.Error?.Detail ?? SharedDataService.SelectViewLang("Unable to load customers.", "تعذر تحميل العملاء."));
        }
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newPageSize))
        {
            pageSize = newPageSize;
            pageIndex = 0;
            await LoadCustomers();
        }
    }

    private async Task OnSearchChanged()
    {
        pageIndex = 0;
        await LoadCustomers();
    }

    private IEnumerable<CustomerDto> ProcessedCustomers =>
        customers
            .OrderByDynamic(sortColumn, sortAscending);

    private async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadCustomers();
        }
    }

    private async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadCustomers();
        }
    }

    private void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column)
            return "bi bi-arrow-down-up";

        return sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";
    }

    private void AddAddress()
    {
        editingCustomer.Addresses.Add(new AddressDto
        {
            Id = Guid.Empty,
            Title = "",
            AddressLine1 = "",
            City = "",
            State = "",
            Country = "",
            PostalCode = ""
        });
    }

    private void RemoveAddress(AddressDto address)
    {
        editingCustomer.Addresses.Remove(address);
    }

    private void AddContact()
    {
        editingCustomer.Contacts.Add(new ContactDto
        {
            Id = Guid.Empty,
            FullName = ""
        });
    }

    private void RemoveContact(ContactDto contact)
    {
        editingCustomer.Contacts.Remove(contact);
    }

    private static CustomerDto NewCustomer() => new()
    {
        Id = Guid.NewGuid(),
        Name = "",
        Status = CustomerStatus.Active,
        PaymentTerm = PaymentTermType.Cash,
        CreditStatus = CreditStatus.Good,
        AvailableCredit = 0,
        // Type = CustomerType.Business,
        // PaymentTerm = PaymentTermType.Cash,
        Addresses = [],
        Contacts = []
    };

    private static CustomerDto Normalize(CustomerDto customer)
    {
        customer.Addresses ??= [];
        customer.Contacts ??= [];
        customer.Name ??= "";

        foreach (var address in customer.Addresses)
        {
            address.Title ??= "";
            address.AddressLine1 ??= "";
            address.City ??= "";
            address.State ??= "";
            address.Country ??= "";
            address.PostalCode ??= "";
        }

        foreach (var contact in customer.Contacts)
        {
            contact.FullName ??= "";
        }

        return customer;
    }
    private void onSelectedCustomerGroupChanged(CustomerGroupDto customerGroup)
    {
        if (customerGroup is not null)
        {
            selectedCustomerGroup = customerGroup;
            editingCustomer.CustomerGroupId = customerGroup.Id;
            customerGroupIdText = customerGroup.Id.ToString();
        }
        else
        {
            selectedCustomerGroup = null;
            customerGroupIdText = "";
        }
    }
    private string GetStatusClass(CustomerStatus status) => status switch
    {
        CustomerStatus.Active => "text-bg-success",
        CustomerStatus.Suspended => "text-bg-warning",
        CustomerStatus.Blocked => "text-bg-danger",
        CustomerStatus.Archived => "text-bg-secondary",
        _ => "text-bg-light"
    };

    private bool HasPermission(string permission)
    {
        return AuthState?.User.Claims.Any(c => c.Value == permission) == true;
    }

    private void ShowError(string message)
    {
        ToastService.Show(new ToastMessage
        {
            Message = message,
            Type = "error"
        });
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

