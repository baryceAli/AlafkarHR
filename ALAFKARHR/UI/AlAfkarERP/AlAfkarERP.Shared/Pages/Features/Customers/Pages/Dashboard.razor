@layout AdminLayout
@page "/Customers/Customer/Dashboard"
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Customers.Enums
@using SharedWithUI.Permissions

@inject ICustomerService CustomerService
@inject ICustomerGroupService CustomerGroupService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (isLoading)
{
    <div class="branches-page">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading customer dashboard...", "جاري تحميل لوحة العملاء...")</div>
            </div>
        </div>
    </div>
}
else if (!CanSelect)
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
}
else
{
    <div class="branches-page">
    <div class="branches-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@SharedDataService.SelectViewLang("Customers", "العملاء")</div>
            <h3 class="mb-1">@SharedDataService.SelectViewLang("Customers Dashboard", "لوحة العملاء")</h3>
            <div class="text-muted">
                @SharedDataService.SelectViewLang("A quick view of customer activity for the selected company.", "نظرة سريعة على عملاء الشركة الحالية.")
            </div>
        </div>

        <button class="btn btn-primary" @onclick="OpenCustomers">
            <i class="bi bi-people"></i>
            @SharedDataService.SelectViewLang("Open Customers", "فتح العملاء")
        </button>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="branch-stat border-primary">
                <div class="branch-stat-icon text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Total Customers", "اجمالي العملاء")</div>
                    <div class="branch-stat-value">@totalCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-success">
                <div class="branch-stat-icon text-success"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Active Customers", "العملاء النشطون")</div>
                    <div class="branch-stat-value">@activeCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-info">
                <div class="branch-stat-icon text-info"><i class="bi bi-receipt-cutoff"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Tax Exempt Customers", "العملاء المعفون من الضريبة")</div>
                    <div class="branch-stat-value">@taxExemptCustomers</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="branch-stat border-warning">
                <div class="branch-stat-icon text-warning"><i class="bi bi-pause-circle"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Blocked/Suspended", "محظور/معلق")</div>
                    <div class="branch-stat-value">@blockedOrSuspendedCustomers</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">@SharedDataService.SelectViewLang("Recent Customers", "احدث العملاء")</h5>
            </div>

        @if (!recentCustomers.Any())
        {
            <div class="branch-empty">
                <i class="bi bi-inboxes"></i>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("No customers found", "لم يتم العثور على عملاء")</div>
                <div class="text-muted small">@SharedDataService.SelectViewLang("Customer activity will appear here once records are available.", "ستظهر حركة العملاء هنا عند توفر البيانات.")</div>
            </div>
        }
        else
        {
            <div class="table-responsive branch-table-wrap">
                        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

                <table class="table branch-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@SharedDataService.SelectViewLang("Name", "الاسم")</th>
                            <th>@SharedDataService.SelectViewLang("Commercial Name", "الاسم التجاري")</th>
                            <th>@SharedDataService.SelectViewLang("Group", "الفئة")</th>
                            <th>@SharedDataService.SelectViewLang("Status", "الحالة")</th>
                            <th>@SharedDataService.SelectViewLang("Credit Limit", "حد الائتمان")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var customer in recentCustomers)
                        {
                            <tr>
                                <td>@customer.Name</td>
                                <td>@customer.CommercialName</td>
                                <td>@GetCustomerGroupName(customer.CustomerGroupId)</td>
                                <td>@customer.Status</td>
                                <td>@customer.CreditLimit.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </div>
    </div>
}

<style>
    .branches-page { max-width: 1400px; }
    .branches-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-stat { align-items: center; background: var(--erp-surface); border-left: 4px solid; border-radius: 8px; box-shadow: var(--erp-shadow-sm); display: flex; gap: 0.875rem; min-height: 88px; padding: 1rem; }
    .branch-stat-icon { align-items: center; background: var(--erp-surface-muted); border-radius: 8px; display: inline-flex; font-size: 1.35rem; height: 44px; justify-content: center; width: 44px; }
    .branch-stat-value { color: var(--erp-text); font-size: 1.35rem; font-weight: 700; line-height: 1.15; }
    .branch-table-wrap { border: 1px solid var(--erp-border); border-radius: 8px; }
    .branch-table thead th { background: var(--erp-surface-muted); color: var(--erp-text-muted); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
    .branch-table tbody tr:hover { background: var(--erp-primary-soft); }
    .branch-empty { align-items: center; color: var(--erp-text-muted); display: grid; justify-items: center; padding: 2rem; text-align: center; }
    .branch-empty i { color: var(--erp-text-soft); font-size: 2rem; margin-bottom: 0.5rem; }
    [dir="rtl"] .branch-stat { border-left: 0; border-right: 4px solid; }
</style>

@code {
    private bool isLoading = true;
    private AuthenticationState? AuthState;
    private List<CustomerDto> recentCustomers = new();
    private List<CustomerDto> allCustomers = new();
    private List<CustomerGroupDto> customerGroups = new();
    private long totalCustomers;
    private int activeCustomers;
    private int taxExemptCustomers;
    private int blockedOrSuspendedCustomers;

    private bool CanSelect => AuthState?.User.Claims.Any(c => c.Value == PermissionList.CustomerPermissions.Select) == true;

    private void OpenCustomers()
    {
        NavigationManager.NavigateTo("/Customers/Customer/List");
    }

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        if (!CanSelect)
        {
            isLoading = false;
            return;
        }

        var companyClaim = AuthState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        if (Guid.TryParse(companyClaim, out var companyId))
        {
            var groupsResponse = await CustomerGroupService.GetByCompanyAsync(companyId, 0, 10000);
            if (groupsResponse.IsSuccess && groupsResponse.Data is not null)
            {
                customerGroups = groupsResponse.Data.Data.ToList();
            }

            var allResponse = await CustomerService.GetByCompany(companyId, 0, 10000);
            if (allResponse.IsSuccess && allResponse.Data is not null)
            {
                allCustomers = allResponse.Data.Data.ToList();
                totalCustomers = allResponse.Data.Count;
                activeCustomers = allCustomers.Count(c => c.Status == CustomerStatus.Active);
                taxExemptCustomers = allCustomers.Count(c => c.IsTaxExempt);
                blockedOrSuspendedCustomers = allCustomers.Count(c =>
                    c.Status is CustomerStatus.Blocked or CustomerStatus.Suspended);
            }

            var response = await CustomerService.GetByCompany(companyId, 0, 5);
            if (response.IsSuccess && response.Data is not null)
            {
                recentCustomers = response.Data.Data.ToList();
            }
        }

        isLoading = false;
    }

    private string GetCustomerGroupName(Guid? customerGroupId)
    {
        if (!customerGroupId.HasValue)
            return "";

        var group = customerGroups.FirstOrDefault(g => g.Id == customerGroupId.Value);
        return group is null ? "" : SharedDataService.SelectViewLang(group.NameEng, group.Name);
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}

