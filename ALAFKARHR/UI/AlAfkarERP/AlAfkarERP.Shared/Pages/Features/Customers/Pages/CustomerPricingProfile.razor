    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadCustomerPricingProfile();
            await InvokeAsync(StateHasChanged);
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;

        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadCustomerPricingProfile();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column)
            return "bi bi-arrow-down-up";

        return sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";
    }

    private bool IsCurrentlyEffective(CustomerPricingProfileDto profile)
    {
        var today = DateTime.UtcNow.Date;
        return profile.EffectiveFrom.Date <= today && (profile.EffectiveTo is null || profile.EffectiveTo.Value.Date >= today);
    }

    private bool HasPermission(string permission)
    {
        return AuthState?.User.Claims.Any(c => c.Value == permission) == true;
    }
