@layout AdminLayout
@page "/Customers/CustomerPricingProfile/List"
@implements IDisposable

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Permissions
@using AlAfkarERP.Shared.Pages.Reuable2
@using SharedWithUI.Pricing.Dtos


@inject ICustomerPricingProfileService CustomerPricingProfileService
@inject IPriceListService PriceListService
@inject ICustomerService CustomerService
@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (AuthState is null)
{
    <div class="branches-page">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading special pricing...", "جاري تحميل تخصيص التسعير...")</div>
            </div>
        </div>
    </div>

    return;
}

@if (!CanView)
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="branches-page">
    <div class="branches-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@SharedDataService.SelectViewLang("Customers", "العملاء")</div>
            <h3 class="mb-1">@SharedDataService.SelectViewLang("Special Customer Pricing", "تخصيص تسعير العملاء")</h3>
            <div class="text-muted">@SharedDataService.SelectViewLang("Manage customer-specific price lists and effective dates.", "ادارة قوائم التسعير الخاصة بالعملاء وتواريخ السريان.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="LoadCustomerPricingProfile"
                    disabled="@(editingCustomerPricingProfileId is not null)">
                <i class="bi bi-arrow-clockwise"></i>
                @SharedDataService.SelectViewLang("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanCreate || editingCustomerPricingProfileId is not null)">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create New", "إضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="branch-stat border-primary">
                <div class="branch-stat-icon text-primary"><i class="bi bi-tags"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Visible Profiles", "الملفات المعروضة")</div>
                    <div class="branch-stat-value">@customerPricingProfiles.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-success">
                <div class="branch-stat-icon text-success"><i class="bi bi-calendar-check"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Currently Effective", "سارية حاليا")</div>
                    <div class="branch-stat-value">@customerPricingProfiles.Count(IsCurrentlyEffective)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-info">
                <div class="branch-stat-icon text-info"><i class="bi bi-percent"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Allow Discounts", "تسمح بخصومات")</div>
                    <div class="branch-stat-value">@customerPricingProfiles.Count(p => p.AllowAdditionalDiscounts)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="branch-toolbar mb-3">
                <div class="branch-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search by customer or price list...", "بحث بالعميل او قائمة التسعير...")"
                           @bind="searchText"
                           @bind:event="oninput"
                           @bind:after="OnSearchChanged" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@SharedDataService.SelectViewLang("Rows", "الصفوف")</label>
                    <select class="form-select branch-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive branch-table-wrap">
                        <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

                <table class="table branch-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => Sort(nameof(CustomerPricingProfileDto.CustomerName))'>
                                @SharedDataService.SelectViewLang("Customer", "العميل")
                                <i class="@SortIcon(nameof(CustomerPricingProfileDto.CustomerName))"></i>
                            </th>
                            <th class="sortable" @onclick="() => Sort(nameof(CustomerPricingProfileDto.PriceListName))">
                                @SharedDataService.SelectViewLang("Pricing List", "قائمة التسعير")
                                <i class="@SortIcon(nameof(CustomerPricingProfileDto.PriceListName))"></i>
                            </th>
                            <th class="sortable" @onclick="() => Sort(nameof(CustomerPricingProfileDto.EffectiveFrom))">
                                @SharedDataService.SelectViewLang("Effective from", "يسري من")
                                <i class="@SortIcon(nameof(CustomerPricingProfileDto.EffectiveFrom))"></i>
                            </th>
                            <th class="sortable" @onclick="() => Sort(nameof(CustomerPricingProfileDto.EffectiveTo))">
                                @SharedDataService.SelectViewLang("Effective to", "يسري حتى")
                                <i class="@SortIcon(nameof(CustomerPricingProfileDto.EffectiveTo))"></i>
                            </th>
                            <th>@SharedDataService.SelectViewLang("Discounts", "الخصومات")</th>
                            <th class="text-end">@SharedDataService.SelectViewLang("Actions", "العمليات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (editingCustomerPricingProfileId != null)
                        {
                            var editingItem = customerPricingProfiles.FirstOrDefault(x => x.Id == editingCustomerPricingProfileId);
                            if (editingItem != null)
                            {
                                <tr class="branch-edit-row">
                                    <td colspan="6">
                                        <EditForm Model="editingItem" OnValidSubmit="() => SaveCustomerPricingProfile(editingItem)">
                                            <DataAnnotationsValidator />
                                            <ValidationSummary />
                                            <div class="branch-edit-panel">
                                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                                    <div>
                                                        <h5 class="mb-1">@SharedDataService.SelectViewLang(isEdit ? "Edit Special Pricing" : "Create Special Pricing", isEdit ? "تعديل تخصيص التسعير" : "اضافة تخصيص تسعير")</h5>
                                                        <div class="text-muted small">@SharedDataService.SelectViewLang("Choose the customer, price list, effective dates, and discount behavior.", "اختر العميل وقائمة السعر وتواريخ السريان وسلوك الخصومات.")</div>
                                                    </div>
                                                    <span class="badge text-bg-light">@SharedDataService.SelectViewLang("Inline Form", "نموذج داخلي")</span>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">@SharedDataService.SelectViewLang("Customer", "العميل")</label>
                                                        <AutoCompleteComponent TItem="CustomerDto"
                                                                               Items="customers"
                                                                               ItemText="c => c.Name"
                                                                               PlaceHolder="@SharedDataService.SelectViewLang("Select a customer", "اختر العميل")"
                                                                               Value="selectedCustomer"
                                                                               ValueChanged="OnCustomerSelected" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@SharedDataService.SelectViewLang("Price list", "قائمة الأسعار")</label>
                                                        <AutoCompleteComponent TItem="PriceListDto"
                                                                               Items="priceLists"
                                                                               ItemText="c => c.Name"
                                                                               PlaceHolder="@SharedDataService.SelectViewLang("Select a price list", "اختر قائمة الأسعار")"
                                                                               Value="selectedPriceList"
                                                                               ValueChanged="OnPriceListSelected" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">@SharedDataService.SelectViewLang("Effective from", "يسري من")</label>
                                                        <InputDate class="form-control" @bind-Value="editingItem.EffectiveFrom" />
                                                        <ValidationMessage For="() => editingItem.EffectiveFrom" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">@SharedDataService.SelectViewLang("Effective to", "يسري حتى")</label>
                                                        <InputDate class="form-control" @bind-Value="editingItem.EffectiveTo" />
                                                        <ValidationMessage For="() => editingItem.EffectiveTo" />
                                                    </div>
                                                    <div class="col-md-4">
                                                        <label class="form-label">@SharedDataService.SelectViewLang("Discount (%)", "الخصم (%)")</label>
                                                        <InputNumber class="form-control" @bind-Value="editingItem.DiscountPercentage" />
                                                    </div>
                                                    <div class="col-md-4 d-flex align-items-end">
                                                        <div class="form-check branch-check">
                                                            <InputCheckbox class="form-check-input" @bind-Value="editingItem.AllowAdditionalDiscounts" />
                                                            <label class="form-check-label">@SharedDataService.SelectViewLang("Allow additional discounts", "السماح بخصومات اضافية")</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-end gap-2 mt-4">
                                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                        @SharedDataService.SelectViewLang("Cancel", "الغاء")
                                                    </button>
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bi bi-check2"></i>
                                                        @SharedDataService.SelectViewLang("Save", "حفظ")
                                                    </button>
                                                </div>
                                            </div>
                                        </EditForm>
                                    </td>
                                </tr>
                            }
                        }

                        @foreach (var custPrPro in ProcessedCustomerPricingProfile.Where(x => x.Id != editingCustomerPricingProfileId))
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@custPrPro.CustomerName</div>
                                    <div class="text-muted small">@custPrPro.CustomerId</div>
                                </td>
                                <td>@custPrPro.PriceListName</td>
                                <td>@custPrPro.EffectiveFrom.ToString("yyyy/MM/dd")</td>
                                <td>@(custPrPro.EffectiveTo?.ToString("yyyy/MM/dd") ?? "-")</td>
                                <td>
                                    @if (custPrPro.AllowAdditionalDiscounts)
                                    {
                                        <span class="badge rounded-pill text-bg-success">@SharedDataService.SelectViewLang("Allowed", "مسموح")</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill text-bg-light">@SharedDataService.SelectViewLang("Not Allowed", "غير مسموح")</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-outline-warning btn-sm branch-action"
                                                @onclick="() => EditCustomerPricingProfile(custPrPro.Id)"
                                                disabled="@(!CanEdit)"
                                                title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm branch-action"
                                                @onclick="() => DeleteCustomerPricingProfile(custPrPro)"
                                                disabled="@(!CanDelete)"
                                                title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!ProcessedCustomerPricingProfile.Any() && editingCustomerPricingProfileId is null)
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="branch-empty">
                                        <i class="bi bi-inboxes"></i>
                                        <div class="fw-semibold">@SharedDataService.SelectViewLang("No special pricing found", "لم يتم العثور على تخصيص تسعير")</div>
                                        <div class="text-muted small">@SharedDataService.SelectViewLang("Try changing the search text or create a new profile.", "جرّب تغيير البحث او اضافة ملف جديد.")</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="branch-pagination">
                <div class="text-muted small">
                    @SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @Math.Max(TotalPages, 1)
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(pageIndex == 0)">
                        <i class="bi bi-chevron-left"></i>
                        @SharedDataService.SelectViewLang("Previous", "السابق")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages - 1)">
                        @SharedDataService.SelectViewLang("Next", "التالي")
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .branches-page { max-width: 1400px; }
    .branches-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-stat { align-items: center; background: var(--erp-surface); border-inline-start: 4px solid; border-radius: var(--erp-radius-lg); box-shadow: var(--erp-shadow-sm); display: flex; gap: 0.875rem; min-height: 88px; padding: 1rem; }
    .branch-stat-icon { align-items: center; background: var(--erp-surface-muted); border-radius: var(--erp-radius-lg); display: inline-flex; font-size: 1.35rem; height: 44px; justify-content: center; width: 44px; }
    .branch-stat-value { color: var(--erp-text); font-size: 1.35rem; font-weight: 700; line-height: 1.15; }
    .branch-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-search { max-width: 420px; position: relative; width: min(100%, 420px); }
    .branch-search i { color: var(--erp-text-muted); inset-inline-start: 0.875rem; position: absolute; top: 50%; transform: translateY(-50%); }
    .branch-search .form-control { padding-inline-start: 2.5rem; }
    .branch-page-size { min-width: 82px; }
    .branch-table-wrap { border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); }
    .branch-table thead th { background: var(--erp-surface-muted); color: var(--erp-text-muted); font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
    .branch-table tbody tr:hover { background: var(--erp-primary-soft); }
    .branch-table .sortable { cursor: pointer; user-select: none; }
    .branch-table .sortable i { color: var(--erp-text-muted); font-size: 0.75rem; margin-inline-start: 0.35rem; }
    .branch-action { align-items: center; display: inline-flex; height: 32px; justify-content: center; width: 36px; }
    .branch-edit-row > td { background: var(--erp-surface-muted); padding: 1rem; }
    .branch-edit-panel { background: var(--erp-surface); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); padding: 1rem; }
    .branch-check { align-items: center; background: var(--erp-surface-muted); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); display: inline-flex; gap: 0.5rem; padding: 0.75rem 1rem; }
    .branch-check .form-check-input { margin: 0; }
    .branch-empty { align-items: center; color: var(--erp-text-muted); display: grid; justify-items: center; padding: 2rem; text-align: center; }
    .branch-empty i { color: var(--erp-text-soft); font-size: 2rem; margin-bottom: 0.5rem; }
    .branch-pagination { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-top: 1rem; }
    [dir="rtl"] .branch-stat { border-inline-start: 0; border-inline-end: 4px solid; }
    [dir="rtl"] .branch-search i { inset-inline-start: auto; inset-inline-end: 0.875rem; }
    [dir="rtl"] .branch-search .form-control { padding-inline-start: 0.75rem; padding-inline-end: 2.5rem; }
</style>

@code {
    private List<CustomerPricingProfileDto> customerPricingProfiles = new();
    private CustomerPricingProfileDto customerPricingProfileDto = new();
    private Guid? editingCustomerPricingProfileId;

    private Guid companyId;

    private List<PriceListDto> priceLists = [];
    private PriceListDto? selectedPriceList;

    private List<CustomerDto> customers = [];
    private CustomerDto? selectedCustomer;

    private bool isEdit = false;
    private AuthenticationState? AuthState;
    private bool CanView => HasPermission(PermissionList.CustomerPricingProfilePermissions.View);
    private bool CanCreate => HasPermission(PermissionList.CustomerPricingProfilePermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.CustomerPricingProfilePermissions.Edit);
    private bool CanDelete => HasPermission(PermissionList.CustomerPricingProfilePermissions.Delete);

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        var custRes = await CustomerService.GetByCompany(companyId, 0, 10000);
        if (custRes.IsSuccess)
        {
            customers = custRes.Data?.Data?.ToList() ?? [];
        }

        var plRes = await PriceListService.GetByCompanyId(companyId, 0, 10000);
        if (plRes.IsSuccess)
        {
            priceLists = plRes.Data?.Data?.ToList() ?? [];
        }

        await LoadCustomerPricingProfile();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }

    void CreateNew()
    {
        var newItem = new CustomerPricingProfileDto()
        {
            Id = Guid.NewGuid(),
            CompanyId = companyId,
            EffectiveFrom = DateTime.UtcNow,
            EffectiveTo = null,
            AllowAdditionalDiscounts = false,


        };



        customerPricingProfiles.Insert(0, newItem);
        editingCustomerPricingProfileId = newItem.Id;
        isEdit = false;
    }

    void EditCustomerPricingProfile(Guid id)
    {
        editingCustomerPricingProfileId = id;
        var ecpp = customerPricingProfiles.FirstOrDefault(x => x.Id == id);
        if(ecpp != null)
        {
            selectedCustomer = customers.FirstOrDefault(c => c.Id == ecpp.CustomerId);
            selectedPriceList = priceLists.FirstOrDefault(p => p.Id == ecpp.PriceListId);
        }
        isEdit = true;
        // editingVariantValueId = variants.FirstOrDefault(v => v.Id == id)?.Values.FirstOrDefault()?.Id ?? null;
        StateHasChanged();
    }
    async Task SaveCustomerPricingProfile(CustomerPricingProfileDto customerPricingProfile)
    {

        if (customerPricingProfile.Id == editingCustomerPricingProfileId && !isEdit)
        {
            //Create new

            // Random rnd = new Random();
            if(selectedCustomer == null || selectedPriceList == null)
            {
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Please select both customer and price list", "الرجاء اختيار كل من العميل وقائمة الأسعار"),
                    Type = "warning"
                });
                return;
            }
            customerPricingProfile.CustomerId = selectedCustomer.Id;
            customerPricingProfile.PriceListId = selectedPriceList.Id;
            customerPricingProfile.CompanyId = companyId;
            if (customerPricingProfile.EffectiveTo.HasValue && customerPricingProfile.EffectiveTo.Value.Date < customerPricingProfile.EffectiveFrom.Date)
            {
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Effective to must be after effective from", "يجب ان يكون تاريخ النهاية بعد تاريخ البداية"),
                    Type = "warning"
                });
                return;
            }

            var bResponse = await CustomerPricingProfileService.CreateAsync(customerPricingProfile);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Customer Pricing Profile has been created successfully", "تم إنشاء ملف تسعير العميل بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit
            if(selectedPriceList != null)
                customerPricingProfile.PriceListId = selectedPriceList.Id;

            if (customerPricingProfile.EffectiveTo.HasValue && customerPricingProfile.EffectiveTo.Value.Date < customerPricingProfile.EffectiveFrom.Date)
            {
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Effective to must be after effective from", "يجب ان يكون تاريخ النهاية بعد تاريخ البداية"),
                    Type = "warning"
                });
                return;
            }

            var bresponse = await CustomerPricingProfileService.UpdateAsync(customerPricingProfile);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Customer Pricing Profile has been Edited successfully", "تم تعديل ملف تسعير العميل بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show
                //
                //
                //
                //   fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadCustomerPricingProfile();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingCustomerPricingProfileId = null;
    }

    async Task DeleteCustomerPricingProfile(CustomerPricingProfileDto customerPricingProfile)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this Customer pricing profile?: {customerPricingProfile.CustomerName}?", $"هل ترغب فعلا في حذف ملف تسعير العميل: {customerPricingProfile.CustomerName}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await CustomerPricingProfileService.DeleteAsync(customerPricingProfile.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadCustomerPricingProfile();

                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the Customer pricing profile", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = customerPricingProfiles.FirstOrDefault(x => x.Id == editingCustomerPricingProfileId);

        if (item != null && item.Id != Guid.Empty)
        {
            await LoadCustomerPricingProfile();
        }
        else
        {
            // new record → remove it
            customerPricingProfiles.Remove(item);
        }
        isEdit = false;
        editingCustomerPricingProfileId = null;
    }

