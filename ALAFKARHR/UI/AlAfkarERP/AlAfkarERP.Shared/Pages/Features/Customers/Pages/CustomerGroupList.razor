@layout AdminLayout
@page "/Customers/CustomerGroup/List"

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Customers.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Customers.Dtos
@using SharedWithUI.Customers.Enums
@using SharedWithUI.Permissions
@using SharedWithUI.Pricing.Dtos

@inject ICustomerGroupService CustomerGroupService
@inject IPriceListService PriceListService

@inject ToastService ToastService
@inject ModalService ModalService
@inject LoadingService LoadingService

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService

@if (isLoading)
{
    <div class="branches-page">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading customer groups...", "جاري تحميل فئات العملاء...")</div>
            </div>
        </div>
    </div>
}
else if (!CanView)
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
}
else
{
    <div class="branches-page">
    <div class="branches-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@SharedDataService.SelectViewLang("Customers", "العملاء")</div>
            <h3 class="mb-1">@SharedDataService.SelectViewLang("Customer Groups Management", "ادارة فئات العملاء")</h3>
            <div class="text-muted">
                @SharedDataService.SelectViewLang("Create, edit, search, and archive customer group records.", "انشاء وتعديل وبحث وارشفة بيانات فئات العملاء.")
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="LoadCustomerGroup"
                    disabled="@(editingCustomerGroupId is not null)">
                <i class="bi bi-arrow-clockwise"></i>
                @SharedDataService.SelectViewLang("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanCreate || editingCustomerGroupId is not null)">
                <i class="bi bi-plus-lg"></i>
                @SharedDataService.SelectViewLang("Create New", "اضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="branch-stat border-primary">
                <div class="branch-stat-icon text-primary"><i class="bi bi-people"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("Visible Groups", "الفئات المعروضة")</div>
                    <div class="branch-stat-value">@customerGroups.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-success">
                <div class="branch-stat-icon text-success"><i class="bi bi-percent"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("With Discount", "لديها خصم")</div>
                    <div class="branch-stat-value">@customerGroups.Count(g => g.DefaultDiscountPercentage > 0)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-info">
                <div class="branch-stat-icon text-info"><i class="bi bi-tags"></i></div>
                <div>
                    <div class="text-muted small">@SharedDataService.SelectViewLang("With Price List", "لديها قائمة تسعير")</div>
                    <div class="branch-stat-value">@customerGroups.Count(g => g.DefaultPriceListId is not null)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="branch-toolbar mb-3">
                <div class="branch-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@SharedDataService.SelectViewLang("Search customer groups...", "بحث في فئات العملاء...")"
                           @bind="searchText"
                           @bind:event="oninput" />
                </div>
            <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@SharedDataService.SelectViewLang("Rows", "الصفوف")</label>
                    <select class="form-select branch-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive branch-table-wrap">
                <table class="table branch-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => Sort(SharedDataService.Language=="Ar"? nameof(CustomerGroupDto.Name) : nameof(CustomerGroupDto.NameEng))'>
                                @SharedDataService.SelectViewLang("Name", "الاسم")
                                <i class="@SortIcon(SharedDataService.Language=="Ar"? nameof(CustomerGroupDto.Name) : nameof(CustomerGroupDto.NameEng))"></i>
                            </th>
                            <th>@SharedDataService.SelectViewLang("Discount (%)", "الخصم (%)")</th>
                            <th>@SharedDataService.SelectViewLang("Pricing List", "قائمة التسعير")</th>
                            <th>@SharedDataService.SelectViewLang("Description", "الوصف")</th>
                            <th class="text-end">@SharedDataService.SelectViewLang("Actions", "العمليات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (editingCustomerGroupId is not null)
                        {
                            <tr class="branch-edit-row">
                                <td colspan="5">
                                    <EditForm Model="editingCustomerGroup" OnValidSubmit="SaveCustomerGroup">
                                        <DataAnnotationsValidator />
                                        <div class="branch-edit-panel">
                                            <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                                <div>
                                                    <h5 class="mb-1">
                                                        @(isEdit
                                                            ? SharedDataService.SelectViewLang("Edit Customer Group", "تعديل فئة العميل")
                                                            : SharedDataService.SelectViewLang("New Customer Group", "فئة عميل جديدة"))
                                                    </h5>
                                                    <div class="text-muted small">@SharedDataService.SelectViewLang("Set group identity, discount, and default price list.", "تحديد بيانات الفئة والخصم وقائمة التسعير الافتراضية.")</div>
                                                </div>
                                                <span class="badge text-bg-light">@SharedDataService.SelectViewLang("Inline Form", "نموذج داخلي")</span>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                                    <InputText class="form-control" @bind-Value="editingCustomerGroup.Name" />
                                                    <ValidationMessage For="() => editingCustomerGroup.Name" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Discount (%)", "الخصم(%)")</label>
                                                    <InputNumber class="form-control" @bind-Value="editingCustomerGroup.DefaultDiscountPercentage" />
                                                </div>
                                                <div class="col-md-4">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Pricing List", "قائمة التسعير")</label>
                                                    <AutoCompleteComponent TItem="PriceListDto"
                                                                           Items="priceLists"
                                                                           ItemText="pl=>pl.Name"
                                                                           PlaceHolder="@SharedDataService.SelectViewLang("Select a pricing list...", "اختر قائمة التسعير...")"
                                                                           Value="selectedPricelist"
                                                                           ValueChanged="onSelectedPriceList" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label">@SharedDataService.SelectViewLang("Description", "الوصف")</label>
                                                    <InputTextArea class="form-control" rows="2" @bind-Value="editingCustomerGroup.Description" />
                                                </div>
                                            </div>

                                            <div class="d-flex justify-content-end gap-2 mt-4">
                                                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                    @SharedDataService.SelectViewLang("Cancel", "الغاء")
                                                </button>
                                                <button type="submit" class="btn btn-success">
                                                    <i class="bi bi-check2"></i>
                                                    @SharedDataService.SelectViewLang("Save", "حفظ")
                                                </button>
                                            </div>
                                        </div>
                                    </EditForm>
                                </td>
                            </tr>
                        }

                        @foreach (var customerGroup in ProcessedCustomers)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@(SharedDataService.Language == "Ar" ? customerGroup.Name : customerGroup.NameEng)</div>
                                </td>
                                <td><span class="badge rounded-pill text-bg-light">@customerGroup.DefaultDiscountPercentage%</span></td>
                                <td>@(priceLists.FirstOrDefault(pl=>pl.Id== customerGroup.DefaultPriceListId)?.Name??"")</td>
                                <td>@customerGroup.Description</td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-outline-warning btn-sm branch-action"
                                            @onclick="() => EditCustomerGroup(customerGroup.Id)"
                                            disabled="@(!CanEdit || editingCustomerGroupId is not null)"
                                            title="@SharedDataService.SelectViewLang("Edit", "تعديل")">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm branch-action"
                                            @onclick="() => DeleteCustomerGroup(customerGroup)"
                                            disabled="@(!CanDelete || editingCustomerGroupId is not null)"
                                            title="@SharedDataService.SelectViewLang("Delete", "حذف")">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!ProcessedCustomers.Any() && editingCustomerGroupId is null)
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="branch-empty">
                                        <i class="bi bi-inboxes"></i>
                                        <div class="fw-semibold">@SharedDataService.SelectViewLang("No customer groups found", "لم يتم العثور على فئات عملاء")</div>
                                        <div class="text-muted small">@SharedDataService.SelectViewLang("Try changing the search text or create a new group.", "جرّب تغيير البحث او اضافة فئة جديدة.")</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="branch-pagination">
                <div class="text-muted small">
                    @SharedDataService.SelectViewLang("Page", "صفحة") @(pageIndex + 1) @SharedDataService.SelectViewLang("of", "من") @Math.Max(TotalPages, 1)
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(pageIndex == 0)">
                        <i class="bi bi-chevron-left"></i>
                        @SharedDataService.SelectViewLang("Previous", "السابق")
                    </button>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages - 1)">
                        @SharedDataService.SelectViewLang("Next", "التالي")
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
    </div>
}

<style>
    .branches-page { max-width: 1400px; }
    .branches-header { align-items: flex-start; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-stat { align-items: center; background: #fff; border-left: 4px solid; border-radius: 8px; box-shadow: 0 0.125rem 0.35rem rgba(15, 23, 42, 0.08); display: flex; gap: 0.875rem; min-height: 88px; padding: 1rem; }
    .branch-stat-icon { align-items: center; background: #f8f9fa; border-radius: 8px; display: inline-flex; font-size: 1.35rem; height: 44px; justify-content: center; width: 44px; }
    .branch-stat-value { color: #212529; font-size: 1.35rem; font-weight: 700; line-height: 1.15; }
    .branch-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; }
    .branch-search { max-width: 420px; position: relative; width: min(100%, 420px); }
    .branch-search i { color: #6c757d; left: 0.875rem; position: absolute; top: 50%; transform: translateY(-50%); }
    .branch-search .form-control { padding-left: 2.5rem; }
    .branch-page-size { min-width: 82px; }
    .branch-table-wrap { border: 1px solid #e9ecef; border-radius: 8px; }
    .branch-table thead th { background: #f8f9fa; color: #495057; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; white-space: nowrap; }
    .branch-table tbody tr:hover { background: #fbfcfe; }
    .branch-table .sortable { cursor: pointer; user-select: none; }
    .branch-table .sortable i { color: #6c757d; font-size: 0.75rem; margin-inline-start: 0.35rem; }
    .branch-action { align-items: center; display: inline-flex; height: 32px; justify-content: center; width: 36px; }
    .branch-edit-row > td { background: #f8fbff; padding: 1rem; }
    .branch-edit-panel { background: #fff; border: 1px solid #dbeafe; border-radius: 8px; padding: 1rem; }
    .branch-empty { align-items: center; color: #6c757d; display: grid; justify-items: center; padding: 2rem; text-align: center; }
    .branch-empty i { color: #adb5bd; font-size: 2rem; margin-bottom: 0.5rem; }
    .branch-pagination { align-items: center; display: flex; flex-wrap: wrap; gap: 1rem; justify-content: space-between; margin-top: 1rem; }
    [dir="rtl"] .branch-stat { border-left: 0; border-right: 4px solid; }
    [dir="rtl"] .branch-search i { left: auto; right: 0.875rem; }
    [dir="rtl"] .branch-search .form-control { padding-left: 0.75rem; padding-right: 2.5rem; }
</style>

@code {
    private List<CustomerGroupDto> customerGroups = new();
    private CustomerGroupDto editingCustomerGroup = NewCustomerGroup();
    private Guid? editingCustomerGroupId;
    private Guid companyId;
    private bool isEdit;
    private bool isLoading = true;
    private AuthenticationState? AuthState;

    private PriceListDto? selectedPricelist;
    private List<PriceListDto> priceLists = new();

    private string searchText = "";
    private string sortColumn = nameof(CustomerGroupDto.Name);
    private bool sortAscending = true;
    private int pageSize = 10;
    private int pageIndex;
    private int TotalPages = 1;

    private bool CanView => HasPermission(PermissionList.CustomerGroupPermissions.View);
    private bool CanCreate => HasPermission(PermissionList.CustomerGroupPermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.CustomerGroupPermissions.Edit);
    private bool CanDelete => HasPermission(PermissionList.CustomerGroupPermissions.Delete);

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;

        AuthState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        var companyClaim = AuthState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        if (!Guid.TryParse(companyClaim, out companyId))
        {
            ToastService.Show(new ToastMessage
            {
                Message = SharedDataService.SelectViewLang("Company id is missing from the current user.", "معرف الشركة غير موجود للمستخدم الحالي."),
                Type = "error"
            });
            isLoading = false;
            return;
        }

        var plResponse = await PriceListService.GetByCompanyId(companyId, 0, 1000);
        if (plResponse.IsSuccess && plResponse.Data is not null)
            priceLists = plResponse.Data.Data.ToList();
        // else
        // ShowError(plResponse.Error?.Detail ?? SharedDataService.SelectViewLang("Unable to load price lists.", "تعذر تحميل قوائم التسعير."));

        if (CanView)
            await LoadCustomerGroup();

        isLoading = false;
    }

    private void CreateNew()
    {
        selectedPricelist = null;
        editingCustomerGroup = NewCustomerGroup();
        editingCustomerGroup.CompanyId = companyId;
        editingCustomerGroupId = editingCustomerGroup.Id;
        // customerGroupIdText = "";
        isEdit = false;
    }

    private async Task EditCustomerGroup(Guid id)
    {
        var response = await CustomerGroupService.GetByIdAsync(id);
        if (!response.IsSuccess || response.Data is null)
        {
            ShowError(SharedDataService.SelectViewLang("Unable to load customer group.", "تعذر تحميل فئة العملاء."));
            return;
        }

        editingCustomerGroup = response.Data;
        editingCustomerGroupId = editingCustomerGroup.Id;
        selectedPricelist = priceLists.FirstOrDefault(pl => pl.Id == editingCustomerGroup.DefaultPriceListId);
        // customerGroupIdText = editingCustomerGroup.CustomerGroupId?.ToString() ?? "";
        isEdit = true;
    }

    private async Task SaveCustomerGroup()
    {
        if (string.IsNullOrWhiteSpace(editingCustomerGroup.Name))
        {
            ShowError(SharedDataService.SelectViewLang("Customer group name is required.", "اسم فئة العملاء مطلوب."));
            return;
        }

        editingCustomerGroup.CompanyId = companyId;
        // Normalize(editingCustomerGroup);

        var isSuccess = false;
        string? errorMessage = null;

        if (isEdit)
        {
            var response = await CustomerGroupService.UpdateAsync(editingCustomerGroup);
            isSuccess = response.IsSuccess;
            errorMessage = response.Error?.Detail;
        }
        else
        {
            var response = await CustomerGroupService.CreateAsync(editingCustomerGroup);
            isSuccess = response.IsSuccess;
            errorMessage = response.Error?.Detail;
        }

        if (isSuccess)
        {
            ToastService.Show(new ToastMessage
            {
                Message = isEdit
                    ? SharedDataService.SelectViewLang("Customer group has been updated successfully.", "تم تعديل فئة العملاء بنجاح.")
                    : SharedDataService.SelectViewLang("Customer group has been created successfully.", "تم انشاء فئة العملاء بنجاح."),
                Type = "success"
            });

            editingCustomerGroupId = null;
            isEdit = false;
            await LoadCustomerGroup();
            return;
        }

        ShowError(errorMessage ?? SharedDataService.SelectViewLang("Customer group save failed.", "فشل حفظ فئة العملاء."));
    }

    private void CancelEdit()
    {
        editingCustomerGroupId = null;
        editingCustomerGroup = NewCustomerGroup();
        // customerGroupIdText = "";
        isEdit = false;
    }

    private async Task DeleteCustomerGroup(CustomerGroupDto customerGroup)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang(
                $"Are you sure you want to delete customer group: {customerGroup.Name}?",
                $"هل ترغب فعلا في حذف فئة العملاء: {customerGroup.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),
            OnOk = async () =>
            {
                var response = await CustomerGroupService.DeleteAsync(customerGroup.Id);
                if (response.IsSuccess)
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Customer group deleted successfully.", "تم حذف فئة العملاء بنجاح."),
                        Type = "success"
                    });
                    await LoadCustomerGroup();
                    await InvokeAsync(StateHasChanged);
                }
                else
                {
                    ShowError(response.Error?.Detail ?? SharedDataService.SelectViewLang("Delete failed.", "فشلت عملية الحذف."));
                }
            }
        });
    }

    private async Task LoadCustomerGroup()
    {
        LoadingService.Show();
        var response = await CustomerGroupService.GetByCompanyAsync(companyId, pageIndex, pageSize, searchText);
        if (response.IsSuccess && response.Data is not null)
        {
            customerGroups = response.Data.Data.ToList();
            TotalPages = Math.Max(1, (int)Math.Ceiling(response.Data.Count / (double)pageSize));
        }
        else
        {
            customerGroups = [];
            TotalPages = 1;
            ShowError(response.Error?.Detail ?? SharedDataService.SelectViewLang("Unable to load customer groups.", "تعذر تحميل فئة العملاء."));
        }
        LoadingService.Hide();
    }

    private async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var newPageSize))
        {
            pageSize = newPageSize;
            pageIndex = 0;
            await LoadCustomerGroup();
        }
    }

    private IEnumerable<CustomerGroupDto> ProcessedCustomers =>
        customerGroups
            .OrderByDynamic(sortColumn, sortAscending);

    private async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadCustomerGroup();
        }
    }

    private async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadCustomerGroup();
        }
    }

    private void Sort(string column)
    {
        sortColumn = SharedDataService.Language == "Ar" ? nameof(CustomerGroupDto.Name) : nameof(CustomerGroupDto.NameEng);
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string SortIcon(string column)
    {
        if (sortColumn != column)
            return "bi bi-arrow-down-up";

        return sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";
    }




    private static CustomerGroupDto NewCustomerGroup() => new()
    {
        Id = Guid.NewGuid(),
        Name = "",
        // CompanyId = companyId,
        // DefaultDiscountPercentage = 0,


    };

    // private static CustomerGroupDto Normalize(CustomerGroupDto customerGroup)
    // {
    //     customerGroup.Name ??= "";

    //     return customerGroup;
    // }

    private void onSelectedPriceList(PriceListDto? priceList)
    {
        editingCustomerGroup.DefaultPriceListId = null;
        selectedPricelist = priceList;
        if (editingCustomerGroup is not null)
            editingCustomerGroup.DefaultPriceListId = priceList?.Id;
    }

    private bool HasPermission(string permission)
    {
        return AuthState?.User.Claims.Any(c => c.Value == permission) == true;
    }

    private void ShowError(string message)
    {
        ToastService.Show(new ToastMessage
        {
            Message = message,
            Type = "error"
        });
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
