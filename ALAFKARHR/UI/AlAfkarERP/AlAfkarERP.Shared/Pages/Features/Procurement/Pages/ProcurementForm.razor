    private EditableProcurementLine CreateReceiptLineFromPurchaseOrder(Guid purchaseOrderId, ProcurementDocumentLineDto line)
    {
        var previouslyReceived = ReceivedQuantityForPurchaseOrderLine(purchaseOrderId, line);
        var remaining = Math.Max(line.Quantity - previouslyReceived, 0);
        return CreatePurchaseOrderBasedLine(line, remaining, previouslyReceived);
    }

    private EditableProcurementLine CreateInvoiceLineFromPurchaseOrder(Guid purchaseOrderId, ProcurementDocumentLineDto line)
    {
        var received = ReceivedQuantityForPurchaseOrderLine(purchaseOrderId, line);
        var alreadyInvoiced = InvoicedQuantityForSku(InvoiceSourceIdsForPurchaseOrder(purchaseOrderId), line.ProductSkuId);
        var invoiceable = Math.Max(received - alreadyInvoiced, 0);
        return CreateInvoiceBasedLine(line, invoiceable, received, alreadyInvoiced);
    }

    private EditableProcurementLine CreateInvoiceLineFromGoodsReceipt(ProcurementDocumentDto goodsReceipt, ProcurementDocumentLineDto line)
    {
        var received = line.Quantity;
        var alreadyInvoiced = InvoicedQuantityForSku(InvoiceSourceIdsForGoodsReceipt(goodsReceipt), line.ProductSkuId);
        var invoiceable = Math.Max(received - alreadyInvoiced, 0);
        return CreateInvoiceBasedLine(line, invoiceable, received, alreadyInvoiced);
    }

    private EditableProcurementLine CreatePurchaseOrderBasedLine(ProcurementDocumentLineDto line, decimal quantity, decimal previouslyReceived)
    {
        var editableLine = new EditableProcurementLine(line)
        {
            Id = Guid.Empty,
            Quantity = quantity,
            BillControlPolicy = line.BillControlPolicy ?? document.BillControlPolicy,
            ThreeWayMatchStatus = ResolveLineMatchStatus(document.BillControlPolicy, quantity, previouslyReceived, 0),
            ReceivedQuantity = previouslyReceived,
            BilledQuantity = 0,
            OrderedQuantity = line.Quantity,
            PreviouslyReceivedQuantity = previouslyReceived,
            RemainingQuantity = Math.Max(line.Quantity - previouslyReceived, 0),
            HasReceiptProgressInfo = true,
            SelectedProduct = products.FirstOrDefault(product => product.Id == line.ProductId),
            SelectedSku = allSkus.FirstOrDefault(sku => sku.Id == line.ProductSkuId),
            SelectedBatch = null,
            BatchId = null,
            WarehouseId = selectedWarehouse?.Id,
            IsSourceLine = true
        };

        return editableLine;
    }

    private EditableProcurementLine CreateInvoiceBasedLine(ProcurementDocumentLineDto line, decimal quantity, decimal receivedQuantity, decimal alreadyInvoicedQuantity)
    {
        var editableLine = new EditableProcurementLine(line)
        {
            Id = Guid.Empty,
            Quantity = quantity,
            BillControlPolicy = line.BillControlPolicy ?? document.BillControlPolicy,
            ThreeWayMatchStatus = ResolveLineMatchStatus(document.BillControlPolicy, quantity, receivedQuantity, alreadyInvoicedQuantity),
            ReceivedQuantity = receivedQuantity,
            BilledQuantity = alreadyInvoicedQuantity,
            OrderedQuantity = receivedQuantity,
            PreviouslyReceivedQuantity = alreadyInvoicedQuantity,
            RemainingQuantity = Math.Max(receivedQuantity - alreadyInvoicedQuantity, 0),
            HasReceiptProgressInfo = true,
            SelectedProduct = products.FirstOrDefault(product => product.Id == line.ProductId),
            SelectedSku = allSkus.FirstOrDefault(sku => sku.Id == line.ProductSkuId),
            SelectedBatch = null,
            BatchId = null,
            WarehouseId = selectedWarehouse?.Id,
            IsSourceLine = true
        };

        return editableLine;
    }

    private static ThreeWayMatchStatus ResolveLineMatchStatus(PurchaseBillControlPolicy policy, decimal currentQuantity, decimal receivedQuantity, decimal billedQuantity)
    {
        if (policy == PurchaseBillControlPolicy.OrderedQuantities)
            return currentQuantity > 0 ? ThreeWayMatchStatus.ReadyToBill : ThreeWayMatchStatus.NotRequired;

        if (receivedQuantity <= 0)
            return ThreeWayMatchStatus.PendingReceipt;

        return billedQuantity >= receivedQuantity ? ThreeWayMatchStatus.Matched : ThreeWayMatchStatus.ReadyToBill;
    }

