    private void ApplySourceDocumentBranch(ProcurementDocumentDto source)
    {
        if (!source.BranchId.HasValue)
            return;

        document.BranchId = source.BranchId;
        if (selectedWarehouse is not null && selectedWarehouse.BranchId != source.BranchId)
        {
            selectedWarehouse = null;
            document.WarehouseId = null;
            foreach (var line in document.Lines)
                line.WarehouseId = null;
        }
    }

    private bool ValidateWarehouseBranch()
    {
        if (selectedWarehouse is not null && document.BranchId.HasValue && selectedWarehouse.BranchId != document.BranchId)
        {
            ToastService.ShowWarning(SharedDataService.SelectViewLang(
                "Select a warehouse that belongs to the document branch.",
                "اختر مستودعاً يتبع فرع المستند."));
            return false;
        }

        return true;
    }

