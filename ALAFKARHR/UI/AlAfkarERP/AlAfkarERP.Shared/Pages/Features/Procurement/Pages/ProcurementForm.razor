    private bool LineMatchesSearch(EditableProcurementLine line)
    {
        var search = lineSearchText?.Trim();
        if (string.IsNullOrWhiteSpace(search))
            return true;

        return LineDisplayNumber(line).ToString().Contains(search, StringComparison.OrdinalIgnoreCase)
            || ProductDisplay(line).Contains(search, StringComparison.OrdinalIgnoreCase)
            || SkuDisplay(line).Contains(search, StringComparison.OrdinalIgnoreCase)
            || (line.Notes?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private string LineSummary(EditableProcurementLine line)
    {
        var product = ProductDisplay(line);
        var sku = SkuDisplay(line);
        if (product == "-" && sku == "-")
            return SharedDataService.SelectViewLang("No product selected", "لم يتم اختيار منتج");

        if (sku == "-")
            return product;

        if (product == "-")
            return sku;

        return $"{product} / {sku}";
    }

