@layout AdminLayout
@page "/Procurement/{KindRoute}/Form"
@page "/Procurement/{KindRoute}/Form/{Id:guid}"

@using AlAfkarERP.Shared.Pages.Features.Catalog.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Features.Inventories.Services
@using AlAfkarERP.Shared.Pages.Features.Procurement.Services
@using AlAfkarERP.Shared.Pages.Features.Suppliers.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Catalog.Dtos
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Inventory.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Procurement.Dtos
@using SharedWithUI.Procurement.Enums
@using SharedWithUI.Suppliers.Dtos

@implements IDisposable
@inject IProcurementService ProcurementService
@inject ISupplierService SupplierService
@inject IProductService ProductService
@inject IWarehouseService WarehouseService
@inject IBranchService BranchService
@inject IBatchService BatchService
@inject ICurrencyService CurrencyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@SharedDataService.SelectViewLang(Meta.En, Meta.Ar)"
                Subtitle="@SharedDataService.SelectViewLang("Capture document header and selectable procurement lines.", "إدخال رأس المستند وبنود المشتريات القابلة للاختيار.")"
                Overline="@SharedDataService.SelectViewLang("Procurement", "المشتريات")"
                Icon="@Meta.Icon">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="Cancel">
                <i class="bi bi-arrow-return-left"></i>
                @SharedDataService.SelectViewLang("Back", "رجوع")
            </button>
        </Actions>
    </PageHeader>

    @if (isLoading)
    {
        <AppCard>
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@SharedDataService.SelectViewLang("Loading procurement document...", "جاري تحميل مستند المشتريات...")</div>
            </div>
        </AppCard>
    }
    else
    {
        <EditForm Model="document" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <AppCard Title="@SharedDataService.SelectViewLang("Document", "المستند")" CssClass="mb-3 erp-form-section allow-overflow">
                <div class="row g-3">
                    @if (IsGoodsReceipt)
                    {
                        <div class="col-md-6">
                            <label class="form-label">@SharedDataService.SelectViewLang("Related Purchase Order", "Related Purchase Order")</label>
                            <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                   Items="receivablePurchaseOrders"
                                                   ItemText="PurchaseOrderText"
                                                   Value="selectedSourcePurchaseOrder"
                                                   ValueChanged="OnSourcePurchaseOrderChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select sent purchase order...", "Select sent purchase order...")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Warehouse", "Warehouse")</label>
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="WarehouseOptions"
                                                   ItemText="WarehouseText"
                                                   Value="selectedWarehouse"
                                                   ValueChanged="OnWarehouseChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse...", "Select warehouse...")" />
                        </div>
                    }
                    @if (!HideDocumentNumberField)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@DocumentNumberLabel</label>
                            <InputText class="form-control"
                                       @bind-Value="document.Number"
                                       readonly="@IsSystemNumberedDocument" />
                            <ValidationMessage For="() => document.Number" />
                        </div>
                    }
                    <div class="col-md-3">
                        <label class="form-label">@SharedDataService.SelectViewLang("Date", "التاريخ")</label>
                        <InputDate class="form-control" @bind-Value="document.DocumentDate" />
                    </div>
                    @if (!IsPurchaseRequest)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Supplier", "المورد")</label>
                            <div class="d-flex gap-2">
                                <div class="flex-grow-1">
                                    <AutoCompleteComponent TItem="SupplierDto"
                                                           Items="suppliers"
                                                           ItemText="SupplierText"
                                                           Value="selectedSupplier"
                                                           ValueChanged="OnSupplierChanged"
                                                           PlaceHolder="@SharedDataService.SelectViewLang("Select supplier...", "اختر المورد...")" />
                                </div>
                                <button type="button" class="btn btn-outline-primary" title="@SharedDataService.SelectViewLang("Create supplier", "إنشاء مورد")" @onclick="CreateSupplier">
                                    <i class="bi bi-plus-lg"></i>
                                </button>
                            </div>
                        </div>
                    }
                    @if (NeedsStockContext && !IsGoodsReceipt)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Warehouse", "المستودع")</label>
                            <AutoCompleteComponent TItem="WarehouseDto"
                                                   Items="WarehouseOptions"
                                                   ItemText="WarehouseText"
                                                   Value="selectedWarehouse"
                                                   ValueChanged="OnWarehouseChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select warehouse...", "اختر المستودع...")" />
                        </div>
                    }
                    @if (NeedsCurrency)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Currency", "العملة")</label>
                            <AutoCompleteComponent TItem="CurrencyDto"
                                                   Items="currencies"
                                                   ItemText="CurrencyText"
                                                   Value="selectedCurrency"
                                                   ValueChanged="OnCurrencyChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select currency...", "اختر العملة...")" />
                        </div>
                    }
                    @if (ShowsPurchaseTemplatePlaceholder)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Purchase Template", "قالب الشراء")</label>
                            <AutoCompleteComponent TItem="ProcurementAgreementDto"
                                                   Items="purchaseTemplates"
                                                   ItemText="AgreementText"
                                                   Value="selectedPurchaseTemplate"
                                                   ValueChanged="OnPurchaseTemplateChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select purchase template...", "Select purchase template...")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Call for Tender", "Call for Tender")</label>
                            <AutoCompleteComponent TItem="ProcurementAgreementDto"
                                                   Items="tenders"
                                                   ItemText="AgreementText"
                                                   Value="selectedTender"
                                                   ValueChanged="OnTenderChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select tender...", "Select tender...")" />
                        </div>
                    }
                    @if (IsPurchaseOrder)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Blanket Order", "Blanket Order")</label>
                            <AutoCompleteComponent TItem="ProcurementAgreementDto"
                                                   Items="BlanketOrderOptions"
                                                   ItemText="AgreementText"
                                                   Value="selectedBlanketOrder"
                                                   ValueChanged="OnBlanketOrderChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select blanket order...", "Select blanket order...")" />
                        </div>
                    }
                    @if (ShowsPurchaseWorkflowControls)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Bill Control", "سياسة الفوترة")</label>
                            <InputSelect class="form-select" @bind-Value="document.BillControlPolicy">
                                @foreach (var policy in BillControlPolicies)
                                {
                                    <option value="@policy">@BillControlPolicyText(policy)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("3-Way Match", "مطابقة ثلاثية")</label>
                            <InputSelect class="form-select" @bind-Value="document.ThreeWayMatchStatus">
                                @foreach (var status in ThreeWayMatchStatuses)
                                {
                                    <option value="@status">@ThreeWayMatchStatusText(status)</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="document.IsBillable" />
                                <label class="form-check-label">@SharedDataService.SelectViewLang("Billable", "قابل للفوترة")</label>
                            </div>
                        </div>
                    }
                    @if (IsRequestForQuotation)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Related Purchase Request (optional)", "طلب الشراء المرتبط (اختياري)")</label>
                            <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                   Items="approvedPurchaseRequests"
                                                   ItemText="PurchaseRequestText"
                                                   Value="selectedSourcePurchaseRequest"
                                                   ValueChanged="OnSourcePurchaseRequestChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select approved purchase request, or leave blank...", "اختر طلب شراء معتمد أو اتركه فارغاً...")" />
                        </div>
                    }
                    else if (IsSupplierQuotation)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Related RFQ", "RFQ")</label>
                            <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                   Items="sentRfqs"
                                                   ItemText="RfqText"
                                                   Value="selectedSourceRfq"
                                                   ValueChanged="OnSourceRfqChanged"
                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select sent RFQ...", "Select sent RFQ...")" />
                        </div>
                    }
                    else if (IsPurchaseOrder)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Purchase Order Source", "مصدر أمر الشراء")</label>
                            <select class="form-select" value="@purchaseOrderSourceMode" @onchange="OnPurchaseOrderSourceModeChanged">
                                <option value="@PurchaseOrderSourceMode.SupplierQuotation">@SharedDataService.SelectViewLang("Supplier Quotation", "عرض سعر المورد")</option>
                                <option value="@PurchaseOrderSourceMode.PurchaseRequest">@SharedDataService.SelectViewLang("Purchase Request", "طلب الشراء")</option>
                            </select>
                        </div>
                        @if (purchaseOrderSourceMode == PurchaseOrderSourceMode.SupplierQuotation)
                        {
                            <div class="col-md-3">
                                <label class="form-label">@SharedDataService.SelectViewLang("Related Supplier Quotation", "عرض سعر المورد المرتبط")</label>
                                <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                       Items="acceptedSupplierQuotations"
                                                       ItemText="SupplierQuotationText"
                                                       Value="selectedSourceSupplierQuotation"
                                                       ValueChanged="OnSourceSupplierQuotationChanged"
                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select accepted supplier quotation...", "اختر عرض سعر مورد مقبول...")" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <label class="form-label">@SharedDataService.SelectViewLang("Related Purchase Request", "طلب الشراء المرتبط")</label>
                                <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                       Items="approvedPurchaseRequests"
                                                       ItemText="PurchaseRequestText"
                                                       Value="selectedSourcePurchaseRequest"
                                                       ValueChanged="OnSourcePurchaseRequestChanged"
                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select approved purchase request...", "اختر طلب شراء معتمد...")" />
                            </div>
                        }
                    }
                    else if (IsSupplierInvoice)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Invoice Source", "مصدر الفاتورة")</label>
                            <select class="form-select" value="@invoiceSourceMode" @onchange="OnInvoiceSourceModeChanged">
                                <option value="@InvoiceSourceMode.PurchaseOrder">@SharedDataService.SelectViewLang("Purchase Order", "أمر الشراء")</option>
                                <option value="@InvoiceSourceMode.GoodsReceipt">@SharedDataService.SelectViewLang("Goods Receipt", "استلام البضاعة")</option>
                                <option value="@InvoiceSourceMode.Standalone">@SharedDataService.SelectViewLang("Standalone", "مستقلة")</option>
                            </select>
                        </div>
                        @if (invoiceSourceMode == InvoiceSourceMode.PurchaseOrder)
                        {
                            <div class="col-md-3">
                                <label class="form-label">@SharedDataService.SelectViewLang("Related Purchase Order", "أمر الشراء المرتبط")</label>
                                <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                       Items="invoiceablePurchaseOrders"
                                                       ItemText="PurchaseOrderText"
                                                       Value="selectedInvoicePurchaseOrder"
                                                       ValueChanged="OnInvoicePurchaseOrderChanged"
                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select received purchase order...", "اختر أمر شراء مستلم...")" />
                            </div>
                        }
                        else if (invoiceSourceMode == InvoiceSourceMode.GoodsReceipt)
                        {
                            <div class="col-md-3">
                                <label class="form-label">@SharedDataService.SelectViewLang("Related Goods Receipt", "استلام البضاعة المرتبط")</label>
                                <AutoCompleteComponent TItem="ProcurementDocumentDto"
                                                       Items="invoiceableGoodsReceipts"
                                                       ItemText="GoodsReceiptText"
                                                       Value="selectedInvoiceGoodsReceipt"
                                                       ValueChanged="OnInvoiceGoodsReceiptChanged"
                                                       PlaceHolder="@SharedDataService.SelectViewLang("Select posted goods receipt...", "اختر استلام بضاعة مرحل...")" />
                            </div>
                        }
                        else
                        {
                            <div class="col-md-3">
                                <label class="form-label">@SharedDataService.SelectViewLang("Related Document", "المستند المرتبط")</label>
                                <input class="form-control" value="@SharedDataService.SelectViewLang("Standalone invoice", "فاتورة مستقلة")" readonly />
                            </div>
                        }
                    }
                    else if (!IsPurchaseRequest)
                    {
                        <div class="col-md-3">
                            <label class="form-label">@SharedDataService.SelectViewLang("Source Number", "رقم المصدر")</label>
                            <InputText class="form-control" @bind-Value="document.SourceDocumentNumber" />
                        </div>
                    }
                    <div class="col-md-6">
                        <label class="form-label">@SharedDataService.SelectViewLang("Notes", "ملاحظات")</label>
                        <InputText class="form-control" @bind-Value="document.Notes" />
                    </div>
                </div>
            </AppCard>

            <AppCard Title="@SharedDataService.SelectViewLang("Lines", "البنود")" CssClass="erp-form-section allow-overflow">
                <div class="erp-table-toolbar mb-3">
                    <div class="input-group erp-search-control">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control"
                               placeholder="@SharedDataService.SelectViewLang("Search lines...", "ابحث في البنود...")"
                               @bind="lineSearchText"
                               @bind:event="oninput" />
                    </div>
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="AddLine">
                        <i class="bi bi-plus-lg"></i>
                        @SharedDataService.SelectViewLang("Add line", "إضافة بند")
                    </button>
                </div>

                <div class="erp-table-wrap procurement-lines-table-wrap allow-overflow">
                    <table class="table erp-table procurement-lines-table mb-0">
                        <thead>
                            <tr>
                                <th>@SharedDataService.SelectViewLang("Line", "البند")</th>
                                <th>@SharedDataService.SelectViewLang("Product", "المنتج")</th>
                                <th>@SharedDataService.SelectViewLang("SKU", "SKU")</th>
                                <th>@SharedDataService.SelectViewLang("Package", "العبوة")</th>
                                <th>@PackageQuantityLabel</th>
                                <th>@QuantityLabel</th>
                                @if (ShowLineCommercialFields)
                                {
                                    <th>@UnitCostLabel</th>
                                    <th>@SharedDataService.SelectViewLang("Tax %", "الضريبة %")</th>
                                }
                                @if (ShowsLinePurchaseControls)
                                {
                                    <th>@SharedDataService.SelectViewLang("Bill Control", "سياسة الفوترة")</th>
                                    <th>@SharedDataService.SelectViewLang("3-Way Match", "مطابقة ثلاثية")</th>
                                    <th>@SharedDataService.SelectViewLang("Received", "المستلم")</th>
                                    <th>@SharedDataService.SelectViewLang("Billed", "المفوتر")</th>
                                }
                                @if (NeedsStockContext)
                                {
                                    <th>@SharedDataService.SelectViewLang("Batch", "الدفعة")</th>
                                }
                                <th>@SharedDataService.SelectViewLang("Notes", "ملاحظات")</th>
                                <th class="text-end">@SharedDataService.SelectViewLang("Actions", "الإجراءات")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (document.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="@LinesTableColumnCount">
                                        <EmptyState Icon="bi-list-ul"
                                                    Title="@SharedDataService.SelectViewLang("No lines added", "لا توجد بنود")"
                                                    Message="@SharedDataService.SelectViewLang("Add the first procurement line to continue.", "أضف أول بند مشتريات للمتابعة.")" />
                                    </td>
                                </tr>
                            }
                            else if (VisibleLines.Count == 0)
                            {
                                <tr>
                                    <td colspan="@LinesTableColumnCount">
                                        <EmptyState Icon="bi-search"
                                                    Title="@SharedDataService.SelectViewLang("No matching lines", "لا توجد بنود مطابقة")"
                                                    Message="@SharedDataService.SelectViewLang("Adjust the line search to see more rows.", "غيّر البحث لعرض بنود أكثر.")" />
                                    </td>
                                </tr>
                            }
                            @foreach (var line in VisibleLines)
                            {
                                <tr @key="line">
                                    <td class="procurement-line-index">
                                        <span class="fw-semibold">@LineDisplayNumber(line)</span>
                                        @if (line.IsSourceLine)
                                        {
                                            <StatusChip Text="@SharedDataService.SelectViewLang("Source", "مصدر")" Tone="info" />
                                        }
                                    </td>
                                    <td>
                                        @if (line.IsSourceLine)
                                        {
                                            <div class="procurement-readonly-field" title="@ProductDisplay(line)">@ProductDisplay(line)</div>
                                        }
                                        else
                                        {
                                            <AutoCompleteComponent TItem="ProductDto"
                                                                   Items="products"
                                                                   ItemText="ProductText"
                                                                   Value="line.SelectedProduct"
                                                                   ValueChanged="product => OnProductChanged(line, product)"
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select product...", "اختر المنتج...")" />
                                        }
                                    </td>
                                    <td>
                                        @if (line.IsSourceLine)
                                        {
                                            <div class="procurement-readonly-field" title="@SkuDisplay(line)">@SkuDisplay(line)</div>
                                        }
                                        else
                                        {
                                            <AutoCompleteComponent TItem="ProductSkuDto"
                                                                   Items="SkuOptions(line)"
                                                                   ItemText="SkuText"
                                                                   Value="line.SelectedSku"
                                                                   ValueChanged="sku => OnSkuChanged(line, sku)"
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select SKU...", "اختر SKU...")" />
                                        }
                                    </td>
                                    <td>
                                        @if (ShowPackageInputs(line))
                                        {
                                            <AutoCompleteComponent TItem="ProductPackageDto"
                                                                   Items="PackageOptions(line)"
                                                                   ItemText="PackageText"
                                                                   Value="line.SelectedPackage"
                                                                   ValueChanged="package => OnPackageChanged(line, package)"
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select package...", "اختر العبوة...")" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (ShowPackageInputs(line))
                                        {
                                            <InputNumber class="form-control procurement-line-number-input"
                                                         Value="line.PackageQuantity"
                                                         ValueChanged="(decimal value) => OnPackageQuantityChanged(line, value)"
                                                         ValueExpression="() => line.PackageQuantity" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (IsPackageQuantityControlled(line))
                                        {
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.Quantity" disabled />
                                        }
                                        else
                                        {
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.Quantity" />
                                        }
                                    </td>
                                    @if (ShowLineCommercialFields)
                                    {
                                        <td>
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.UnitCost" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.TaxRate" />
                                        </td>
                                    }
                                    @if (ShowsLinePurchaseControls)
                                    {
                                        <td>
                                            <select class="form-select procurement-line-control-select"
                                                    value="@(line.BillControlPolicy?.ToString() ?? string.Empty)"
                                                    @onchange="args => OnLineBillControlPolicyChanged(line, args)">
                                                <option value="">@SharedDataService.SelectViewLang("Document policy", "سياسة المستند")</option>
                                                @foreach (var policy in BillControlPolicies)
                                                {
                                                    <option value="@policy">@BillControlPolicyText(policy)</option>
                                                }
                                            </select>
                                        </td>
                                        <td>
                                            <InputSelect class="form-select procurement-line-control-select" @bind-Value="line.ThreeWayMatchStatus">
                                                @foreach (var status in ThreeWayMatchStatuses)
                                                {
                                                    <option value="@status">@ThreeWayMatchStatusText(status)</option>
                                                }
                                            </InputSelect>
                                        </td>
                                        <td>
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.ReceivedQuantity" />
                                        </td>
                                        <td>
                                            <InputNumber class="form-control procurement-line-number-input" @bind-Value="line.BilledQuantity" />
                                        </td>
                                    }
                                    @if (NeedsStockContext)
                                    {
                                        <td>
                                            <AutoCompleteComponent TItem="BatchDto"
                                                                   @key="line.BatchSelectorKey"
                                                                   Items="BatchOptions(line)"
                                                                   ItemText="BatchText"
                                                                   Value="line.SelectedBatch"
                                                                   ValueChanged="batch => OnBatchChanged(line, batch)"
                                                                   PlaceHolder="@SharedDataService.SelectViewLang("Select batch...", "اختر الدفعة...")" />
                                        </td>
                                    }
                                    <td>
                                        <InputText class="form-control procurement-line-notes-input" @bind-Value="line.Notes" />
                                    </td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm erp-row-action"
                                                title="@SharedDataService.SelectViewLang("Remove line", "حذف البند")"
                                                @onclick="() => RemoveLine(line)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                                @if (IsGoodsReceipt && line.HasReceiptProgressInfo)
                                {
                                    <tr class="procurement-line-helper-row">
                                        <td colspan="@LinesTableColumnCount">
                                            <div class="procurement-receipt-progress">
                                                <span class="fw-semibold">@SharedDataService.SelectViewLang("PO Receiving Progress", "تقدم استلام أمر الشراء")</span>
                                                <span>@ReceiptProgressText(line)</span>
                                            </div>
                                            @if (IsOverRemaining(line))
                                            {
                                                <div class="alert alert-warning py-2 mb-0 mt-2">
                                                    @SharedDataService.SelectViewLang("Receipt quantity is greater than the remaining purchase order quantity.", "كمية الاستلام أكبر من الكمية المتبقية في أمر الشراء.")
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </AppCard>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" @onclick="Cancel">@SharedDataService.SelectViewLang("Cancel", "إلغاء")</button>
                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                    <i class="bi bi-check2"></i>
                    @SharedDataService.SelectViewLang("Save", "حفظ")
                </button>
            </div>
        </EditForm>
    }
</div>

@if (isBatchModalOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" dir="@SharedDataService.PageDirection">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <EditForm Model="newBatch" OnValidSubmit="SaveNewBatchAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@SharedDataService.SelectViewLang("New Batch", "New Batch")</h5>
                        <button type="button" class="btn-close" aria-label="Close" @onclick="CloseBatchModal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">@SharedDataService.SelectViewLang("Product", "Product")</label>
                                <div class="form-control bg-light text-muted">@ProductDisplay(batchModalLine)</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@SharedDataService.SelectViewLang("SKU", "SKU")</label>
                                <div class="form-control bg-light text-muted">@SkuDisplay(batchModalLine)</div>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">@SharedDataService.SelectViewLang("Batch Number", "Batch Number")</label>
                                <InputText class="form-control" @bind-Value="newBatch.BatchNumber" />
                                <ValidationMessage For="() => newBatch.BatchNumber" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@SharedDataService.SelectViewLang("Manufacturing Date", "Manufacturing Date")</label>
                                <InputDate class="form-control" @bind-Value="newBatch.ManufacturingDate" />
                                <ValidationMessage For="() => newBatch.ManufacturingDate" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">@SharedDataService.SelectViewLang("Expiry Date", "Expiry Date")</label>
                                <InputDate class="form-control" @bind-Value="newBatch.ExpiryDate" />
                                <ValidationMessage For="() => newBatch.ExpiryDate" />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseBatchModal">
                            @SharedDataService.SelectViewLang("Cancel", "Cancel")
                        </button>
                        <button type="submit" class="btn btn-primary" disabled="@isSavingBatch">
                            <i class="bi bi-check2"></i>
                            @SharedDataService.SelectViewLang("Save", "Save")
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<style>
    .procurement-lines-table-wrap {
        overflow: visible;
    }

    .procurement-lines-table {
        min-width: 1180px;
    }

    .procurement-lines-table td {
        vertical-align: top;
    }

    .procurement-line-index {
        white-space: nowrap;
        width: 5.5rem;
    }

    .procurement-line-number-input {
        min-width: 6rem;
    }

    .procurement-line-control-select {
        min-width: 11rem;
    }

    .procurement-line-notes-input {
        min-width: 10rem;
    }

    .procurement-readonly-field {
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-default);
        color: var(--erp-text);
        min-height: var(--erp-control-height);
        min-width: 0;
        overflow: hidden;
        padding: .45rem .75rem;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .procurement-line-helper-row td {
        background: var(--erp-surface-muted);
    }

    .procurement-receipt-progress {
        align-items: center;
        background: var(--erp-bg-subtle);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-default);
        color: var(--erp-text-muted);
        display: flex;
        flex-wrap: wrap;
        gap: var(--erp-space-2);
        padding: .6rem .75rem;
    }
</style>

@code {
    [Parameter] public string? KindRoute { get; set; }
    [Parameter] public Guid? Id { get; set; }

    private static readonly Guid CreateBatchOptionId = Guid.Parse("00000000-0000-0000-0000-000000000001");

    private ProcurementDocumentKind kind;
    private (string En, string Ar, string Icon, string Permission) Meta;
    private EditableProcurementDocument document = new();
    private readonly List<SupplierDto> suppliers = [];
    private readonly List<ProductDto> products = [];
    private readonly List<ProductSkuDto> allSkus = [];
    private readonly List<WarehouseDto> warehouses = [];
    private readonly List<BranchDto> branches = [];
    private readonly List<BatchDto> batches = [];
    private readonly List<CurrencyDto> currencies = [];
    private readonly List<ProcurementDocumentDto> approvedPurchaseRequests = [];
    private readonly List<ProcurementDocumentDto> sentRfqs = [];
    private readonly List<ProcurementDocumentDto> acceptedSupplierQuotations = [];
    private readonly List<ProcurementDocumentDto> receivablePurchaseOrders = [];
    private readonly List<ProcurementDocumentDto> invoiceablePurchaseOrders = [];
    private readonly List<ProcurementDocumentDto> invoiceableGoodsReceipts = [];
    private readonly List<ProcurementDocumentDto> postedGoodsReceipts = [];
    private readonly List<ProcurementDocumentDto> supplierInvoices = [];
    private readonly List<ProcurementAgreementDto> purchaseTemplates = [];
    private readonly List<ProcurementAgreementDto> blanketOrders = [];
    private readonly List<ProcurementAgreementDto> tenders = [];
    private SupplierDto? selectedSupplier;
    private WarehouseDto? selectedWarehouse;
    private CurrencyDto? selectedCurrency;
    private ProcurementAgreementDto? selectedPurchaseTemplate;
    private ProcurementAgreementDto? selectedBlanketOrder;
    private ProcurementAgreementDto? selectedTender;
    private ProcurementDocumentDto? selectedSourcePurchaseRequest;
    private ProcurementDocumentDto? selectedSourceRfq;
    private ProcurementDocumentDto? selectedSourceSupplierQuotation;
    private ProcurementDocumentDto? selectedSourcePurchaseOrder;
    private ProcurementDocumentDto? selectedInvoicePurchaseOrder;
    private ProcurementDocumentDto? selectedInvoiceGoodsReceipt;
    private PurchaseOrderSourceMode purchaseOrderSourceMode = PurchaseOrderSourceMode.SupplierQuotation;
    private InvoiceSourceMode invoiceSourceMode = InvoiceSourceMode.PurchaseOrder;
    private string? lineSearchText;
    private Guid companyId;
    private CurrentUserBranchAccessDto branchAccess = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool isBatchModalOpen;
    private bool isSavingBatch;
    private EditableProcurementLine? batchModalLine;
    private CreateBatchDto newBatch = NewBatchModel();

    private bool IsRequestForQuotation => kind == ProcurementDocumentKind.RequestForQuotation;
    private bool IsPurchaseRequest => kind == ProcurementDocumentKind.PurchaseRequest;
    private bool IsSupplierQuotation => kind == ProcurementDocumentKind.SupplierQuotation;
    private bool IsPurchaseOrder => kind == ProcurementDocumentKind.PurchaseOrder;
    private bool IsGoodsReceipt => kind == ProcurementDocumentKind.GoodsReceipt;
    private bool IsSupplierInvoice => kind == ProcurementDocumentKind.SupplierInvoice;
    private bool IsNonCommercialRequestDocument => IsPurchaseRequest || IsRequestForQuotation;
    private bool ShowLineCommercialFields => !IsNonCommercialRequestDocument;
    private bool IsSystemNumberedDocument => IsPurchaseRequest || IsRequestForQuotation || IsSupplierQuotation || IsPurchaseOrder || IsGoodsReceipt || IsSupplierInvoice;
    private bool HideDocumentNumberField => IsSystemNumberedDocument && !Id.HasValue;
    private bool NeedsStockContext => kind is ProcurementDocumentKind.GoodsReceipt or ProcurementDocumentKind.PurchaseReturn;
    private bool NeedsCurrency => kind is ProcurementDocumentKind.SupplierQuotation or ProcurementDocumentKind.PurchaseOrder or ProcurementDocumentKind.GoodsReceipt or ProcurementDocumentKind.PurchaseReturn or ProcurementDocumentKind.SupplierInvoice;
    private bool ShowsPurchaseTemplatePlaceholder => kind is ProcurementDocumentKind.RequestForQuotation or ProcurementDocumentKind.PurchaseOrder;
    private bool ShowsPurchaseWorkflowControls => kind is ProcurementDocumentKind.PurchaseOrder or ProcurementDocumentKind.GoodsReceipt or ProcurementDocumentKind.SupplierInvoice;
    private bool ShowsLinePurchaseControls => ShowsPurchaseWorkflowControls;
    private int LinesTableColumnCount => 8 + (ShowLineCommercialFields ? 2 : 0) + (ShowsLinePurchaseControls ? 4 : 0) + (NeedsStockContext ? 1 : 0);
    private static readonly PurchaseBillControlPolicy[] BillControlPolicies = Enum.GetValues<PurchaseBillControlPolicy>();
    private static readonly ThreeWayMatchStatus[] ThreeWayMatchStatuses = Enum.GetValues<ThreeWayMatchStatus>();
    private List<EditableProcurementLine> VisibleLines => string.IsNullOrWhiteSpace(lineSearchText)
        ? document.Lines
        : document.Lines.Where(LineMatchesSearch).ToList();
    private string QuantityLabel => kind switch
    {
        ProcurementDocumentKind.GoodsReceipt => SharedDataService.SelectViewLang("Received Quantity", "Received Quantity"),
        ProcurementDocumentKind.SupplierInvoice => SharedDataService.SelectViewLang("Invoice Quantity", "Invoice Quantity"),
        _ => SharedDataService.SelectViewLang("Qty", "Qty")
    };
    private string PackageQuantityLabel => kind switch
    {
        ProcurementDocumentKind.GoodsReceipt => SharedDataService.SelectViewLang("Received Package Qty", "Received Package Qty"),
        ProcurementDocumentKind.SupplierInvoice => SharedDataService.SelectViewLang("Invoice Package Qty", "Invoice Package Qty"),
        _ => SharedDataService.SelectViewLang("Package Qty", "Package Qty")
    };
    private string TotalSkuQuantityLabel => kind switch
    {
        ProcurementDocumentKind.GoodsReceipt => SharedDataService.SelectViewLang("Total Received SKU Qty", "Total Received SKU Qty"),
        ProcurementDocumentKind.SupplierInvoice => SharedDataService.SelectViewLang("Total Invoice SKU Qty", "Total Invoice SKU Qty"),
        _ => SharedDataService.SelectViewLang("Total SKU Qty", "Total SKU Qty")
    };
    private string UnitCostLabel => kind switch
    {
        ProcurementDocumentKind.SupplierQuotation => SharedDataService.SelectViewLang("Quoted Unit Cost", "Quoted Unit Cost"),
        ProcurementDocumentKind.PurchaseOrder => SharedDataService.SelectViewLang("Purchase Unit Cost", "Purchase Unit Cost"),
        ProcurementDocumentKind.GoodsReceipt => SharedDataService.SelectViewLang("Received Unit Cost", "Received Unit Cost"),
        ProcurementDocumentKind.SupplierInvoice => SharedDataService.SelectViewLang("Invoice Unit Cost", "Invoice Unit Cost"),
        _ => SharedDataService.SelectViewLang("Cost", "التكلفة")
    };
    private string DocumentNumberLabel => kind switch
    {
        ProcurementDocumentKind.PurchaseRequest => SharedDataService.SelectViewLang("Purchase Request Number", "رقم طلب الشراء"),
        ProcurementDocumentKind.PurchaseOrder => SharedDataService.SelectViewLang("Purchase Order Number", "Purchase Order Number"),
        ProcurementDocumentKind.GoodsReceipt => SharedDataService.SelectViewLang("Goods Receipt Number", "Goods Receipt Number"),
        ProcurementDocumentKind.SupplierInvoice => SharedDataService.SelectViewLang("Supplier Invoice Number", "Supplier Invoice Number"),
        _ => SharedDataService.SelectViewLang("Number", "الرقم")
    };
    private List<WarehouseDto> WarehouseOptions => warehouses
        .Where(WarehouseMatchesDocumentBranch)
        .ToList();
    private List<ProcurementAgreementDto> BlanketOrderOptions => blanketOrders
        .Where(x => !x.SupplierId.HasValue || !document.SupplierId.HasValue || x.SupplierId == document.SupplierId)
        .ToList();

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        kind = ProcurementUiText.ParseKind(KindRoute);
        Meta = ProcurementUiText.Meta(kind);
        document.Kind = kind;
        document.DocumentDate = DateTime.UtcNow;
        if (HideDocumentNumberField)
            document.Number = "AUTO";

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var companyClaim = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
        Guid.TryParse(companyClaim, out companyId);
        document.CompanyId = companyId;

        await LoadLookupsAsync();

        if (Id.HasValue)
        {
            var response = await ProcurementService.GetByIdAsync(kind, Id.Value);
            if (response.IsSuccess && response.Data is not null)
            {
                LoadDocument(response.Data);
                if (!ProcurementUiText.CanEditDocument(kind, document.Status))
                {
                    ToastService.ShowWarning(ProcurementUiText.LockedEditReason(kind, document.Status, SharedDataService));
                    NavigationManager.NavigateTo($"/Procurement/{ProcurementUiText.Route(kind)}/Detail/{Id.Value}");
                    return;
                }
            }
            else
                ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? SharedDataService.SelectViewLang("Could not load document.", "تعذر تحميل المستند."));
        }
        else if (document.Lines.Count == 0)
        {
            AddLine();
        }

        ApplySelectionsFromDocument();
        isLoading = false;
    }

    private async Task LoadLookupsAsync()
    {
        suppliers.Clear();
        products.Clear();
        allSkus.Clear();
        warehouses.Clear();
        branches.Clear();
        batches.Clear();
        currencies.Clear();
        approvedPurchaseRequests.Clear();
        sentRfqs.Clear();
        acceptedSupplierQuotations.Clear();
        receivablePurchaseOrders.Clear();
        invoiceablePurchaseOrders.Clear();
        invoiceableGoodsReceipts.Clear();
        postedGoodsReceipts.Clear();
        supplierInvoices.Clear();
        purchaseTemplates.Clear();
        blanketOrders.Clear();
        tenders.Clear();

        if (companyId == Guid.Empty)
            return;

        await LoadBranchAccessAsync();

        var supplierResponse = await SupplierService.GetByCompanyAsync(companyId, 0, 200);
        if (supplierResponse.IsSuccess)
            suppliers.AddRange(supplierResponse.Data?.Data ?? []);

        var productResponse = await ProductService.GetByCompanyAsync(companyId, 0, 200);
        if (productResponse.IsSuccess)
        {
            products.AddRange(productResponse.Data?.Data ?? []);
            allSkus.AddRange(products.SelectMany(x => x.Skus ?? []));
        }

        var warehouseResponse = await WarehouseService.GetAsync(companyId, 0, 10000);
        if (warehouseResponse.IsSuccess)
        {
            var loadedWarehouses = warehouseResponse.Data?.Data?.ToList() ?? [];
            warehouses.AddRange(branchAccess.CanViewAllBranches
                ? loadedWarehouses
                : loadedWarehouses.Where(warehouse => warehouse.BranchId == null || (warehouse.BranchId.HasValue && branchAccess.BranchIds.Contains(warehouse.BranchId.Value))));
        }

        var batchResponse = await BatchService.GetAsync(companyId, 0, 10000);
        if (batchResponse.IsSuccess)
            batches.AddRange(batchResponse.Data?.Data ?? []);

        var currencyResponse = await CurrencyService.GetAsync(companyId, 0, 200);
        if (currencyResponse.IsSuccess)
            currencies.AddRange(currencyResponse.Data?.Data ?? []);

        if (IsRequestForQuotation || IsPurchaseOrder)
        {
            var templateResponse = await ProcurementService.GetPurchaseAgreementsAsync(companyId, ProcurementAgreementType.PurchaseTemplate);
            if (templateResponse.IsSuccess)
                purchaseTemplates.AddRange((templateResponse.Data ?? []).Where(IsUsableAgreement));

            var tenderResponse = await ProcurementService.GetPurchaseAgreementsAsync(companyId, ProcurementAgreementType.CallForTender);
            if (tenderResponse.IsSuccess)
                tenders.AddRange((tenderResponse.Data ?? []).Where(IsUsableAgreement));
        }

        if (IsPurchaseOrder)
        {
            var blanketResponse = await ProcurementService.GetPurchaseAgreementsAsync(companyId, ProcurementAgreementType.BlanketOrder);
            if (blanketResponse.IsSuccess)
                blanketOrders.AddRange((blanketResponse.Data ?? []).Where(IsUsableAgreement));
        }

        if (IsGoodsReceipt || IsSupplierInvoice)
        {
            var goodsReceiptResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.GoodsReceipt, companyId, 1, 200, null);
            if (goodsReceiptResponse.IsSuccess)
            {
                postedGoodsReceipts.AddRange((goodsReceiptResponse.Data?.Data ?? [])
                    .Where(IsPostedGoodsReceipt));
            }
        }

        if (IsSupplierInvoice)
        {
            var supplierInvoiceResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.SupplierInvoice, companyId, 1, 200, null);
            if (supplierInvoiceResponse.IsSuccess)
            {
                supplierInvoices.AddRange((supplierInvoiceResponse.Data?.Data ?? [])
                    .Where(invoice => !string.Equals(invoice.Status, SupplierInvoiceStatus.Cancelled.ToString(), StringComparison.OrdinalIgnoreCase)));
            }

            invoiceableGoodsReceipts.AddRange(postedGoodsReceipts.Where(IsInvoiceableGoodsReceipt));
        }

        if (IsRequestForQuotation || IsPurchaseOrder)
        {
            var purchaseRequestResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.PurchaseRequest, companyId, 1, 200, null);
            if (purchaseRequestResponse.IsSuccess)
            {
                Func<ProcurementDocumentDto, bool> purchaseRequestFilter = IsPurchaseOrder
                    ? IsPurchaseOrderSourcePurchaseRequest
                    : IsApprovedPurchaseRequest;
                approvedPurchaseRequests.AddRange((purchaseRequestResponse.Data?.Data ?? [])
                    .Where(purchaseRequestFilter));
            }
        }

        if (IsSupplierQuotation)
        {
            var rfqResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.RequestForQuotation, companyId, 1, 200, null);
            if (rfqResponse.IsSuccess)
            {
                sentRfqs.AddRange((rfqResponse.Data?.Data ?? [])
                    .Where(IsSentRfq));
            }
        }

        if (IsPurchaseOrder)
        {
            var supplierQuotationResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.SupplierQuotation, companyId, 1, 200, null);
            if (supplierQuotationResponse.IsSuccess)
            {
                acceptedSupplierQuotations.AddRange((supplierQuotationResponse.Data?.Data ?? [])
                    .Where(IsAcceptedSupplierQuotation));
            }
        }

        if (IsGoodsReceipt)
        {
            var purchaseOrderResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.PurchaseOrder, companyId, 1, 200, null);
            if (purchaseOrderResponse.IsSuccess)
            {
                receivablePurchaseOrders.AddRange((purchaseOrderResponse.Data?.Data ?? [])
                    .Where(IsReceivablePurchaseOrder));
            }
        }

        if (IsSupplierInvoice)
        {
            var purchaseOrderResponse = await ProcurementService.GetAsync(ProcurementDocumentKind.PurchaseOrder, companyId, 1, 200, null);
            if (purchaseOrderResponse.IsSuccess)
            {
                invoiceablePurchaseOrders.AddRange((purchaseOrderResponse.Data?.Data ?? [])
                    .Where(IsInvoiceablePurchaseOrder));
            }
        }
    }

    private async Task SaveAsync()
    {
        if (!ValidateWarehouseBranch())
            return;

        isSaving = true;
        var dto = ToDto();
        bool success;
        string? errorMessage = null;

        if (Id.HasValue)
        {
            var response = await ProcurementService.UpdateAsync(dto);
            success = response.IsSuccess;
            errorMessage = response.Error?.GetDisplayMessage(SharedDataService.Language);
        }
        else
        {
            var response = await ProcurementService.CreateAsync(dto);
            success = response.IsSuccess;
            errorMessage = response.Error?.GetDisplayMessage(SharedDataService.Language);
        }

        if (success)
        {
            ToastService.ShowSuccess(SharedDataService.SelectViewLang("Document saved.", "تم حفظ المستند."));
            NavigationManager.NavigateTo($"/Procurement/{ProcurementUiText.Route(kind)}");
        }
        else
        {
            ToastService.ShowError(errorMessage ?? SharedDataService.SelectViewLang("Could not save document.", "تعذر حفظ المستند."));
        }

        isSaving = false;
    }

    private ProcurementDocumentDto ToDto()
    {
        if (IsPurchaseRequest)
        {
            selectedSupplier = null;
            document.SupplierId = null;
            document.SupplierName = null;
        }
        else
        {
            document.SupplierId = selectedSupplier?.Id;
            document.SupplierName = selectedSupplier?.Name ?? document.SupplierName;
        }
        document.WarehouseId = selectedWarehouse?.Id;
        document.CurrencyId = selectedCurrency?.Id;
        document.CompanyId = companyId;

        var lineNumber = 1;
        foreach (var line in document.Lines)
        {
            line.LineNumber = lineNumber++;
            line.ProductId = line.SelectedProduct?.Id ?? line.ProductId;
            line.ProductSkuId = line.SelectedSku?.Id ?? line.ProductSkuId;
            line.ProductPackageId = line.SelectedPackage?.Id ?? line.ProductPackageId;
            if (line.SelectedPackage is not null)
                ApplyPackageQuantity(line);
            line.ProductName = line.SelectedProduct?.Name ?? line.ProductName;
            line.ProductNameEng = line.SelectedProduct?.NameEng ?? line.ProductNameEng;
            line.SkuCode = SkuNameSnapshot(line.SelectedSku, line.SkuCode);
            line.BatchId = line.SelectedBatch?.Id ?? line.BatchId;
            line.WarehouseId = selectedWarehouse?.Id ?? line.WarehouseId;
        }

        return new ProcurementDocumentDto
        {
            Id = document.Id,
            Kind = document.Kind,
            Number = document.Number,
            Status = document.Status,
            DocumentDate = document.DocumentDate,
            CompanyId = document.CompanyId,
            BranchId = document.BranchId,
            DepartmentId = document.DepartmentId,
            SupplierId = document.SupplierId,
            SupplierName = document.SupplierName,
            WarehouseId = document.WarehouseId,
            CurrencyId = document.CurrencyId,
            SourceDocumentId = document.SourceDocumentId,
            SourceDocumentNumber = document.SourceDocumentNumber,
            SentAt = document.SentAt,
            SentBy = document.SentBy,
            PurchaseTemplateId = document.PurchaseTemplateId,
            BlanketOrderId = document.BlanketOrderId,
            TenderId = document.TenderId,
            BillControlPolicy = document.BillControlPolicy,
            ThreeWayMatchStatus = document.ThreeWayMatchStatus,
            IsBillable = document.IsBillable,
            Notes = document.Notes,
            Lines = document.Lines.Select(line => new ProcurementDocumentLineDto
            {
                Id = line.Id,
                LineNumber = line.LineNumber,
                ProductId = line.ProductId,
                ProductSkuId = line.ProductSkuId,
                ProductPackageId = line.ProductPackageId,
                ProductName = line.ProductName,
                ProductNameEng = line.ProductNameEng,
                SkuCode = line.SkuCode,
                UnitOfMeasureId = line.UnitOfMeasureId,
                WarehouseId = line.WarehouseId,
                BatchId = line.BatchId,
                BillControlPolicy = line.BillControlPolicy,
                ThreeWayMatchStatus = line.ThreeWayMatchStatus,
                ReceivedQuantity = line.ReceivedQuantity,
                BilledQuantity = line.BilledQuantity,
                Quantity = line.Quantity,
                UnitCost = IsNonCommercialRequestDocument ? 0 : line.UnitCost,
                DiscountRate = IsNonCommercialRequestDocument ? 0 : line.DiscountRate,
                TaxRate = IsNonCommercialRequestDocument ? 0 : line.TaxRate,
                Notes = line.Notes
            }).ToList()
        };
    }

    private void LoadDocument(ProcurementDocumentDto dto)
    {
        document = new EditableProcurementDocument(dto);
        document.CompanyId = companyId == Guid.Empty ? dto.CompanyId : companyId;
        foreach (var line in document.Lines)
            line.IsSourceLine = dto.SourceDocumentId.HasValue;
    }

    private void ApplySelectionsFromDocument()
    {
        selectedSupplier = suppliers.FirstOrDefault(x => x.Id == document.SupplierId);
        selectedWarehouse = WarehouseOptions.FirstOrDefault(x => x.Id == document.WarehouseId);
        selectedCurrency = currencies.FirstOrDefault(x => x.Id == document.CurrencyId) ?? currencies.FirstOrDefault(x => x.IsDefault);
        selectedSourcePurchaseRequest = approvedPurchaseRequests.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? approvedPurchaseRequests.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedSourceRfq = sentRfqs.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? sentRfqs.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedSourceSupplierQuotation = acceptedSupplierQuotations.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? acceptedSupplierQuotations.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedSourcePurchaseOrder = receivablePurchaseOrders.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? receivablePurchaseOrders.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedInvoicePurchaseOrder = invoiceablePurchaseOrders.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? invoiceablePurchaseOrders.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedInvoiceGoodsReceipt = invoiceableGoodsReceipts.FirstOrDefault(x => x.Id == document.SourceDocumentId)
            ?? invoiceableGoodsReceipts.FirstOrDefault(x => string.Equals(x.Number, document.SourceDocumentNumber, StringComparison.OrdinalIgnoreCase));
        selectedPurchaseTemplate = purchaseTemplates.FirstOrDefault(x => x.Id == document.PurchaseTemplateId);
        selectedBlanketOrder = blanketOrders.FirstOrDefault(x => x.Id == document.BlanketOrderId);
        selectedTender = tenders.FirstOrDefault(x => x.Id == document.TenderId);

        if (IsPurchaseOrder)
        {
            purchaseOrderSourceMode = selectedSourcePurchaseRequest is not null
                ? PurchaseOrderSourceMode.PurchaseRequest
                : PurchaseOrderSourceMode.SupplierQuotation;
        }

        if (IsSupplierInvoice)
        {
            if (selectedInvoiceGoodsReceipt is not null)
                invoiceSourceMode = InvoiceSourceMode.GoodsReceipt;
            else if (selectedInvoicePurchaseOrder is not null)
                invoiceSourceMode = InvoiceSourceMode.PurchaseOrder;
            else if (document.SourceDocumentId.HasValue || !string.IsNullOrWhiteSpace(document.SourceDocumentNumber))
                invoiceSourceMode = LooksLikeGoodsReceiptNumber(document.SourceDocumentNumber) ? InvoiceSourceMode.GoodsReceipt : InvoiceSourceMode.PurchaseOrder;
            else
                invoiceSourceMode = InvoiceSourceMode.PurchaseOrder;
        }

        if (selectedCurrency is not null && document.CurrencyId is null)
            document.CurrencyId = selectedCurrency.Id;

        ApplyLineLookupSelections();
    }

    private void ApplyLineLookupSelections()
    {
        foreach (var line in document.Lines)
        {
            line.SelectedProduct = products.FirstOrDefault(x => x.Id == line.ProductId);
            line.SelectedSku = allSkus.FirstOrDefault(x => x.Id == line.ProductSkuId);
            line.SelectedPackage = PackageOptions(line).FirstOrDefault(x => x.Id == line.ProductPackageId);
            if (line.SelectedPackage is not null && line.SelectedPackage.Quantity > 0)
                line.PackageQuantity = line.Quantity / line.SelectedPackage.Quantity;
            line.SelectedBatch = batches.FirstOrDefault(x => x.Id == line.BatchId);
        }
    }

