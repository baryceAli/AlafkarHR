                $"Received {line.OrderedQuantity:N2}, already invoiced {line.PreviouslyReceivedQuantity:N2}, invoiceable {line.RemainingQuantity:N2}")
            : SharedDataService.SelectViewLang(
                $"Ordered {line.OrderedQuantity:N2}, received {line.PreviouslyReceivedQuantity:N2}, remaining {line.RemainingQuantity:N2}",
                $"Ordered {line.OrderedQuantity:N2}, received {line.PreviouslyReceivedQuantity:N2}, remaining {line.RemainingQuantity:N2}");

    private bool IsOverRemaining(EditableProcurementLine line) =>
        line.HasReceiptProgressInfo && line.RemainingQuantity > 0 && line.Quantity > line.RemainingQuantity;

    private decimal ReceivedQuantityForPurchaseOrderLine(Guid purchaseOrderId, ProcurementDocumentLineDto purchaseOrderLine) =>
        postedGoodsReceipts
            .Where(receipt => receipt.SourceDocumentId == purchaseOrderId)
            .SelectMany(receipt => receipt.Lines)
            .Where(line => line.ProductSkuId == purchaseOrderLine.ProductSkuId)
            .Sum(line => line.Quantity);

    private HashSet<Guid> InvoiceSourceIdsForPurchaseOrder(Guid purchaseOrderId)
    {
        var sourceIds = new HashSet<Guid> { purchaseOrderId };
        foreach (var receiptId in postedGoodsReceipts
            .Where(receipt => receipt.SourceDocumentId == purchaseOrderId)
            .Select(receipt => receipt.Id))
        {
            sourceIds.Add(receiptId);
        }

        return sourceIds;
    }

    private static HashSet<Guid> InvoiceSourceIdsForGoodsReceipt(ProcurementDocumentDto goodsReceipt)
    {
        var sourceIds = new HashSet<Guid> { goodsReceipt.Id };
        if (goodsReceipt.SourceDocumentId.HasValue)
            sourceIds.Add(goodsReceipt.SourceDocumentId.Value);

        return sourceIds;
    }

    private decimal InvoicedQuantityForSku(HashSet<Guid> sourceIds, Guid productSkuId) =>
        supplierInvoices
            .Where(invoice => invoice.Id != document.Id
                && invoice.SourceDocumentId.HasValue
                && sourceIds.Contains(invoice.SourceDocumentId.Value)
                && !string.Equals(invoice.Status, SupplierInvoiceStatus.Cancelled.ToString(), StringComparison.OrdinalIgnoreCase))
            .SelectMany(invoice => invoice.Lines)
            .Where(line => line.ProductSkuId == productSkuId)
            .Sum(line => line.Quantity);

    private static bool IsApprovedPurchaseRequest(ProcurementDocumentDto purchaseRequest) =>
        string.Equals(purchaseRequest.Status, PurchaseRequestStatus.Approved.ToString(), StringComparison.OrdinalIgnoreCase);
    private static bool IsPurchaseOrderSourcePurchaseRequest(ProcurementDocumentDto purchaseRequest) =>
        string.Equals(purchaseRequest.Status, PurchaseRequestStatus.Approved.ToString(), StringComparison.OrdinalIgnoreCase)
        || string.Equals(purchaseRequest.Status, PurchaseRequestStatus.Converted.ToString(), StringComparison.OrdinalIgnoreCase);
    private static bool IsSentRfq(ProcurementDocumentDto rfq) =>
        string.Equals(rfq.Status, RequestForQuotationStatus.Sent.ToString(), StringComparison.OrdinalIgnoreCase);
    private static bool IsAcceptedSupplierQuotation(ProcurementDocumentDto supplierQuotation) =>
        string.Equals(supplierQuotation.Status, SupplierQuotationStatus.Accepted.ToString(), StringComparison.OrdinalIgnoreCase);
    private static bool IsReceivablePurchaseOrder(ProcurementDocumentDto purchaseOrder) =>
        string.Equals(purchaseOrder.Status, PurchaseOrderStatus.Sent.ToString(), StringComparison.OrdinalIgnoreCase)
        || string.Equals(purchaseOrder.Status, PurchaseOrderStatus.PartiallyReceived.ToString(), StringComparison.OrdinalIgnoreCase);
    private bool IsInvoiceablePurchaseOrder(ProcurementDocumentDto purchaseOrder) =>
        (string.Equals(purchaseOrder.Status, PurchaseOrderStatus.PartiallyReceived.ToString(), StringComparison.OrdinalIgnoreCase)
            || string.Equals(purchaseOrder.Status, PurchaseOrderStatus.Received.ToString(), StringComparison.OrdinalIgnoreCase)
            || string.Equals(purchaseOrder.Status, PurchaseOrderStatus.Closed.ToString(), StringComparison.OrdinalIgnoreCase))
        && purchaseOrder.Lines.Any(line => InvoiceableQuantityForPurchaseOrderLine(purchaseOrder.Id, line) > 0);
    private static bool IsPostedGoodsReceipt(ProcurementDocumentDto goodsReceipt) =>
        string.Equals(goodsReceipt.Status, PostedDocumentStatus.Posted.ToString(), StringComparison.OrdinalIgnoreCase);
    private bool IsInvoiceableGoodsReceipt(ProcurementDocumentDto goodsReceipt) =>
        IsPostedGoodsReceipt(goodsReceipt)
        && goodsReceipt.Lines.Any(line => InvoiceableQuantityForGoodsReceiptLine(goodsReceipt, line) > 0);
    private static bool IsUsableAgreement(ProcurementAgreementDto agreement) =>
        agreement.Status is not (ProcurementAgreementStatus.Closed or ProcurementAgreementStatus.Cancelled);

    private decimal InvoiceableQuantityForPurchaseOrderLine(Guid purchaseOrderId, ProcurementDocumentLineDto line)
    {
        var received = ReceivedQuantityForPurchaseOrderLine(purchaseOrderId, line);
        var alreadyInvoiced = InvoicedQuantityForSku(InvoiceSourceIdsForPurchaseOrder(purchaseOrderId), line.ProductSkuId);
        return Math.Max(received - alreadyInvoiced, 0);
    }

    private decimal InvoiceableQuantityForGoodsReceiptLine(ProcurementDocumentDto goodsReceipt, ProcurementDocumentLineDto line)
    {
        var alreadyInvoiced = InvoicedQuantityForSku(InvoiceSourceIdsForGoodsReceipt(goodsReceipt), line.ProductSkuId);
        return Math.Max(line.Quantity - alreadyInvoiced, 0);
    }

    private static bool LooksLikeGoodsReceiptNumber(string? number) =>
        !string.IsNullOrWhiteSpace(number)
        && number.StartsWith("GR-", StringComparison.OrdinalIgnoreCase);

    private bool CanCreateBatch(EditableProcurementLine line) =>
        NeedsStockContext && line.ProductId != Guid.Empty && line.ProductSkuId != Guid.Empty;

    private BatchDto CreateBatchOption() =>
        new()
        {
            Id = CreateBatchOptionId,
            BatchNumber = SharedDataService.SelectViewLang("+ Create new batch", "+ إنشاء دفعة جديدة")
        };

    private static bool IsCreateBatchOption(BatchDto? batch) =>
        batch?.Id == CreateBatchOptionId;

    private void OpenBatchModal(EditableProcurementLine line)
    {
        if (!CanCreateBatch(line))
            return;

        batchModalLine = line;
        newBatch = NewBatchModel();
        newBatch.CompanyId = companyId;
        newBatch.ProductId = line.ProductId;
        newBatch.ProductSkuId = line.ProductSkuId;
        isBatchModalOpen = true;
    }

    private void CloseBatchModal()
    {
        isBatchModalOpen = false;
        isSavingBatch = false;
        batchModalLine = null;
        newBatch = NewBatchModel();
    }

    private async Task SaveNewBatchAsync()
    {
        if (batchModalLine is null || !CanCreateBatch(batchModalLine))
            return;

        isSavingBatch = true;
        newBatch.CompanyId = companyId;
        newBatch.ProductId = batchModalLine.ProductId;
        newBatch.ProductSkuId = batchModalLine.ProductSkuId;

        var response = await BatchService.CreateAsync(newBatch);
        if (!response.IsSuccess || response.Data is null)
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language)
                ?? SharedDataService.SelectViewLang("Could not create batch.", "Could not create batch."));
            isSavingBatch = false;
            return;
        }

        var createdBatch = await ResolveCreatedBatchAsync(response.Data.Id, batchModalLine, newBatch);
        batches.RemoveAll(x => x.Id == createdBatch.Id);
        batches.Add(createdBatch);
        await OnBatchChanged(batchModalLine, createdBatch);

        ToastService.ShowSuccess(SharedDataService.SelectViewLang("Batch created.", "Batch created."));
        CloseBatchModal();
    }

    private async Task<BatchDto> ResolveCreatedBatchAsync(Guid batchId, EditableProcurementLine line, CreateBatchDto created)
    {
        var response = await BatchService.GetByIdAsync(batchId);
        if (response.IsSuccess && response.Data is not null)
            return response.Data;

        return new BatchDto
        {
            Id = batchId,
            ProductId = created.ProductId,
            ProductSkuId = created.ProductSkuId,
            ProductName = line.ProductName,
            ProductNameEng = line.ProductNameEng,
            SkuName = line.SelectedSku?.Name ?? line.SkuCode,
            SkuNameEng = line.SelectedSku?.NameEng ?? line.SkuCode,
            BatchNumber = created.BatchNumber,
            ManufacturingDate = created.ManufacturingDate,
            ExpiryDate = created.ExpiryDate,
            CompanyId = created.CompanyId
        };
    }

    private static CreateBatchDto NewBatchModel() =>
        new()
        {
            ManufacturingDate = DateTime.Today,
            ExpiryDate = DateTime.Today.AddDays(1)
        };

    private void ApplyAgreementDefaults(ProcurementAgreementDto agreement, bool replaceLines)
    {
        if (agreement.SupplierId.HasValue)
        {
            selectedSupplier = suppliers.FirstOrDefault(x => x.Id == agreement.SupplierId.Value);
            document.SupplierId = agreement.SupplierId;
            document.SupplierName = agreement.SupplierName ?? selectedSupplier?.Name;
        }

        if (agreement.CurrencyId.HasValue)
        {
            selectedCurrency = currencies.FirstOrDefault(x => x.Id == agreement.CurrencyId.Value);
            document.CurrencyId = agreement.CurrencyId;
        }

        if (agreement.BranchId.HasValue)
            document.BranchId = agreement.BranchId;

        if (!replaceLines || agreement.Lines.Count == 0)
            return;

        document.Lines = agreement.Lines.Select(line =>
        {
            var editableLine = new EditableProcurementLine
            {
                ProductId = line.ProductId,
                ProductSkuId = line.ProductSkuId,
                ProductName = line.ProductName,
                ProductNameEng = line.ProductNameEng,
                SkuCode = line.SkuCode,
                UnitOfMeasureId = line.UnitOfMeasureId,
                Quantity = line.Quantity,
                UnitCost = IsNonCommercialRequestDocument ? 0 : line.UnitCost,
                DiscountRate = IsNonCommercialRequestDocument ? 0 : line.DiscountRate,
                TaxRate = IsNonCommercialRequestDocument ? 0 : line.TaxRate,
                Notes = line.Notes,
                BillControlPolicy = ShowsLinePurchaseControls ? document.BillControlPolicy : null,
                ThreeWayMatchStatus = ShowsLinePurchaseControls ? document.ThreeWayMatchStatus : ThreeWayMatchStatus.NotRequired
            };
            editableLine.SelectedProduct = products.FirstOrDefault(x => x.Id == editableLine.ProductId);
            editableLine.SelectedSku = allSkus.FirstOrDefault(x => x.Id == editableLine.ProductSkuId);
            return editableLine;
        }).ToList();
    }

    private void CreateSupplier() => NavigationManager.NavigateTo("/Suppliers/Supplier/Form");
    private void AddLine() => document.Lines.Insert(0, new EditableProcurementLine
    {
        BillControlPolicy = ShowsLinePurchaseControls ? document.BillControlPolicy : null,
        ThreeWayMatchStatus = ShowsLinePurchaseControls ? document.ThreeWayMatchStatus : ThreeWayMatchStatus.NotRequired
    });
    private void RemoveLine(EditableProcurementLine line) => document.Lines.Remove(line);
    private static void ApplyPackageQuantity(EditableProcurementLine line)
    {
        if (line.SelectedPackage is null)
            return;

        line.ProductPackageId = line.SelectedPackage.Id;
        line.Quantity = line.PackageQuantity * line.SelectedPackage.Quantity;
    }

