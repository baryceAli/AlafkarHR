    private Task OnSkuChanged(EditableProcurementLine line, ProductSkuDto? sku)
    {
        line.SelectedSku = sku;
        line.ProductSkuId = sku?.Id ?? Guid.Empty;
        line.SelectedPackage = null;
        line.ProductPackageId = null;
        line.PackageQuantity = 0;
        line.SkuCode = SkuNameSnapshot(sku);
        if (sku is not null && line.SelectedProduct is null)
        {
            line.SelectedProduct = products.FirstOrDefault(x => x.Id == sku.ProductId);
            line.ProductId = sku.ProductId;
            line.ProductName = line.SelectedProduct?.Name ?? sku.ProductName ?? string.Empty;
            line.ProductNameEng = line.SelectedProduct?.NameEng ?? sku.ProductNameEng ?? string.Empty;
        }
        line.SelectedBatch = null;
        line.BatchId = null;
        return Task.CompletedTask;
    }

    private Task OnPackageChanged(EditableProcurementLine line, ProductPackageDto? package)
    {
        line.SelectedPackage = package;
        line.ProductPackageId = package?.Id;

        if (package is null)
        {
            line.PackageQuantity = 0;
            return Task.CompletedTask;
        }

        if (line.PackageQuantity <= 0 && line.Quantity > 0 && package.Quantity > 0)
            line.PackageQuantity = line.Quantity / package.Quantity;
        else if (line.PackageQuantity <= 0)
            line.PackageQuantity = 1;

        ApplyPackageQuantity(line);
        return Task.CompletedTask;
    }

    private Task OnPackageQuantityChanged(EditableProcurementLine line, decimal quantity)
    {
        line.PackageQuantity = quantity < 0 ? 0 : quantity;
        ApplyPackageQuantity(line);
        return Task.CompletedTask;
    }

    private Task OnBatchChanged(EditableProcurementLine line, BatchDto? batch)
    {
