            return allSkus.Where(x => x.ProductId == line.ProductId).ToList();

        return allSkus;
    }

    private List<ProductPackageDto> PackageOptions(EditableProcurementLine line) => line.SelectedSku?.Packages ?? [];
    private bool ShowPackageInputs(EditableProcurementLine line) => PackageOptions(line).Count > 0;
    private bool IsPackageQuantityControlled(EditableProcurementLine line) => ShowPackageInputs(line) && line.SelectedPackage is not null;

    private List<BatchDto> BatchOptions(EditableProcurementLine line)
    {
        List<BatchDto> options;

        if (line.ProductSkuId != Guid.Empty)
            options = batches.Where(x => x.ProductSkuId == line.ProductSkuId).ToList();
        else if (line.ProductId != Guid.Empty)
            options = batches.Where(x => x.ProductId == line.ProductId).ToList();
        else
            options = batches.ToList();

        if (CanCreateBatch(line))
            options.Insert(0, CreateBatchOption());

        return options;
    }

