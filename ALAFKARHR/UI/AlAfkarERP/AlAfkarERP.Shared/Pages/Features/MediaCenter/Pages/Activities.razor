@page "/MediaCenter/Activities"
@layout AdminLayout
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.MediaCenter.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using SharedWithUI.MediaCenter.Dtos
@using SharedWithUI.MediaCenter.Enums
@using SharedWithUI.Permissions

@inject IMediaCenterService MediaCenterService
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject ApiConfig ApiConfig
@inject AuthenticationStateProvider AuthenticationStateProvider

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Media Center", "المركز الإعلامي")"
                Subtitle="@Text("Document company activities with images, videos, audio, documents, and related business context.", "وثق أنشطة الشركة بالصور والفيديو والصوت والمستندات وسياق العمل المرتبط بها.")"
                Icon="bi-images">
        <Actions>
            @if (CanManageTypes)
            {
                <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/MediaCenter/ActivityTypes"))">
                    <i class="bi bi-tags"></i> @Text("Types", "الأنواع")
                </button>
            }
            @if (CanCreate)
            {
                <button class="btn btn-primary" @onclick="NewActivity">
                    <i class="bi bi-plus-lg"></i> @Text("New entry", "إدخال جديد")
                </button>
            }
        </Actions>
    </PageHeader>

    <AppCard>
        <FilterBar>
            <input class="form-control erp-search-control" placeholder="@Text("Search title, location, notes, related records", "بحث في العنوان أو الموقع أو الملاحظات أو السجلات المرتبطة")" @bind="filter.SearchText" />
            <select class="form-select" @bind="filter.ActivityTypeId">
                <option value="">@Text("All types", "كل الأنواع")</option>
                @foreach (var type in activityTypes)
                {
                    <option value="@type.Id">@DisplayName(type.Name, type.NameEng)</option>
                }
            </select>
            <input class="form-control" placeholder="@Text("Related type", "نوع الرابط")" @bind="filter.RelatedType" />
            <input class="form-control" placeholder="@Text("Related text", "نص الرابط")" @bind="filter.RelatedText" />
            <InputDate class="form-control" @bind-Value="filter.FromDate" />
            <InputDate class="form-control" @bind-Value="filter.ToDate" />
            <select class="form-select" @bind="filter.MediaKind">
                @foreach (var kind in Enum.GetValues<MediaKind>())
                {
                    <option value="@kind">@MediaKindText(kind)</option>
                }
            </select>
            <button class="btn btn-outline-secondary" @onclick="SearchAsync"><i class="bi bi-search"></i> @Text("Filter", "تصفية")</button>
        </FilterBar>
    </AppCard>

    @if (editing is not null && (editing.Id == Guid.Empty ? CanCreate : CanEdit))
    {
        <AppCard Title="@Text(editing.Id == Guid.Empty ? "Create library entry" : "Edit library entry", editing.Id == Guid.Empty ? "إنشاء إدخال في المكتبة" : "تعديل إدخال المكتبة")" CssClass="mt-3">
            <EditForm id="activity-edit-form" EditContext="@activityEditContext" OnValidSubmit="SaveActivityAsync">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">@Text("Activity type", "نوع النشاط")</label>
                        <select class="form-select" @bind="editing.ActivityTypeId">
                            <option value="">@Text("Select type", "اختر النوع")</option>
                            @foreach (var type in activityTypes)
                            {
                                <option value="@type.Id">@DisplayName(type.Name, type.NameEng)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">@Text("Title", "العنوان")</label>
                        <InputText class="form-control" @bind-Value="editing.Title" />
                        <ValidationMessage For="@(() => editing.Title)" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Text("English title", "العنوان الإنجليزي")</label>
                        <InputText class="form-control" @bind-Value="editing.TitleEng" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Text("Activity date", "تاريخ النشاط")</label>
                        <InputDate class="form-control" @bind-Value="editing.ActivityDate" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Text("Activity time", "وقت النشاط")</label>
                        <input type="time" class="form-control" value="@activityTimeText" @onchange="OnActivityTimeChanged" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Text("Location", "الموقع")</label>
                        <InputText class="form-control" @bind-Value="editing.LocationText" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">@Text("Notes", "ملاحظات")</label>
                        <InputTextArea class="form-control" rows="3" @bind-Value="editing.Notes" />
                    </div>
                </div>
            </EditForm>

            <div class="border-top mt-3 pt-3">
                <div class="fw-semibold mb-2">@Text("Related records", "السجلات المرتبطة")</div>
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">@Text("Type", "النوع")</label>
                        <input class="form-control" placeholder="@Text("Project, employee, event", "مشروع، موظف، فعالية")" @bind="relatedDraft.RelatedType" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">@Text("Record ID", "معرف السجل")</label>
                        <input class="form-control" placeholder="@Text("Optional GUID", "معرف اختياري")" @bind="relatedRecordIdText" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Text("Display name", "اسم العرض")</label>
                        <input class="form-control" @bind="relatedDraft.DisplayName" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-outline-secondary w-100" @onclick="AddRelatedRecord"><i class="bi bi-plus"></i> @Text("Add", "إضافة")</button>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@Text("Link notes", "ملاحظات الرابط")</label>
                        <input class="form-control" @bind="relatedDraft.Notes" />
                    </div>
                </div>

                @if (editing.RelatedRecords.Any())
                {
                    <div class="d-flex flex-wrap gap-2 mt-3">
                        @foreach (var record in editing.RelatedRecords)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => RemoveRelatedRecord(record)">
                                <i class="bi bi-x"></i> @record.RelatedType: @record.DisplayName
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="d-flex justify-content-end gap-2 mt-3">
                <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">@Text("Cancel", "إلغاء")</button>
                <button type="button" class="btn btn-primary" disabled="@busy" @onclick="SaveActivityAsync"><i class="bi bi-check2"></i> @Text("Save", "حفظ")</button>
            </div>
        </AppCard>
    }

    <AppCard Title="@Text("Library", "المكتبة")" CssClass="mt-3">
        @if (busy)
        {
            <AppLoader />
        }
        else if (!activities.Any())
        {
            <EmptyState Title="@Text("No media entries", "لا توجد إدخالات إعلامية")" Message="@Text("Create the first entry or adjust the filters.", "أنشئ أول إدخال أو عدل عوامل التصفية.")" />
        }
        else
        {
            <div class="erp-table-wrap">
                <table class="table erp-table align-middle">
                    <thead>
                        <tr>
                            <th>@Text("Entry", "الإدخال")</th>
                            <th>@Text("Date", "التاريخ")</th>
                            <th>@Text("Location", "الموقع")</th>
                            <th>@Text("Related records", "السجلات المرتبطة")</th>
                            <th>@Text("Media", "الوسائط")</th>
                            <th class="text-end">@Text("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in activities)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold">@DisplayName(item.Title, item.TitleEng)</div>
                                    <div class="text-muted small">@DisplayName(item.ActivityTypeName, item.ActivityTypeNameEng)</div>
                                </td>
                                <td>@DateTimeText(item.ActivityDate, item.ActivityTime)</td>
                                <td>@item.LocationText</td>
                                <td>@RelatedSummary(item)</td>
                                <td><StatusChip Text="@item.MediaCount.ToString()" Tone="info" Icon="bi-paperclip" /></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenActivity(item.Id)" title="@Text("Open", "فتح")"><i class="bi bi-box-arrow-up-right"></i></button>
                                    @if (CanEdit)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => Edit(item)" title="@Text("Edit", "تعديل")"><i class="bi bi-pencil"></i></button>
                                    }
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteActivityAsync(item.Id)" title="@Text("Delete", "حذف")"><i class="bi bi-trash"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="text-muted small">@Text("Total", "الإجمالي"): @totalCount</span>
                <div class="btn-group">
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(filter.PageIndex == 0)" @onclick="PreviousPage"><i class="bi bi-chevron-left"></i></button>
                    <button class="btn btn-outline-secondary btn-sm" disabled="@(!HasNextPage)" @onclick="NextPage"><i class="bi bi-chevron-right"></i></button>
                </div>
            </div>
        }
    </AppCard>
</div>

@code {
    private readonly List<MediaActivityDto> activities = [];
    private readonly List<MediaActivityTypeDto> activityTypes = [];
    private readonly MediaActivityFilter filter = new() { PageSize = 20, MediaKind = MediaKind.All };
    private SaveMediaActivityDto? editing;
    private EditContext? activityEditContext;
    private MediaActivityRelatedRecordDto relatedDraft = new();
    private AuthenticationState? authState;
    private string? relatedRecordIdText;
    private string? activityTimeText;
    private long totalCount;
    private bool busy;

    private bool CanCreate => HasPermission(PermissionList.MediaCenterPermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.MediaCenterPermissions.Edit);
    private bool CanDelete => HasPermission(PermissionList.MediaCenterPermissions.Delete);
    private bool CanManageTypes => HasPermission(PermissionList.MediaCenterPermissions.ManageTypes);
    private bool HasNextPage => ((filter.PageIndex + 1) * filter.PageSize) < totalCount;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        await LoadLookupsAsync();
        await LoadActivitiesAsync();
    }

    private async Task LoadLookupsAsync()
    {
        var response = await MediaCenterService.GetActivityTypesAsync(0, 500, CompanyId());
        if (response.IsSuccess && response.Data is not null) activityTypes.AddRange(response.Data.Data);
    }

    private async Task SearchAsync() { filter.PageIndex = 0; await LoadActivitiesAsync(); }

    private async Task LoadActivitiesAsync()
    {
        busy = true;
        filter.CompanyId = CompanyId();
        var response = await MediaCenterService.GetActivitiesAsync(filter);
        activities.Clear();
        if (response.IsSuccess && response.Data is not null) { activities.AddRange(response.Data.Data); totalCount = response.Data.Count; }
        else ToastService.ShowError(Error(response, Text("Unable to load media entries.", "تعذر تحميل الإدخالات الإعلامية.")));
        busy = false;
    }

    private void NewActivity()
    {
        if (!CanCreate) return;
        editing = new SaveMediaActivityDto { CompanyId = ApiConfig.CompanyId, ActivityDate = DateTime.UtcNow.Date, ActivityTypeId = activityTypes.FirstOrDefault()?.Id ?? Guid.Empty };
        activityEditContext = new EditContext(editing);
        relatedDraft = new MediaActivityRelatedRecordDto();
        relatedRecordIdText = null;
        activityTimeText = null;
    }

    private void Edit(MediaActivityDto item)
    {
        if (!CanEdit) return;
        editing = new SaveMediaActivityDto
        {
            Id = item.Id,
            CompanyId = item.CompanyId,
            ActivityTypeId = item.ActivityTypeId,
            Title = item.Title,
            TitleEng = item.TitleEng,
            ActivityDate = item.ActivityDate,
            ActivityTime = item.ActivityTime,
            LocationText = item.LocationText,
            Notes = item.Notes,
            RelatedRecords = item.RelatedRecords.Select(r => new MediaActivityRelatedRecordDto
            {
                RelatedType = r.RelatedType,
                RelatedRecordId = r.RelatedRecordId,
                DisplayName = r.DisplayName,
                Notes = r.Notes
            }).ToList()
        };
        activityEditContext = new EditContext(editing);
        relatedDraft = new MediaActivityRelatedRecordDto();
        relatedRecordIdText = null;
        activityTimeText = item.ActivityTime?.ToString("HH:mm");
    }

    private void AddRelatedRecord()
    {
        if (editing is null) return;
        if (string.IsNullOrWhiteSpace(relatedDraft.RelatedType) || string.IsNullOrWhiteSpace(relatedDraft.DisplayName))
        {
            ToastService.ShowError(Text("Related record type and display name are required.", "نوع السجل المرتبط واسم العرض مطلوبان."));
            return;
        }

        if (!string.IsNullOrWhiteSpace(relatedRecordIdText) && !Guid.TryParse(relatedRecordIdText, out _))
        {
            ToastService.ShowError(Text("Related record ID must be a valid GUID.", "يجب أن يكون معرف السجل المرتبط بصيغة GUID صحيحة."));
            return;
        }

        editing.RelatedRecords.Add(new MediaActivityRelatedRecordDto
        {
            RelatedType = relatedDraft.RelatedType.Trim(),
            RelatedRecordId = ParseGuid(relatedRecordIdText),
            DisplayName = relatedDraft.DisplayName.Trim(),
            Notes = relatedDraft.Notes
        });
        relatedDraft = new MediaActivityRelatedRecordDto();
        relatedRecordIdText = null;
    }

    private void RemoveRelatedRecord(MediaActivityRelatedRecordDto record) => editing?.RelatedRecords.Remove(record);
    private void CancelEdit()
    {
        editing = null;
        activityEditContext = null;
    }
    private void OpenActivity(Guid id) => NavigationManager.NavigateTo($"/MediaCenter/Activities/{id}");

    private async Task SaveActivityAsync()
    {
        if (editing is null || (editing.Id == Guid.Empty && !CanCreate) || (editing.Id != Guid.Empty && !CanEdit)) return;
        if (!ValidateActivityBeforeSave()) return;
        editing.CompanyId = ApiConfig.CompanyId;
        editing.ActivityTime = ParseTime(activityTimeText);
        busy = true;
        var success = editing.Id == Guid.Empty ? (await MediaCenterService.CreateActivityAsync(editing)).IsSuccess : (await MediaCenterService.UpdateActivityAsync(editing)).IsSuccess;
        busy = false;
        if (success) { ToastService.ShowSuccess(Text("Media entry saved.", "تم حفظ الإدخال الإعلامي.")); editing = null; await LoadActivitiesAsync(); }
        else ToastService.ShowError(Text("Unable to save media entry.", "تعذر حفظ الإدخال الإعلامي."));
    }

    private async Task DeleteActivityAsync(Guid id)
    {
        if (!CanDelete) return;
        var response = await MediaCenterService.DeleteActivityAsync(id);
        if (response.IsSuccess) { ToastService.ShowSuccess(Text("Media entry deleted.", "تم حذف الإدخال الإعلامي.")); await LoadActivitiesAsync(); }
        else ToastService.ShowError(Error(response, Text("Unable to delete media entry.", "تعذر حذف الإدخال الإعلامي.")));
    }

    private bool ValidateActivityBeforeSave()
    {
        if (editing is null) return false;
        if (activityEditContext is not null && !activityEditContext.Validate()) return false;

        if (editing.ActivityTypeId == Guid.Empty)
        {
            ToastService.ShowError(Text("Select an activity type before saving.", "اختر نوع النشاط قبل الحفظ."));
            return false;
        }

        if (string.IsNullOrWhiteSpace(editing.Title))
        {
            ToastService.ShowError(Text("Title is required.", "العنوان مطلوب."));
            return false;
        }

        return TryCommitRelatedDraft();
    }

    private bool TryCommitRelatedDraft()
    {
        if (editing is null || !HasRelatedDraftInput()) return true;

        if (string.IsNullOrWhiteSpace(relatedDraft.RelatedType) || string.IsNullOrWhiteSpace(relatedDraft.DisplayName))
        {
            ToastService.ShowError(Text("Complete the related record type and display name, or clear the draft row.", "أكمل نوع السجل المرتبط واسم العرض أو امسح صف الإدخال."));
            return false;
        }

        if (!string.IsNullOrWhiteSpace(relatedRecordIdText) && !Guid.TryParse(relatedRecordIdText, out _))
        {
            ToastService.ShowError(Text("Related record ID must be a valid GUID.", "يجب أن يكون معرف السجل المرتبط بصيغة GUID صحيحة."));
            return false;
        }

        AddRelatedRecord();
        return true;
    }

    private bool HasRelatedDraftInput() =>
        !string.IsNullOrWhiteSpace(relatedDraft.RelatedType) ||
        !string.IsNullOrWhiteSpace(relatedDraft.DisplayName) ||
        !string.IsNullOrWhiteSpace(relatedDraft.Notes) ||
        !string.IsNullOrWhiteSpace(relatedRecordIdText);

    private async Task PreviousPage() { if (filter.PageIndex == 0) return; filter.PageIndex--; await LoadActivitiesAsync(); }
    private async Task NextPage() { if (!HasNextPage) return; filter.PageIndex++; await LoadActivitiesAsync(); }

    private static TimeOnly? ParseTime(string? value) => TimeOnly.TryParse(value, out var time) ? time : null;
    private static Guid? ParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private void OnActivityTimeChanged(ChangeEventArgs args) => activityTimeText = args.Value?.ToString();
    private string RelatedSummary(MediaActivityDto item) => item.RelatedRecords.Any() ? string.Join(", ", item.RelatedRecords.Select(x => $"{x.RelatedType}: {x.DisplayName}")) : string.Empty;
    private string DateTimeText(DateTime date, TimeOnly? time) => time.HasValue ? $"{date:yyyy-MM-dd} {time:HH:mm}" : date.ToString("yyyy-MM-dd");
    private bool HasPermission(string permission) => CompanyContext.HasPermission(authState?.User, permission);
    private Guid? CompanyId() => ApiConfig.CompanyId == Guid.Empty ? null : ApiConfig.CompanyId;
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string DisplayName(string name, string? nameEng) => SharedDataService.Language == "ar" ? name : string.IsNullOrWhiteSpace(nameEng) ? name : nameEng;
    private string MediaKindText(MediaKind kind) => kind switch { MediaKind.Image => Text("Images", "صور"), MediaKind.Video => Text("Videos", "فيديو"), MediaKind.Audio => Text("Audio", "صوت"), MediaKind.Document => Text("Documents", "مستندات"), MediaKind.Other => Text("Other", "أخرى"), _ => Text("All media", "كل الوسائط") };
    private static string Error<T>(ApiResult<T> result, string fallback) => result.Error?.Title ?? fallback;
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
