@page "/MediaCenter/Activities/{Id:guid}"
@layout AdminLayout
@implements IDisposable

@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.DocumentManagement.Services
@using AlAfkarERP.Shared.Pages.Features.MediaCenter.Services
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.DocumentManagement.Dtos
@using SharedWithUI.DocumentManagement.Enums
@using SharedWithUI.MediaCenter.Dtos
@using SharedWithUI.MediaCenter.Enums
@using SharedWithUI.Permissions

@inject IMediaCenterService MediaCenterService
@inject IDocumentManagementService DocumentService
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@(activity is null ? Text("Media Entry", "إدخال إعلامي") : DisplayName(activity.Title, activity.TitleEng))"
                Subtitle="@(activity is null ? null : DateTimeText(activity.ActivityDate, activity.ActivityTime))"
                Icon="bi-images">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick="@(() => NavigationManager.NavigateTo("/MediaCenter/Activities"))">
                <i class="bi bi-arrow-return-left"></i> @Text("Back", "رجوع")
            </button>
        </Actions>
    </PageHeader>

    @if (busy)
    {
        <AppLoader />
    }
    else if (activity is null)
    {
        <EmptyState Title="@Text("Entry not found", "الإدخال غير موجود")" />
    }
    else
    {
        <div class="row g-3">
            <div class="col-lg-4">
                <AppCard Title="@Text("Entry details", "تفاصيل الإدخال")">
                    <dl class="row mb-0">
                        <dt class="col-5">@Text("Type", "النوع")</dt><dd class="col-7">@DisplayName(activity.ActivityTypeName, activity.ActivityTypeNameEng)</dd>
                        <dt class="col-5">@Text("Date", "التاريخ")</dt><dd class="col-7">@DateTimeText(activity.ActivityDate, activity.ActivityTime)</dd>
                        <dt class="col-5">@Text("Location", "الموقع")</dt><dd class="col-7">@activity.LocationText</dd>
                        <dt class="col-5">@Text("Media", "الوسائط")</dt><dd class="col-7">@activity.MediaCount</dd>
                    </dl>
                    @if (!string.IsNullOrWhiteSpace(activity.Notes))
                    {
                        <hr />
                        <div class="small text-muted">@activity.Notes</div>
                    }
                </AppCard>

                <AppCard Title="@Text("Related records", "السجلات المرتبطة")" CssClass="mt-3">
                    @if (!activity.RelatedRecords.Any())
                    {
                        <EmptyState Title="@Text("No related records", "لا توجد سجلات مرتبطة")" Icon="bi-link-45deg" />
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var record in activity.RelatedRecords)
                            {
                                <div class="border rounded p-2 small">
                                    <div class="d-flex justify-content-between align-items-start gap-2">
                                        <div class="fw-semibold">@record.DisplayName</div>
                                        <StatusChip Text="@record.RelatedType" Tone="primary" Icon="bi-link-45deg" />
                                    </div>
                                    @if (record.RelatedRecordId.HasValue)
                                    {
                                        <div class="text-muted">@record.RelatedRecordId</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(record.Notes))
                                    {
                                        <div class="mt-1">@record.Notes</div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </AppCard>
            </div>

            <div class="col-lg-8">
                @if (CanUpload)
                {
                    <AppCard Title="@Text("Upload media", "رفع الوسائط")">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4"><label class="form-label">@Text("Media kind", "نوع الوسائط")</label><select class="form-select" @bind="newMedia.MediaKind">@foreach (var kind in Enum.GetValues<MediaKind>().Where(x => x != MediaKind.All)) { <option value="@kind">@MediaKindText(kind)</option> }</select></div>
                            <div class="col-md-8"><label class="form-label">@Text("Caption", "التعليق")</label><input class="form-control" @bind="newMedia.Caption" /></div>
                            <div class="col-md-4"><label class="form-label">@Text("Captured at", "وقت الالتقاط")</label><InputDate class="form-control" @bind-Value="newMedia.CapturedAt" /></div>
                            <div class="col-md-4 d-flex align-items-end"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="newMedia.IsPrimary" /><span class="form-check-label">@Text("Primary media", "وسائط رئيسية")</span></label></div>
                        </div>
                        <DocumentMediaUpload Mode="DocumentMediaUploadMode.CreateDocument" Preset="@UploadPreset" CompanyId="@activity.CompanyId" SourceModule="MediaCenter" SourceEntity="MediaActivity" SourceRecordId="@activity.Id" CanEditSource="false" CreateButtonText="@Text("Upload and attach", "رفع وربط")" OnDocumentCreated="AttachDocumentAsync" />
                    </AppCard>
                }

                @if (editingMedia is not null && CanUpload)
                {
                    <AppCard Title="@Text("Edit media metadata", "تعديل بيانات الوسائط")" CssClass="mt-3">
                        <EditForm Model="@editingMedia" OnValidSubmit="SaveMediaAsync">
                            <div class="row g-3">
                                <div class="col-md-4"><label class="form-label">@Text("Media kind", "نوع الوسائط")</label><select class="form-select" @bind="editingMedia.MediaKind">@foreach (var kind in Enum.GetValues<MediaKind>().Where(x => x != MediaKind.All)) { <option value="@kind">@MediaKindText(kind)</option> }</select></div>
                                <div class="col-md-8"><label class="form-label">@Text("Caption", "التعليق")</label><InputText class="form-control" @bind-Value="editingMedia.Caption" /></div>
                                <div class="col-md-4"><label class="form-label">@Text("Captured at", "وقت الالتقاط")</label><InputDate class="form-control" @bind-Value="editingMedia.CapturedAt" /></div>
                                <div class="col-md-4 d-flex align-items-end"><label class="form-check"><InputCheckbox class="form-check-input" @bind-Value="editingMedia.IsPrimary" /><span class="form-check-label">@Text("Primary media", "وسائط رئيسية")</span></label></div>
                                <div class="col-12 d-flex justify-content-end gap-2"><button type="button" class="btn btn-outline-secondary" @onclick="CancelMediaEdit">@Text("Cancel", "إلغاء")</button><button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i> @Text("Save", "حفظ")</button></div>
                            </div>
                        </EditForm>
                    </AppCard>
                }

                <AppCard Title="@Text("Gallery", "المعرض")" CssClass="mt-3">
                    @if (!activity.Media.Any())
                    {
                        <EmptyState Title="@Text("No media uploaded", "لم يتم رفع وسائط")" Message="@Text("Upload images, videos, audio, or documents for this entry.", "ارفع صورا أو فيديو أو صوتا أو مستندات لهذا الإدخال.")" Icon="bi-images" />
                    }
                    else
                    {
                        <div class="row g-3">
                            @foreach (var media in activity.Media)
                            {
                                var document = Document(media.DocumentId);
                                <div class="col-md-6">
                                    <div class="border rounded p-3 h-100">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <StatusChip Text="@MediaKindText(media.MediaKind)" Tone="info" Icon="@MediaKindIcon(media.MediaKind)" />
                                            @if (media.IsPrimary) { <StatusChip Text="@Text("Primary", "رئيسي")" Tone="success" /> }
                                        </div>
                                        <div class="fw-semibold text-truncate">@(document?.LatestFileName ?? document?.Title ?? media.DocumentId.ToString())</div>
                                        <div class="text-muted small">@(document?.LatestContentType ?? Text("Document metadata loading", "جاري تحميل بيانات المستند"))</div>
                                        @if (!string.IsNullOrWhiteSpace(media.Caption)) { <div class="mt-2">@media.Caption</div> }
                                        <div class="small text-muted mt-2">@media.CapturedAt?.ToString("yyyy-MM-dd")</div>
                                        <div class="d-flex justify-content-end gap-2 mt-3">
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => ViewDocument(media.DocumentId)" title="@Text("View document", "عرض المستند")"><i class="bi bi-box-arrow-up-right"></i></button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => DownloadAsync(media.DocumentId)" title="@Text("Download", "تنزيل")"><i class="bi bi-download"></i></button>
                                            @if (CanUpload)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditMedia(media)" title="@Text("Edit", "تعديل")"><i class="bi bi-pencil"></i></button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMediaAsync(media.Id)" title="@Text("Remove link", "إزالة الرابط")"><i class="bi bi-trash"></i></button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </AppCard>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private MediaActivityDto? activity;
    private AddMediaActivityMediaDto newMedia = new() { MediaKind = MediaKind.Image };
    private UpdateMediaActivityMediaDto? editingMedia;
    private readonly Dictionary<Guid, DocumentDetailDto> documents = [];
    private AuthenticationState? authState;
    private bool busy;

    private bool CanUpload => HasPermission(PermissionList.MediaCenterPermissions.Upload);

    private DocumentUploadPreset UploadPreset => newMedia.MediaKind switch
    {
        MediaKind.Image => DocumentUploadPreset.Image,
        MediaKind.Video => DocumentUploadPreset.Video,
        MediaKind.Audio => DocumentUploadPreset.Audio,
        MediaKind.Document => DocumentUploadPreset.All,
        _ => DocumentUploadPreset.All
    };

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        busy = true;
        var response = await MediaCenterService.GetActivityByIdAsync(Id);
        activity = response.IsSuccess ? response.Data : null;
        if (!response.IsSuccess) ToastService.ShowError(Error(response, Text("Unable to load media entry.", "تعذر تحميل الإدخال الإعلامي.")));
        busy = false;
        await LoadDocumentsAsync();
    }

    private async Task LoadDocumentsAsync()
    {
        documents.Clear();
        if (activity is null) return;
        foreach (var media in activity.Media)
        {
            var response = await DocumentService.GetByIdAsync(media.DocumentId);
            if (response.IsSuccess && response.Data is not null) documents[media.DocumentId] = response.Data;
        }
    }

    private async Task AttachDocumentAsync(Guid documentId)
    {
        if (activity is null || !CanUpload) return;
        newMedia.DocumentId = documentId;
        var response = await MediaCenterService.AddMediaAsync(activity.Id, newMedia);
        if (response.IsSuccess) { ToastService.ShowSuccess(Text("Media attached.", "تم ربط الوسائط.")); newMedia = new AddMediaActivityMediaDto { MediaKind = MediaKind.Image }; await LoadAsync(); }
        else ToastService.ShowError(Error(response, Text("Media uploaded, but it could not be attached to the entry.", "تم رفع الوسائط ولكن تعذر ربطها بالإدخال.")));
    }

    private void EditMedia(MediaActivityMediaDto media)
    {
        editingMedia = new UpdateMediaActivityMediaDto { Id = media.Id, MediaKind = media.MediaKind, Caption = media.Caption, CapturedAt = media.CapturedAt, IsPrimary = media.IsPrimary };
    }

    private void CancelMediaEdit() => editingMedia = null;

    private async Task SaveMediaAsync()
    {
        if (activity is null || editingMedia is null || !CanUpload) return;
        var response = await MediaCenterService.UpdateMediaAsync(activity.Id, editingMedia);
        if (response.IsSuccess) { ToastService.ShowSuccess(Text("Media metadata saved.", "تم حفظ بيانات الوسائط.")); editingMedia = null; await LoadAsync(); }
        else ToastService.ShowError(Error(response, Text("Unable to save media metadata.", "تعذر حفظ بيانات الوسائط.")));
    }

    private async Task DeleteMediaAsync(Guid mediaId)
    {
        if (activity is null || !CanUpload) return;
        var response = await MediaCenterService.DeleteMediaAsync(activity.Id, mediaId);
        if (response.IsSuccess) { ToastService.ShowSuccess(Text("Media link removed.", "تمت إزالة رابط الوسائط.")); await LoadAsync(); }
        else ToastService.ShowError(Error(response, Text("Unable to remove media link.", "تعذر إزالة رابط الوسائط.")));
    }

    private async Task DownloadAsync(Guid documentId)
    {
        var response = await DocumentService.DownloadAsync(documentId);
        if (response.IsSuccess && response.Data is not null) await JS.InvokeVoidAsync("alafkarDocumentDownload.downloadBase64", response.Data.FileName, response.Data.ContentType, response.Data.Base64Content);
        else ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Download failed.", "فشل التنزيل."));
    }

    private void ViewDocument(Guid documentId) => NavigationManager.NavigateTo($"/DocumentManagement/View/{documentId}");
    private DocumentDetailDto? Document(Guid id) => documents.TryGetValue(id, out var document) ? document : null;
    private string DateTimeText(DateTime date, TimeOnly? time) => time.HasValue ? $"{date:yyyy-MM-dd} {time:HH:mm}" : date.ToString("yyyy-MM-dd");
    private bool HasPermission(string permission) => CompanyContext.HasPermission(authState?.User, permission);
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string DisplayName(string name, string? nameEng) => SharedDataService.Language == "ar" ? name : string.IsNullOrWhiteSpace(nameEng) ? name : nameEng;
    private string MediaKindText(MediaKind kind) => kind switch { MediaKind.Image => Text("Image", "صورة"), MediaKind.Video => Text("Video", "فيديو"), MediaKind.Audio => Text("Audio", "صوت"), MediaKind.Document => Text("Document", "مستند"), MediaKind.Other => Text("Other", "أخرى"), _ => Text("All media", "كل الوسائط") };
    private static string MediaKindIcon(MediaKind kind) => kind switch { MediaKind.Image => "bi-image", MediaKind.Video => "bi-camera-video", MediaKind.Audio => "bi-soundwave", MediaKind.Document => "bi-file-earmark-text", _ => "bi-paperclip" };
    private static string Error<T>(ApiResult<T> result, string fallback) => result.Error?.Title ?? fallback;
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
