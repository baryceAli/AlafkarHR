    async Task NextPage()
    {
        // if (currentPage < TotalPages)
        //     currentPage++;

        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadAdministrations();
        }
    }

    async Task PrevPage()
    {
        // if (pageIndex > 1)
        //     pageIndex--;
        
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadAdministrations();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;
    private string AdministrationSearchText(AdministrationDto administration)
        => $"{SharedDataService.SelectViewLang(administration.NameEng, administration.Name)} | {administration.Code}";

    private string BranchScopeLabel(AdministrationDto administration)
    {
        if (!administration.BranchId.HasValue)
        {
            return Text("Company level", "مستوى الشركة");
        }

        var branch = branches.FirstOrDefault(x => x.Id == administration.BranchId.Value);
        return SharedDataService.SelectViewLang(branch?.NameEng ?? "", branch?.Name ?? "");
    }

    private string? ParentAdministrationLabel(AdministrationDto administration)
    {
        if (!administration.ParentAdministrationId.HasValue)
        {
            return null;
        }

        var parent = allBranchAdministrations.FirstOrDefault(x => x.Id == administration.ParentAdministrationId.Value);
        return SharedDataService.SelectViewLang(
            parent?.NameEng ?? administration.ParentAdministrationNameEng ?? "",
            parent?.Name ?? administration.ParentAdministrationName ?? "");
    }

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
