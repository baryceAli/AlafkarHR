@layout AdminLayout
@page "/Organization/Administration/List"
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Permissions
@using SharedWithUI.Employees.Dtos
@using AlAfkarERP.Shared.Pages.Features.Employees.Services
@inject IBranchService BranchService
@inject IAdministrationService AdministrationService
@inject IAuthService AuthService
@inject ToastService ToastService
@inject ModalService ModalService
@inject IEmployeeService EmployeeService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService


    @if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.AdministrationPermissions.View}"))
{
    <div class="alr alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحيات لعرض هذه الصفحة")</span>
    </div>

    return;
}
<div class="org-list-page" dir="@SharedDataService.PageDirection">
    <div class="org-list-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Organization", "المنظمة")</div>
            <h3 class="mb-1">@Text("Administrations Management", "ادارة الإدارات")</h3>
            <div class="text-muted">@Text("Manage company higher management, branch administrations, hierarchy, managers, and active status.", "إدارة الإدارة العليا على مستوى الشركة وإدارات الفروع والتسلسل الإداري والمدراء وحالة التفعيل.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" @onclick="LoadAdministrations">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.AdministrationPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i>
                @Text("Create New", "إضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="org-stat border-primary">
                <div class="org-stat-icon text-primary"><i class="bi bi-kanban"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Administrations", "الإدارات المعروضة")</div>
                    <div class="org-stat-value">@administrations.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="org-stat border-success">
                <div class="org-stat-icon text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="text-muted small">@Text("Active", "النشطة")</div>
                    <div class="org-stat-value">@administrations.Count(a => a.IsActive)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="org-stat border-info">
                <div class="org-stat-icon text-info"><i class="bi bi-person-badge"></i></div>
                <div>
                    <div class="text-muted small">@Text("With Manager", "لها مدير")</div>
                    <div class="org-stat-value">@administrations.Count(a => a.ManagerId.HasValue)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="org-toolbar mb-3">
                <div class="org-selector">
                    <label class="form-label mb-1">@Text("Branch filter", "تصفية حسب الفرع")</label>
                    <AutoCompleteComponent TItem="BranchDto"
                                           Items="branches"
                                           Value="selectedBranch"
                                           ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                           ValueChanged="OnBranchSelected">
                    </AutoCompleteComponent>
                    <button type="button" class="btn btn-link btn-sm px-0" @onclick="ClearBranchFilter">
                        @Text("Show company-level and all branches", "عرض مستوى الشركة وجميع الفروع")
                    </button>
                </div>

                <div class="org-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search by name...", "بحث بالاسم...")"
                           @bind="searchText" />
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select org-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>

    <div class="table-responsive org-table-wrap">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table org-table align-middle mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(AdministrationDto.Name))" class="sortable">
                    @Text("Name", "الاسم")
                    <i class="@SortIcon(nameof(AdministrationDto.Name))"></i>
                </th>
                <th @onclick="() => Sort(nameof(AdministrationDto.NameEng))" class="sortable">
                    @Text("Name (English)", "الاسم بالانجليزية")
                    <i class="@SortIcon(nameof(AdministrationDto.NameEng))"></i>
                </th>
                <th>@Text("Scope", "النطاق")</th>
                <th @onclick="() => Sort(nameof(AdministrationDto.ManagerId))" class="sortable">
                    @Text("Manager", "المدير")
                    <i class="@SortIcon(nameof(AdministrationDto.ManagerId))"></i>
                </th>
                <th>@Text("Parent", "الإدارة الأعلى")</th>
                <th>@Text("Status", "الحالة")</th>
                <th class="text-end">@Text("Actions", "العمليات")</th>
            </tr>
        </thead>
        <tbody>
            @if (editingAdministrationId !=null)
            {
                var admin = administrations.FirstOrDefault(a => a.Id == editingAdministrationId);
                <tr class="org-edit-row">
                    <td colspan="7">
                        <EditForm Model="admin" OnValidSubmit="async () => await SaveAdministration(admin)">
                            <DataAnnotationsValidator />
                            <ValidationSummary />
                            <div class="org-edit-panel">
                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                    <div>
                                        <h5 class="mb-1">@Text(isEdit ? "Edit Administration" : "Create Administration", isEdit ? "تعديل الإدارة" : "اضافة إدارة")</h5>
                                        <div class="text-muted small">@Text("Update administration identity, manager, and status.", "تحديث بيانات الإدارة والمدير والحالة.")</div>
                                    </div>
                                    <span class="badge text-bg-light">@Text("Inline Form", "نموذج داخلي")</span>
                                </div>

                                <div class="row g-3">

                                <div class="col-md-6">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                            
                                        <InputText class="form-control" @bind-Value="admin.Name" />
                                        <ValidationMessage For="() => admin.Name" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (انجليزي)")</label>
                                        <InputText class="form-control" @bind-Value="admin.NameEng" />
                                        <ValidationMessage For="() => admin.NameEng" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@SharedDataService.SelectViewLang("Manager", "مدير الادارة")</label>
                                        <AutoCompleteComponent TItem="EmployeeDto"
                                                               Items="employees"
                                                               Value="manager"
                                                               PlaceHolder="@Text("Search manager...", "ابحث عن المدير...")"
                                                               ItemText='(p=> p.FullName)'
                                                               ValueChanged="OnUserSelected">
                                        </AutoCompleteComponent>
                                                               @* ItemText='(p=> SharedDataService.SelectViewLang( p.FullNameEng,p.FullName))' *@
                                        
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">@Text("Parent administration", "الإدارة الأعلى")</label>
                                    <AutoCompleteComponent TItem="AdministrationDto"
                                                           Items="ParentAdministrationOptions(admin)"
                                                           Value="parentAdministration"
                                                           PlaceHolder="@Text("Search parent administration...", "ابحث عن الإدارة الأعلى...")"
                                                           ItemText="AdministrationSearchText"
                                                           ValueChanged="OnParentAdministrationSelected">
                                    </AutoCompleteComponent>
                                    <div class="form-text">@Text("Leave empty for CEO, General Manager, or another top-level administration.", "اتركه فارغا للرئيس التنفيذي أو المدير العام أو أي إدارة عليا.")</div>
                                </div>
                                    
                                <div class="col-md-6">
                                    <label class="form-label d-block">@SharedDataService.SelectViewLang("Active?", "فعال؟")</label>
                                    <div class="org-check">
                                        <InputCheckbox class="form-check-input" @bind-Value="admin.IsActive" />
                                        <span>@Text("Active administration", "إدارة نشطة")</span>
                                    </div>
                                </div>
                                    
                                <div class="col-12 d-flex justify-content-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">@Text("Cancel", "إلغاء")</button>
                                    <button type="submit" class="btn btn-success"><i class="bi bi-check2"></i> @Text("Save", "حفظ")</button>
                                </div>
                            </div>
                            </div>
                        </EditForm>
                    </td>
                </tr>
            }
                
            @foreach (var admin in ProcessedAdministrations.Where(a=> a.Id!=editingAdministrationId))
            {
                
                <tr>
                        <td>
                            <div class="fw-semibold">@EmptyValue(admin.Name)</div>
                            <div class="text-muted small">@EmptyValue(admin.Code)</div>
                        </td>
                        <td>@EmptyValue(admin.NameEng)</td>
                        <td>@EmptyValue(BranchScopeLabel(admin))</td>
                        <td>@EmptyValue(SharedDataService.SelectViewLang(employees.FirstOrDefault(u => u.Id == admin.ManagerId)?.FullName ?? "",employees.FirstOrDefault(u => u.Id == admin.ManagerId)?.FullName ?? ""))</td>
                        <td>@EmptyValue(ParentAdministrationLabel(admin))</td>
                        <td>
                            <span class="badge rounded-pill @(admin.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(admin.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))
                            </span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm org-action"
                                    @onclick="() => EditAdministration(admin)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.AdministrationPermissions.Edit}"))
                                    title="@Text("Edit", "تعديل")">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button class="btn btn-outline-danger btn-sm org-action"
                                    @onclick="() => DeleteAdministration(admin)"
                                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.AdministrationPermissions.Delete}"))
                                    title="@Text("Delete", "حذف")">
                                <i class="bi bi-trash"></i>
                            </button>
                            </div>
                        </td>
                    </tr>
                
            }
        </tbody>
    </table>
    </div>
    <div class="org-pagination">
        <div class="text-muted small">
            @Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @Math.Max(TotalPages, 1)
        </div>
        <div class="d-flex gap-2">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            <i class="bi bi-chevron-left"></i>
            @Text("Previous", "السابق")
        </button>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @Text("Next", "التالي")
            <i class="bi bi-chevron-right"></i>
        </button>

        </div>
    </div>
        </div>
    </div>
</div>

