    private async Task ToggleChildCompanyStatusAsync(OrganizationCompanyNodeDto company) => await ModalService.ShowAsync(new ModalOptions { Title = T("Change Company Status", "تغيير حالة الشركة"), Message = T("Do you want to change this child company's status?", "هل تريد تغيير حالة هذه الشركة التابعة؟"), Variant = ModalVariant.Warning, ShowCancel = true, OkText = T("Confirm", "تأكيد"), CancelText = T("Cancel", "إلغاء"), OnOk = async () => { var result = await CompanyService.SetChildStatusAsync(company.Id, !company.IsActive); if (result.IsSuccess) { ToastService.ShowSuccess(T("Company status updated.", "تم تحديث حالة الشركة.")); await LoadStructureAsync(); } else { ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not update company status.", "تعذر تحديث حالة الشركة.")); } } });
    private async Task ConfirmDeleteBranchAsync(OrganizationBranchNodeDto branch) => await ConfirmDeleteAsync(T("Delete Branch", "حذف الفرع"), Name(branch.Name, branch.NameEng), async () => await BranchService.DeleteAsync(branch.Id));
    private async Task ConfirmDeleteAdministrationAsync(OrganizationAdministrationNodeDto administration) => await ConfirmDeleteAsync(T("Delete Administration", "حذف الإدارة"), Name(administration.Name, administration.NameEng), async () => await AdministrationService.DeleteAsync(administration.Id));
    private async Task ConfirmDeleteDepartmentAsync(OrganizationDepartmentNodeDto department) => await ConfirmDeleteAsync(T("Delete Department", "حذف القسم"), Name(department.Name, department.NameEng), async () => await DepartmentService.DeleteAsync(department.Id));
    private async Task ConfirmDeleteAsync(string title, string name, Func<Task<ApiResult<UpdateDeleteResponseDto>>> action) => await ModalService.ShowAsync(new ModalOptions { Title = title, Message = T($"Delete {name}?", $"حذف {name}؟"), Variant = ModalVariant.Danger, ShowCancel = true, OkText = T("Delete", "حذف"), CancelText = T("Cancel", "إلغاء"), OnOk = async () => { var result = await action(); if (result.IsSuccess) { ToastService.ShowSuccess(T("Deleted successfully.", "تم الحذف بنجاح.")); await LoadStructureAsync(); } else { ShowError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Delete failed.", "تعذر الحذف.")); } } });

    private bool CompanyVisible(OrganizationCompanyNodeDto company) => Matches(company.Name, company.NameEng, company.Code) || company.ChildCompanies.Any(CompanyVisible) || company.Branches.Any(BranchVisible) || company.Administrations.Any(AdminVisible);
    private bool BranchVisible(OrganizationBranchNodeDto branch) => Matches(branch.Name, branch.NameEng, branch.Code, branch.Location) || branch.Administrations.Any(AdminVisible);
    private bool AdminVisible(OrganizationAdministrationNodeDto administration) => Matches(administration.Name, administration.NameEng, administration.Code) || administration.ChildAdministrations.Any(AdminVisible) || administration.Departments.Any(DepartmentVisible);
    private bool DepartmentVisible(OrganizationDepartmentNodeDto department) => Matches(department.Name, department.NameEng, department.Code, department.Location) || department.ChildDepartments.Any(DepartmentVisible);
    private bool Matches(params string?[] values) { if (string.IsNullOrWhiteSpace(searchText)) return true; var search = searchText.Trim(); return values.Any(value => !string.IsNullOrWhiteSpace(value) && value.Contains(search, StringComparison.OrdinalIgnoreCase)); }

    private void ExpandAll() { expandedNodes.Clear(); if (structure is null) return; foreach (var company in structure.Companies) AddCompanyKeys(company); }
    private void CollapseAll() => expandedNodes.Clear();
    private void AddCompanyKeys(OrganizationCompanyNodeDto company) { expandedNodes.Add(NodeKey("company", company.Id)); foreach (var administration in company.Administrations) AddAdministrationKeys(administration); foreach (var branch in company.Branches) AddBranchKeys(branch); foreach (var child in company.ChildCompanies) AddCompanyKeys(child); }
    private void AddBranchKeys(OrganizationBranchNodeDto branch) { expandedNodes.Add(NodeKey("branch", branch.Id)); foreach (var administration in branch.Administrations) AddAdministrationKeys(administration); }
    private void AddAdministrationKeys(OrganizationAdministrationNodeDto administration) { expandedNodes.Add(NodeKey("admin", administration.Id)); foreach (var child in administration.ChildAdministrations) AddAdministrationKeys(child); foreach (var department in administration.Departments) AddDepartmentKeys(department); }
    private void AddDepartmentKeys(OrganizationDepartmentNodeDto department) { expandedNodes.Add(NodeKey("dept", department.Id)); foreach (var child in department.ChildDepartments) AddDepartmentKeys(child); }
    private void Toggle(string key) { if (!expandedNodes.Add(key)) expandedNodes.Remove(key); }
    private bool IsExpanded(string key) => expandedNodes.Contains(key);
    private static string CompanyKey(Guid id) => NodeKey("company", id);
    private static string BranchKey(Guid id) => NodeKey("branch", id);
    private static string AdminKey(Guid id) => NodeKey("admin", id);
    private static string DeptKey(Guid id) => NodeKey("dept", id);
    private static string NodeKey(string kind, Guid id) => $"{kind}:{id:N}";
    private string ChevronIcon(string key) => IsExpanded(key) ? "bi bi-chevron-down" : "bi bi-chevron-left";
    private string ToggleNodeTooltip(string key) => IsExpanded(key) ? T("Collapse node", "طي العنصر") : T("Expand node", "توسيع العنصر");
    private static string StatusBadgeClass(bool isActive) => $"badge rounded-pill {(isActive ? "text-bg-success" : "text-bg-secondary")}";
    private void ClearSearch() => searchText = string.Empty;
    private void CloseQuickForm() => activeForm = QuickFormKind.None;
    private bool HasPermission(string permission) => AuthState?.User.Claims.Any(c => c.Value == permission) == true;
    private string T(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private string Name(string? name, string? nameEng) => SharedDataService.Language == "Ar" ? FirstNotEmpty(name, nameEng) : FirstNotEmpty(nameEng, name);
    private static string FirstNotEmpty(string? primary, string? fallback) => !string.IsNullOrWhiteSpace(primary) ? primary : !string.IsNullOrWhiteSpace(fallback) ? fallback : "-";
    private void SetError(string message) { errorMessage = message; ToastService.ShowError(message); }
    private void ShowError(string message) => ToastService.ShowError(message);
    private async Task HandleLanguageChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleLanguageChangeAsync;

    private enum QuickFormKind { None, CreateCompany, EditCompany, CreateBranch, EditBranch, CreateAdministration, EditAdministration, CreateDepartment, EditDepartment, ResetPassword }
    private sealed class PasswordResetForm { public string TemporaryPassword { get; set; } = string.Empty; }
}
