    private async Task SaveCompanyAsync() { isSaving = true; try { ApiResult<UpdateDeleteResponseDto>? updateResult = null; ApiResult<CompanyDto>? createResult = null; if (activeForm == QuickFormKind.CreateCompany) createResult = await CompanyService.CreateChildAsync(companyForm); else updateResult = await CompanyService.UpdateChildAsync(companyForm); if ((createResult?.IsSuccess ?? false) || (updateResult?.IsSuccess ?? false)) { ToastService.ShowSuccess(T("Company saved.", "تم حفظ الشركة.")); CloseQuickForm(); await LoadStructureAsync(); return; } ShowError(createResult?.Error?.GetDisplayMessage(SharedDataService.Language) ?? updateResult?.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save company.", "تعذر حفظ الشركة.")); } finally { isSaving = false; } }
    private async Task SaveBranchAsync()
    {
        isSaving = true;
        try
        {
            if (activeForm == QuickFormKind.CreateBranch)
            {
                var createResult = await BranchService.CreateAsync(branchForm);
                if (!createResult.IsSuccess)
                {
                    ShowError(createResult.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save branch.", "تعذر حفظ الفرع."));
                    return;
                }
            }
            else
            {
                var updateResult = await BranchService.UpdateAsync(branchForm);
                if (!updateResult.IsSuccess)
                {
                    ShowError(updateResult.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Could not save branch.", "تعذر حفظ الفرع."));
                    return;
                }
            }

            ToastService.ShowSuccess(T("Branch saved.", "تم حفظ الفرع."));
            CloseQuickForm();
            await LoadStructureAsync();
        }
        finally { isSaving = false; }
    }

