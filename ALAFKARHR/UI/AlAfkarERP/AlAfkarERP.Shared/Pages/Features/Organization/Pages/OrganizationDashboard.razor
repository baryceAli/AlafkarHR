
@layout AdminLayout
@page "/Organization/Dashboard"
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Organization.Dtos
@using SharedWithUI.Permissions
@implements IDisposable

@inject ICompanyService CompanyService
@inject ICurrencyService CurrencyService
@inject IBranchService BranchService
@inject IAdministrationService AdministrationService
@inject IDepartmentService DepartmentService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject ModalService ModalService

<div class="organization-tree-page erp-page" dir="@SharedDataService.PageDirection">
    @if (AuthState is null)
    {
        <AppCard BodyClass="py-5 text-center"><div class="spinner-border text-primary mb-3"></div><div class="fw-semibold">@T("Loading organization tree...", "جاري تحميل الهيكل التنظيمي...")</div></AppCard>
    }
    else if (!CanViewTree)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2"><i class="bi bi-shield-lock"></i><span>@T("You do not have permission to view the organizational structure.", "ليس لديك صلاحية عرض الهيكل التنظيمي.")</span></div>
    }
    else
    {
        <PageHeader Title="@T("Organization Tree", "شجرة الهيكل التنظيمي")" Subtitle="@T("View and maintain companies, branches, administrations, and departments from one structure.", "عرض وإدارة الشركات والفروع والإدارات والأقسام من هيكل واحد.")" Overline="@T("Organization", "المنظمة")" Icon="bi-diagram-3">
            <Actions>
                <button class="btn btn-outline-primary" @onclick="LoadStructureAsync" disabled="@isLoading" title="@T("Refresh organization tree", "تحديث شجرة الهيكل التنظيمي")" aria-label="@T("Refresh organization tree", "تحديث شجرة الهيكل التنظيمي")"><i class="bi bi-arrow-clockwise"></i> @T("Refresh", "تحديث")</button>
                <button class="btn btn-outline-secondary" @onclick="ExpandAll" disabled="@(structure is null)" title="@T("Expand all nodes", "توسيع كل العناصر")" aria-label="@T("Expand all nodes", "توسيع كل العناصر")"><i class="bi bi-arrows-expand"></i> @T("Expand All", "توسيع الكل")</button>
                <button class="btn btn-outline-secondary" @onclick="CollapseAll" disabled="@(structure is null)" title="@T("Collapse all nodes", "طي كل العناصر")" aria-label="@T("Collapse all nodes", "طي كل العناصر")"><i class="bi bi-arrows-collapse"></i> @T("Collapse All", "طي الكل")</button>
            </Actions>
        </PageHeader>

        <div class="row g-3 mb-4">
            @StatCard("bi-buildings", T("Companies", "الشركات"), structure?.CompanyCount ?? 0, "text-primary")
            @StatCard("bi-diagram-2", T("Branches", "الفروع"), structure?.BranchCount ?? 0, "text-info")
            @StatCard("bi-kanban", T("Administrations", "الإدارات"), structure?.AdministrationCount ?? 0, "text-success")
            @StatCard("bi-grid-1x2", T("Departments", "الأقسام"), structure?.DepartmentCount ?? 0, "text-warning")
        </div>

        <AppCard CssClass="mb-4 allow-overflow"><div class="org-tree-toolbar"><div class="org-tree-search"><i class="bi bi-search"></i><input class="form-control" placeholder="@T("Search names or codes...", "ابحث بالاسم أو الكود...")" @bind="searchText" @bind:event="oninput" /></div>@if (!string.IsNullOrWhiteSpace(searchText)) { <button class="btn btn-outline-secondary" @onclick="ClearSearch" title="@T("Clear search", "مسح البحث")" aria-label="@T("Clear search", "مسح البحث")"><i class="bi bi-x-lg"></i> @T("Clear", "مسح")</button> }</div></AppCard>

        @if (isLoading)
        {
            <AppCard BodyClass="py-5 text-center"><div class="spinner-border text-primary mb-3"></div><div class="fw-semibold">@T("Loading organization tree...", "جاري تحميل شجرة الهيكل التنظيمي...")</div></AppCard>
        }
        else if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <AppPageMessage Message="@errorMessage" Type="error" Direction="@SharedDataService.PageDirection" Dismissible="false" />
        }
        else if (structure is null || structure.Companies.Count == 0)
        {
            <AppCard BodyClass="py-5 text-center text-muted"><i class="bi bi-diagram-3 fs-2 d-block mb-2"></i>@T("No organization structure is available for the current user.", "لا يوجد هيكل تنظيمي متاح للمستخدم الحالي.")</AppCard>
        }
        else
        {
            <div class="org-tree-surface">@foreach (var company in structure.Companies.Where(CompanyVisible)) { @RenderCompany(company, 0) }</div>
        }
    }
</div>

@if (activeForm != QuickFormKind.None)
{
    <div class="modal-backdrop fade show"></div><div class="modal fade show d-block" tabindex="-1"><div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content org-quick-modal"><div class="modal-header"><div><h5 class="modal-title">@QuickFormTitle</h5><div class="text-muted small">@QuickFormSubtitle</div></div><button type="button" class="btn-close" @onclick="CloseQuickForm" disabled="@isSaving" title="@T("Close form", "إغلاق النموذج")" aria-label="@T("Close form", "إغلاق النموذج")"></button></div><div class="modal-body">
        @if (activeForm is QuickFormKind.CreateCompany or QuickFormKind.EditCompany)
        {
            <EditForm Model="companyForm" OnValidSubmit="SaveCompanyAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T("Name", "الاسم")</label><InputText class="form-control" @bind-Value="companyForm.Name" /></div><div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم بالإنجليزية")</label><InputText class="form-control" @bind-Value="companyForm.NameEng" /></div>
                <div class="col-md-4"><label class="form-label">@T("Code", "الكود")</label><InputText class="form-control" @bind-Value="companyForm.Code" /></div><div class="col-md-4"><label class="form-label">@T("VAT Number", "الرقم الضريبي")</label><InputText class="form-control" @bind-Value="companyForm.VatNo" /></div>
                <div class="col-md-4"><label class="form-label">@T("Currency", "العملة")</label><InputSelect class="form-select" @bind-Value="companyForm.CurrencyId"><option value="">@T("Select currency", "اختر العملة")</option>@foreach (var currency in currencies) { <option value="@currency.Id">@currency.Code - @Name(currency.Name, currency.NameEng)</option> }</InputSelect></div>
                <div class="col-md-6"><label class="form-label">@T("Email", "البريد الإلكتروني")</label><InputText class="form-control" @bind-Value="companyForm.Email" /></div><div class="col-md-6"><label class="form-label">@T("Phone", "الهاتف")</label><InputText class="form-control" @bind-Value="companyForm.Phone" /></div>
                <div class="col-md-6"><label class="form-label">@T("Time Zone", "المنطقة الزمنية")</label><InputText class="form-control" @bind-Value="companyForm.TimeZone" /></div><div class="col-md-6"><label class="form-label">@T("HQ Location", "موقع المقر")</label><InputText class="form-control" @bind-Value="companyForm.HqLocation" /></div>
                <div class="col-md-6"><label class="form-label">@T("Longitude", "خط الطول")</label><InputNumber class="form-control" @bind-Value="companyForm.HqLongitude" /></div><div class="col-md-6"><label class="form-label">@T("Latitude", "خط العرض")</label><InputNumber class="form-control" @bind-Value="companyForm.HqLatitude" /></div>
                @if (activeForm == QuickFormKind.CreateCompany) { <div class="col-md-4"><label class="form-label">@T("Admin User Name", "اسم مستخدم المدير")</label><InputText class="form-control" @bind-Value="companyForm.AdminUserName" /></div><div class="col-md-4"><label class="form-label">@T("Admin Email", "بريد المدير")</label><InputText class="form-control" @bind-Value="companyForm.AdminEmail" /></div><div class="col-md-4"><label class="form-label">@T("Temporary Password", "كلمة المرور المؤقتة")</label><InputText type="password" class="form-control" @bind-Value="companyForm.AdminTemporaryPassword" /></div><div class="col-md-6"><label class="form-label">@T("Admin Phone", "هاتف المدير")</label><InputText class="form-control" @bind-Value="companyForm.AdminPhoneNumber" /></div> }
            </div>@QuickFormFooter</EditForm>
        }
        else if (activeForm is QuickFormKind.CreateBranch or QuickFormKind.EditBranch)
        {
            <EditForm Model="branchForm" OnValidSubmit="SaveBranchAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T("Name", "الاسم")</label><InputText class="form-control" @bind-Value="branchForm.Name" /></div><div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم بالإنجليزية")</label><InputText class="form-control" @bind-Value="branchForm.NameEng" /></div>
                <div class="col-md-4"><label class="form-label">@T("Code", "الكود")</label><InputText class="form-control" @bind-Value="branchForm.Code" /></div><div class="col-md-4"><label class="form-label">@T("Specialization", "التخصص")</label><InputSelect class="form-select" @bind-Value="branchForm.Specialization"><option value="@BranchSpecialization.General">@T("General", "عام")</option><option value="@BranchSpecialization.StoreFront">@T("StoreFront", "واجهة متجر")</option></InputSelect></div><div class="col-md-4"><label class="form-label">@T("Phone", "الهاتف")</label><InputText class="form-control" @bind-Value="branchForm.Phone" /></div>
                <div class="col-md-6"><label class="form-label">@T("Email", "البريد الإلكتروني")</label><InputText class="form-control" @bind-Value="branchForm.Email" /></div><div class="col-md-6"><label class="form-label">@T("Location", "الموقع")</label><InputText class="form-control" @bind-Value="branchForm.Location" /></div>
                <div class="col-md-6"><label class="form-label">@T("Longitude", "خط الطول")</label><InputNumber class="form-control" @bind-Value="branchForm.Longitude" /></div><div class="col-md-6"><label class="form-label">@T("Latitude", "خط العرض")</label><InputNumber class="form-control" @bind-Value="branchForm.Latitude" /></div>
            </div>@QuickFormFooter</EditForm>
        }
        else if (activeForm is QuickFormKind.CreateAdministration or QuickFormKind.EditAdministration)
        {
            <EditForm Model="administrationForm" OnValidSubmit="SaveAdministrationAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T("Name", "الاسم")</label><InputText class="form-control" @bind-Value="administrationForm.Name" /></div><div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم بالإنجليزية")</label><InputText class="form-control" @bind-Value="administrationForm.NameEng" /></div>
                <div class="col-md-6"><label class="form-label">@T("Code", "الكود")</label><InputText class="form-control" @bind-Value="administrationForm.Code" /></div><div class="col-md-6"><label class="form-label">@T("Scope", "النطاق")</label><input class="form-control" value="@AdministrationScopeLabel" disabled /></div>
                <div class="col-md-6"><div class="org-check"><InputCheckbox class="form-check-input" @bind-Value="administrationForm.IsHigherManagement" /><span>@T("Higher management", "إدارة عليا")</span></div></div><div class="col-md-6"><div class="org-check"><InputCheckbox class="form-check-input" @bind-Value="administrationForm.IsActive" /><span>@T("Active", "نشط")</span></div></div>
            </div>@QuickFormFooter</EditForm>
        }
        else if (activeForm is QuickFormKind.CreateDepartment or QuickFormKind.EditDepartment)
        {
            <EditForm Model="departmentForm" OnValidSubmit="SaveDepartmentAsync"><DataAnnotationsValidator /><ValidationSummary /><div class="row g-3">
                <div class="col-md-6"><label class="form-label">@T("Name", "الاسم")</label><InputText class="form-control" @bind-Value="departmentForm.Name" /></div><div class="col-md-6"><label class="form-label">@T("Name (English)", "الاسم بالإنجليزية")</label><InputText class="form-control" @bind-Value="departmentForm.NameEng" /></div>
                <div class="col-md-6"><label class="form-label">@T("Code", "الكود")</label><InputText class="form-control" @bind-Value="departmentForm.Code" /></div><div class="col-md-6"><label class="form-label">@T("Location", "الموقع")</label><InputText class="form-control" @bind-Value="departmentForm.Location" /></div>
                <div class="col-md-4"><label class="form-label">@T("Longitude", "خط الطول")</label><InputNumber class="form-control" @bind-Value="departmentForm.Longitude" /></div><div class="col-md-4"><label class="form-label">@T("Latitude", "خط العرض")</label><InputNumber class="form-control" @bind-Value="departmentForm.Latitude" /></div><div class="col-md-4"><label class="form-label">@T("Allowed Radius", "نطاق الحضور")</label><InputNumber class="form-control" @bind-Value="departmentForm.AllowedRadiusMeters" /></div>
                <div class="col-12"><div class="org-check"><InputCheckbox class="form-check-input" @bind-Value="departmentForm.IsActive" /><span>@T("Active", "نشط")</span></div></div>
            </div>@QuickFormFooter</EditForm>
        }
        else if (activeForm == QuickFormKind.ResetPassword)
        {
            <EditForm Model="passwordResetForm" OnValidSubmit="ResetPasswordAsync"><DataAnnotationsValidator /><div class="row g-3"><div class="col-12"><label class="form-label">@T("Temporary Password", "كلمة المرور المؤقتة")</label><InputText type="password" class="form-control" @bind-Value="passwordResetForm.TemporaryPassword" /></div></div>@QuickFormFooter</EditForm>
        }
    </div></div></div></div>
}

<style>
    .organization-tree-page { max-width: 1480px; }
    .org-tree-stat { align-items: center; background: var(--erp-surface); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); box-shadow: var(--erp-shadow-sm); display: flex; gap: .875rem; min-height: 92px; padding: 1rem; }
    .org-tree-stat-icon { align-items: center; background: var(--erp-surface-muted); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-md); display: inline-flex; height: 42px; justify-content: center; width: 42px; }
    .org-tree-stat strong { display: block; font-size: 1.6rem; line-height: 1.1; }
    .org-tree-toolbar { align-items: center; display: flex; gap: .75rem; }
    .org-tree-search { flex: 1 1 320px; position: relative; }
    .org-tree-search i { color: var(--erp-text-muted); inset-block-start: 50%; inset-inline-start: .875rem; position: absolute; transform: translateY(-50%); }
    .org-tree-search .form-control { padding-inline-start: 2.35rem; }
    .org-tree-surface { display: grid; gap: 1rem; }
    .org-tree-node { margin-inline-start: calc(var(--tree-depth, 0) * 1rem); }
    .org-node-card { background: var(--erp-surface); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-lg); box-shadow: var(--erp-shadow-sm); overflow: hidden; }
    .org-node-card.is-company { border-inline-start: 4px solid var(--erp-primary); }
    .org-node-card.is-branch { border-inline-start: 4px solid var(--erp-info); }
    .org-node-card.is-administration { border-inline-start: 4px solid var(--erp-success); }
    .org-node-card.is-department { border-inline-start: 4px solid var(--erp-warning); }
    .org-node-main { align-items: flex-start; display: flex; gap: .75rem; justify-content: space-between; padding: .875rem 1rem; }
    .org-node-title { align-items: flex-start; display: flex; gap: .75rem; min-width: 0; }
    .org-node-icon { align-items: center; background: var(--erp-surface-muted); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-md); display: inline-flex; flex: 0 0 auto; height: 38px; justify-content: center; width: 38px; }
    .org-node-name { font-weight: 700; overflow-wrap: anywhere; }
    .org-node-meta { color: var(--erp-text-muted); display: flex; flex-wrap: wrap; gap: .5rem; font-size: .85rem; margin-top: .15rem; }
    .org-node-actions { display: flex; flex-wrap: wrap; gap: .35rem; justify-content: flex-end; }
    .org-node-actions .btn { align-items: center; display: inline-flex; height: 32px; justify-content: center; padding: 0; width: 34px; }
    .org-node-children { border-block-start: 1px solid var(--erp-border); display: grid; gap: .75rem; padding: .875rem; }
    .org-node-empty { background: var(--erp-surface-muted); border: 1px dashed var(--erp-border-strong); border-radius: var(--erp-radius-md); color: var(--erp-text-muted); padding: .75rem; text-align: center; }
    .org-check { align-items: center; background: var(--erp-surface-muted); border: 1px solid var(--erp-border); border-radius: var(--erp-radius-md); display: inline-flex; gap: .5rem; padding: .75rem 1rem; }
    [dir="rtl"] .org-node-card { border-inline-start-width: 1px; border-inline-end-width: 4px; }
    @@media (max-width: 767.98px) { .org-tree-toolbar, .org-node-main { flex-direction: column; } .org-tree-node { margin-inline-start: calc(var(--tree-depth, 0) * .45rem); } .org-node-actions { justify-content: flex-start; } }
</style>

@code {
    private OrganizationStructureDto? structure;
    private List<CurrencyDto> currencies = [];
    private AuthenticationState? AuthState;
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private string searchText = string.Empty;
    private readonly HashSet<string> expandedNodes = [];
    private QuickFormKind activeForm = QuickFormKind.None;
    private CompanyDto companyForm = new();
    private BranchDto branchForm = new();
    private AdministrationDto administrationForm = new();
    private DepartmentDto departmentForm = new();
    private PasswordResetForm passwordResetForm = new();
    private Guid selectedChildCompanyId;
    private string selectedScopeName = string.Empty;

    private bool CanViewTree => HasPermission(PermissionList.CompanyPermissions.Select);
    private bool CanCreateChildCompany => HasPermission(PermissionList.CompanyPermissions.CreateChild);
    private bool CanEditChildCompany => HasPermission(PermissionList.CompanyPermissions.EditChild);
    private bool CanDisableChildCompany => HasPermission(PermissionList.CompanyPermissions.DisableChild);
    private bool CanResetChildAdminPassword => HasPermission(PermissionList.CompanyPermissions.ResetChildAdminPassword);
    private bool CanCreateBranch => HasPermission(PermissionList.BranchPermissions.Create);
    private bool CanEditBranch => HasPermission(PermissionList.BranchPermissions.Edit);
    private bool CanDeleteBranch => HasPermission(PermissionList.BranchPermissions.Delete);
    private bool CanCreateAdministration => HasPermission(PermissionList.AdministrationPermissions.Create);
    private bool CanEditAdministration => HasPermission(PermissionList.AdministrationPermissions.Edit);
    private bool CanDeleteAdministration => HasPermission(PermissionList.AdministrationPermissions.Delete);
    private bool CanCreateDepartment => HasPermission(PermissionList.DepartmentPermissions.Create);
    private bool CanEditDepartment => HasPermission(PermissionList.DepartmentPermissions.Edit);
    private bool CanDeleteDepartment => HasPermission(PermissionList.DepartmentPermissions.Delete);

    private string QuickFormTitle => activeForm switch
    {
        QuickFormKind.CreateCompany => T("Create Child Company", "إنشاء شركة تابعة"),
        QuickFormKind.EditCompany => T("Edit Child Company", "تعديل الشركة التابعة"),
        QuickFormKind.CreateBranch => T("Create Branch", "إنشاء فرع"),
        QuickFormKind.EditBranch => T("Edit Branch", "تعديل الفرع"),
        QuickFormKind.CreateAdministration => T("Create Administration", "إنشاء إدارة"),
        QuickFormKind.EditAdministration => T("Edit Administration", "تعديل الإدارة"),
        QuickFormKind.CreateDepartment => T("Create Department", "إنشاء قسم"),
        QuickFormKind.EditDepartment => T("Edit Department", "تعديل القسم"),
        QuickFormKind.ResetPassword => T("Reset Child Admin Password", "إعادة تعيين كلمة مرور مدير الشركة التابعة"),
        _ => string.Empty
    };

    private string QuickFormSubtitle => string.IsNullOrWhiteSpace(selectedScopeName) ? T("Save changes and refresh the organization tree.", "احفظ التغييرات وسيتم تحديث الشجرة.") : selectedScopeName;
    private string AdministrationScopeLabel => administrationForm.BranchId.HasValue ? T("Branch administration", "إدارة فرع") : T("Company-level administration", "إدارة على مستوى الشركة");
    private RenderFragment QuickFormFooter => @<div class="d-flex justify-content-end gap-2 mt-4"><button type="button" class="btn btn-outline-secondary" @onclick="CloseQuickForm" disabled="@isSaving" title="@T("Cancel changes", "إلغاء التغييرات")" aria-label="@T("Cancel changes", "إلغاء التغييرات")">@T("Cancel", "إلغاء")</button><button type="submit" class="btn btn-primary" disabled="@isSaving" title="@T("Save changes", "حفظ التغييرات")" aria-label="@T("Save changes", "حفظ التغييرات")"><i class="bi bi-check2"></i> @T("Save", "حفظ")</button></div>;

    protected override void OnInitialized() => SharedDataService.OnChange1 += HandleLanguageChangeAsync;

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);
            return;
        }

        await LoadCurrenciesAsync();
        await LoadStructureAsync();
    }

    private async Task LoadCurrenciesAsync()
    {
        var result = await CurrencyService.GetAvailableAsync(0, 500);
        if (result.IsSuccess && result.Data is not null)
            currencies = result.Data.Data.ToList();
    }

    private async Task LoadStructureAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            var result = await CompanyService.GetOrganizationStructureAsync();
            if (!result.IsSuccess || result.Data is null)
            {
                SetError(result.Error?.GetDisplayMessage(SharedDataService.Language) ?? T("Unable to load organization tree.", "تعذر تحميل شجرة الهيكل التنظيمي."));
                return;
            }
            structure = result.Data;
            ExpandAll();
        }
        catch
        {
            SetError(T("An error occurred while loading the organization tree.", "حدث خطأ أثناء تحميل شجرة الهيكل التنظيمي."));
        }
        finally { isLoading = false; }
    }

    private RenderFragment StatCard(string icon, string label, int value, string tone) => @<div class="col-sm-6 col-xl-3"><div class="org-tree-stat"><span class="org-tree-stat-icon @tone"><i class="bi @icon"></i></span><div><div class="text-muted small">@label</div><strong>@value</strong></div></div></div>;

    private RenderFragment RenderCompany(OrganizationCompanyNodeDto company, int depth) => @<div class="org-tree-node" style="--tree-depth:@depth"><article class="org-node-card is-company"><div class="org-node-main"><div class="org-node-title"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(CompanyKey(company.Id))" title="@ToggleNodeTooltip(CompanyKey(company.Id))" aria-label="@ToggleNodeTooltip(CompanyKey(company.Id))"><i class="@ChevronIcon(CompanyKey(company.Id))"></i></button><span class="org-node-icon text-primary"><i class="bi bi-buildings"></i></span><div><div class="org-node-name">@Name(company.Name, company.NameEng)</div><div class="org-node-meta"><span>@company.Code</span><span>@T("Branches", "الفروع"): @company.BranchCount</span><span>@T("Administrations", "الإدارات"): @company.AdministrationCount</span><span>@T("Departments", "الأقسام"): @company.DepartmentCount</span><span class="@StatusBadgeClass(company.IsActive)">@(company.IsActive ? T("Active", "نشط") : T("Inactive", "غير نشط"))</span></div></div></div><div class="org-node-actions">@CompanyActions(company)</div></div>@if (IsExpanded(CompanyKey(company.Id))) { <div class="org-node-children">@if (!company.Administrations.Any(AdminVisible) && !company.Branches.Any(BranchVisible) && !company.ChildCompanies.Any(CompanyVisible)) { <div class="org-node-empty">@T("No visible structure under this company.", "لا يوجد هيكل ظاهر تحت هذه الشركة.")</div> } @foreach (var administration in company.Administrations.Where(AdminVisible)) { @RenderAdministration(administration, depth + 1) } @foreach (var branch in company.Branches.Where(BranchVisible)) { @RenderBranch(branch, depth + 1) } @foreach (var child in company.ChildCompanies.Where(CompanyVisible)) { @RenderCompany(child, depth + 1) }</div>}</article></div>;
    private RenderFragment CompanyActions(OrganizationCompanyNodeDto company) => @<text>@if (company.ParentCompanyId is null && CanCreateChildCompany) { <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenCreateCompany(company)" title="@T("Add child company", "إضافة شركة تابعة")" aria-label="@T("Add child company", "إضافة شركة تابعة")"><i class="bi bi-building-add"></i></button> } @if (company.ParentCompanyId.HasValue && CanEditChildCompany) { <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditCompany(company)" title="@T("Edit child company", "تعديل الشركة التابعة")" aria-label="@T("Edit child company", "تعديل الشركة التابعة")"><i class="bi bi-pencil-square"></i></button> } @if (company.ParentCompanyId.HasValue && CanDisableChildCompany) { <button class="btn btn-outline-warning btn-sm" @onclick="() => ToggleChildCompanyStatusAsync(company)" title="@T("Change company status", "تغيير حالة الشركة")" aria-label="@T("Change company status", "تغيير حالة الشركة")"><i class="bi bi-slash-circle"></i></button> } @if (company.ParentCompanyId.HasValue && CanResetChildAdminPassword) { <button class="btn btn-outline-secondary btn-sm" @onclick="() => OpenResetPassword(company)" title="@T("Reset admin password", "إعادة تعيين كلمة مرور المدير")" aria-label="@T("Reset admin password", "إعادة تعيين كلمة مرور المدير")"><i class="bi bi-key"></i></button> } @if (CanCreateBranch) { <button class="btn btn-outline-info btn-sm" @onclick="() => OpenCreateBranch(company)" title="@T("Add branch", "إضافة فرع")" aria-label="@T("Add branch", "إضافة فرع")"><i class="bi bi-diagram-2"></i></button> } @if (CanCreateAdministration) { <button class="btn btn-outline-success btn-sm" @onclick="() => OpenCreateCompanyAdministration(company)" title="@T("Add administration", "إضافة إدارة")" aria-label="@T("Add administration", "إضافة إدارة")"><i class="bi bi-kanban"></i></button> }</text>;

    private RenderFragment RenderBranch(OrganizationBranchNodeDto branch, int depth) => @<div class="org-tree-node" style="--tree-depth:@depth"><article class="org-node-card is-branch"><div class="org-node-main"><div class="org-node-title"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(BranchKey(branch.Id))" title="@ToggleNodeTooltip(BranchKey(branch.Id))" aria-label="@ToggleNodeTooltip(BranchKey(branch.Id))"><i class="@ChevronIcon(BranchKey(branch.Id))"></i></button><span class="org-node-icon text-info"><i class="bi bi-diagram-2"></i></span><div><div class="org-node-name">@Name(branch.Name, branch.NameEng)</div><div class="org-node-meta"><span>@branch.Code</span><span>@branch.Location</span><span>@T("Administrations", "الإدارات"): @branch.AdministrationCount</span><span>@T("Departments", "الأقسام"): @branch.DepartmentCount</span>@if (branch.IsMainBranch) { <span class="badge rounded-pill text-bg-primary">@T("Main", "رئيسي")</span> } @if (branch.Specialization == BranchSpecialization.StoreFront) { <span class="badge rounded-pill text-bg-info">@T("StoreFront", "واجهة متجر")</span> }</div></div></div><div class="org-node-actions">@BranchActions(branch)</div></div>@if (IsExpanded(BranchKey(branch.Id))) { <div class="org-node-children">@if (!branch.Administrations.Any(AdminVisible)) { <div class="org-node-empty">@T("No administrations under this branch.", "لا توجد إدارات تحت هذا الفرع.")</div> } @foreach (var administration in branch.Administrations.Where(AdminVisible)) { @RenderAdministration(administration, depth + 1) }</div>}</article></div>;
    private RenderFragment BranchActions(OrganizationBranchNodeDto branch) => @<text>@if (CanCreateAdministration) { <button class="btn btn-outline-success btn-sm" @onclick="() => OpenCreateBranchAdministration(branch)" title="@T("Add administration", "إضافة إدارة")" aria-label="@T("Add administration", "إضافة إدارة")"><i class="bi bi-kanban"></i></button> } @if (CanEditBranch) { <button class="btn btn-outline-primary btn-sm" @onclick="() => OpenEditBranch(branch)" title="@T("Edit branch", "تعديل الفرع")" aria-label="@T("Edit branch", "تعديل الفرع")"><i class="bi bi-pencil-square"></i></button> } @if (CanDeleteBranch && !branch.IsMainBranch) { <button class="btn btn-outline-danger btn-sm" @onclick="() => ConfirmDeleteBranchAsync(branch)" title="@T("Delete branch", "حذف الفرع")" aria-label="@T("Delete branch", "حذف الفرع")"><i class="bi bi-trash"></i></button> }</text>;

    private RenderFragment RenderAdministration(OrganizationAdministrationNodeDto administration, int depth) => @<div class="org-tree-node" style="--tree-depth:@depth"><article class="org-node-card is-administration"><div class="org-node-main"><div class="org-node-title"><button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => Toggle(AdminKey(administration.Id))" title="@ToggleNodeTooltip(AdminKey(administration.Id))" aria-label="@ToggleNodeTooltip(AdminKey(administration.Id))"><i class="@ChevronIcon(AdminKey(administration.Id))"></i></button><span class="org-node-icon text-success"><i class="bi bi-kanban"></i></span><div><div class="org-node-name">@Name(administration.Name, administration.NameEng)</div><div class="org-node-meta"><span>@administration.Code</span><span>@T("Departments", "الأقسام"): @administration.DepartmentCount</span>@if (administration.IsHigherManagement) { <span class="badge rounded-pill text-bg-primary">@T("Higher Management", "إدارة عليا")</span> }<span class="@StatusBadgeClass(administration.IsActive)">@(administration.IsActive ? T("Active", "نشط") : T("Inactive", "غير نشط"))</span></div></div></div><div class="org-node-actions">@AdministrationActions(administration)</div></div>@if (IsExpanded(AdminKey(administration.Id))) { <div class="org-node-children">@if (!administration.ChildAdministrations.Any(AdminVisible) && !administration.Departments.Any(DepartmentVisible)) { <div class="org-node-empty">@T("No child administrations or departments.", "لا توجد إدارات تابعة أو أقسام.")</div> } @foreach (var child in administration.ChildAdministrations.Where(AdminVisible)) { @RenderAdministration(child, depth + 1) } @foreach (var department in administration.Departments.Where(DepartmentVisible)) { @RenderDepartment(department, depth + 1) }</div>}</article></div>;
