@layout AdminLayout
@page "/organization/Branch/Form/{Id:guid?}"
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization

@inject IBranchService BranchService
@inject ToastService ToastService
@inject ModalService ModalService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Branch Form", "نموذج الفرع")"
                Subtitle="@Text("Create or edit branch identity, contact, and location details.", "إنشاء أو تعديل بيانات الفرع والتواصل والموقع.")"
                Overline="@Text("Organization", "المنظمة")"
                Icon="bi-diagram-2">
        <Actions>
            <a class="btn btn-outline-primary" href="/Organization/Branch/List">
                <i class="bi bi-arrow-left"></i>
                @Text("Back to Branches", "العودة للفروع")
            </a>
        </Actions>
    </PageHeader>

    <AppCard Title="@Text("Branch Details", "بيانات الفرع")"
             Subtitle="@Text("Use clear bilingual names and contact information for ERP records.", "استخدم أسماء ثنائية اللغة وبيانات اتصال واضحة لسجلات النظام.")">
        <EditForm Model="branchDto" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="row g-3">
                <div class="col-md-6">
                    <label for="inputName" class="form-label">@Text("Name", "الاسم")</label>
                    <InputText class="form-control" id="inputName" placeholder="@Text("Name", "الاسم")" @bind-Value="branchDto.Name" />
                    <ValidationMessage For="() => branchDto.Name" />
                </div>

                <div class="col-md-6">
                    <label for="inputNameEng" class="form-label">@Text("English Name", "الاسم بالانجليزية")</label>
                    <InputText class="form-control" id="inputNameEng"
                               @bind-Value="branchDto.NameEng"
                               placeholder="@Text("English Name", "الاسم بالانجليزية")" />
                    <ValidationMessage For="() => branchDto.NameEng" />
                </div>

                <div class="col-12">
                    <label for="inputLocation" class="form-label">@Text("Location", "الموقع")</label>
                    <InputText class="form-control" id="inputLocation" placeholder="@Text("Location", "الموقع")" @bind-Value="branchDto.Location" />
                    <ValidationMessage For="() => branchDto.Location" />
                </div>

                <div class="col-md-6">
                    <label for="inputLongitude" class="form-label">@Text("Longitude", "خط الطول")</label>
                    <InputNumber class="form-control" id="inputLongitude"
                                 @bind-Value="branchDto.Longitude"
                                 placeholder="@Text("Longitude", "خط الطول")" />
                    <ValidationMessage For="() => branchDto.Longitude" />
                </div>

                <div class="col-md-6">
                    <label for="inputLatitude" class="form-label">@Text("Latitude", "خط العرض")</label>
                    <InputNumber class="form-control" id="inputLatitude"
                                 @bind-Value="branchDto.Latitude"
                                 placeholder="@Text("Latitude", "خط العرض")" />
                    <ValidationMessage For="() => branchDto.Latitude" />
                </div>

                <div class="col-md-6">
                    <label for="inputPhone" class="form-label">@Text("Phone", "الهاتف")</label>
                    <InputText class="form-control" id="inputPhone"
                               @bind-Value="branchDto.Phone"
                               placeholder="@Text("Phone", "الهاتف")" />
                    <ValidationMessage For="() => branchDto.Phone" />
                </div>

                <div class="col-md-6">
                    <label for="inputEmail" class="form-label">@Text("Email", "الايميل")</label>
                    <InputText class="form-control" id="inputEmail"
                               @bind-Value="branchDto.Email"
                               placeholder="@Text("Email", "الايميل")" />
                    <ValidationMessage For="() => branchDto.Email" />
                </div>

                <div class="col-12">
                    <div class="form-check erp-form-check-panel">
                        <input class="form-check-input" checked="@branchDto.IsMainBranch" @bind-value="branchDto.IsMainBranch" type="checkbox" id="gridCheck1">
                        <label class="form-check-label" for="gridCheck1">
                            @Text("Main Branch?", "الفرع الرئيسي؟")
                        </label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary" @onclick="OnCancel">@Text("Cancel", "إلغاء")</button>
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check2"></i>
                    @Text("Save", "حفظ")
                </button>
            </div>
        </EditForm>
    </AppCard>
</div>

<style>
    .erp-form-check-panel {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-md);
        display: inline-flex;
        gap: .5rem;
        padding: .75rem 1rem;
    }

    .erp-form-check-panel .form-check-input {
        margin: 0;
    }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    private BranchDto branchDto = new();
    private Guid companyId;
    private AuthenticationState AuthState;

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (!CompanyContext.TryGetCompanyId(AuthState.User, out companyId))
        {
            NavigationManager.NavigateTo("/Dashboard");
            return;
        }
    }

    private async Task HandleSubmit()
    {
        if (!Id.HasValue)
        {
            Random random = new Random();
            branchDto.Code = branchDto.NameEng.Substring(0, 1) + random.Next(100, 999).ToString();
            branchDto.CompanyId = companyId;
            var bResponse = await BranchService.CreateAsync(branchDto);
            if (bResponse.IsSuccess)
            {
                ToastService.Show(new ToastMessage
                {
                    Message = "Saved successfully",
                    Type = "success"
                });
                NavigationManager.NavigateTo("Organization/Branch/List");
            }
            else
            {
                await ModalService.ShowAsync(new ModalOptions
                {
                    Title = "Error",
                    Message = "Something went wrong",
                    Details = bResponse.Error?.Detail ?? "",
                    IsError = true,
                    OnOk = async () =>
                    {

                    }
                });
            }
        }
        else
        {
            // Update behavior was not implemented in the original page.
        }
    }

    private void OnCancel()
    {
        NavigationManager.NavigateTo("/Organization/Branch/List");
    }

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
