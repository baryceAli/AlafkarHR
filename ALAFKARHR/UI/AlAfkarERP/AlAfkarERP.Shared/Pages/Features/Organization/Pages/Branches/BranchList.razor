@layout AdminLayout
@page "/Organization/Branch/List"
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Permissions


@inject IBranchService BranchService
@inject ICompanySettingService CompanySettingService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject IJSRuntime JSRuntime

@if (AuthState is null)
{
    <div class="branches-page">
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@Text("Loading branches...", "جاري تحميل الفروع...")</div>
            </div>
        </div>
    </div>

    return;
}

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.SpecializationPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>@SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحية لعرض هذه الصفحة")</span>
    </div>
    return;
}

<div class="branches-page">
    <div class="branches-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Organization", "المنظمة")</div>
            <h3 class="mb-1">@Text("Branches Management", "ادارة الفروع")</h3>
            <div class="text-muted">@Text("Manage branch contact details, locations, and main branch assignment.", "ادارة بيانات الاتصال والمواقع وتحديد الفرع الرئيسي.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary"
                    @onclick="LoadBranches"
                    disabled="@(editingBranchId is not null)">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled="@(!CanCreateBranch)">
                <i class="bi bi-plus-lg"></i>
                @Text("Create New", "إضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="branch-stat border-primary">
                <div class="branch-stat-icon text-primary"><i class="bi bi-diagram-2"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Branches", "الفروع المعروضة")</div>
                    <div class="branch-stat-value">@branches.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-success">
                <div class="branch-stat-icon text-success"><i class="bi bi-star-fill"></i></div>
                <div>
                    <div class="text-muted small">@Text("Main Branches", "الفروع الرئيسية")</div>
                    <div class="branch-stat-value">@branches.Count(b => b.IsMainBranch)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="branch-stat border-info">
                <div class="branch-stat-icon text-info"><i class="bi bi-geo-alt-fill"></i></div>
                <div>
                    <div class="text-muted small">@Text("With Coordinates", "لديها احداثيات")</div>
                    <div class="branch-stat-value">@branches.Count(HasCoordinates)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="branch-toolbar mb-3">
                <div class="branch-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search by name or email...", "بحث بالاسم او البريد...")"
                           @bind="searchText"
                           @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown" />
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select branch-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>

            <div class="table-responsive branch-table-wrap">
                <table class="table branch-table align-middle mb-0">
                    <thead>
                        <tr>
                            <th @onclick="() => Sort(nameof(BranchDto.Name))" class="sortable">
                                @Text("Name", "الاسم")
                                <i class="@SortIcon(nameof(BranchDto.Name))"></i>
                            </th>
                            <th @onclick="() => Sort(nameof(BranchDto.NameEng))" class="sortable">
                                @Text("Name (English)", "الاسم بالانجليزية")
                                <i class="@SortIcon(nameof(BranchDto.NameEng))"></i>
                            </th>
                            <th>@Text("Contact", "التواصل")</th>
                            <th @onclick="() => Sort(nameof(BranchDto.Location))" class="sortable">
                                @Text("Location", "الموقع")
                                <i class="@SortIcon(nameof(BranchDto.Location))"></i>
                            </th>
                            <th>@Text("Coordinates", "الاحداثيات")</th>
                            <th>@Text("Status", "الحالة")</th>
                            <th class="text-end">@Text("Actions", "العمليات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (editingBranchId != null)
                        {
                            var branch = branches.FirstOrDefault(b => b.Id == editingBranchId);
                            if (branch is not null)
                            {
                                <tr class="branch-edit-row">
                                    <td colspan="7">
                                        <EditForm Model="branch" OnValidSubmit="() => SaveBranch(branch)">
                                            <DataAnnotationsValidator />
                                            <div class="branch-edit-panel">
                                                <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                                    <div>
                                                        <h5 class="mb-1">@Text(isEdit ? "Edit Branch" : "Create Branch", isEdit ? "تعديل الفرع" : "اضافة فرع")</h5>
                                                        <div class="text-muted small">@Text("Update branch identity, contact, and location details.", "تحديث بيانات الفرع والتواصل والموقع.")</div>
                                                    </div>
                                                    <span class="badge text-bg-light">@Text("Inline Form", "نموذج داخلي")</span>
                                                </div>

                                                <div class="row g-3">
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Name", "الاسم")</label>
                                                        <InputText class="form-control" @bind-Value="branch.Name" />
                                                        <ValidationMessage For="() => branch.Name" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Name (English)", "الاسم (انجليزي)")</label>
                                                        <InputText class="form-control" @bind-Value="branch.NameEng" />
                                                        <ValidationMessage For="() => branch.NameEng" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Phone", "الهاتف")</label>
                                                        <InputText class="form-control" @bind-Value="branch.Phone" />
                                                        <ValidationMessage For="() => branch.Phone" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Email", "الايميل")</label>
                                                        <InputText class="form-control" @bind-Value="branch.Email" />
                                                        <ValidationMessage For="() => branch.Email" />
                                                    </div>
                                                    <div class="col-12">
                                                        <label class="form-label">@Text("Location", "الموقع")</label>
                                                        <InputText class="form-control" @bind-Value="branch.Location" />
                                                        <ValidationMessage For="() => branch.Location" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Longitude", "خط الطول")</label>
                                                        <InputNumber class="form-control" @bind-Value="branch.Longitude" />
                                                        <ValidationMessage For="() => branch.Longitude" />
                                                    </div>
                                                    <div class="col-md-6">
                                                        <label class="form-label">@Text("Latitude", "خط العرض")</label>
                                                        <InputNumber class="form-control" @bind-Value="branch.Latitude" />
                                                        <ValidationMessage For="() => branch.Latitude" />
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                                            <label class="form-label mb-0">@Text("Pick Branch Location", "اختيار موقع الفرع")</label>
                                                            <div class="d-flex flex-wrap gap-2">
                                                                <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomOutMapAsync" title="@Text("Zoom Out", "تصغير")">
                                                                    <i class="bi bi-dash-lg"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomInMapAsync" title="@Text("Zoom In", "تكبير")">
                                                                    <i class="bi bi-plus-lg"></i>
                                                                </button>
                                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CenterMapFromBranchAsync">
                                                                    <i class="bi bi-crosshair"></i>
                                                                    @Text("Center from Fields", "توسيط من الحقول")
                                                                </button>
                                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="UseCurrentLocationAsync">
                                                                    <i class="bi bi-geo-alt"></i>
                                                                    @Text("Use Current Location", "استخدام موقعي")
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div id="@mapElementId" class="branch-map"></div>
                                                        <div class="text-muted small mt-2">
                                                            @Text("Click the map to update longitude and latitude.", "اضغط على الخريطة لتحديث خط الطول وخط العرض.")
                                                        </div>
                                                    </div>
                                                    <div class="col-12">
                                                        <div class="form-check branch-check">
                                                            <InputCheckbox class="form-check-input"
                                                                           Value="branch.IsMainBranch"
                                                                           ValueChanged="value => OnMainBranchChanged(branch, value)"
                                                                           ValueExpression="() => branch.IsMainBranch" />
                                                            <label class="form-check-label">@Text("Main Branch", "الفرع الرئيسي")</label>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="d-flex justify-content-end gap-2 mt-4">
                                                    <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">
                                                        @Text("Cancel", "إلغاء")
                                                    </button>
                                                    <button type="submit" class="btn btn-success">
                                                        <i class="bi bi-check2"></i>
                                                        @Text("Save", "حفظ")
                                                    </button>
                                                </div>
                            </div>
                        </EditForm>
                    </td>
                </tr>
                            }
            }
                
            @foreach (var branch in BranchesForDisplay.Where(b => b.Id != editingBranchId))
            {
                
                <tr>
                    <td>
                        <div class="fw-semibold">@EmptyValue(branch.Name)</div>
                        <div class="text-muted small">@EmptyValue(branch.Code)</div>
                    </td>
                    <td>@EmptyValue(branch.NameEng)</td>
                    <td>
                        <div class="branch-contact-line"><i class="bi bi-telephone"></i> @EmptyValue(branch.Phone)</div>
                        <div class="branch-contact-line"><i class="bi bi-envelope"></i> @EmptyValue(branch.Email)</div>
                    </td>
                    <td>
                        <div class="branch-location">
                            <i class="bi bi-geo-alt"></i>
                            <span>@EmptyValue(branch.Location)</span>
                        </div>
                    </td>
                    <td>
                        @if (HasCoordinates(branch))
                        {
                            <div class="small">@branch.Latitude</div>
                            <div class="text-muted small">@branch.Longitude</div>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (branch.IsMainBranch)
                        {
                            <span class="badge rounded-pill text-bg-primary">@Text("Main", "رئيسي")</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill text-bg-light">@Text("Branch", "فرع")</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm branch-action"
                                @onclick="() => EditBranch(branch.Id)"
                                    disabled="@(!CanEditBranch)"
                                    title="@Text("Edit", "تعديل")">
                                <i class="bi bi-pencil-square"></i>
                        </button>
                            <button class="btn btn-outline-danger btn-sm branch-action"
                                @onclick="() => DeleteBranch(branch)"
                                    disabled="@(!CanDeleteBranch)"
                                    title="@Text("Delete", "حذف")">
                                <i class="bi bi-trash"></i>
                        </button>
                        </div>
                    </td>
                </tr>
                
            }
                        @if (!BranchesForDisplay.Any() && editingBranchId is null)
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="branch-empty">
                                        <i class="bi bi-inboxes"></i>
                                        <div class="fw-semibold">@Text("No branches found", "لم يتم العثور على فروع")</div>
                                        <div class="text-muted small">@Text("Try changing the search text or create a new branch.", "جرّب تغيير البحث او اضافة فرع جديد.")</div>
                                    </div>
                                </td>
                            </tr>
                        }
        </tbody>
    </table>
            </div>

            <div class="branch-pagination">
                <div class="text-muted small">
                    @Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @Math.Max(TotalPages, 1)
                    <span class="mx-1">•</span>
                    @Text("Total", "الإجمالي") @totalCount
                </div>
                <div class="d-flex gap-2">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                            disabled="@(pageIndex == 0)">
                        <i class="bi bi-chevron-left"></i>
                        @Text("Previous", "السابق")
        </button>

                    <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                            disabled="@(pageIndex >= TotalPages - 1)">
                        @Text("Next", "التالي")
                        <i class="bi bi-chevron-right"></i>
        </button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .branches-page {
        max-width: 1400px;
    }

    .branches-header {
        align-items: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
    }

    .branch-stat {
        align-items: center;
        background: #fff;
        border-left: 4px solid;
        border-radius: 8px;
        box-shadow: 0 0.125rem 0.35rem rgba(15, 23, 42, 0.08);
        display: flex;
        gap: 0.875rem;
        min-height: 88px;
        padding: 1rem;
    }

    .branch-stat-icon {
        align-items: center;
        background: #f8f9fa;
        border-radius: 8px;
        display: inline-flex;
        font-size: 1.35rem;
        height: 44px;
        justify-content: center;
        width: 44px;
    }

    .branch-stat-value {
        color: #212529;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .branch-toolbar {
        align-items: center;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
    }

    .branch-search {
        max-width: 420px;
        position: relative;
        width: min(100%, 420px);
    }

    .branch-search i {
        color: #6c757d;
        left: 0.875rem;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .branch-search .form-control {
        padding-left: 2.5rem;
    }

    .branch-page-size {
        min-width: 82px;
    }

    .branch-table-wrap {
        border: 1px solid #e9ecef;
        border-radius: 8px;
    }

    .branch-table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: 0.8125rem;
        font-weight: 700;
