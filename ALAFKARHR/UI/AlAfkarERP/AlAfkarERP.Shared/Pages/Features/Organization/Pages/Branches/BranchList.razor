</style>

@code {
    private List<BranchDto> branches = new();
    private Guid? editingBranchId;
    private Guid companyId;
    private bool isEdit = false;
    private AuthenticationState? AuthState;
    private CompanySettingDto? companySetting;
    private readonly string mapElementId = $"branch-location-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<BranchList>? dotNetReference;
    private Guid? mapInitializedBranchId;
    private bool CanCreateBranch => AuthState?.User.Claims.Any(c => c.Value == $"{PermissionList.BranchPermissions.Create}") == true;
    private bool CanEditBranch => AuthState?.User.Claims.Any(c => c.Value == $"{PermissionList.BranchPermissions.Edit}") == true;
    private bool CanDeleteBranch => AuthState?.User.Claims.Any(c => c.Value == $"{PermissionList.BranchPermissions.Delete}") == true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (editingBranchId is not null && mapInitializedBranchId != editingBranchId)
        {
            var branch = branches.FirstOrDefault(b => b.Id == editingBranchId);
            if (branch is not null)
            {
                dotNetReference ??= DotNetObjectReference.Create(this);
                await JSRuntime.InvokeVoidAsync(
                    "alafkarLocationPicker.init",
                    mapElementId,
                    MapLatitude(branch),
                    MapLongitude(branch),
                    dotNetReference);
                mapInitializedBranchId = editingBranchId;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        AuthState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
        if (AuthState.User.Identity?.IsAuthenticated != true)
        {
            NavigationManager.NavigateTo("/login", true);

        }
        companyId = Guid.Parse(AuthState.User.Claims.First(c => c.Type == "company_id").Value);

        var settingResult = await CompanySettingService.GetAsync(companyId);
        if (settingResult.IsSuccess)
        {
            companySetting = settingResult.Data;
        }

        await LoadBranches();
        // var branchResponse = await BranchService.GetByCompanyIdAsync(companyId);
        // if (branchResponse.IsSuccess)
        // {
        //     branches = branchResponse.Data?.ToList() ?? [];
        // }
    }
    // Branch
    void CreateNew()
    {
        var newItem = new BranchDto()
        {
            Id = Guid.NewGuid()
        };
        newItem.Code = "b";
        branches.Insert(0, newItem);
        editingBranchId = newItem.Id;
        mapInitializedBranchId = null;
        isEdit = false;
    }

    void EditBranch(Guid id)
    {
        editingBranchId = id;
        mapInitializedBranchId = null;
        isEdit = true;
    }

    private void OnMainBranchChanged(BranchDto selectedBranch, bool isMainBranch)
    {
        selectedBranch.IsMainBranch = isMainBranch;

        if (!isMainBranch)
        {
            return;
        }

        foreach (var branch in branches.Where(branch => branch.Id != selectedBranch.Id))
        {
            branch.IsMainBranch = false;
        }
    }

    async Task SaveBranch(BranchDto branch)
    {
        if (branch.Id == editingBranchId && !isEdit)
        {
            //Create new

            Random rnd = new Random();
            branch.Code = branch.NameEng.Substring(0, 1) + rnd.Next(100, 999);
            branch.CompanyId = companyId;

            var bResponse = await BranchService.CreateAsync(branch);
            if (bResponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Branch has been created successfully", "تم انشاء الفرع بنجاح"),
                    Type = "success"
                });

            }
            else
            {
                // how fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }
        else
        {
            //Edit

            var bresponse = await BranchService.UpdateAsync(branch);
            if (bresponse.IsSuccess)
            {
                //show success
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Branch has been Edited successfully", "تم تعديل الفرع بنجاح"),
                    Type = "success"
                });
            }
            else
            {
                // show  fail
                ToastService.Show(new ToastMessage
                {
                    Message = SharedDataService.SelectViewLang("Error has occured, please try again later", "حدث خطأ، الرجاء المحاولة مرة أخرى"),
                    Type = "error"
                });
            }
        }

        await LoadBranches();
        // var response = await BranchService.GetByCompanyIdAsync(companyId);
        // if (response.IsSuccess)
        // {
        //     branches = response.Data?.ToList() ?? [];
        // }
        editingBranchId = null;
        mapInitializedBranchId = null;
    }

    async Task DeleteBranch(BranchDto branch)
    {
        await ModalService.ShowAsync(new ModalOptions
        {
            Title = SharedDataService.SelectViewLang("Confirm Delete", "تأكيد عملية الحذف"),
            Message = SharedDataService.SelectViewLang($"Are you sure you want to delete this branch: {branch.NameEng}?", $"هل ترغب فعلا في حذف الفرع: {branch.Name}؟"),
            ShowCancel = true,
            OkText = SharedDataService.SelectViewLang("Yes", "نعم"),
            CancelText = SharedDataService.SelectViewLang("No", "لا"),

            OnOk = async () =>
            {
                var brResponse = await BranchService.DeleteAsync(branch.Id);
                if (brResponse.IsSuccess)
                {

                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Deleted successfully", "تم الحذف بنجاح"),
                        Type = "success"
                    });

                    await LoadBranches();
                    // var response = await BranchService.GetByCompanyIdAsync(companyId);
                    // if (response.IsSuccess)
                    // {
                    //     branches = response.Data?.ToList() ?? [];
                    //     await InvokeAsync(StateHasChanged);
                    // }
                }
                else
                {
                    ToastService.Show(new ToastMessage
                    {
                        Message = SharedDataService.SelectViewLang("Fail to delete the branch", "فشلت عملية الحذف"),
                        Type = "error"
                    });
                }


            }
        });


    }
    async Task CancelEdit()
    {


        //new
        // branch
        var item = branches.FirstOrDefault(x => x.Id == editingBranchId);

        if (item != null && item.Id != Guid.Empty)
        {
            // existing record → keep it
            await LoadBranches();
        }
        else
        {
            // new record → remove it
            branches.Remove(item);
        }
        isEdit = false;
        editingBranchId = null;
        mapInitializedBranchId = null;
    }

    #region Table Helpers


    // Searching
    private string searchText = "";
    private string appliedSearchText = "";

    // Sorting
    private string sortColumn = nameof(BranchDto.Name);
    private bool sortAscending = true;

    // Pagination
    private int pageSize = 5;
    private int pageIndex = 0;
    private long totalCount;
    private async Task LoadBranches()
    {
        var response = await BranchService.GetByCompanyIdAsync(companyId, pageIndex, pageSize, appliedSearchText);

        if (response.IsSuccess)
        {
            branches = response.Data?.Data.ToList() ?? [];
            totalCount = response.Data?.Count ?? 0;
            TotalPages = Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
            if (pageIndex >= TotalPages)
            {
                pageIndex = TotalPages - 1;
                await LoadBranches();
            }
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter")
        {
            return;
        }

        appliedSearchText = searchText.Trim();
        pageIndex = 0;
        editingBranchId = null;
        mapInitializedBranchId = null;
        await LoadBranches();
    }

    async Task OnPageSizeChanged(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value!.ToString()!);
        pageIndex = 0;
        await LoadBranches();
    }
    private IEnumerable<BranchDto> BranchesForDisplay => branches.OrderByDynamic(sortColumn, sortAscending);



    private int TotalPages = 1;

    async Task NextPage()
    {
        if (pageIndex < TotalPages - 1)
        {
            pageIndex++;
            await LoadBranches();
        }
    }

    async Task PrevPage()
    {
        if (pageIndex > 0)
        {
            pageIndex--;
            await LoadBranches();
        }
    }

    void Sort(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private string EmptyValue(string? value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static bool HasCoordinates(BranchDto branch)
        => branch.Latitude != 0 || branch.Longitude != 0;

    private string SortIcon(string column)
        => sortColumn != column
            ? "bi bi-arrow-down-up"
            : sortAscending ? "bi bi-arrow-up" : "bi bi-arrow-down";

    private BranchDto? EditingBranch =>
        editingBranchId is null ? null : branches.FirstOrDefault(branch => branch.Id == editingBranchId);

    private double MapLatitude(BranchDto branch)
        => branch.Latitude is > 0
            ? branch.Latitude
            : companySetting?.DefaultLatitude is > 0 ? companySetting.DefaultLatitude : 24.7136;

    private double MapLongitude(BranchDto branch)
        => branch.Longitude is > 0
            ? branch.Longitude
            : companySetting?.DefaultLongitude is > 0 ? companySetting.DefaultLongitude : 46.6753;

    private async Task CenterMapFromBranchAsync()
    {
        var branch = EditingBranch;
        if (branch is null || mapInitializedBranchId is null)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "alafkarLocationPicker.setCenter",
            mapElementId,
            MapLatitude(branch),
            MapLongitude(branch),
            false);
    }

    private async Task UseCurrentLocationAsync()
    {
        if (mapInitializedBranchId is null)
        {
            return;
        }

        var isSupported = await JSRuntime.InvokeAsync<bool>("alafkarLocationPicker.useCurrentLocation", mapElementId);
        if (!isSupported)
        {
            ToastService.Show(new ToastMessage
            {
                Type = "warning",
                Message = Text("Current location is not supported in this browser.", "الموقع الحالي غير مدعوم في هذا المتصفح.")
            });
        }
    }

    private async Task ZoomInMapAsync()
    {
        if (mapInitializedBranchId is not null)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomIn", mapElementId);
        }
    }

    private async Task ZoomOutMapAsync()
    {
        if (mapInitializedBranchId is not null)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomOut", mapElementId);
        }
    }

    [JSInvokable]
    public async Task OnMapLocationSelected(double latitude, double longitude)
    {
        var branch = EditingBranch;
        if (branch is null)
        {
            return;
        }

        branch.Latitude = Math.Round(latitude, 6);
        branch.Longitude = Math.Round(longitude, 6);
        await InvokeAsync(StateHasChanged);
    }
    #endregion Table helpers

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (mapInitializedBranchId is not null)
        {
            _ = JSRuntime.InvokeVoidAsync("alafkarLocationPicker.dispose", mapElementId);
        }

        dotNetReference?.Dispose();
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
