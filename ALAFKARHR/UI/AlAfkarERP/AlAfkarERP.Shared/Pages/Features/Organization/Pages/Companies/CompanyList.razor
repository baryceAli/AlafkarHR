    [JSInvokable]
    public async Task OnMapLocationSelected(double latitude, double longitude)
    {
        if (company is null)
        {
            return;
        }

        company.HqLatitude = Math.Round(latitude, 6);
        company.HqLongitude = Math.Round(longitude, 6);
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private string DisplayName(string? name, string? nameEng)
        => SharedDataService.Language == "Ar"
            ? FirstNotEmpty(name, nameEng)
            : FirstNotEmpty(nameEng, name);

    private static string EmptyValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FirstNotEmpty(string? primary, string? fallback)
        => !string.IsNullOrWhiteSpace(primary)
            ? primary
            : !string.IsNullOrWhiteSpace(fallback) ? fallback : "-";

    private double MapLatitude => company?.HqLatitude is > 0
        ? company.HqLatitude
        : companySetting?.DefaultLatitude is > 0 ? companySetting.DefaultLatitude : 24.7136;

    private double MapLongitude => company?.HqLongitude is > 0
        ? company.HqLongitude
        : companySetting?.DefaultLongitude is > 0 ? companySetting.DefaultLongitude : 46.6753;

    private async Task HandleLanguageChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (mapInitialized)
        {
            _ = JSRuntime.InvokeVoidAsync("alafkarLocationPicker.dispose", mapElementId);
        }

        dotNetReference?.Dispose();
        SharedDataService.OnChange1 -= HandleLanguageChangeAsync;
    }
