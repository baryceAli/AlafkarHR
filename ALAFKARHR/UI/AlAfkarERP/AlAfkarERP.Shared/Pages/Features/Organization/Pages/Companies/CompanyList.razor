<div class="company-profile erp-page">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h3 class="mb-1">@Text("Company Profile", "ملف الشركة")</h3>
            <div class="text-muted">@Text("Manage core company information used across the organization.", "إدارة بيانات الشركة الأساسية المستخدمة في النظام.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Organization/Dashboard" class="btn btn-outline-primary">
                <i class="bi bi-diagram-3"></i>
                @Text("Structure", "الهيكل")
            </a>
            <button class="btn btn-primary" @onclick="LoadCompanyAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a href="/Organization/Branch/List" class="text-decoration-none">
                <div class="profile-link border-primary">
                    <i class="bi bi-diagram-2"></i>
                    <span>@Text("Branches", "الفروع")</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Organization/Administration/List" class="text-decoration-none">
                <div class="profile-link border-success">
                    <i class="bi bi-kanban"></i>
                    <span>@Text("Administrations", "الإدارات")</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Organization/Department/List" class="text-decoration-none">
                <div class="profile-link border-warning">
                    <i class="bi bi-grid-1x2"></i>
                    <span>@Text("Departments", "الأقسام")</span>
                </div>
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@Text("Loading company profile...", "جاري تحميل ملف الشركة...")</div>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }
