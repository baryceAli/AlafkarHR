    private void PrepareChildCompanyModel()
    {
        if (company is null || company.ParentCompanyId.HasValue)
        {
            childCompany = null;
            showChildCompanyForm = false;
            return;
        }

        childCompany = new CompanyDto
        {
            ParentCompanyId = company.Id,
            Currency = company.Currency,
            TimeZone = company.TimeZone,
            HqLocation = company.HqLocation,
            HqLatitude = company.HqLatitude,
            HqLongitude = company.HqLongitude,
            Logo = string.Empty
        };
    }

