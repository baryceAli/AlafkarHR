@layout AdminLayout
@page "/Organization/Company/List"
@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@using AlAfkarERP.Shared.Pages.Features.GeneralSettings.Services
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.GeneralSettings.Dtos
@using SharedWithUI.Organization.Dtos
@implements IDisposable

@inject ICompanyService CompanyService
@inject ICompanySettingService CompanySettingService
@inject ICurrencyService CurrencyService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService
@inject ApiConfig ApiConfig
@inject IJSRuntime JSRuntime

<div class="company-profile erp-page" dir="@SharedDataService.PageDirection">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h3 class="mb-1">@Text("Company Profile", "ملف الشركة")</h3>
            <div class="text-muted">@Text("Manage core company information used across the organization.", "إدارة بيانات الشركة الأساسية المستخدمة في النظام.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/Organization/Dashboard" class="btn btn-outline-primary">
                <i class="bi bi-diagram-3"></i>
                @Text("Structure", "الهيكل")
            </a>
            <button class="btn btn-primary" @onclick="LoadCompanyAsync" disabled="@isLoading">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a href="/Organization/Branch/List" class="text-decoration-none">
                <div class="profile-link border-primary">
                    <i class="bi bi-diagram-2"></i>
                    <span>@Text("Branches", "الفروع")</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Organization/Administration/List" class="text-decoration-none">
                <div class="profile-link border-success">
                    <i class="bi bi-kanban"></i>
                    <span>@Text("Administrations", "الإدارات")</span>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a href="/Organization/Department/List" class="text-decoration-none">
                <div class="profile-link border-warning">
                    <i class="bi bi-grid-1x2"></i>
                    <span>@Text("Departments", "الأقسام")</span>
                </div>
            </a>
        </div>
    </div>

    @if (isLoading)
    {
        <AppCard BodyClass="py-5 text-center">
                <div class="spinner-border text-primary mb-3" role="status"></div>
                <div class="fw-semibold">@Text("Loading company profile...", "جاري تحميل ملف الشركة...")</div>
        </AppCard>
    }
    else if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@errorMessage</span>
        </div>
    }
    else if (company is null)
    {
        <AppCard BodyClass="py-5 text-center text-muted">
                @Text("No company profile was found.", "لم يتم العثور على ملف الشركة.")
        </AppCard>
    }
    else
    {
        <AppCard CssClass="mb-4">
                <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="company-logo">
                            @if (!string.IsNullOrWhiteSpace(company.Logo))
                            {
                                <img src="@CompanyLogoUrl" alt="@DisplayName(company.Name, company.NameEng)" />
                            }
                            else
                            {
                                <i class="bi bi-building"></i>
                            }
                        </div>
                        <div>
                            <div class="text-muted small">@Text("Company", "الشركة")</div>
                            <h4 class="mb-1">@DisplayName(company.Name, company.NameEng)</h4>
                            <div class="text-muted">@company.Code | @CurrencyDisplay(company.CurrencyId) | @company.TimeZone</div>
                        </div>
                    </div>
                    <div class="company-contact text-md-end">
                        <div><i class="bi bi-telephone"></i> @EmptyValue(company.Phone)</div>
                        <div><i class="bi bi-envelope"></i> @EmptyValue(company.Email)</div>
                    </div>
                </div>
        </AppCard>

        <EditForm Model="company" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <div class="row g-4">
                <div class="col-xl-8">
                    <AppCard CssClass="h-100">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0">@Text("Editable Information", "البيانات القابلة للتعديل")</h5>
                                <span class="badge text-bg-light">@Text("Saved by API", "تحفظ عبر الواجهة البرمجية")</span>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Name", "الاسم")</label>
                                    <InputText class="form-control" @bind-Value="company.Name" />
                                    <ValidationMessage For="() => company.Name" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Name (English)", "الاسم بالإنجليزية")</label>
                                    <InputText class="form-control" @bind-Value="company.NameEng" />
                                    <ValidationMessage For="() => company.NameEng" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("VAT Number", "الرقم الضريبي")</label>
                                    <InputText class="form-control" @bind-Value="company.VatNo" />
                                    <ValidationMessage For="() => company.VatNo" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Logo", "الشعار")</label>
                                    <div class="d-flex align-items-center gap-3">
                                        <label for="companyLogoUpload" class="company-logo-upload">
                                            @if (!string.IsNullOrWhiteSpace(company.Logo))
                                            {
                                                <img src="@CompanyLogoUrl" alt="@DisplayName(company.Name, company.NameEng)" />
                                            }
                                            else
                                            {
                                                <i class="bi bi-image"></i>
                                            }
                                        </label>
                                        <div>
                                            <InputFile id="companyLogoUpload"
                                                       class="erp-hidden-input"
                                                       OnChange="OnCompanyLogoSelected"
                                                       accept="image/*" />
                                            <label for="companyLogoUpload" class="btn btn-outline-primary btn-sm mb-1">
                                                <i class="bi bi-upload"></i>
                                                @Text("Upload Logo", "رفع الشعار")
                                            </label>
                                            <div class="text-muted small">@Text("PNG or JPG up to 5 MB.", "PNG أو JPG حتى 5 ميجابايت.")</div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <label class="form-label">@Text("Headquarters Location", "موقع المقر الرئيسي")</label>
                                    <InputText class="form-control" @bind-Value="company.HqLocation" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Longitude", "خط الطول")</label>
                                    <InputNumber class="form-control" @bind-Value="company.HqLongitude" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">@Text("Latitude", "خط العرض")</label>
                                    <InputNumber class="form-control" @bind-Value="company.HqLatitude" />
                                </div>
                                <div class="col-12">
                                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                        <label class="form-label mb-0">@Text("Pick Headquarters Location", "اختيار موقع المقر الرئيسي")</label>
                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomOutMapAsync" title="@Text("Zoom Out", "تصغير")">
                                                <i class="bi bi-dash-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomInMapAsync" title="@Text("Zoom In", "تكبير")">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CenterMapFromFieldsAsync">
                                                <i class="bi bi-crosshair"></i>
                                                @Text("Center from Fields", "توسيط من الحقول")
                                            </button>
                                            <button type="button" class="btn btn-outline-primary btn-sm" @onclick="UseCurrentLocationAsync">
                                                <i class="bi bi-geo-alt"></i>
                                                @Text("Use Current Location", "استخدام موقعي")
                                            </button>
                                        </div>
                                    </div>
                                    <div id="@mapElementId" class="company-map"></div>
                                    <div class="text-muted small mt-2">
                                        @Text("Click the map to update longitude and latitude.", "اضغط على الخريطة لتحديث خط الطول وخط العرض.")
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-end gap-2 mt-4">
                                <button type="button" class="btn btn-outline-secondary" @onclick="LoadCompanyAsync" disabled="@isSaving">
                                    @Text("Cancel", "إلغاء")
                                </button>
                                <button type="submit" class="btn btn-primary" disabled="@isSaving">
                                    @if (isSaving)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1" role="status"></span>
                                    }
                                    <span>@Text("Save Changes", "حفظ التغييرات")</span>
                                </button>
                            </div>
                    </AppCard>
                </div>

                <div class="col-xl-4">
                    <AppCard CssClass="h-100">
                            <h5 class="mb-3">@Text("System Details", "بيانات النظام")</h5>
                            <div class="locked-fields">
                                <div>
                                    <label>@Text("Code", "الكود")</label>
                                    <input class="form-control" value="@EmptyValue(company.Code)" disabled />
                                </div>
                                <div>
                                    <label>@Text("Currency", "العملة")</label>
                                    <input class="form-control" value="@CurrencyDisplay(company.CurrencyId)" disabled />
                                </div>
                                <div>
                                    <label>@Text("Time Zone", "المنطقة الزمنية")</label>
                                    <input class="form-control" value="@EmptyValue(company.TimeZone)" disabled />
                                </div>
                                <div>
                                    <label>@Text("Phone", "الهاتف")</label>
                                    <input class="form-control" value="@EmptyValue(company.Phone)" disabled />
                                </div>
                                <div>
                                    <label>@Text("Email", "البريد الإلكتروني")</label>
                                    <input class="form-control" value="@EmptyValue(company.Email)" disabled />
                                </div>
                            </div>
                            <div class="text-muted small mt-3">
                                @Text("These fields are shown for context because the current company update endpoint does not change them.", "تظهر هذه الحقول للمعرفة لأن واجهة تعديل الشركة الحالية لا تقوم بتغييرها.")
                            </div>
                    </AppCard>
                </div>
            </div>
        </EditForm>

    }
</div>

<style>
    .company-profile {
        max-width: 1400px;
    }

    .profile-link {
        align-items: center;
        background: var(--erp-surface);
        border-inline-start: 4px solid;
        border-radius: var(--erp-radius-lg);
        box-shadow: var(--erp-shadow-sm);
        color: var(--erp-text);
        display: flex;
        gap: 0.75rem;
        min-height: 86px;
        padding: 1rem;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .profile-link:hover {
        box-shadow: var(--erp-shadow-md);
        transform: translateY(-1px);
    }

    .profile-link i {
        color: var(--erp-primary);
        font-size: 1.5rem;
    }

    .profile-link span {
        font-size: 1.15rem;
        font-weight: 600;
    }

    .company-logo {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        color: var(--erp-primary);
        display: flex;
        height: 72px;
        justify-content: center;
        overflow: hidden;
        width: 72px;
    }

    .company-logo img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .company-logo i {
        font-size: 2rem;
    }

    .company-logo-upload {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px dashed var(--erp-border-strong);
        border-radius: var(--erp-radius-lg);
        color: var(--erp-primary);
        cursor: pointer;
        display: flex;
        height: 88px;
        justify-content: center;
        overflow: hidden;
        width: 88px;
    }

    .company-logo-upload img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .company-logo-upload i {
        font-size: 1.75rem;
    }

    .company-contact {
        color: var(--erp-text-muted);
        display: grid;
        gap: 0.35rem;
    }

    .locked-fields {
        display: grid;
        gap: 1rem;
    }

    .locked-fields label {
        color: var(--erp-text-muted);
        display: block;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .company-map {
        background: var(--erp-bg-subtle);
        border: 1px solid var(--erp-border-strong);
        border-radius: var(--erp-radius-lg);
        cursor: crosshair;
        height: 340px;
        overflow: hidden;
        position: relative;
        width: 100%;
    }

    .location-picker-tile {
        height: 256px;
        position: absolute;
        user-select: none;
        width: 256px;
    }

    .location-picker-marker {
        color: var(--erp-danger);
        font-size: 2rem;
        inset-inline-start: 50%;
        line-height: 1;
        pointer-events: none;
        position: absolute;
        text-shadow: 0 2px 4px color-mix(in srgb, var(--erp-color-inverse-surface) 25%, transparent);
        top: 50%;
        transform: translate(-50%, -100%);
        z-index: 2;
    }

    .map-zoom-button {
        align-items: center;
        display: inline-flex;
        height: 31px;
        justify-content: center;
        width: 36px;
    }

    [dir="rtl"] .profile-link {
        border-inline-start: 0;
        border-inline-end: 4px solid;
    }
</style>

@code {
    private CompanyDto? company;
    private List<CurrencyDto> currencies = [];
    private bool isLoading = true;
    private bool isSaving;
    private string? errorMessage;
    private CompanySettingDto? companySetting;
    private readonly string mapElementId = $"company-location-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<CompanyList>? dotNetReference;
    private bool mapInitialized;

    private string CompanyLogoUrl =>
        company is null || string.IsNullOrWhiteSpace(company.Logo)
            ? string.Empty
            : company.Logo.Contains("data:", StringComparison.OrdinalIgnoreCase)
                ? company.Logo
                : $"{ApiConfig.BaseURL}/Images/Companies/{company.Logo}";

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleLanguageChangeAsync;
        await LoadCompanyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapInitialized && company is not null && !isLoading)
        {
            dotNetReference ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync(
                "alafkarLocationPicker.init",
                mapElementId,
                MapLatitude,
                MapLongitude,
                dotNetReference);
            mapInitialized = true;
        }
    }

    private async Task LoadCompanyAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            var companyIdValue = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
            if (!Guid.TryParse(companyIdValue, out var companyId))
            {
                company = null;
                errorMessage = Text("The current user is not linked to a company.", "المستخدم الحالي غير مرتبط بشركة.");
                return;
            }

            var result = await CompanyService.GetByIdAsync(companyId);
            var settingResult = await CompanySettingService.GetAsync(companyId);
            var currencyResult = await CurrencyService.GetAsync(companyId, 0, 1000);
            if (settingResult.IsSuccess)
            {
                companySetting = settingResult.Data;
            }

            if (currencyResult.IsSuccess && currencyResult.Data is not null)
            {
                currencies = currencyResult.Data.Data.ToList();
            }

            if (result.IsSuccess)
            {
                company = result.Data;
                if (mapInitialized)
                {
                    await CenterMapFromFieldsAsync();
                }
            }
            else
            {
                company = null;
                errorMessage = result.Error?.Detail ?? Text("Unable to load company profile.", "تعذر تحميل ملف الشركة.");
            }
        }
        catch
        {
            company = null;
            errorMessage = Text("An error occurred while loading company profile.", "حدث خطأ أثناء تحميل ملف الشركة.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (company is null)
        {
            return;
        }

        isSaving = true;

        try
        {
            var result = await CompanyService.UpdateAsync(company);
            if (result.IsSuccess && result.Data?.IsSuccess == true)
            {
                ToastService.Show(new ToastMessage
                {
                    Type = "success",
                    Message = Text("Company profile has been saved successfully.", "تم حفظ بيانات الشركة بنجاح.")
                });
            }
            else
            {
                ToastService.Show(new ToastMessage
                {
                    Type = "error",
                    Message = result.Error?.Detail ?? Text("Unable to save company profile.", "تعذر حفظ بيانات الشركة.")
                });
            }
        }
        finally
        {
            isSaving = false;
        }
    }


    private async Task OnCompanyLogoSelected(InputFileChangeEventArgs e)
    {
        if (company is null)
        {
            return;
        }

        var file = e.File;
        if (file is null)
        {
            return;
        }

        using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var ms = new MemoryStream();

        await stream.CopyToAsync(ms);

        var base64 = Convert.ToBase64String(ms.ToArray());
        company.Logo = $"data:{file.ContentType};base64,{base64}".Trim();

        await InvokeAsync(StateHasChanged);
    }

    private async Task CenterMapFromFieldsAsync()
    {
        if (company is null || !mapInitialized)
        {
            return;
        }

        await JSRuntime.InvokeVoidAsync(
            "alafkarLocationPicker.setCenter",
            mapElementId,
            MapLatitude,
            MapLongitude,
            false);
    }

    private async Task UseCurrentLocationAsync()
    {
        if (!mapInitialized)
        {
            return;
        }

        var isSupported = await JSRuntime.InvokeAsync<bool>("alafkarLocationPicker.useCurrentLocation", mapElementId);
        if (!isSupported)
        {
            ToastService.Show(new ToastMessage
            {
                Type = "warning",
                Message = Text("Current location is not supported in this browser.", "الموقع الحالي غير مدعوم في هذا المتصفح.")
            });
        }
    }

    private async Task ZoomInMapAsync()
    {
        if (mapInitialized)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomIn", mapElementId);
        }
    }

    private async Task ZoomOutMapAsync()
    {
        if (mapInitialized)
        {
            await JSRuntime.InvokeAsync<int>("alafkarLocationPicker.zoomOut", mapElementId);
        }
    }

    [JSInvokable]
    public async Task OnMapLocationSelected(double latitude, double longitude)
    {
        if (company is null)
        {
            return;
        }

        company.HqLatitude = Math.Round(latitude, 6);
        company.HqLongitude = Math.Round(longitude, 6);
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    private string DisplayName(string? name, string? nameEng)
        => SharedDataService.Language == "Ar"
            ? FirstNotEmpty(name, nameEng)
            : FirstNotEmpty(nameEng, name);

    private string CurrencyDisplay(Guid? currencyId)
    {
        var currency = currencyId.HasValue
            ? currencies.FirstOrDefault(x => x.Id == currencyId.Value)
            : null;

        if (currency is null)
            return "-";

        var name = SharedDataService.Language == "Ar"
            ? FirstNotEmpty(currency.Name, currency.NameEng)
            : FirstNotEmpty(currency.NameEng, currency.Name);

        return $"{currency.Code} - {name}";
    }

    private static string EmptyValue(string? value)
        => string.IsNullOrWhiteSpace(value) ? "-" : value;

    private static string FirstNotEmpty(string? primary, string? fallback)
        => !string.IsNullOrWhiteSpace(primary)
            ? primary
            : !string.IsNullOrWhiteSpace(fallback) ? fallback : "-";

    private double MapLatitude => company?.HqLatitude is > 0
        ? company.HqLatitude
        : companySetting?.DefaultLatitude is > 0 ? companySetting.DefaultLatitude : 24.7136;

    private double MapLongitude => company?.HqLongitude is > 0
        ? company.HqLongitude
        : companySetting?.DefaultLongitude is > 0 ? companySetting.DefaultLongitude : 46.6753;

    private async Task HandleLanguageChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        if (mapInitialized)
        {
            _ = JSRuntime.InvokeVoidAsync("alafkarLocationPicker.dispose", mapElementId);
        }

        dotNetReference?.Dispose();
        SharedDataService.OnChange1 -= HandleLanguageChangeAsync;
    }
}
