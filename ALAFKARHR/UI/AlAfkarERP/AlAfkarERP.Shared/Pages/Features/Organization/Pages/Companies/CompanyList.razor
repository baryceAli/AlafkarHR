<style>
    .company-profile {
        max-width: 1400px;
    }

    .profile-link {
        align-items: center;
        background: var(--erp-surface);
        border-left: 4px solid;
        border-radius: var(--erp-radius-lg);
        box-shadow: var(--erp-shadow-sm);
        color: var(--erp-text);
        display: flex;
        gap: 0.75rem;
        min-height: 86px;
        padding: 1rem;
        transition: transform 0.12s ease, box-shadow 0.12s ease;
    }

    .profile-link:hover {
        box-shadow: var(--erp-shadow-md);
        transform: translateY(-1px);
    }

    .profile-link i {
        color: var(--erp-primary);
        font-size: 1.5rem;
    }

    .profile-link span {
        font-size: 1.15rem;
        font-weight: 600;
    }

    .company-logo {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px solid var(--erp-border);
        border-radius: var(--erp-radius-lg);
        color: var(--erp-primary);
        display: flex;
        height: 72px;
        justify-content: center;
        overflow: hidden;
        width: 72px;
    }

    .company-logo img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .company-logo i {
        font-size: 2rem;
    }

    .company-logo-upload {
        align-items: center;
        background: var(--erp-surface-muted);
        border: 1px dashed var(--erp-border-strong);
        border-radius: var(--erp-radius-lg);
        color: var(--erp-primary);
        cursor: pointer;
        display: flex;
        height: 88px;
        justify-content: center;
        overflow: hidden;
        width: 88px;
    }

    .company-logo-upload img {
        height: 100%;
        object-fit: cover;
        width: 100%;
    }

    .company-logo-upload i {
        font-size: 1.75rem;
    }

    .company-contact {
        color: var(--erp-text-muted);
        display: grid;
        gap: 0.35rem;
    }

    .locked-fields {
        display: grid;
        gap: 1rem;
    }

    .locked-fields label {
        color: var(--erp-text-muted);
        display: block;
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .company-map {
        background: var(--erp-bg-subtle);
        border: 1px solid var(--erp-border-strong);
        border-radius: var(--erp-radius-lg);
        cursor: crosshair;
        height: 340px;
        overflow: hidden;
        position: relative;
        width: 100%;
    }

    .location-picker-tile {
        height: 256px;
        position: absolute;
        user-select: none;
        width: 256px;
    }

    .location-picker-marker {
        color: #dc3545;
        font-size: 2rem;
        left: 50%;
        line-height: 1;
        pointer-events: none;
        position: absolute;
        text-shadow: 0 2px 4px rgba(0, 0, 0, 0.25);
        top: 50%;
        transform: translate(-50%, -100%);
        z-index: 2;
    }

    .map-zoom-button {
        align-items: center;
        display: inline-flex;
        height: 31px;
        justify-content: center;
        width: 36px;
    }

    [dir="rtl"] .profile-link {
        border-left: 0;
        border-right: 4px solid;
    }
</style>

@code {
    private CompanyDto? company;
    private bool isLoading = true;
    private bool isSaving;
    private bool isCreatingChild;
    private bool showChildCompanyForm;
    private string? errorMessage;
    private CompanyDto? childCompany;
    private CompanySettingDto? companySetting;
    private readonly string mapElementId = $"company-location-map-{Guid.NewGuid():N}";
    private DotNetObjectReference<CompanyList>? dotNetReference;
    private bool mapInitialized;

    private string CompanyLogoUrl =>
        company is null || string.IsNullOrWhiteSpace(company.Logo)
            ? string.Empty
            : company.Logo.Contains("data:", StringComparison.OrdinalIgnoreCase)
                ? company.Logo
                : $"{ApiConfig.BaseURL}/Images/Companies/{company.Logo}";

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleLanguageChangeAsync;
        await LoadCompanyAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!mapInitialized && company is not null && !isLoading)
        {
            dotNetReference ??= DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync(
                "alafkarLocationPicker.init",
                mapElementId,
                MapLatitude,
                MapLongitude,
                dotNetReference);
            mapInitialized = true;
        }
    }

    private async Task LoadCompanyAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var authState = await ((CustomAuthStateProvider)AuthenticationStateProvider).GetAuthenticationStateAsync();
            if (authState.User.Identity?.IsAuthenticated != true)
            {
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            var companyIdValue = authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value;
            if (!Guid.TryParse(companyIdValue, out var companyId))
            {
                company = null;
                errorMessage = Text("The current user is not linked to a company.", "المستخدم الحالي غير مرتبط بشركة.");
                return;
            }

            var result = await CompanyService.GetByIdAsync(companyId);
            var settingResult = await CompanySettingService.GetAsync(companyId);
            if (settingResult.IsSuccess)
            {
                companySetting = settingResult.Data;
            }

            if (result.IsSuccess)
            {
                company = result.Data;
                PrepareChildCompanyModel();
                if (mapInitialized)
                {
                    await CenterMapFromFieldsAsync();
                }
            }
            else
            {
                company = null;
                errorMessage = result.Error?.Detail ?? Text("Unable to load company profile.", "تعذر تحميل ملف الشركة.");
            }
        }
        catch
        {
            company = null;
            errorMessage = Text("An error occurred while loading company profile.", "حدث خطأ أثناء تحميل ملف الشركة.");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (company is null)
        {
            return;
        }

        isSaving = true;

        try
        {
            var result = await CompanyService.UpdateAsync(company);
            if (result.IsSuccess && result.Data?.IsSuccess == true)
            {
                ToastService.Show(new ToastMessage
                {
                    Type = "success",
