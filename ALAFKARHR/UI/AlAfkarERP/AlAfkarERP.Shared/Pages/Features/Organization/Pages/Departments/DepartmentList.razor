    }

    .org-check {
        align-items: center;
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        display: inline-flex;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
    }

    .org-check .form-check-input {
        margin: 0;
    }

    .department-map {
        background: #eef2f5;
        border: 1px solid #ced4da;
        border-radius: 8px;
        cursor: grab;
        height: 320px;
        overflow: hidden;
