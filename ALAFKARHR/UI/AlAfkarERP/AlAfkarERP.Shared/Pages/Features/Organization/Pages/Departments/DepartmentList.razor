@layout AdminLayout
@page "/Organization/Department/List"
@using AlAfkarERP.Shared.Pages.Features.Auth.Services
@using AlAfkarERP.Shared.Pages.Features.Company.Services
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@* @using AlAfkarERP.Shared.Pages.Reuable *@
@using AlAfkarERP.Shared.Pages.Reuable2
@using AlAfkarERP.Shared.Utilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.Auth.Dtos
@using SharedWithUI.Permissions


@inject IBranchService BranchService
@inject IDepartmentService DepartmentService
@inject IAdministrationService AdministrationService
@inject IAuthService AuthService
@inject IUserService UserService
@inject ToastService ToastService
@inject ModalService ModalService

@inject AuthenticationStateProvider AuthenticationStateProvider


@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject IJSRuntime JSRuntime

@if (!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.DepartmentPermissions.View}"))
{
    <div class="alert alert-warning">
        <span>
            @SharedDataService.SelectViewLang("You don't have permissions to view this page", "ليس لديك الصلاحيات لعرض هذه الصفحة")
        </span>
    </div>

    return;
}

<div class="org-list-page" dir="@SharedDataService.PageDirection">
    <div class="org-list-header mb-4">
        <div>
            <div class="text-uppercase text-primary fw-semibold small mb-1">@Text("Organization", "المنظمة")</div>
            <h3 class="mb-1">@Text("Departments Management", "ادارة الأقسام")</h3>
            <div class="text-muted">@Text("Manage department structure, heads, locations, and attendance geofence coordinates.", "ادارة الأقسام والرؤساء والمواقع وإحداثيات نطاق الحضور.")</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <button class="btn btn-outline-primary" @onclick="LoadDepartments">
                <i class="bi bi-arrow-clockwise"></i>
                @Text("Refresh", "تحديث")
            </button>
            <button class="btn btn-primary"
                    @onclick="CreateNew"
                    disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.DepartmentPermissions.Create}") ? true : false)>
                <i class="bi bi-plus-lg"></i>
                @Text("Create New", "إضافة جديد")
            </button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="org-stat border-primary">
                <div class="org-stat-icon text-primary"><i class="bi bi-grid-1x2"></i></div>
                <div>
                    <div class="text-muted small">@Text("Visible Departments", "الأقسام المعروضة")</div>
                    <div class="org-stat-value">@departments.Count</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="org-stat border-success">
                <div class="org-stat-icon text-success"><i class="bi bi-check-circle"></i></div>
                <div>
                    <div class="text-muted small">@Text("Active", "النشطة")</div>
                    <div class="org-stat-value">@departments.Count(d => d.IsActive)</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="org-stat border-info">
                <div class="org-stat-icon text-info"><i class="bi bi-geo-alt-fill"></i></div>
                <div>
                    <div class="text-muted small">@Text("With Coordinates", "لديها احداثيات")</div>
                    <div class="org-stat-value">@departments.Count(HasCoordinates)</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="org-toolbar mb-3">
                <div class="org-selector">
                    <label class="form-label mb-1">@Text("Select Branch", "اختر الفرع")</label>
                    <AutoCompleteComponent TItem="BranchDto"
                                           Items="branches"
                                           Value="selectedBranch"
                                           ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                           ValueChanged="OnBranchSelected">
                    </AutoCompleteComponent>
                </div>
                <div class="org-selector">
                    <label class="form-label mb-1">@Text("Select Administration", "اختر الإدارة")</label>
                    <AutoCompleteComponent TItem="AdministrationDto"
                                           Items="administrations"
                                           Value="selectedAdministration"
                                           ItemText='(p=> SharedDataService.Language=="Ar"? p.Name:p.NameEng)'
                                           ValueChanged="OnAdministrationSelected">
                    </AutoCompleteComponent>
                </div>

                <div class="org-search">
                    <i class="bi bi-search"></i>
                    <input class="form-control"
                           placeholder="@Text("Search by name...", "بحث بالاسم...")"
                           @bind="searchText" />
                </div>

                <div class="d-flex align-items-center gap-2">
                    <label class="text-muted small mb-0">@Text("Rows", "الصفوف")</label>
                    <select class="form-select org-page-size" @onchange="OnPageSizeChanged" value="@pageSize">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20">20</option>
                    </select>
                </div>
            </div>

    <div class="table-responsive org-table-wrap">
            <div class="d-flex justify-content-end mb-2">
            <TableExportActions />
        </div>

    <table class="table org-table align-middle mb-0">
        <thead>
            <tr>
                <th @onclick="() => Sort(nameof(DepartmentDto.Name))" class="sortable">
                    @Text("Name", "الاسم")
                    <i class="@SortIcon(nameof(DepartmentDto.Name))"></i>
                </th>
                <th @onclick="() => Sort(nameof(DepartmentDto.NameEng))" class="sortable">
                    @Text("Name (English)", "الاسم بالانجليزية")
                    <i class="@SortIcon(nameof(DepartmentDto.NameEng))"></i>
                </th>
                @* <th @onclick="() => Sort(nameof(AdministrationDto.BranchId))">Branch</th> *@
                <th @onclick="() => Sort(nameof(DepartmentDto.HeadOfDepartment))" class="sortable">
                    @Text("Head of Dept.", "رئيس القسم")
                    <i class="@SortIcon(nameof(DepartmentDto.HeadOfDepartment))"></i>
                </th>
                <th @onclick="() => Sort(nameof(DepartmentDto.Location))" class="sortable">
                    @Text("Location", "الموقع")
                    <i class="@SortIcon(nameof(DepartmentDto.Location))"></i>
                </th>
                <th>@Text("Coordinates", "الاحداثيات")</th>
                <th>@Text("Status", "الحالة")</th>
                <th class="text-end">@Text("Actions", "العمليات")</th>
            </tr>
        </thead>
        <tbody>
            
            @if (editingDepartmentId != null)
                {
                    var dept = departments.FirstOrDefault(d => d.Id == editingDepartmentId);
                    <tr class="org-edit-row">
                        <td colspan="8">
                            <EditForm Model="dept" OnValidSubmit="async () => await SaveDepartment(dept)">
                                <DataAnnotationsValidator />
                                @* <ValidationSummary/> *@
                                <div class="org-edit-panel">
                                    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
                                        <div>
                                            <h5 class="mb-1">@Text(isNew ? "Create Department" : "Edit Department", isNew ? "اضافة قسم" : "تعديل القسم")</h5>
                                            <div class="text-muted small">@Text("Update department identity, head, location, and active state.", "تحديث بيانات القسم والرئيس والموقع والحالة.")</div>
                                        </div>
                                        <span class="badge text-bg-light">@Text("Inline Form", "نموذج داخلي")</span>
                                    </div>

                                <div class="row g-3">


                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name", "الاسم")</label>
                                            <InputText class="form-control" @bind-Value="dept.Name" />
                                            <ValidationMessage For="() => dept.Name" />
                                    </div>

                            

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Name (En)", "الاسم (En)")</label>
                                            <InputText class="form-control" @bind-Value="dept.NameEng" />
                                            <ValidationMessage For="() => dept.NameEng" />
                                    </div>

                                    

                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Head of Department", "رئيس القسم")</label>
                                            <AutoCompleteComponent TItem="UserDto"
                                                                   Items="users"
                                                                   Value="manager"
                                                                   PlaceHolder="@Text("Search manager...", "ابحث عن الرئيس...")"
                                                                   ItemText='(p=> p.UserName)'
                                                                   ValueChanged="OnUserSelected">
                                            </AutoCompleteComponent>
                                    </div>



                                    
                                    <div class="col-md-6">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Location", "الموقع")</label>
                                            <InputText class="form-control" @bind-Value="dept.Location" />
                                            <ValidationMessage For="() => dept.Location" />
                                    </div>



                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Longitude", "خط الطول")</label>
                                            <InputNumber class="form-control" @bind-Value="dept.Longitude" />
                                            <ValidationMessage For="() => dept.Longitude" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label">@SharedDataService.SelectViewLang("Latitude", "خط العرض")</label>
                                            <InputNumber class="form-control" @bind-Value="dept.Latitude" />
                                            <ValidationMessage For="() => dept.Latitude" />
                                    </div>

                                    <div class="col-md-4">
                                        <label class="form-label d-block">@SharedDataService.SelectViewLang("Is Active?", "فعال؟")</label>
                                        <div class="org-check">
                                            <InputCheckbox class="form-check-input" @bind-Value="dept.IsActive" />
                                            <span>@Text("Active department", "قسم نشط")</span>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                                            <label class="form-label mb-0">@Text("Pick Department Location", "اختيار موقع القسم")</label>
                                            <div class="d-flex flex-wrap gap-2">
                                                <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomOutMapAsync" title="@Text("Zoom Out", "تصغير")">
                                                    <i class="bi bi-dash-lg"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm map-zoom-button" @onclick="ZoomInMapAsync" title="@Text("Zoom In", "تكبير")">
                                                    <i class="bi bi-plus-lg"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CenterMapFromDepartmentAsync">
                                                    <i class="bi bi-crosshair"></i>
                                                    @Text("Center from Fields", "توسيط من الحقول")
                                                </button>
                                                <button type="button" class="btn btn-outline-primary btn-sm" @onclick="UseCurrentLocationAsync">
                                                    <i class="bi bi-geo-alt"></i>
                                                    @Text("Use Current Location", "استخدام موقعي")
                                                </button>
                                            </div>
                                        </div>
                                        <div id="@mapElementId" class="department-map"></div>
                                        <div class="text-muted small mt-2">
                                            @Text("Click the map to update longitude and latitude.", "اضغط على الخريطة لتحديث خط الطول وخط العرض.")
                                        </div>
                                    </div>


                                    <div class="col-12 d-flex justify-content-end gap-2">
                                        <button type="button" class="btn btn-outline-secondary" @onclick="CancelEdit">@SharedDataService.SelectViewLang("Cancel","إلغاء")</button>
                                        <button type="submit"
                                            class="btn btn-success"><i class="bi bi-check2"></i> @SharedDataService.SelectViewLang("Save","حفظ")</button>
                                    </div>
                                </div>
                                </div>
                            </EditForm>
                        </td>
                    </tr>
                }
                
                @foreach (var dept in ProcessedDepartments.Where(d => d.Id != editingDepartmentId))
            {
                
                <tr>
                        <td>
                            <div class="fw-semibold">@EmptyValue(dept.Name)</div>
                            <div class="text-muted small">@EmptyValue(dept.Code)</div>
                        </td>
                        <td>@EmptyValue(dept.NameEng)</td>
                        <td>@EmptyValue(users.FirstOrDefault(u => u.Id == dept.HeadOfDepartment)?.UserName)</td>
                        <td>@EmptyValue(dept.Location)</td>
                        <td>
                            @if (HasCoordinates(dept))
                            {
                                <div class="small">@dept.Latitude</div>
                                <div class="text-muted small">@dept.Longitude</div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge rounded-pill @(dept.IsActive ? "text-bg-success" : "text-bg-secondary")">
                                @(dept.IsActive ? Text("Active", "نشط") : Text("Inactive", "غير نشط"))
                            </span>
                        </td>
                        <td>
                            <div class="d-flex justify-content-end gap-2">
                            <button class="btn btn-outline-warning btn-sm org-action"
                            @onclick="() => EditDepartment(dept)"
                            disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.DepartmentPermissions.Edit}"))
                            title="@Text("Edit", "تعديل")">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <button
                                class="btn btn-outline-danger btn-sm org-action" @onclick="() => DeleteDepartment(dept)"
                                disabled=@(!AuthState.User.Claims.Any(c => c.Value == $"{PermissionList.DepartmentPermissions.Delete}"))
                                title="@Text("Delete", "حذف")">
                                <i class="bi bi-trash"></i>
                            </button>
                            </div>
                        </td>
                    </tr>
                
                }
        </tbody>
    </table>
    </div>
    <div class="org-pagination">
        <div class="text-muted small">
            @Text("Page", "صفحة") @(pageIndex + 1) @Text("of", "من") @Math.Max(TotalPages, 1)
        </div>
        <div class="d-flex gap-2">

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="PrevPage"
                disabled="@(pageIndex == 0)">
            <i class="bi bi-chevron-left"></i>
            @Text("Previous", "السابق")
        </button>

        <button class="btn btn-sm btn-outline-secondary"
                @onclick="NextPage"
                disabled="@(pageIndex >= TotalPages - 1)">
            @Text("Next", "التالي")
            <i class="bi bi-chevron-right"></i>
        </button>

        </div>
    </div>
        </div>
    </div>
</div>

<style>
    .org-list-page {
        max-width: 1400px;
    }

    .org-list-header {
        align-items: flex-start;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
    }

    .org-stat {
        align-items: center;
        background: #fff;
        border-left: 4px solid;
        border-radius: 8px;
        box-shadow: 0 0.125rem 0.35rem rgba(15, 23, 42, 0.08);
        display: flex;
        gap: 0.875rem;
        min-height: 88px;
        padding: 1rem;
    }

    .org-stat-icon {
        align-items: center;
        background: #f8f9fa;
        border-radius: 8px;
        display: inline-flex;
        font-size: 1.35rem;
        height: 44px;
        justify-content: center;
        width: 44px;
    }

    .org-stat-value {
        color: #212529;
        font-size: 1.35rem;
        font-weight: 700;
        line-height: 1.15;
    }

    .org-toolbar {
        align-items: end;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        justify-content: space-between;
    }

    .org-selector {
        min-width: 240px;
        width: min(100%, 320px);
    }

    .org-search {
        max-width: 360px;
        position: relative;
        width: min(100%, 360px);
    }

    .org-search i {
        color: #6c757d;
        left: 0.875rem;
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
    }

    .org-search .form-control {
        padding-left: 2.5rem;
    }

    .org-page-size {
        min-width: 82px;
    }

    .org-table-wrap {
        border: 1px solid #e9ecef;
        border-radius: 8px;
    }

    .org-table thead th {
        background: #f8f9fa;
