@page "/Fleet/Vehicles"
@layout AdminLayout
@implements IDisposable
@using AlAfkarERP.Shared.Pages.Features.Fleet.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using SharedWithUI.Fleet.Dtos
@using SharedWithUI.Fleet.Enums
@using SharedWithUI.Maintenance.Enums
@using SharedWithUI.Permissions
@inject IFleetService FleetService
@inject SharedDataService SharedDataService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<main class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Fleet Vehicles", "مركبات الأسطول")"
                Subtitle="@Text("Owned and rented vehicles with filters, odometer updates, and emergency maintenance actions.", "المركبات المملوكة والمؤجرة مع الفلاتر وتحديث العداد وطلبات الصيانة الطارئة.")"
                Icon="bi-truck-front">
        <Actions>
            @if (Can(PermissionList.FleetVehiclePermissions.Create))
            {
                <button class="btn btn-primary" @onclick="@(() => NavigationManager.NavigateTo("/Fleet/Vehicles/Form"))">
                    <i class="bi bi-plus-lg"></i>
                    @Text("New Vehicle", "مركبة جديدة")
                </button>
            }
        </Actions>
    </PageHeader>

    <section class="erp-card mb-3">
        <div class="erp-card-body">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-lg-3">
                    <label class="form-label">@Text("Search", "بحث")</label>
                    <input class="form-control" @bind="searchText" @bind:event="oninput" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Ownership", "الملكية")</label>
                    <select class="form-select" @bind="ownershipText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var value in Enum.GetValues<FleetVehicleOwnershipType>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Type", "النوع")</label>
                    <select class="form-select" @bind="typeText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var value in Enum.GetValues<FleetVehicleType>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Status", "الحالة")</label>
                    <select class="form-select" @bind="statusText">
                        <option value="">@Text("All", "الكل")</option>
                        @foreach (var value in Enum.GetValues<FleetVehicleStatus>())
                        {
                            <option value="@value">@value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="form-label">@Text("Branch Id", "معرف الفرع")</label>
                    <input class="form-control" @bind="branchIdText" />
                </div>
                <div class="col-12 col-lg-1">
                    <button class="btn btn-outline-secondary w-100" @onclick="ApplyFiltersAsync"><i class="bi bi-search"></i></button>
                </div>
            </div>
        </div>
    </section>

    @if (selectedOdometerVehicle is not null)
    {
        <section class="erp-card mb-3">
            <div class="erp-card-header"><strong>@Text("Update Odometer", "تحديث العداد")</strong></div>
            <div class="erp-card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-md-4">@selectedOdometerVehicle.PlateNumber - @Name(selectedOdometerVehicle)</div>
                    <div class="col-12 col-md-3"><input class="form-control" type="number" @bind="odometerValue" /></div>
                    <div class="col-12 col-md-5 d-flex gap-2">
                        <button class="btn btn-primary" @onclick="SaveOdometerAsync">@Text("Save", "حفظ")</button>
                        <button class="btn btn-outline-secondary" @onclick="@(() => selectedOdometerVehicle = null)">@Text("Cancel", "إلغاء")</button>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (selectedMaintenanceVehicle is not null)
    {
        <section class="erp-card mb-3">
            <div class="erp-card-header"><strong>@Text("Emergency Maintenance", "صيانة طارئة")</strong></div>
            <div class="erp-card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-12 col-lg-3"><label class="form-label">@Text("Title", "العنوان")</label><input class="form-control" @bind="emergencyTitle" /></div>
                    <div class="col-12 col-lg-3"><label class="form-label">@Text("Description", "الوصف")</label><input class="form-control" @bind="emergencyDescription" /></div>
                    <div class="col-6 col-lg-2"><label class="form-label">@Text("Priority", "الأولوية")</label><select class="form-select" @bind="emergencyPriority">@foreach (var value in Enum.GetValues<MaintenancePriority>()) { <option value="@value">@value</option> }</select></div>
                    <div class="col-6 col-lg-2"><label class="form-label">@Text("Estimated Cost", "التكلفة")</label><input class="form-control" type="number" @bind="emergencyCost" /></div>
                    <div class="col-12 col-lg-2 d-flex gap-2">
                        <button class="btn btn-warning" @onclick="CreateEmergencyAsync">@Text("Create", "إنشاء")</button>
                        <button class="btn btn-outline-secondary" @onclick="@(() => selectedMaintenanceVehicle = null)">@Text("Cancel", "إلغاء")</button>
                    </div>
                </div>
            </div>
        </section>
    }

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <section class="erp-card">
        <div class="erp-table-wrap">
            <table class="erp-table table">
                <thead>
                    <tr>
                        <th>@Text("Code", "الكود")</th>
                        <th>@Text("Plate", "اللوحة")</th>
                        <th>@Text("Vehicle", "المركبة")</th>
                        <th>@Text("Ownership", "الملكية")</th>
                        <th>@Text("Rental", "الإيجار")</th>
                        <th>@Text("Status", "الحالة")</th>
                        <th>@Text("Odometer", "العداد")</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr><td colspan="8" class="text-muted">@Text("Loading vehicles...", "جاري تحميل المركبات...")</td></tr>
                    }
                    else if (!vehicles.Any())
                    {
                        <tr><td colspan="8" class="text-muted">@Text("No vehicles found.", "لا توجد مركبات.")</td></tr>
                    }
                    else
                    {
                        @foreach (var vehicle in vehicles)
                        {
                            <tr>
                                <td class="fw-semibold">@vehicle.VehicleCode</td>
                                <td>@vehicle.PlateNumber</td>
                                <td>@Name(vehicle)<div class="small text-muted">@vehicle.Make @vehicle.Model @vehicle.Year</div></td>
                                <td><StatusChip Text="@vehicle.OwnershipType.ToString()" Tone="info" /></td>
                                <td class="small">@RentalSummary(vehicle)</td>
                                <td><StatusChip Text="@vehicle.Status.ToString()" Tone="@StatusTone(vehicle.Status)" /></td>
                                <td>@vehicle.CurrentOdometer.ToString("N0")</td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" title="@Text("View", "عرض")" @onclick="@(() => NavigationManager.NavigateTo($"/Fleet/Vehicles/View/{vehicle.Id}"))"><i class="bi bi-eye"></i></button>
                                        @if (Can(PermissionList.FleetVehiclePermissions.Edit))
                                        {
                                            <button class="btn btn-outline-secondary" title="@Text("Edit", "تعديل")" @onclick="@(() => NavigationManager.NavigateTo($"/Fleet/Vehicles/Form/{vehicle.Id}"))"><i class="bi bi-pencil"></i></button>
                                            <button class="btn btn-outline-dark" title="@Text("Odometer", "العداد")" @onclick="@(() => BeginOdometer(vehicle))"><i class="bi bi-speedometer2"></i></button>
                                        }
                                        @if (Can(PermissionList.MaintenanceWorkOrderPermissions.Create))
                                        {
                                            <button class="btn btn-outline-warning" title="@Text("Emergency Maintenance", "صيانة طارئة")" @onclick="@(() => BeginEmergency(vehicle))"><i class="bi bi-tools"></i></button>
                                        }
                                        @if (Can(PermissionList.FleetVehiclePermissions.Delete))
                                        {
                                            <button class="btn btn-outline-danger" title="@Text("Delete", "حذف")" @onclick="@(() => DeleteAsync(vehicle))"><i class="bi bi-trash"></i></button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="erp-card-body border-top d-flex justify-content-between align-items-center gap-2">
            <span class="text-muted small">@Text("Total", "الإجمالي"): @totalCount</span>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(pageIndex == 0 || isLoading)" @onclick="PreviousPageAsync"><i class="bi bi-chevron-left"></i></button>
                <span class="small">@Text("Page", "صفحة") @(pageIndex + 1)</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(!HasNextPage || isLoading)" @onclick="NextPageAsync"><i class="bi bi-chevron-right"></i></button>
            </div>
        </div>
    </section>
</main>

@code {
    private List<FleetVehicleDto> vehicles = [];
    private string searchText = string.Empty;
    private string ownershipText = string.Empty;
    private string statusText = string.Empty;
    private string typeText = string.Empty;
    private string branchIdText = string.Empty;
    private Guid companyId;
    private int pageIndex;
    private int pageSize = 25;
    private long totalCount;
    private bool isLoading = true;
    private string? errorMessage;
    private AuthenticationState? authState;
    private FleetVehicleDto? selectedOdometerVehicle;
    private int odometerValue;
    private FleetVehicleDto? selectedMaintenanceVehicle;
    private string emergencyTitle = string.Empty;
    private string emergencyDescription = string.Empty;
    private MaintenancePriority emergencyPriority = MaintenancePriority.High;
    private decimal? emergencyCost;
    private bool HasNextPage => (pageIndex + 1) * pageSize < totalCount;

    protected override async Task OnInitializedAsync()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
        authState = await AuthStateProvider.GetAuthenticationStateAsync();
        companyId = ResolveCompanyId();
        ReadQueryFilters();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        var result = await FleetService.GetVehiclesAsync(pageIndex, pageSize, searchText, companyId == Guid.Empty ? null : companyId, ParseGuid(branchIdText), ParseOwnership(), ParseStatus(), ParseType());
        if (result.IsSuccess)
        {
            vehicles = result.Data?.Data.ToList() ?? [];
            totalCount = result.Data?.Count ?? 0;
            errorMessage = null;
        }
        else
        {
            errorMessage = result.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Unable to load vehicles.", "تعذر تحميل المركبات.");
        }
        isLoading = false;
    }

    private async Task ApplyFiltersAsync() { pageIndex = 0; await LoadAsync(); }
    private async Task NextPageAsync() { if (HasNextPage) { pageIndex++; await LoadAsync(); } }
    private async Task PreviousPageAsync() { if (pageIndex > 0) { pageIndex--; await LoadAsync(); } }

    private void BeginOdometer(FleetVehicleDto vehicle)
    {
        selectedOdometerVehicle = vehicle;
        odometerValue = vehicle.CurrentOdometer;
    }

    private async Task SaveOdometerAsync()
    {
        if (selectedOdometerVehicle is null)
            return;
        var result = await FleetService.UpdateOdometerAsync(selectedOdometerVehicle.Id, odometerValue);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        selectedOdometerVehicle = null;
        await LoadAsync();
    }

    private void BeginEmergency(FleetVehicleDto vehicle)
    {
        selectedMaintenanceVehicle = vehicle;
        emergencyTitle = $"{vehicle.PlateNumber} - Emergency maintenance";
        emergencyDescription = string.Empty;
        emergencyPriority = MaintenancePriority.High;
        emergencyCost = null;
    }

    private async Task CreateEmergencyAsync()
    {
        if (selectedMaintenanceVehicle is null)
            return;
        var result = await FleetService.CreateEmergencyMaintenanceAsync(new CreateEmergencyFleetMaintenanceRequestDto
        {
            VehicleId = selectedMaintenanceVehicle.Id,
            Title = emergencyTitle,
            Description = emergencyDescription,
            Priority = emergencyPriority,
            EstimatedCost = emergencyCost
        });
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        selectedMaintenanceVehicle = null;
        await LoadAsync();
    }

    private async Task DeleteAsync(FleetVehicleDto vehicle)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", Text("Delete this vehicle?", "هل تريد حذف هذه المركبة؟")))
            return;
        var result = await FleetService.DeleteVehicleAsync(vehicle.Id);
        errorMessage = result.IsSuccess ? null : result.Error?.GetDisplayMessage(SharedDataService.Language);
        await LoadAsync();
    }

    private void ReadQueryFilters()
    {
        var uri = new Uri(NavigationManager.Uri);
        foreach (var part in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split('=', 2);
            if (pieces.Length == 2 && pieces[0] == "ownershipType")
                ownershipText = Uri.UnescapeDataString(pieces[1]);
        }
    }

    private FleetVehicleOwnershipType? ParseOwnership() => Enum.TryParse<FleetVehicleOwnershipType>(ownershipText, out var value) ? value : null;
    private FleetVehicleStatus? ParseStatus() => Enum.TryParse<FleetVehicleStatus>(statusText, out var value) ? value : null;
    private FleetVehicleType? ParseType() => Enum.TryParse<FleetVehicleType>(typeText, out var value) ? value : null;
    private Guid? ParseGuid(string? value) => Guid.TryParse(value, out var id) ? id : null;
    private Guid ResolveCompanyId() => Guid.TryParse(authState?.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var id) ? id : Guid.Empty;
    private bool Can(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private string Name(FleetVehicleDto vehicle) => SharedDataService.SelectViewLang(vehicle.NameEng, vehicle.Name);
    private string StatusTone(FleetVehicleStatus status) => status == FleetVehicleStatus.Active ? "success" : status == FleetVehicleStatus.UnderMaintenance ? "warning" : status == FleetVehicleStatus.Assigned ? "primary" : "muted";
    private string RentalSummary(FleetVehicleDto vehicle) => vehicle.OwnershipType == FleetVehicleOwnershipType.Rented ? $"{vehicle.RentalStartDate:yyyy-MM-dd} - {vehicle.RentalEndDate:yyyy-MM-dd} / {vehicle.MonthlyRent:N2}" : "-";
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
