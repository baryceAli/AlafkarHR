@layout AdminLayout
@page "/Contracts/Renewals"

@using AlAfkarERP.Shared.Pages.Features.Contracts
@using AlAfkarERP.Shared.Pages.Features.Contracts.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Contracts.Dtos
@using SharedWithUI.Contracts.Enums
@using SharedWithUI.Permissions

@implements IDisposable
@inject IContractsService ContractsService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Renewal Work Queue", "قائمة عمل التجديدات")"
                Subtitle="@Text("Process auto-renewals and record renewal fee payments from one operational queue.", "معالجة التجديدات التلقائية وتسجيل رسوم التجديد من قائمة تشغيل واحدة.")"
                Overline="@Text("Contracts", "العقود")"
                Icon="bi-arrow-repeat">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/Contracts/Dashboard")'>
                <i class="bi bi-speedometer2"></i>
                @Text("Dashboard", "لوحة العقود")
            </button>
            <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/Contracts/List")'>
                <i class="bi bi-list-check"></i>
                @Text("Contracts", "العقود")
            </button>
        </Actions>
    </PageHeader>

    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view renewal work.", "ليست لديك صلاحية عرض أعمال التجديد.")</div>
    }
    else
    {
        <AppCard Title="@Text("Renewal Queue", "قائمة التجديدات")">
            <FilterBar CssClass="mb-3">
                <ChildContent>
                    <div class="input-group erp-search-control">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="@Text("Search contract or party", "ابحث بالعقد أو الطرف")" @bind="searchText" @bind:event="oninput" @onkeydown="HandleSearchKey" />
                    </div>
                    <select class="form-select" @bind="status">
                        <option value="">@Text("All statuses", "كل الحالات")</option>
                        @foreach (var option in Enum.GetValues<ContractStatus>())
                        {
                            <option value="@option">@SharedDataService.ContractStatusLabel(option)</option>
                        }
                    </select>
                    <select class="form-select" @bind="paymentStatus">
                        <option value="">@Text("All payment states", "كل حالات الدفع")</option>
                        @foreach (var option in Enum.GetValues<ContractRenewalPaymentStatus>())
                        {
                            <option value="@option">@SharedDataService.PaymentStatusLabel(option)</option>
                        }
                    </select>
                    <InputDate class="form-control" @bind-Value="fromDate" />
                    <InputDate class="form-control" @bind-Value="toDate" />
                </ChildContent>
                <Actions>
                    <button class="btn btn-outline-secondary" @onclick="ClearFilters">
                        <i class="bi bi-x-circle"></i>
                        @Text("Clear", "مسح")
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="SearchAsync">
                        <i class="bi bi-arrow-repeat"></i>
                        @Text("Refresh", "تحديث")
                    </button>
                </Actions>
            </FilterBar>

            <div class="erp-table-wrap">
                <table class="table erp-table mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Contract", "العقد")</th>
                            <th>@Text("Party", "الطرف")</th>
                            <th>@Text("End Date", "تاريخ الانتهاء")</th>
                            <th>@Text("Status", "الحالة")</th>
                            <th>@Text("Renewal", "التجديد")</th>
                            <th class="text-end">@Text("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr><td colspan="6" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                        }
                        else if (contracts.Count == 0)
                        {
                            <tr><td colspan="6" class="text-center text-muted py-4">@Text("No renewal work found.", "لا توجد أعمال تجديد.")</td></tr>
                        }
                        @foreach (var contract in contracts)
                        {
                            var pendingRenewal = contract.Renewals.FirstOrDefault(x => x.PaymentStatus == ContractRenewalPaymentStatus.Pending);
                            <tr>
                                <td><div class="fw-semibold">@contract.Number</div><div class="text-muted small">@contract.Title</div></td>
                                <td><div>@contract.PartyDisplayName</div><div class="text-muted small">@SharedDataService.PartyTypeLabel(contract.PartyType)</div></td>
                                <td>@contract.EndDate.ToString("yyyy-MM-dd")</td>
                                <td><StatusChip Text="@SharedDataService.ContractStatusLabel(contract.Status)" Tone="@StatusTone(contract.Status)" /></td>
                                <td>
                                    @if (pendingRenewal is not null)
                                    {
                                        <div>@pendingRenewal.FeeAmount.ToString("N2")</div>
                                        <StatusChip Text="@SharedDataService.PaymentStatusLabel(pendingRenewal.PaymentStatus)" Tone="@PaymentTone(pendingRenewal.PaymentStatus)" />
                                    }
                                    else if (contract.RenewalSettings.AutoRenew)
                                    {
                                        <StatusChip Text="@Text("Auto Renew", "تجديد تلقائي")" Tone="info" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-outline-primary btn-sm erp-row-action" title="@Text("Open", "فتح")" @onclick='() => NavigationManager.NavigateTo($"/Contracts/Detail/{contract.Id}")'>
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <button class="btn btn-outline-warning btn-sm erp-row-action" title="@Text("Process renewal", "معالجة التجديد")" @onclick="() => ProcessRenewalAsync(contract.Id)" disabled="@(!CanProcess)">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                        <button class="btn btn-outline-success btn-sm erp-row-action" title="@Text("Record payment", "تسجيل الدفع")" @onclick="() => RecordPaymentAsync(contract, pendingRenewal)" disabled="@(!CanRecordPayment(pendingRenewal))">
                                            <i class="bi bi-cash-coin"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(pageIndex <= 1)">@Text("Previous", "السابق")</button>
                <span class="text-muted small">@Text("Page", "صفحة") @pageIndex @Text("of", "من") @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages)">@Text("Next", "التالي")</button>
            </div>
        </AppCard>
    }
</div>

@code {
    private List<ContractDto> contracts = [];
    private AuthenticationState? authState;
    private Guid? companyId;
    private string? searchText;
    private ContractStatus? status = ContractStatus.PendingRenewalPayment;
    private ContractRenewalPaymentStatus? paymentStatus;
    private DateTime? fromDate = DateTime.Today;
    private DateTime? toDate = DateTime.Today.AddDays(30);
    private int pageIndex = 1;
    private int pageSize = 20;
    private long totalCount;
    private bool isLoading;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));

    private bool CanView => HasPermission(PermissionList.ContractRenewalPermissions.View);
    private bool CanProcess => HasPermission(PermissionList.ContractRenewalPermissions.Process);
    private bool CanRecord => HasPermission(PermissionList.ContractRenewalPermissions.RecordPayment);

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var parsedCompanyId))
            companyId = parsedCompanyId;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!CanView)
            return;

        isLoading = true;
        var response = await ContractsService.GetContractsAsync(companyId, null, null, status, null, paymentStatus, fromDate, toDate, pageIndex, pageSize, searchText);
        if (response.IsSuccess)
        {
            contracts = response.Data?.Data?.ToList() ?? [];
            totalCount = response.Data?.Count ?? 0;
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Could not load renewal queue.", "تعذر تحميل قائمة التجديدات."));
        }
        isLoading = false;
    }

    private async Task ProcessRenewalAsync(Guid contractId)
    {
        var response = await ContractsService.ProcessRenewalAsync(contractId);
        if (response.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Renewal processed.", "تمت معالجة التجديد."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Could not process renewal.", "تعذر معالجة التجديد."));
        }
    }

    private async Task RecordPaymentAsync(ContractDto contract, ContractRenewalDto? renewal)
    {
        if (renewal is null)
            return;

        var response = await ContractsService.RecordRenewalPaymentAsync(contract.Id, renewal.Id, null, renewal.FeeAmount);
        if (response.IsSuccess)
        {
            ToastService.ShowSuccess(Text("Renewal payment recorded.", "تم تسجيل دفعة التجديد."));
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Could not record payment.", "تعذر تسجيل الدفع."));
        }
    }

    private bool CanRecordPayment(ContractRenewalDto? renewal) => CanRecord && renewal is not null && renewal.FeeRequired && renewal.PaymentStatus == ContractRenewalPaymentStatus.Pending;
    private async Task SearchAsync() { pageIndex = 1; await LoadAsync(); }
    private async Task ClearFilters() { searchText = null; status = ContractStatus.PendingRenewalPayment; paymentStatus = null; fromDate = DateTime.Today; toDate = DateTime.Today.AddDays(30); await SearchAsync(); }
    private async Task PrevPage() { if (pageIndex > 1) { pageIndex--; await LoadAsync(); } }
    private async Task NextPage() { if (pageIndex < TotalPages) { pageIndex++; await LoadAsync(); } }
    private Task HandleSearchKey(KeyboardEventArgs args) => args.Key == "Enter" ? SearchAsync() : Task.CompletedTask;
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private static string StatusTone(ContractStatus value) => value switch
    {
        ContractStatus.Active => "success",
        ContractStatus.PendingRenewalPayment or ContractStatus.UnderReview => "warning",
        ContractStatus.Terminated or ContractStatus.Expired => "danger",
        ContractStatus.Signed or ContractStatus.Renewed => "info",
        _ => "muted"
    };
    private static string PaymentTone(ContractRenewalPaymentStatus value) => value switch
    {
        ContractRenewalPaymentStatus.Paid => "success",
        ContractRenewalPaymentStatus.Pending => "warning",
        ContractRenewalPaymentStatus.Waived => "info",
        _ => "muted"
    };
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
