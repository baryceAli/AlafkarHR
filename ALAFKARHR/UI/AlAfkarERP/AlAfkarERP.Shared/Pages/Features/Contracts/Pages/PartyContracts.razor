@layout AdminLayout
@page "/Contracts/Party/{PartyType}/{PartyId:guid}"

@using AlAfkarERP.Shared.Pages.Features.Contracts
@using AlAfkarERP.Shared.Pages.Features.Contracts.Services
@using Microsoft.AspNetCore.Components.Authorization
@using SharedWithUI.Contracts.Dtos
@using SharedWithUI.Contracts.Enums
@using SharedWithUI.Permissions

@implements IDisposable
@inject IContractsService ContractsService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager NavigationManager
@inject SharedDataService SharedDataService
@inject ToastService ToastService

<div class="erp-page" dir="@SharedDataService.PageDirection">
    <PageHeader Title="@Text("Party Contracts", "عقود الطرف")"
                Subtitle="@PartySubtitle"
                Overline="@Text("Contracts", "العقود")"
                Icon="bi-person-lines-fill">
        <Actions>
            <button class="btn btn-outline-secondary" @onclick='() => NavigationManager.NavigateTo("/Contracts/List")'>
                <i class="bi bi-list-check"></i>
                @Text("All Contracts", "كل العقود")
            </button>
            <button class="btn btn-primary" @onclick="CreateLinkedContract" disabled="@(!CanCreate)">
                <i class="bi bi-plus-lg"></i>
                @Text("New Linked Contract", "عقد مرتبط جديد")
            </button>
        </Actions>
    </PageHeader>

    @if (!CanView)
    {
        <div class="alert alert-warning">@Text("You don't have permissions to view contracts.", "ليست لديك صلاحية عرض العقود.")</div>
    }
    else
    {
        <AppCard Title="@Text("Contracts", "العقود")">
            <FilterBar CssClass="mb-3">
                <ChildContent>
                    <div class="input-group erp-search-control">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="@Text("Search this party's contracts", "ابحث في عقود هذا الطرف")" @bind="searchText" @bind:event="oninput" @onkeydown="HandleSearchKey" />
                    </div>
                    <select class="form-select" @bind="status">
                        <option value="">@Text("All statuses", "كل الحالات")</option>
                        @foreach (var option in Enum.GetValues<ContractStatus>())
                        {
                            <option value="@option">@SharedDataService.ContractStatusLabel(option)</option>
                        }
                    </select>
                </ChildContent>
                <Actions>
                    <button class="btn btn-outline-secondary" @onclick="SearchAsync"><i class="bi bi-arrow-repeat"></i> @Text("Refresh", "تحديث")</button>
                </Actions>
            </FilterBar>

            <div class="erp-table-wrap">
                <table class="table erp-table mb-0">
                    <thead>
                        <tr>
                            <th>@Text("Number", "الرقم")</th>
                            <th>@Text("Contract", "العقد")</th>
                            <th>@Text("Dates", "التواريخ")</th>
                            <th>@Text("Status", "الحالة")</th>
                            <th class="text-end">@Text("Actions", "الإجراءات")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoading)
                        {
                            <tr><td colspan="5" class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></td></tr>
                        }
                        else if (contracts.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">@Text("No contracts found for this party.", "لم يتم العثور على عقود لهذا الطرف.")</td></tr>
                        }
                        @foreach (var contract in contracts)
                        {
                            <tr>
                                <td><span class="fw-semibold">@contract.Number</span></td>
                                <td><div class="fw-semibold">@contract.Title</div><div class="text-muted small">@contract.Type</div></td>
                                <td>@contract.StartDate.ToString("yyyy-MM-dd") - @contract.EndDate.ToString("yyyy-MM-dd")</td>
                                <td><StatusChip Text="@SharedDataService.ContractStatusLabel(contract.Status)" Tone="@StatusTone(contract.Status)" /></td>
                                <td>
                                    <div class="d-flex justify-content-end gap-2">
                                        <button class="btn btn-outline-primary btn-sm erp-row-action" title="@Text("Open", "فتح")" @onclick='() => NavigationManager.NavigateTo($"/Contracts/Detail/{contract.Id}")'><i class="bi bi-eye"></i></button>
                                        <button class="btn btn-outline-secondary btn-sm erp-row-action" title="@Text("Edit", "تعديل")" @onclick='() => NavigationManager.NavigateTo($"/Contracts/Form/{contract.Id}")' disabled="@(!CanEdit)"><i class="bi bi-pencil-square"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-end align-items-center gap-2 mt-3">
                <button class="btn btn-sm btn-outline-secondary" @onclick="PrevPage" disabled="@(pageIndex <= 1)">@Text("Previous", "السابق")</button>
                <span class="text-muted small">@Text("Page", "صفحة") @pageIndex @Text("of", "من") @TotalPages</span>
                <button class="btn btn-sm btn-outline-secondary" @onclick="NextPage" disabled="@(pageIndex >= TotalPages)">@Text("Next", "التالي")</button>
            </div>
        </AppCard>
    }
</div>

@code {
    [Parameter] public string PartyType { get; set; } = string.Empty;
    [Parameter] public Guid PartyId { get; set; }
    [SupplyParameterFromQuery(Name = "partyName")] public string? PartyName { get; set; }

    private List<ContractDto> contracts = [];
    private AuthenticationState? authState;
    private Guid? companyId;
    private string? searchText;
    private ContractStatus? status;
    private int pageIndex = 1;
    private int pageSize = 20;
    private long totalCount;
    private bool isLoading;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private string PartySubtitle => string.IsNullOrWhiteSpace(PartyName) ? $"{PartyType} - {PartyId}" : $"{PartyName} ({PartyType})";

    private bool CanView => HasPermission(PermissionList.ContractPermissions.View);
    private bool CanCreate => HasPermission(PermissionList.ContractPermissions.Create);
    private bool CanEdit => HasPermission(PermissionList.ContractPermissions.Edit);

    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    protected override async Task OnInitializedAsync()
    {
        authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (Guid.TryParse(authState.User.Claims.FirstOrDefault(c => c.Type == "company_id")?.Value, out var parsedCompanyId))
            companyId = parsedCompanyId;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (authState is not null)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!CanView)
            return;

        isLoading = true;
        var response = await ContractsService.GetContractsAsync(companyId, PartyType, PartyId, status, null, null, null, null, pageIndex, pageSize, searchText);
        if (response.IsSuccess)
        {
            contracts = response.Data?.Data?.ToList() ?? [];
            totalCount = response.Data?.Count ?? 0;
        }
        else
        {
            ToastService.ShowError(response.Error?.GetDisplayMessage(SharedDataService.Language) ?? Text("Could not load party contracts.", "تعذر تحميل عقود الطرف."));
        }
        isLoading = false;
    }

    private void CreateLinkedContract()
    {
        var url = $"/Contracts/Form?partyType={Uri.EscapeDataString(PartyType)}&partyId={PartyId}";
        if (!string.IsNullOrWhiteSpace(PartyName))
            url += $"&partyName={Uri.EscapeDataString(PartyName)}";
        NavigationManager.NavigateTo(url);
    }

    private async Task SearchAsync() { pageIndex = 1; await LoadAsync(); }
    private async Task PrevPage() { if (pageIndex > 1) { pageIndex--; await LoadAsync(); } }
    private async Task NextPage() { if (pageIndex < TotalPages) { pageIndex++; await LoadAsync(); } }
    private Task HandleSearchKey(KeyboardEventArgs args) => args.Key == "Enter" ? SearchAsync() : Task.CompletedTask;
    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);
    private bool HasPermission(string permission) => authState?.User.Claims.Any(c => c.Value == permission) == true;
    private static string StatusTone(ContractStatus value) => value switch
    {
        ContractStatus.Active => "success",
        ContractStatus.PendingRenewalPayment or ContractStatus.UnderReview => "warning",
        ContractStatus.Terminated or ContractStatus.Expired => "danger",
        ContractStatus.Signed or ContractStatus.Renewed => "info",
        _ => "muted"
    };
    private async Task HandleChangeAsync() => await InvokeAsync(StateHasChanged);
    public void Dispose() => SharedDataService.OnChange1 -= HandleChangeAsync;
}
