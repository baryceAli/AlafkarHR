@using AlAfkarERP.Shared.Dtos
@using AlAfkarERP.Shared.Utilities
@using SharedWithUI.GeneralSettings.Dtos

@inject ApiConfig ApiConfig
@inject SharedDataService SharedDataService

@if (HomePage is not null)
{
    if (!IsCurrent)
    {
        <UploadedHomePageTemplateRenderer HomePage="HomePage" />
    }
    else
    {
        <div class="@PageClass" dir="@SharedDataService.PageDirection">
        <nav class="template-nav">
            <a class="template-brand" href="/">
                @if (IsCurrent)
                {
                    <img src="_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" alt="@Text("Nav", "Brand", "ALAFKAR")" />
                }
                else
                {
                    <i class="@TemplateIcon"></i>
                }
                <span>@Text("Nav", "Brand", IsCurrent ? "ALAFKAR" : "Streamline")</span>
            </a>

            @if (!IsCurrent)
            {
                <div class="template-nav-links">
                    <a href="@Text("Nav", "Link1Url", "#features")">@Text("Nav", "Link1", "Features")</a>
                    <a href="@Text("Nav", "Link2Url", "#solutions")">@Text("Nav", "Link2", "Solutions")</a>
                    <a href="@Text("Nav", "Link3Url", "#pricing")">@Text("Nav", "Link3", "Pricing")</a>
                </div>
            }

            <div class="template-nav-actions">
                <a class="template-login-link" href="/login">@Text("Nav", "LoginText", "Login")</a>
                @if (!IsCurrent)
                {
                    <a class="template-nav-cta" href="@Text("Nav", "CtaUrl", "#cta")">@Text("Nav", "CtaText", "Get Started")</a>
                }
            </div>
        </nav>

        <section class="template-hero">
            <div class="template-container template-hero-grid">
                <div class="template-hero-copy">
                    <span class="template-eyebrow">@Text("Hero", "Eyebrow", IsCurrent ? "Alafkar Catering Store" : "Efficiency Reimagined")</span>
                    <h1>@Text("Hero", "Title", IsCurrent ? "Ready meals for organized field operations." : "The modern OS for high-growth teams.")</h1>
                    <p>@Text("Hero", "Subtitle", "A polished public homepage template.")</p>
                    <div class="template-hero-actions">
                        <a class="template-primary-action" href="@Text("Hero", "PrimaryButtonUrl", IsCurrent ? "#products" : "#cta")">@Text("Hero", "PrimaryButtonText", IsCurrent ? "Browse products" : "Get Started")</a>
                        <a class="template-secondary-action" href="@Text("Hero", "SecondaryButtonUrl", IsCurrent ? "/login" : "#features")">@Text("Hero", "SecondaryButtonText", IsCurrent ? "Login to ERP" : "View Demo")</a>
                    </div>
                </div>

                <div class="template-hero-visual" aria-label="@Alt("Hero", "HeroImage")">
                    <div class="template-visual-frame">
                        <img alt="@Alt("Hero", "HeroImage")" src="@Image("Hero", "HeroImage")" />
                    </div>
                    <div class="template-floating-card">
                        <i class="@TemplateIcon"></i>
                        <strong>@Text("Hero", "CardTitle", IsCurrent ? "Fast preparation from request to delivery." : "Premium landing experience.")</strong>
                        <span>@Text("Hero", "Badge", IsCurrent ? "Ready to order" : "Ready")</span>
                    </div>
                </div>
            </div>
        </section>

        <section id="features" class="template-features">
            <div class="template-container">
                @if (!IsCurrent)
                {
                    <div class="template-section-heading">
                        <h2>@Text("Products", "Title", "Powerful by design")</h2>
                        <p>@Text("Products", "Subtitle", "A complete landing-page flavor controlled by tenant content.")</p>
                    </div>
                }
                <div class="template-feature-grid">
                    @foreach (var feature in FeatureSections)
                    {
                        <article class="template-feature-card">
                            <i class="@FeatureIcon(feature)"></i>
                            <h3>@Text(feature, "Title", feature)</h3>
                            <p>@Text(feature, "Text", "Editable feature text.")</p>
                        </article>
                    }
                </div>
            </div>
        </section>

        @if (!IsCurrent)
        {
            <section class="template-stats">
                <div class="template-container template-stat-grid">
                    @foreach (var stat in StatSections.Where(s => Find(s, "Value") is not null || Find(s, "Label") is not null))
                    {
                        <div class="template-stat">
                            <strong>@Text(stat, "Value", "99%")</strong>
                            <span>@Text(stat, "Label", "Uptime")</span>
                        </div>
                    }
                </div>
            </section>

            <section id="cta" class="template-cta-section">
                <div class="template-container">
                    <div class="template-cta-card">
                        <h2>@Text("Cta", "Title", "Ready to get started?")</h2>
                        <p>@Text("Cta", "Text", "Launch the next public homepage experience.")</p>
                        <a class="template-primary-action" href="@Text("Cta", "ButtonUrl", "#")">@Text("Cta", "ButtonText", "Get Started")</a>
                    </div>
                </div>
            </section>

            <footer class="template-footer">
                <div class="template-container">
                    <strong>@Text("Nav", "Brand", "Streamline")</strong>
                    <p>@Text("Footer", "Text", "A configurable tenant homepage.")</p>
                    <span>@Text("Footer", "Copyright", "© 2026 Alafkar. All rights reserved.")</span>
                </div>
            </footer>
        }
        </div>
    }
}

@code {
    [Parameter] public HomePageTemplateDto? HomePage { get; set; }

    private static readonly string[] FeatureSections = ["Feature1", "Feature2", "Feature3"];
    private static readonly string[] StatSections = ["Stat1", "Stat2", "Stat3", "Stat4"];

    private IEnumerable<HomePageContentItemDto> Items => HomePage?.ContentItems ?? [];
    private string TemplateKey => HomePageTemplateKeys.IsValid(HomePage?.ActiveTemplateKey) ? HomePage!.ActiveTemplateKey : HomePageTemplateKeys.CurrentStorefront;
    private bool IsCurrent => TemplateKey == HomePageTemplateKeys.CurrentStorefront;
    private string PageClass => $"template-page template-page-{TemplateKey.ToLowerInvariant()}";

    private string TemplateIcon => TemplateKey switch
    {
        HomePageTemplateKeys.MinimalistLanding => "bi bi-bounding-box",
        HomePageTemplateKeys.SoftSaasLanding => "bi bi-magic",
        HomePageTemplateKeys.BoldEnergeticLanding => "bi bi-lightning-charge",
        HomePageTemplateKeys.CorporateTrustLanding => "bi bi-buildings",
        HomePageTemplateKeys.ModernDarkModeLanding => "bi bi-cpu",
        _ => "bi bi-shop"
    };

    private string FeatureIcon(string section) => TemplateKey switch
    {
        HomePageTemplateKeys.BoldEnergeticLanding => section == "Feature1" ? "bi bi-rocket-takeoff" : section == "Feature2" ? "bi bi-diagram-3" : "bi bi-shield-lock",
        HomePageTemplateKeys.CorporateTrustLanding => section == "Feature1" ? "bi bi-shield-check" : section == "Feature2" ? "bi bi-globe2" : "bi bi-headset",
        HomePageTemplateKeys.ModernDarkModeLanding => section == "Feature1" ? "bi bi-stars" : section == "Feature2" ? "bi bi-graph-up" : "bi bi-lock",
        HomePageTemplateKeys.SoftSaasLanding => section == "Feature1" ? "bi bi-kanban" : section == "Feature2" ? "bi bi-patch-check" : "bi bi-bar-chart",
        HomePageTemplateKeys.MinimalistLanding => section == "Feature1" ? "bi bi-insights" : section == "Feature2" ? "bi bi-lock" : "bi bi-lightning",
        _ => section == "Feature1" ? "bi bi-calendar2-check" : section == "Feature2" ? "bi bi-filter-circle" : "bi bi-shield-check"
    };

    private string Text(string sectionKey, string fieldKey, string fallback = "")
    {
        var item = Find(sectionKey, fieldKey);
        if (item is null || !item.IsVisible)
            return fallback;

        var text = SharedDataService.SelectViewLang(item.TextEn ?? "", item.TextAr ?? "");
        return string.IsNullOrWhiteSpace(text) ? fallback : text;
    }

    private string Alt(string sectionKey, string fieldKey)
    {
        var item = Find(sectionKey, fieldKey);
        var text = SharedDataService.SelectViewLang(item?.AltTextEn ?? "", item?.AltTextAr ?? "");
        return string.IsNullOrWhiteSpace(text) ? "Home page image" : text;
    }

    private string Image(string sectionKey, string fieldKey)
    {
        var item = Find(sectionKey, fieldKey);
        var image = item?.ImageUrl;
        if (string.IsNullOrWhiteSpace(image))
            image = item?.ImagePath;

        if (string.IsNullOrWhiteSpace(image))
            return "_content/AlAfkarERP.Shared/images/Meals/alkaramSingleMeal.png";

        if (image.StartsWith("_content/", StringComparison.OrdinalIgnoreCase)
            || image.StartsWith("data:", StringComparison.OrdinalIgnoreCase)
            || Uri.TryCreate(image, UriKind.Absolute, out _))
        {
            return image;
        }

        return $"{ApiConfig.BaseURL}{image}";
    }

    private HomePageContentItemDto? Find(string sectionKey, string fieldKey)
        => Items.FirstOrDefault(x =>
            x.TemplateKey == TemplateKey &&
            string.Equals(x.SectionKey, sectionKey, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(x.FieldKey, fieldKey, StringComparison.OrdinalIgnoreCase));
}
