@page "/not-found"
@layout LandingPageLayout
@implements IDisposable

@inject SharedDataService SharedDataService

<section dir="@SharedDataService.PageDirection">
    <h3>@Text("Not Found", "??? ?????")</h3>
    <p>@Text("Sorry, the content you are looking for does not exist.", "????? ??????? ???? ???? ??? ??? ?????.")</p>
</section>

@code {
    protected override void OnInitialized()
    {
        SharedDataService.OnChange1 += HandleChangeAsync;
    }

    private async Task HandleChangeAsync()
    {
        await InvokeAsync(StateHasChanged);
    }

    private string Text(string en, string ar) => SharedDataService.SelectViewLang(en, ar);

    public void Dispose()
    {
        SharedDataService.OnChange1 -= HandleChangeAsync;
    }
}
