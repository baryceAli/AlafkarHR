@using AlAfkarERP.Web.Components.PublicWebsite
<!DOCTYPE html>
<html lang="@(IsWebsite && !IsEnglishWebsite ? "ar" : "en")" dir="@(IsWebsite && !IsEnglishWebsite ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (HttpContext?.Request.Query.ContainsKey("websiteEditor") == true)
    {
        <meta name="robots" content="noindex,nofollow" />
        <meta name="referrer" content="no-referrer" />
    }
    <base href="/" />
    <ResourcePreloader />
    @if (IsWebsite)
    {
        <link rel="icon" href="/_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" />
        <link rel="stylesheet" href="/website/fonts.css" />
        <link rel="stylesheet" href="/website/website.css" />
        <link rel="stylesheet" href="/website/content-editor.css" />
    }
    else
    {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="_content/AlAfkarERP.Shared/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    @* <link href="css/harvest-layout.css" rel="stylesheet" /> *@
    <link rel="icon" type="image/png" sizes="32x32" href="_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico">
    <link rel="icon" type="image/png" sizes="16x16" href="_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico">
    @* <link rel="icon" type="image/png" sizes="16x16" href="favicon-16.png"> *@

    <link rel="stylesheet" href="_content/AlAfkarERP.Shared/Home.css" />
    <link rel="stylesheet" href="_content/AlAfkarERP.Shared/theme.css" />
    <link rel="stylesheet" href="_content/AlAfkarERP.Shared/app.css" />
    <link rel="stylesheet" href="AlAfkarERP.Web.styles.css" />
    }
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    @if (IsWebsite)
    {
        <PublicRoutes @rendermode="InteractiveServer" />
    }
    else
    {
        <script src="_content/AlAfkarERP.Shared/theme.js"></script>
        <Routes @rendermode="InteractiveServer" />
    }
    <ReconnectModal />
    @if (!IsWebsite)
    {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.bundle.min.js" integrity="sha384-MrcW6ZMFYlzcLA8Nl+NtUVF0sA7MsXsP1UyJoMp4YLEuNSfAP+JcXn/tWtIaxVXM" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    @* <script src="_content/EShop.Shared/lib/MyJs/PopupMessage.js"></script> *@
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/Charts.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/KanbanScroll.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/LocationPickerMap.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/AttendanceLocation.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/AttendanceTime.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/TableExport.js"></script>
    <script src="_content/AlAfkarERP.Shared/lib/MyJs/DocumentDownload.js"></script>
    }
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
 [CascadingParameter] public HttpContext? HttpContext { get; set; }
 private bool IsWebsite => PublicWebsite.WebsiteRoutes.IsPublic(HttpContext?.Request.Path.Value);
 private bool IsEnglishWebsite => HttpContext?.Request.Path.Value?.Equals("/en", StringComparison.OrdinalIgnoreCase) == true || HttpContext?.Request.Path.Value?.StartsWith("/en/", StringComparison.OrdinalIgnoreCase) == true;
}
