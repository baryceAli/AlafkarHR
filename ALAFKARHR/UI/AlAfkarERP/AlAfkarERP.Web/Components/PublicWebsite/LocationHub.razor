<section class="w-full bg-background px-margin-mobile md:px-margin-tablet lg:px-margin py-space-xl">
<div class="max-w-[1440px] mx-auto flex flex-col gap-space-lg">
<div class="flex flex-col md:flex-row md:items-end justify-between gap-space-sm">
<div class="flex flex-col gap-1">
<span class="font-label-md text-label-md text-primary" data-pw-fields="LocationHub.f001">@Content.Text("LocationHub.f001")</span>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-bold" data-pw-fields="LocationHub.f002">@Content.Text("LocationHub.f002")</h2>
</div>
<p class="font-body-sm text-body-sm text-on-surface-variant max-w-md" data-pw-fields="LocationHub.f003">
          @Content.Text("LocationHub.f003")
        </p>
</div>

<div class="relative w-full h-[450px] rounded-2xl overflow-hidden shadow-2xl bg-surface-container-lowest">

<img class="w-full h-full object-cover" src="@Content.Media("LocationHub.map")" alt="@Content.Text("LocationHub.mapAlt")" data-pw-fields="LocationHub.map,LocationHub.mapAlt" />

<div class="absolute inset-0 bg-gradient-to-t from-background/90 via-surface/30 to-surface/50 pointer-events-none"></div>

<div class="absolute top-1/4 right-1/4 transform translate-x-1/2 -translate-y-1/2 group">
<div class="relative flex items-center justify-center">
<span class="absolute w-8 h-8 rounded-full bg-primary/30 animate-ping"></span>
<div class="w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-2xl">
<span aria-hidden="true" class="material-symbols-outlined text-xl">corporate_fare</span>
</div>
</div>
<div class="absolute -bottom-12 right-1/2 transform translate-x-1/2 whitespace-nowrap bg-surface-container-lowest/95 backdrop-blur-md px-space-md py-1 rounded-lg text-on-surface shadow-2xl font-label-sm text-label-sm" data-pw-fields="LocationHub.f004">
<span class="text-primary font-bold" data-pw-fields="LocationHub.f005">@Content.Text("LocationHub.f005")</span> @Content.Text("LocationHub.f004")
          </div>
</div>
<div class="absolute top-1/2 left-1/3 transform translate-x-1/2 -translate-y-1/2 group">
<div class="relative flex items-center justify-center">
<span class="absolute w-8 h-8 rounded-full bg-primary/20 animate-pulse"></span>
<div class="w-10 h-10 rounded-full bg-surface-container-highest text-primary flex items-center justify-center shadow-2xl">
<span aria-hidden="true" class="material-symbols-outlined text-xl">warehouse</span>
</div>
</div>
<div class="absolute -bottom-12 right-1/2 transform translate-x-1/2 whitespace-nowrap bg-surface-container-lowest/95 backdrop-blur-md px-space-md py-1 rounded-lg text-on-surface shadow-2xl font-label-sm text-label-sm" data-pw-fields="LocationHub.f006">
<span class="text-primary font-bold" data-pw-fields="LocationHub.f007">@Content.Text("LocationHub.f007")</span> @Content.Text("LocationHub.f006")
          </div>
</div>
<div class="absolute bottom-1/4 right-1/3 transform translate-x-1/2 -translate-y-1/2 group">
<div class="relative flex items-center justify-center">
<div class="w-10 h-10 rounded-full bg-surface-container-highest text-primary flex items-center justify-center shadow-2xl">
<span aria-hidden="true" class="material-symbols-outlined text-xl">local_shipping</span>
</div>
</div>
<div class="absolute -bottom-12 right-1/2 transform translate-x-1/2 whitespace-nowrap bg-surface-container-lowest/95 backdrop-blur-md px-space-md py-1 rounded-lg text-on-surface shadow-2xl font-label-sm text-label-sm" data-pw-fields="LocationHub.f008">
<span class="text-primary font-bold" data-pw-fields="LocationHub.f009">@Content.Text("LocationHub.f009")</span> @Content.Text("LocationHub.f008")
          </div>
</div>

<div class="absolute bottom-space-md right-space-md left-space-md md:left-auto md:w-80 bg-surface-container/95 backdrop-blur-md p-space-md rounded-xl shadow-2xl flex flex-col gap-space-xs">
<span class="font-label-sm text-label-sm text-primary font-bold" data-pw-fields="LocationHub.f010">@Content.Text("LocationHub.f010")</span>
<div class="flex items-center gap-space-sm text-on-surface font-body-sm text-body-sm">
<span class="w-3 h-3 rounded-full bg-primary"></span>
<span data-pw-fields="LocationHub.f011">@Content.Text("LocationHub.f011")</span>
</div>
<div class="flex items-center gap-space-sm text-on-surface font-body-sm text-body-sm">
<span class="w-3 h-3 rounded-full bg-secondary"></span>
<span data-pw-fields="LocationHub.f012">@Content.Text("LocationHub.f012")</span>
</div>
</div>
</div>
</div>
</section>