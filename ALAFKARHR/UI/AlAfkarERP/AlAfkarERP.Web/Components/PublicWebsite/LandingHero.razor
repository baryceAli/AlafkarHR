<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/40 to-transparent"></div>

<div class="absolute top-space-md right-space-md left-space-md p-space-md rounded-lg bg-surface-container/90 backdrop-blur-md shadow-lg flex items-center justify-between">
<div class="flex items-center gap-space-sm">
<span class="h-3 w-3 rounded-full bg-primary animate-pulse"></span>
<div class="flex flex-col">
<span class="font-label-sm text-label-sm text-primary font-semibold" data-pw-fields="LandingHero.f021">@Content.Text("LandingHero.f021")</span>
