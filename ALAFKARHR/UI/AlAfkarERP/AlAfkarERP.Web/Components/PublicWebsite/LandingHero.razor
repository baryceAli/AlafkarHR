<span class="font-label-md text-label-md text-on-surface-variant font-semibold" data-pw-fields="LandingHero.f001">
              @Content.Text("LandingHero.f001")
            </span>
</div>

<div class="flex flex-col gap-space-sm">
<div class="flex items-center gap-space-sm">
