<div class="relative w-full overflow-hidden">
<div class="absolute top-0 right-1/4 w-[600px] h-[350px] bg-primary/10 rounded-full blur-[140px] pointer-events-none"></div>
<div class="absolute top-40 left-10 w-[450px] h-[450px] bg-primary-container/5 rounded-full blur-[120px] pointer-events-none"></div>

<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin pt-space-xl pb-space-lg">
<StaticDataNote />

<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-lg">
<div class="max-w-3xl space-y-space-sm">
<div class="inline-flex items-center gap-space-xs px-space-md py-space-xs rounded-full bg-surface-container-high text-primary font-label-md text-label-md shadow-sm">
<span aria-hidden="true" class="material-symbols-outlined text-primary text-base">verified</span>
<span data-pw-fields="ServicesOverview.f001">@Content.Text("ServicesOverview.f001")</span>
</div>
<h1 class="font-headline-xl text-headline-xl text-on-surface font-bold tracking-tight" data-pw-fields="ServicesOverview.f002">
            @Content.Text("ServicesOverview.f002")
          </h1>
<p class="font-body-xl text-body-xl text-on-surface-variant leading-relaxed" data-pw-fields="ServicesOverview.f003">
            @Content.Text("ServicesOverview.f003")
          </p>
</div>

<div class="p-space-md rounded-xl bg-surface-container-low shadow-xl flex items-center gap-space-md">
<div class="w-12 h-12 rounded-lg bg-surface-container-highest flex items-center justify-center text-primary">
<span aria-hidden="true" class="material-symbols-outlined text-2xl">severe_cold</span>
</div>
<div class="flex flex-col">
<div class="flex items-center gap-space-xs">
<span class="w-2.5 h-2.5 rounded-full bg-primary animate-pulse"></span>
<span class="font-label-md text-label-md text-on-surface font-semibold" data-pw-fields="ServicesOverview.f004">@Content.Text("ServicesOverview.f004")</span>
</div>
<span class="font-body-sm text-body-sm text-on-surface-variant font-mono" data-pw-fields="ServicesOverview.f005">@Content.Text("ServicesOverview.f005")</span>
</div>
</div>
</div>

<div class="grid grid-cols-2 md:grid-cols-4 gap-space-md mt-space-xl">
@foreach (var item in Content.Items("ServicesOverview.collection1"))
{
@switch (item.TemplateKey)
{
@case "ServicesOverview.collection1.item1":
<div class="p-space-md rounded-xl bg-surface-container shadow-md flex flex-col justify-between">
<div class="flex items-center justify-between text-on-surface-variant mb-space-xs">
<span class="font-label-sm text-label-sm" data-pw-fields="ServicesOverview.collection1.item1.f006" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item1.f006", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">inventory_2</span>
</div>
<div class="font-headline-md text-headline-md text-primary font-bold" data-pw-fields="ServicesOverview.collection1.item1.f007" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item1.f007", item)</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" data-pw-fields="ServicesOverview.collection1.item1.f008" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item1.f008", item)</span>
</div>
break;
@case "ServicesOverview.collection1.item2":
<div class="p-space-md rounded-xl bg-surface-container shadow-md flex flex-col justify-between">
<div class="flex items-center justify-between text-on-surface-variant mb-space-xs">
<span class="font-label-sm text-label-sm" data-pw-fields="ServicesOverview.collection1.item2.f009" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item2.f009", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">local_shipping</span>
</div>
<div class="font-headline-md text-headline-md text-on-surface font-bold" data-pw-fields="ServicesOverview.collection1.item2.f010" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item2.f010", item)</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" data-pw-fields="ServicesOverview.collection1.item2.f011" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item2.f011", item)</span>
</div>
break;
@case "ServicesOverview.collection1.item3":
<div class="p-space-md rounded-xl bg-surface-container shadow-md flex flex-col justify-between">
<div class="flex items-center justify-between text-on-surface-variant mb-space-xs">
<span class="font-label-sm text-label-sm" data-pw-fields="ServicesOverview.collection1.item3.f012" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item3.f012", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">warehouse</span>
</div>
<div class="font-headline-md text-headline-md text-on-surface font-bold" data-pw-fields="ServicesOverview.collection1.item3.f013" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item3.f013", item)</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" data-pw-fields="ServicesOverview.collection1.item3.f014" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item3.f014", item)</span>
</div>
break;
@case "ServicesOverview.collection1.item4":
<div class="p-space-md rounded-xl bg-surface-container shadow-md flex flex-col justify-between">
<div class="flex items-center justify-between text-on-surface-variant mb-space-xs">
<span class="font-label-sm text-label-sm" data-pw-fields="ServicesOverview.collection1.item4.f015" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item4.f015", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">groups</span>
</div>
<div class="font-headline-md text-headline-md text-primary font-bold" data-pw-fields="ServicesOverview.collection1.item4.f016" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item4.f016", item)</div>
<span class="font-body-sm text-body-sm text-on-surface-variant" data-pw-fields="ServicesOverview.collection1.item4.f017" data-pw-item="@item.Id">@Content.Text("ServicesOverview.collection1.item4.f017", item)</span>
</div>
break;
}
}
</div>
</div>
</div>