@inject IJSRuntime JS
@implements IAsyncDisposable
<form class="d2-form" novalidate @onsubmit="Continue" @onsubmit:preventDefault="true">
    <div class="d2-form-row">
        <div>
            <label for="d2-name">الاسم <span>*</span></label>
            <input id="d2-name" @bind="name" autocomplete="name" placeholder="اسمك الكريم" required maxlength="200" aria-invalid="@Invalid("name")" aria-describedby="@(errors.ContainsKey("name") ? "d2-name-error" : null)" />
            @if (errors.TryGetValue("name", out var nameError)) { <p id="d2-name-error" class="d2-form-error">@nameError</p> }
        </div>
        <div>
            <label for="d2-organisation">الجهة <small>(اختياري)</small></label>
            <input id="d2-organisation" @bind="organisation" autocomplete="organization" placeholder="الجمعية أو الوقف أو الشركة" maxlength="200" aria-invalid="@Invalid("organisation")" aria-describedby="@(errors.ContainsKey("organisation") ? "d2-organisation-error" : null)" />
            @if (errors.TryGetValue("organisation", out var organisationError)) { <p id="d2-organisation-error" class="d2-form-error">@organisationError</p> }
        </div>
    </div>
    <label for="d2-phone">الجوال <span>*</span></label>
    <input id="d2-phone" @bind="phone" type="tel" autocomplete="tel" inputmode="tel" dir="ltr" placeholder="0500000000" required minlength="9" maxlength="20" aria-invalid="@Invalid("phone")" aria-describedby="@(errors.ContainsKey("phone") ? "d2-phone-error" : null)" />
    @if (errors.TryGetValue("phone", out var phoneError)) { <p id="d2-phone-error" class="d2-form-error">@phoneError</p> }
    <label for="d2-message">الرسالة <span>*</span></label>
    <textarea id="d2-message" @bind="message" rows="5" placeholder="اكتب سؤالك أو تفاصيل مشروعك" required maxlength="2000" aria-invalid="@Invalid("message")" aria-describedby="@(errors.ContainsKey("message") ? "d2-message-error" : null)"></textarea>
    @if (errors.TryGetValue("message", out var messageError)) { <p id="d2-message-error" class="d2-form-error">@messageError</p> }
    <p class="d2-form-notice" id="d2-form-notice"><Design2Icon Name="info" />يفتح هذا النموذج الواتساب برسالتك. لا يصل الاستفسار إلى الفريق حتى ترسله هناك.</p>
    @if (errors.Count > 0) { <p class="d2-form-error" role="alert">يرجى تصحيح الحقول الموضحة أعلاه قبل المتابعة عبر الواتساب.</p> }
    <button class="d2-button" type="submit" disabled="@(!interactive)" aria-describedby="d2-form-notice">متابعة عبر الواتساب <span aria-hidden="true">↗</span></button>
    @if (messageUrl != null)
    {
        <div class="d2-form-handoff"><p role="status">رسالتك جاهزة. أكمل إرسالها في الواتساب. إذا لم تُفتح النافذة، استخدم الرابط التالي.</p><a class="d2-text-link" href="@messageUrl" target="_blank" rel="noopener noreferrer">افتح رسالتك في الواتساب ↗</a></div>
    }
</form>
@code {
    private string name = "", organisation = "", phone = "", message = "";
    private bool interactive;
    private readonly Dictionary<string, string> errors = [];
    private string? Invalid(string field) => errors.ContainsKey(field) ? "true" : null;
    private string? messageUrl;
    private IJSObjectReference? module;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try { module = await JS.InvokeAsync<IJSObjectReference>("import", "/website/whatsapp.js"); }
        catch (JSException) { /* The rendered handoff link still works without the optional popup. */ }
        interactive = true;
        StateHasChanged();
    }
    private async Task Continue()
    {
        // Accept Arabic and Persian numeral keyboards as well as Latin digits.
        phone = new string(phone.Select(c => char.IsDigit(c) ? (char)('0' + (int)char.GetNumericValue(c)) : c).ToArray());
        errors.Clear();
        if (string.IsNullOrWhiteSpace(name)) errors["name"] = "يرجى كتابة اسمك الكريم.";
        else if (name.Length > 200) errors["name"] = "يجب ألا يتجاوز الاسم ٢٠٠ حرف.";
        if (organisation.Length > 200) errors["organisation"] = "يجب ألا يتجاوز اسم الجهة ٢٠٠ حرف.";
        if (string.IsNullOrWhiteSpace(phone)) errors["phone"] = "يرجى إدخال رقم الجوال.";
        else if (phone.Length > 20 || phone.Count(char.IsAsciiDigit) < 9 ||
            phone.Any(c => !char.IsAsciiDigit(c) && c is not ('+' or ' ' or '-' or '(' or ')')))
            errors["phone"] = "يرجى إدخال رقم جوال صحيح يحتوي على ٩ أرقام على الأقل ولا يتجاوز ٢٠ محرفًا.";
        if (string.IsNullOrWhiteSpace(message)) errors["message"] = "يرجى كتابة سؤالك أو تفاصيل مشروعك.";
        else if (message.Length > 2000) errors["message"] = "يجب ألا تتجاوز الرسالة ٢٠٠٠ حرف.";
        if (errors.Count > 0) { messageUrl = null; return; }
        messageUrl = WebsiteWhatsApp.Link(WebsiteWhatsApp.Message(new Dictionary<string, string>
        {
            ["الاسم"] = name, ["الجهة"] = organisation, ["الجوال"] = phone, ["الرسالة"] = message
        }));
        if (module != null)
        {
            try { await module.InvokeVoidAsync("openWhatsApp", messageUrl); }
            catch (JSException) { /* Keep the explicit fallback link available. */ }
        }
    }
    public async ValueTask DisposeAsync()
    {
        if (module != null) { try { await module.DisposeAsync(); } catch (JSDisconnectedException) { } }
    }
}
