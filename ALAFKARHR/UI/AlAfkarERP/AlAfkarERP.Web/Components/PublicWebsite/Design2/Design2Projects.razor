<section class="d2-hero"><div class="d2-container d2-narrow"><Design2Heading Hero Centered Title="مشاريعنا" Text="@Design2Content.ProjectsText" /><div class="d2-actions d2-centered"><a target="_top" class="d2-button" href="/design-2/projects#projects-grid">اكتشف مشاريعنا <span aria-hidden="true">↓</span></a><a target="_top" class="d2-text-link" href="/design-2/contact">تحدث معنا <span aria-hidden="true">←</span></a></div></div></section>
<section class="d2-section d2-dark d2-impact-band"><div class="d2-container"><Design2Heading Centered Eyebrow="حصاد الأثر" Title="خبرة المواسم بالأرقام" /><Design2Metrics Items="Design2Content.ProjectMetrics" /></div></section>
<section class="d2-section d2-tinted" id="projects-grid">
    <div class="d2-container">
        <Design2Heading Eyebrow="من الميدان" Title="مشاريعنا" />
        <div class="d2-filters" role="group" aria-label="تصفية المشاريع حسب الخدمة">
            @foreach (var category in Design2Content.ProjectCategories)
            {
                <button type="button" aria-pressed="@(selected == category ? "true" : "false")" @onclick="() => selected = category">@category</button>
            }
        </div>
        <p class="d2-filter-status" role="status" aria-live="polite">@Filtered.Count() مشاريع · @selected</p>
        <div class="d2-grid d2-grid-3">@foreach (var project in Filtered) { <Design2ProjectCard Project="project" @key="project.Title" /> }</div>
        <p class="d2-image-notice">@Design2Content.ImageNotice</p>
    </div>
</section>
<section class="d2-section"><div class="d2-container d2-split"><Design2Heading Title="موقعنا" Text="@Design2Content.Introduction" /><div class="d2-location-panel"><Design2Icon Name="location_on" CssClass="d2-location-icon" /><h3>المقر</h3><p>@Design2Content.Address</p><a target="_top" class="d2-text-link" href="/infrastructure">البنية التشغيلية · الموقع الحالي ↗</a></div></div></section>
<section class="d2-section d2-tinted"><div class="d2-container"><Design2Heading Centered Title="التوثيق والتقارير" Text="@Design2Content.Reasons[0]" /><Design2Cards Items="Design2Content.Reports" /></div></section>
<section class="d2-section d2-dark"><div class="d2-container d2-narrow"><Design2Heading Centered Title="@Design2Content.PartnersTitle" Text="@Design2Content.PartnersText" /><div class="d2-actions d2-centered"><a target="_top" class="d2-button" href="/design-2/partners">شركاء النجاح <span aria-hidden="true">←</span></a></div></div></section>
<Design2CallToAction />
@code {
    private string selected = "الكل";
    private IEnumerable<Design2Content.Project> Filtered => Design2Content.Projects.Where(p => selected == "الكل" || p.Category == selected);
}
