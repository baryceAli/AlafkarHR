<section class="d2-hero"><div class="d2-container d2-narrow"><Design2Heading Hero Centered Title="خدماتنا" Text="@Design2Content.ServicesText" /></div></section>
<div class="d2-container"><nav class="d2-service-tabs" aria-label="انتقل إلى الخدمة">@foreach (var service in Design2Content.Services) { <a target="_top" href="@("/design-2/services#" + service.Id)"><Design2Icon Name="@service.Icon" />@service.Title</a> }</nav></div>
<section class="d2-section">
    <div class="d2-container d2-service-list">
        @foreach (var service in Design2Content.Services.Where(s => s.Id != "infrastructure"))
        {
            var copy = Design2Content.ServiceCopies[service.Id];
            <article class="d2-service-detail" id="@service.Id">
                <div class="d2-service-copy">
                    <Design2Icon Name="@service.Icon" CssClass="d2-icon" /><h2>@service.Title</h2><p>@service.Text</p>
                    <ul class="d2-check-list">@foreach (var item in service.Includes) { <li><span aria-hidden="true">✓</span>@item</li> }</ul>
                    @if (copy.Achievement != null) { <p class="d2-service-achievement">@copy.Achievement</p> }
                    @if (copy.Audience != null) { <h3>لمن هذه الخدمة</h3><p>@copy.Audience</p> }
                    <div class="d2-actions"><a target="_top" class="d2-button" href="@("/design-2/request-proposal?service=" + service.Id)">@copy.Action <span aria-hidden="true">↗</span></a><a target="_top" class="d2-text-link" href="@service.CurrentUrl">تفاصيل الخدمة · الموقع الحالي ↗</a></div>
                </div>
                <figure class="d2-service-visual" data-d2-motion="image"><div class="d2-motion-image-clip"><img src="@Design2Content.Image(service.Image)" alt="@service.Alt" width="512" height="279" loading="lazy" /></div><figcaption>صورة توضيحية للخدمة</figcaption></figure>
            </article>
        }
    </div>
</section>
<section class="d2-section d2-tinted"><div class="d2-container"><Design2Heading Centered Title="خدمات مساندة" Text="@Design2Content.SupportingServicesText" /><Design2Cards Items="Design2Content.SupportingServices" Columns="d2-grid-4" /></div></section>
<section class="d2-section" id="infrastructure">
    <div class="d2-container">
        @{ var infrastructure = Design2Content.Services.Single(s => s.Id == "infrastructure"); }
        <Design2Heading Centered Title="بنيتنا التشغيلية" Text="@infrastructure.Text" />
        <Design2Cards Items="Design2Content.Infrastructure" Columns="d2-grid-4" />
        <div class="d2-section-action"><Design2Heading Title="الجودة والسلامة الغذائية" Text="@Design2Content.FoodSafetyText" /><a target="_top" class="d2-text-link" href="/infrastructure">البنية التشغيلية · الموقع الحالي ↗</a></div>
        <div class="d2-section-action"><Design2Heading Title="التوثيق والتقارير" /><Design2Cards Items="Design2Content.Reports" /></div>
    </div>
</section>
<section class="d2-section d2-tinted"><div class="d2-container d2-narrow"><Design2Heading Centered Title="الأسئلة الشائعة عن الخدمات" /><Design2Faq Items="Design2Content.ServiceFaqs" /></div></section>
<Design2CallToAction />
