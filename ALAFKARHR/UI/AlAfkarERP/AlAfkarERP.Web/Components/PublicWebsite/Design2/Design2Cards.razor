<div class="d2-grid @Columns">
    @foreach (var item in Items)
    {
        <article class="d2-card" data-d2-motion="card">
            <Design2Icon Name="@item.Icon" CssClass="d2-icon" />
            <h3>@item.Title</h3><p>@item.Text</p>
        </article>
    }
</div>
@code {
    [Parameter, EditorRequired] public IEnumerable<Design2Content.Item> Items { get; set; } = [];
    [Parameter] public string Columns { get; set; } = "d2-grid-3";
}
