<section class="d2-hero">
    <div class="d2-container d2-split">
        <div><Design2Heading Hero Eyebrow="تسع سنوات في خدمة ضيوف الرحمن" Title="من نحن" Text="@Design2Content.Introduction" /><div class="d2-actions"><a target="_top" class="d2-button" href="/design-2/about#story">تعرّف على قصتنا <span aria-hidden="true">↓</span></a><a target="_top" class="d2-text-link" href="/design-2/contact">تواصل معنا <span aria-hidden="true">←</span></a></div></div>
        <figure class="d2-feature-image" data-d2-motion="image"><img src="@Design2Content.Image("iftar.webp")" alt="صورة توضيحية لخدمات إفطار الصائم" width="512" height="279" fetchpriority="high" /><figcaption>من الفكرة إلى الأثر <small>صورة توضيحية، وليست صورة لفريق الشركة</small></figcaption></figure>
    </div>
</section>
<section class="d2-section" id="story">
    <div class="d2-container">
        <Design2Heading Centered Title="@Design2Content.StoryTitle" />
        <div class="d2-grid d2-grid-3 d2-timeline">@for (var i = 0; i < Design2Content.Story.Length; i++) { var step = Design2Content.Story[i]; <article class="d2-card" data-d2-motion="card"><span class="d2-step">@((i + 1).ToString("00"))</span><h3>@step.Title</h3><p>@step.Text</p></article> }</div>
    </div>
</section>
<section class="d2-section d2-dark">
    <div class="d2-container d2-split">
        <div><Design2Heading Title="كلمة المؤسس" /><p class="d2-signature">@Design2Content.Founder<small>@Design2Content.FounderRole</small></p></div>
        <blockquote class="d2-quote"><span class="d2-quote-mark" aria-hidden="true">“</span>@foreach (var paragraph in Design2Content.FounderStatement) { <p>@paragraph</p> }</blockquote>
    </div>
</section>
<section class="d2-section">
    <div class="d2-container">
        <Design2Heading Centered Title="الرؤية والرسالة" />
        <div class="d2-grid d2-grid-2">
            <article class="d2-card d2-vision" data-d2-motion="card"><Design2Icon Name="visibility" CssClass="d2-icon" /><h3>رؤيتنا</h3><p>@Design2Content.Vision</p></article>
            <article class="d2-card" data-d2-motion="card"><Design2Icon Name="flag" CssClass="d2-icon" /><h3>رسالتنا</h3><p>@Design2Content.Mission</p></article>
        </div>
    </div>
</section>
<section class="d2-section d2-tinted"><div class="d2-container"><Design2Heading Centered Title="قيمنا" /><Design2Cards Items="Design2Content.Values" Columns="d2-grid-4" /></div></section>
<section class="d2-section d2-tinted">
    <div class="d2-container d2-split">
        <div><Design2Heading Title="فريقنا" Text="@Design2Content.TeamText" /></div>
        <div class="d2-team-numbers"><div class="d2-card" data-d2-motion="card"><strong>40</strong><span>موظفًا دائمًا</span></div><div class="d2-card d2-dark" data-d2-motion="card"><strong>800</strong><span>كادر في رمضان</span></div><div class="d2-card" data-d2-motion="card"><strong>600</strong><span>كادر في الحج</span></div></div>
    </div>
</section>
<section class="d2-section"><div class="d2-container"><Design2Heading Centered Title="من نخدم" /><Design2Cards Items="Design2Content.Audiences" /></div></section>
<Design2CallToAction />
