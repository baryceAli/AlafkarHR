@page "/design-2"
@page "/design-2/{*Path}"
@layout Design2Layout
<PageTitle>@(Page?.Title ?? "الصفحة غير موجودة | الأفكار الناجحة")</PageTitle>
<HeadContent>
    <meta name="description" content="@(Page?.Description ?? "الصفحة المطلوبة غير موجودة في معاينة التصميم الثاني.")" />
</HeadContent>
@switch (Page?.Key)
{
    case "": <Design2Home /> break;
    case "about": <Design2About /> break;
    case "services": <Design2Services /> break;
    case "projects": <Design2Projects /> break;
    case "partners": <Design2Partners /> break;
    case "contact": <Design2Contact /> break;
    case "request-proposal": <Design2RequestProposal /> break;
    default:
        <section class="d2-section d2-not-found">
            <div class="d2-container d2-centered">
                <span class="d2-eyebrow">404 · التصميم الثاني</span>
                <h1>الصفحة غير موجودة</h1>
                <p>هذه الصفحة غير متاحة ضمن معاينة التصميم الثاني.</p>
                <a target="_top" class="d2-button" href="/design-2">العودة إلى الرئيسية <span aria-hidden="true">←</span></a>
            </div>
        </section>
        break;
}
@code {
    [Parameter] public string? Path { get; set; }
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private Design2Content.Page? Page => Design2Content.Find(Path);
    protected override void OnParametersSet()
    {
        if (Page == null && HttpContext is { Response.HasStarted: false }) HttpContext.Response.StatusCode = 404;
    }
}
