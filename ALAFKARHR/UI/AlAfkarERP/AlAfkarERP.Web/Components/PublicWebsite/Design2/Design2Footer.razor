<footer class="d2-footer">
    <div class="d2-container">
        <div class="d2-footer-grid">
            <div>
                <a target="_top" class="d2-brand" href="/design-2"><span class="d2-brand-mark" aria-hidden="true"><img src="/_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" alt="" width="32" height="32" /></span><span><strong>الأفكار الناجحة</strong><small>@Design2Content.Slogan</small></span></a>
                <p>@Design2Content.FooterText</p>
            </div>
            <nav aria-label="روابط المعاينة">
                <h2>روابط سريعة</h2>
                @foreach (var entry in Design2Content.Pages.Skip(1)) { <a target="_top" href="@entry.Url">@entry.Label</a> }
            </nav>
            <nav aria-label="خدمات الموقع الحالي">
                <h2>خدماتنا</h2>
                <small>التفاصيل في الموقع الحالي ↗</small>
                @foreach (var service in Design2Content.Services.Take(5)) { <a target="_top" href="@service.CurrentUrl">@Design2Content.ServiceCopies[service.Id].HomeTitle</a> }
                <a target="_top" href="/infrastructure">البنية التشغيلية · الموقع الحالي ↗</a>
                <a target="_top" href="/packages">متجر الأفكار · الموقع الحالي ↗</a>
            </nav>
            <div>
                <h2>تواصل</h2>
                <a target="_top" href="tel:+966580007040" dir="ltr">058 000 70 40</a>
                <a target="_top" href="mailto:info@al-afkar.sa">@Design2Content.Email</a>
                <p>@Design2Content.Address</p>
            </div>
        </div>
        <div class="d2-footer-bottom">
            <small>@Design2Content.Copyright</small>
            <nav aria-label="روابط قانونية في الموقع الحالي"><a target="_top" href="/privacy-policy">سياسة الخصوصية · الموقع الحالي ↗</a><a target="_top" href="/terms-and-conditions">الشروط والأحكام · الموقع الحالي ↗</a></nav>
        </div>
    </div>
</footer>
