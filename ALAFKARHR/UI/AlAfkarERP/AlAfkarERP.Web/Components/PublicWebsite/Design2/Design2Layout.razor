@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Microsoft.JSInterop.IJSRuntime JS
@using Microsoft.JSInterop
@implements IAsyncDisposable
<div @ref="root" class="d2-site" lang="ar" dir="rtl" data-enhance-nav="false">
    <a target="_top" class="d2-skip" href="@(new Uri(Navigation.Uri).AbsolutePath + "#d2-main")">انتقل إلى المحتوى</a>
    <aside class="d2-comparison" aria-label="مقارنة التصميمين">
        <div class="d2-container">
            <span><span class="d2-dot" aria-hidden="true"></span> معاينة التصميم الثاني <span class="d2-comparison-note">· محتوى ثابت للمقارنة</span></span>
            <a target="_top" href="@CurrentUrl">شاهد التصميم الحالي <span aria-hidden="true">↗</span></a>
            <button type="button" class="d2-motion-toggle" data-d2-motion-toggle hidden>إيقاف الحركة</button>
        </div>
    </aside>
    <Design2Header />
    <main id="d2-main">@Body</main>
    <Design2Footer />
</div>
@code {
    private ElementReference root;
    private IJSObjectReference? module;
    private IJSObjectReference? connection;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "/website/design-2/motion.js");
            connection = await module.InvokeAsync<IJSObjectReference>("connect", root);
        }
        catch (JSException) { /* Content stays visible when optional motion is unavailable. */ }
    }
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (connection != null)
            {
                await connection.InvokeVoidAsync("disconnect");
                await connection.DisposeAsync();
            }
            if (module != null) await module.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
    }
    private string CurrentUrl => Design2Content.Find(new Uri(Navigation.Uri).AbsolutePath[Design2Content.Root.Length..].TrimStart('/'))?.CurrentUrl ?? "/";
}
