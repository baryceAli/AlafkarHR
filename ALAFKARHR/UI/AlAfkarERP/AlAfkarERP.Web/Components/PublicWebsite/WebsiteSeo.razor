@using System.Text.Json
@inject WebsiteRuntimeSettings Runtime
<PageTitle>@Page.Title</PageTitle>
<HeadContent>
    <meta name="description" content="@Page.Description" />
    <link rel="canonical" href="@(origin + Page.Url)" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@WebsiteContent.Brand" />
    <meta property="og:title" content="@Page.Title" />
    <meta property="og:description" content="@Page.Description" />
    <meta property="og:url" content="@(origin + Page.Url)" />
    <meta property="og:image" content="@(origin + WebsiteContent.HeroImage)" />
    <meta property="og:image:alt" content="صورة توضيحية لخدمات الإعاشة والنقل" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@Page.Title" />
    <meta name="twitter:description" content="@Page.Description" />
    <meta name="twitter:image" content="@(origin + WebsiteContent.HeroImage)" />
    <meta name="twitter:image:alt" content="صورة توضيحية لخدمات الإعاشة والنقل" />
    @if (Page.Key.Length == 0)
    {
        <script type="application/ld+json">@((MarkupString)Organization)</script>
    }
</HeadContent>
@code {
    [Parameter, EditorRequired] public WebsiteContent.Page Page { get; set; } = default!;
    private string origin = "";
    protected override async Task OnInitializedAsync() => origin = await Runtime.OriginAsync();
    private string Organization => JsonSerializer.Serialize(new Dictionary<string, object>
    {
        ["@context"] = "https://schema.org", ["@type"] = "Organization",
        ["name"] = "شركة الأفكار الناجحة التجارية", ["url"] = origin + "/",
        ["email"] = WebsiteContent.Email, ["telephone"] = WebsiteWhatsApp.Phone,
        ["address"] = new Dictionary<string, string> { ["@type"] = "PostalAddress", ["streetAddress"] = WebsiteContent.Address, ["addressLocality"] = "مكة المكرمة", ["addressCountry"] = "SA" }
    });
}
