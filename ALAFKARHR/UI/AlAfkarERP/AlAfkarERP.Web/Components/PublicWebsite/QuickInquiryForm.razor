<form @onsubmit="Submit" @onsubmit:preventDefault="true" class="flex flex-col gap-space-md">
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

<div class="flex flex-col gap-space-xs text-right">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="quickinquiryform-field-0">الاسم الكريم / ممثل الجهة</label>
<input class="w-full h-11 px-space-md rounded bg-surface text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 focus:outline-none focus:ring-1 focus:ring-primary transition-all" id="quickinquiryform-field-0" name="quickinquiryform-field-0" placeholder="مثال: أ. عبد الله الغامدي" required="" type="text"/>
</div>

<div class="flex flex-col gap-space-xs text-right">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="quickinquiryform-field-1">رقم الجوال / واتساب</label>
<input autocomplete="tel" class="w-full h-11 px-space-md rounded bg-surface text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 text-right focus:outline-none focus:ring-1 focus:ring-primary transition-all" dir="ltr" id="quickinquiryform-field-1" maxlength="20" minlength="9" name="quickinquiryform-field-1" placeholder="05XXXXXXXX" required="" type="tel"/>
</div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

<div class="flex flex-col gap-space-xs text-right">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="quickinquiryform-field-2">نوع الجهة</label>
<select class="w-full h-11 px-space-md rounded bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary transition-all cursor-pointer" id="quickinquiryform-field-2" name="quickinquiryform-field-2">
<option value="charity">جمعية خيرية / وقف إنساني</option>
<option value="tawafa">شركة طوافة / خدمة حجاج</option>
<option value="government">جهة حكومية / تنظيمية</option>
<option value="catering">شركة إعاشة وتغذية</option>
<option value="private">قطاع خاص / مبادرة فردية</option>
</select>
</div>

<div class="flex flex-col gap-space-xs text-right">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="quickinquiryform-field-3">الخدمة المطلوبة</label>
<select class="w-full h-11 px-space-md rounded bg-surface text-on-surface font-body-md text-body-md focus:outline-none focus:ring-1 focus:ring-primary transition-all cursor-pointer" id="quickinquiryform-field-3" name="quickinquiryform-field-3">
<option value="hajj">إعاشة حجاج (المشاعر المقدسة / منى)</option>
<option value="iftar">وجبات إفطار صائم بالمسجد الحرام</option>
<option value="suqya">مشاريع سقيا الماء والتوزيع الميداني</option>
<option value="food-baskets">توريد سلال غذائية ومواد تموينية</option>
<option value="fleet">حلول النقل المبرد والتشغيل اللوجستي</option>
</select>
</div>
</div>

<div class="flex flex-col gap-space-xs text-right">
<label class="font-label-md text-label-md text-on-surface font-semibold" for="quickinquiryform-field-4">تفاصيل المشروع المقدرة (الكمية، التوقيت، الموقع)</label>
<textarea class="w-full p-space-md rounded bg-surface text-on-surface font-body-md text-body-md placeholder:text-on-surface-variant/60 focus:outline-none focus:ring-1 focus:ring-primary transition-all resize-none" id="quickinquiryform-field-4" name="quickinquiryform-field-4" placeholder="يرجى ذكر التقديرات الأولية لعدد الوجبات أو المستفيدين والموعد المستهدف للتنفيذ..." rows="3"></textarea>
</div>

<div class="pt-space-xs">
<button class="w-full py-space-md rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow-lg transition-all duration-300 hover:bg-tertiary flex items-center justify-center gap-space-sm" type="submit" disabled="@(!Interactive)">
<span aria-hidden="true" class="material-symbols-outlined text-xl">send</span>
<span>إرسال طلب الاستشارة وعرض السعر الآن</span>
</button>
<p class="font-label-sm text-label-sm text-on-surface-variant text-center mt-2">نموذج توضيحي فقط — لا تُرسل البيانات ولا تُحفظ.</p>
</div>
</form>
<p class="website-demo-note">عرض توضيحي: لا يتم إرسال طلب أو إنشاء تعاقد في هذه النسخة.</p>
@if (Submitted)
{
<p class="website-demo-note" role="status">تم التحقق محلياً من النموذج التجريبي. لم يتم إرسال البيانات أو حفظها، ولم يُنشأ أي طلب.</p>
}

@code {
 private bool Submitted;
 private bool Interactive;
 protected override void OnAfterRender(bool firstRender)
 {
  if (firstRender) { Interactive = true; StateHasChanged(); }
 }
 private void Submit() => Submitted = true;
}
