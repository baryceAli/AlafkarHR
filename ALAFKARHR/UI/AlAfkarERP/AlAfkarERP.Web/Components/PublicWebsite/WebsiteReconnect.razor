@* Public-only reconnect grace period; the ERP reconnect handler stays independent. *@
<script type="module" src="@Assets["website/reconnect.js"]"></script>
<dialog id="components-reconnect-modal" class="pw-site pw-reconnect" lang="ar" dir="rtl" data-nosnippet aria-label="حالة الاتصال">
    <div class="pw-reconnect-content">
        <p class="components-reconnect-first-attempt-visible">جارٍ إعادة الاتصال…</p>
        <p class="components-reconnect-repeated-attempt-visible">تعذر الاتصال. نحاول مجددًا خلال <span id="components-seconds-to-next-attempt"></span> ثانية.</p>
        <p class="components-reconnect-failed-visible">تعذر إعادة الاتصال. حاول مجددًا أو أعد تحميل الصفحة.</p>
        <button id="components-reconnect-button" class="pw-button components-reconnect-failed-visible">حاول مجددًا</button>
        <p class="components-pause-visible">توقفت الجلسة مؤقتًا.</p>
        <button id="components-resume-button" class="pw-button components-pause-visible">متابعة</button>
        <p class="components-resume-failed-visible">تعذرت المتابعة. أعد تحميل الصفحة.</p>
    </div>
</dialog>
