<footer class="pw-footer">
    <div class="pw-container">
        <div class="pw-footer-grid">
            <div>
                <a class="pw-brand" href="/"><span class="pw-brand-mark" aria-hidden="true"><img src="/_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" alt="" width="32" height="32" /></span><span><strong>الأفكار الناجحة</strong><small>@WebsiteContent.Slogan</small></span></a>
                <p>@WebsiteContent.FooterText</p>
            </div>
            <nav aria-label="روابط الموقع">
                <h2>روابط سريعة</h2>
                @foreach (var entry in WebsiteContent.Pages.Skip(1)) { <a href="@entry.Url">@entry.Label</a> }
            </nav>
            <nav aria-label="خدماتنا">
                <h2>خدماتنا</h2>
                @foreach (var service in WebsiteContent.Services.Take(5)) { <a href="@service.Url">@WebsiteContent.ServiceCopies[service.Id].HomeTitle</a> }
                <a href="/services#infrastructure">البنية التشغيلية</a>
            </nav>
            <div>
                <h2>تواصل</h2>
                <a target="_top" href="tel:+966580007040" dir="ltr">058 000 70 40</a>
                <a target="_top" href="mailto:info@al-afkar.sa">@WebsiteContent.Email</a>
                <p>@WebsiteContent.Address</p>
            </div>
        </div>
        <div class="pw-footer-bottom">
            <small>@WebsiteContent.Copyright</small>
            <button type="button" class="pw-motion-toggle" data-pw-motion-toggle hidden>إيقاف الحركة</button>
        </div>
    </div>
</footer>
