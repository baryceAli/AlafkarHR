<section class="website-projects-overview relative w-full overflow-hidden bg-surface-container-lowest py-space-xl">
<div class="absolute inset-0 pointer-events-none opacity-20">
<div class="absolute -top-32 right-10 w-96 h-96 rounded-full bg-primary/10 blur-3xl"></div>
<div class="absolute bottom-0 left-20 w-80 h-80 rounded-full bg-primary-container/10 blur-3xl"></div>
</div>
<div class="relative max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin flex flex-col gap-space-lg">
<StaticDataNote />

<div class="flex flex-wrap items-center justify-between gap-space-md">
<div class="flex items-center gap-space-xs bg-surface-container px-space-md py-space-xs rounded-full">
<span aria-hidden="true" class="material-symbols-outlined text-primary text-base" style="font-variation-settings: 'FILL' 1;">verified</span>
<span class="font-label-sm text-label-sm text-primary uppercase tracking-wider" data-pw-fields="ProjectsOverview.f001">@Content.Text("ProjectsOverview.f001")</span>
</div>
<div class="flex items-center gap-space-sm bg-surface-container-low px-space-md py-space-xs rounded-lg">
<span aria-hidden="true" class="material-symbols-outlined text-primary text-sm">schedule</span>
<span class="font-body-sm text-body-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.f002">@Content.Text("ProjectsOverview.f002")</span>
</div>
</div>
<div class="flex flex-col gap-space-sm max-w-4xl">
<h1 class="font-headline-xl text-headline-xl md:text-display-hero text-on-surface font-bold tracking-tight" data-pw-fields="ProjectsOverview.f003">
          @Content.Text("ProjectsOverview.f003") <span class="text-primary" data-pw-fields="ProjectsOverview.f004">@Content.Text("ProjectsOverview.f004")</span>
</h1>
<p class="font-body-xl text-body-xl text-on-surface-variant leading-relaxed" data-pw-fields="ProjectsOverview.f005">
          @Content.Text("ProjectsOverview.f005")
        </p>
</div>
<div class="grid grid-cols-2 md:grid-cols-4 gap-space-md pt-space-md">
@foreach (var item in Content.Items("ProjectsOverview.collection1"))
{
@switch (item.TemplateKey)
{
@case "ProjectsOverview.collection1.item1":
<div class="p-space-lg bg-surface-container rounded-xl flex flex-col gap-space-xs shadow-md">
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item1.f006" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item1.f006", item)</span>
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight" data-counter="4850000" data-pw-fields="ProjectsOverview.collection1.item1.f007" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item1.f007", item)</span>
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item1.f008" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item1.f008", item)</span>
</div>
<span class="font-body-sm text-body-sm text-secondary" data-pw-fields="ProjectsOverview.collection1.item1.f009" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item1.f009", item)</span>
</div>
break;
@case "ProjectsOverview.collection1.item2":
<div class="p-space-lg bg-surface-container rounded-xl flex flex-col gap-space-xs shadow-md">
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item2.f010" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item2.f010", item)</span>
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight" data-counter="12400000" data-pw-fields="ProjectsOverview.collection1.item2.f011" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item2.f011", item)</span>
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item2.f012" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item2.f012", item)</span>
</div>
<span class="font-body-sm text-body-sm text-secondary" data-pw-fields="ProjectsOverview.collection1.item2.f013" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item2.f013", item)</span>
</div>
break;
@case "ProjectsOverview.collection1.item3":
<div class="p-space-lg bg-surface-container rounded-xl flex flex-col gap-space-xs shadow-md">
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item3.f014" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item3.f014", item)</span>
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight" data-counter="320000" data-pw-fields="ProjectsOverview.collection1.item3.f015" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item3.f015", item)</span>
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item3.f016" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item3.f016", item)</span>
</div>
<span class="font-body-sm text-body-sm text-secondary" data-pw-fields="ProjectsOverview.collection1.item3.f017" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item3.f017", item)</span>
</div>
break;
@case "ProjectsOverview.collection1.item4":
<div class="p-space-lg bg-surface-container rounded-xl flex flex-col gap-space-xs shadow-md">
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item4.f018" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item4.f018", item)</span>
<div class="flex items-baseline gap-space-xs">
<span class="font-headline-xl text-headline-xl text-primary font-bold tracking-tight" data-pw-fields="ProjectsOverview.collection1.item4.f019" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item4.f019", item)</span>
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="ProjectsOverview.collection1.item4.f020" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item4.f020", item)</span>
</div>
<span class="font-body-sm text-body-sm text-secondary" data-pw-fields="ProjectsOverview.collection1.item4.f021" data-pw-item="@item.Id">@Content.Text("ProjectsOverview.collection1.item4.f021", item)</span>
</div>
break;
}
}
</div>
</div>
</section>