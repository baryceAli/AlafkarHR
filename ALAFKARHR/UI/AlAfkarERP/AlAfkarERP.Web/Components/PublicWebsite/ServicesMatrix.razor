                @Content.Text("ServicesMatrix.collection1.item3.f012", item)
              </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed" data-pw-fields="ServicesMatrix.collection1.item3.f013" data-pw-item="@item.Id">
                @Content.Text("ServicesMatrix.collection1.item3.f013", item)
              </p>
</div>
</div>
<a class="pt-space-lg flex items-center justify-between" href="@Content.Link("ServicesMatrix.collection1.item3.f014", item)" data-pw-fields="ServicesMatrix.collection1.item3.f014" data-pw-item="@item.Id">
<span class="font-label-sm text-label-sm text-primary font-semibold" data-pw-fields="ServicesMatrix.collection1.item3.f015" data-pw-item="@item.Id">@Content.Text("ServicesMatrix.collection1.item3.f015", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-lg">arrow_forward</span>
</a>
</div>
break;
@case "ServicesMatrix.collection1.item4":
<div class="group rounded-xl p-space-lg bg-surface-container flex flex-col justify-between shadow-md transition-all duration-300 hover:bg-surface-container-high">
