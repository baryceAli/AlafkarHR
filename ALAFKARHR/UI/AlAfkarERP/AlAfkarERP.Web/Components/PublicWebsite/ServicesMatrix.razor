<span aria-hidden="true" class="material-symbols-outlined text-3xl">water_drop</span>
</div>
<div class="flex flex-col gap-space-xs">
<h3 class="font-headline-md text-headline-md text-on-surface font-bold group-hover:text-primary transition-colors" data-pw-fields="ServicesMatrix.collection1.item4.f016" data-pw-item="@item.Id">
                @Content.Text("ServicesMatrix.collection1.item4.f016", item)
              </h3>
<p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed" data-pw-fields="ServicesMatrix.collection1.item4.f017" data-pw-item="@item.Id">
