<form @onsubmit="Submit" @onsubmit:preventDefault="true" class="flex flex-col gap-space-sm">
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-secondary" for="partnerreportform-field-0">رقم المشروع أو كود العقد</label>
<div class="bg-surface-container-lowest rounded-lg p-space-xs flex items-center gap-space-xs">
<span aria-hidden="true" class="material-symbols-outlined text-on-surface-variant text-lg">tag</span>
<input class="bg-transparent border-0 outline-none text-on-surface font-body-sm text-body-sm w-full" id="partnerreportform-field-0" name="partnerreportform-field-0" placeholder="مثال: NJH-HAJJ-1446-90" type="text"/>
</div>
</div>
<div class="flex flex-col gap-space-xs">
<label class="font-label-sm text-label-sm text-secondary" for="partnerreportform-field-1">رمز تجريبي (لا تدخل بيانات اعتماد حقيقية)</label>
<div class="bg-surface-container-lowest rounded-lg p-space-xs flex items-center gap-space-xs">
<span aria-hidden="true" class="material-symbols-outlined text-on-surface-variant text-lg">key</span>
<input class="bg-transparent border-0 outline-none text-on-surface font-body-sm text-body-sm w-full" id="partnerreportform-field-1" name="partnerreportform-field-1" placeholder="••••••••" type="text" autocomplete="off"/>
</div>
</div>
<button class="mt-space-xs w-full py-space-sm rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold hover:bg-primary-container transition-all flex items-center justify-center gap-space-xs" type="submit" disabled="@(!Interactive)">
<span aria-hidden="true" class="material-symbols-outlined text-base">login</span>
<span>عرض التقرير الموثق الفوري</span>
</button>
</form>
<p class="website-demo-note">عرض توضيحي: لا يتم إرسال طلب أو إنشاء تعاقد في هذه النسخة.</p>
@if (Submitted)
{
<p class="website-demo-note" role="status">تم التحقق محلياً من النموذج التجريبي. لم يتم إرسال البيانات أو حفظها، ولم يُنشأ أي طلب.</p>
}

@code {
 private bool Submitted;
 private bool Interactive;
 protected override void OnAfterRender(bool firstRender)
 {
  if (firstRender) { Interactive = true; StateHasChanged(); }
 }
 private void Submit() => Submitted = true;
}
