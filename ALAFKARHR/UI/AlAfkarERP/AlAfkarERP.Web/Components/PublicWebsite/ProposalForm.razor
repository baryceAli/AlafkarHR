<form @onsubmit="Submit" @onsubmit:preventDefault="true" class="flex flex-col gap-space-md">

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-0">
              الاسم الكامل / اسم الجهة أو الجمعية الخيرية
              <span class="text-error">*</span>
</label>
<div class="relative">
<span aria-hidden="true" class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant text-xl pointer-events-none">corporate_fare</span>
<input class="w-full h-11 bg-surface-container-lowest text-on-surface pr-10 pl-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="proposalform-field-0" name="proposalform-field-0" placeholder="مثال: جمعية الإحسان لرعاية ضيوف الرحمن / مؤسسة إعاشة الحجاج" required="" type="text"/>
</div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-1">
                نوع الجهة
                <span class="text-error">*</span>
</label>
<select class="w-full h-11 bg-surface-container-lowest text-on-surface px-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors cursor-pointer" id="proposalform-field-1" name="proposalform-field-1" required="">
<option disabled="" selected="" value="">اختر صفة الجهة التعاقدية</option>
<option value="charity">جمعية خيرية / منظمة غير ربحية</option>
<option value="catering">شركة إعاشة وتموين مؤسسي</option>
<option value="donor">جهة مانحة / أوقاف استثمارية</option>
<option value="hajj">شركة خدمة حجاج (طوافة / داخل)</option>
<option value="individual">فاعل خير / قطاع أفراد</option>
</select>
</div>

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-2">
                نوع الخدمة أو الباقة المطلوبة
                <span class="text-error">*</span>
</label>
<select class="w-full h-11 bg-surface-container-lowest text-on-surface px-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors cursor-pointer" @bind="SelectedService" id="proposalform-field-2" name="proposalform-field-2" required="">
<option disabled="" selected="" value="">حدد البرنامج اللوجستي</option>
<option value="إعاشة حجاج">إعاشة حجاج المشاعر المقدسة</option>
<option value="إفطار صائم">وجبات إفطار صائم بالحرم المكي</option>
<option value="سقيا">برنامج السقيا المباركة والمياه</option>
<option value="سلال غذائية">السلال والمواد الغذائية التموينية</option>
<option value="توريد مباشر">توريد التمور والمواد الجافة</option>
<option value="نقل وتخزين مبرد">نقل وتخزين مبرد ومجمد</option>
<option value="غير ذلك">أخرى / حقائب مدرسية وكسوة</option>
</select>
</div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-space-md">

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-3">
                عدد المستفيدين / حجم الكمية التقديري
                <span class="text-error">*</span>
</label>
<div class="relative">
<span aria-hidden="true" class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant text-xl pointer-events-none">groups</span>
<input class="w-full h-11 bg-surface-container-lowest text-on-surface pr-10 pl-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" id="proposalform-field-3" name="proposalform-field-3" placeholder="مثال: 5,000 وجبة أو 500 سلة تموينية" required="" type="text"/>
</div>
</div>

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-4">
                رقم الجوال المعتمد (السعودية)
                <span class="text-error">*</span>
</label>
<div class="relative" dir="ltr">
<span class="absolute left-3 top-3 text-primary font-bold text-sm pointer-events-none">+966</span>
<input autocomplete="tel" class="w-full h-11 bg-surface-container-lowest text-on-surface pl-16 pr-space-md text-left rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" dir="ltr" id="proposalform-field-4" maxlength="20" minlength="9" name="proposalform-field-4" placeholder="5X XXX XXXX" required="" type="tel"/>
</div>
</div>
</div>

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold flex items-center gap-1" for="proposalform-field-5">
              البريد الإلكتروني الرسمي
              <span class="text-error">*</span>
</label>
<div class="relative">
<span aria-hidden="true" class="material-symbols-outlined absolute right-3 top-3 text-on-surface-variant text-xl pointer-events-none">alternate_email</span>
<input autocomplete="email" class="w-full h-11 bg-surface-container-lowest text-on-surface pr-10 pl-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors" dir="ltr" id="proposalform-field-5" name="proposalform-field-5" placeholder="procurement@@organization.sa" required="" type="email"/>
</div>
</div>

<div class="flex flex-col gap-1">
<label class="font-label-lg text-label-lg text-on-surface font-semibold" for="proposalform-field-6">
              المواصفات الفنية وملاحظات الجدول الزمني
            </label>
<textarea class="w-full bg-surface-container-lowest text-on-surface p-space-md rounded-lg font-body-md text-body-md focus:outline-none focus:bg-surface-container-high transition-colors resize-none" id="proposalform-field-6" name="proposalform-field-6" placeholder="يرجى توضيح موقع التوزيع (منى، عرفات، الحرم، مستودعات خارجية)، فترات التوريد، أية اشتراطات خاصة بالتغليف أو الهوية..." rows="4">@Details</textarea>
</div>

<div class="flex items-center gap-space-sm pt-space-xs">
<input class="w-4 h-4 accent-primary rounded bg-surface-container-lowest cursor-pointer" id="proposalform-field-7" name="proposalform-field-7" required="" type="checkbox"/>
<label class="font-label-sm text-label-sm text-on-surface-variant cursor-pointer select-none" for="proposalform-field-7">
              أقر بأن هذا نموذج توضيحي لا يرسل طلباً أو ينشئ تعاقداً. <a href="/privacy-policy">مسودة سياسة الخصوصية</a>
            </label>
</div>

<div class="pt-space-sm">
<button class="w-full py-3.5 px-space-lg rounded-xl bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow-xl hover:bg-primary-container transition-all flex items-center justify-center gap-space-sm group" id="submitBtn" type="submit" disabled="@(!Interactive)">
<span aria-hidden="true" class="material-symbols-outlined text-xl group-hover:-translate-x-1 transition-transform">send</span>
<span>إرسال طلب التعاقد / الاستشارة المباشرة</span>
</button>
</div>


</form>
<p class="website-demo-note">عرض توضيحي: لا يتم إرسال طلب أو إنشاء تعاقد في هذه النسخة.</p>
@if (Submitted)
{
<p class="website-demo-note" role="status">تم التحقق محلياً من النموذج التجريبي. لم يتم إرسال البيانات أو حفظها، ولم يُنشأ أي طلب.</p>
}

@code {
 private bool Submitted;
 private bool Interactive;
 protected override void OnAfterRender(bool firstRender)
 {
  if (firstRender) { Interactive = true; StateHasChanged(); }
 }
 private void Submit() => Submitted = true;
 private string SelectedService = "";
 protected override void OnParametersSet() => SelectedService = Service ?? "";
 [Parameter] public string? Service { get; set; }
 [Parameter] public string? Package { get; set; }
 private string Details => string.IsNullOrEmpty(Package) ? "" : $"الطلب التجريبي للباقة: {Package}";
}
