<section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin py-space-xl">
<div class="text-center max-w-2xl mx-auto mb-space-xl">
<span class="font-label-md text-label-md text-primary font-bold" data-pw-fields="DeliveryWorkflow.f001">@Content.Text("DeliveryWorkflow.f001")</span>
