@page "/website-not-found"
@layout WebsiteLayout
@inject NavigationManager Navigation
<PageTitle>@Title | الأفكار الناجحة</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="description" content="@Description" />
</HeadContent>
<section class="pw-section pw-not-found">
    <div class="pw-container pw-centered">
        <span class="pw-eyebrow">@Status</span>
        <h1>@Title</h1>
        <p>@Description</p>
        <a target="_top" class="pw-button" href="/">العودة إلى الرئيسية <span aria-hidden="true">←</span></a>
        <a target="_top" class="pw-text-link" href="/contact">تواصل معنا</a>
    </div>
</section>
@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
    private int Status = 404;
    private string Title => Status == 410 ? "هذه الصفحة لم تعد متاحة" : "الصفحة غير موجودة";
    private string Description => Status == 410 ? "تم إيقاف هذه الصفحة. يمكنك تصفح خدماتنا أو التواصل معنا لمعرفة المزيد." : "تعذر العثور على الصفحة المطلوبة. يمكنك العودة إلى الرئيسية أو التواصل معنا.";
    protected override void OnInitialized()
    {
        // Preserve retirement wording when the interactive router sees the original URL.
        Status = WebsiteRoutes.Resolve(new Uri(Navigation.Uri).AbsolutePath).Status == 410 ? 410 : 404;
        if (HttpContext is { Response.HasStarted: false })
        {
            Status = HttpContext.Response.StatusCode == 410 ? 410 : 404;
            HttpContext.Response.StatusCode = Status;
            HttpContext.Response.Headers["X-Robots-Tag"] = "noindex, nofollow";
        }
    }
}
