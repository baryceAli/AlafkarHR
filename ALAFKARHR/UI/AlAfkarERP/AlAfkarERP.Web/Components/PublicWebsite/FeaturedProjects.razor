<button @onclick="() => Select(0)" aria-pressed='@(Filter == 0 ? "true" : "false")' class='px-space-md py-space-xs rounded-full font-label-md text-label-md font-bold shadow-sm @(Filter == 0 ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")' data-pw-fields="FeaturedProjects.f030">
              @Content.Text("FeaturedProjects.f030")
            </button>
<button @onclick="() => Select(1)" aria-pressed='@(Filter == 1 ? "true" : "false")' class='px-space-md py-space-xs rounded-full hover:text-primary font-label-md text-label-md transition-colors @(Filter == 1 ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")' data-pw-fields="FeaturedProjects.f031">
