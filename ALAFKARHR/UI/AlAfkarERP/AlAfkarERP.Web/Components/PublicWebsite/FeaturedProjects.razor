<span class="px-space-sm py-0.5 rounded bg-surface-container-high text-primary font-label-sm text-label-sm font-bold" data-pw-fields="FeaturedProjects.collection1.item2.f013" data-pw-item="@item.Id">@Content.Text("FeaturedProjects.collection1.item2.f013", item)</span>
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">star</span>
