<img alt="@Content.Text("FeaturedProjects.collection1.item1.f003", item)" class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 opacity-60" decoding="async" height="279" loading="lazy" src="@Content.Media("FeaturedProjects.collection1.item1.f004", item)" width="512" data-pw-fields="FeaturedProjects.collection1.item1.f003,FeaturedProjects.collection1.item1.f004" data-pw-item="@item.Id"/>
<div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/70 to-transparent"></div>
<div class="website-image-caption relative p-space-xl flex flex-col gap-space-sm z-10">
<div class="flex items-center gap-space-sm">
<span class="px-space-sm py-0.5 rounded bg-primary text-on-primary font-label-sm text-label-sm font-bold" data-pw-fields="FeaturedProjects.collection1.item1.f005" data-pw-item="@item.Id">@Content.Text("FeaturedProjects.collection1.item1.f005", item)</span>
