<p class="font-body-md text-body-md text-on-surface-variant max-w-xl" data-pw-fields="FeaturedProjects.collection1.item1.f008" data-pw-item="@item.Id">
              @Content.Text("FeaturedProjects.collection1.item1.f008", item)
            </p>
<div class="flex items-center gap-space-lg pt-space-xs">
