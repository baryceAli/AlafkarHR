<button @onclick="() => Select(2)" aria-pressed='@(Filter == 2 ? "true" : "false")' class='px-space-md py-space-xs rounded-full hover:text-primary font-label-md text-label-md transition-colors @(Filter == 2 ? "bg-primary text-on-primary" : "bg-surface-container-high text-on-surface-variant")' data-pw-fields="FeaturedProjects.f032">
