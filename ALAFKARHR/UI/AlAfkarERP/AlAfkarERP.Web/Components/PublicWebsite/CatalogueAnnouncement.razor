<section class="relative w-full bg-surface-container-lowest px-margin-mobile md:px-margin-tablet lg:px-margin py-space-sm overflow-hidden">
<div class="max-w-[1440px] mx-auto flex flex-wrap items-center justify-between gap-space-sm text-on-surface-variant font-label-sm text-label-sm">
<div class="flex items-center gap-space-sm">
<span class="inline-flex items-center gap-1 text-primary" data-pw-fields="CatalogueAnnouncement.f001">
<span aria-hidden="true" class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">verified</span>
          @Content.Text("CatalogueAnnouncement.f001")
        </span>
<span class="text-outline">/</span>
<span data-pw-fields="CatalogueAnnouncement.f002">@Content.Text("CatalogueAnnouncement.f002")</span>
</div>
<div class="flex items-center gap-space-md">
<span class="inline-flex items-center gap-1 text-on-surface" data-pw-fields="CatalogueAnnouncement.f003">
<span aria-hidden="true" class="material-symbols-outlined text-sm text-primary">schedule</span>
          @Content.Text("CatalogueAnnouncement.f003")
        </span>
<span class="inline-flex items-center gap-1 text-primary font-semibold" data-pw-fields="CatalogueAnnouncement.f004">
<span aria-hidden="true" class="material-symbols-outlined text-sm">local_shipping</span>
          @Content.Text("CatalogueAnnouncement.f004")
        </span>
</div>
</div>
</section>