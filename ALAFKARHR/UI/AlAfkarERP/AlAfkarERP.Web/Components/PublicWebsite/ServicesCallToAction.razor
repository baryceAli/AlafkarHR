<section class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin pt-space-md pb-space-xl">
<div class="rounded-2xl bg-gradient-to-r from-surface-container to-surface-container-high p-space-lg md:p-space-xl shadow-2xl relative overflow-hidden">
<div class="absolute -right-20 -top-20 w-80 h-80 bg-primary/10 rounded-full blur-3xl pointer-events-none"></div>
<div class="flex flex-col lg:flex-row items-center justify-between gap-space-lg relative z-10">
<div class="max-w-2xl text-center lg:text-right space-y-space-xs">
<span class="px-space-sm py-space-xs bg-surface-container-highest text-primary rounded-full font-label-sm text-label-sm font-semibold inline-block" data-pw-fields="ServicesCallToAction.f001">
            @Content.Text("ServicesCallToAction.f001")
          </span>
<h2 class="font-headline-lg text-headline-lg text-on-surface font-bold" data-pw-fields="ServicesCallToAction.f002">
            @Content.Text("ServicesCallToAction.f002")
          </h2>
<p class="font-body-md text-body-md text-on-surface-variant" data-pw-fields="ServicesCallToAction.f003">
            @Content.Text("ServicesCallToAction.f003")
          </p>
</div>
<div class="flex flex-col sm:flex-row items-center gap-space-sm w-full lg:w-auto">
<a class="w-full sm:w-auto inline-flex items-center justify-center gap-space-xs px-space-xl py-space-md rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold shadow-lg hover:bg-primary-container hover:text-on-primary-container transition-all text-center" data-path="request-proposal" href="@Content.Link("ServicesCallToAction.f004")" data-pw-fields="ServicesCallToAction.f004">
<span aria-hidden="true" class="material-symbols-outlined text-xl">assignment</span>
<span data-pw-fields="ServicesCallToAction.f005">@Content.Text("ServicesCallToAction.f005")</span>
</a>
<a class="w-full sm:w-auto inline-flex items-center justify-center gap-space-xs px-space-lg py-space-md rounded-lg bg-surface-container-lowest text-on-surface font-label-lg text-label-lg font-semibold hover:bg-surface-container-highest transition-all text-center" data-path="contact" href="@Content.Link("ServicesCallToAction.f006")" data-pw-fields="ServicesCallToAction.f006">
<span aria-hidden="true" class="material-symbols-outlined text-xl">phone_in_talk</span>
<span data-pw-fields="ServicesCallToAction.f007">@Content.Text("ServicesCallToAction.f007")</span>
</a>
</div>
</div>
</div>
</section>