<section class="w-full bg-surface-container py-space-xl">
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin">
<div class="p-space-xl bg-gradient-to-r from-surface-container-high to-surface-container rounded-2xl flex flex-col lg:flex-row items-center justify-between gap-space-lg shadow-2xl">
<div class="flex flex-col gap-space-xs text-center lg:text-right">
<span class="font-label-md text-label-md text-primary font-semibold" data-pw-fields="ProjectsCallToAction.f001">@Content.Text("ProjectsCallToAction.f001")</span>
<h2 class="font-headline-xl text-headline-xl text-on-surface font-bold" data-pw-fields="ProjectsCallToAction.f002">@Content.Text("ProjectsCallToAction.f002")</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl" data-pw-fields="ProjectsCallToAction.f003">
            @Content.Text("ProjectsCallToAction.f003")
          </p>
</div>
<div class="flex flex-col sm:flex-row items-center gap-space-sm shrink-0 w-full sm:w-auto">
<a class="w-full sm:w-auto px-space-xl py-space-md rounded-lg bg-primary text-on-primary font-label-lg text-label-lg font-bold hover:bg-primary-container transition-all text-center shadow-lg" data-path="request-proposal" href="@Content.Link("ProjectsCallToAction.f004")" data-pw-fields="ProjectsCallToAction.f004,ProjectsCallToAction.f005">
            @Content.Text("ProjectsCallToAction.f005")
          </a>
<a class="w-full sm:w-auto px-space-lg py-space-md rounded-lg bg-surface-container-lowest text-on-surface hover:text-primary font-label-lg text-label-lg transition-all text-center" data-path="direct-contact" href="@Content.Link("ProjectsCallToAction.f006")" data-pw-fields="ProjectsCallToAction.f006,ProjectsCallToAction.f007">
            @Content.Text("ProjectsCallToAction.f007")
          </a>
</div>
</div>
</div>
</section>