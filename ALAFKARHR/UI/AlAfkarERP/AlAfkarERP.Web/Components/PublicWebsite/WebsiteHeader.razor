else { <span class="website-brand-unavailable" role="img" aria-label="@Content.Text("WebsiteHeader.f001")" data-pw-fields="WebsiteHeader.logo,WebsiteHeader.f001">@Content.Text("WebsiteHeader.f002")</span> }<div class="flex flex-col"><span class="font-headline-sm text-headline-sm text-primary tracking-wide" data-pw-fields="WebsiteHeader.f004">@Content.Text("WebsiteHeader.f004")</span><span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="WebsiteHeader.f005">@Content.Text("WebsiteHeader.f005")</span></div></a><nav aria-label="@Content.Text("WebsiteHeader.f006")" class="hidden xl:flex items-center gap-space-md" data-active-classes="text-primary font-bold" data-pw-fields="WebsiteHeader.f006"><a aria-current='@Current("/")' class="font-label-lg text-label-lg transition-colors py-space-xs px-space-xs website-nav-link" data-path="home" href="@Content.Link("WebsiteHeader.f007")" data-pw-fields="WebsiteHeader.f007,WebsiteHeader.f008">@Content.Text("WebsiteHeader.f008")</a><a aria-current='@Current("/about")' class="font-label-lg text-label-lg transition-colors py-space-xs px-space-xs website-nav-link" data-path="about" href="@Content.Link("WebsiteHeader.f009")" data-pw-fields="WebsiteHeader.f009,WebsiteHeader.f010">@Content.Text("WebsiteHeader.f010")</a><a aria-current='@Current("/services")' class="font-label-lg text-label-lg transition-colors py-space-xs px-space-xs website-nav-link" data-path="services" href="@Content.Link("WebsiteHeader.f011")" data-pw-fields="WebsiteHeader.f011,WebsiteHeader.f012">@Content.Text("WebsiteHeader.f012")</a><a aria-current='@Current("/projects")' class="font-label-lg text-label-lg transition-colors py-space-xs px-space-xs website-nav-link" data-path="projects" href="@Content.Link("WebsiteHeader.f013")" data-pw-fields="WebsiteHeader.f013,WebsiteHeader.f014">@Content.Text("WebsiteHeader.f014")</a><a aria-current='@Current("/infrastructure")' class="font-label-lg text-label-lg transition-colors py-space-xs px-space-xs