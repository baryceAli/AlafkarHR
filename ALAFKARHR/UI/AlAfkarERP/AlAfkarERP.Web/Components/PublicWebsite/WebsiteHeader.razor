@inject NavigationManager Navigation
<header class="pw-header">
    <div class="pw-header-inner pw-container">
        <a class="pw-brand" href="/" aria-label="@(WebsiteContent.Brand + " — الرئيسية")">
            <span class="pw-brand-mark" aria-hidden="true"><img src="/_content/AlAfkarERP.Shared/images/logo/afkarfavicon.ico" alt="" width="32" height="32" /></span>
            <span><strong>@WebsiteContent.Brand</strong><small>أفكار نابضة.. حلول ناجحة</small></span>
        </a>
        <nav class="pw-desktop-nav" aria-label="التنقل الرئيسي">
            @foreach (var entry in WebsiteContent.Pages.Where(p => p.Key != "request-proposal"))
            {
                <a href="@entry.Url" aria-current="@Current(entry)">@entry.Label</a>
            }
        </nav>
        <a class="pw-button pw-header-cta" href="/request-proposal" aria-current="@ProposalCurrent">اطلب عرض سعر <span aria-hidden="true">↗</span></a>
        <details class="pw-mobile-nav">
            <summary aria-label="قائمة التنقل"><WebsiteIcon Name="menu" /><span>القائمة</span></summary>
            <nav aria-label="التنقل على الجوال">
                @foreach (var entry in WebsiteContent.Pages.Where(p => p.Key != "request-proposal"))
                {
                    <a href="@entry.Url" aria-current="@Current(entry)">@entry.Label</a>
                }
                <a href="/request-proposal" aria-current="@ProposalCurrent">اطلب عرض سعر</a>
            </nav>
        </details>
    </div>
</header>
@code {
    private string? ProposalCurrent => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals(WebsiteContent.ProposalUrl, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    private string? Current(WebsiteContent.Page page) => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').Equals(page.Url.TrimEnd('/'), StringComparison.OrdinalIgnoreCase) ? "page" : null;
}
