eHeader.f025,WebsiteHeader.f026">@Content.Text("WebsiteHeader.f026")</a></div></div><details class="website-mobile-nav"><summary data-pw-fields="WebsiteHeader.f027">@Content.Text("WebsiteHeader.f027")</summary><nav aria-label="@Content.Text("WebsiteHeader.f028")" data-pw-fields="WebsiteHeader.f028"><a href="@Content.Link("WebsiteHeader.f029")" data-pw-fields="WebsiteHeader.f029,WebsiteHeader.f030">@Content.Text("WebsiteHeader.f030")</a><a href="@Content.Link("WebsiteHeader.f031")" data-pw-fields="WebsiteHeader.f031,WebsiteHeader.f032">@Content.Text("WebsiteHeader.f032")</a><a href="@Content.Link("WebsiteHeader.f033")" data-pw-fields="WebsiteHeader.f033,WebsiteHeader.f034">@Content.Text("WebsiteHeader.f034")</a><a href="@Content.Link("WebsiteHeader.f035")" data-pw-fields="WebsiteHeader.f035,WebsiteHeader.f036">@Content.Text("WebsiteHeader.f036")</a><a href="@Content.Link("WebsiteHeader.f037")" data-pw-fields="WebsiteHeader.f037,WebsiteHeader.f038">@Content.Text("WebsiteHeader.f038")</a><a href="@Content.Link("WebsiteHeader.f039")" data-pw-fields="WebsiteHeader.f039,WebsiteHeader.f040">@Content.Text("WebsiteHeader.f040")</a><a href="@Content.Link("WebsiteHeader.f041")" data-pw-fields="WebsiteHeader.f041,WebsiteHeader.f042">@Content.Text("WebsiteHeader.f042")</a><a href="@Content.Link("WebsiteHeader.f043")" data-pw-fields="WebsiteHeader.f043,WebsiteHeader.f044">@Content.Text("WebsiteHeader.f044")</a><a href="@Content.Link("WebsiteHeader.f045")" data-pw-fields="WebsiteHeader.f045,WebsiteHeader.f046">@Content.Text("WebsiteHeader.f046")</a><a href="@Content.Link("WebsiteHeader.f047")" data-pw-fields="WebsiteHeader.f047,WebsiteHeader.f048">@Content.Text("WebsiteHeader.f048")</a></nav></details></header>
@inject NavigationManager Navigation
@code {
 private string LanguageUrl => Content.English ? WebsiteRoutes.ArabicPath(new Uri(Navigation.Uri).AbsolutePath) : Content.LocalizeEnglish(new Uri(Navigation.Uri).AbsolutePath);
 private string? Current(string path)
 {
  var uri = new Uri(Navigation.Uri);
  var localizedPath = WebsiteRoutes.ArabicPath(uri.AbsolutePath);
  var current = localizedPath == "/projects" && uri.Fragment == "#media-center" ? "/projects#media-center" : localizedPath;
  return current == path ? "page" : null;
 }
}
