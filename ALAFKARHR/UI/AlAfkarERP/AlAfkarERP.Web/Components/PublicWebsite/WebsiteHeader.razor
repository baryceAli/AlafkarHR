@inject NavigationManager Navigation
@code {
 private string? Current(string path)
 {
  var uri = new Uri(Navigation.Uri);
  var current = uri.AbsolutePath == "/projects" && uri.Fragment == "#media-center" ? "/projects#media-center" : uri.AbsolutePath;
  return current == path ? "page" : null;
 }
}
