<header class="website-header">
    <div class="website-header-inner website-approved-header">
        <a class="website-approved-brand" href="@Content.Link("WebsiteHeader.f001")" data-pw-fields="WebsiteHeader.f001">
            @if (Content.Value("WebsiteHeader.logo").MediaId.HasValue)
            { <img src="@Content.Media("WebsiteHeader.logo")" alt="@Content.Text("WebsiteHeader.logoAlt")" data-pw-fields="WebsiteHeader.logo,WebsiteHeader.logoAlt" /> }
            <span><strong data-pw-fields="WebsiteHeader.f004">@Content.Text("WebsiteHeader.f004")</strong><small data-pw-fields="WebsiteHeader.f005">@Content.Text("WebsiteHeader.f005")</small></span>
        </a>
        <nav class="website-approved-desktop-nav" aria-label="@Content.Text("WebsiteHeader.f006")">
            @foreach (var (link, label) in Links)
            {
                @if (Show(link))
                { <a href="@Content.Link(link)" aria-current="@Current(Content.Text(link))" data-pw-fields="@(link + "," + label)">@Content.Text(label)</a> }
            }
        </nav>
        <div class="website-approved-actions website-header-actions">
            <a class="website-language-switch" href="@LanguageUrl">@(Content.English ? "العربية" : "English")</a>
            <a class="website-approved-button" href="@Content.Link("WebsiteHeader.f025")" data-pw-fields="WebsiteHeader.f025,WebsiteHeader.f026">@Content.Text("WebsiteHeader.f026")</a>
        </div>
        <details class="website-mobile-nav">
            <summary data-pw-fields="WebsiteHeader.f027">@Content.Text("WebsiteHeader.f027")</summary>
            <nav aria-label="@Content.Text("WebsiteHeader.f028")">
                @foreach (var (link, label) in Links)
                {
                    @if (Show(link))
                    { <a href="@Content.Link(link)" aria-current="@Current(Content.Text(link))" data-pw-fields="@(link + "," + label)">@Content.Text(label)</a> }
                }
                <a href="@Content.Link("WebsiteHeader.f025")" data-pw-fields="WebsiteHeader.f025,WebsiteHeader.f026">@Content.Text("WebsiteHeader.f026")</a>
                <a href="@Content.Link("WebsiteHeader.f023")" data-pw-fields="WebsiteHeader.f023,WebsiteHeader.f024">@Content.Text("WebsiteHeader.f024")</a>
                <a class="website-language-switch" href="@LanguageUrl">@(Content.English ? "العربية" : "English")</a>
            </nav>
        </details>
    </div>
</header>
@inject NavigationManager Navigation
@code {
    private static readonly (string Link, string Label)[] Links =
    [("WebsiteHeader.f007", "WebsiteHeader.f008"), ("WebsiteHeader.f009", "WebsiteHeader.f010"),
     ("WebsiteHeader.f011", "WebsiteHeader.f012"), ("WebsiteHeader.f013", "WebsiteHeader.f014"),
     ("WebsiteHeader.f015", "WebsiteHeader.f016"), ("WebsiteHeader.f017", "WebsiteHeader.f018"),
     ("WebsiteHeader.f019", "WebsiteHeader.f020"), ("WebsiteHeader.f021", "WebsiteHeader.f022")];
    private string LanguageUrl
    {
        get
        {
            var uri = new Uri(Navigation.Uri);
            return (Content.English ? WebsiteRoutes.ArabicPath(uri.AbsolutePath) : Content.LocalizeEnglish(uri.AbsolutePath)) + uri.Query + uri.Fragment;
        }
    }
    private bool Show(string link) => link != "WebsiteHeader.f017" ||
        (Content.Snapshot.Pages.GetValueOrDefault("/projects")?.Any(x => x.Key == "ApprovedResources" && x.Visible) == true &&
        (Content.PreviewSession != null || new[] { "MediaCenter.profile", "MediaCenter.press", "MediaCenter.report", "MediaCenter.kit", "MediaCenter.audio" }.Any(x => Content.Value(x).MediaId.HasValue)));
    private string? Current(string path)
    {
        var uri = new Uri(Navigation.Uri);
        var current = WebsiteRoutes.ArabicPath(uri.AbsolutePath);
        if (current.StartsWith("/services/", StringComparison.Ordinal)) current = "/services";
        if (path.Contains('#')) return current + uri.Fragment == path ? "page" : null;
        return current == path && !(current == "/projects" && uri.Fragment.Length > 0) ? "page" : null;
    }
}
