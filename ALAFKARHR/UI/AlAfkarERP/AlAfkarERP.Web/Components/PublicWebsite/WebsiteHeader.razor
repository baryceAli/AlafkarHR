<header class="fixed top-0 left-0 right-0 w-full z-50 bg-surface/90 backdrop-blur-xl shadow-[0_4px_20px_-2px_rgba(0,0,0,0.70)] website-header"><div class="h-20 max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin flex items-center justify-between gap-space-lg website-header-inner"><a class="flex items-center gap-space-md" href="@Content.Link("WebsiteHeader.f001")" data-pw-fields="WebsiteHeader.f001">@if (Content.Value("WebsiteHeader.logo").MediaId.HasValue)
