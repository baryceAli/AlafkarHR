<section class="w-full bg-surface-container-lowest py-space-xl relative overflow-hidden" id="quick-inquiry">

<div class="absolute -bottom-20 right-1/3 w-96 h-96 bg-primary/10 rounded-full blur-[120px] pointer-events-none"></div>
<div class="max-w-[1440px] mx-auto px-margin-mobile md:px-margin-tablet lg:px-margin">
<div class="rounded-xl bg-surface-container p-space-xl shadow-2xl relative overflow-hidden">
<div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-center">

<div class="lg:col-span-5 flex flex-col gap-space-md">
<div class="inline-flex items-center gap-space-xs text-primary">
<span aria-hidden="true" class="material-symbols-outlined text-lg">bolt</span>
<span class="font-label-lg text-label-lg font-bold" data-pw-fields="QuickInquiry.f001">@Content.Text("QuickInquiry.f001")</span>
</div>
<h2 class="font-headline-xl text-headline-xl text-on-surface font-bold" data-pw-fields="QuickInquiry.f002">
              @Content.Text("QuickInquiry.f002")
            </h2>
<p class="font-body-md text-body-md text-on-surface-variant leading-relaxed" data-pw-fields="QuickInquiry.f003">
              @Content.Text("QuickInquiry.f003")
            </p>
<div class="flex flex-col gap-space-sm pt-space-xs">
<div class="flex items-center gap-space-sm text-on-surface">
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">phone_in_talk</span>
<span class="font-body-md text-body-md" dir="ltr" data-pw-fields="QuickInquiry.f004">@Content.Text("QuickInquiry.f004")</span>
<span class="font-label-sm text-label-sm text-on-surface-variant" data-pw-fields="QuickInquiry.f005">@Content.Text("QuickInquiry.f005")</span>
</div>
<div class="flex items-center gap-space-sm text-on-surface">
<span aria-hidden="true" class="material-symbols-outlined text-primary text-xl">schedule</span>
<span class="font-body-md text-body-md" data-pw-fields="QuickInquiry.f006">@Content.Text("QuickInquiry.f006")</span>
</div>
</div>
</div>

<div class="lg:col-span-7 bg-surface-container-low p-space-lg rounded-xl shadow-lg">
<QuickInquiryForm />
</div>
</div>
</div>
</div>
</section>