@page "/"
@page "/about"
@page "/activities"
@page "/services"
@page "/projects"
@page "/partners"
@page "/contact"
@page "/request-proposal"
@layout WebsiteLayout
@inject NavigationManager Navigation
<WebsiteSeo Page="Page" />
@switch (Page.Key)
{
    case "": <WebsiteHome /> break;
    case "about": <WebsiteAbout /> break;
    case "activities": <WebsiteActivities /> break;
    case "services": <WebsiteServices /> break;
    case "projects": <WebsiteProjects /> break;
    case "partners": <WebsitePartners /> break;
    case "contact": <WebsiteContact /> break;
    case "request-proposal": <WebsiteRequestProposal /> break;
}
@code {
    private WebsiteContent.Page Page => WebsiteContent.Find(new Uri(Navigation.Uri).AbsolutePath.Trim('/')) ?? WebsiteContent.Pages[0];
}
